// OSS demo workspace package (P2). Entry for import malda-demo-math;
// Layout: packages/malda-demo-math/demo-math.malda (malda-* → short name).

export function clamp(value, lo, hi) {
    if (value < lo) {
        return lo;
    }
    if (value > hi) {
        return hi;
    }
    return value;
}

export function add(a, b) {
    return a + b;
}

export var VERSION = "1.0.0";
