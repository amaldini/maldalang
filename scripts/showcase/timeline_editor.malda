// Slider editor for scripts/showcase/playlist.json and song-prompt.md.
//
// Run:  malda scripts/showcase/timeline_editor.malda
// Open: http://localhost:8094/
//
// Each cue has a slider. Dragging a cue later pushes the cues after it so
// start times stay in order. Earlier and Later reorder cues inside the
// example browser, the manual, and the scenes. Time slots stay put. A scene
// lyric moves with that scene. The song prompt stays on screen: section
// lengths, dream lines, and the order notes follow the page, and the rest
// can be edited. Hear plays the soundtrack from that cue for the number of
// seconds set on the page, starting at 3. Save writes the playlist and the
// prompt.

var playlistPath = io.pathJoin(getProgramDirectory(), "playlist.json");
var promptPath = io.pathJoin(getProgramDirectory(), "song-prompt.md");
var timelineMaxMs = 180000;
var timelineGapMs = 200;

function loadPlaylist() {
    return parseJSON(io.readFile(playlistPath));
}

function checkOrder(doc) {
    var previous = -1;
    var label = "the splash";
    var groups = [doc.browse, doc.manual, doc.scenes];
    for (var g = 0; g < groups.length; g = g + 1) {
        var group = groups[g];
        for (var i = 0; i < group.length; i = i + 1) {
            var start = int(group[i].startMs);
            if (start <= previous) {
                return group[i].caption + " must start after " + label + ".";
            }
            previous = start;
            label = group[i].caption;
        }
    }
    if (int(doc.endMs) <= previous) {
        return "The reel end must be after " + label + ".";
    }
    return "";
}

function assignStarts(group, values) {
    if (values == null or values.length != group.length) {
        return "The editor cue count does not match the playlist.";
    }
    for (var i = 0; i < group.length; i = i + 1) {
        var n = toIntOrNull(values[i]);
        if (n == null or n < 0) {
            return "Each start must be a whole number of milliseconds.";
        }
        group[i].startMs = n;
    }
    return "";
}

function takeOrder(items, order, label) {
    if (order == null or order.length != items.length) {
        return { "error": label + " order does not match the playlist.", "items": items };
    }
    var used = [];
    var next = [];
    for (var i = 0; i < order.length; i = i + 1) {
        var found = -1;
        for (var j = 0; j < items.length; j = j + 1) {
            if (items[j].file == order[i]) {
                var already = false;
                for (var u = 0; u < used.length; u = u + 1) {
                    if (used[u] == j) {
                        already = true;
                    }
                }
                if (not already) {
                    found = j;
                    break;
                }
            }
        }
        if (found < 0) {
            return { "error": "Unknown " + label + " in the new order.", "items": items };
        }
        used.append(found);
        next.append(items[found]);
    }
    return { "error": "", "items": next };
}

function applyListedOrder(doc, items, order, label) {
    if (order == null) {
        return "";
    }
    var taken = takeOrder(items, order, label);
    if (taken.error != "") {
        return taken.error;
    }
    if (label == "browse cue") {
        doc.browse = taken.items;
    } else if (label == "manual page") {
        doc.manual = taken.items;
    } else {
        doc.scenes = taken.items;
    }
    return "";
}

function reorderScenes(doc, order) {
    return applyListedOrder(doc, doc.scenes, order, "scene");
}

function fileList(items) {
    var files = [];
    for (var i = 0; i < items.length; i = i + 1) {
        files.append(items[i].file);
    }
    return files;
}

function sameOrder(before, after) {
    if (before.length != after.length) {
        return false;
    }
    for (var i = 0; i < before.length; i = i + 1) {
        if (before[i] != after[i]) {
            return false;
        }
    }
    return true;
}

function splitLines(text) {
    return str.split(string(text), "\n");
}

function spliceLines(lines, start, end, replacement) {
    var next = [];
    for (var i = 0; i < start; i = i + 1) {
        next.append(lines[i]);
    }
    for (var j = 0; j < replacement.length; j = j + 1) {
        next.append(replacement[j]);
    }
    for (var k = end; k < lines.length; k = k + 1) {
        next.append(lines[k]);
    }
    return str.join(next, "\n");
}

function extractDreamLyrics(text) {
    var lines = splitLines(text);
    var inDream = false;
    var inLines = false;
    var lyrics = [];
    for (var i = 0; i < lines.length; i = i + 1) {
        var line = lines[i];
        if (str.startsWith(line, "[Dream")) {
            inDream = true;
            inLines = false;
        } else if (inDream and str.startsWith(line, "[Outro")) {
            break;
        } else if (inDream and str.startsWith(line, "[Female voice]")) {
            inLines = true;
        } else if (inLines and str.trim(line) != "") {
            lyrics.append(str.trim(line));
        }
    }
    return lyrics;
}

function replaceDreamLyrics(text, lyrics) {
    var lines = splitLines(text);
    var voice = -1;
    var inDream = false;
    for (var i = 0; i < lines.length; i = i + 1) {
        if (str.startsWith(lines[i], "[Dream")) {
            inDream = true;
        } else if (inDream and str.startsWith(lines[i], "[Female voice]")) {
            voice = i;
            break;
        }
    }
    if (voice < 0) {
        return "";
    }
    var start = voice + 1;
    var end = start;
    while (end < lines.length) {
        if (str.trim(lines[end]) == "" or str.startsWith(lines[end], "[")) {
            break;
        }
        end = end + 1;
    }
    return spliceLines(lines, start, end, lyrics);
}

function captionSentence(label, items) {
    var names = [];
    for (var i = 0; i < items.length; i = i + 1) {
        names.append(items[i].caption);
    }
    return label + ": " + str.join(names, ", ") + ".";
}

function lineIndex(lines, prefix) {
    for (var i = 0; i < lines.length; i = i + 1) {
        if (str.startsWith(lines[i], prefix)) {
            return i;
        }
    }
    return -1;
}

function replaceOrderNote(text, prefix, altPrefix, sentence) {
    var lines = splitLines(text);
    var start = lineIndex(lines, prefix);
    if (start < 0 and altPrefix != "") {
        start = lineIndex(lines, altPrefix);
    }
    if (start < 0) {
        return "";
    }
    var end = start + 1;
    while (end < lines.length) {
        if (str.trim(lines[end]) == "") {
            break;
        }
        end = end + 1;
    }
    var replacement = [];
    replacement.append(sentence);
    return spliceLines(lines, start, end, replacement);
}

function replaceDreamOrder(text, scenes) {
    return replaceOrderNote(text, "Dream, in scene order:", "", captionSentence("Dream, in scene order", scenes));
}

function cleanLyric(value) {
    var line = str.trim(string(value));
    while (str.indexOf(line, "\n") >= 0) {
        line = str.replace(line, "\n", " ");
    }
    return str.trim(line);
}

function allDigits(value) {
    if (str.length(value) == 0) {
        return false;
    }
    for (var i = 0; i < str.length(value); i = i + 1) {
        var ch = str.substring(value, i, 1);
        if (str.indexOf("0123456789", ch) < 0) {
            return false;
        }
    }
    return true;
}

function roundedSeconds(ms) {
    if (ms < 0) {
        return 0;
    }
    var seconds = ms / 1000.0;
    var whole = math.floor(seconds);
    if (seconds - whole >= 0.5) {
        whole = whole + 1;
    }
    return int(whole);
}

function runtimePhrase(endMs) {
    var total = roundedSeconds(endMs);
    var minutes = int(total / 60);
    var seconds = total - minutes * 60;
    if (minutes <= 0) {
        return "About " + string(seconds) + " seconds";
    }
    if (seconds == 0) {
        if (minutes == 1) {
            return "About 1 minute";
        }
        return "About " + string(minutes) + " minutes";
    }
    var unit = "minutes";
    if (minutes == 1) {
        unit = "minute";
    }
    return "About " + string(minutes) + " " + unit + " " + string(seconds) + " seconds";
}

function looksLikeClock(span) {
    if (str.length(span) == 0) {
        return false;
    }
    var sawDigit = false;
    var allowed = "0123456789 minutes";
    for (var i = 0; i < str.length(span); i = i + 1) {
        var ch = str.substring(span, i, 1);
        if (str.indexOf("0123456789", ch) >= 0) {
            sawDigit = true;
        } else if (str.indexOf(allowed, ch) < 0) {
            return false;
        }
    }
    return sawDigit;
}

function replaceHeadingSeconds(text, label, seconds) {
    var prefix = "[" + label + " – ";
    var at = str.indexOf(text, prefix);
    if (at < 0) {
        return text;
    }
    var numberAt = at + str.length(prefix);
    var rest = str.substring(text, numberAt, str.length(text) - numberAt);
    var end = str.indexOf(rest, " seconds");
    if (end < 0) {
        return text;
    }
    var digits = str.substring(rest, 0, end);
    if (not allDigits(digits)) {
        return text;
    }
    var tailAt = numberAt + end;
    return str.substring(text, 0, numberAt) + string(int(seconds)) + str.substring(text, tailAt, str.length(text) - tailAt);
}

function replaceRuntimeLength(text, endMs) {
    var marker = "About ";
    var at = str.indexOf(text, marker);
    if (at < 0) {
        return text;
    }
    var from = at + str.length(marker);
    var rest = str.substring(text, from, str.length(text) - from);
    var endWord = str.indexOf(rest, "seconds");
    if (endWord < 0) {
        return text;
    }
    var span = str.substring(rest, 0, endWord);
    if (not looksLikeClock(span)) {
        return text;
    }
    var phrase = runtimePhrase(endMs);
    var tailAt = from + endWord + str.length("seconds");
    return str.substring(text, 0, at) + phrase + str.substring(text, tailAt, str.length(text) - tailAt);
}

function replaceSectionDurations(text, doc) {
    if (doc.browse.length == 0 or doc.manual.length == 0 or doc.scenes.length == 0) {
        return text;
    }
    var browseStart = int(doc.browse[0].startMs);
    var manualStart = int(doc.manual[0].startMs);
    var sceneStart = int(doc.scenes[0].startMs);
    var endMs = int(doc.endMs);
    text = replaceHeadingSeconds(text, "Intro", roundedSeconds(browseStart));
    text = replaceHeadingSeconds(text, "Catalog", roundedSeconds(manualStart - browseStart));
    text = replaceHeadingSeconds(text, "Manual", roundedSeconds(sceneStart - manualStart));
    text = replaceHeadingSeconds(text, "Dream", roundedSeconds(endMs - sceneStart));
    return text;
}

function refreshSongPrompt(text, doc, lyrics, manualChanged) {
    if (lyrics == null or lyrics.length != doc.scenes.length) {
        return { "error": "Each scene needs one lyric line.", "text": text };
    }
    var cleaned = [];
    for (var i = 0; i < lyrics.length; i = i + 1) {
        var line = cleanLyric(lyrics[i]);
        if (line == "") {
            return { "error": "Each scene needs one lyric line.", "text": text };
        }
        cleaned.append(line);
    }
    var withLyrics = replaceDreamLyrics(text, cleaned);
    if (withLyrics == "") {
        return { "error": "Could not find the dream lyrics in song-prompt.md.", "text": text };
    }
    var withDream = replaceDreamOrder(withLyrics, doc.scenes);
    if (withDream == "") {
        return { "error": "Could not find the dream order note in song-prompt.md.", "text": text };
    }
    var withCatalog = replaceOrderNote(withDream, "Catalog, in browse order:", "", captionSentence("Catalog, in browse order", doc.browse));
    if (withCatalog == "") {
        return { "error": "Could not find the catalog order note in song-prompt.md.", "text": text };
    }
    var withManual = withCatalog;
    if (manualChanged) {
        withManual = replaceOrderNote(withCatalog, "Manual, in page order:", "Manual:", captionSentence("Manual, in page order", doc.manual));
        if (withManual == "") {
            return { "error": "Could not find the manual order note in song-prompt.md.", "text": text };
        }
    }
    var withTime = replaceRuntimeLength(replaceSectionDurations(withManual, doc), int(doc.endMs));
    return { "error": "", "text": withTime };
}

function writeSongPrompt(doc, lyrics, manualChanged, baseText) {
    var text = io.readFile(promptPath);
    if (baseText != null and str.trim(string(baseText)) != "") {
        text = string(baseText);
    }
    var refreshed = refreshSongPrompt(text, doc, lyrics, manualChanged);
    if (refreshed.error != "") {
        return refreshed.error;
    }
    io.writeFile(promptPath, refreshed.text);
    return "";
}

function previewPrompt(doc, lyrics) {
    var raw = io.readFile(promptPath);
    if (lyrics.length != doc.scenes.length) {
        return replaceRuntimeLength(replaceSectionDurations(raw, doc), int(doc.endMs));
    }
    var refreshed = refreshSongPrompt(raw, doc, lyrics, false);
    if (refreshed.error != "") {
        return raw;
    }
    return refreshed.text;
}

function applyTimeline(doc, body) {
    var moved = applyListedOrder(doc, doc.browse, body.browseOrder, "browse cue");
    if (moved != "") {
        return moved;
    }
    moved = applyListedOrder(doc, doc.manual, body.manualOrder, "manual page");
    if (moved != "") {
        return moved;
    }
    moved = applyListedOrder(doc, doc.scenes, body.sceneOrder, "scene");
    if (moved != "") {
        return moved;
    }
    var problem = assignStarts(doc.browse, body.browse);
    if (problem != "") {
        return problem;
    }
    problem = assignStarts(doc.manual, body.manual);
    if (problem != "") {
        return problem;
    }
    problem = assignStarts(doc.scenes, body.scenes);
    if (problem != "") {
        return problem;
    }
    var endMs = toIntOrNull(body.endMs);
    if (endMs == null or endMs < 0) {
        return "The reel end must be a whole number of milliseconds.";
    }
    doc.endMs = endMs;
    return checkOrder(doc);
}

function jsonLine(indent, key, value, last) {
    var line = indent + toJSON(key) + ": " + value;
    if (not last) {
        line = line + ",";
    }
    return line;
}

function writeCue(cue, kind) {
    var lines = [];
    lines.append("    {");
    lines.append(jsonLine("      ", "file", toJSON(cue.file), false));
    if (kind == "manual" and cue.anchor != null and string(cue.anchor) != "") {
        lines.append(jsonLine("      ", "anchor", toJSON(cue.anchor), false));
    }
    lines.append(jsonLine("      ", "caption", toJSON(cue.caption), false));
    if (kind == "scene") {
        lines.append(jsonLine("      ", "panel", toJSON(cue.panel), false));
        var flag = "false";
        if (cue.maximize) {
            flag = "true";
        }
        lines.append(jsonLine("      ", "maximize", flag, false));
    }
    var hasFocus = cue.focusLine != null;
    lines.append(jsonLine("      ", "startMs", string(int(cue.startMs)), not hasFocus));
    if (hasFocus) {
        lines.append(jsonLine("      ", "focusLine", string(int(cue.focusLine)), true));
    }
    lines.append("    }");
    return str.join(lines, "\n");
}

function writeGroup(name, items, kind, last) {
    var parts = [];
    parts.append("  " + toJSON(name) + ": [");
    for (var i = 0; i < items.length; i = i + 1) {
        var block = writeCue(items[i], kind);
        if (i < items.length - 1) {
            block = block + ",";
        }
        parts.append(block);
    }
    var close = "  ]";
    if (not last) {
        close = close + ",";
    }
    parts.append(close);
    return str.join(parts, "\n");
}

function renderPlaylist(doc) {
    var chunks = [];
    chunks.append("{");
    chunks.append(jsonLine("  ", "width", string(int(doc.width)), false));
    chunks.append(jsonLine("  ", "height", string(int(doc.height)), false));
    chunks.append(jsonLine("  ", "left", string(int(doc.left)), false));
    chunks.append(jsonLine("  ", "top", string(int(doc.top)), false));
    chunks.append(jsonLine("  ", "splitBeatMs", string(int(doc.splitBeatMs)), false));
    chunks.append(jsonLine("  ", "readyTimeoutMs", string(int(doc.readyTimeoutMs)), false));
    chunks.append(jsonLine("  ", "endMs", string(int(doc.endMs)), false));
    chunks.append(writeGroup("browse", doc.browse, "browse", false));
    chunks.append(writeGroup("manual", doc.manual, "manual", false));
    chunks.append(writeGroup("scenes", doc.scenes, "scene", true));
    chunks.append("}");
    chunks.append("");
    return str.join(chunks, "\n");
}

function htmlText(value) {
    var text = string(value);
    text = str.join(str.split(text, "&"), "&amp;");
    text = str.join(str.split(text, "<"), "&lt;");
    text = str.join(str.split(text, ">"), "&gt;");
    return text;
}

function cueRow(kind, label, index, cue, lyric) {
    var file = htmlText(cue.file);
    var caption = htmlText(cue.caption);
    var start = string(int(cue.startMs));
    var indexText = string(index);
    var extra = "<div class='cue-bar'>" +
        "<button type='button' class='hear'>Hear</button>" +
        "<button type='button' class='nudge' data-delta='-1'>Earlier</button>" +
        "<button type='button' class='nudge' data-delta='1'>Later</button>";
    if (kind == "scenes") {
        extra = extra + "<textarea class='lyric' rows='1'>" + htmlText(lyric) + "</textarea>";
    }
    extra = extra + "</div>";
    return "<div class='cue " + kind + "' data-file='" + htmlText(cue.file) + "'>" +
        "<div class='meta'><span class='tag'>" + label + "</span><strong>" + caption + "</strong><span class='file'>" + file + "</span></div>" +
        "<input type='range' min='0' max='" + string(timelineMaxMs) + "' step='100' value='" + start + "' data-group='" + kind + "' data-index='" + indexText + "'>" +
        "<span class='readout'></span>" +
        extra +
        "</div>";
}

function cueRows(kind, label, items) {
    var html = "";
    for (var i = 0; i < items.length; i = i + 1) {
        html = html + cueRow(kind, label, i, items[i], "");
    }
    return html;
}

function sceneRows(items, lyrics) {
    var html = "";
    for (var i = 0; i < items.length; i = i + 1) {
        var lyric = "";
        if (i < lyrics.length) {
            lyric = lyrics[i];
        }
        html = html + cueRow("scenes", "Scene", i, items[i], lyric);
    }
    return html;
}

function editorScript() {
    return "(function(){" +
        "var gap=" + string(timelineGapMs) + ";" +
        "var endSlider=document.getElementById('endMs');" +
        "var track=document.getElementById('track');" +
        "var max=Number(endSlider.max);" +
        "var audio=document.getElementById('previewAudio');" +
        "var audioLabel='';" +
        "var stopTimer=null;" +
        "var playToken=0;" +
        "var applying=false;" +
        "function hearMs(){var n=Number(document.getElementById('hearSeconds').value);if(!isFinite(n)||n<1){n=3;}if(n>30){n=30;}return Math.round(n)*1000;}" +
        "function setAudioStatus(text){document.getElementById('audioName').textContent=text;}" +
        "function markPlaying(button){document.querySelectorAll('button.hear').forEach(function(el){el.classList.remove('playing');});if(button){button.classList.add('playing');}}" +
        "function stopPreview(){playToken=playToken+1;if(stopTimer){clearTimeout(stopTimer);stopTimer=null;}audio.pause();markPlaying(null);if(audioLabel){setAudioStatus(audioLabel);}}" +
        "function preview(row, button){" +
        "if(!audio.src){setAudioStatus('Choose a soundtrack first.');return;}" +
        "var ms=Number(row.querySelector('input[type=range]').value);" +
        "var start=ms/1000;" +
        "var token=playToken+1;playToken=token;" +
        "if(stopTimer){clearTimeout(stopTimer);stopTimer=null;}" +
        "audio.pause();" +
        "function begin(){" +
        "if(token!==playToken){return;}" +
        "if(isFinite(audio.duration)&&start>=audio.duration){markPlaying(null);setAudioStatus('That time is past the end of the track.');return;}" +
        "var started=false;" +
        "function arm(){" +
        "if(started||token!==playToken){return;}" +
        "started=true;" +
        "audio.removeEventListener('seeked', arm);" +
        "markPlaying(button);" +
        "var hold=hearMs();" +
        "setAudioStatus('Playing '+fmt(ms)+' for '+(hold/1000)+'s');" +
        "audio.play().catch(function(){markPlaying(null);setAudioStatus('Could not play that moment.');});" +
        "stopTimer=setTimeout(function(){if(token!==playToken){return;}audio.pause();markPlaying(null);setAudioStatus(audioLabel);}, hold);" +
        "}" +
        "audio.addEventListener('seeked', arm);" +
        "try{audio.currentTime=start;}catch(err){setAudioStatus('Could not play that moment.');return;}" +
        "if(Math.abs(audio.currentTime-start)<0.2){arm();}" +
        "}" +
        "if(audio.readyState>=1){begin();}else{audio.addEventListener('loadedmetadata', function onMeta(){audio.removeEventListener('loadedmetadata', onMeta);begin();});}" +
        "}" +
        "function cueInputs(){return [].slice.call(document.querySelectorAll('input[data-group]'));}" +
        "function rowsInGroup(group){return [].slice.call(document.querySelectorAll('.cue.'+group));}" +
        "function fmt(ms){var s=ms/1000;var m=Math.floor(s/60);var rem=s-m*60;var text=rem.toFixed(1);if(rem<10){text='0'+text;}return m+':'+text;}" +
        "function splitPrompt(text){var norm=String(text).split(String.fromCharCode(13)).join('');return norm.split(String.fromCharCode(10));}" +
        "function joinPrompt(lines){return lines.join(String.fromCharCode(10));}" +
        "function promptBox(){return document.getElementById('songPrompt');}" +
        "function setPrompt(next){var box=promptBox();if(!box||box.value===next){return;}var start=box.selectionStart;var end=box.selectionEnd;var focused=document.activeElement===box;box.value=next;if(focused){var max=next.length;box.selectionStart=Math.min(start,max);box.selectionEnd=Math.min(end,max);}}" +
        "function digitsOnly(value){if(!value){return false;}for(var i=0;i<value.length;i++){var ch=value.charAt(i);if(ch<'0'||ch>'9'){return false;}}return true;}" +
        "function roundedSeconds(ms){if(ms<0){ms=0;}return Math.round(ms/1000);}" +
        "function runtimePhrase(ms){var total=roundedSeconds(ms);var minutes=Math.floor(total/60);var seconds=total-minutes*60;if(minutes<=0){return 'About '+seconds+' seconds';}if(seconds===0){return minutes===1?'About 1 minute':'About '+minutes+' minutes';}return 'About '+minutes+' '+(minutes===1?'minute':'minutes')+' '+seconds+' seconds';}" +
        "function replaceHeading(text,label,seconds){var prefix='['+label+' – ';var at=text.indexOf(prefix);if(at<0){return text;}var numberAt=at+prefix.length;var end=text.indexOf(' seconds',numberAt);if(end<0){return text;}if(!digitsOnly(text.slice(numberAt,end))){return text;}return text.slice(0,numberAt)+seconds+text.slice(end);}" +
        "function looksLikeClock(span){if(!span){return false;}var saw=false;for(var i=0;i<span.length;i++){var ch=span.charAt(i);if(ch>='0'&&ch<='9'){saw=true;continue;}if(' minutes'.indexOf(ch)<0){return false;}}return saw;}" +
        "function replaceRuntime(text,ms){var marker='About ';var at=text.indexOf(marker);if(at<0){return text;}var from=at+marker.length;var endWord=text.indexOf('seconds',from);if(endWord<0){return text;}if(!looksLikeClock(text.slice(from,endWord))){return text;}return text.slice(0,at)+runtimePhrase(ms)+text.slice(endWord+'seconds'.length);}" +
        "function groupStart(group){var rows=rowsInGroup(group);if(!rows.length){return 0;}return Number(rows[0].querySelector('input[type=range]').value);}" +
        "function syncDurations(){var box=promptBox();if(!box){return;}var text=box.value;var browse=groupStart('browse');var manual=groupStart('manual');var scene=groupStart('scenes');var end=Number(endSlider.value);text=replaceHeading(text,'Intro',roundedSeconds(browse));text=replaceHeading(text,'Catalog',roundedSeconds(manual-browse));text=replaceHeading(text,'Manual',roundedSeconds(scene-manual));text=replaceHeading(text,'Dream',roundedSeconds(end-scene));text=replaceRuntime(text,end);setPrompt(text);}" +
        "function paragraphAt(text,prefixes){var lines=splitPrompt(text);var start=-1;for(var i=0;i<lines.length;i++){for(var p=0;p<prefixes.length;p++){if(lines[i].indexOf(prefixes[p])===0){start=i;break;}}if(start>=0){break;}}if(start<0){return '';}var end=start+1;while(end<lines.length&&lines[end].trim()!==''){end++;}return lines.slice(start,end).join(String.fromCharCode(10));}" +
        "function replaceParagraph(text,prefixes,sentence){var lines=splitPrompt(text);var start=-1;for(var i=0;i<lines.length;i++){for(var p=0;p<prefixes.length;p++){if(lines[i].indexOf(prefixes[p])===0){start=i;break;}}if(start>=0){break;}}if(start<0){return text;}var end=start+1;while(end<lines.length&&lines[end].trim()!==''){end++;}var next=lines.slice(0,start);splitPrompt(sentence).forEach(function(line){next.push(line);});for(var k=end;k<lines.length;k++){next.push(lines[k]);}return joinPrompt(next);}" +
        "function extractDream(text){var lines=splitPrompt(text);var inDream=false;var inLines=false;var lyrics=[];for(var i=0;i<lines.length;i++){var line=lines[i];if(line.indexOf('[Dream')===0){inDream=true;inLines=false;}else if(inDream&&line.indexOf('[Outro')===0){break;}else if(inDream&&line.indexOf('[Female voice]')===0){inLines=true;}else if(inLines&&line.trim()!==''){lyrics.push(line.trim());}}return lyrics;}" +
        "function replaceDream(text,lyrics){var lines=splitPrompt(text);var voice=-1;var inDream=false;for(var i=0;i<lines.length;i++){if(lines[i].indexOf('[Dream')===0){inDream=true;}else if(inDream&&lines[i].indexOf('[Female voice]')===0){voice=i;break;}}if(voice<0){return text;}var start=voice+1;var end=start;while(end<lines.length){if(lines[end].trim()===''||lines[end].indexOf('[')===0){break;}end++;}var next=lines.slice(0,start);for(var j=0;j<lyrics.length;j++){next.push(lyrics[j]);}for(var k=end;k<lines.length;k++){next.push(lines[k]);}return joinPrompt(next);}" +
        "function oneLine(value){var text=splitPrompt(value).join(' ');var collapsed='';var prev='';for(var i=0;i<text.length;i++){var ch=text.charAt(i);if(ch===' '&&prev===' '){continue;}collapsed=collapsed+ch;prev=ch;}return collapsed.trim();}" +
        "function sceneLyricLines(){return rowsInGroup('scenes').map(function(row){return oneLine(row.querySelector('.lyric').value);});}" +
        "function syncLyrics(){if(applying){return;}applying=true;setPrompt(replaceDream(promptBox().value,sceneLyricLines()));applying=false;}" +
        "function fileOrder(group){return rowsInGroup(group).map(function(row){return row.getAttribute('data-file');}).join('|');}" +
        "function captions(group){return rowsInGroup(group).map(function(row){return row.querySelector('strong').textContent;});}" +
        "function syncOrderNotes(){var text=promptBox().value;text=replaceParagraph(text,['Catalog, in browse order:'],'Catalog, in browse order: '+captions('browse').join(', ')+'.');text=replaceParagraph(text,['Dream, in scene order:'],'Dream, in scene order: '+captions('scenes').join(', ')+'.');if(fileOrder('manual')!==initialManual){text=replaceParagraph(text,['Manual, in page order:','Manual:'],'Manual, in page order: '+captions('manual').join(', ')+'.');}else if(originalManualNote){text=replaceParagraph(text,['Manual, in page order:','Manual:'],originalManualNote);}setPrompt(text);}" +
        "function paint(){" +
        "var inputs=cueInputs();" +
        "inputs.forEach(function(el){el.parentNode.querySelector('.readout').textContent=fmt(Number(el.value))+'  '+el.value+' ms';});" +
        "document.getElementById('endReadout').textContent=fmt(Number(endSlider.value))+'  '+endSlider.value+' ms';" +
        "track.innerHTML='';" +
        "inputs.forEach(function(el){var mark=document.createElement('i');mark.className=el.getAttribute('data-group');mark.style.left=(Number(el.value)/max*100)+'%';mark.title=el.parentNode.querySelector('strong').textContent;track.appendChild(mark);});" +
        "var endMark=document.createElement('i');endMark.className='end';endMark.style.left=(Number(endSlider.value)/max*100)+'%';track.appendChild(endMark);" +
        "syncDurations();" +
        "}" +
        "function ripple(index){" +
        "var inputs=cueInputs();" +
        "var value=Number(inputs[index].value);" +
        "if(index>0){var prev=Number(inputs[index-1].value);if(value<prev+gap){value=prev+gap;}}" +
        "inputs[index].value=String(value);" +
        "for(var j=index+1;j<inputs.length;j++){var earlier=Number(inputs[j-1].value);if(Number(inputs[j].value)<earlier+gap){inputs[j].value=String(earlier+gap);}}" +
        "var last=Number(inputs[inputs.length-1].value);" +
        "if(Number(endSlider.value)<last+gap){endSlider.value=String(last+gap);}" +
        "paint();" +
        "}" +
        "cueInputs().forEach(function(el){el.addEventListener('input', function(){ripple(cueInputs().indexOf(el));});});" +
        "endSlider.addEventListener('input', function(){var inputs=cueInputs();var last=Number(inputs[inputs.length-1].value);if(Number(endSlider.value)<last+gap){endSlider.value=String(last+gap);}paint();});" +
        "document.getElementById('trackFile').addEventListener('change', function(){" +
        "var file=this.files&&this.files[0];" +
        "stopPreview();" +
        "if(!file){audioLabel='';audio.removeAttribute('src');setAudioStatus('Choose the song to hear 3 seconds from each cue.');return;}" +
        "if(audio.src){URL.revokeObjectURL(audio.src);}" +
        "audio.src=URL.createObjectURL(file);" +
        "audioLabel=file.name;" +
        "setAudioStatus(file.name);" +
        "});" +
        "audio.addEventListener('ended', function(){if(stopTimer){clearTimeout(stopTimer);stopTimer=null;}markPlaying(null);if(audioLabel){setAudioStatus(audioLabel);}});" +
        "document.body.addEventListener('click', function(event){" +
        "var hear=event.target.closest('button.hear');" +
        "if(hear){preview(hear.closest('.cue'), hear);return;}" +
        "var button=event.target.closest('button.nudge');" +
        "if(!button){return;}" +
        "var row=button.closest('.cue');" +
        "var group=row.querySelector('input[data-group]').getAttribute('data-group');" +
        "var rows=rowsInGroup(group);" +
        "var index=rows.indexOf(row);" +
        "var delta=Number(button.getAttribute('data-delta'));" +
        "var dest=index+delta;" +
        "if(dest<0||dest>=rows.length){return;}" +
        "var times=rows.map(function(item){return item.querySelector('input[type=range]').value;});" +
        "if(delta<0){row.parentNode.insertBefore(row, rows[dest]);}else{row.parentNode.insertBefore(row, rows[dest].nextSibling);}" +
        "rowsInGroup(group).forEach(function(item, slot){item.querySelector('input[type=range]').value=times[slot];});" +
        "paint();" +
        "syncLyrics();" +
        "syncOrderNotes();" +
        "});" +
        "document.body.addEventListener('input', function(event){" +
        "var target=event.target;if(!target){return;}" +
        "if(target.classList&&target.classList.contains('lyric')){syncLyrics();return;}" +
        "if(target.id!=='songPrompt'||applying){return;}" +
        "var lyrics=extractDream(target.value);var rows=rowsInGroup('scenes');if(lyrics.length!==rows.length){return;}" +
        "applying=true;rows.forEach(function(row,i){row.querySelector('.lyric').value=lyrics[i];});applying=false;" +
        "});" +
        "document.getElementById('save').addEventListener('click', function(){" +
        "var body={browse:[],manual:[],scenes:[],browseOrder:[],manualOrder:[],sceneOrder:[],lyrics:[],prompt:promptBox().value,endMs:Number(endSlider.value)};" +
        "cueInputs().forEach(function(el){body[el.getAttribute('data-group')].push(Number(el.value));});" +
        "rowsInGroup('browse').forEach(function(row){body.browseOrder.push(row.getAttribute('data-file'));});" +
        "rowsInGroup('manual').forEach(function(row){body.manualOrder.push(row.getAttribute('data-file'));});" +
        "rowsInGroup('scenes').forEach(function(row){body.sceneOrder.push(row.getAttribute('data-file'));body.lyrics.push(row.querySelector('.lyric').value);});" +
        "var status=document.getElementById('status');status.textContent='Saving…';" +
        "fetch('/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(function(res){return res.text();}).then(function(text){" +
        "var data=JSON.parse(text);if(data.ok){location.href='/?saved=1';return;}status.textContent=data.error||'Could not save.';}).catch(function(){status.textContent='Could not reach the editor.';});" +
        "});" +
        "var initialManual=fileOrder('manual');" +
        "var originalManualNote=paragraphAt(promptBox().value,['Manual, in page order:','Manual:']);" +
        "paint();" +
        "})();";
}

function editorPageHtml(doc, lyrics, saved, promptText) {
    var banner = "";
    if (saved == "1") {
        banner = "<p class='ok'>Saved the playlist and the song prompt. Play the showcase again to hear the new cuts.</p>";
    }
    if (lyrics.length != doc.scenes.length) {
        banner = banner + "<p class='warn'>The dream lyric count does not match the scenes. Fill one line per scene before saving.</p>";
    }
    var rows = cueRows("browse", "Browse", doc.browse) +
        cueRows("manual", "Manual", doc.manual) +
        sceneRows(doc.scenes, lyrics);
    var endValue = string(int(doc.endMs));
    var css = "body{margin:0;font:15px/1.4 system-ui,sans-serif;background:#12141c;color:#e7e9f2}" +
        "main{max-width:1180px;margin:0 auto;padding:28px 20px 48px}" +
        "h1{font-size:22px;font-weight:600;margin:0 0 8px}" +
        "h2{font-size:16px;font-weight:600;margin:0 0 6px}" +
        ".layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,440px);gap:28px;align-items:start}" +
        ".prompt-panel{position:sticky;top:12px}" +
        ".prompt-panel p.lead{margin:0 0 8px;font-size:13px}" +
        "#songPrompt{width:100%;height:calc(100vh - 188px);min-height:280px;box-sizing:border-box;resize:vertical;background:#1c2230;color:#e7e9f2;border:1px solid #2a3144;border-radius:8px;padding:12px;font:12.5px/1.45 ui-monospace,Consolas,monospace}" +
        "@media (max-width:980px){.layout{grid-template-columns:1fr}.prompt-panel{position:static}#songPrompt{height:420px}}" +
        "p.lead,p.ok{color:#b7bfd4}p.ok{color:#8ddec4}" +
        ".track{position:relative;height:28px;margin:18px 0 28px;border-radius:999px;background:#232838}" +
        ".track i{position:absolute;top:6px;width:3px;height:16px;border-radius:2px;background:#7aa2ff}" +
        ".track i.manual{background:#e2b15a}.track i.scenes{background:#7dcea0}.track i.end{background:#f2f4fb;height:22px;top:3px}" +
        ".cue{display:grid;grid-template-columns:220px 1fr 108px;gap:12px;align-items:center;padding:8px 0;border-top:1px solid #2a3144}" +
        ".cue-bar{grid-column:1 / -1;display:flex;gap:8px;align-items:center}" +
        ".meta{display:flex;flex-direction:column;min-width:0}.meta strong{font-weight:600}.file{color:#8b93a8;font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}" +
        ".tag{font-size:11px;letter-spacing:.04em;text-transform:uppercase;color:#8b93a8}" +
        "input[type=range]{width:100%;accent-color:#8eb0ff}.readout{font-variant-numeric:tabular-nums;color:#d5dbeb;font-size:13px}" +
        ".lyric{flex:1;min-height:34px;resize:vertical;background:#1c2230;color:#e7e9f2;border:1px solid #2a3144;border-radius:6px;padding:6px 8px;font:inherit}" +
        ".end-row{margin-top:18px}.actions{display:flex;gap:12px;align-items:center;margin-top:12px;flex-wrap:wrap}" +
        "button{background:#e7e9f2;color:#12141c;border:0;border-radius:8px;padding:8px 14px;font:inherit;font-weight:600}" +
        "button.nudge{background:#232838;color:#e7e9f2}" +
        "button.hear{background:#1d3a32;color:#d7f5ea}button.hear.playing{background:#8ddec4;color:#12141c}" +
        ".audio{display:flex;gap:12px;align-items:center;margin:8px 0 4px;color:#b7bfd4}" +
        "#hearSeconds{width:72px;background:#1c2230;color:#e7e9f2;border:1px solid #2a3144;border-radius:6px;padding:6px 8px;font:inherit}" +
        "#audioName{color:#8b93a8;font-size:13px}input[type=file]{color:#b7bfd4}" +
        "#status{color:#f0c3c3}p.warn{color:#e2b15a}";
    return "<!DOCTYPE html><html><head><meta charset='utf-8'><title>Showcase timeline</title><style>" + css + "</style></head><body><main>" +
        "<h1>Showcase timeline</h1>" +
        "<p class='lead'>Times run from the splash. A cue stays up until the next slider. Earlier and Later reorder the example browser, the manual, and the scenes inside their own tour. A scene lyric moves with that scene. The song prompt stays aligned with this page. Hear plays the soundtrack from that cue for the number of seconds next to the soundtrack.</p>" +
        banner +
        "<div class='audio'><label for='trackFile'>Soundtrack</label><input id='trackFile' type='file' accept='audio/*'><label for='hearSeconds'>Seconds</label><input id='hearSeconds' type='number' min='1' max='30' step='1' value='3'><span id='audioName'>Choose the song. Hear uses the seconds field.</span></div>" +
        "<audio id='previewAudio'></audio>" +
        "<div class='layout'><div>" +
        "<div class='track' id='track'></div>" +
        rows +
        "<div class='cue end-row'><div class='meta'><span class='tag'>End</span><strong>Reel ends</strong></div>" +
        "<input id='endMs' type='range' min='0' max='" + string(timelineMaxMs) + "' step='100' value='" + endValue + "'>" +
        "<span class='readout' id='endReadout'></span></div>" +
        "</div><aside class='prompt-panel'>" +
        "<h2>Song prompt</h2>" +
        "<p class='lead'>Section lengths, dream lines, and the order notes follow this page. Edit the style and the sung lines here. Save writes song-prompt.md.</p>" +
        "<textarea id='songPrompt' spellcheck='false'>" + htmlText(promptText) + "</textarea>" +
        "<div class='actions'><button id='save' type='button'>Save</button><span id='status'></span></div>" +
        "</aside></div>" +
        "</main><script>" + editorScript() + "</script></body></html>";
}

@PAGE("/")
function timelinePage(saved) {
    var doc = loadPlaylist();
    var lyrics = extractDreamLyrics(io.readFile(promptPath));
    return editorPageHtml(doc, lyrics, saved, previewPrompt(doc, lyrics));
}

@POST("/save")
function saveTimeline(body) {
    if (body == null) {
        return "{\"ok\":false,\"error\":" + toJSON("Missing timeline.") + "}";
    }
    var doc = loadPlaylist();
    var manualBefore = fileList(doc.manual);
    var problem = applyTimeline(doc, body);
    if (problem != "") {
        return "{\"ok\":false,\"error\":" + toJSON(problem) + "}";
    }
    if (body.prompt != null and str.trim(string(body.prompt)) == "") {
        return "{\"ok\":false,\"error\":" + toJSON("The song prompt is empty.") + "}";
    }
    if (body.lyrics != null) {
        var promptBase = null;
        if (body.prompt != null) {
            promptBase = string(body.prompt);
        }
        var lyricProblem = writeSongPrompt(doc, body.lyrics, not sameOrder(manualBefore, fileList(doc.manual)), promptBase);
        if (lyricProblem != "") {
            return "{\"ok\":false,\"error\":" + toJSON(lyricProblem) + "}";
        }
    }
    io.writeFile(playlistPath, renderPlaylist(doc));
    return "{\"ok\":true}";
}

if (io.getEnvOr("MALDA_TIMELINE_SELFTEST") == "1") {
    var original = loadPlaylist();
    var rendered = parseJSON(renderPlaylist(original));
    if (int(rendered.browse[0].startMs) != int(original.browse[0].startMs)) {
        io.print("browse start was not preserved");
        exit(1);
    }
    if (rendered.manual[4].anchor != "declarative-agent-teams") {
        io.print("manual anchor was not preserved");
        exit(1);
    }
    if (int(rendered.scenes[5].focusLine) != int(original.scenes[5].focusLine)) {
        io.print("scene focus line was not preserved");
        exit(1);
    }
    if (rendered.scenes[0].maximize) {
        io.print("maximize false was not preserved");
        exit(1);
    }
    if (checkOrder(original) != "") {
        io.print("the checked-in playlist is out of order");
        exit(1);
    }
    var broken = loadPlaylist();
    broken.browse[1].startMs = broken.browse[0].startMs;
    if (checkOrder(broken) == "") {
        io.print("equal starts were accepted");
        exit(1);
    }
    var promptText = io.readFile(promptPath);
    var dream = extractDreamLyrics(promptText);
    if (dream.length != original.scenes.length) {
        io.print("dream lyric count does not match the scenes");
        exit(1);
    }
    if (dream[0] != "Printed clean.") {
        io.print("first dream lyric was not preserved");
        exit(1);
    }
    var swappedLyrics = [];
    swappedLyrics.append(dream[1]);
    swappedLyrics.append(dream[0]);
    for (var lyricIndex = 2; lyricIndex < dream.length; lyricIndex = lyricIndex + 1) {
        swappedLyrics.append(dream[lyricIndex]);
    }
    var rewritten = replaceDreamLyrics(promptText, swappedLyrics);
    var rewrittenDream = extractDreamLyrics(rewritten);
    if (rewrittenDream[0] != dream[1] or rewrittenDream[1] != dream[0]) {
        io.print("dream lyrics did not follow the scene swap");
        exit(1);
    }
    var moved = loadPlaylist();
    var sceneOrder = [];
    sceneOrder.append(moved.scenes[1].file);
    sceneOrder.append(moved.scenes[0].file);
    for (var sceneIndex = 2; sceneIndex < moved.scenes.length; sceneIndex = sceneIndex + 1) {
        sceneOrder.append(moved.scenes[sceneIndex].file);
    }
    if (reorderScenes(moved, sceneOrder) != "") {
        io.print("scene reorder failed");
        exit(1);
    }
    if (moved.scenes[0].file != original.scenes[1].file) {
        io.print("scene order did not change");
        exit(1);
    }
    var orderNote = replaceDreamOrder(promptText, moved.scenes);
    if (orderNote == "" or str.indexOf(orderNote, "Dream, in scene order: " + moved.scenes[0].caption) < 0) {
        io.print("dream order note was not rewritten");
        exit(1);
    }
    var browseMoved = loadPlaylist();
    var browseOrder = [];
    browseOrder.append(browseMoved.browse[1].file);
    browseOrder.append(browseMoved.browse[0].file);
    for (var browseIndex = 2; browseIndex < browseMoved.browse.length; browseIndex = browseIndex + 1) {
        browseOrder.append(browseMoved.browse[browseIndex].file);
    }
    if (applyListedOrder(browseMoved, browseMoved.browse, browseOrder, "browse cue") != "") {
        io.print("browse reorder failed");
        exit(1);
    }
    if (int(browseMoved.browse[0].focusLine) != 13) {
        io.print("browse focus line did not move with the example");
        exit(1);
    }
    var catalogNote = replaceOrderNote(promptText, "Catalog, in browse order:", "", captionSentence("Catalog, in browse order", browseMoved.browse));
    if (catalogNote == "" or str.indexOf(catalogNote, "Catalog, in browse order: Schemas") < 0) {
        io.print("catalog order note was not rewritten");
        exit(1);
    }
    var manualMoved = loadPlaylist();
    var manualOrder = [];
    for (var manualIndex = 0; manualIndex < 3; manualIndex = manualIndex + 1) {
        manualOrder.append(manualMoved.manual[manualIndex].file);
    }
    manualOrder.append(manualMoved.manual[4].file);
    manualOrder.append(manualMoved.manual[3].file);
    manualOrder.append(manualMoved.manual[5].file);
    if (applyListedOrder(manualMoved, manualMoved.manual, manualOrder, "manual page") != "") {
        io.print("manual reorder failed");
        exit(1);
    }
    if (manualMoved.manual[3].anchor != "declarative-agent-teams") {
        io.print("manual anchor did not move with the page");
        exit(1);
    }
    var manualNote = replaceOrderNote(promptText, "Manual, in page order:", "Manual:", captionSentence("Manual, in page order", manualMoved.manual));
    if (manualNote == "" or str.indexOf(manualNote, "Manual, in page order:") < 0 or str.indexOf(manualNote, "Multi-agent") < 0) {
        io.print("manual order note was not rewritten");
        exit(1);
    }
    if (roundedSeconds(59700) != 60 or roundedSeconds(4500) != 5 or roundedSeconds(95600) != 96) {
        io.print("rounded seconds are off");
        exit(1);
    }
    var refreshed = refreshSongPrompt(promptText, original, dream, false);
    if (refreshed.error != "") {
        io.print(refreshed.error);
        exit(1);
    }
    if (str.indexOf(refreshed.text, "60 seconds, same tempo") < 0) {
        io.print("dream duration was not updated");
        exit(1);
    }
    if (str.indexOf(refreshed.text, "5 seconds, pads only") < 0 or str.indexOf(refreshed.text, "19 seconds, one continuous") < 0) {
        io.print("intro or catalog duration was not kept");
        exit(1);
    }
    if (str.indexOf(refreshed.text, "About 1 minute 36 seconds") < 0) {
        io.print("runtime length was not updated");
        exit(1);
    }
    if (str.indexOf(refreshed.text, "Many agents, one objective") < 0) {
        io.print("manual note was rewritten without a reorder");
        exit(1);
    }
    if (str.indexOf(refreshed.text, "[Outro") < 0 or str.indexOf(refreshed.text, "soft dream-pop") < 0) {
        io.print("prompt body was dropped");
        exit(1);
    }
    var custom = str.replace(promptText, "airy and melodic", "airy and melodic, edited");
    var kept = refreshSongPrompt(custom, original, dream, false);
    if (kept.error != "" or str.indexOf(kept.text, "airy and melodic, edited") < 0) {
        io.print("prompt edits were dropped");
        exit(1);
    }
    var manualRefreshed = refreshSongPrompt(promptText, manualMoved, dream, true);
    if (manualRefreshed.error != "" or str.indexOf(manualRefreshed.text, "Manual, in page order: ") < 0 or str.indexOf(manualRefreshed.text, "Multi-agent") < 0) {
        io.print("manual reorder did not refresh the song prompt");
        exit(1);
    }
    var preview = previewPrompt(original, dream);
    var page = editorPageHtml(original, dream, "", preview);
    if (str.indexOf(page, "class='hear'") < 0 or str.indexOf(page, "id='trackFile'") < 0 or str.indexOf(page, "id='hearSeconds'") < 0 or str.indexOf(page, "value='3'") < 0) {
        io.print("soundtrack preview controls are missing");
        exit(1);
    }
    if (str.indexOf(page, "id='songPrompt'") < 0 or str.indexOf(page, "About 1 minute 36 seconds") < 0 or str.indexOf(page, "Printed clean.") < 0 or str.indexOf(page, "prompt:promptBox().value") < 0) {
        io.print("song prompt preview is missing");
        exit(1);
    }
    io.print("timeline editor self-test ok");
    exit(0);
}

var server = new HttpServer(8094);
server.start();
io.print("Showcase timeline editor: http://localhost:8094/");
io.print("Playlist: " + playlistPath);

while (server.isRunning) {
    sleep(1000);
}
