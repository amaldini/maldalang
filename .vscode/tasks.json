{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run current MALDA file",
      "type": "process",
      "command": "${config:malda.cli.path}",
      "windows": {
        "command": "${config:malda.cli.path}"
      },
      "args": ["${file}"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
