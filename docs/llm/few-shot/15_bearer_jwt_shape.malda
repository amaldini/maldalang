// Bearer JWT shape: createJwt/verifyJwt offline, plus RestServer middleware form.
// Full long-running server: Examples/Web/rest_bearer_jwt.malda

var jwtSecret = "dev-only-jwt-secret-change-me";

var token = createJwt({
    "sub": "alice",
    "role": "user"
}, jwtSecret, {
    "expiresInSeconds": 120,
    "issuer": "malda-fewshot",
    "audience": "malda-api"
});

var claims = verifyJwt(token, jwtSecret);
io.print($"sub={claims.sub} role={claims.role}");

// Middleware shape (wire with server.use(requireAuth, { "except": ["/api/login"] })):
function requireAuth(req, res, next) {
    req.auth.authenticateBearerJwt(jwtSecret);
    next();
}

@POST("/api/login")
function login(body) {
    // Issue a token after verifying credentials (hashPassword / verifyPassword).
    return {
        "token": createJwt({ "sub": body.username, "role": "user" }, jwtSecret, 3600),
        "tokenType": "Bearer"
    };
}

@GET("/api/profile")
function profile(req) {
    return {
        "sub": req.auth.sub,
        "role": req.auth.claim("role", "user")
    };
}

// Intentionally no RestServer.start() here — this file is a shape + offline JWT smoke.
io.print("bearer shape ready (server not started)");
