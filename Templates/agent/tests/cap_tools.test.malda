// Run from the project root: malda test
// Discovery finds tests/*.test.malda. Include the shared helper; mint notes/ beside app.malda.
include "../tools.malda";

var notesRoot = cap.fileRead(io.pathJoin(getProgramDirectory(), "..", "notes"));

var welcome = str.trim(readNoteWith(notesRoot, "welcome.txt"));
assert(welcome == "Welcome to your MALDA agent workspace.", "welcome note should be readable under notes/");

var escaped = false;
try {
    readNoteWith(notesRoot, "../secret.txt");
} catch (e) {
    escaped = true;
}
assert(escaped, "cap.confine should reject a path that escapes notes/");

var forged = false;
try {
    cap.read({ "kind": "fileRead", "path": io.pathJoin(getProgramDirectory(), "..", "notes", "welcome.txt") });
} catch (e) {
    forged = true;
}
assert(forged, "cap.read should reject a forged { kind, path } dict");

var http = cap.httpGet("https://example.com/docs");
assert(pageWith(http, "guide").path == "https://example.com/docs/guide", "http confine should join a relative path");
var httpEscaped = false;
try {
    pageWith(http, "https://evil.com");
} catch (e) {
    httpEscaped = true;
}
assert(httpEscaped, "cap.confine should reject an HTTP origin escape");

var mcp = cap.mcpCall("local");
assert(mcpToolWith(mcp, "add").name == "add", "mcp confine should set the tool name");

var shell = cap.shell("git");
assert(shellWith(shell, "status").path == "git status", "shell confine should append argv");
var shellEscaped = false;
try {
    shellWith(shell, "..");
} catch (e) {
    shellEscaped = true;
}
assert(shellEscaped, "cap.confine should reject a shell .. escape");
