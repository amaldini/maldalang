{{#LOCAL_FIRST}}
include "data/local_first.malda";
{{/LOCAL_FIRST}}

var api = new RestServer();
var web = new HttpServer(8080);
var ticketsStateId = "tickets-board";

var jwtSecret = getEnv("MALDA_JWT_SECRET");
if (jwtSecret == null or jwtSecret == "") {
    jwtSecret = "change-me-jwt-secret";
}
var csrfSecret = getEnv("MALDA_CSRF_SECRET");
if (csrfSecret == null or csrfSecret == "") {
    csrfSecret = "change-me-csrf-secret";
}
var sessionSecret = getEnv("MALDA_SESSION_SECRET");
if (sessionSecret == null or sessionSecret == "") {
    sessionSecret = "change-me-session-secret";
}

function htmlLayout(title, content) {
    var helper = "<script>(function(){document.querySelectorAll('form').forEach(function(form){if(form.dataset.splAjaxBound==='1')return;form.dataset.splAjaxBound='1';form.addEventListener('submit',async function(e){e.preventDefault();var fd=new FormData(form);var r=await fetch(form.action||window.location.pathname,{method:'POST',body:fd,headers:{'X-CSRF-Token':(fd.get('_csrf')||'')}});var html=await r.text();var isFrag=(r.headers.get('X-Malda-Fragment')||'').toLowerCase()==='true';var target=r.headers.get('X-Malda-Fragment-Target');if(isFrag&&target&&document.getElementById(target)){document.getElementById(target).innerHTML=html;return;}document.body.innerHTML=html;});});var es=new EventSource('/components/tickets/live?channel=tickets');es.onmessage=function(evt){console.log('tickets live',evt.data);};})();</script>";
    return pageLayout(title, content + helper, {
        "css": "body{font-family:system-ui,sans-serif;max-width:720px;margin:32px auto;padding:0 16px}input,button{padding:8px;margin:4px 0}.error-list{color:#a11}"
    });
}

function requireAuth(req, res, next) {
    req.auth.authenticateBearerJwt(jwtSecret);
    next();
}

@GET("/api/health")
function health() {
    return {
        "app": "__PROJECT_NAME__",
        "appSlug": "__PROJECT_SLUG__",
        "status": "ok"
    };
}

@GET("/api/readiness")
function readiness() {
    return {
        "app": "__PROJECT_NAME__",
        "status": "ready"
        {{#LOCAL_FIRST}},
        "storage": "sqlite-local"
        {{/LOCAL_FIRST}}
    };
}

@GET("/metrics")
function metrics() {
    return {
        "name": "__PROJECT_NAME__",
        "requests_total": 0
    };
}

@GET("/api/me")
function me(req) {
    return {
        "verified": req.auth.verified,
        "sub": req.auth.sub,
        "role": req.auth.claim("role", "user"),
        "isAdmin": req.auth.hasRole("admin")
    };
}

{{#LOCAL_FIRST}}
@GET("/api/data/status")
function dataStatus() {
    return getLocalDataPlatformStatus();
}
{{/LOCAL_FIRST}}

component TicketBoard() {
    {{#LOCAL_FIRST}}
    var tickets = listLocalTickets();
    {{/LOCAL_FIRST}}
    {{^LOCAL_FIRST}}
    var tickets = componentStateGet(ticketsStateId, "items", []);
    {{/LOCAL_FIRST}}
    var items = "";
    var i = 0;
    while (i < tickets.length) {
        var t = tickets[i];
        items = items + "<li><strong>" + t.title + "</strong> - " + t.status + "</li>";
        i = i + 1;
    }
    if (items == "") {
        items = "<li>No tickets yet</li>";
    }

    var notice = "";
    // Flash is available when the page is served through a request that binds req;
    // component render may not have session — keep empty notice here.

    var page = "<h1>__PROJECT_NAME__ Ticket Board</h1>";
    {{#LOCAL_FIRST}}
    page = page + "<p>Storage: SQLite local-first starter with migration bootstrap.</p>";
    {{/LOCAL_FIRST}}
    page = page + notice;
    page = page + "<form method='POST' action='/components/addTicket/action'>";
    page = page + csrfField(csrfSecret);
    page = page + "<input name='title' placeholder='Ticket title' />";
    page = page + "<button type='submit'>Add</button>";
    page = page + "</form>";
    page = page + "<div id='ticket-list'><ul>" + items + "</ul></div>";
    page = page + "<p>Live endpoint: <code>/components/tickets/live?channel=tickets</code> (SSE)</p>";
    return htmlLayout("__PROJECT_NAME__", page);
}

@ACTION("/components/addTicket/action")
function addTicketAction(req, res, body) {
    var form = bindForm(body, [
        {"name": "title", "required": true, "trim": true, "minLength": 1, "maxLength": 120}
    ]);
    if (not form.ok) {
        return componentFragment("ticket-list", formErrors(form.errors));
    }

    var title = form.values.title;
    {{#LOCAL_FIRST}}
    insertLocalTicket(title);
    var tickets = listLocalTickets();
    {{/LOCAL_FIRST}}
    {{^LOCAL_FIRST}}
    var tickets = componentStateGet(ticketsStateId, "items", []);
    tickets.append({"title": title, "status": "open"});
    componentStateSet(ticketsStateId, "items", tickets);
    {{/LOCAL_FIRST}}

    var items = "";
    var i = 0;
    while (i < tickets.length) {
        var t = tickets[i];
        items = items + "<li><strong>" + t.title + "</strong> - " + t.status + "</li>";
        i = i + 1;
    }
    componentLiveEmit("tickets", {"count": tickets.length}, "ticket-added");
    return componentFragment("ticket-list", "<ul>" + items + "</ul>");
}

@LIVE("/components/tickets/live")
function ticketsLive() {
    return {"sse": true};
}

{{#LOCAL_FIRST}}
initLocalDataPlatform();
{{/LOCAL_FIRST}}

web.mount(api);
web.enableSession(sessionSecret);
// CSRF protects Rest API mutations; HTML forms include csrfField for the same secret
// when you also enableCsrf on the HttpServer and set the csrf_token cookie to match.
api.enableCsrf(csrfSecret);
api.setRateLimit(200, 60, "verifiedSubOrIp");
api.setRateLimitHeaders(true, true);
api.use(requireAuth, {
    "except": ["/api/health", "/api/readiness", "/metrics"]
});
web.start();
print("__PROJECT_NAME__ fullstack at http://localhost:8080/");
