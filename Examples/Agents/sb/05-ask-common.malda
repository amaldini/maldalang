// sb/05-ask-common.malda — lexical scorer + shared ASK turn
// Host must define selectNotesForAsk, afterNoteSelection, prepareAskMemory, askModeRetrievalLabel, hostAskToolsOnLabel, hostAskToolExtraInstructions.

function metadataScore(questionTokens, note) {
    var haystack = str.lower(note.title + " " + note.topic + " " +
        str.join(note.tags, " ") + " " + note.summary + " " + str.join(note.headings, " "));
    var haystackTokens = str.tokenize(haystack);
    var titleTokens = str.tokenize(str.lower(note.title + " " + str.join(note.tags, " ")));
    var score = 0.0;
    foreach (var token in questionTokens) {
        if (str.length(token) < 3) {
            continue;
        }
        if (str.includes(haystackTokens, token)) {
            score = score + 1.0;
        } else if (str.indexOf(haystack, token) >= 0) {
            score = score + 0.5;
        }
        if (str.includes(titleTokens, token)) {
            score = score + 1.0;
        }
    }
    return score;
}

function bodyScore(brainDir, questionTokens, note) {
    var path = sbJoinUnderRoot(brainDir, note.path);
    if (path == null or not io.hasFile(path)) {
        return 0.0;
    }
    var body = "";
    try {
        body = str.lower(io.readFile(path));
    } catch (e) {
        return 0.0;
    }
    var bodyTokens = str.tokenize(body);
    var score = 0.0;
    foreach (var token in questionTokens) {
        if (str.length(token) < 3) {
            continue;
        }
        if (str.includes(bodyTokens, token)) {
            score = score + 0.5;
        }
    }
    return score;
}

function selectNotes(brainDir, catalog, question, tagFilter) {
    var questionTokens = str.tokenize(str.lower(question));
    var scored = [];
    var best = 0.0;
    foreach (var note in catalog.notes) {
        if (tagFilter != null and tagFilter.length > 0 and
                not askNoteMatchesTagFilter(note, tagFilter)) {
            continue;
        }
        var score = metadataScore(questionTokens, note);
        if (score > best) {
            best = score;
        }
        scored.append({ "note": note, "score": score });
    }
    if (best < 1.5) {
        foreach (var entry in scored) {
            entry.score = entry.score + bodyScore(brainDir, questionTokens, entry.note);
        }
    }

    var picked = [];
    var used = [];
    var slot = 0;
    while (slot < TOP_K) {
        var bestIndex = -1;
        var bestScore = 0.0;
        var i = 0;
        while (i < scored.length) {
            if (not str.includes(used, i) and scored[i].score > bestScore) {
                bestScore = scored[i].score;
                bestIndex = i;
            }
            i = i + 1;
        }
        if (bestIndex < 0) {
            slot = TOP_K;
        } else {
            used.append(bestIndex);
            picked.append(scored[bestIndex]);
            slot = slot + 1;
        }
    }
    return picked;
}

function retrievalHitAtK(picked, expectSlugs, k) {
    if (expectSlugs == null or expectSlugs.length == 0) {
        return false;
    }
    if (k == null or k < 1) {
        k = TOP_K;
    }
    var i = 0;
    while (i < picked.length and i < k) {
        var slug = "";
        if (picked[i].note != null and picked[i].note.slug != null) {
            slug = string(picked[i].note.slug);
        } else if (picked[i].slug != null) {
            slug = string(picked[i].slug);
        }
        foreach (var want in expectSlugs) {
            if (slug == string(want)) {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

function buildContext(brainDir, picked) {
    var blocks = [];
    foreach (var entry in picked) {
        var note = entry.note;
        var path = sbJoinUnderRoot(brainDir, note.path);
        var body = "";
        if (path != null) {
            try {
                body = io.readFile(path);
            } catch (e) {
                body = "";
            }
        }
        if (str.length(body) > MAX_NOTE_CHARS) {
            body = str.substring(body, 0, MAX_NOTE_CHARS) + "\n[...nota troncata...]";
        }
        blocks.append("### NOTA " + note.slug + "\n" +
            "titolo: " + note.title + "\n" +
            "tema: " + note.topic + "\n" +
            "file: " + note.path + "\n" +
            "origine: " + note.source + "\n\n" + body);
    }
    return str.join(blocks, "\n\n");
}

function answerInstructions(useTools) {
    var text = "Rispondi alle domande usando esclusivamente " + productName() + " fornito. " +
        "Cita le note su cui ti basi con la forma [nota: slug]. " +
        "Se le note non contengono la risposta, dillo esplicitamente e indica quale nota " +
        "si avvicina di piu'. Non inventare API, parametri o comportamenti. ";
    if (useTools == true) {
        text = text +
            "Puoi usare gli strumenti read_file, grep e list_directory per aprire altre note " +
            "di " + productName() + " se il contesto fornito non basta. " +
            hostAskToolExtraInstructions();
    } else {
        text = text +
            "Non hai strumenti: usa solo gli estratti forniti nel prompt; non inventare " +
            "contenuti di altre note. ";
    }
    return text +
        "Rispondi nella lingua della domanda, in modo conciso e strutturato. Formatta la risposta in Markdown " +
        "(grassetto, elenchi, tabelle se utili); non usare HTML grezzo.";
}

function chatOnlyInstructions() {
    return "Sei un assistente utile in chat diretta. Non c'e' " + productName() +
        " / knowledge base disponibile per questa sessione: rispondi con le tue conoscenze generali. " +
        "Rispondi nella lingua della domanda, in modo conciso e strutturato. " +
        "Formatta la risposta in Markdown (grassetto, elenchi, tabelle se utili); " +
        "non usare HTML grezzo.";
}

function documentInstructions(useTools) {
    var text = "Genera un documento completo e autonomo (riepilogo, proposta, verbale, checklist, brief) " +
        "che l'utente puo' scaricare. " +
        "Usa gli estratti di " + productName() + " come ESEMPI di stile, struttura, sezioni, tabelle e clausole. " +
        "Non copiare nomi, date o valori numerici degli esempi se l'utente non li ha chiesti. " +
        "Usa i fatti indicati nella richiesta. " +
        "Non inventare cifre, date o termini assenti dalla richiesta o dagli esempi: " +
        "usa un placeholder chiaro [TO CONFIRM: ...]. " +
        "Non rispondere come in una chat: niente preambolo, niente 'ecco il documento', " +
        "niente citazioni [nota: slug] nel corpo. " +
        "Output solo Markdown (titoli, elenchi, tabelle). Niente HTML grezzo. ";
    if (useTools == true) {
        text = text +
            "Puoi usare gli strumenti read_file, grep e list_directory per aprire altri esempi " +
            "di " + productName() + " se il contesto fornito non basta. " +
            hostAskToolExtraInstructions();
    } else {
        text = text +
            "Non hai strumenti: usa solo gli estratti forniti nel prompt. ";
    }
    return text + "Scrivi nella lingua della richiesta. Inizia con un titolo #.";
}

function chatOnlyDocumentInstructions() {
    return "Genera un documento completo e autonomo che l'utente puo' scaricare. " +
        "Non c'e' " + productName() + " / knowledge base: usa solo la richiesta e conoscenze generali. " +
        "Segna i fatti non confermati con [TO CONFIRM: ...]. " +
        "Output solo Markdown, senza preambolo. Inizia con un titolo #. " +
        "Scrivi nella lingua della richiesta.";
}

function catalogNoteCount(catalog) {
    if (catalog == null or catalog.notes == null) {
        return 0;
    }
    return catalog.notes.length;
}

function runChatOnlyTurn(question) {
    var generate = askGetAskMode() == "generate";
    AnsiConsole.markupLine("[dim]" + t(
        "direct chat (no " + productName() + " retrieval)",
        "chat diretta (nessun recupero da " + productName() + ")") + "[/]");
    var instructions = chatOnlyInstructions();
    var role = "assistente in chat";
    var name = "ChatAssistant";
    if (generate) {
        instructions = chatOnlyDocumentInstructions();
        role = "redattore di documenti";
        name = "DocWriter";
    }
    var responder = newPlainAgent(name, role, instructions);
    var answer = str.trim(tryThink(responder, question));
    if (answer == "") {
        return {
            "question": question,
            "answer": "",
            "sources": [],
            "error": t("No answer from the LLM.", "Nessuna risposta dall'LLM.")
        };
    }
    var turn = {
        "question": question,
        "answer": answer,
        "sources": [],
        "error": ""
    };
    if (generate) {
        return askMarkGeneratedTurn(turn, question);
    }
    return turn;
}

function resolveAskBrainRoot(cli) {
    if (io.hasEmbeddedFolder(EMBED_ALIAS)) {
        var root = io.embeddedFolderRoot(EMBED_ALIAS);
        AnsiConsole.markupLine("[dim]" + t(
            "Using embedded " + productName() + " (no disk folder).",
            "Uso " + productName() + " incorporato (nessuna cartella su disco).") + "[/]");
        return root;
    }
    if (cli != null and str.trim(sbCliAsText(cli.brain)) != "") {
        return str.trim(sbCliAsText(cli.brain));
    }
    var brainDir = str.trim(io.input(t(
        productName() + " folder [" + DEFAULT_BRAIN_DIR + "]: ",
        "Cartella " + productName() + " [" + DEFAULT_BRAIN_DIR + "]: ")));
    if (brainDir == "") {
        brainDir = DEFAULT_BRAIN_DIR;
    }
    return brainDir;
}

function askSourcesFromPicked(picked) {
    var sources = [];
    foreach (var entry in picked) {
        var hint = "";
        if (entry.vectorScore != null) {
            hint = "vec " + string(entry.vectorScore);
            if (entry.lexicalScore != null) {
                hint = hint + " · lex " + string(entry.lexicalScore);
            }
        } else if (entry.score != null) {
            hint = "score " + string(entry.score);
        }
        sources.append({
            "slug": entry.note.slug,
            "title": entry.note.title,
            "path": entry.note.path,
            "source": entry.note.source,
            "score": entry.score,
            "scoreHint": hint
        });
    }
    return sources;
}

function askCompletedHistoryTurns(history, currentQuestion) {
    var completed = [];
    if (history == null) {
        return completed;
    }
    var current = str.trim(string(currentQuestion));
    foreach (var turn in history) {
        if (turn == null or turn.pending == true) {
            continue;
        }
        var q = "";
        if (turn.question != null) {
            q = str.trim(string(turn.question));
        }
        if (q == "") {
            continue;
        }
        if (current != "" and q == current) {
            continue;
        }
        completed.append(turn);
    }
    return completed;
}

function expandAskRetrievalQuery(question, history) {
    var q = str.trim(string(question));
    var prior = askCompletedHistoryTurns(history, q);
    if (prior.length == 0) {
        return q;
    }
    var parts = [];
    parts.append(q);
    var start = prior.length - 2;
    if (start < 0) {
        start = 0;
    }
    var i = start;
    while (i < prior.length) {
        var pq = "";
        if (prior[i].question != null) {
            pq = str.trim(string(prior[i].question));
        }
        if (pq != "" and pq != q) {
            parts.append(pq);
        }
        i = i + 1;
    }
    var last = prior[prior.length - 1];
    if (last.sources != null and typeOf(last.sources) == "array") {
        foreach (var src in last.sources) {
            var label = "";
            if (src != null and src.title != null) {
                label = str.trim(string(src.title));
            }
            if (label == "" and src != null and src.slug != null) {
                label = str.trim(string(src.slug));
            }
            if (label != "") {
                parts.append(label);
            }
        }
    }
    var expanded = str.trim(str.join(parts, " "));
    if (expanded == "") {
        return q;
    }
    if (str.length(expanded) > 400) {
        expanded = str.substring(expanded, 0, 400);
    }
    return expanded;
}

function retrievalTopScore(selection) {
    if (selection == null or selection.picked == null or selection.picked.length == 0) {
        return 0.0;
    }
    if (selection.picked[0].score == null) {
        return 0.0;
    }
    return float(selection.picked[0].score);
}

function retrievalIsWeak(selection) {
    var n = 0;
    if (selection != null and selection.picked != null) {
        n = selection.picked.length;
    }
    var minScore = ASK_MIN_LEXICAL_SCORE;
    if (selection != null and selection.channel == "graphmemory") {
        minScore = ASK_MIN_RETRIEVAL_SCORE;
    }
    return n == 0 or retrievalTopScore(selection) < minScore;
}

function runAskTurn(question) {
    var generate = askGetAskMode() == "generate";
    var session = askGetSession();
    var brainDir = askAsText(session.brainDir);
    var catalog = askGetCatalog();
    var chatOnly = session.chatOnly == true or catalogNoteCount(catalog) == 0;
    if (chatOnly) {
        return runChatOnlyTurn(question);
    }

    var tagFilter = askGetTagFilter();
    var selection = selectNotesForAsk(brainDir, catalog, question, tagFilter);
    var retrievalExpanded = false;
    if (retrievalIsWeak(selection)) {
        var history = askGetHistory();
        var prior = askCompletedHistoryTurns(history, question);
        if (prior.length > 0) {
            var expanded = expandAskRetrievalQuery(question, history);
            if (expanded != str.trim(string(question))) {
                var retry = selectNotesForAsk(brainDir, catalog, expanded, tagFilter);
                retry.expanded = true;
                retry.retrievalQuery = expanded;
                if (not retrievalIsWeak(retry) or
                        retrievalTopScore(retry) > retrievalTopScore(selection)) {
                    AnsiConsole.markupLine("[dim]" + t(
                        "retrieval: expanded from conversation",
                        "recupero: espanso dalla conversazione") + "[/]");
                    selection = retry;
                    retrievalExpanded = true;
                }
            }
        }
    }
    var picked = selection.picked;
    var topScore = retrievalTopScore(selection);
    if (retrievalIsWeak(selection) and not askGetForceAnswer()) {
        AnsiConsole.markupLine("[yellow]" + t(
            "Weak / empty retrieval (score=",
            "Recupero debole / vuoto (score=") + string(topScore) +
            ", channel=" + askAsText(selection.channel) + ").[/]");
        return {
            "question": question,
            "answer": askWeakRetrievalMessage(),
            "sources": askSourcesFromPicked(picked),
            "error": "",
            "weakRetrieval": true,
            "retrievalExpanded": retrievalExpanded
        };
    }
    if (retrievalIsWeak(selection) and askGetForceAnswer()) {
        AnsiConsole.markupLine("[yellow]" + t(
            "Weak / empty retrieval (score=",
            "Recupero debole / vuoto (score=") + string(topScore) +
            ", channel=" + askAsText(selection.channel) + ").[/]");
        return runChatOnlyTurn(question);
    }

    var sources = askSourcesFromPicked(picked);
    var names = [];
    foreach (var entry in picked) {
        names.append(entry.note.slug);
    }
    AnsiConsole.markupLine("[dim]" + t("retrieved notes: ", "note recuperate: ") +
        str.join(names, ", ") + " (" + askAsText(selection.channel) + ")[/]");
    afterNoteSelection(selection);

    var useTools = askGetToolsEnabled();
    var responder = null;
    var agentName = "BrainReader";
    var agentRole = "assistente di knowledge base";
    var instructions = answerInstructions(useTools);
    var promptLead = "SECOND BRAIN (estratti pertinenti):\n\n";
    var promptAsk = "\n\n----\nDOMANDA: ";
    if (generate) {
        agentName = "DocWriter";
        agentRole = "redattore di documenti";
        instructions = documentInstructions(useTools);
        promptLead = "SECOND BRAIN (esempi di stile e struttura):\n\n";
        promptAsk = "\n\n----\nRICHIESTA DOCUMENTO: ";
    }
    if (useTools) {
        AnsiConsole.markupLine("[dim]" + hostAskToolsOnLabel() + "[/]");
        responder = newReaderAgent(agentName, agentRole, instructions, brainDir);
    } else {
        AnsiConsole.markupLine("[dim]" + t(
            "ASK tools: off (retrieved excerpts only)",
            "Tool ASK: disattivi (solo estratti recuperati)") + "[/]");
        responder = newPlainAgent(agentName, agentRole, instructions);
    }
    var context = buildContext(brainDir, picked);
    AnsiConsole.markupLine("[dim]" + t(
        "Calling LLM (" + modelLabel() + ")… keep the browser tab open.",
        "Chiamo l'LLM (" + modelLabel() + ")… lascia aperta la scheda del browser.") + "[/]");
    var answer = str.trim(tryThink(responder, promptLead + context + promptAsk + question));
    if (answer == "") {
        AnsiConsole.markupLine("[yellow]" + t(
            "LLM returned an empty answer.",
            "L'LLM ha restituito una risposta vuota.") + "[/]");
        return {
            "question": question,
            "answer": "",
            "sources": sources,
            "error": t("No answer from the LLM.", "Nessuna risposta dall'LLM."),
            "retrievalExpanded": retrievalExpanded
        };
    }
    AnsiConsole.markupLine("[dim]" + t("Answer ready.", "Risposta pronta.") + "[/]");
    var turn = {
        "question": question,
        "answer": answer,
        "sources": sources,
        "error": "",
        "retrievalExpanded": retrievalExpanded
    };
    if (generate) {
        return askMarkGeneratedTurn(turn, question);
    }
    return turn;
}

function runAskUpdateFromUpload(body) {
    var session = askGetSession();
    var brainDir = str.trim(askAsText(session.brainDir));
    if (brainDir == "" or str.startsWith(brainDir, "embed:")) {
        return {
            "ok": false,
            "error": t("Embedded brain cannot be updated from the UI.",
                "Il brain embeddato non si aggiorna dalla UI."),
            "added": 0,
            "changed": 0,
            "files": 0
        };
    }
    var catalog = loadCatalog(brainDir);
    if (catalog == null) {
        return {
            "ok": false,
            "error": t("Missing catalog.", "Catalogo mancante."),
            "added": 0,
            "changed": 0,
            "files": 0
        };
    }
    var docsRoot = resolveUpdateDocsRoot({ "docs": "" }, catalog, brainDir);
    if (docsRoot == "" or not io.hasDirectory(docsRoot)) {
        docsRoot = brainSourcesRoot(brainDir);
        if (docsRoot != null) {
            io.ensureDir(docsRoot);
        }
    }
    if (docsRoot == "" or not io.hasDirectory(docsRoot)) {
        return {
            "ok": false,
            "error": t("Documentation folder not found (sourceFolder in brain.json). Run BUILD/UPDATE once with --docs to populate brain/sources.",
                "Cartella documentazione non trovata (sourceFolder in brain.json). Esegui BUILD/UPDATE una volta con --docs per popolare brain/sources."),
            "added": 0,
            "changed": 0,
            "files": 0
        };
    }
    var filesWritten = 0;
    if (body != null and body.docs != null) {
        var fileObj = body.docs;
        var fileName = "";
        var content = "";
        if (fileObj.fileName != null) {
            fileName = io.getFileName(askAsText(fileObj.fileName));
            content = askAsText(fileObj.content);
        }
        var lower = str.lower(fileName);
        if (fileName != "" and (str.endsWith(lower, ".md") or str.endsWith(lower, ".html") or
                str.endsWith(lower, ".htm"))) {
            var dest = sbAssertUnderRoot(docsRoot, io.pathJoin(docsRoot, fileName));
            if (dest != null) {
                io.writeFile(dest, content);
                filesWritten = 1;
            }
        }
    }
    if (filesWritten == 0) {
        return {
            "ok": false,
            "error": t("No .md/.html file uploaded.", "Nessun file .md/.html caricato."),
            "added": 0,
            "changed": 0,
            "files": 0
        };
    }
    var ok = updateBrain({
        "mode": "update",
        "docs": docsRoot,
        "brain": brainDir,
        "removeOrphans": false,
        "lang": "",
        "port": null,
        "auth": null,
        "allowRegister": null,
        "showExamples": null,
        "error": ""
    });
    return {
        "ok": ok == true,
        "error": "",
        "added": filesWritten,
        "changed": filesWritten,
        "files": filesWritten
    };
}

function generateDocumentCli(cli) {
    var prompt = str.trim(sbCliAsText(cli.prompt));
    if (prompt == "") {
        AnsiConsole.markupLine("[red]" + t(
            "generate requires --prompt <text>.",
            "generate richiede --prompt <testo>.") + "[/]");
        return false;
    }

    var brainDir = resolveAskBrainRoot(cli);
    askApplyProductNameFromBrain(brainDir);
    sbCliApplyProductName(cli);
    var catalog = loadCatalog(brainDir);
    var noteCount = catalogNoteCount(catalog);
    var topicCount = 0;
    var sourceFolder = brainDir;
    var chatOnly = noteCount == 0;
    if (catalog != null) {
        if (catalog.topics != null) {
            topicCount = catalog.topics.length;
        }
        if (catalog.sourceFolder != null and askAsText(catalog.sourceFolder) != "") {
            sourceFolder = catalog.sourceFolder;
        }
    }
    prepareAskMemory(brainDir, chatOnly);

    ui.setState(ASK_STORE, "lang", UI_LANG, ASK_SESSION_ID);
    askSetCatalog(catalog);
    askSetToolsEnabled(false);
    askSetAskMode("generate");
    askSetForceAnswer(cli.forceAnswer == true);
    askClearHistory();
    askSetSession({
        "brainDir": brainDir,
        "chatOnly": chatOnly,
        "noteCount": noteCount,
        "topicCount": topicCount,
        "sourceFolder": sourceFolder,
        "retrieval": askModeRetrievalLabel(),
        "llm": modelLabel(),
        "title": ASK_PAGE_TITLE,
        "subtitle": t("CLI generate document", "CLI genera documento")
    });

    AnsiConsole.panel(
        t("Writes a downloadable document from " + productName() + " examples.",
            "Scrive un documento scaricabile dagli esempi di " + productName() + "."),
        t("[bold]Mode - GENERATE[/]", "[bold]Modalita' - GENERA[/]"), "rounded");
    AnsiConsole.markupLine("[dim]" + t("Request: ", "Richiesta: ") + prompt + "[/]");

    var turn = runAskTurn(prompt);
    if (turn == null or str.trim(askAsText(turn.error)) != "" or str.trim(askAsText(turn.answer)) == "") {
        var err = "";
        if (turn != null) {
            err = str.trim(askAsText(turn.error));
            if (err == "") {
                err = str.trim(askAsText(turn.answer));
            }
        }
        if (err == "") {
            err = t("No document from the LLM.", "Nessun documento dall'LLM.");
        }
        AnsiConsole.markupLine("[red]" + str.replace(str.replace(err, "[", "[["), "]", "]]") + "[/]");
        return false;
    }

    var fmt = sbCliNormalizeDocFormat(cli.format);
    if (fmt == "") {
        fmt = "md";
    }
    var baseName = askSuggestDocumentFilename(prompt, turn.answer);
    var outPath = str.trim(sbCliAsText(cli.outPath));
    if (outPath == "") {
        outPath = baseName + "." + fmt;
    }
    var body = askAsText(turn.answer);
    if (fmt == "html") {
        body = askWrapGeneratedHtml(baseName, body);
    }
    io.writeFile(outPath, body);
    AnsiConsole.markupLine("[green]" + t("Wrote:", "Scritto:") + "[/] [bold]" +
        str.replace(str.replace(outPath, "[", "[["), "]", "]]") + "[/]");
    return true;
}
