// Offline lexical retrieval eval (no LLM).
// From repo root:
//   malda Examples/Agents/sb/eval/run_retrieval_eval.malda
// Prints HIT / MISS per question and HIT_AT_K / EVAL_PASS.
// Items with priorId test conversation-aware expansion (follow-up miss on
// the raw question; topic-switch expectRawHit keeps the first-pass hit).

var UI_LANG = "en";
var TOP_K = 5;
var MAX_NOTE_CHARS = 5000;
var PRODUCT_NAME = "EvalBrain";

function t(en, it) {
    return en;
}

function productName() {
    return PRODUCT_NAME;
}

function askNoteMatchesTagFilter(note, tags) {
    return true;
}

function sbJoinUnderRoot(root, part) {
    return io.pathJoin(root, part);
}

function evalDataDir() {
    var args = getCommandLineArgs();
    foreach (var a in args) {
        var s = str.replace(string(a), "\\", "/");
        if (str.endsWith(str.lower(s), "run_retrieval_eval.malda")) {
            var dir = io.getDirectoryName(a);
            if (dir != null and str.trim(string(dir)) != "") {
                return dir;
            }
        }
    }
    if (io.hasFile("questions.json")) {
        return ".";
    }
    if (io.hasFile("Examples/Agents/sb/eval/questions.json")) {
        return "Examples/Agents/sb/eval";
    }
    return ".";
}

function evalFindQuestion(questions, id) {
    foreach (var item in questions) {
        if (item.id == id) {
            return item;
        }
    }
    return null;
}

function evalCatalogTitle(catalog, slug) {
    foreach (var note in catalog.notes) {
        if (note.slug == slug) {
            return string(note.title);
        }
    }
    return string(slug);
}

function evalHistoryFromPrior(questions, catalog, priorId) {
    var prior = evalFindQuestion(questions, priorId);
    if (prior == null) {
        return [];
    }
    var sources = [];
    if (prior.expectSlugs != null) {
        foreach (var slug in prior.expectSlugs) {
            sources.append({
                "slug": slug,
                "title": evalCatalogTitle(catalog, slug)
            });
        }
    }
    return [{
        "question": prior.q,
        "answer": "prior",
        "sources": sources,
        "pending": false
    }];
}

include "../05-ask-common.malda";

var here = evalDataDir();
var catalog = parseJSON(io.readFile(io.pathJoin(here, "catalog.json")));
var questions = parseJSON(io.readFile(io.pathJoin(here, "questions.json")));
var hits = 0;
var total = questions.length;
foreach (var item in questions) {
    var top = "";
    var ok = false;
    var priorId = "";
    if (item.priorId != null) {
        priorId = str.trim(string(item.priorId));
    }
    if (priorId == "") {
        var picked = selectNotes(here, catalog, item.q, []);
        ok = retrievalHitAtK(picked, item.expectSlugs, TOP_K);
        if (picked.length > 0) {
            top = string(picked[0].note.slug);
        }
    } else {
        var history = evalHistoryFromPrior(questions, catalog, priorId);
        if (history.length == 0) {
            print("MISS " + item.id + " missing priorId=" + priorId);
            continue;
        }
        var rawPicked = selectNotes(here, catalog, item.q, []);
        var rawHit = retrievalHitAtK(rawPicked, item.expectSlugs, TOP_K);
        var expectRaw = item.expectRawHit == true;
        if (expectRaw) {
            ok = rawHit;
            if (rawPicked.length > 0) {
                top = string(rawPicked[0].note.slug);
            }
        } else {
            if (rawHit) {
                print("MISS " + item.id + " raw unexpectedly hit");
                continue;
            }
            var expanded = expandAskRetrievalQuery(item.q, history);
            var picked2 = selectNotes(here, catalog, expanded, []);
            ok = retrievalHitAtK(picked2, item.expectSlugs, TOP_K);
            if (picked2.length > 0) {
                top = string(picked2[0].note.slug);
            }
        }
    }
    if (ok) {
        hits = hits + 1;
        print("HIT " + item.id + " top=" + top);
    } else {
        print("MISS " + item.id + " top=" + top + " want=" + str.join(item.expectSlugs, ","));
    }
}
print("HIT_AT_K=" + string(hits) + "/" + string(total));
if (hits < total) {
    print("EVAL_FAIL");
} else {
    print("EVAL_PASS");
}
