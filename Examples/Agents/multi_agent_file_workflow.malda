// Note: Requires OPENROUTER_API_KEY environment variable
// Create a sample code file
io.writeFile("calculator.malda", "function add(a, b) {
    return a + b;
}

function subtract(a, b) {
    return a - b;
}");

// Using CodingAgent - automatically includes all file tools and uses OpenRouterClient
// Create multiple specialized coding agents
var readerAgent = new CodingAgent(
    "Reader",
    "file reader",
    "You read and analyze files."
);

var editorAgent = new CodingAgent(
    "Editor",
    "code editor",
    "You edit code files to add improvements."
);

var reviewerAgent = new CodingAgent(
    "Reviewer",
    "code reviewer",
    "You review code and suggest changes."
);

// Workflow: Reader -> Reviewer -> Editor
io.print("Step 1: Reader analyzes the file");
var readResponse = readerAgent.think("Read calculator.malda and summarize what it does.");
io.print(readResponse.content);

io.print("
Step 2: Reviewer reviews the code");
var code = io.readFile("calculator.malda");
reviewerAgent.getConversation().addUserMessage("Review this code and suggest improvements:

" + code);
var reviewResponse = reviewerAgent.getConversation().send();
io.print(reviewResponse.content);

io.print("
Step 3: Editor applies improvements");
var editResponse = editorAgent.think("Read calculator.malda and add comments to each function explaining what it does.");
io.print(editResponse.content);
