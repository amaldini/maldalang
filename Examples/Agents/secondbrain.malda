// secondbrain.malda - MALDA 0.1.0
//
// Lexical-retrieval second brain. For GraphMemory + embedding ASK (synonyms /
// paraphrases), see the sibling: Examples/Agents/secondbrain_semantic.malda
//
// Modes:
//   1) BUILD   a CodingAgent explores documentation (.md / .html) in a user-chosen
//              folder, proposes a theme taxonomy, then distills a "second brain":
//              hierarchical linked .md notes (index -> topic hubs -> notes).
//   2) UPDATE  incremental refresh: re-distill only new/changed source files in an
//              existing brain (content hashes in brain.json); optional orphan cleanup.
//   3) ASK     local HttpServer web UI: catalog + token-overlap retrieval, LLM
//              answers in Markdown (rendered with markdownToHtml).
//   4) language  switch console/UI language (English / Italian).
//   5) PACK    compile a portable ASK-only .exe with the brain embedded.
//
// Run:   malda Examples/Agents/secondbrain.malda
//
// LLM:   if OPENROUTER_API_KEY is set, uses OpenRouter (client default model,
//        override with MALDA_BRAIN_MODEL); otherwise MALDA's default local model
//        (downloaded on first use).
//
// UI:    at startup, choose UI message language (English / Italian).
//        Notes stay in the source document language; technical terms are unchanged.
//        ASK opens http://localhost:39018/ (Ctrl+C in console returns to menu).
//
// Pack portable ASK exe (menu option 4, or CLI):
//   malda compile Examples/Agents/secondbrain.malda -o dist/secondbrain.exe --mode transpile --embed-folder secondbrain
//   When the embedded folder is present at runtime, startup skips the console
//   menu/language prompt and opens ASK immediately (language is chosen in the
//   web UI; exits when the server stops).

// ---------------------------------------------------------------- configuration

var MAX_DOC_CHARS = 12000;      // document characters sent per LLM call
var MAX_CHUNKS = 15;            // max parts for a very long document
var MAX_NOTE_CHARS = 5000;      // characters per note in an answer context
var TOP_K = 5;                  // notes retrieved per question
var MAX_EXPLORE_DOCS = 300;     // documents listed for the explorer agent
var CATALOG_NAME = "brain.json";
var UI_LANG = "it";             // "en" | "it" — UI messages
var ASK_HTTP_PORT = 39018;
var ASK_SESSION_ID = "secondbrain-ask-lexical";
var ASK_STORE = "SecondBrainAsk";
// Display name for UI / console / generated index (folder aliases stay EMBED_ALIAS).
// Literal name, OR path / embed:… to a utf-8 text file (first non-empty line).
// Prefer brain file product_name.txt (auto-loaded when the brain root is known).
var PRODUCT_NAME = "Second brain";
var ASK_TITLE_SUFFIX = " — ASK";
// ASK web header — defaults from PRODUCT_NAME; override freely if needed.
var ASK_PAGE_TITLE = PRODUCT_NAME + ASK_TITLE_SUFFIX;
var ASK_POWERED_BY = "Powered by MALDA: Multi Agent Language with Development Automation";
var ASK_POWERED_BY_URL = "https://github.com/amaldini/maldalang";
// Optional logo left of the title (works in normal ASK and in packed/embed exe):
//   ""              -> auto-load logo.png/.svg/.jpg/… from the brain folder
//   "logo.png"      -> same folder as the brain (resolved at ASK start)
//   "P:/brain/logo.png" or "P:\\brain\\logo.png"  -> absolute disk path
//      Prefer / or \\ — a single \ in "P:\Second..." is a string escape, not a folder slash.
//   "embed:ALIAS/logo.png" -> packed brain only
//   "https://..." / "data:..." -> remote or inline
var ASK_LOGO = "";
var SOURCE_SCRIPT_NAME = "secondbrain.malda";
var EMBED_ALIAS = "secondbrain";
var DEFAULT_PACK_OUTPUT = "dist/secondbrain.exe";
var askHttpServer = null;

// ---------------------------------------------------------------- UI i18n

function t(en, it) {
    if (UI_LANG == "en") {
        return en;
    }
    return it;
}

function readProductNameFile(path) {
    var p = str.trim(string(path));
    if (p == "" or not io.hasFile(p)) {
        return "";
    }
    var text = io.readFile(p);
    if (text == null) {
        return "";
    }
    var lines = str.split(string(text), "\n");
    foreach (var line in lines) {
        // trim() also strips trailing CR from CRLF files.
        var n = str.trim(string(line));
        if (n != "") {
            return n;
        }
    }
    return "";
}

function productNameLooksLikePath(value) {
    var n = str.trim(string(value));
    if (n == "") {
        return false;
    }
    if (str.startsWith(n, "embed:")) {
        return true;
    }
    if (str.endsWith(str.lower(n), ".txt")) {
        return true;
    }
    if (str.indexOf(n, "/") >= 0 or str.indexOf(n, "\\") >= 0) {
        return true;
    }
    return io.hasFile(n);
}

function productName() {
    var n = str.trim(string(PRODUCT_NAME));
    if (n != "" and productNameLooksLikePath(n)) {
        var fromFile = readProductNameFile(n);
        if (fromFile != "") {
            return fromFile;
        }
    }
    if (n == "" or productNameLooksLikePath(n)) {
        return "Second brain";
    }
    return n;
}

// Prefer brainDir/product_name.txt (disk or embed). Keeps ASK_PAGE_TITLE in sync when default-shaped.
function applyProductNameFromBrain(brainDir) {
    var root = str.trim(string(brainDir));
    var loaded = "";
    if (root != "") {
        loaded = readProductNameFile(io.pathJoin(root, "product_name.txt"));
    }
    if (loaded == "") {
        return productName();
    }
    // Brain file owns display name + default ASK title.
    PRODUCT_NAME = loaded;
    ASK_PAGE_TITLE = loaded + ASK_TITLE_SUFFIX;
    return loaded;
}

function ynHint() {
    return t("(y/n)", "(s/n)");
}

function isAffirmative(answer) {
    var a = str.lower(str.trim(string(answer)));
    return a == "y" or a == "yes" or a == "s" or a == "si";
}

function isNegative(answer) {
    var a = str.lower(str.trim(string(answer)));
    return a == "n" or a == "no";
}

function chooseLanguage() {
    AnsiConsole.markupLine("");
    AnsiConsole.panel(
        "[bold]1[/]  English\n" +
        "[bold]2[/]  Italiano\n\n" +
        "[dim]Enter = Italiano[/]",
        "[bold blue]Language / Lingua[/]", "rounded");
    var choice = str.lower(str.trim(io.input("Language / Lingua (1/2) [2]: ")));
    if (choice == "1" or choice == "en" or choice == "english" or choice == "e") {
        UI_LANG = "en";
    } else {
        UI_LANG = "it";
    }
    ui.setState(ASK_STORE, "lang", UI_LANG, ASK_SESSION_ID);
    AnsiConsole.markupLine(t(
        "[dim]UI language: English[/]",
        "[dim]Lingua interfaccia: Italiano[/]"));
}

// ---------------------------------------------------------------- LLM helpers

function makeClient() {
    if (not io.hasEnv("OPENROUTER_API_KEY")) {
        return null;
    }
    if (io.hasEnv("MALDA_BRAIN_MODEL")) {
        var m = str.trim(string(io.getEnv("MALDA_BRAIN_MODEL")));
        if (m != "") {
            return new OpenRouterClient(m);
        }
    }
    return new OpenRouterClient();
}

function modelLabel() {
    if (not io.hasEnv("OPENROUTER_API_KEY")) {
        return t("default local model (MALDA)", "modello locale di default (MALDA)");
    }
    if (io.hasEnv("MALDA_BRAIN_MODEL")) {
        var m = str.trim(string(io.getEnv("MALDA_BRAIN_MODEL")));
        if (m != "") {
            return "OpenRouter / " + m;
        }
    }
    return t("OpenRouter / client default model", "OpenRouter / modello di default del client");
}

// CodingAgent: full file tools, with working directory limited to the docs root.
function newCodingAgent(name, role, instructions, workDir) {
    var client = makeClient();
    if (client == null) {
        return new CodingAgent(name, role, instructions, workDir);
    }
    return new CodingAgent(name, role, instructions, client, workDir);
}

// Read-only agent for ASK mode (no write tools).
function newReaderAgent(name, role, instructions, brainDir) {
    var client = makeClient();
    var agent = null;
    if (client == null) {
        agent = new Agent(name, role, instructions);
    } else {
        agent = new Agent(name, role, instructions, client);
    }
    agent.addTool(createReadFileTool(brainDir));
    agent.addTool(createGrepTool(brainDir));
    agent.addTool(createListDirectoryTool(brainDir));
    return agent;
}

// Tool-less agent: safer with thinking models (DeepSeek V4) that break on tool
// rounds when reasoning_content is not replayed, and enough for taxonomy from a list.
function newPlainAgent(name, role, instructions) {
    var client = makeClient();
    if (client == null) {
        return new Agent(name, role, instructions);
    }
    return new Agent(name, role, instructions, client);
}

// A failed LLM call must not abort the whole run.
// Returns { content, reasoning }. Never treat CoT as the answer by default.
function tryThinkParts(agent, question) {
    try {
        var response = agent.think(question);
        var content = "";
        var reasoning = "";
        if (response != null) {
            if (response.content != null) {
                content = str.trim(string(response.content));
            }
            if (response.reasoning != null) {
                reasoning = str.trim(string(response.reasoning));
            }
        }
        return { "content": content, "reasoning": reasoning };
    } catch (e) {
        AnsiConsole.markupLine("  [red]" + t("LLM error:", "errore LLM:") + "[/] " + string(e));
        return { "content": "", "reasoning": "" };
    }
}

function tryThink(agent, question) {
    return tryThinkParts(agent, question).content;
}

// ---------------------------------------------------------------- text helpers

function normalizePath(p) {
    return str.replace(string(p), "\\", "/");
}

function slugify(text) {
    var s = str.lower(str.trim(string(text)));
    s = str.regexReplace(s, "[^a-z0-9]+", "-");
    s = str.regexReplace(s, "^-+", "");
    s = str.regexReplace(s, "-+$", "");
    if (s == "") {
        s = "nota";
    }
    if (str.length(s) > 60) {
        s = str.substring(s, 0, 60);
        s = str.regexReplace(s, "-+$", "");
    }
    return s;
}

function htmlToText(raw) {
    var t = str.regexReplace(raw, "(?is)<(script|style|noscript)[^>]*>.*?</\\1>", " ");
    t = str.regexReplace(t, "(?is)<!--.*?-->", " ");
    t = str.regexReplace(t, "(?i)<br[^>]*>", "\n");
    t = str.regexReplace(t, "(?i)</(p|div|li|h1|h2|h3|h4|h5|h6|tr|section|article|pre|blockquote)>", "\n");
    t = str.regexReplace(t, "<[^>]+>", " ");
    t = str.replace(t, "&nbsp;", " ");
    t = str.replace(t, "&amp;", "&");
    t = str.replace(t, "&lt;", "<");
    t = str.replace(t, "&gt;", ">");
    t = str.replace(t, "&quot;", "\"");
    t = str.replace(t, "&#39;", "'");
    t = str.replace(t, "&rsquo;", "'");
    t = str.replace(t, "&mdash;", "-");
    t = str.regexReplace(t, "[ \\t]+", " ");
    t = str.regexReplace(t, "\n{3,}", "\n\n");
    return str.trim(t);
}

function extractText(absPath) {
    var raw = io.readFile(absPath);
    var ext = str.lower(io.pathGetExtension(absPath));
    if (ext == ".html" or ext == ".htm") {
        return htmlToText(raw);
    }
    return raw;
}

// Split long text into chunks, cutting on the last available paragraph break.
function chunkText(text, maxChars, maxChunks) {
    var chunks = [];
    var rest = text;
    while (str.length(rest) > 0 and chunks.length < maxChunks) {
        if (str.length(rest) <= maxChars) {
            chunks.append(rest);
            rest = "";
        } else {
            var head = str.substring(rest, 0, maxChars);
            var cut = str.indexOf(head, "\n\n");
            var lastBreak = -1;
            var probe = cut;
            while (probe >= 0) {
                lastBreak = probe;
                var tail = str.substring(head, probe + 2, str.length(head));
                var next = str.indexOf(tail, "\n\n");
                if (next < 0) {
                    probe = -1;
                } else {
                    probe = probe + 2 + next;
                }
            }
            if (lastBreak < int(maxChars / 2)) {
                lastBreak = maxChars;
            }
            chunks.append(str.substring(rest, 0, lastBreak));
            rest = str.substring(rest, lastBreak, str.length(rest));
        }
    }
    return chunks;
}

function firstLines(text, count) {
    var lines = str.split(text, "\n");
    var taken = [];
    var i = 0;
    while (i < lines.length and taken.length < count) {
        var line = str.trim(lines[i]);
        if (line != "") {
            taken.append(line);
        }
        i = i + 1;
    }
    return str.join(taken, " ");
}

function headingsOf(markdown) {
    var found = str.regexFind(markdown, "(?m)^#{1,4} +(.+)$");
    var titles = [];
    foreach (var hit in found) {
        var text = str.trim(hit.groups[1]);
        if (text != "" and titles.length < 12) {
            titles.append(text);
        }
    }
    return titles;
}

function tagsFromLine(line) {
    var tags = [];
    foreach (var part in str.split(line, ",")) {
        var tag = str.lower(str.trim(part));
        tag = str.regexReplace(tag, "[^a-z0-9 \\-]+", "");
        tag = str.trim(tag);
        if (tag != "" and tags.length < 8 and not str.includes(tags, tag)) {
            tags.append(tag);
        }
    }
    return tags;
}

// ---------------------------------------------------------------- distillation

function distillInstructions() {
    return "Sei un knowledge engineer. Distilli documentazione tecnica in note atomiche " +
        "per " + productName() + ". Rispetti sempre alla lettera il formato di risposta richiesto. " +
        "Scrivi la nota nella stessa lingua del documento di origine e mantieni invariati i " +
        "termini tecnici, i nomi di API e i frammenti di codice. Non inventi nulla: usi solo " +
        "cio' che il documento contiene. Non usi gli strumenti sui file: il testo del " +
        "documento ti viene fornito direttamente nel messaggio.";
}

function distillQuestion(sourceRel, partLabel, text) {
    return "Documento: " + sourceRel + partLabel + "\n\n" +
        "Distilla il documento seguente in una nota di " + productName() + ".\n\n" +
        "Rispondi ESATTAMENTE in questo formato, senza altro testo prima o dopo:\n" +
        "TITLE: <titolo breve e specifico>\n" +
        "TAGS: <da 3 a 6 tag minuscoli separati da virgola>\n" +
        "SUMMARY: <1-3 frasi che dicono cosa insegna il documento>\n" +
        "BODY:\n" +
        "## Concetti chiave\n" +
        "- <fatto essenziale, uno per riga>\n" +
        "## Dettagli\n" +
        "<paragrafi o elenchi con le regole operative, la sintassi, i parametri>\n" +
        "## Esempi\n" +
        "<solo esempi presenti nel documento, in blocchi di codice; ometti la sezione se non ce ne sono>\n" +
        "## Trappole\n" +
        "<errori, limiti, avvertenze; ometti la sezione se il documento non ne parla>\n\n" +
        "--- INIZIO DOCUMENTO ---\n" + text + "\n--- FINE DOCUMENTO ---";
}

// Map the agent reply into note fields, with fallbacks if the format is missing.
function parseDistilled(response, fallbackTitle, fallbackText) {
    var note = {
        "title": "",
        "tags": [],
        "summary": "",
        "body": ""
    };
    var bodyLines = [];
    var inBody = false;
    foreach (var rawLine in str.split(string(response), "\n")) {
        var line = rawLine;
        if (inBody) {
            bodyLines.append(line);
        } else if (str.startsWith(str.upper(str.trim(line)), "TITLE:")) {
            note.title = str.trim(str.substring(str.trim(line), 6, str.length(str.trim(line))));
        } else if (str.startsWith(str.upper(str.trim(line)), "TAGS:")) {
            note.tags = tagsFromLine(str.substring(str.trim(line), 5, str.length(str.trim(line))));
        } else if (str.startsWith(str.upper(str.trim(line)), "SUMMARY:")) {
            note.summary = str.trim(str.substring(str.trim(line), 8, str.length(str.trim(line))));
        } else if (str.startsWith(str.upper(str.trim(line)), "BODY:")) {
            inBody = true;
        }
    }
    note.body = str.trim(str.join(bodyLines, "\n"));

    if (note.title == "") {
        note.title = fallbackTitle;
    }
    if (note.body == "") {
        // Format not followed: keep the raw reply, or an extract of the document.
        var raw = str.trim(string(response));
        if (raw == "") {
            note.body = "## Estratto non distillato\n\nL'agente non ha prodotto una nota per questo documento.\n\n```\n" +
                str.substring(fallbackText, 0, 1500) + "\n```";
        } else {
            note.body = raw;
        }
    }
    if (note.summary == "") {
        note.summary = firstLines(note.body, 2);
        if (str.length(note.summary) > 300) {
            note.summary = str.substring(note.summary, 0, 300) + "...";
        }
    }
    if (note.tags.length == 0) {
        note.tags = tagsFromLine(fallbackTitle);
    }
    return note;
}

// ---------------------------------------------------------------- note writing

function frontmatter(note) {
    return "---\n" +
        "title: " + note.title + "\n" +
        "topic: " + note.topic + "\n" +
        "source: " + note.source + "\n" +
        "tags: [" + str.join(note.tags, ", ") + "]\n" +
        "generated_by: secondbrain.malda\n" +
        "---\n";
}

function writeNoteFile(brainDir, note) {
    var text = frontmatter(note) +
        "\n# " + note.title + "\n\n" +
        "> " + note.summary + "\n\n" +
        note.body + "\n\n" +
        "## Note collegate\n\n" +
        "<!--related-start-->\n" +
        "<!--related-end-->\n\n" +
        "---\n\n" +
        "- Hub tematico: [" + note.topic + "](../topics/" + slugify(note.topic) + ".md)\n" +
        "- Indice: [" + productName() + "](../index.md)\n" +
        "- Documento di origine: `" + note.source + "`\n";
    io.writeFile(io.pathJoin(brainDir, "notes", note.slug + ".md"), text);
}

function replaceRelatedBlock(fileText, linksText) {
    var startMark = "<!--related-start-->";
    var endMark = "<!--related-end-->";
    var block = startMark + "\n" + linksText + "\n" + endMark;
    var start = str.indexOf(fileText, startMark);
    var end = str.indexOf(fileText, endMark);
    if (start >= 0 and end > start) {
        return str.substring(fileText, 0, start) + block +
            str.substring(fileText, end + str.length(endMark), str.length(fileText));
    }
    var oldMark = "<!--related-->";
    var oldIdx = str.indexOf(fileText, oldMark);
    if (oldIdx >= 0) {
        return str.substring(fileText, 0, oldIdx) + block +
            str.substring(fileText, oldIdx + str.length(oldMark), str.length(fileText));
    }
    var section = "\n## Note collegate\n\n";
    var sectionIdx = str.indexOf(fileText, section);
    if (sectionIdx >= 0) {
        var after = sectionIdx + str.length(section);
        var rest = str.substring(fileText, after, str.length(fileText));
        var sep = str.indexOf(rest, "\n---\n");
        if (sep >= 0) {
            return str.substring(fileText, 0, after) + block + "\n" +
                str.substring(rest, sep, str.length(rest));
        }
    }
    return fileText;
}

// Links between notes: overlap of tags, title, and summary (deterministic,
// so links always point at files that really exist).
function relatednessScore(a, b) {
    var score = 0.0;
    foreach (var tag in a.tags) {
        if (str.includes(b.tags, tag)) {
            score = score + 2.0;
        }
    }
    if (a.topic == b.topic) {
        score = score + 1.0;
    }
    if (a.sourceKey == b.sourceKey) {
        score = score + 4.0;
    }
    var overlap = str.tokenOverlap(a.title + " " + a.summary, b.title + " " + b.summary);
    score = score + overlap.jaccard * 3.0;
    return score;
}

function writeRelatedSections(brainDir, notes) {
    var i = 0;
    while (i < notes.length) {
        var current = notes[i];
        var picked = [];
        var used = [];
        var slot = 0;
        while (slot < 4) {
            var bestIndex = -1;
            var bestScore = 0.5;
            var j = 0;
            while (j < notes.length) {
                if (j != i and not str.includes(used, j)) {
                    var score = relatednessScore(current, notes[j]);
                    if (score > bestScore) {
                        bestScore = score;
                        bestIndex = j;
                    }
                }
                j = j + 1;
            }
            if (bestIndex < 0) {
                slot = 4;
            } else {
                used.append(bestIndex);
                picked.append(notes[bestIndex]);
                slot = slot + 1;
            }
        }
        var lines = [];
        foreach (var related in picked) {
            lines.append("- [" + related.title + "](" + related.slug + ".md) - " + related.topic);
        }
        if (lines.length == 0) {
            lines.append("- nessuna nota affine rilevata");
        }
        var notePath = io.pathJoin(brainDir, "notes", current.slug + ".md");
        if (io.hasFile(notePath)) {
            var updated = replaceRelatedBlock(io.readFile(notePath), str.join(lines, "\n"));
            io.writeFile(notePath, updated);
        }
        i = i + 1;
    }
}

// ---------------------------------------------------------------- hubs and index

function topicsOf(notes) {
    var topics = [];
    foreach (var note in notes) {
        var known = false;
        foreach (var topic in topics) {
            if (topic.title == note.topic) {
                known = true;
                topic.count = topic.count + 1;
                topic.notes.append(note);
            }
        }
        if (not known) {
            topics.append({
                "title": note.topic,
                "slug": slugify(note.topic),
                "description": "",
                "count": 1,
                "notes": [note]
            });
        }
    }
    return topics;
}

function writeTopicHub(brainDir, topic, agent) {
    var listing = [];
    foreach (var note in topic.notes) {
        listing.append("- " + note.title + ": " + note.summary);
    }
    var overview = "";
    var themeIntro = "";
    if (topic.description != null and str.trim(string(topic.description)) != "") {
        themeIntro = "Il tema e' stato definito cosi' in fase di esplorazione: " +
            str.trim(string(topic.description)) + "\n\n";
    }
    var question = "Sei davanti a un gruppo di note di " + productName() + " sul tema \"" + topic.title + "\".\n\n" +
        themeIntro +
        str.join(listing, "\n") + "\n\n" +
        "Scrivi in markdown, senza titolo di primo livello e senza inventare contenuti:\n" +
        "1. due o tre frasi che spiegano di cosa si occupa questo tema;\n" +
        "2. una sezione \"### Ordine di lettura consigliato\" con un elenco numerato dei titoli " +
        "nell'ordine in cui conviene leggerli, ciascuno con mezza riga di motivazione.\n" +
        "Usa la stessa lingua delle note.";
    if (agent != null) {
        overview = str.trim(tryThink(agent, question));
    }
    if (overview == "") {
        overview = str.trim(string(topic.description));
        if (overview == "") {
            overview = "Raccolta di " + string(topic.count) +
                " note distillate dai documenti di questo gruppo.";
        }
    }

    var lines = [];
    foreach (var note in topic.notes) {
        lines.append("- [" + note.title + "](../notes/" + note.slug + ".md) - " + note.summary);
    }
    var text = "---\n" +
        "title: " + topic.title + "\n" +
        "kind: hub\n" +
        "notes: " + string(topic.count) + "\n" +
        "---\n\n" +
        "# " + topic.title + "\n\n" +
        overview + "\n\n" +
        "## Note di questo tema\n\n" +
        str.join(lines, "\n") + "\n\n" +
        "---\n\n" +
        "- Indice: [" + productName() + "](../index.md)\n";
    io.writeFile(io.pathJoin(brainDir, "topics", topic.slug + ".md"), text);
}

function writeIndex(brainDir, docsRoot, notes, topics, skipped, truncated, taxonomySource) {
    var lines = [];
    lines.append("---");
    lines.append("title: " + productName());
    lines.append("kind: index");
    lines.append("source_folder: " + docsRoot);
    lines.append("notes: " + string(notes.length));
    lines.append("topics: " + string(topics.length));
    lines.append("taxonomy: " + taxonomySource);
    lines.append("model: " + modelLabel());
    lines.append("---");
    lines.append("");
    lines.append("# " + productName());
    lines.append("");
    lines.append("Conoscenza distillata da `" + docsRoot + "` (" + string(notes.length) +
        " note, " + string(topics.length) + " temi).");
    lines.append("");
    lines.append("Temi ricavati da: " + taxonomySource + ".");
    lines.append("");
    lines.append("## Temi");
    lines.append("");
    foreach (var topic in topics) {
        var suffix = "";
        if (str.trim(string(topic.description)) != "") {
            suffix = " - " + str.trim(string(topic.description));
        }
        lines.append("- [" + topic.title + "](topics/" + topic.slug + ".md) - " +
            string(topic.count) + " note" + suffix);
    }
    lines.append("");
    lines.append("## Tutte le note");
    lines.append("");
    foreach (var topic in topics) {
        lines.append("### " + topic.title);
        lines.append("");
        foreach (var note in topic.notes) {
            lines.append("- [" + note.title + "](notes/" + note.slug + ".md) - " + note.summary);
            lines.append("  - origine: `" + note.source + "`");
        }
        lines.append("");
    }
    if (skipped.length > 0) {
        lines.append("## Documenti non distillati");
        lines.append("");
        foreach (var item in skipped) {
            lines.append("- `" + item + "`");
        }
        lines.append("");
    }
    if (truncated.length > 0) {
        lines.append("## Documenti distillati solo in parte");
        lines.append("");
        lines.append("Oltre " + string(MAX_CHUNKS) + " parti da " + string(MAX_DOC_CHARS) +
            " caratteri la coda del documento non e' stata distillata (alza MAX_CHUNKS in `secondbrain.malda`):");
        lines.append("");
        foreach (var item in truncated) {
            lines.append("- `" + item.source + "` - distillati " + string(item.used) +
                " di " + string(item.total) + " caratteri");
        }
        lines.append("");
    }
    lines.append("## Come si usa");
    lines.append("");
    lines.append("- Modalita' 3 di `secondbrain.malda`: domande in linguaggio naturale su queste note.");
    lines.append("- Modalita' 2: aggiornamento incrementale da file nuovi/modificati nell'origine.");
    lines.append("- `" + CATALOG_NAME + "`: catalogo leggibile a macchina usato dal recupero.");
    lines.append("");
    io.writeFile(io.pathJoin(brainDir, "index.md"), str.join(lines, "\n"));
}

function writeCatalog(brainDir, docsRoot, notes, topics, taxonomySource) {
    var slimNotes = [];
    foreach (var note in notes) {
        var sourceKey = note.sourceKey;
        if (sourceKey == null or str.trim(string(sourceKey)) == "") {
            sourceKey = sourceKeyOf(note.source);
        }
        var contentHash = "";
        if (note.contentHash != null) {
            contentHash = string(note.contentHash);
        }
        slimNotes.append({
            "slug": note.slug,
            "title": note.title,
            "path": "notes/" + note.slug + ".md",
            "source": note.source,
            "sourceKey": sourceKey,
            "contentHash": contentHash,
            "topic": note.topic,
            "tags": note.tags,
            "summary": note.summary,
            "headings": note.headings
        });
    }
    var slimTopics = [];
    foreach (var topic in topics) {
        slimTopics.append({
            "title": topic.title,
            "slug": topic.slug,
            "path": "topics/" + topic.slug + ".md",
            "description": topic.description,
            "count": topic.count
        });
    }
    var catalog = {
        "version": 2,
        "generatedAt": now(),
        "sourceFolder": docsRoot,
        "taxonomy": taxonomySource,
        "model": modelLabel(),
        "notes": slimNotes,
        "topics": slimTopics
    };
    io.writeFile(io.pathJoin(brainDir, CATALOG_NAME), toJSON(catalog));
}

// ---------------------------------------------------------------- mode 1

function collectDocs(root) {
    var patterns = ["**/*.md", "**/*.markdown", "**/*.html", "**/*.htm"];
    var found = [];
    var truncated = false;
    foreach (var pattern in patterns) {
        var result = io.glob(pattern, root);
        if (result.truncated) {
            truncated = true;
        }
        foreach (var item in result.items) {
            if (item.type == "file") {
                var rel = normalizePath(item.path);
                if (not str.includes(found, rel)) {
                    found.append(rel);
                }
            }
        }
    }
    return { "files": sort(found), "truncated": truncated };
}

function topicOf(relPath) {
    var parts = str.split(relPath, "/");
    if (parts.length > 1) {
        return parts[0];
    }
    return "documenti principali";
}

// ---------------------------------------------------------------- exploration

// Balanced {...} slice starting at startIndex, respecting JSON strings.
function sliceBalancedObject(text, startIndex) {
    var s = string(text);
    if (startIndex < 0 || startIndex >= str.length(s)) {
        return null;
    }
    if (str.substring(s, startIndex, startIndex + 1) != "{") {
        return null;
    }
    var depth = 0;
    var inString = false;
    var escape = false;
    var i = startIndex;
    while (i < str.length(s)) {
        var c = str.substring(s, i, i + 1);
        if (inString) {
            if (escape) {
                escape = false;
            } else if (c == "\\") {
                escape = true;
            } else if (c == "\"") {
                inString = false;
            }
        } else {
            if (c == "\"") {
                inString = true;
            } else if (c == "{") {
                depth = depth + 1;
            } else if (c == "}") {
                depth = depth - 1;
                if (depth == 0) {
                    return str.substring(s, startIndex, i + 1);
                }
            }
        }
        i = i + 1;
    }
    return null;
}

// Find a JSON object that contains "key", walking brace-balanced from each hit.
function extractJsonWithKey(text, key) {
    var s = str.trim(string(text));
    if (s == "") {
        return null;
    }
    var needle = "\"" + key + "\"";
    var pos = 0;
    while (pos < str.length(s)) {
        var rest = str.substring(s, pos, str.length(s));
        var rel = str.indexOf(rest, needle);
        if (rel < 0) {
            return null;
        }
        var keyAt = pos + rel;
        var start = keyAt;
        while (start >= 0) {
            if (str.substring(s, start, start + 1) == "{") {
                break;
            }
            start = start - 1;
        }
        if (start >= 0) {
            var slice = sliceBalancedObject(s, start);
            if (slice != null) {
                try {
                    var parsed = parseJSON(slice);
                    if (parsed != null) {
                        return parsed;
                    }
                } catch (e) {
                    // try an earlier '{' / later key occurrence
                }
            }
        }
        pos = keyAt + 1;
    }
    return null;
}

// Pull a JSON object out of a reply that may include prose or code fences.
function extractJsonObject(response) {
    var s = str.trim(string(response));
    if (s == "") {
        return null;
    }
    var fenced = str.regexFind(s, "(?s)^```(?:json)?\\s*(.*?)\\s*```$");
    if (fenced.length > 0 && fenced[0].groups.length > 1) {
        s = str.trim(fenced[0].groups[1]);
    }
    try {
        return parseJSON(s);
    } catch (e) {
        // fall through
    }
    var withThemes = extractJsonWithKey(s, "themes");
    if (withThemes != null) {
        return withThemes;
    }
    var hits = str.regexFind(s, "(?s)\\{.*\\}");
    if (hits.length == 0) {
        return null;
    }
    try {
        return parseJSON(hits[0].text);
    } catch (e) {
        return null;
    }
}

// Prefer final content; if empty, mine JSON out of reasoning (never use raw CoT as answer).
function parseExplorerThemes(parts) {
    var parsed = extractJsonObject(parts.content);
    if (parsed != null && parsed.themes != null) {
        return parsed;
    }
    parsed = extractJsonWithKey(parts.content, "themes");
    if (parsed != null && parsed.themes != null) {
        return parsed;
    }
    parsed = extractJsonWithKey(parts.reasoning, "themes");
    if (parsed != null && parsed.themes != null) {
        return parsed;
    }
    parsed = extractJsonObject(parts.reasoning);
    if (parsed != null && parsed.themes != null) {
        return parsed;
    }
    return null;
}

function previewText(text, maxChars) {
    var s = str.trim(string(text));
    if (s == "") {
        return "";
    }
    if (str.length(s) <= maxChars) {
        return s;
    }
    return str.substring(s, 0, maxChars) + "\n...[" + string(str.length(s) - maxChars) + " more chars]";
}

// Dump content + a short reasoning preview (not the full CoT dump).
function printExplorerReply(parts, reason) {
    AnsiConsole.markupLine("  [yellow]" + reason + "[/]");
    var content = "";
    var reasoning = "";
    if (parts != null) {
        if (parts.content != null) {
            content = string(parts.content);
        }
        if (parts.reasoning != null) {
            reasoning = string(parts.reasoning);
        }
    }
    if (str.trim(content) == "" && str.trim(reasoning) == "") {
        io.print(t(
            "  (empty reply — check OpenRouter model, quota, or network)",
            "  (risposta vuota — controlla modello OpenRouter, quota o rete)"));
        return;
    }
    io.print(t("  --- explorer content ---", "  --- content esploratore ---"));
    if (str.trim(content) == "") {
        io.print(t("  (empty — model returned only reasoning/CoT)",
            "  (vuoto — il modello ha restituito solo reasoning/CoT)"));
    } else {
        io.print(previewText(content, 2000));
    }
    if (str.trim(reasoning) != "") {
        io.print(t("  --- explorer reasoning (preview) ---",
            "  --- reasoning esploratore (anteprima) ---"));
        io.print(previewText(reasoning, 800));
    }
    io.print(t("  --- end explorer reply ---", "  --- fine risposta esploratore ---"));
}

function findDoc(docs, candidate) {
    var wanted = str.lower(normalizePath(str.trim(string(candidate))));
    wanted = str.regexReplace(wanted, "^\\./", "");
    foreach (var rel in docs) {
        if (str.lower(rel) == wanted) {
            return rel;
        }
    }
    // The model sometimes cites only the file name: accept it when unambiguous.
    var matches = [];
    foreach (var rel in docs) {
        if (str.lower(io.getFileName(rel)) == wanted) {
            matches.append(rel);
        }
    }
    if (matches.length == 1) {
        return matches[0];
    }
    return null;
}

function exploreInstructions() {
    return "Sei un architetto della documentazione. Proponi una tassonomia per temi. " +
        "La lista documenti e' gia' nel messaggio utente: usala cosi' com'e', senza strumenti. " +
        "Raggruppa per argomento reale (nomi/percorsi), non solo per cartelle. " +
        "CRITICO per modelli thinking (DeepSeek): puoi ragionare nel canale reasoning, " +
        "ma il canale content NON puo' essere vuoto — deve contenere SOLO l'oggetto JSON " +
        "della tassonomia (niente markdown, niente prose). Se content e' vuoto il task fallisce.";
}

function exploreSchemaHint() {
    return "{\"themes\": [{\"title\": \"nome del tema\", \"description\": " +
        "\"una o due frasi su cosa copre\", \"documents\": [\"percorso1\", \"percorso2\"]}]}";
}

function exploreDocBlock(docsRoot, listed) {
    return "Cartella della documentazione: " + docsRoot + "\n\n" +
        "Documenti (percorsi relativi; usali ESATTAMENTE cosi'):\n" +
        str.join(listed, "\n");
}

// Fresh agent + ultra-short ask: helps DeepSeek when the first turn burned tokens on CoT.
function coerceExplorerThemesJson(docsRoot, listed, draftReasoning) {
    var schemaHint = exploreSchemaHint();
    var coercer = newPlainAgent(
        "ExplorerJson",
        "emette JSON",
        "Sei una macchina che emette solo JSON. " +
        "Il content della risposta deve essere UN oggetto JSON valido e nient'altro. " +
        "Niente markdown, niente spiegazioni, niente code fence. " +
        "Inizia il content con { e termina con }."
    );
    var question = exploreDocBlock(docsRoot, listed) + "\n\n";
    if (draftReasoning != null and str.trim(string(draftReasoning)) != "") {
        question = question +
            "Bozza di ragionamento (incompleta o senza JSON finale) — usala solo come indizio:\n" +
            previewText(draftReasoning, 3500) + "\n\n";
    }
    question = question +
        "Compito: da 2 a 12 temi che coprano TUTTI i documenti elencati. " +
        "Ogni documento in esattamente un tema. Nomi tema nella lingua dei file. " +
        "Coppia .html/.md con lo stesso stem possono stare nello stesso tema.\n\n" +
        "OUTPUT OBBLIGATORIO nel content (copia lo schema e riempilo):\n" +
        schemaHint;
    return tryThinkParts(coercer, question);
}

// Step 0: the agent inspects the folder on its own and proposes themes.
function exploreTaxonomy(docsRoot, docs) {
    var listed = docs;
    var listTruncated = false;
    if (docs.length > MAX_EXPLORE_DOCS) {
        listed = [];
        var i = 0;
        while (i < MAX_EXPLORE_DOCS) {
            listed.append(docs[i]);
            i = i + 1;
        }
        listTruncated = true;
        AnsiConsole.markupLine(t(
            "[yellow]Explorer list limited to[/] " + string(MAX_EXPLORE_DOCS) +
            " [yellow]of[/] " + string(docs.length) +
            "[yellow] documents; the rest will use subfolders as theme.[/]",
            "[yellow]Elenco per l'esploratore limitato a[/] " + string(MAX_EXPLORE_DOCS) +
            " [yellow]documenti su[/] " + string(docs.length) +
            "[yellow]; i restanti useranno le sottocartelle come tema.[/]"));
    }

    // Tool-less: document paths are already in the prompt. Avoids DeepSeek V4
    // tool-loop failures (reasoning_content must be replayed after tool_calls).
    var explorer = newPlainAgent("Explorer", "architetto della documentazione",
        exploreInstructions());

    var schemaHint = exploreSchemaHint();
    var question = exploreDocBlock(docsRoot, listed) + "\n\n" +
        "Proponi da 2 a 12 temi che coprano tutti i documenti elencati. Ogni documento " +
        "va in esattamente un tema. Usa i percorsi esattamente come compaiono nell'elenco. " +
        "Dai ai temi nomi nella lingua della documentazione.\n\n" +
        "OBBLIGO: nel content (non solo nel reasoning) metti SOLO questo JSON, " +
        "iniziando con {\"themes\":\n" +
        schemaHint;

    var parts = tryThinkParts(explorer, question);
    var parsed = parseExplorerThemes(parts);
    var lastReasoning = "";
    if (parts != null and parts.reasoning != null) {
        lastReasoning = string(parts.reasoning);
    }

    if (parsed == null) {
        printExplorerReply(parts, t(
            "explorer reply is not valid JSON — retrying same agent...",
            "risposta esploratore non e' JSON valido — ritento sullo stesso agent..."));
        parts = tryThinkParts(explorer,
            "STOP. Il content era vuoto o senza JSON. " +
            "Ignora ulteriore analisi lunga. Scrivi ORA nel content SOLO l'oggetto JSON " +
            "(prima carattere { , ultima }). Niente markdown. Schema:\n" + schemaHint +
            "\nDeve includere tutti i percorsi dell'elenco precedente.");
        parsed = parseExplorerThemes(parts);
        if (parts != null and parts.reasoning != null and str.trim(string(parts.reasoning)) != "") {
            lastReasoning = string(parts.reasoning);
        }
    }

    if (parsed == null) {
        printExplorerReply(parts, t(
            "explorer still CoT-only — coercing with a fresh JSON-only agent...",
            "ancora solo CoT — costringo con un agent JSON-only nuovo..."));
        parts = coerceExplorerThemesJson(docsRoot, listed, lastReasoning);
        parsed = parseExplorerThemes(parts);
    }

    if (parsed == null) {
        printExplorerReply(parts, t(
            "explorer did not return valid JSON",
            "l'esploratore non ha restituito JSON valido"));
        return null;
    }
    if (parsed.themes == null) {
        printExplorerReply(parts, t(
            "explorer response missing 'themes' field",
            "risposta dell'esploratore senza campo 'themes'"));
        return null;
    }

    var themes = [];
    var assigned = [];
    var unknown = [];
    foreach (var raw in parsed.themes) {
        var title = "";
        if (raw.title != null) {
            title = str.trim(string(raw.title));
        }
        if (title == "") {
            continue;
        }
        var description = "";
        if (raw.description != null) {
            description = str.trim(string(raw.description));
        }
        var members = [];
        if (raw.documents != null) {
            foreach (var candidate in raw.documents) {
                var rel = findDoc(docs, candidate);
                if (rel == null) {
                    unknown.append(string(candidate));
                } else if (not str.includes(assigned, rel)) {
                    // First theme that claims a document wins: avoid double assignment.
                    assigned.append(rel);
                    members.append(rel);
                }
            }
        }
        if (members.length > 0) {
            themes.append({
                "title": title,
                "slug": slugify(title),
                "description": description,
                "documents": members
            });
        }
    }

    if (themes.length == 0) {
        printExplorerReply(parts, t(
            "no usable themes in the explorer response",
            "nessun tema utilizzabile nella risposta dell'esploratore"));
        return null;
    }
    return {
        "themes": themes,
        "assignedCount": assigned.length,
        "unknownCount": unknown.length,
        "listTruncated": listTruncated
    };
}

function themeTopicOf(rel, taxonomy) {
    if (taxonomy != null) {
        foreach (var theme in taxonomy.themes) {
            if (str.includes(theme.documents, rel)) {
                return theme.title;
            }
        }
    }
    return topicOf(rel);
}

function describeTaxonomy(taxonomy, docs) {
    var colTheme = t("theme", "tema");
    var colDocs = t("documents", "documenti");
    var colDesc = t("description", "descrizione");
    var rows = [];
    foreach (var theme in taxonomy.themes) {
        var row = {};
        row[colTheme] = theme.title;
        row[colDocs] = string(theme.documents.length);
        row[colDesc] = theme.description;
        rows.append(row);
    }
    AnsiConsole.table(rows, t("Taxonomy proposed by the explorer", "Tassonomia proposta dall'esploratore"),
        [colTheme, colDocs, colDesc]);
    var leftover = docs.length - taxonomy.assignedCount;
    if (leftover > 0) {
        AnsiConsole.markupLine("[yellow]" + string(leftover) + t(
            " unassigned documents:[/] they will use the subfolder as theme.",
            " documenti non assegnati:[/] useranno la sottocartella come tema."));
    }
    if (taxonomy.unknownCount > 0) {
        AnsiConsole.markupLine("[yellow]" + string(taxonomy.unknownCount) + t(
            " paths cited by the explorer do not exist:[/] ignored.",
            " percorsi citati dall'esploratore non esistono:[/] ignorati."));
    }
}

function descriptionOfTheme(taxonomy, title) {
    if (taxonomy == null) {
        return "";
    }
    foreach (var theme in taxonomy.themes) {
        if (theme.title == title) {
            return theme.description;
        }
    }
    return "";
}

function uniqueSlug(base, notes) {
    var candidate = base;
    var suffix = 2;
    var clash = true;
    while (clash) {
        clash = false;
        foreach (var note in notes) {
            if (note.slug == candidate) {
                clash = true;
            }
        }
        if (clash) {
            candidate = base + "-" + string(suffix);
            suffix = suffix + 1;
        }
    }
    return candidate;
}

function sourceKeyOf(source) {
    var s = string(source);
    s = str.regexReplace(s, " \\(part \\d+ of \\d+\\)$", "");
    s = str.regexReplace(s, " \\(parte \\d+ di \\d+\\)$", "");
    return s;
}

function contentHashOf(text) {
    return str.sha256(string(text));
}

function catalogEntrySourceKey(entry) {
    if (entry.sourceKey != null and str.trim(string(entry.sourceKey)) != "") {
        return string(entry.sourceKey);
    }
    return sourceKeyOf(entry.source);
}

function loadNoteBody(brainDir, entry) {
    var path = io.pathJoin(brainDir, "notes", entry.slug + ".md");
    if (not io.hasFile(path)) {
        return "";
    }
    var text = io.readFile(path);
    var summary = "";
    if (entry.summary != null) {
        summary = string(entry.summary);
    }
    if (summary != "") {
        var marker = "\n> " + summary + "\n\n";
        var start = str.indexOf(text, marker);
        if (start >= 0) {
            start = start + str.length(marker);
            var rest = str.substring(text, start, str.length(text));
            var end = str.indexOf(rest, "\n## Note collegate");
            if (end >= 0) {
                return str.trim(str.substring(rest, 0, end));
            }
            return str.trim(rest);
        }
    }
    var found = str.regexFind(text, "(?s)\\n> [^\\n]+\\n\\n([\\s\\S]*?)\\n## Note collegate");
    if (found.length > 0) {
        return str.trim(found[0].groups[1]);
    }
    return "";
}

function noteFromCatalogEntry(brainDir, entry) {
    var tags = [];
    if (entry.tags != null) {
        tags = entry.tags;
    }
    var headings = [];
    if (entry.headings != null) {
        headings = entry.headings;
    }
    var hash = "";
    if (entry.contentHash != null) {
        hash = string(entry.contentHash);
    }
    return {
        "slug": entry.slug,
        "title": entry.title,
        "summary": entry.summary,
        "tags": tags,
        "body": loadNoteBody(brainDir, entry),
        "topic": entry.topic,
        "source": entry.source,
        "sourceKey": catalogEntrySourceKey(entry),
        "contentHash": hash,
        "headings": headings
    };
}

function groupNotesBySource(notes) {
    var groups = [];
    foreach (var note in notes) {
        var key = note.sourceKey;
        if (key == null or str.trim(string(key)) == "") {
            key = sourceKeyOf(note.source);
        }
        var found = null;
        foreach (var g in groups) {
            if (g.key == key) {
                found = g;
            }
        }
        if (found == null) {
            found = {
                "key": key,
                "hash": "",
                "notes": []
            };
            groups.append(found);
        }
        found.notes.append(note);
        if (note.contentHash != null and str.trim(string(note.contentHash)) != "") {
            found.hash = string(note.contentHash);
        }
    }
    return groups;
}

function findSourceGroup(groups, key) {
    foreach (var g in groups) {
        if (g.key == key) {
            return g;
        }
    }
    return null;
}

function deleteNoteFile(brainDir, slug) {
    var path = io.pathJoin(brainDir, "notes", slug + ".md");
    if (io.hasFile(path)) {
        io.deleteFile(path);
    }
}

function topicDescriptionFromCatalog(catalog, title) {
    if (catalog == null or catalog.topics == null) {
        return "";
    }
    foreach (var topic in catalog.topics) {
        if (topic.title == title) {
            if (topic.description != null) {
                return string(topic.description);
            }
            return "";
        }
    }
    return "";
}

function listContains(items, value) {
    foreach (var item in items) {
        if (item == value) {
            return true;
        }
    }
    return false;
}

// Distill one source document into notes[] and write note files. Returns { skipped, truncated }.
function distillSourceFile(distiller, docsRoot, brainDir, rel, taxonomy, notes, contentHash) {
    var absPath = io.pathJoin(docsRoot, rel);
    var text = "";
    try {
        text = extractText(absPath);
    } catch (e) {
        AnsiConsole.markupLine("  [red]" + t("read failed:", "lettura fallita:") + "[/] " + string(e));
        return { "skipped": true, "truncated": null };
    }
    if (str.trim(text) == "") {
        AnsiConsole.markupLine("  [yellow]" + t(
            "empty or non-text, skipped",
            "vuoto o non testuale, ignorato") + "[/]");
        return { "skipped": true, "truncated": null };
    }
    if (contentHash == null or str.trim(string(contentHash)) == "") {
        contentHash = contentHashOf(text);
    }

    var chunks = chunkText(text, MAX_DOC_CHARS, MAX_CHUNKS);
    var consumed = 0;
    foreach (var piece in chunks) {
        consumed = consumed + str.length(piece);
    }
    var truncated = null;
    if (consumed < str.length(text)) {
        truncated = {
            "source": rel,
            "used": consumed,
            "total": str.length(text)
        };
        AnsiConsole.markupLine("  [yellow]" + t("document too long:", "documento troppo lungo:") +
            "[/] " + t("distilled ", "distillati ") +
            string(consumed) + t(" of ", " di ") + string(str.length(text)) +
            t(" characters", " caratteri"));
    }
    var partIndex = 0;
    foreach (var chunk in chunks) {
        partIndex = partIndex + 1;
        var partLabel = "";
        if (chunks.length > 1) {
            partLabel = t(
                " (part " + string(partIndex) + " of " + string(chunks.length) + ")",
                " (parte " + string(partIndex) + " di " + string(chunks.length) + ")");
        }
        distiller.reset();
        var response = tryThink(distiller, distillQuestion(rel, partLabel, chunk));
        var fallbackTitle = io.getFileName(rel) + partLabel;
        var parsed = parseDistilled(response, fallbackTitle, chunk);

        var note = {
            "slug": uniqueSlug(slugify(parsed.title), notes),
            "title": parsed.title,
            "summary": parsed.summary,
            "tags": parsed.tags,
            "body": parsed.body,
            "topic": themeTopicOf(rel, taxonomy),
            "source": rel + partLabel,
            "sourceKey": rel,
            "contentHash": contentHash,
            "headings": headingsOf(parsed.body)
        };
        notes.append(note);
        writeNoteFile(brainDir, note);
        AnsiConsole.markupLine("  [green]" + t("note", "nota") + "[/] notes/" + note.slug + ".md");
    }
    return { "skipped": false, "truncated": truncated };
}

// Link notes, rebuild hubs/index/catalog. touchedTopics: null = all hubs use LLM;
// otherwise only listed topic titles call the curator (others reuse catalog descriptions).
function finalizeBrain(brainDir, docsRoot, notes, skipped, truncated, taxonomySource, taxonomy, catalog, touchedTopics) {
    io.print("");
    io.print(t("Linking notes...", "Collegamento delle note..."));
    writeRelatedSections(brainDir, notes);

    io.print(t("Building topic hubs...", "Costruzione degli hub tematici..."));
    var topics = topicsOf(notes);
    var curator = newCodingAgent(
        "Curator",
        "curatore di knowledge base",
        "Scrivi introduzioni brevi e concrete per gli hub tematici di " + productName() + ". " +
        "Non inventare contenuti: usa solo i titoli e i riassunti forniti. " +
        "Non usare gli strumenti sui file.",
        brainDir
    );
    foreach (var topic in topics) {
        var fromTaxonomy = descriptionOfTheme(taxonomy, topic.title);
        var fromCatalog = topicDescriptionFromCatalog(catalog, topic.title);
        if (fromTaxonomy != "") {
            topic.description = fromTaxonomy;
        } else {
            topic.description = fromCatalog;
        }
        var useLlm = touchedTopics == null or listContains(touchedTopics, topic.title);
        if (useLlm) {
            curator.reset();
            writeTopicHub(brainDir, topic, curator);
        } else {
            writeTopicHub(brainDir, topic, null);
        }
        AnsiConsole.markupLine("  [green]hub[/] topics/" + topic.slug + ".md");
    }

    if (catalog != null and catalog.topics != null) {
        foreach (var oldTopic in catalog.topics) {
            var stillThere = false;
            foreach (var topic in topics) {
                if (topic.slug == oldTopic.slug) {
                    stillThere = true;
                }
            }
            if (not stillThere) {
                var hubPath = io.pathJoin(brainDir, "topics", oldTopic.slug + ".md");
                if (io.hasFile(hubPath)) {
                    io.deleteFile(hubPath);
                    AnsiConsole.markupLine("  [dim]" + t("removed hub", "hub rimosso") +
                        "[/] topics/" + oldTopic.slug + ".md");
                }
            }
        }
    }

    writeIndex(brainDir, docsRoot, notes, topics, skipped, truncated, taxonomySource);
    writeCatalog(brainDir, docsRoot, notes, topics, taxonomySource);
    return topics;
}

function buildBrain() {
    AnsiConsole.markupLine("");
    AnsiConsole.panel(
        t("Reads .md and .html and distills linked notes for " + productName() + ".",
            "Legge .md e .html e distilla note collegate per " + productName() + "."),
        t("[bold]Mode 1 - BUILD[/]", "[bold]Modalita' 1 - COSTRUISCI[/]"), "rounded");

    var docsRoot = str.trim(io.input(t("Documentation folder: ", "Cartella della documentazione: ")));
    if (docsRoot == "") {
        io.print(t("Cancelled.", "Annullato."));
        return false;
    }
    if (not io.hasDirectory(docsRoot)) {
        AnsiConsole.markupLine("[red]" + t("Folder not found:", "Cartella non trovata:") + "[/] " + docsRoot);
        return false;
    }

    var brainDir = str.trim(io.input(t(
        productName() + " folder [secondbrain]: ",
        "Cartella " + productName() + " [secondbrain]: ")));
    if (brainDir == "") {
        brainDir = "secondbrain";
    }
    applyProductNameFromBrain(brainDir);
    if (io.hasFile(io.pathJoin(brainDir, CATALOG_NAME))) {
        var confirm = str.trim(io.input(t(
            productName() + " already exists in this folder: matching files will be overwritten. Proceed? " + ynHint() + ": ",
            productName() + " esiste gia' in questa cartella: i file omonimi verranno sovrascritti. Procedo? " + ynHint() + ": ")));
        if (not isAffirmative(confirm)) {
            io.print(t("Cancelled.", "Annullato."));
            return false;
        }
    }

    var scan = collectDocs(docsRoot);
    var docs = scan.files;
    if (docs.length == 0) {
        AnsiConsole.markupLine("[yellow]" + t("No .md / .html files found in", "Nessun file .md / .html trovato in") +
            "[/] " + docsRoot);
        return false;
    }
    if (scan.truncated) {
        AnsiConsole.markupLine("[yellow]" + t("Warning:", "Attenzione:") + "[/] " + t(
            "file search was truncated by the runtime; some documents are missing from the list.",
            "la ricerca dei file e' stata troncata dal runtime; alcuni documenti non sono nell'elenco."));
    }

    AnsiConsole.markupLine("");
    AnsiConsole.markupLine(t("Documents found:", "Documenti trovati:") + " [bold]" + string(docs.length) + "[/]");
    AnsiConsole.markupLine("LLM: [bold]" + modelLabel() + "[/]");
    AnsiConsole.markupLine("[dim]" + t(
        "One exploration call, one per document, one per theme: paid models incur a cost.",
        "Una chiamata di esplorazione, una per documento, una per tema: con modelli a pagamento questo ha un costo.") + "[/]");
    var go = str.trim(io.input(t(
        "Start distillation? " + ynHint() + ": ",
        "Avvio la distillazione? " + ynHint() + ": ")));
    if (not isAffirmative(go)) {
        io.print(t("Cancelled.", "Annullato."));
        return false;
    }

    io.print("");
    io.print(t("Exploring documentation...", "Esplorazione della documentazione..."));
    var taxonomy = exploreTaxonomy(docsRoot, docs);
    var taxonomySource = t("subfolders", "sottocartelle");
    if (taxonomy != null) {
        io.print("");
        describeTaxonomy(taxonomy, docs);
        var keep = str.trim(io.input(t(
            "Use this taxonomy? (y = yes, n = group by subfolder): ",
            "Uso questa tassonomia? (s = si, n = raggruppa per sottocartella): ")));
        if (isNegative(keep)) {
            taxonomy = null;
        } else {
            taxonomySource = t("LLM exploration", "esplorazione LLM");
        }
    }
    if (taxonomy == null) {
        AnsiConsole.markupLine("[dim]" + t(
            "Themes derived from folder structure.",
            "Temi ricavati dalla struttura di cartelle.") + "[/]");
    }

    io.ensureDir(brainDir);
    io.ensureDir(io.pathJoin(brainDir, "notes"));
    io.ensureDir(io.pathJoin(brainDir, "topics"));

    var distiller = newCodingAgent(
        "Distiller",
        "knowledge engineer",
        distillInstructions(),
        docsRoot
    );

    var notes = [];
    var skipped = [];
    var truncated = [];
    var index = 0;
    foreach (var rel in docs) {
        index = index + 1;
        AnsiConsole.markupLine("[dim][[" + string(index) + "/" + string(docs.length) + "]][/] " + rel);
        var outcome = distillSourceFile(distiller, docsRoot, brainDir, rel, taxonomy, notes, "");
        if (outcome.skipped) {
            skipped.append(rel);
        } else if (outcome.truncated != null) {
            truncated.append(outcome.truncated);
        }
    }

    if (notes.length == 0) {
        AnsiConsole.markupLine("[red]" + t("No notes produced.", "Nessuna nota prodotta.") + "[/]");
        return false;
    }

    var topics = finalizeBrain(brainDir, docsRoot, notes, skipped, truncated, taxonomySource, taxonomy, null, null);

    io.print("");
    var colKey = t("item", "voce");
    var colVal = t("value", "valore");
    var summaryRows = [];
    var r1 = {};
    r1[colKey] = t("documents read", "documenti letti");
    r1[colVal] = string(docs.length - skipped.length);
    summaryRows.append(r1);
    var r2 = {};
    r2[colKey] = t("documents skipped", "documenti ignorati");
    r2[colVal] = string(skipped.length);
    summaryRows.append(r2);
    var r3 = {};
    r3[colKey] = t("documents truncated", "documenti troncati");
    r3[colVal] = string(truncated.length);
    summaryRows.append(r3);
    var r4 = {};
    r4[colKey] = t("notes produced", "note prodotte");
    r4[colVal] = string(notes.length);
    summaryRows.append(r4);
    var r5 = {};
    r5[colKey] = t("themes", "temi");
    r5[colVal] = string(topics.length);
    summaryRows.append(r5);
    var r6 = {};
    r6[colKey] = t("taxonomy", "tassonomia");
    r6[colVal] = taxonomySource;
    summaryRows.append(r6);
    var r7 = {};
    r7[colKey] = t("folder", "cartella");
    r7[colVal] = brainDir;
    summaryRows.append(r7);
    AnsiConsole.table(summaryRows, t(productName() + " built", productName() + " costruito"), [colKey, colVal]);
    AnsiConsole.markupLine(t("Index:", "Indice:") + " [bold]" + io.pathJoin(brainDir, "index.md") + "[/]");
    return true;
}

function updateBrain() {
    AnsiConsole.markupLine("");
    AnsiConsole.panel(
        t("Updates an existing " + productName() + ": only new or changed source files are re-distilled.",
            "Aggiorna " + productName() + " esistente: ridistilla solo i file di origine nuovi o modificati."),
        t("[bold]Mode 2 - UPDATE[/]", "[bold]Modalita' 2 - AGGIORNA[/]"), "rounded");

    var brainDir = str.trim(io.input(t(
        productName() + " folder [secondbrain]: ",
        "Cartella " + productName() + " [secondbrain]: ")));
    if (brainDir == "") {
        brainDir = "secondbrain";
    }
    applyProductNameFromBrain(brainDir);
    var catalog = loadCatalog(brainDir);
    if (catalog == null or catalog.notes == null) {
        AnsiConsole.markupLine("[red]" + t(
            "No usable catalog in ",
            "Nessun catalogo utilizzabile in ") + brainDir +
            t(". Run mode 1 (BUILD) first.", ". Esegui prima la modalita' 1 (COSTRUISCI).") + "[/]");
        return false;
    }

    var defaultRoot = "";
    if (catalog.sourceFolder != null) {
        defaultRoot = str.trim(string(catalog.sourceFolder));
    }
    var docsPrompt = t("Documentation folder", "Cartella della documentazione");
    if (defaultRoot != "") {
        docsPrompt = docsPrompt + " [" + defaultRoot + "]";
    }
    docsPrompt = docsPrompt + ": ";
    var docsRoot = str.trim(io.input(docsPrompt));
    if (docsRoot == "") {
        docsRoot = defaultRoot;
    }
    if (docsRoot == "") {
        io.print(t("Cancelled.", "Annullato."));
        return false;
    }
    if (not io.hasDirectory(docsRoot)) {
        AnsiConsole.markupLine("[red]" + t("Folder not found:", "Cartella non trovata:") + "[/] " + docsRoot);
        return false;
    }

    var scan = collectDocs(docsRoot);
    var docs = scan.files;
    if (docs.length == 0) {
        AnsiConsole.markupLine("[yellow]" + t("No .md / .html files found in", "Nessun file .md / .html trovato in") +
            "[/] " + docsRoot);
        return false;
    }
    if (scan.truncated) {
        AnsiConsole.markupLine("[yellow]" + t("Warning:", "Attenzione:") + "[/] " + t(
            "file search was truncated by the runtime; some documents are missing from the list.",
            "la ricerca dei file e' stata troncata dal runtime; alcuni documenti non sono nell'elenco."));
    }

    var existingNotes = [];
    foreach (var entry in catalog.notes) {
        existingNotes.append(noteFromCatalogEntry(brainDir, entry));
    }
    var groups = groupNotesBySource(existingNotes);

    var unchanged = [];
    var changed = [];
    var added = [];
    var missingHash = 0;
    foreach (var rel in docs) {
        var absPath = io.pathJoin(docsRoot, rel);
        var text = "";
        try {
            text = extractText(absPath);
        } catch (e) {
            changed.append(rel);
            continue;
        }
        if (str.trim(text) == "") {
            changed.append(rel);
            continue;
        }
        var hash = contentHashOf(text);
        var group = findSourceGroup(groups, rel);
        if (group == null) {
            added.append(rel);
        } else if (group.hash == "" or group.hash == null) {
            missingHash = missingHash + 1;
            changed.append(rel);
        } else if (group.hash != hash) {
            changed.append(rel);
        } else {
            unchanged.append(rel);
        }
    }

    var removed = [];
    foreach (var g in groups) {
        if (not listContains(docs, g.key)) {
            removed.append(g.key);
        }
    }

    AnsiConsole.markupLine("");
    AnsiConsole.markupLine(t("Scan:", "Scansione:") + " [bold]" + string(docs.length) + "[/] " +
        t("source files", "file di origine"));
    AnsiConsole.markupLine("  [green]" + t("unchanged", "invariati") + "[/] " + string(unchanged.length));
    AnsiConsole.markupLine("  [yellow]" + t("changed", "modificati") + "[/] " + string(changed.length));
    AnsiConsole.markupLine("  [cyan]" + t("new", "nuovi") + "[/] " + string(added.length));
    AnsiConsole.markupLine("  [dim]" + t("removed from source", "rimossi dall'origine") + "[/] " +
        string(removed.length));
    if (missingHash > 0) {
        AnsiConsole.markupLine("[yellow]" + t(
            "Legacy catalog without content hashes: those sources will be re-distilled once.",
            "Catalogo legacy senza hash: quelle origini verranno ridistillate una volta.") + "[/]");
    }
    AnsiConsole.markupLine("LLM: [bold]" + modelLabel() + "[/]");

    if (changed.length == 0 and added.length == 0 and removed.length == 0) {
        AnsiConsole.markupLine("[green]" + t(
            "Already up to date — nothing to do.",
            "Gia' aggiornato — nulla da fare.") + "[/]");
        return true;
    }

    var removeOrphans = false;
    if (removed.length > 0) {
        var drop = str.trim(io.input(t(
            "Remove notes for " + string(removed.length) + " source file(s) missing from the folder? " +
                ynHint() + ": ",
            "Rimuovo le note di " + string(removed.length) + " file assenti dalla cartella? " +
                ynHint() + ": ")));
        removeOrphans = isAffirmative(drop);
    }

    var toDistill = added.length + changed.length;
    AnsiConsole.markupLine("[dim]" + t(
        "LLM calls: about one per changed/new document (plus hub refresh for touched themes).",
        "Chiamate LLM: circa una per documento nuovo/modificato (piu' refresh hub dei temi toccati).") + "[/]");
    var go = str.trim(io.input(t(
        "Apply update (" + string(toDistill) + " to distill)? " + ynHint() + ": ",
        "Applico l'aggiornamento (" + string(toDistill) + " da distillare)? " + ynHint() + ": ")));
    if (not isAffirmative(go)) {
        io.print(t("Cancelled.", "Annullato."));
        return false;
    }

    var notes = [];
    var touchedTopics = [];
    foreach (var rel in unchanged) {
        var group = findSourceGroup(groups, rel);
        if (group != null) {
            foreach (var note in group.notes) {
                notes.append(note);
            }
        }
    }

    if (removeOrphans) {
        foreach (var rel in removed) {
            var group = findSourceGroup(groups, rel);
            if (group != null) {
                foreach (var note in group.notes) {
                    if (not listContains(touchedTopics, note.topic)) {
                        touchedTopics.append(note.topic);
                    }
                    deleteNoteFile(brainDir, note.slug);
                    AnsiConsole.markupLine("  [dim]" + t("removed note", "nota rimossa") +
                        "[/] notes/" + note.slug + ".md");
                }
            }
        }
    } else {
        foreach (var rel in removed) {
            var group = findSourceGroup(groups, rel);
            if (group != null) {
                foreach (var note in group.notes) {
                    notes.append(note);
                }
            }
        }
    }

    var distiller = newCodingAgent(
        "Distiller",
        "knowledge engineer",
        distillInstructions(),
        docsRoot
    );
    var skipped = [];
    var truncated = [];
    var work = [];
    foreach (var rel in changed) {
        work.append(rel);
    }
    foreach (var rel in added) {
        work.append(rel);
    }

    var index = 0;
    foreach (var rel in work) {
        index = index + 1;
        AnsiConsole.markupLine("[dim][[" + string(index) + "/" + string(work.length) + "]][/] " + rel);
        var previous = [];
        var group = findSourceGroup(groups, rel);
        if (group != null) {
            foreach (var oldNote in group.notes) {
                previous.append(oldNote);
                if (not listContains(touchedTopics, oldNote.topic)) {
                    touchedTopics.append(oldNote.topic);
                }
                deleteNoteFile(brainDir, oldNote.slug);
            }
        }
        var absPath = io.pathJoin(docsRoot, rel);
        var hash = "";
        try {
            hash = contentHashOf(extractText(absPath));
        } catch (e) {
            hash = "";
        }
        var outcome = distillSourceFile(distiller, docsRoot, brainDir, rel, null, notes, hash);
        if (outcome.skipped) {
            skipped.append(rel);
            foreach (var oldNote in previous) {
                notes.append(oldNote);
                writeNoteFile(brainDir, oldNote);
            }
        } else {
            if (outcome.truncated != null) {
                truncated.append(outcome.truncated);
            }
            foreach (var note in notes) {
                if (note.sourceKey == rel and not listContains(touchedTopics, note.topic)) {
                    touchedTopics.append(note.topic);
                }
            }
        }
    }

    if (notes.length == 0) {
        AnsiConsole.markupLine("[red]" + t("No notes left in the brain.", "Nessuna nota rimasta nel brain.") + "[/]");
        return false;
    }

    // Rewrite kept note files so related markers are refreshable.
    foreach (var note in notes) {
        var isFresh = listContains(work, note.sourceKey);
        if (not isFresh) {
            if (note.body == null or str.trim(string(note.body)) == "") {
                note.body = loadNoteBody(brainDir, note);
            }
            writeNoteFile(brainDir, note);
        }
    }

    var taxonomySource = t("subfolders", "sottocartelle");
    if (catalog.taxonomy != null and str.trim(string(catalog.taxonomy)) != "") {
        taxonomySource = string(catalog.taxonomy);
    }
    taxonomySource = taxonomySource + t(" + incremental update", " + aggiornamento incrementale");

    var topics = finalizeBrain(
        brainDir, docsRoot, notes, skipped, truncated, taxonomySource, null, catalog, touchedTopics);

    io.print("");
    var colKey = t("item", "voce");
    var colVal = t("value", "valore");
    var summaryRows = [];
    var u1 = {};
    u1[colKey] = t("unchanged sources", "origini invariate");
    u1[colVal] = string(unchanged.length);
    summaryRows.append(u1);
    var u2 = {};
    u2[colKey] = t("re-distilled", "ridistillati");
    u2[colVal] = string(work.length - skipped.length);
    summaryRows.append(u2);
    var u3 = {};
    u3[colKey] = t("removed sources", "origini rimosse");
    if (removeOrphans) {
        u3[colVal] = string(removed.length);
    } else {
        u3[colVal] = "0 (" + string(removed.length) + " " + t("kept", "mantenute") + ")";
    }
    summaryRows.append(u3);
    var u4 = {};
    u4[colKey] = t("notes total", "note totali");
    u4[colVal] = string(notes.length);
    summaryRows.append(u4);
    var u5 = {};
    u5[colKey] = t("themes", "temi");
    u5[colVal] = string(topics.length);
    summaryRows.append(u5);
    var u6 = {};
    u6[colKey] = t("folder", "cartella");
    u6[colVal] = brainDir;
    summaryRows.append(u6);
    AnsiConsole.table(summaryRows, t(productName() + " updated", productName() + " aggiornato"), [colKey, colVal]);
    AnsiConsole.markupLine(t("Index:", "Indice:") + " [bold]" + io.pathJoin(brainDir, "index.md") + "[/]");
    return true;
}

// ---------------------------------------------------------------- mode 3 (ASK)

function loadCatalog(brainDir) {
    var catalogPath = io.pathJoin(brainDir, CATALOG_NAME);
    if (not io.hasFile(catalogPath)) {
        return null;
    }
    try {
        return parseJSON(io.readFile(catalogPath));
    } catch (e) {
        AnsiConsole.markupLine("[red]" + t("Unreadable catalog:", "Catalogo illeggibile:") + "[/] " + string(e));
        return null;
    }
}

function metadataScore(questionTokens, note) {
    var haystack = str.lower(note.title + " " + note.topic + " " +
        str.join(note.tags, " ") + " " + note.summary + " " + str.join(note.headings, " "));
    var haystackTokens = str.tokenize(haystack);
    var titleTokens = str.tokenize(str.lower(note.title + " " + str.join(note.tags, " ")));
    var score = 0.0;
    foreach (var token in questionTokens) {
        if (str.length(token) < 3) {
            continue;
        }
        if (str.includes(haystackTokens, token)) {
            score = score + 1.0;
        } else if (str.indexOf(haystack, token) >= 0) {
            score = score + 0.5;
        }
        if (str.includes(titleTokens, token)) {
            score = score + 1.0;
        }
    }
    return score;
}

function bodyScore(brainDir, questionTokens, note) {
    var path = io.pathJoin(brainDir, note.path);
    if (not io.hasFile(path)) {
        return 0.0;
    }
    var body = "";
    try {
        body = str.lower(io.readFile(path));
    } catch (e) {
        return 0.0;
    }
    var bodyTokens = str.tokenize(body);
    var score = 0.0;
    foreach (var token in questionTokens) {
        if (str.length(token) < 3) {
            continue;
        }
        if (str.includes(bodyTokens, token)) {
            score = score + 0.5;
        }
    }
    return score;
}

// Retrieval: catalog metadata first, then note bodies if needed.
function selectNotes(brainDir, catalog, question) {
    var questionTokens = str.tokenize(str.lower(question));
    var scored = [];
    var best = 0.0;
    foreach (var note in catalog.notes) {
        var score = metadataScore(questionTokens, note);
        if (score > best) {
            best = score;
        }
        scored.append({ "note": note, "score": score });
    }
    if (best < 1.5) {
        foreach (var entry in scored) {
            entry.score = entry.score + bodyScore(brainDir, questionTokens, entry.note);
        }
    }

    var picked = [];
    var used = [];
    var slot = 0;
    while (slot < TOP_K) {
        var bestIndex = -1;
        var bestScore = 0.0;
        var i = 0;
        while (i < scored.length) {
            if (not str.includes(used, i) and scored[i].score > bestScore) {
                bestScore = scored[i].score;
                bestIndex = i;
            }
            i = i + 1;
        }
        if (bestIndex < 0) {
            slot = TOP_K;
        } else {
            used.append(bestIndex);
            picked.append(scored[bestIndex]);
            slot = slot + 1;
        }
    }
    return picked;
}

function buildContext(brainDir, picked) {
    var blocks = [];
    foreach (var entry in picked) {
        var note = entry.note;
        var path = io.pathJoin(brainDir, note.path);
        var body = "";
        try {
            body = io.readFile(path);
        } catch (e) {
            body = "";
        }
        if (str.length(body) > MAX_NOTE_CHARS) {
            body = str.substring(body, 0, MAX_NOTE_CHARS) + "\n[...nota troncata...]";
        }
        blocks.append("### NOTA " + note.slug + "\n" +
            "titolo: " + note.title + "\n" +
            "tema: " + note.topic + "\n" +
            "file: " + note.path + "\n" +
            "origine: " + note.source + "\n\n" + body);
    }
    return str.join(blocks, "\n\n");
}

function answerInstructions(useTools) {
    var text = "Rispondi alle domande usando esclusivamente " + productName() + " fornito. " +
        "Cita le note su cui ti basi con la forma [nota: slug]. " +
        "Se le note non contengono la risposta, dillo esplicitamente e indica quale nota " +
        "si avvicina di piu'. Non inventare API, parametri o comportamenti. ";
    if (useTools == true) {
        text = text +
            "Puoi usare gli strumenti read_file, grep e list_directory per aprire altre note " +
            "di " + productName() + " se il contesto fornito non basta. ";
    } else {
        text = text +
            "Non hai strumenti: usa solo gli estratti forniti nel prompt; non inventare " +
            "contenuti di altre note. ";
    }
    return text +
        "Rispondi nella lingua della domanda, in modo conciso e strutturato. Formatta la risposta in Markdown " +
        "(grassetto, elenchi, tabelle se utili); non usare HTML grezzo.";
}

function chatOnlyInstructions() {
    return "Sei un assistente utile in chat diretta. Non c'e' " + productName() +
        " / knowledge base disponibile per questa sessione: rispondi con le tue conoscenze generali. " +
        "Rispondi nella lingua della domanda, in modo conciso e strutturato. " +
        "Formatta la risposta in Markdown (grassetto, elenchi, tabelle se utili); " +
        "non usare HTML grezzo.";
}

function catalogNoteCount(catalog) {
    if (catalog == null or catalog.notes == null) {
        return 0;
    }
    return catalog.notes.length;
}

function runChatOnlyTurn(question) {
    AnsiConsole.markupLine("[dim]" + t(
        "direct chat (no " + productName() + " retrieval)",
        "chat diretta (nessun recupero da " + productName() + ")") + "[/]");
    var responder = newPlainAgent(
        "ChatAssistant",
        "assistente in chat",
        chatOnlyInstructions()
    );
    var answer = str.trim(tryThink(responder, question));
    if (answer == "") {
        return {
            "question": question,
            "answer": "",
            "sources": [],
            "error": t("No answer from the LLM.", "Nessuna risposta dall'LLM.")
        };
    }
    return {
        "question": question,
        "answer": answer,
        "sources": [],
        "error": ""
    };
}

function resolveAskBrainRoot() {
    if (io.hasEmbeddedFolder("secondbrain")) {
        var root = io.embeddedFolderRoot("secondbrain");
        AnsiConsole.markupLine("[dim]" + t(
            "Using embedded " + productName() + " (no disk folder).",
            "Uso " + productName() + " incorporato (nessuna cartella su disco).") + "[/]");
        return root;
    }
    var brainDir = str.trim(io.input(t(
        productName() + " folder [secondbrain]: ",
        "Cartella " + productName() + " [secondbrain]: ")));
    if (brainDir == "") {
        brainDir = "secondbrain";
    }
    return brainDir;
}

function askSourcesFromPicked(picked) {
    var sources = [];
    foreach (var entry in picked) {
        sources.append({
            "slug": entry.note.slug,
            "title": entry.note.title,
            "path": entry.note.path,
            "source": entry.note.source,
            "score": entry.score,
            "scoreHint": ""
        });
    }
    return sources;
}

// Called from the shared ASK web UI on each @ACTION /ask.
function runAskTurn(question) {
    var session = askGetSession();
    var brainDir = askAsText(session.brainDir);
    var catalog = ui.state(ASK_STORE, "catalog", null, ASK_SESSION_ID);
    var chatOnly = session.chatOnly == true or catalogNoteCount(catalog) == 0;
    if (chatOnly) {
        return runChatOnlyTurn(question);
    }

    var picked = selectNotes(brainDir, catalog, question);
    if (picked.length == 0) {
        AnsiConsole.markupLine("[yellow]" + t(
            "No relevant notes; falling back to direct chat.",
            "Nessuna nota pertinente; passo alla chat diretta.") + "[/]");
        return runChatOnlyTurn(question);
    }

    var sources = askSourcesFromPicked(picked);
    var names = [];
    foreach (var entry in picked) {
        names.append(entry.note.slug);
    }
    AnsiConsole.markupLine("[dim]" + t("retrieved notes: ", "note recuperate: ") +
        str.join(names, ", ") + "[/]");

    var useTools = askGetToolsEnabled();
    var responder = null;
    if (useTools) {
        AnsiConsole.markupLine("[dim]" + t(
            "ASK tools: on (read_file / grep / list_directory)",
            "Tool ASK: attivi (read_file / grep / list_directory)") + "[/]");
        responder = newReaderAgent(
            "BrainReader",
            "assistente di knowledge base",
            answerInstructions(true),
            brainDir
        );
    } else {
        AnsiConsole.markupLine("[dim]" + t(
            "ASK tools: off (retrieved excerpts only)",
            "Tool ASK: disattivi (solo estratti recuperati)") + "[/]");
        responder = newPlainAgent(
            "BrainReader",
            "assistente di knowledge base",
            answerInstructions(false)
        );
    }
    var context = buildContext(brainDir, picked);
    var answer = str.trim(tryThink(responder,
        "SECOND BRAIN (estratti pertinenti):\n\n" + context +
        "\n\n----\nDOMANDA: " + question));
    if (answer == "") {
        return {
            "question": question,
            "answer": "",
            "sources": sources,
            "error": t("No answer from the LLM.", "Nessuna risposta dall'LLM.")
        };
    }
    return {
        "question": question,
        "answer": answer,
        "sources": sources,
        "error": ""
    };
}

include "secondbrain_ask_ui_lib.malda";

function askBrain() {
    AnsiConsole.markupLine("");
    AnsiConsole.panel(
        t("Opens a local web UI to ask questions against " + productName() + " from BUILD/UPDATE.",
            "Apre una UI web locale per fare domande su " + productName() + " di COSTRUISCI/AGGIORNA."),
        t("[bold]Mode 3 - ASK (web)[/]", "[bold]Modalita' 3 - CHIEDI (web)[/]"), "rounded");

    var brainDir = resolveAskBrainRoot();
    askApplyProductNameFromBrain(brainDir);
    askApplyLogoFromBrain(brainDir);
    if (askLogoPathMissing()) {
        AnsiConsole.markupLine("[yellow]" + t(
            "ASK_LOGO not found (check path; use / or \\\\ in Windows strings): ",
            "ASK_LOGO non trovato (controlla il path; in stringhe Windows usa / o \\\\): ") +
            ASK_LOGO + "[/]");
    }
    var catalog = loadCatalog(brainDir);
    var noteCount = catalogNoteCount(catalog);
    var topicCount = 0;
    var sourceFolder = brainDir;
    var chatOnly = noteCount == 0;
    if (catalog != null) {
        if (catalog.topics != null) {
            topicCount = catalog.topics.length;
        }
        if (catalog.sourceFolder != null and askAsText(catalog.sourceFolder) != "") {
            sourceFolder = catalog.sourceFolder;
        }
    }

    if (chatOnly) {
        AnsiConsole.markupLine("[yellow]" + t(
            "No " + productName() + " notes found — ASK will open as direct chat with the model.",
            "Nessuna nota di " + productName() + " — ASK si apre in chat diretta col modello.") + "[/]");
        if (catalog == null) {
            AnsiConsole.markupLine("[dim]" + t("Missing", "Manca") + " " + CATALOG_NAME +
                t(" in ", " in ") + brainDir +
                t(". Run mode 1 later to enable retrieval.",
                    ". Esegui dopo la modalita' 1 per abilitare il recupero.") + "[/]");
        }
    }

    var retrieval = t("none (direct chat)", "nessuno (chat diretta)");
    var subtitle = t(
        "Direct chat with the model (no " + productName() + " retrieval).",
        "Chat diretta col modello (nessun recupero da " + productName() + ").");
    if (not chatOnly) {
        retrieval = t("lexical token overlap", "sovrapposizione lessicale di token");
        subtitle = t(
            "Lexical retrieval over the distilled note tree.",
            "Recupero lessicale sull'albero di note distillate.");
    }

    ui.setState(ASK_STORE, "lang", UI_LANG, ASK_SESSION_ID);
    ui.setState(ASK_STORE, "catalog", catalog, ASK_SESSION_ID);
    ui.setState(ASK_STORE, "pendingStop", false, ASK_SESSION_ID);
    askSetToolsEnabled(false);
    askClearHistory();
    askSetSession({
        "brainDir": brainDir,
        "chatOnly": chatOnly,
        "noteCount": noteCount,
        "topicCount": topicCount,
        "sourceFolder": sourceFolder,
        "retrieval": retrieval,
        "llm": modelLabel(),
        "title": ASK_PAGE_TITLE,
        "subtitle": subtitle
    });

    if (chatOnly) {
        AnsiConsole.markupLine(t("Mode:", "Modalita':") + " [bold]" +
            t("direct chat", "chat diretta") + "[/]");
    } else {
        AnsiConsole.markupLine(productName() + ": [bold]" + string(noteCount) + "[/] " +
            t("notes", "note") + ", [bold]" +
            string(topicCount) + "[/] " + t("themes", "temi") +
            t(", from `", ", da `") + string(sourceFolder) + "`");
    }
    AnsiConsole.markupLine("LLM: [bold]" + modelLabel() + "[/]");

    askHttpServer = new HttpServer(ASK_HTTP_PORT);
    askHttpServer.start();
    AnsiConsole.markupLine("");
    AnsiConsole.markupLine(t("Open:", "Apri:") + " [bold blue]http://localhost:" +
        string(ASK_HTTP_PORT) + "/[/]");
    AnsiConsole.markupLine("[dim]" + t(
        "Stop the process from the console (Ctrl+C) to return here. The web UI cannot stop the server.",
        "Ferma il processo dalla console (Ctrl+C) per tornare qui. La pagina web non puo' fermare il server.") + "[/]");

    while (askHttpServer != null and askHttpServer.isRunning) {
        if (askConsumePendingStop()) {
            askHttpServer.stop();
            break;
        }
        sleep(200);
    }
    askHttpServer = null;
    AnsiConsole.markupLine(t("ASK server stopped.", "Server ASK fermato."));
    return true;
}

// ---------------------------------------------------------------- pack portable ASK exe

function packPortableAskExe() {
    AnsiConsole.markupLine("");
    AnsiConsole.panel(
        t("Compiles a portable ASK-only .exe that embeds the " + productName() + " folder " +
            "(no disk extract). Requires a brain built with mode 1.",
            "Compila un .exe ASK portatile che incorpora la cartella di " + productName() + " " +
            "(nessuna estrazione su disco). Serve un brain creato con la modalita' 1."),
        t("[bold]Mode 4 - PACK[/]", "[bold]Modalita' 4 - PACCHETTO[/]"), "rounded");

    var brainDir = str.trim(io.input(t(
        productName() + " folder [" + EMBED_ALIAS + "]: ",
        "Cartella " + productName() + " [" + EMBED_ALIAS + "]: ")));
    if (brainDir == "") {
        brainDir = EMBED_ALIAS;
    }
    applyProductNameFromBrain(brainDir);
    if (not io.hasDirectory(brainDir)) {
        AnsiConsole.markupLine("[red]" + t("Folder not found:", "Cartella non trovata:") +
            "[/] " + brainDir);
        return false;
    }
    if (not io.hasFile(io.pathJoin(brainDir, CATALOG_NAME))) {
        AnsiConsole.markupLine("[red]" + t("Missing", "Manca") + " " + CATALOG_NAME +
            t(" in ", " in ") + brainDir +
            t(". Run mode 1 (BUILD) first.", ". Esegui prima la modalita' 1 (COSTRUISCI).") + "[/]");
        return false;
    }

    var outputPath = str.trim(io.input(t(
        "Output exe [" + DEFAULT_PACK_OUTPUT + "]: ",
        "Exe di output [" + DEFAULT_PACK_OUTPUT + "]: ")));
    if (outputPath == "") {
        outputPath = DEFAULT_PACK_OUTPUT;
    }
    // If the user types a folder, pack into <folder>/<default exe name>.
    if (io.hasDirectory(outputPath)) {
        var packExeName = io.getFileName(DEFAULT_PACK_OUTPUT);
        if (packExeName == "") {
            packExeName = "secondbrain.exe";
        }
        outputPath = io.pathJoin(outputPath, packExeName);
    }

    var sourcePath = io.pathJoin(getProgramDirectory(), SOURCE_SCRIPT_NAME);
    if (not io.hasFile(sourcePath)) {
        sourcePath = SOURCE_SCRIPT_NAME;
    }
    if (not io.hasFile(sourcePath)) {
        AnsiConsole.markupLine("[red]" + t("Source script not found:", "Sorgente non trovato:") +
            "[/] " + SOURCE_SCRIPT_NAME);
        return false;
    }

    // Keep the runtime alias stable so the packed exe auto-starts ASK.
    var embedSpec = brainDir + "=" + EMBED_ALIAS;
    AnsiConsole.markupLine("[dim]" + t("Compiling (this may take a minute)…",
        "Compilazione in corso (puo' richiedere un minuto)…") + "[/]");
    AnsiConsole.markupLine("[dim]compileMALDA(\"" + sourcePath + "\", \"" + outputPath +
        "\", \"transpile\", \"" + embedSpec + "\")[/]");

    var result = compileMALDA(sourcePath, outputPath, "transpile", embedSpec);
    if (result == null or result.success != true) {
        var err = "";
        if (result != null and result.error != null) {
            err = string(result.error);
        }
        if (err == "") {
            err = t("Unknown compilation error.", "Errore di compilazione sconosciuto.");
        }
        // Escape dynamic text: compile errors often contain [paths] that Spectre would treat as styles.
        AnsiConsole.markupLine("[red]" + t("Pack failed:", "Pacchetto non riuscito:") +
            "[/] " + str.replace(str.replace(err, "[", "[["), "]", "]]"));
        return false;
    }

    var written = outputPath;
    if (result.outputPath != null and string(result.outputPath) != "") {
        written = string(result.outputPath);
    }
    AnsiConsole.markupLine("[green]" + t("Portable ASK exe ready:", "Exe ASK portatile pronto:") +
        "[/] [bold]" + str.replace(str.replace(string(written), "[", "[["), "]", "]]") + "[/]");
    AnsiConsole.markupLine("[dim]" + t(
        "Run the .exe to open ASK with the embedded brain. Branding in the brain folder " +
            "(auto-loaded): product_name.txt and optional logo.png / logo.svg.",
        "Avvia l'.exe per aprire ASK col brain incorporato. Branding nella cartella del brain " +
            "(auto-caricato): product_name.txt e logo.png / logo.svg opzionale.") + "[/]");
    return true;
}

// ---------------------------------------------------------------- menu

function showMenu() {
    AnsiConsole.markupLine("");
    AnsiConsole.panel(
        t("[bold]1[/]  BUILD   a CodingAgent reads .md/.html and distills " + productName() + "\n" +
            "[bold]2[/]  UPDATE  refresh brain from new/changed source files only\n" +
            "[bold]3[/]  ASK     web UI — questions against " + productName() + "\n" +
            "[bold]4[/]  language  switch UI language (English / Italian)\n" +
            "[bold]5[/]  PACK    portable ASK .exe with embedded " + productName() + "\n" +
            "[bold]0[/]  quit",
            "[bold]1[/]  COSTRUISCI  un CodingAgent legge .md/.html e distilla " + productName() + "\n" +
            "[bold]2[/]  AGGIORNA    aggiorna il brain solo con file nuovi/modificati\n" +
            "[bold]3[/]  CHIEDI      UI web — domande su " + productName() + "\n" +
            "[bold]4[/]  lingua      cambia lingua interfaccia (English / Italiano)\n" +
            "[bold]5[/]  PACCHETTO  .exe ASK portatile con " + productName() + " incorporato\n" +
            "[bold]0[/]  esci"),
        "[bold blue]MALDA " + productName() + "[/]", "double");
}

if (io.hasEmbeddedFolder("secondbrain")) {
    // Portable ASK-only exe: skip console menu/language — ASK web UI has EN/IT.
    askBrain();
} else {
    chooseLanguage();
    showMenu();
    while (true) {
        var choice = str.trim(io.input(t("Choice (1/2/3/4/5/0): ", "Scelta (1/2/3/4/5/0): ")));
        if (choice == "" or choice == "0") {
            io.print(t("Goodbye.", "A presto."));
            break;
        }
        if (choice == "1") {
            buildBrain();
            showMenu();
        } else if (choice == "2") {
            updateBrain();
            showMenu();
        } else if (choice == "3") {
            askBrain();
            showMenu();
        } else if (choice == "4") {
            chooseLanguage();
            showMenu();
        } else if (choice == "5") {
            packPortableAskExe();
            showMenu();
        } else {
            AnsiConsole.markupLine("[yellow]" + t("Invalid choice.", "Scelta non valida.") + "[/]");
        }
    }
}
