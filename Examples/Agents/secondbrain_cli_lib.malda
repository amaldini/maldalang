// secondbrain_cli_lib.malda - shared CLI parsing for secondbrain*.malda
//
// Included by the host after t() / UI_LANG helpers. Parses getCommandLineArgs()
// style arrays (script path + host flags like --strict-types are ignored).
//
// Modes: build | update | ask | help
// Flags: --docs --brain --taxonomy llm|folders --remove-orphans --lang en|it
//        --port / -p  --host <addr>  --https --cert <path> --cert-password <pwd>
//        --mode <name>  --auth / --no-auth
//        --allow-register / --no-register
//        --product-name / --name  (display name; overrides product_name.txt)
//        --help / -h
// Host: localhost (default), 127.0.0.1, IP/hostname, 0.0.0.0 or * (all interfaces).
// HTTPS: --https requires --cert (.pfx/.p12 or .pem/.crt + .key).

function sbCliAsText(value) {
    if (value == null) {
        return "";
    }
    return string(value);
}

function sbCliEmptyOptions() {
    return {
        "mode": "",
        "docs": "",
        "brain": "",
        "taxonomy": "llm",
        "removeOrphans": false,
        "lang": "",
        "port": null,
        "portError": false,
        "host": null,
        "hostError": false,
        "https": false,
        "cert": "",
        "certPassword": "",
        "auth": null,
        "allowRegister": null,
        "productName": "",
        "error": ""
    };
}

function sbCliNormalizeHost(raw) {
    var s = str.trim(sbCliAsText(raw));
    if (s == "") {
        return "";
    }
    if (s == "*" or str.lower(s) == "all") {
        return "0.0.0.0";
    }
    return s;
}

function sbCliIsModeName(raw) {
    var a = str.lower(str.trim(sbCliAsText(raw)));
    return a == "build" or a == "update" or a == "ask" or a == "help" or a == "pack";
}

function sbCliEndsWithMalda(raw) {
    var a = str.lower(str.trim(sbCliAsText(raw)));
    return str.endsWith(a, ".malda");
}

function sbCliIsHostSkipFlag(raw) {
    var a = str.lower(str.trim(sbCliAsText(raw)));
    return a == "--strict-types" or a == "--profile";
}

function sbCliIsHostSkipFlagWithValue(raw) {
    var a = str.lower(str.trim(sbCliAsText(raw)));
    return a == "--profile-output" or a == "--profile-format" or
        a == "--profile-periodic-seconds";
}

function sbCliParsePortNumber(raw) {
    var s = str.trim(sbCliAsText(raw));
    if (s == "") {
        return null;
    }
    var n = toIntOrNull(s);
    if (n == null) {
        return null;
    }
    if (n < 1 or n > 65535) {
        return null;
    }
    return n;
}

function sbCliNormalizeMode(raw) {
    var a = str.lower(str.trim(sbCliAsText(raw)));
    if (a == "build" or a == "update" or a == "ask" or a == "help" or a == "pack") {
        return a;
    }
    return "";
}

function sbCliNormalizeLang(raw) {
    var a = str.lower(str.trim(sbCliAsText(raw)));
    if (a == "en" or a == "english" or a == "e" or a == "1") {
        return "en";
    }
    if (a == "it" or a == "italiano" or a == "italian" or a == "i" or a == "2") {
        return "it";
    }
    return "";
}

function sbCliNormalizeTaxonomy(raw) {
    var a = str.lower(str.trim(sbCliAsText(raw)));
    if (a == "llm" or a == "explore" or a == "exploration") {
        return "llm";
    }
    if (a == "folders" or a == "folder" or a == "subfolders" or a == "subfolder") {
        return "folders";
    }
    return "";
}

function sbCliTakeFlagValue(args, i, flag) {
    // Returns { value, nextIndex, ok, missing }
    var a = str.trim(sbCliAsText(args[i]));
    var prefix = flag + "=";
    if (str.startsWith(a, prefix)) {
        // Empty value after '=' (e.g. --host=) — avoid str.substring(start >= length).
        var valueLen = str.length(a) - str.length(flag) - 1;
        var value = "";
        if (valueLen > 0) {
            value = str.substring(a, str.length(flag) + 1, valueLen);
        }
        return {
            "value": value,
            "nextIndex": i + 1,
            "ok": true,
            "missing": false
        };
    }
    if (a == flag) {
        if (i + 1 >= args.length) {
            return { "value": "", "nextIndex": i + 1, "ok": false, "missing": true };
        }
        return {
            "value": sbCliAsText(args[i + 1]),
            "nextIndex": i + 2,
            "ok": true,
            "missing": false
        };
    }
    return { "value": "", "nextIndex": i, "ok": false, "missing": false };
}

function sbCliParseArgs(args) {
    var opt = sbCliEmptyOptions();
    if (args == null) {
        return opt;
    }
    var i = 0;
    while (i < args.length) {
        var a = str.trim(sbCliAsText(args[i]));
        if (a == "" or sbCliEndsWithMalda(a)) {
            i = i + 1;
            continue;
        }
        if (sbCliIsHostSkipFlag(a)) {
            i = i + 1;
            continue;
        }
        if (sbCliIsHostSkipFlagWithValue(a)) {
            if (i + 1 < args.length) {
                i = i + 2;
            } else {
                i = i + 1;
            }
            continue;
        }
        if (a == "--help" or a == "-h" or a == "help") {
            opt.mode = "help";
            i = i + 1;
            continue;
        }
        if (sbCliIsModeName(a) and opt.mode == "") {
            opt.mode = sbCliNormalizeMode(a);
            i = i + 1;
            continue;
        }

        var taken = sbCliTakeFlagValue(args, i, "--mode");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true or sbCliNormalizeMode(taken.value) == "") {
                opt.error = "Invalid --mode (use build, update, ask, or help).";
                return opt;
            }
            opt.mode = sbCliNormalizeMode(taken.value);
            i = taken.nextIndex;
            continue;
        }

        taken = sbCliTakeFlagValue(args, i, "--docs");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true or str.trim(taken.value) == "") {
                opt.error = "Missing value for --docs.";
                return opt;
            }
            opt.docs = str.trim(taken.value);
            i = taken.nextIndex;
            continue;
        }

        taken = sbCliTakeFlagValue(args, i, "--brain");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true or str.trim(taken.value) == "") {
                opt.error = "Missing value for --brain.";
                return opt;
            }
            opt.brain = str.trim(taken.value);
            i = taken.nextIndex;
            continue;
        }

        taken = sbCliTakeFlagValue(args, i, "--taxonomy");
        if (taken.ok == true or taken.missing == true) {
            var tax = sbCliNormalizeTaxonomy(taken.value);
            if (taken.missing == true or tax == "") {
                opt.error = "Invalid --taxonomy (use llm or folders).";
                return opt;
            }
            opt.taxonomy = tax;
            i = taken.nextIndex;
            continue;
        }

        taken = sbCliTakeFlagValue(args, i, "--lang");
        if (taken.ok == true or taken.missing == true) {
            var lang = sbCliNormalizeLang(taken.value);
            if (taken.missing == true or lang == "") {
                opt.error = "Invalid --lang (use en or it).";
                return opt;
            }
            opt.lang = lang;
            i = taken.nextIndex;
            continue;
        }

        taken = sbCliTakeFlagValue(args, i, "--product-name");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true or str.trim(taken.value) == "") {
                opt.error = "Missing value for --product-name.";
                return opt;
            }
            opt.productName = str.trim(taken.value);
            i = taken.nextIndex;
            continue;
        }
        taken = sbCliTakeFlagValue(args, i, "--name");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true or str.trim(taken.value) == "") {
                opt.error = "Missing value for --name.";
                return opt;
            }
            opt.productName = str.trim(taken.value);
            i = taken.nextIndex;
            continue;
        }

        if (a == "--remove-orphans") {
            opt.removeOrphans = true;
            i = i + 1;
            continue;
        }
        if (a == "--keep-orphans") {
            opt.removeOrphans = false;
            i = i + 1;
            continue;
        }

        // ASK cookie auth (default on unless --no-auth / MALDA_ASK_AUTH=0)
        if (a == "--auth") {
            opt.auth = true;
            i = i + 1;
            continue;
        }
        if (a == "--no-auth") {
            opt.auth = false;
            i = i + 1;
            continue;
        }
        // Open self-registration into users.json (default off)
        if (a == "--allow-register") {
            opt.allowRegister = true;
            i = i + 1;
            continue;
        }
        if (a == "--no-register") {
            opt.allowRegister = false;
            i = i + 1;
            continue;
        }

        // Port: --port / -p / --port= / -p=
        taken = sbCliTakeFlagValue(args, i, "--port");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true) {
                opt.portError = true;
                opt.error = "Missing value for --port.";
                return opt;
            }
            var p = sbCliParsePortNumber(taken.value);
            if (p == null) {
                opt.portError = true;
                opt.error = "Invalid --port value.";
                return opt;
            }
            opt.port = p;
            i = taken.nextIndex;
            continue;
        }
        taken = sbCliTakeFlagValue(args, i, "-p");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true) {
                opt.portError = true;
                opt.error = "Missing value for -p.";
                return opt;
            }
            var p2 = sbCliParsePortNumber(taken.value);
            if (p2 == null) {
                opt.portError = true;
                opt.error = "Invalid -p value.";
                return opt;
            }
            opt.port = p2;
            i = taken.nextIndex;
            continue;
        }

        // Bind host: --host / --host=  (localhost default; 0.0.0.0 / * = all interfaces)
        taken = sbCliTakeFlagValue(args, i, "--host");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true) {
                opt.hostError = true;
                opt.error = "Missing value for --host.";
                return opt;
            }
            var h = sbCliNormalizeHost(taken.value);
            if (h == "") {
                opt.hostError = true;
                opt.error = "Invalid --host value.";
                return opt;
            }
            opt.host = h;
            i = taken.nextIndex;
            continue;
        }

        if (a == "--https") {
            opt.https = true;
            i = i + 1;
            continue;
        }

        taken = sbCliTakeFlagValue(args, i, "--cert");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true or str.trim(taken.value) == "") {
                opt.error = "Missing value for --cert.";
                return opt;
            }
            opt.cert = str.trim(taken.value);
            i = taken.nextIndex;
            continue;
        }

        taken = sbCliTakeFlagValue(args, i, "--cert-password");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true) {
                opt.error = "Missing value for --cert-password.";
                return opt;
            }
            opt.certPassword = taken.value;
            i = taken.nextIndex;
            continue;
        }

        if (str.startsWith(a, "-")) {
            opt.error = "Unknown flag: " + a;
            return opt;
        }

        opt.error = "Unexpected argument: " + a;
        return opt;
    }
    if (opt.https == true and str.trim(sbCliAsText(opt.cert)) == "") {
        opt.error = "--https requires --cert <path>.";
    }
    return opt;
}

function sbCliIsNonInteractive(cli) {
    if (cli == null) {
        return false;
    }
    var m = str.trim(sbCliAsText(cli.mode));
    return m == "build" or m == "update" or m == "ask";
}

function sbCliApplyLang(cli) {
    if (cli == null) {
        return;
    }
    var lang = str.trim(sbCliAsText(cli.lang));
    if (lang == "en" or lang == "it") {
        UI_LANG = lang;
        ui.setState(ASK_STORE, "lang", UI_LANG, ASK_SESSION_ID);
    }
}

function sbCliApplyPort(cli) {
    if (cli == null or cli.port == null) {
        return ASK_HTTP_PORT;
    }
    ASK_HTTP_PORT = cli.port;
    AnsiConsole.markupLine("[dim]" + t(
        "ASK HTTP port from CLI: ",
        "Porta HTTP ASK da riga di comando: ") +
        string(ASK_HTTP_PORT) + "[/]");
    return ASK_HTTP_PORT;
}

function sbCliApplyHost(cli) {
    if (cli == null or cli.host == null) {
        return ASK_HTTP_HOST;
    }
    ASK_HTTP_HOST = sbCliNormalizeHost(cli.host);
    AnsiConsole.markupLine("[dim]" + t(
        "ASK HTTP host from CLI: ",
        "Host HTTP ASK da riga di comando: ") +
        ASK_HTTP_HOST + "[/]");
    return ASK_HTTP_HOST;
}

function sbCliApplyHttps(cli) {
    if (cli == null) {
        return ASK_HTTPS;
    }
    if (cli.https == true) {
        ASK_HTTPS = true;
        ASK_CERT_PATH = str.trim(sbCliAsText(cli.cert));
        ASK_CERT_PASSWORD = sbCliAsText(cli.certPassword);
        if (ASK_CERT_PASSWORD == "") {
            var envPwd = getEnv("MALDA_HTTP_CERT_PASSWORD");
            if (envPwd != null and str.trim(string(envPwd)) != "") {
                ASK_CERT_PASSWORD = string(envPwd);
            }
        }
        AnsiConsole.markupLine("[dim]" + t(
            "ASK HTTPS from CLI; cert: ",
            "ASK HTTPS da riga di comando; cert: ") +
            ASK_CERT_PATH + "[/]");
    }
    return ASK_HTTPS;
}

// Override PRODUCT_NAME / ASK title from --product-name / --name.
// Call after applyProductNameFromBrain / askApplyProductNameFromBrain so CLI wins.
function sbCliApplyProductName(cli) {
    if (cli == null) {
        return "";
    }
    var n = str.trim(sbCliAsText(cli.productName));
    if (n == "") {
        return "";
    }
    PRODUCT_NAME = n;
    var suffix = str.trim(sbCliAsText(ASK_TITLE_SUFFIX));
    ASK_PAGE_TITLE = n + suffix;
    ui.setState(ASK_STORE, "productName", n, ASK_SESSION_ID);
    AnsiConsole.markupLine("[dim]" + t(
        "Product name from CLI: ",
        "Nome prodotto da riga di comando: ") + n + "[/]");
    return n;
}

function sbCliPrintHelp(defaultBrain, defaultPort) {
    var brain = str.trim(sbCliAsText(defaultBrain));
    if (brain == "") {
        brain = "secondbrain";
    }
    var port = str.trim(sbCliAsText(defaultPort));
    if (port == "") {
        port = "39018";
    }
    var en =
        "Second Brain CLI\n\n" +
        "  build  --docs <folder> [--brain " + brain + "] [--taxonomy llm|folders] [--lang en|it]\n" +
        "         [--product-name <name>]\n" +
        "  update [--docs <folder>] [--brain " + brain + "] [--remove-orphans] [--lang en|it]\n" +
        "         [--product-name <name>]\n" +
        "  ask    [--brain " + brain + "] [--port " + port + "] [--host localhost] [--lang en|it]\n" +
        "         [--https --cert <pfx|pem>] [--cert-password <pwd>]\n" +
        "         [--product-name <name>] [--auth|--no-auth] [--allow-register|--no-register]\n" +
        "  help\n\n" +
        "Non-interactive: build/update/ask skip the menu and confirmations.\n" +
        "Also: --mode build|update|ask   -p <port>   --port=<n>   --host=<addr>   --name <name>\n" +
        "--host defaults to localhost; use 0.0.0.0 or * to listen on all interfaces.\n" +
        "--https requires --cert (.pfx/.p12 or .pem/.crt with sibling .key).\n" +
        "Optional: --cert-password or MALDA_HTTP_CERT_PASSWORD.\n" +
        "Privileged ports / non-localhost binds on Windows may need admin or\n" +
        "  netsh http add urlacl url=http://+:PORT/ user=Everyone\n" +
        "--product-name / --name overrides brain product_name.txt and the default title.\n" +
        "ASK auth is on by default (cookie JWT). Disable with --no-auth.\n" +
        "Bootstrap: MALDA_ASK_USER / MALDA_ASK_PASSWORD (or MALDA_ASK_PASSWORD_HASH).\n" +
        "Multi-user: users.json in the brain folder (or .malda/ask_users.json).\n" +
        "Open registration: --allow-register (or MALDA_ASK_ALLOW_REGISTER=1).\n" +
        "Pack remains interactive (menu option 5).";
    var it =
        "Second Brain CLI\n\n" +
        "  build  --docs <cartella> [--brain " + brain + "] [--taxonomy llm|folders] [--lang en|it]\n" +
        "         [--product-name <nome>]\n" +
        "  update [--docs <cartella>] [--brain " + brain + "] [--remove-orphans] [--lang en|it]\n" +
        "         [--product-name <nome>]\n" +
        "  ask    [--brain " + brain + "] [--port " + port + "] [--host localhost] [--lang en|it]\n" +
        "         [--https --cert <pfx|pem>] [--cert-password <pwd>]\n" +
        "         [--product-name <nome>] [--auth|--no-auth] [--allow-register|--no-register]\n" +
        "  help\n\n" +
        "Non interattivo: build/update/ask saltano menu e conferme.\n" +
        "Anche: --mode build|update|ask   -p <porta>   --port=<n>   --host=<addr>   --name <nome>\n" +
        "--host di default e' localhost; usa 0.0.0.0 o * per tutte le interfacce.\n" +
        "--https richiede --cert (.pfx/.p12 o .pem/.crt con .key accanto).\n" +
        "Opzionale: --cert-password o MALDA_HTTP_CERT_PASSWORD.\n" +
        "Porte privilegiate / bind non-localhost su Windows possono richiedere admin o\n" +
        "  netsh http add urlacl url=http://+:PORTA/ user=Everyone\n" +
        "--product-name / --name ha priorita' su product_name.txt e sul titolo di default.\n" +
        "Auth ASK attiva di default (cookie JWT). Disattiva con --no-auth.\n" +
        "Bootstrap: MALDA_ASK_USER / MALDA_ASK_PASSWORD (o MALDA_ASK_PASSWORD_HASH).\n" +
        "Multi-utente: users.json nella cartella del brain (o .malda/ask_users.json).\n" +
        "Registrazione aperta: --allow-register (o MALDA_ASK_ALLOW_REGISTER=1).\n" +
        "PACK resta interattivo (voce di menu 5).";
    if (UI_LANG == "en") {
        io.print(en);
    } else if (UI_LANG == "it") {
        io.print(it);
    } else {
        io.print(en);
        io.print("");
        io.print(it);
    }
}
