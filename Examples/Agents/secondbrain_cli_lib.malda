// secondbrain_cli_lib.malda - shared CLI parsing for secondbrain*.malda
//
// Pure helpers: import this module (isolated env; only export bindings merge).
// Host-bound apply/help that assign UI_LANG / ASK_* live in
// secondbrain_cli_apply_lib.malda (include after this import).
//
// Modes: build | update | ask | help
// Flags: --docs --brain --taxonomy llm|folders --remove-orphans --lang en|it
//        --port / -p  --host <addr>  --https --cert <path> --cert-password <pwd>
//        --mode <name>  --auth / --no-auth
//        --allow-register / --no-register
//        --examples / --no-examples  (sample questions on empty ASK UI)
//        --product-name / --name  (display name; overrides product_name.txt)
//        --no-powered-by / --powered-by <text> / --powered-by-url <url>
//        --help / -h
// Host: localhost (default), 127.0.0.1, IP/hostname, 0.0.0.0 or * (all interfaces).
// HTTPS: --https requires --cert (.pfx/.p12 or .pem/.crt + .key).

export function sbCliAsText(value) {
    return str.text(value);
}

// Path confinement: return path when it resolves under root (disk or embed:), else null.
// Use after io.pathJoin so ../ and rooted overrides cannot escape the intended tree.
export function sbAssertUnderRoot(root, path) {
    var r = str.trim(sbCliAsText(root));
    var p = str.trim(sbCliAsText(path));
    if (r == "" or p == "") {
        return null;
    }
    if (not io.isPathUnder(r, p)) {
        return null;
    }
    return p;
}

export function sbJoinUnderRoot(root, part1) {
    return sbAssertUnderRoot(root, io.pathJoin(root, part1));
}

export function sbJoinUnderRoot2(root, part1, part2) {
    return sbAssertUnderRoot(root, io.pathJoin(root, part1, part2));
}

export function sbJoinUnderRoot3(root, part1, part2, part3) {
    return sbAssertUnderRoot(root, io.pathJoin(root, part1, part2, part3));
}

export function sbCliEmptyOptions() {
    return {
        "mode": "",
        "docs": "",
        "brain": "",
        "taxonomy": "llm",
        "removeOrphans": false,
        "lang": "",
        "port": null,
        "portError": false,
        "host": null,
        "hostError": false,
        "https": false,
        "cert": "",
        "certPassword": "",
        "auth": null,
        "allowRegister": null,
        "showExamples": null,
        "productName": "",
        "poweredBy": null,
        "poweredByUrl": null,
        "error": ""
    };
}

export function sbCliNormalizeHost(raw) {
    var s = str.trim(sbCliAsText(raw));
    if (s == "") {
        return "";
    }
    if (s == "*" or str.lower(s) == "all") {
        return "0.0.0.0";
    }
    return s;
}

export function sbCliIsModeName(raw) {
    var a = str.lower(str.trim(sbCliAsText(raw)));
    return a == "build" or a == "update" or a == "ask" or a == "help" or a == "pack";
}

export function sbCliEndsWithMalda(raw) {
    var a = str.lower(str.trim(sbCliAsText(raw)));
    return str.endsWith(a, ".malda");
}

export function sbCliIsHostSkipFlag(raw) {
    var a = str.lower(str.trim(sbCliAsText(raw)));
    return a == "--strict-types" or a == "--profile";
}

export function sbCliIsHostSkipFlagWithValue(raw) {
    var a = str.lower(str.trim(sbCliAsText(raw)));
    return a == "--profile-output" or a == "--profile-format" or
        a == "--profile-periodic-seconds";
}

export function sbCliParsePortNumber(raw) {
    var s = str.trim(sbCliAsText(raw));
    if (s == "") {
        return null;
    }
    var n = toIntOrNull(s);
    if (n == null) {
        return null;
    }
    if (n < 1 or n > 65535) {
        return null;
    }
    return n;
}

export function sbCliNormalizeMode(raw) {
    var a = str.lower(str.trim(sbCliAsText(raw)));
    if (a == "build" or a == "update" or a == "ask" or a == "help" or a == "pack") {
        return a;
    }
    return "";
}

export function sbCliNormalizeLang(raw) {
    var a = str.lower(str.trim(sbCliAsText(raw)));
    if (a == "en" or a == "english" or a == "e" or a == "1") {
        return "en";
    }
    if (a == "it" or a == "italiano" or a == "italian" or a == "i" or a == "2") {
        return "it";
    }
    return "";
}

export function sbCliNormalizeTaxonomy(raw) {
    var a = str.lower(str.trim(sbCliAsText(raw)));
    if (a == "llm" or a == "explore" or a == "exploration") {
        return "llm";
    }
    if (a == "folders" or a == "folder" or a == "subfolders" or a == "subfolder") {
        return "folders";
    }
    return "";
}

export function sbCliTakeFlagValue(args, i, flag) {
    // Returns { value, nextIndex, ok, missing }
    var a = str.trim(sbCliAsText(args[i]));
    var prefix = flag + "=";
    if (str.startsWith(a, prefix)) {
        // Empty value after '=' (e.g. --host=) — avoid str.substring(start >= length).
        var valueLen = str.length(a) - str.length(flag) - 1;
        var value = "";
        if (valueLen > 0) {
            value = str.substring(a, str.length(flag) + 1, valueLen);
        }
        return {
            "value": value,
            "nextIndex": i + 1,
            "ok": true,
            "missing": false
        };
    }
    if (a == flag) {
        if (i + 1 >= args.length) {
            return { "value": "", "nextIndex": i + 1, "ok": false, "missing": true };
        }
        return {
            "value": sbCliAsText(args[i + 1]),
            "nextIndex": i + 2,
            "ok": true,
            "missing": false
        };
    }
    return { "value": "", "nextIndex": i, "ok": false, "missing": false };
}

export function sbCliParseArgs(args) {
    var opt = sbCliEmptyOptions();
    if (args == null) {
        return opt;
    }
    var i = 0;
    while (i < args.length) {
        var a = str.trim(sbCliAsText(args[i]));
        if (a == "" or sbCliEndsWithMalda(a)) {
            i = i + 1;
            continue;
        }
        if (sbCliIsHostSkipFlag(a)) {
            i = i + 1;
            continue;
        }
        if (sbCliIsHostSkipFlagWithValue(a)) {
            if (i + 1 < args.length) {
                i = i + 2;
            } else {
                i = i + 1;
            }
            continue;
        }
        if (a == "--help" or a == "-h" or a == "help") {
            opt.mode = "help";
            i = i + 1;
            continue;
        }
        if (sbCliIsModeName(a) and opt.mode == "") {
            opt.mode = sbCliNormalizeMode(a);
            i = i + 1;
            continue;
        }

        var taken = sbCliTakeFlagValue(args, i, "--mode");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true or sbCliNormalizeMode(taken.value) == "") {
                opt.error = "Invalid --mode (use build, update, ask, or help).";
                return opt;
            }
            opt.mode = sbCliNormalizeMode(taken.value);
            i = taken.nextIndex;
            continue;
        }

        taken = sbCliTakeFlagValue(args, i, "--docs");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true or str.trim(taken.value) == "") {
                opt.error = "Missing value for --docs.";
                return opt;
            }
            opt.docs = str.trim(taken.value);
            i = taken.nextIndex;
            continue;
        }

        taken = sbCliTakeFlagValue(args, i, "--brain");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true or str.trim(taken.value) == "") {
                opt.error = "Missing value for --brain.";
                return opt;
            }
            opt.brain = str.trim(taken.value);
            i = taken.nextIndex;
            continue;
        }

        taken = sbCliTakeFlagValue(args, i, "--taxonomy");
        if (taken.ok == true or taken.missing == true) {
            var tax = sbCliNormalizeTaxonomy(taken.value);
            if (taken.missing == true or tax == "") {
                opt.error = "Invalid --taxonomy (use llm or folders).";
                return opt;
            }
            opt.taxonomy = tax;
            i = taken.nextIndex;
            continue;
        }

        taken = sbCliTakeFlagValue(args, i, "--lang");
        if (taken.ok == true or taken.missing == true) {
            var lang = sbCliNormalizeLang(taken.value);
            if (taken.missing == true or lang == "") {
                opt.error = "Invalid --lang (use en or it).";
                return opt;
            }
            opt.lang = lang;
            i = taken.nextIndex;
            continue;
        }

        taken = sbCliTakeFlagValue(args, i, "--product-name");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true or str.trim(taken.value) == "") {
                opt.error = "Missing value for --product-name.";
                return opt;
            }
            opt.productName = str.trim(taken.value);
            i = taken.nextIndex;
            continue;
        }
        taken = sbCliTakeFlagValue(args, i, "--name");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true or str.trim(taken.value) == "") {
                opt.error = "Missing value for --name.";
                return opt;
            }
            opt.productName = str.trim(taken.value);
            i = taken.nextIndex;
            continue;
        }

        if (a == "--remove-orphans") {
            opt.removeOrphans = true;
            i = i + 1;
            continue;
        }
        if (a == "--keep-orphans") {
            opt.removeOrphans = false;
            i = i + 1;
            continue;
        }

        // ASK cookie auth (default on unless --no-auth / MALDA_ASK_AUTH=0)
        if (a == "--auth") {
            opt.auth = true;
            i = i + 1;
            continue;
        }
        if (a == "--no-auth") {
            opt.auth = false;
            i = i + 1;
            continue;
        }
        // Open self-registration into users.json (default off)
        if (a == "--allow-register") {
            opt.allowRegister = true;
            i = i + 1;
            continue;
        }
        if (a == "--no-register") {
            opt.allowRegister = false;
            i = i + 1;
            continue;
        }
        // Sample questions on the empty ASK UI (default on)
        if (a == "--examples") {
            opt.showExamples = true;
            i = i + 1;
            continue;
        }
        if (a == "--no-examples") {
            opt.showExamples = false;
            i = i + 1;
            continue;
        }

        // ASK header "Powered by …" line (default from script globals)
        if (a == "--no-powered-by") {
            opt.poweredBy = "";
            opt.poweredByUrl = "";
            i = i + 1;
            continue;
        }
        taken = sbCliTakeFlagValue(args, i, "--powered-by");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true or str.trim(taken.value) == "") {
                opt.error = "Missing value for --powered-by.";
                return opt;
            }
            opt.poweredBy = str.trim(taken.value);
            i = taken.nextIndex;
            continue;
        }
        taken = sbCliTakeFlagValue(args, i, "--powered-by-url");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true) {
                opt.error = "Missing value for --powered-by-url.";
                return opt;
            }
            opt.poweredByUrl = str.trim(taken.value);
            i = taken.nextIndex;
            continue;
        }

        // Port: --port / -p / --port= / -p=
        taken = sbCliTakeFlagValue(args, i, "--port");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true) {
                opt.portError = true;
                opt.error = "Missing value for --port.";
                return opt;
            }
            var p = sbCliParsePortNumber(taken.value);
            if (p == null) {
                opt.portError = true;
                opt.error = "Invalid --port value.";
                return opt;
            }
            opt.port = p;
            i = taken.nextIndex;
            continue;
        }
        taken = sbCliTakeFlagValue(args, i, "-p");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true) {
                opt.portError = true;
                opt.error = "Missing value for -p.";
                return opt;
            }
            var p2 = sbCliParsePortNumber(taken.value);
            if (p2 == null) {
                opt.portError = true;
                opt.error = "Invalid -p value.";
                return opt;
            }
            opt.port = p2;
            i = taken.nextIndex;
            continue;
        }

        // Bind host: --host / --host=  (localhost default; 0.0.0.0 / * = all interfaces)
        taken = sbCliTakeFlagValue(args, i, "--host");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true) {
                opt.hostError = true;
                opt.error = "Missing value for --host.";
                return opt;
            }
            var h = sbCliNormalizeHost(taken.value);
            if (h == "") {
                opt.hostError = true;
                opt.error = "Invalid --host value.";
                return opt;
            }
            opt.host = h;
            i = taken.nextIndex;
            continue;
        }

        if (a == "--https") {
            opt.https = true;
            i = i + 1;
            continue;
        }

        taken = sbCliTakeFlagValue(args, i, "--cert");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true or str.trim(taken.value) == "") {
                opt.error = "Missing value for --cert.";
                return opt;
            }
            opt.cert = str.trim(taken.value);
            i = taken.nextIndex;
            continue;
        }

        taken = sbCliTakeFlagValue(args, i, "--cert-password");
        if (taken.ok == true or taken.missing == true) {
            if (taken.missing == true) {
                opt.error = "Missing value for --cert-password.";
                return opt;
            }
            opt.certPassword = taken.value;
            i = taken.nextIndex;
            continue;
        }

        if (str.startsWith(a, "-")) {
            opt.error = "Unknown flag: " + a;
            return opt;
        }

        opt.error = "Unexpected argument: " + a;
        return opt;
    }
    if (opt.https == true and str.trim(sbCliAsText(opt.cert)) == "") {
        opt.error = "--https requires --cert <path>.";
    }
    return opt;
}

export function sbCliIsNonInteractive(cli) {
    if (cli == null) {
        return false;
    }
    var m = str.trim(sbCliAsText(cli.mode));
    return m == "build" or m == "update" or m == "ask";
}

