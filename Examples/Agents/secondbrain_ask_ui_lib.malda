        "label{display:block;font-size:0.82rem;margin:0 0 8px;color:var(--muted);font-weight:500}" +
        "label.tool-toggle{display:inline-flex;align-items:center;gap:10px;margin:0;" +
        "font-size:0.88rem;color:var(--ink);cursor:pointer;line-height:1.3;font-weight:500;" +
        "user-select:none}" +
        "label.tool-toggle input{position:absolute;opacity:0;width:1px;height:1px;overflow:hidden}" +
        "label.tool-toggle .switch{width:36px;height:20px;border-radius:999px;background:var(--switch-off);" +
        "border:1px solid var(--switch-off-border);position:relative;flex:0 0 auto;transition:background .15s ease}" +
        "label.tool-toggle .switch::after{content:'';position:absolute;top:1px;left:1px;" +
        "width:16px;height:16px;border-radius:50%;background:var(--knob);" +
        "box-shadow:0 1px 2px var(--shadow-soft);transition:transform .15s ease}" +
        "label.tool-toggle input:checked+.switch{background:var(--accent);border-color:var(--accent)}" +
        "label.tool-toggle input:checked+.switch::after{transform:translateX(16px)}" +
        "label.tool-toggle input:focus-visible+.switch{outline:2px solid var(--focus);outline-offset:2px}" +
        "textarea{width:100%;min-height:88px;resize:vertical;padding:12px 14px;border-radius:8px;" +
        "border:1px solid var(--line);background:var(--surface);color:var(--ink);font:1rem/1.45 var(--ui)}" +
        "textarea:focus{outline:2px solid var(--focus);border-color:var(--accent)}" +
        ".composer-bar{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-top:12px}" +
        ".composer-bar .actions{display:flex;gap:10px;flex-wrap:wrap;margin-left:auto}" +
        ".composer-bar .actions button:not(.ghost){order:2}" +
        ".composer-bar .actions .ghost{order:1}" +
        "button,.ghost{font-family:var(--ui);border-radius:8px;padding:10px 14px;" +
        "border:1px solid var(--accent);cursor:pointer;font-size:0.92rem;font-weight:600}" +
        "button{background:var(--accent);color:var(--btn-fg)}" +
        "button:hover{background:var(--accent-strong);color:var(--btn-fg)}" +
        ".ghost{background:transparent;color:var(--accent-ink);text-decoration:none;display:inline-block}" +
        ".ghost:hover{background:var(--hover)}" +
        ".error{color:var(--danger);margin:0}" +
        ".error-bubble{background:var(--error-bg);border-color:var(--error-border)}" +
        ".pending{color:var(--warn);margin:0;font-style:italic;font-family:var(--ui)}" +
        ".live-status,.live-dock{font-size:0.88rem;margin:8px 0 0;" +
        "color:var(--accent-ink);background:var(--live-bg);border:1px solid var(--accent-line);border-radius:8px;" +
        "padding:8px 12px;overflow-wrap:anywhere}" +
        /* Home holds the dock outside #ask-panel so fragment replace cannot destroy it.
           While live it is position:fixed above the sticky composer (see syncLiveDockPosition). */
        "#ask-live-home:empty{display:none}" +
        ".live-dock[hidden]{display:none!important}" +
        ".live-dock.is-floating{position:fixed;left:max(12px,env(safe-area-inset-left));" +
        "right:max(12px,env(safe-area-inset-right));z-index:28;margin:0;" +
        "box-shadow:0 8px 24px var(--shadow);max-height:min(30vh,9rem);overflow:auto;" +
        "-webkit-overflow-scrolling:touch}" +
        ".live-dock .live-round{font-weight:600;margin-right:6px;white-space:nowrap}" +
        ".live-dock .live-timer,.live-status .live-timer{font-variant-numeric:tabular-nums;" +
        "font-weight:600;color:var(--muted);margin-right:6px;white-space:nowrap}" +
        ".live-dock .live-dock-body{font-variant-numeric:tabular-nums}" +
        ".live-status{display:block}" +
        ".empty-state{background:var(--panel);border:1px solid var(--line);border-radius:12px;" +
        "padding:22px 20px;margin:0}" +
        ".empty-lead{margin:0 0 14px;color:var(--ink);font-size:1rem;line-height:1.45;font-weight:500}" +
        ".empty-hint{margin:0 0 14px;color:var(--muted);font-size:0.9rem;line-height:1.4}" +
        ".examples{display:flex;flex-wrap:wrap;gap:8px}" +
        ".example{font-family:var(--ui);font-size:0.86rem;font-weight:500;color:var(--accent-ink);" +
        "background:var(--surface);border:1px solid var(--accent-line);border-radius:999px;padding:8px 12px;cursor:pointer;" +
        "text-align:left;line-height:1.3;max-width:100%;overflow-wrap:anywhere}" +
        ".example:hover{background:var(--q-bg);border-color:var(--accent)}" +
        ".mode-pills{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 10px}" +
        ".mode-pill{display:inline-flex;align-items:center;cursor:pointer;margin:0}" +
        ".mode-pill input{position:absolute;opacity:0;width:1px;height:1px;overflow:hidden}" +
        ".mode-pill span{font-family:var(--ui);font-size:0.86rem;font-weight:600;color:var(--muted);" +
        "background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:6px 12px}" +
        ".mode-pill input:checked+span{color:var(--accent-ink);background:var(--pill);border-color:var(--accent)}" +
        ".mode-pill input:focus-visible+span{outline:2px solid var(--focus);outline-offset:2px}" +
        ".download-bar{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 0}" +
        ".download-bar a{font-family:var(--ui);font-size:0.84rem;font-weight:600;color:var(--accent-ink);" +
        "background:var(--pill);border:1px solid var(--accent-line);border-radius:999px;" +
        "padding:6px 12px;text-decoration:none}" +
        ".download-bar a:hover{border-color:var(--accent)}" +
        ".download-hint{margin:8px 0 0;font-size:0.8rem;color:var(--muted);line-height:1.4}" +
        ".composer{position:sticky;bottom:0;z-index:15;margin-top:20px;" +
        "background:var(--panel);border:1px solid var(--line);border-radius:12px;" +
        "padding:14px 16px;padding-bottom:max(14px,env(safe-area-inset-bottom));" +
        "box-shadow:0 -10px 28px var(--shadow-soft)}" +
        ".composer .clear-form{position:absolute;width:1px;height:1px;padding:0;margin:-1px;" +
        "overflow:hidden;clip:rect(0,0,0,0);border:0}" +
        ".busy{font-size:0.8rem;color:var(--muted);margin:0}" +
        ".busy.ready{color:var(--muted)}" +
        /* Smartphones / narrow viewports */
        "@media (max-width:640px){" +
        "main{padding:0 12px 28px;" +
        "padding-left:max(12px,env(safe-area-inset-left));" +
        "padding-right:max(12px,env(safe-area-inset-right));" +
        "padding-bottom:max(28px,env(safe-area-inset-bottom))}" +
        ".sticky-header{margin:0 -12px;padding:10px max(12px,env(safe-area-inset-right)) 8px " +
        "max(12px,env(safe-area-inset-left));padding-top:max(10px,env(safe-area-inset-top))}" +
        ".sticky-header-inner{gap:10px}" +
        ".brand{flex:1 1 100%;column-gap:8px}" +
        ".brand.has-left-logo{grid-template-columns:minmax(0,auto) minmax(0,1fr)}" +
        ".logo{height:36px;max-width:min(28vw,120px)}" +
        ".logo-right{height:min(" + logoRightH + ",36px);max-width:min(28vw,120px)}" +
        ".brand-title-row{gap:8px}" +
        ".powered-by{white-space:normal;text-overflow:unset;max-width:100%;" +
        "display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}" +
        ".header-actions{flex:1 1 100%;flex-direction:row;flex-wrap:wrap;align-items:center;" +
        "justify-content:flex-start;gap:8px 12px;padding-top:0}" +
        ".lang a{padding:8px 12px;min-height:36px;display:inline-flex;align-items:center}" +
        ".new-conv{padding:6px 0}" +
        ".meta-bar{font-size:0.78rem;gap:4px 0}" +
        ".meta-bar .dot{margin:0 6px}" +
        ".bubble{padding:12px}" +
        ".panel{padding:12px}" +
        ".empty-state{padding:16px 14px}" +
        ".examples{gap:6px}" +
        ".example{flex:1 1 calc(50% - 6px);border-radius:10px;padding:10px 12px;" +
        "font-size:0.82rem}" +
        ".composer{padding:12px;border-radius:10px;margin-top:14px}" +
        ".composer-bar{flex-direction:column;align-items:stretch;gap:10px}" +
        ".composer-bar .actions{margin-left:0;width:100%}" +
        ".composer-bar .actions button,.composer-bar .actions .ghost{flex:1 1 auto;" +
        "min-height:44px;text-align:center}" +
        "label.tool-toggle{width:100%}" +
        "textarea{min-height:96px;font-size:16px}" +
        ".source-chip{flex:1 1 100%;min-width:0}" +
        ".feedback-form{flex-wrap:wrap}" +
        ".admin-table{font-size:0.82rem}" +
        ".admin-table th,.admin-table td{padding:6px 4px}" +
        ".login-wrap{margin:24px auto;padding:0 12px}" +
        ".login-wrap h1{font-size:1.15rem;overflow-wrap:anywhere}" +
        ".live-dock.is-floating{max-height:min(22vh,7.5rem);font-size:0.84rem;padding:8px 10px}" +
        ".live-status{margin-top:10px;padding:8px 10px;border-radius:8px;" +
        "background:var(--live-bg);border:1px solid var(--accent-line);color:var(--accent-ink);" +
        "font-size:0.84rem;font-family:var(--ui);font-style:normal}" +
        "}" +
        "</style>";
}

function askLogoMime(path) {
    var lower = str.lower(askAsText(path));
    if (str.endsWith(lower, ".png")) {
        return "image/png";
    }
    if (str.endsWith(lower, ".jpg") or str.endsWith(lower, ".jpeg")) {
        return "image/jpeg";
    }
    if (str.endsWith(lower, ".gif")) {
        return "image/gif";
    }
    if (str.endsWith(lower, ".webp")) {
        return "image/webp";
    }
    if (str.endsWith(lower, ".svg")) {
        return "image/svg+xml";
    }
    if (str.endsWith(lower, ".ico")) {
        return "image/x-icon";
    }
    return "application/octet-stream";
}

function askInvalidateLogoCache() {
    ui.setState(ASK_STORE, "logoSrcCached", false, ASK_SESSION_ID);
}

function askInvalidateLogoRightCache() {
    ui.setState(ASK_STORE, "logoRightSrcCached", false, ASK_SESSION_ID);
}

// Normalize disk paths: accept / or \ ; strip accidental quotes.
function askNormalizeLogoPath(path) {
    var p = str.trim(askAsText(path));
    if (p == "") {
        return "";
    }
    if (str.startsWith(p, "\"") and str.endsWith(p, "\"") and str.length(p) >= 2) {
        // substring(s, start, length) — drop both quotes.
        p = str.substring(p, 1, str.length(p) - 2);
        p = str.trim(p);
    }
    if (str.startsWith(p, "http://") or str.startsWith(p, "https://") or
            str.startsWith(p, "data:") or str.startsWith(p, "embed:")) {
        return p;
    }
    // File.Exists accepts / on Windows; normalize \ for consistency in joins.
    p = str.replace(p, "\\", "/");
    return p;
}

function askLogoFileExists(path) {
    var p = askNormalizeLogoPath(path);
    if (p == "") {
        return false;
    }
    return io.hasFile(p);
}

// Resolve current logo against brainDir; when empty, try autoNames under the brain root.
// Returns the resolved path (may be "") — does not print; hosts may warn on miss.
function askResolveLogoPathAgainstBrain(brainDir, current, autoNames) {
    var root = askNormalizeLogoPath(brainDir);
    current = askNormalizeLogoPath(current);

    if (current != "") {
        if (str.startsWith(current, "http://") or str.startsWith(current, "https://") or
                str.startsWith(current, "data:")) {
            return current;
        }
        if (askLogoFileExists(current)) {
            return current;
        }
        if (root != "") {
            var underBrain = askNormalizeLogoPath(io.pathJoin(root, current));
            if (askLogoFileExists(underBrain)) {
                return underBrain;
            }
            // Basename like logo.png → also try root + filename only.
            var baseName = io.getFileName(current);
            if (baseName != "" and baseName != current) {
                var underBrainBase = askNormalizeLogoPath(io.pathJoin(root, baseName));
                if (askLogoFileExists(underBrainBase)) {
                    return underBrainBase;
                }
            }
        }
        return current;
    }

    if (root == "") {
        return "";
    }
    foreach (var name in autoNames) {
        var path = askNormalizeLogoPath(io.pathJoin(root, name));
        if (askLogoFileExists(path)) {
            return path;
        }
    }
    return "";
}

function askLogoAutoNamesLeft() {
    return ["logo.png", "logo.svg", "logo.jpg", "logo.jpeg", "logo.webp", "logo.gif", "logo.ico"];
}

function askLogoAutoNamesRight() {
    return [
        "logo_right.png", "logo_right.svg", "logo_right.jpg", "logo_right.jpeg",
        "logo_right.webp", "logo_right.gif", "logo_right.ico"
    ];
}

// Prefer brainDir/logo.* when ASK_LOGO is empty; resolve relative ASK_LOGO under brainDir.
// Call after the brain root is known (disk folder or embed:alias).
function askApplyLogoFromBrain(brainDir) {
    askInvalidateLogoCache();
    ASK_LOGO = askResolveLogoPathAgainstBrain(brainDir, ASK_LOGO, askLogoAutoNamesLeft());
    return ASK_LOGO;
}

// Prefer brainDir/logo_right.* when ASK_LOGO_RIGHT is empty; resolve relative path under brainDir.
// Also loads logo_right_height.txt into ASK_LOGO_RIGHT_HEIGHT when present.
function askApplyLogoRightFromBrain(brainDir) {
    askInvalidateLogoRightCache();
    ASK_LOGO_RIGHT = askResolveLogoPathAgainstBrain(
        brainDir, ASK_LOGO_RIGHT, askLogoAutoNamesRight());
    askApplyLogoRightHeightFromBrain(brainDir);
    return ASK_LOGO_RIGHT;
}

// True when a local/embed logo path is set but could not be opened.
function askLogoConfiguredPathMissing(logoPath) {
    var logo = askNormalizeLogoPath(logoPath);
    if (logo == "") {
        return false;
    }
    if (str.startsWith(logo, "http://") or str.startsWith(logo, "https://") or
            str.startsWith(logo, "data:")) {
        return false;
    }
    return not askLogoFileExists(logo);
}

function askLogoPathMissing() {
    return askLogoConfiguredPathMissing(ASK_LOGO);
}

function askLogoRightPathMissing() {
    return askLogoConfiguredPathMissing(ASK_LOGO_RIGHT);
}

// Load logo bytes/URL into a data: or remote src string. When side is "right", updates
// ASK_LOGO_RIGHT if a relative path is resolved under the session brain; else ASK_LOGO.
function askLoadLogoSrc(logoPath, side) {
    var logo = askNormalizeLogoPath(logoPath);
    var src = "";
    if (logo == "") {
        return src;
    }
    if (str.startsWith(logo, "http://") or str.startsWith(logo, "https://") or
            str.startsWith(logo, "data:")) {
        return logo;
    }
    if (askLogoFileExists(logo)) {
        var b64 = io.readFileBase64(logo);
        if (b64 != null and askAsText(b64) != "") {
            return "data:" + askLogoMime(logo) + ";base64," + askAsText(b64);
        }
        return "";
    }
    // Last chance: relative to session brainDir (if apply was skipped).
    var session = askGetSession();
    var root = "";
    if (session != null) {
        root = askNormalizeLogoPath(session.brainDir);
    }
    if (root != "") {
        var underBrain = askNormalizeLogoPath(io.pathJoin(root, logo));
        if (askLogoFileExists(underBrain)) {
            logo = underBrain;
            if (side == "right") {
                ASK_LOGO_RIGHT = logo;
            } else {
                ASK_LOGO = logo;
            }
            var b64b = io.readFileBase64(logo);
            if (b64b != null and askAsText(b64b) != "") {
                src = "data:" + askLogoMime(logo) + ";base64," + askAsText(b64b);
            }
        }
    }
    return src;
}

// Resolves ASK_LOGO once per ASK session (cached in ui.state).
function askResolveLogoSrc() {
    if (ui.state(ASK_STORE, "logoSrcCached", false, ASK_SESSION_ID) == true) {
        return askAsText(ui.state(ASK_STORE, "logoSrc", "", ASK_SESSION_ID));
    }
    var src = askLoadLogoSrc(ASK_LOGO, "left");
    ui.setState(ASK_STORE, "logoSrc", src, ASK_SESSION_ID);
    ui.setState(ASK_STORE, "logoSrcCached", true, ASK_SESSION_ID);
    return src;
}

// Resolves ASK_LOGO_RIGHT once per ASK session (cached in ui.state).
function askResolveLogoRightSrc() {
    if (ui.state(ASK_STORE, "logoRightSrcCached", false, ASK_SESSION_ID) == true) {
        return askAsText(ui.state(ASK_STORE, "logoRightSrc", "", ASK_SESSION_ID));
    }
    var src = askLoadLogoSrc(ASK_LOGO_RIGHT, "right");
    ui.setState(ASK_STORE, "logoRightSrc", src, ASK_SESSION_ID);
    ui.setState(ASK_STORE, "logoRightSrcCached", true, ASK_SESSION_ID);
    return src;
}

function askRenderExampleButtonsHtml(examples, cssClass, hidden) {
    if (examples == null or examples.length == 0) {
        return "";
    }
    var html = "<div class='examples " + cssClass + "'";
    if (hidden) {
        html = html + " hidden";
    }
    html = html + ">";
    foreach (var example in examples) {
        html = html + "<button type='button' class='example' data-ask-example='" +
            askEscapeHtml(example) + "'>" + askEscapeHtml(example) + "</button>";
    }
    html = html + "</div>";
    return html;
}

function askRenderEmptyStateHtml(session) {
    var generate = askGetAskMode() == "generate";
    var lead = "";
    var hint = "";
    var askExamples = [];
    var generateExamples = [];
    if (session != null and session.chatOnly == true) {
        lead = askT(
            "No " + askProductName() + " loaded.",
            askProductName() + " non caricato.");
        if (ASK_SHOW_EXAMPLES) {
            hint = askT(
                "Chat or generate a downloadable draft below — or try an example.",
                "Chatta o genera una bozza scaricabile qui sotto — oppure prova un esempio.");
            askExamples = [
                askT("Summarize what you can help with.", "Riassumi in cosa puoi aiutarmi."),
                askT("Explain a concept step by step.", "Spiega un concetto passo per passo."),
                askT("Draft a short checklist for me.", "Prepara una breve checklist.")
            ];
            generateExamples = [
                askT("Draft a one-page project brief.",
                    "Prepara un brief di progetto di una pagina."),
                askT("Write a meeting agenda with timed slots.",
                    "Scrivi un ordine del giorno con orari."),
                askT("Generate a short weekly status report.",
                    "Genera un breve report di stato settimanale.")
            ];
        } else {
            hint = askT(
                "Chat or generate a downloadable draft below.",
                "Chatta o genera una bozza scaricabile qui sotto.");
        }
    } else {
        lead = askT(
            "Ask " + askProductName() + " — or generate a document.",
            "Interroga " + askProductName() + " — o genera un documento.");
        if (ASK_SHOW_EXAMPLES) {
            hint = askT(
                "Answers and generated documents use the distilled notes. Pick an example or type below.",
                "Risposte e documenti generati usano le note distillate. Scegli un esempio o scrivi qui sotto.");
            askExamples = [
                askT("What are the main themes?", "Quali sono i temi principali?"),
                askT("How does authentication work?", "Come funziona l'autenticazione?"),
                askT("Where should I start reading?", "Da dove conviene iniziare a leggere?")
            ];
            generateExamples = [
                askT("Draft a project brief following the indexed examples.",
                    "Prepara un brief di progetto seguendo gli esempi indicizzati."),
                askT("Write a checklist using the same structure as the stored notes.",
                    "Scrivi una checklist con la stessa struttura delle note in archivio."),
                askT("Generate a one-page summary from the indexed templates.",
                    "Genera un riepilogo di una pagina dai modelli indicizzati.")
            ];
        } else {
            hint = askT(
                "Answers and generated documents use the distilled notes. Type a request below.",
                "Risposte e documenti generati usano le note distillate. Scrivi una richiesta qui sotto.");
        }
    }
    var html = "<div class='empty-state'>" +
        "<p class='empty-lead'>" + askEscapeHtml(lead) + "</p>" +
        "<p class='empty-hint'>" + askEscapeHtml(hint) + "</p>";
    if (ASK_SHOW_EXAMPLES) {
        html = html + askRenderExampleButtonsHtml(askExamples, "examples-ask", generate);
        html = html + askRenderExampleButtonsHtml(generateExamples, "examples-generate", not generate);
    }
    html = html + "</div>";
    return html;
}

function askCollectAvailableTags() {
    var catalog = askGetCatalog();
    var seen = {};
    var out = [];
    if (catalog == null) {
        return out;
    }
    if (catalog.topics != null) {
        foreach (var topic in catalog.topics) {
            if (topic == null) {
                continue;
            }
            var slug = str.trim(askAsText(topic.slug));
            if (slug == "") {
                slug = str.trim(askAsText(topic.name));
            }
            if (slug != "" and seen[slug] == null) {
                seen[slug] = true;
                out.append(slug);
            }
        }
    }
    if (catalog.notes != null) {
        foreach (var note in catalog.notes) {
            if (note == null or note.tags == null) {
                continue;
            }
            foreach (var tag in note.tags) {
                var t = str.trim(askAsText(tag));
                if (t != "" and seen[t] == null) {
                    seen[t] = true;
                    out.append(t);
                }
            }
            var cat = str.trim(askAsText(note.category));
            if (cat != "" and seen[cat] == null) {
                seen[cat] = true;
                out.append(cat);
            }
        }
    }
    return out;
}

function askTagSelected(tag, selected) {
    var want = str.lower(str.trim(askAsText(tag)));
    if (selected == null) {
        return false;
    }
    foreach (var s in selected) {
        if (str.lower(str.trim(askAsText(s))) == want) {
            return true;
        }
    }
    return false;
}

function askTagPickerSummaryLabel(selected) {
    var n = 0;
    if (selected != null) {
        n = selected.length;
    }
    if (n == 0) {
        return "<span class='muted'>" +
            askEscapeHtml(askT("Filter by tag", "Filtra per tag")) +
            "</span>";
    }
    var shown = [];
    var i = 0;
    while (i < selected.length and shown.length < 2) {
        var t = str.trim(askAsText(selected[i]));
        if (t != "") {
            shown.append(t);
        }
        i = i + 1;
    }
    var preview = str.join(shown, ", ");
    var more = n - shown.length;
    var extra = "";
    if (more > 0) {
        extra = " +" + string(more);
    }
    return "<strong>" + askEscapeHtml(askT("Tags", "Tag")) +
        " (" + string(n) + ")</strong> · " +
        askEscapeHtml(preview) + askEscapeHtml(extra);
}

function askRenderTagPickerHtml(available, selected) {
    if (available == null or available.length == 0) {
        return "";
    }
    var html = "<details class='tag-picker'>" +
        "<summary>" +
        "<span class='tag-picker-label' data-ask-tag-label='1'>" +
        askTagPickerSummaryLabel(selected) +
        "</span>" +
        "<span class='tag-picker-chevron' aria-hidden='true'>▾</span>" +
        "</summary>" +
        "<div class='tag-picker-panel' role='group' aria-label='" +
        askEscapeHtml(askT("Filter by tag", "Filtra per tag")) + "'>";
    foreach (var tag in available) {
        var checked = "";
        if (askTagSelected(tag, selected)) {
            checked = " checked";
        }
        html = html + "<label><input type='checkbox' name='tags' value='" +
            askEscapeHtml(tag) + "'" + checked + "> <span>" +
            askEscapeHtml(tag) + "</span></label>";
    }
    html = html + "</div></details>";
    return html;
}

// Flash + thread + composer — returned as componentFragment("ask-panel", ...).
function askRenderPanelHtml() {
    var history = askGetHistory();
    var flashError = askGetFlashError();
    var session = askGetSession();
    var html = "";

    if (flashError != "") {
        html = html + "<section class='panel'><p class='error'>" +
            askEscapeHtml(flashError) + "</p></section>";
    }

    html = html + "<section class='thread' id='thread'>";
    if (history.length == 0) {
        html = html + askRenderEmptyStateHtml(session);
    } else {
        var i = 0;
        foreach (var turn in history) {
            html = html + askRenderTurnHtml(turn, i);
            i = i + 1;
        }
    }
    html = html + "</section>";

    var generate = askGetAskMode() == "generate";
    var placeholderAsk = askT(
        "Ask about the distilled notes…",
        "Chiedi sulle note distillate…");
    var placeholderGen = askT(
        "Describe the document to generate (brief, summary, checklist)…",
        "Descrivi il documento da generare (brief, riepilogo, checklist)…");
    if (session.chatOnly == true) {
        placeholderAsk = askT(
            "Ask the model anything…",
            "Chiedi qualsiasi cosa al modello…");
        placeholderGen = askT(
            "Describe the document to generate…",
            "Descrivi il documento da generare…");
    }
    var placeholder = placeholderAsk;
    if (generate) {
        placeholder = placeholderGen;
    }
    var askBtn = askT("Ask", "Chiedi");
    var genBtn = askT("Generate", "Genera");
    var submitLabel = askBtn;
    if (generate) {
        submitLabel = genBtn;
    }

    var toolsEnabled = askGetToolsEnabled();
    var toolsChecked = "";
    if (toolsEnabled) {
        toolsChecked = " checked";
    }
    var forceChecked = "";
    if (askGetForceAnswer()) {
        forceChecked = " checked";
    }
    var statusHint = askT("Ready", "Pronto");
    if (toolsEnabled and session.chatOnly != true) {
        statusHint = askT(
            "Note search on — may take several LLM rounds.",
            "Ricerca note attiva — puo' richiedere piu' round LLM.");
    }

    var requestLabel = askT("New question", "Nuova domanda");
    if (generate) {
        requestLabel = askT("New document request", "Nuova richiesta documento");
    }
    html = html + "<section class='composer'>" +
        "<form method='post' action='/ask' id='ask-form' data-btn-ask='" +
        askEscapeHtml(askBtn) + "' data-btn-generate='" + askEscapeHtml(genBtn) + "'>" +
        askHiddenConvField() +
        askRenderModePillsHtml() +
        "<label for='question'>" + askEscapeHtml(requestLabel) + "</label>" +
        "<textarea id='question' name='question' required autofocus placeholder='" +
        askEscapeHtml(placeholder) +
        "' data-ph-ask='" + askEscapeHtml(placeholderAsk) +
        "' data-ph-generate='" + askEscapeHtml(placeholderGen) +
        "'></textarea>";

    if (session.chatOnly != true) {
        html = html + askRenderTagPickerHtml(askCollectAvailableTags(), askGetTagFilter());
    }

    html = html + "<div class='composer-bar'>";

    if (session.chatOnly != true) {
        html = html + "<label class='tool-toggle' for='useTools' title='" +
            askEscapeHtml(askT(
                "Off: answer from retrieved excerpts only (faster). On: allow read_file / grep / list_directory.",
                "Off: risponde solo dagli estratti recuperati (piu' veloce). On: consente read_file / grep / list_directory.")) +
            "'>" +
            "<input type='checkbox' id='useTools' name='useTools' value='1'" + toolsChecked + ">" +
            "<span class='switch' aria-hidden='true'></span>" +
            "<span>" + askEscapeHtml(askT("Search notes", "Ricerca note")) + "</span></label>";
        html = html + "<label class='tool-toggle' for='forceAnswer' title='" +
            askEscapeHtml(askT(
                "Answer even when retrieval scores are below the minimum threshold.",
                "Rispondi anche se i punteggi di recupero sono sotto soglia.")) +
            "'>" +
            "<input type='checkbox' id='forceAnswer' name='forceAnswer' value='1'" + forceChecked + ">" +
            "<span class='switch' aria-hidden='true'></span>" +
            "<span>" + askEscapeHtml(askT("Force answer", "Forza risposta")) + "</span></label>";
    }

    var busyClass = "busy";
    if (not (toolsEnabled and session.chatOnly != true)) {
        busyClass = "busy ready";
    }
    // Ask button first in DOM (HttpServer AJAX disables the first submit control).
    // CSS order keeps Clear visually to the left. Clear uses form= (no nested forms).
    html = html + "<p class='" + busyClass + "'>" + askEscapeHtml(statusHint) + "</p>" +
        "<div class='actions'>" +
        "<button type='submit'>" + askEscapeHtml(submitLabel) + "</button>" +
        "<button type='submit' class='ghost' form='ask-clear-form'>" +
        askEscapeHtml(askT("Clear", "Cancella")) + "</button>" +
        "</div></div></form>" +
        "<form method='post' action='/clear' class='clear-form' id='ask-clear-form'>" +
        askHiddenConvField() +
        "</form></section>";

    return html;
}

function askPanelFragment() {
    return componentFragment("ask-panel", askRenderPanelHtml());
}

// Scroll + SSE live progress. Scripts inside fragment bodies do not run via innerHTML.
// #ask-live-dock stays in #ask-live-home (outside #ask-panel) so panel fragment
// replace cannot destroy it. While visible it is position:fixed just above the
// sticky composer — mounting inside the composer hid rounds on tall phone layouts.
function askPageClientScript() {
    return "<script>(function(){" +
        "var es=null;" +
        "var liveClosing=false;" +
        "var askConvId='" + askEscapeHtml(askConvScope()) + "';" +
        "var askLiveChannel='" + askEscapeHtml(askLiveChannel()) + "';" +
        "var liveLabel='" + askEscapeHtml(askT("Live", "Live")) + "';" +
        "var askStartedAt=null;" +
        "var roundStartedAt=null;" +
        "var lastRound=null;" +
        "var lastMsg='';" +
        "var timerId=null;" +
        "var dockPosBound=false;" +
        "function formatElapsed(ms){" +
        "var s=Math.max(0,Math.floor(ms/1000));" +
        "var m=Math.floor(s/60);" +
        "s=s%60;" +
        "return m+':'+(s<10?'0':'')+s;" +
        "}" +
        "function scrollLatest(){" +
        "var status=document.getElementById('ask-live-status');" +
        "if(status){" +
        "status.scrollIntoView({block:'nearest',behavior:'smooth'});" +
        "return;" +
        "}" +
        "var thread=document.getElementById('thread');" +
        "if(!thread){return;}" +
        "var turns=thread.querySelectorAll('.turn');" +
        "if(turns.length===0){return;}" +
        "var last=turns[turns.length-1];" +
        "if(last&&last.id){location.hash=last.id;}" +
        "last.scrollIntoView({block:'nearest',behavior:'smooth'});" +
        "}" +
        "function progressMessage(p){" +
        "if(!p){return '';}" +
        "if(p.phase==='tool_calls'&&p.tools&&p.tools.length){" +
        "try{return 'Tools: '+(Array.isArray(p.tools)?p.tools.join(', '):String(p.tools));}" +
        "catch(err){return 'Tools…';}" +
        "}" +
        "if(p.phase==='tool_done'&&p.tool){" +
        "return (p.ok===false?'Failed: ':'Done: ')+p.tool;" +
        "}" +
        "return p.message||'';" +
        "}" +
        "function roundLabel(){" +
        "if(lastRound==null){return '';}" +
        "var bit='Round '+lastRound;" +
        "if(roundStartedAt){bit+=' '+formatElapsed(Date.now()-roundStartedAt);}" +
        "return bit;" +
        "}" +
        "function paintTimers(){" +
        "var total=askStartedAt?formatElapsed(Date.now()-askStartedAt):'0:00';" +
        "var roundBit=roundLabel();" +
        "var bodyText=(roundBit?(roundBit+' · '):'')+(lastMsg||'');" +
        "var dock=document.getElementById('ask-live-dock');" +
        "if(dock){" +
        "var t=dock.querySelector('.live-timer');" +
        "if(t){t.textContent=total;}" +
        "var body=dock.querySelector('.live-dock-body');" +
        "if(body){body.textContent=bodyText;}" +
        "}" +
        "var status=document.getElementById('ask-live-status');" +
        "if(status){status.textContent=total+(bodyText?' · '+bodyText:'');}" +
        "}" +
        "function startLiveTimer(){" +
        "if(!askStartedAt){askStartedAt=Date.now();}" +
        "if(!roundStartedAt){roundStartedAt=askStartedAt;}" +
        "if(timerId){return;}" +
        "paintTimers();" +
        "timerId=setInterval(paintTimers,1000);" +
        "}" +
        "function stopLiveTimer(){" +
        "if(timerId){clearInterval(timerId);timerId=null;}" +
        "askStartedAt=null;" +
        "roundStartedAt=null;" +
        "lastRound=null;" +
        "lastMsg='';" +
        "}" +
        "function ensureLiveDock(){" +
        "var dock=document.getElementById('ask-live-dock');" +
        "if(dock){return dock;}" +
        "var home=document.getElementById('ask-live-home');" +
        "if(!home){return null;}" +
        "dock=document.createElement('div');" +
        "dock.id='ask-live-dock';" +
        "dock.className='live-dock';" +
        "dock.hidden=true;" +
        "dock.setAttribute('role','status');" +
        "dock.setAttribute('aria-live','polite');" +
        "dock.innerHTML='<span class=\"live-round\"></span><span class=\"live-timer\">0:00</span><span class=\"live-dock-body\"></span>';" +
        "var label=dock.querySelector('.live-round');" +
        "if(label){label.textContent=liveLabel;}" +
        "home.appendChild(dock);" +
        "return dock;" +
        "}" +
        "function syncLiveDockPosition(){" +
        "var dock=document.getElementById('ask-live-dock');" +
        "if(!dock||dock.hidden){return;}" +
        "var home=document.getElementById('ask-live-home');" +
        "if(home&&dock.parentNode!==home){home.appendChild(dock);}" +
        "dock.classList.add('is-floating');" +
        "var gap=8;" +
        "var composer=document.querySelector('#ask-panel .composer');" +
        "var bottom=gap;" +
        "if(composer){" +
        "var rect=composer.getBoundingClientRect();" +
        "bottom=Math.max(gap,Math.round(window.innerHeight-rect.top)+gap);" +
        "}" +
        "dock.style.bottom=bottom+'px';" +
        "}" +
        "function bindLiveDockPosition(){" +
        "if(dockPosBound){return;}" +
        "dockPosBound=true;" +
        "var sync=function(){syncLiveDockPosition();};" +
        "window.addEventListener('resize',sync);" +
        "window.addEventListener('scroll',sync,{passive:true});" +
        "try{" +
        "if(window.visualViewport){" +
        "window.visualViewport.addEventListener('resize',sync);" +
        "window.visualViewport.addEventListener('scroll',sync);" +
        "}" +
        "}catch(vvErr){}" +
        "}" +
        "function placeLiveDock(visible){" +
        "var dock=ensureLiveDock();" +
        "var home=document.getElementById('ask-live-home');" +
        "if(!dock){return null;}" +
        "if(home&&dock.parentNode!==home){home.appendChild(dock);}" +
        "if(!visible){" +
        "dock.classList.remove('is-floating');" +
        "dock.style.bottom='';" +
        "return dock;" +
        "}" +
        "bindLiveDockPosition();" +
        "syncLiveDockPosition();" +
        "return dock;" +
        "}" +
        "function showLive(text,visible){" +
        "var dock=placeLiveDock(visible);" +
        "if(visible){" +
        "if(text){lastMsg=text;}" +
        "startLiveTimer();" +
        "}else{" +
        "stopLiveTimer();" +
        "}" +
        "if(dock){" +
        "dock.hidden=!visible;" +
        "if(visible){" +
        "paintTimers();" +
        "syncLiveDockPosition();" +
        "}else{" +
        "dock.classList.remove('is-floating');" +
        "dock.style.bottom='';" +
        "var body=dock.querySelector('.live-dock-body');" +
        "if(body){body.textContent='';}" +
        "var t=dock.querySelector('.live-timer');" +
        "if(t){t.textContent='0:00';}" +
        "}" +
        "}" +
        "var status=document.getElementById('ask-live-status');" +
        "if(status){" +
        "if(!visible){status.textContent='';}" +
        "else{paintTimers();}" +
        "}" +
        "}" +
        "function onProgressPayload(payload){" +
        "if(!payload){return;}" +
        "var done=payload.phase==='done';" +
        "var roundChanged=false;" +
        "if(payload.phase==='round_start'||(payload.round!=null&&payload.round!==lastRound)){" +
        "if(payload.round!=null){" +
        "lastRound=payload.round;" +
        "roundStartedAt=Date.now();" +
        "roundChanged=true;" +
        "}" +
        "}" +
        "var msg=progressMessage(payload);" +
        // Still refresh the dock on round-only events (empty message).
        "if(!msg&&!done&&!roundChanged){return;}" +
        "if(msg){lastMsg=msg;}" +
        "showLive(lastMsg||roundLabel()||'…',!done);" +
        "if(done){setTimeout(function(){showLive('',false);},1200);}" +
        "}" +
        "function disconnectLive(){" +
        "liveClosing=true;" +
        "if(es){try{es.close();}catch(e){} es=null;}" +
        "stopLiveTimer();" +
        "}" +
        "function connectLive(){" +
        "liveClosing=false;" +
        "if(es){try{es.close();}catch(e){}}" +
        "es=new EventSource('/ask/live?channel='+encodeURIComponent(askLiveChannel));" +
        "es.onmessage=function(evt){" +
        "try{" +
        "var data=JSON.parse(evt.data);" +
        "var payload=data&&data.payload?data.payload:data;" +
        "if(data&&data.event&&data.event!=='ask-progress'&&data.type==='componentLiveEvent'){" +
        "/* keep going — payload still useful */" +
        "}" +
        "onProgressPayload(payload);" +
        "}catch(err){}" +
        "};" +
        "es.onerror=function(){" +
        // Avoid reconnect storms while navigating away (lang switch / unload).
        "if(liveClosing){try{es&&es.close();}catch(e){} es=null;}" +
        "};" +
        "}" +
        "function fillExample(text){" +
        "var ta=document.getElementById('question');" +
        "if(!ta||!text){return;}" +
        "ta.value=text;" +
        "ta.focus();" +
        "try{ta.setSelectionRange(text.length,text.length);}catch(err){}" +
        "}" +
        "function navigateLang(href){" +
        "if(!href){return;}" +
        // Close SSE before full navigation — an open event-stream can stall
        // the next document request on HttpListener (browser appears to hang).
        "disconnectLive();" +
        "setTimeout(function(){window.location.assign(href);},50);" +
        "}" +
        "function convUrl(extra){" +
        "var q='c='+encodeURIComponent(askConvId||'');" +
        "if(extra){q+='&'+extra;}" +
        "return '/?'+q;" +
        "}" +
        "function syncAskModeUi(){" +
        "var form=document.getElementById('ask-form');" +
        "if(!form){return;}" +
        "var gen=form.querySelector('input[name=askMode][value=generate]');" +
        "var isGen=!!(gen&&gen.checked);" +
        "var ta=document.getElementById('question');" +
        "if(ta){" +
        "var ph=isGen?(ta.getAttribute('data-ph-generate')||''):(ta.getAttribute('data-ph-ask')||'');" +
        "if(ph){ta.placeholder=ph;}" +
        "}" +
        "var btn=form.querySelector('.actions button[type=submit]');" +
        "if(btn){" +
        "var lab=isGen?(form.getAttribute('data-btn-generate')||''):(form.getAttribute('data-btn-ask')||'');" +
        "if(lab){btn.textContent=lab;}" +
        "}" +
        "var askEx=document.querySelector('.examples-ask');" +
        "var genEx=document.querySelector('.examples-generate');" +
        "if(askEx){askEx.hidden=isGen;}" +
        "if(genEx){genEx.hidden=!isGen;}" +
        "}" +
        "function bind(){" +
        "var panel=document.getElementById('ask-panel');" +
        "if(panel&&panel.dataset.askScrollBound!=='1'){" +
        "panel.dataset.askScrollBound='1';" +
        "new MutationObserver(function(){" +
        // Dock lives outside #ask-panel; keep it pinned above the new composer.
        "var dock=document.getElementById('ask-live-dock');" +
        "if(dock&&!dock.hidden){" +
        "syncLiveDockPosition();" +
        "paintTimers();" +
        "}" +
        "scrollLatest();" +
        "}).observe(panel,{childList:true});" +
        "}" +
        "if(document.documentElement.dataset.askNavBound!=='1'){" +
        "document.documentElement.dataset.askNavBound='1';" +
        "document.addEventListener('click',function(e){" +
        "var t=e.target;" +
        "if(!t||!t.closest){return;}" +
        "var lang=t.closest('a[data-ask-lang]');" +
        "if(lang){" +
        "e.preventDefault();" +
        "navigateLang(lang.getAttribute('href')||'');" +
        "return;" +
        "}" +
        "var theme=t.closest('a[data-ask-theme]');" +
        "if(theme){" +
        "e.preventDefault();" +
        "navigateLang(theme.getAttribute('href')||'');" +
        "return;" +
        "}" +
        "var btn=t.closest('[data-ask-example]');" +
        "if(btn){" +
        "e.preventDefault();" +
        "fillExample(btn.getAttribute('data-ask-example')||'');" +
        "return;" +
        "}" +
        // Close tag combo when clicking outside (keeps sticky composer compact).
        "var picker=document.querySelector('#ask-panel details.tag-picker[open]');" +
        "if(picker&&!picker.contains(t)){picker.open=false;}" +
        "},true);" +
        "document.addEventListener('change',function(e){" +
        "var t=e.target;" +
        "if(t&&t.name==='askMode'){syncAskModeUi();return;}" +
        "if(!t||t.name!=='tags'){return;}" +
        "var picker=t.closest('details.tag-picker');" +
        "if(!picker){return;}" +
        "var label=picker.querySelector('[data-ask-tag-label]');" +
        "if(!label){return;}" +
        "function esc(s){" +
        "return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;')" +
        ".replace(/>/g,'&gt;').replace(/\"/g,'&quot;');" +
        "}" +
        "var boxes=picker.querySelectorAll(\"input[name='tags']\");" +
        "var names=[];" +
        "for(var i=0;i<boxes.length;i++){" +
        "if(boxes[i].checked){names.push(boxes[i].value||'');}" +
        "}" +
        "var isIt=(document.documentElement.lang||'').toLowerCase().indexOf('it')===0;" +
        "if(names.length===0){" +
        "label.innerHTML=\"<span class='muted'>\"+(isIt?'Filtra per tag':'Filter by tag')+\"</span>\";" +
        "return;" +
        "}" +
        "var shown=names.slice(0,2).map(esc);" +
        "var extra=names.length>shown.length?' +'+(names.length-shown.length):'';" +
        "var title=isIt?'Tag':'Tags';" +
        "label.innerHTML='<strong>'+title+' ('+names.length+')</strong> · '+" +
        "shown.join(', ')+extra;" +
        "});" +
        "window.addEventListener('pagehide',disconnectLive);" +
        "window.addEventListener('beforeunload',disconnectLive);" +
        "}" +
        "document.addEventListener('submit',function(e){" +
        "var form=e.target;" +
        "if(!form||!form.action){return;}" +
        "if(String(form.action).indexOf('/ask')<0){return;}" +
        "if(String(form.action).indexOf('/ask/live')>=0){return;}" +
        "var openPicker=document.querySelector('#ask-panel details.tag-picker[open]');" +
        "if(openPicker){openPicker.open=false;}" +
        "lastRound=null;" +
        "roundStartedAt=null;" +
        "askStartedAt=null;" +
        "showLive('Starting…',true);" +
        "},true);" +
        "connectLive();" +
        "scrollLatest();" +
        "syncAskModeUi();" +
        "}" +
        "if(document.readyState==='loading'){" +
        "document.addEventListener('DOMContentLoaded',bind);" +
        "}else{bind();}" +
        "})();</script>";
}

function askRenderPage() {
    var lang = askGetLang();
    var session = askGetSession();
    var title = askAsText(session.title);
    if (title == "") {
        title = askAsText(ASK_PAGE_TITLE);
    }
    if (title == "") {
        title = askProductName();
    }
    var poweredBy = askAsText(ASK_POWERED_BY);
    var poweredByUrl = askAsText(ASK_POWERED_BY_URL);
    var logoSrc = askResolveLogoSrc();
    var logoRightSrc = askResolveLogoRightSrc();
    var theme = askGetTheme();
    // One toggle each: label = current; href switches to the other.
    var nextLang = "it";
    var langLabel = "EN";
    if (lang == "it") {
        nextLang = "en";
        langLabel = "IT";
    }
    var nextTheme = "dark";
    var themeLabel = askT("Light", "Chiaro");
    if (theme == "dark") {
        nextTheme = "light";
        themeLabel = askT("Dark", "Scuro");
    }

    var mainClass = "";
    if (logoSrc != "" or logoRightSrc != "") {
        mainClass = " class='has-logo'";
    }
    var html = "<!DOCTYPE html><html lang='" + lang + "' data-theme='" + theme + "'><head>" +
        "<meta charset='utf-8'>" +
        "<meta name='viewport' content='width=device-width,initial-scale=1'>" +
        "<title>" + askEscapeHtml(title) + "</title>" +
        askPageStyles() +
        "</head><body><main" + mainClass + ">";

    var brandClass = "brand";
    if (logoSrc != "") {
        brandClass = "brand has-left-logo";
    }
    html = html + "<header class='sticky-header'><div class='sticky-header-inner'>" +
        "<div class='" + brandClass + "'>";
    if (logoSrc != "") {
        // Same grid row as title + right logo → shared vertical centering.
        html = html + "<img class='logo' src='" + askEscapeHtml(logoSrc) +
            "' alt=''>";
    }
    html = html + "<div class='brand-title-row'>" +
        "<h1>" + askEscapeHtml(title) + "</h1>";
    if (logoRightSrc != "") {
        html = html + "<img class='logo-right' src='" + askEscapeHtml(logoRightSrc) +
            "' alt=''>";
    }
    html = html + "</div>";
    if (poweredBy != "") {
        if (poweredByUrl != "") {
            html = html + "<p class='powered-by'><a href='" + askEscapeHtml(poweredByUrl) +
                "' target='_blank' rel='noopener noreferrer'>" +
                askEscapeHtml(poweredBy) + "</a></p>";
        } else {
            html = html + "<p class='powered-by'>" + askEscapeHtml(poweredBy) + "</p>";
        }
    }
    html = html + "</div>" +
        "<div class='header-actions'>" +
        "<nav class='lang' aria-label='" +
        askEscapeHtml(askT("Language and theme", "Lingua e tema")) + "'>" +
        "<a class='active' href='/?" + askEscapeHtml(askConvQuery("lang=" + nextLang)) +
        "' hreflang='" + nextLang + "' data-ask-lang='" + lang + "' title='" +
        askEscapeHtml(askT("Switch language", "Cambia lingua")) + "'>" +
        langLabel + "</a>" +
        "<a class='active' href='/?" + askEscapeHtml(askConvQuery("theme=" + nextTheme)) +
        "' data-ask-theme='" + theme + "' title='" +
        askEscapeHtml(askT("Switch theme", "Cambia tema")) + "'>" +
        askEscapeHtml(themeLabel) + "</a>" +
        "</nav>" +
        "<a class='new-conv' href='/?" + askEscapeHtml("c=" + askMintConvId()) + "'>" +
        askEscapeHtml(askT("New conversation", "Nuova conversazione")) + "</a>";
    if (ASK_CURRENT_IS_ADMIN) {
        html = html +
            "<a class='new-conv' href='/admin/users'>" +
            askEscapeHtml(askT("Admin", "Admin")) + "</a>" +
            "<a class='new-conv' href='/admin/upload'>" +
            askEscapeHtml(askT("Upload", "Upload")) + "</a>";
    }
    if (ASK_AUTH_ENABLED) {
        html = html +
            "<a class='new-conv' href='/logout'>" +
            askEscapeHtml(askT("Log out", "Esci")) + "</a>";
    }
    html = html + "</div></div></header>";

    var subtitle = askAsText(session.subtitle);
    html = html + "<div class='meta-bar'>" +
        "<span>" + askEscapeHtml(askT("Notes", "Note")) + " <strong>" +
        askEscapeHtml(askMetaCount(session.noteCount)) + "</strong></span>" +
        "<span class='dot' aria-hidden='true'>·</span>" +
        "<span>" + askEscapeHtml(askT("Themes", "Temi")) + " <strong>" +
        askEscapeHtml(askMetaCount(session.topicCount)) + "</strong></span>" +
        "<span class='dot' aria-hidden='true'>·</span>" +
        "<span>" + askEscapeHtml(askT("from", "da")) +
        " <strong>" + askEscapeHtml(askAsText(session.sourceFolder)) + "</strong></span>" +
        "<span class='dot' aria-hidden='true'>·</span>" +
        "<span>" + askEscapeHtml(askT("Retrieval", "Recupero")) + " <strong>" +
        askEscapeHtml(askAsText(session.retrieval)) + "</strong></span>" +
        "<span class='dot' aria-hidden='true'>·</span>" +
        "<span>LLM <strong>" + askEscapeHtml(askAsText(session.llm)) + "</strong></span>";
    if (subtitle != "") {
        html = html + "<div class='meta-sub'>" + askEscapeHtml(subtitle) + "</div>";
    }
    html = html + "</div>";

    // Shelf outside #ask-panel so fragment replace cannot destroy live progress.
    // While live, client JS floats the dock fixed above the sticky composer.
    html = html + "<div id='ask-live-home'>" +
        "<div id='ask-live-dock' class='live-dock' hidden role='status' aria-live='polite'>" +
        "<span class='live-round'>" + askEscapeHtml(askT("Live", "Live")) +
        "</span><span class='live-timer'>0:00</span>" +
        "<span class='live-dock-body'></span></div></div>";

    html = html + "<div id='ask-panel'>" + askRenderPanelHtml() + "</div>";
    html = html + askPageClientScript();
    html = html + "</main></body></html>";
    return html;
}

@PAGE("/")
function askUiHome(queryParams, response, cookies, req) {
    var id = askBeginRequest(queryParams, null, cookies, response, req);
    var hasC = askNormalizeConvId(queryParams?["c"] ?? "") != "";
    if (not hasC) {
        var redirect = "/?c=" + id;
        if (queryParams?["lang"] != null) {
            redirect = redirect + "&lang=" + askAsText(queryParams["lang"]);
        }
        if (queryParams?["theme"] != null) {
            redirect = redirect + "&theme=" + askAsText(queryParams["theme"]);
        }
        return RedirectTo(redirect);
    }
    if (queryParams?["lang"] != null) {
        askSetLang(queryParams["lang"]);
    }
    if (queryParams?["theme"] != null) {
        askSetTheme(queryParams["theme"]);
        askSetThemeCookie(response, askGetTheme());
    }
    // Bookmark / no-JS fallback for clear (AJAX path uses POST /clear).
    if (queryParams?["clear"] != null) {
        askClearHistory();
        askAudit("clear", req, {});
        return RedirectTo("/?c=" + id);
    }
    return askRenderPage();
}

function askConsumePendingStop() {
    // Web UI does not expose stop (multi-user safe). Hosts may still poll this
    // for a future console/admin signal; nothing in ASK sets pendingStop today.
    var pending = ui.state(ASK_STORE, "pendingStop", false, ASK_SESSION_ID);
    if (pending == true) {
        ui.setState(ASK_STORE, "pendingStop", false, ASK_SESSION_ID);
        return true;
    }
    return false;
}

function askReplaceLastTurn(turn) {
    // Rebuild + setState so the completed answer is what the panel fragment shows.
    var history = askGetHistory();
    if (history.length == 0) {
        askAppendTurn(turn);
        return;
    }
    var next = [];
    var i = 0;
    var last = history.length - 1;
    while (i < last) {
        next.append(history[i]);
        i = i + 1;
    }
    next.append(turn);
    askSetHistory(next);
}

@ACTION("/ask")
function askUiSubmit(body, response, cookies, req) {
    askBeginRequest(null, body, cookies, response, req);
    var liveChannel = askLiveChannel();
    var question = str.trim(askAsText(body.question));
    askSetFlashError("");
    askApplyToolsFromBody(body);
    askApplyTagFilterFromBody(body);
    askApplyForceAnswerFromBody(body);
    askApplyAskModeFromBody(body);

    if (question == "") {
        if (askGetAskMode() == "generate") {
            askSetFlashError(askT("Describe the document to generate.", "Descrivi il documento da generare."));
        } else {
            askSetFlashError(askT("Enter a question.", "Inserisci una domanda."));
        }
        return askPanelFragment();
    }

    // Visible immediately if the user refreshes while the LLM is still running.
    askAppendTurn({
        "question": question,
        "answer": "",
        "sources": [],
        "error": "",
        "pending": true,
        "generated": askGetAskMode() == "generate"
    });

    // Per-user+conversation channel (AsyncLocal) so concurrent asks stay isolated.
    onAgentProgress(liveChannel);
    try {
        var startMsg = askT("Starting ask…", "Avvio domanda…");
        if (askGetAskMode() == "generate") {
            startMsg = askT("Starting document…", "Avvio documento…");
            if (askGetToolsEnabled()) {
                startMsg = askT("Starting document (tools on)…", "Avvio documento (tool attivi)…");
            }
        } else if (askGetToolsEnabled()) {
            startMsg = askT("Starting ask (tools on)…", "Avvio domanda (tool attivi)…");
        }
        componentLiveEmit(liveChannel, {
            "phase": "round_start",
            "round": 0,
            "message": startMsg
        }, "ask-progress");
        var turn = runAskTurn(question);
        if (turn == null) {
            askReplaceLastTurn({
                "question": question,
                "answer": "",
                "sources": [],
                "error": askT("Ask failed.", "Domanda fallita."),
                "pending": false
            });
            return askPanelFragment();
        }
        turn.pending = false;
        askReplaceLastTurn(turn);
        var srcCount = 0;
        if (turn.sources != null) {
            srcCount = turn.sources.length;
        }
        askAudit("ask", req, {
            "qLen": str.length(question),
            "sources": srcCount,
            "weak": turn.weakRetrieval == true,
            "tags": askGetTagFilter(),
            "mode": askGetAskMode(),
            "generated": turn.generated == true
        });
    } catch (e) {
        askReplaceLastTurn({
            "question": question,
            "answer": "",
            "sources": [],
            "error": askT("Ask failed: ", "Domanda fallita: ") + askAsText(e),
            "pending": false
        });
    } finally {
        clearAgentProgress();
    }
    return askPanelFragment();
}

@ACTION("/clear")
function askUiClear(body, response, cookies, req) {
    askBeginRequest(null, body, cookies, response, req);
    askClearHistory();
    askAudit("clear", req, {});
    return askPanelFragment();
}

@ACTION("/feedback")
function askUiFeedback(body, response, cookies, req) {
    askBeginRequest(null, body, cookies, response, req);
    var vote = "";
    var turnIndex = -1;
    if (body != null) {
        vote = str.lower(str.trim(askAsText(body.vote)));
        turnIndex = toIntOrNull(askAsText(body.turnIndex));
        if (turnIndex == null) {
            turnIndex = -1;
        }
    }
    if (vote != "up" and vote != "down") {
        return askPanelFragment();
    }
    var history = askGetHistory();
    var qSnippet = "";
    if (turnIndex >= 0 and turnIndex < history.length) {
        qSnippet = str.trim(askAsText(history[turnIndex].question));
        if (str.length(qSnippet) > 120) {
            qSnippet = str.substring(qSnippet, 0, 120);
        }
    }
    askAudit("feedback", req, {
        "vote": vote,
        "turnIndex": turnIndex,
        "qSnippet": qSnippet
    });
    askAppendJsonl(ASK_FEEDBACK_PATH, {
        "ts": string(now()),
        "sub": ASK_CURRENT_SUB,
        "vote": vote,
        "turnIndex": turnIndex,
        "qSnippet": qSnippet,
        "conv": askConvScope()
    });
    return askPanelFragment();
}

@LIVE("/ask/live")
function askUiLive() {
    return { "sse": true };
}

@GET("/generate/download")
function askUiDownloadGenerated(req, res, queryParams, cookies) {
    askBeginRequest(queryParams, null, cookies, res, req);
    var fmt = "";
    var turnIndex = -1;
    if (queryParams != null) {
        fmt = askAsText(queryParams["fmt"]);
        turnIndex = toIntOrNull(askAsText(queryParams["turn"]));
        if (turnIndex == null) {
            turnIndex = -1;
        }
    }
    var history = askGetHistory();
    var turn = null;
    if (turnIndex >= 0 and turnIndex < history.length) {
        turn = history[turnIndex];
    }
    var built = askBuildGeneratedDownload(turn, fmt);
    if (not built.ok) {
        return res.status(404).text(askAsText(built.error));
    }
    res.header("Content-Disposition", "attachment; filename=\"" +
        askAsText(built.filename) + "\"");
    res.setContentType(askAsText(built.contentType));
    askAudit("generate-download", req, {
        "turn": turnIndex,
        "fmt": askNormalizeDownloadFormat(fmt)
    });
    return res.send(built.body);
}

@GET("/health")
function askUiHealth(req, res, queryParams) {
    var ready = true;
    if (queryParams != null and queryParams["ready"] != null) {
        // askGetCatalog peeks — never ui.state(..., null) which would persist a
        // null catalog after a shared-store miss.
        var catalog = askGetCatalog();
        ready = catalog != null;
    }
    return res.json({
        "ok": true,
        "ready": ready,
        "service": "secondbrain-ask",
        "auth": ASK_AUTH_ENABLED,
        "product": askProductName(),
        "version": ASK_SERVICE_VERSION
    });
}

function askRenderAdminUsersPage(flash) {
    var users = askListUsers();
    var msg = str.trim(askAsText(flash));
    var flashHtml = "";
    if (msg != "") {
        flashHtml = "<p class='flash error'>" + askEscapeHtml(msg) + "</p>";
    }
    var html = "<!DOCTYPE html><html lang='" + askGetLang() + "' data-theme='" +
        askGetTheme() + "'><head>" +
        "<meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'>" +
        "<title>" + askEscapeHtml(askT("Users", "Utenti")) + "</title>" +
        askPageStyles() + "</head><body><main class='admin-wrap'>" +
        "<p><a href='/'>" + askEscapeHtml(askT("← Back to ASK", "← Torna ad ASK")) +
        "</a> · <a href='/admin/upload'>" + askEscapeHtml(askT("Upload", "Upload")) +
        "</a></p>" +
        "<h1>" + askEscapeHtml(askT("User admin", "Amministrazione utenti")) + "</h1>" +
        flashHtml +
        "<p class='hint'>" + askEscapeHtml(askT(
            "Bootstrap admin is configured via env and is not listed here.",
            "L'admin di bootstrap e' configurato via env e non compare qui.")) + "</p>" +
        "<table class='admin-table'><thead><tr>" +
        "<th>" + askEscapeHtml(askT("User", "Utente")) + "</th>" +
        "<th>" + askEscapeHtml(askT("Role", "Ruolo")) + "</th>" +
        "<th>" + askEscapeHtml(askT("Status", "Stato")) + "</th>" +
        "<th>" + askEscapeHtml(askT("Actions", "Azioni")) + "</th>" +
        "</tr></thead><tbody>";
    if (users.length == 0) {
        html = html + "<tr><td colspan='4'>" + askEscapeHtml(askT(
            "No registered users yet.",
            "Nessun utente registrato.")) + "</td></tr>";
    }
    foreach (var u in users) {
        var status = askT("Enabled", "Attivo");
        if (u.enabled != true) {
            status = askT("Disabled", "Disabilitato");
        }
        html = html + "<tr><td>" + askEscapeHtml(u.username) + "</td><td>" +
            askEscapeHtml(u.role) + "</td><td>" + askEscapeHtml(status) +
            "</td><td class='admin-actions'>";
        var askSel = "";
        var adminSel = "";
        if (u.role == "ask") {
            askSel = " selected";
        }
        if (u.role == "admin") {
            adminSel = " selected";
        }
        html = html + "<form method='post' action='/admin/users/role'>" +
            "<input type='hidden' name='username' value='" + askEscapeHtml(u.username) + "'>" +
            "<select name='role'><option value='ask'" + askSel + ">ask</option>" +
            "<option value='admin'" + adminSel + ">admin</option></select> " +
            "<button type='submit'>" + askEscapeHtml(askT("Set role", "Imposta ruolo")) +
            "</button></form> ";
        if (u.enabled == true) {
            html = html + "<form method='post' action='/admin/users/disable'>" +
                "<input type='hidden' name='username' value='" + askEscapeHtml(u.username) + "'>" +
                "<button type='submit'>" + askEscapeHtml(askT("Disable", "Disabilita")) +
                "</button></form> ";
        } else {
            html = html + "<form method='post' action='/admin/users/enable'>" +
                "<input type='hidden' name='username' value='" + askEscapeHtml(u.username) + "'>" +
                "<button type='submit'>" + askEscapeHtml(askT("Enable", "Abilita")) +
                "</button></form> ";
        }
        html = html + "<form method='post' action='/admin/users/reset-password'>" +
            "<input type='hidden' name='username' value='" + askEscapeHtml(u.username) + "'>" +
            "<input type='password' name='password' placeholder='" +
            askEscapeHtml(askT("New password", "Nuova password")) +
            "' minlength='6' required> " +
            "<button type='submit'>" + askEscapeHtml(askT("Reset", "Reset")) +
            "</button></form> ";
        html = html + "<form method='post' action='/admin/users/delete'>" +
            "<input type='hidden' name='username' value='" + askEscapeHtml(u.username) + "'>" +
            "<button type='submit'>" + askEscapeHtml(askT("Delete", "Elimina")) +
            "</button></form>";
        html = html + "</td></tr>";
    }
    html = html + "</tbody></table></main></body></html>";
    return html;
}

@PAGE("/admin/users")
function askUiAdminUsers(req, res) {
