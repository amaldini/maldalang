function askBrainIsEmbedded() {
    var session = askGetSession();
    var brainDir = str.trim(askAsText(session.brainDir));
    return str.startsWith(brainDir, "embed:");
}

function askRenderAdminUploadPage(flash, okMsg) {
    var err = str.trim(askAsText(flash));
    var ok = str.trim(askAsText(okMsg));
    var banner = "";
    if (err != "") {
        banner = "<p class='flash error'>" + askEscapeHtml(err) + "</p>";
    } else if (ok != "") {
        banner = "<p class='ok'>" + askEscapeHtml(ok) + "</p>";
    }
    var body = "";
    if (askBrainIsEmbedded()) {
        body = "<p>" + askEscapeHtml(askT(
            "UPDATE is not available for embedded (packed) brains. Rebuild on disk and re-pack.",
            "UPDATE non disponibile per brain embeddati (pack). Aggiorna su disco e rifai il pack.")) + "</p>";
    } else {
        body = "<form method='post' action='/admin/upload' enctype='multipart/form-data'>" +
            "<label for='docs'>" + askEscapeHtml(askT(
                "Upload .md / .html into the docs folder, then run UPDATE",
                "Carica .md / .html nella cartella docs, poi esegui UPDATE")) + "</label>" +
            "<input id='docs' name='docs' type='file' multiple accept='.md,.html,.htm' required>" +
            "<p><button type='submit'>" + askEscapeHtml(askT(
                "Upload and update", "Carica e aggiorna")) + "</button></p></form>";
    }
    return "<!DOCTYPE html><html lang='" + askGetLang() + "'><head>" +
        "<meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'>" +
        "<title>" + askEscapeHtml(askT("Upload", "Upload")) + "</title>" +
        askPageStyles() + askAuthFormStyles() +
        "</head><body><main class='admin-wrap'>" +
        "<p><a href='/'>" + askEscapeHtml(askT("← Back to ASK", "← Torna ad ASK")) +
        "</a> · <a href='/admin/users'>" + askEscapeHtml(askT("Users", "Utenti")) +
        "</a></p>" +
        "<h1>" + askEscapeHtml(askT("Upload documents", "Carica documenti")) + "</h1>" +
        banner + body + "</main></body></html>";
}

@PAGE("/admin/upload")
function askUiAdminUploadPage(req, res) {
    if (not askRequireAdmin(req, res)) {
        return "";
    }
    return askRenderAdminUploadPage("", "");
}

@POST("/admin/upload")
function askUiAdminUploadSubmit(req, res, body) {
    if (not askRequireAdmin(req, res)) {
        return "";
    }
    if (askBrainIsEmbedded()) {
        return askRenderAdminUploadPage(askT(
            "UPDATE is not available for embedded brains.",
            "UPDATE non disponibile per brain embeddati."), "");
    }
    var result = runAskUpdateFromUpload(body);
    if (result == null or result.ok != true) {
        var err = askT("Update failed.", "Aggiornamento fallito.");
        if (result != null and askAsText(result.error) != "") {
            err = askAsText(result.error);
        }
        askAudit("upload", req, { "ok": false, "error": err });
        return askRenderAdminUploadPage(err, "");
    }
    askAudit("upload", req, {
        "ok": true,
        "added": result.added,
        "changed": result.changed,
        "files": result.files
    });
    askAudit("update", req, {
        "ok": true,
        "added": result.added,
        "changed": result.changed
    });
    return askRenderAdminUploadPage("", askT(
        "Upload and UPDATE completed.",
        "Upload e UPDATE completati.") + " " +
        askT("Added/changed:", "Aggiunti/modificati:") + " " +
        string(result.added) + "/" + string(result.changed));
}
