        ".tag-picker-chevron{flex:0 0 auto;color:var(--muted);font-size:0.75rem;line-height:1}" +
        ".tag-picker-panel{position:absolute;left:0;right:0;bottom:calc(100% + 6px);" +
        "max-height:min(38vh,220px);overflow:auto;display:flex;flex-wrap:wrap;gap:8px;" +
        "padding:10px 12px;background:var(--panel);border:1px solid var(--line);border-radius:10px;" +
        "box-shadow:0 10px 28px var(--shadow);z-index:20}" +
        ".tag-picker-panel label{font-size:0.78rem;color:var(--muted);display:flex;gap:5px;" +
        "align-items:center;padding:3px 2px;max-width:100%}" +
        ".tag-picker-panel label span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}" +
        ".tag-picker-empty{font-size:0.78rem;color:var(--muted);margin:0}" +
        ".admin-table{width:100%;border-collapse:collapse;font-size:0.9rem}" +
