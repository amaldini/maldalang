// secondbrain_ask_ui_lib.malda - shared ASK web UI for secondbrain*.malda
//
// Included by the host program. Host must define:
//   ASK_HTTP_PORT, ASK_HTTP_HOST, ASK_HTTPS, ASK_CERT_PATH, ASK_CERT_PASSWORD,
//   ASK_SESSION_ID, ASK_STORE  (vars)
//   PRODUCT_NAME                             (display name, OR path/embed: to a utf-8 text file)
//   ASK_TITLE_SUFFIX                         (optional; default ""; used when refreshing title from file)
//   ASK_PAGE_TITLE, ASK_POWERED_BY, ASK_POWERED_BY_URL  (header branding)
//   ASK_LOGO  (optional logo left of title: "", file path, embed:..., http(s):, or data:)
//   ASK_LOGO_RIGHT  (optional logo right of title — same path forms as ASK_LOGO)
//   ASK_LOGO_RIGHT_HEIGHT  (optional; CSS height in px, default 48 — number, "64"/"64px",
//                           OR path/embed: to a utf-8 text file like PRODUCT_NAME)
//   askHttpServer                            (var, initially null)
//   runAskTurn(question) -> { question, answer, sources, error }
//              Hosts read askGetAskMode() ("ask"|"generate") and may set
//              generated=true + filename on successful document turns.
//   UI_LANG                                  (existing)
//
// Brain branding (disk or embed root), auto-loaded when hosts call askApply*FromBrain:
//   product_name.txt — first non-empty line
//   logo_right_height.txt — first non-empty line (px; overrides ASK_LOGO_RIGHT_HEIGHT)
//   logo.png / .svg / .jpg / .jpeg / .webp / .gif / .ico — if ASK_LOGO is empty
//   logo_right.png / .svg / .jpg / .jpeg / .webp / .gif / .ico — if ASK_LOGO_RIGHT is empty
//
// HttpServer isolates each request: brain/catalog live in shared ui.state
// (ASK_SESSION_ID), pinned so TTL/LRU cannot drop process-lifetime meta.
// Per-browser conversations use scope askConvScope() from query/body/cookie
// `c` (malda_ask_c). Ask / Clear use @ACTION +
// componentFragment("ask-panel", ...) so the HttpServer AJAX helper patches
// only #ask-panel. Live progress uses @LIVE + per-conversation SSE channel
// ask-{c} because the POST /ask connection stays blocked until the answer
// is ready.
//
// Shared reads use ui.getState (peek). Do not ui.state(..., {}) / null on
// session/catalog — that get-or-create path poisons the store after a miss.
//
// Theme: query `theme=light|dark` (header toggle). Persisted in cookie
// malda_ask_theme (browser-wide, survives conversations); also mirrored in
// ui.state for the active scope. Default light. CSS: html[data-theme=...].
//
// Cookie JWT auth is on by default for ASK. Disable with --no-auth (or
// MALDA_ASK_AUTH=0). Login: /login  Logout: /logout  Register: /register.
// Bootstrap credentials: MALDA_ASK_USER / MALDA_ASK_PASSWORD (or HASH).
// Multi-user store: users.json under the brain folder (writable), else
// .malda/ask_users.json. Open registration: --allow-register.
// Per-user history scope: u:{sub}:{convId}. Admin: /admin/users, /admin/upload.
// Health: GET /health. Audit: ask_audit.jsonl. Feedback: /feedback + ask_feedback.jsonl.
// Generate document: composer Ask/Generate toggle; download GET /generate/download
//   ?c=&turn=&fmt=md|html (cookie JWT, same history scope).
// Host must define runAskTurn(question) and runAskUpdateFromUpload(body).

// HTTPS defaults (hosts may override after include, or via --https CLI apply).
var ASK_HTTPS = false;
var ASK_CERT_PATH = "";
var ASK_CERT_PASSWORD = "";

var ASK_CONV_COOKIE = "malda_ask_c";
var ASK_THEME_COOKIE = "malda_ask_theme";
var ASK_CONV_CURRENT = "";
var ASK_THEME_CURRENT = "";
var ASK_HISTORY_CURRENT = "";
var ASK_CURRENT_SUB = "";
var ASK_CURRENT_ROLE = "";
var ASK_CURRENT_IS_ADMIN = false;
var ASK_AUTH_COOKIE = "malda_ask_session";
var ASK_AUTH_ENABLED = true;
var ASK_ALLOW_REGISTER = false;
var ASK_SHOW_EXAMPLES = true;
var ASK_AUTH_USER = "admin";
var ASK_AUTH_PASSWORD_HASH = "";
var ASK_AUTH_USING_DEFAULT_PASSWORD = false;
var ASK_USERS_PATH = "";
var ASK_USERS_FILE_NAME = "users.json";
var ASK_AUDIT_PATH = "";
var ASK_FEEDBACK_PATH = "";
var ASK_SERVICE_VERSION = "0.2.0";
var ASK_MIN_RETRIEVAL_SCORE = 0.15;
var ASK_MIN_LEXICAL_SCORE = 1.0;
var askAuthJwtSecret = "";
var askAuthCookieSecret = "";
var askAuthSessionSecret = "";
var ASK_SHARED_STORE_CONFIGURED = false;

function askAsText(value) {
    return str.text(value);
}

// CLI: --port 8080 | -p 8080 | --port=8080 (also works on packed ASK .exe).
//      --host 0.0.0.0 | --host=* | --host=localhost
//      --https --cert path.pfx [--cert-password pwd]
// Scans getCommandLineArgs(); when run via `malda script.malda ...` the script
// path is present in args and is ignored. Invalid / missing values keep defaultPort.
function askParsePortNumber(raw) {
    var s = str.trim(askAsText(raw));
    if (s == "") {
        return null;
    }
    var n = toIntOrNull(s);
    if (n == null) {
        return null;
    }
    if (n < 1 or n > 65535) {
        return null;
    }
    return n;
}

function askNormalizeHttpHost(raw) {
    var s = str.trim(askAsText(raw));
    if (s == "") {
        return "";
    }
    if (s == "*" or str.lower(s) == "all") {
        return "0.0.0.0";
    }
    return s;
}

function askParseHttpPortFromArgs(args, defaultPort) {
    var fallback = defaultPort;
    if (args == null) {
        return { "ok": true, "changed": false, "port": fallback, "raw": "" };
    }
    var i = 0;
    while (i < args.length) {
        var a = str.trim(askAsText(args[i]));
        if (a == "--port" or a == "-p") {
            if (i + 1 >= args.length) {
                return { "ok": false, "changed": false, "port": fallback, "raw": "" };
            }
            var next = askAsText(args[i + 1]);
            var n = askParsePortNumber(next);
            if (n == null) {
                return { "ok": false, "changed": false, "port": fallback, "raw": next };
            }
            return { "ok": true, "changed": true, "port": n, "raw": next };
        }
        if (str.startsWith(a, "--port=")) {
            var eq = str.substring(a, 7, str.length(a) - 7);
            var nEq = askParsePortNumber(eq);
            if (nEq == null) {
                return { "ok": false, "changed": false, "port": fallback, "raw": eq };
            }
            return { "ok": true, "changed": true, "port": nEq, "raw": eq };
        }
        if (str.startsWith(a, "-p=") and str.length(a) > 3) {
            var eqP = str.substring(a, 3, str.length(a) - 3);
            var nP = askParsePortNumber(eqP);
            if (nP == null) {
                return { "ok": false, "changed": false, "port": fallback, "raw": eqP };
            }
            return { "ok": true, "changed": true, "port": nP, "raw": eqP };
        }
        i = i + 1;
    }
    return { "ok": true, "changed": false, "port": fallback, "raw": "" };
}

function askParseHttpHostFromArgs(args, defaultHost) {
    var fallback = askNormalizeHttpHost(defaultHost);
    if (fallback == "") {
        fallback = "localhost";
    }
    if (args == null) {
        return { "ok": true, "changed": false, "host": fallback, "raw": "" };
    }
    var i = 0;
    while (i < args.length) {
        var a = str.trim(askAsText(args[i]));
        if (a == "--host") {
            if (i + 1 >= args.length) {
                return { "ok": false, "changed": false, "host": fallback, "raw": "" };
            }
            var next = askNormalizeHttpHost(args[i + 1]);
            if (next == "") {
                return { "ok": false, "changed": false, "host": fallback, "raw": askAsText(args[i + 1]) };
            }
            return { "ok": true, "changed": true, "host": next, "raw": next };
        }
        if (str.startsWith(a, "--host=")) {
            var rawEq = "";
            if (str.length(a) > 7) {
                rawEq = str.substring(a, 7, str.length(a) - 7);
            }
            var eq = askNormalizeHttpHost(rawEq);
            if (eq == "") {
                return { "ok": false, "changed": false, "host": fallback, "raw": rawEq };
            }
            return { "ok": true, "changed": true, "host": eq, "raw": eq };
        }
        i = i + 1;
    }
    return { "ok": true, "changed": false, "host": fallback, "raw": "" };
}

function applyAskHttpPortFromCli() {
    var parsed = askParseHttpPortFromArgs(getCommandLineArgs(), ASK_HTTP_PORT);
    if (parsed.ok != true) {
        AnsiConsole.markupLine("[yellow]" + askT(
            "Invalid --port / -p value; keeping ",
            "Valore --port / -p non valido; resta ") +
            string(ASK_HTTP_PORT) +
            askT(".", ".") + "[/]");
        return ASK_HTTP_PORT;
    }
    if (parsed.changed == true) {
        ASK_HTTP_PORT = parsed.port;
        AnsiConsole.markupLine("[dim]" + askT(
            "ASK HTTP port from CLI: ",
            "Porta HTTP ASK da riga di comando: ") +
            string(ASK_HTTP_PORT) + "[/]");
    }
    return ASK_HTTP_PORT;
}

function applyAskHttpHostFromCli() {
    var parsed = askParseHttpHostFromArgs(getCommandLineArgs(), ASK_HTTP_HOST);
    if (parsed.ok != true) {
        AnsiConsole.markupLine("[yellow]" + askT(
            "Invalid --host value; keeping ",
            "Valore --host non valido; resta ") +
            ASK_HTTP_HOST +
            askT(".", ".") + "[/]");
        return ASK_HTTP_HOST;
    }
    if (parsed.changed == true) {
        ASK_HTTP_HOST = parsed.host;
        AnsiConsole.markupLine("[dim]" + askT(
            "ASK HTTP host from CLI: ",
            "Host HTTP ASK da riga di comando: ") +
            ASK_HTTP_HOST + "[/]");
    }
    return ASK_HTTP_HOST;
}

function askParseHttpsFromArgs(args) {
    var result = {
        "ok": true,
        "https": false,
        "cert": "",
        "certPassword": "",
        "error": ""
    };
    if (args == null) {
        return result;
    }
    var i = 0;
    while (i < args.length) {
        var a = str.trim(askAsText(args[i]));
        if (a == "--https") {
            result.https = true;
            i = i + 1;
            continue;
        }
        if (a == "--cert") {
            if (i + 1 >= args.length or str.trim(askAsText(args[i + 1])) == "") {
                result.ok = false;
                result.error = "Missing value for --cert.";
                return result;
            }
            result.cert = str.trim(askAsText(args[i + 1]));
            i = i + 2;
            continue;
        }
        if (str.startsWith(a, "--cert=")) {
            var rawCert = "";
            if (str.length(a) > 7) {
                rawCert = str.substring(a, 7, str.length(a) - 7);
            }
            if (str.trim(rawCert) == "") {
                result.ok = false;
                result.error = "Missing value for --cert.";
                return result;
            }
            result.cert = str.trim(rawCert);
            i = i + 1;
            continue;
        }
        if (a == "--cert-password") {
            if (i + 1 >= args.length) {
                result.ok = false;
                result.error = "Missing value for --cert-password.";
                return result;
            }
            result.certPassword = askAsText(args[i + 1]);
            i = i + 2;
            continue;
        }
        if (str.startsWith(a, "--cert-password=")) {
            var rawPwd = "";
            if (str.length(a) > 16) {
                rawPwd = str.substring(a, 16, str.length(a) - 16);
            }
            result.certPassword = rawPwd;
            i = i + 1;
            continue;
        }
        i = i + 1;
    }
    if (result.https == true and str.trim(result.cert) == "") {
        result.ok = false;
        result.error = "--https requires --cert <path>.";
    }
    return result;
}

function applyAskHttpsFromCli() {
    var parsed = askParseHttpsFromArgs(getCommandLineArgs());
    if (parsed.ok != true) {
        AnsiConsole.markupLine("[red]" + askAsText(parsed.error) + "[/]");
        return false;
    }
    if (parsed.https == true) {
        ASK_HTTPS = true;
        ASK_CERT_PATH = str.trim(askAsText(parsed.cert));
        ASK_CERT_PASSWORD = askAsText(parsed.certPassword);
        if (ASK_CERT_PASSWORD == "") {
            var envPwd = askEnvText("MALDA_HTTP_CERT_PASSWORD");
            if (envPwd != "") {
                ASK_CERT_PASSWORD = envPwd;
            }
        }
        AnsiConsole.markupLine("[dim]" + askT(
            "ASK HTTPS from CLI; cert: ",
            "ASK HTTPS da riga di comando; cert: ") +
            ASK_CERT_PATH + "[/]");
    }
    return true;
}

function askCookieSecureFlag() {
    return ASK_HTTPS == true;
}

// Console "Open:" URL for the ASK server (loopback vs all-interfaces).
function askFormatOpenUrl() {
    var scheme = "http";
    if (ASK_HTTPS == true) {
        scheme = "https";
    }
    var host = askNormalizeHttpHost(ASK_HTTP_HOST);
    if (host == "") {
        host = "localhost";
    }
    if (host == "0.0.0.0") {
        return scheme + "://0.0.0.0:" + string(ASK_HTTP_PORT) + "/";
    }
    return scheme + "://" + host + ":" + string(ASK_HTTP_PORT) + "/";
}

function askPrintOpenUrlHint() {
    AnsiConsole.markupLine(askT("Open:", "Apri:") + " [bold blue]" + askFormatOpenUrl() + "[/]");
    var host = askNormalizeHttpHost(ASK_HTTP_HOST);
    if (host == "0.0.0.0") {
        AnsiConsole.markupLine("[dim]" + askT(
            "Listening on all interfaces — use this machine's LAN IP from other devices.",
            "In ascolto su tutte le interfacce — usa l'IP LAN di questa macchina dagli altri dispositivi.") + "[/]");
    }
    if (ASK_HTTPS == true) {
        AnsiConsole.markupLine("[dim]" + askT(
            "HTTPS enabled (self-signed certs need a browser exception).",
            "HTTPS attivo (i certificati self-signed richiedono un'eccezione nel browser).") + "[/]");
    }
}

// ---------------------------------------------------------------- ASK auth (cookie JWT + users.json)

function askEnvText(name) {
    var key = str.trimText(name);
    if (key == "") {
        return "";
    }
    return str.trim(io.getEnvOr(key));
}

function askEnvBoolOverride(name) {
    var raw = str.lower(askEnvText(name));
    if (raw == "") {
        return null;
    }
    if (raw == "0" or raw == "false" or raw == "off" or raw == "no") {
        return false;
    }
    if (raw == "1" or raw == "true" or raw == "on" or raw == "yes") {
        return true;
    }
    return null;
}

function askParseBoolFlagFromArgs(args, onFlag, offFlag) {
    // Last matching flag wins. Returns true / false / null (unset).
    if (args == null) {
        return null;
    }
    var flag = null;
    var i = 0;
    while (i < args.length) {
        var a = str.trim(askAsText(args[i]));
        if (a == onFlag) {
            flag = true;
        } else if (a == offFlag) {
            flag = false;
        }
        i = i + 1;
    }
    return flag;
}

// Resolve ASK_AUTH_ENABLED + ASK_ALLOW_REGISTER + ASK_SHOW_EXAMPLES from env,
// CLI args, then cli opts.
function askApplyAuthFromCli(cli) {
    var enabled = true;
    var envAuth = askEnvBoolOverride("MALDA_ASK_AUTH");
    if (envAuth != null) {
        enabled = envAuth;
    }
    var argAuth = askParseBoolFlagFromArgs(getCommandLineArgs(), "--auth", "--no-auth");
    if (argAuth != null) {
        enabled = argAuth;
    }
    if (cli != null and cli.auth != null) {
        enabled = cli.auth == true;
    }
    ASK_AUTH_ENABLED = enabled == true;

    var allowReg = false;
    var envReg = askEnvBoolOverride("MALDA_ASK_ALLOW_REGISTER");
    if (envReg != null) {
        allowReg = envReg;
    }
    var argReg = askParseBoolFlagFromArgs(
        getCommandLineArgs(), "--allow-register", "--no-register");
    if (argReg != null) {
        allowReg = argReg;
    }
    if (cli != null and cli.allowRegister != null) {
        allowReg = cli.allowRegister == true;
    }
    ASK_ALLOW_REGISTER = allowReg == true and ASK_AUTH_ENABLED;

    var showExamples = true;
    var envExamples = askEnvBoolOverride("MALDA_ASK_EXAMPLES");
    if (envExamples != null) {
        showExamples = envExamples;
    }
    var argExamples = askParseBoolFlagFromArgs(
        getCommandLineArgs(), "--examples", "--no-examples");
    if (argExamples != null) {
        showExamples = argExamples;
    }
    if (cli != null and cli.showExamples != null) {
        showExamples = cli.showExamples == true;
    }
    ASK_SHOW_EXAMPLES = showExamples == true;
    return ASK_AUTH_ENABLED;
}

// Prefer brainDir/users.json when writable; else .malda/ask_users.json (embed-safe).
function askSetAuthUsersRoot(brainDir) {
    var root = str.trim(askAsText(brainDir));
    if (root != "" and not str.startsWith(root, "embed:") and io.hasDirectory(root)) {
        ASK_USERS_PATH = io.pathJoin(root, ASK_USERS_FILE_NAME);
        ASK_AUDIT_PATH = io.pathJoin(root, "ask_audit.jsonl");
        ASK_FEEDBACK_PATH = io.pathJoin(root, "ask_feedback.jsonl");
        return ASK_USERS_PATH;
    }
    try {
        io.ensureDir(".malda");
    } catch (dirErr) {
    }
    ASK_USERS_PATH = io.pathJoin(".malda", "ask_users.json");
    ASK_AUDIT_PATH = io.pathJoin(".malda", "ask_audit.jsonl");
    ASK_FEEDBACK_PATH = io.pathJoin(".malda", "ask_feedback.jsonl");
    return ASK_USERS_PATH;
}

function askAppendJsonl(path, obj) {
    var p = str.trim(askAsText(path));
    if (p == "" or obj == null) {
        return false;
    }
    try {
        var parent = io.getDirectoryName(p);
        if (parent != null and str.trim(askAsText(parent)) != "") {
            io.ensureDir(parent);
        }
        var line = toJSON(obj) + "\n";
        var prev = "";
        if (io.hasFile(p)) {
            prev = askAsText(io.readFile(p));
        }
        io.writeFile(p, prev + line);
        return true;
    } catch (logErr) {
        return false;
    }
}

function askAudit(action, req, meta) {
    var sub = ASK_CURRENT_SUB;
    var role = ASK_CURRENT_ROLE;
    if (req != null and req.auth != null) {
        try {
            if (req.auth.verified == true) {
                sub = str.trim(askAsText(req.auth.sub));
                role = str.trim(askAsText(req.auth.claim("role", "")));
            }
        } catch (aErr) {
        }
    }
    var m = meta;
    if (m == null) {
        m = {};
    }
    askAppendJsonl(ASK_AUDIT_PATH, {
        "ts": string(now()),
        "sub": sub,
        "role": role,
        "conv": askConvScope(),
        "action": askAsText(action),
        "meta": m
    });
}

function askUsersPath() {
    if (str.trim(ASK_USERS_PATH) != "") {
        return ASK_USERS_PATH;
    }
    return askSetAuthUsersRoot("");
}

function askEmptyUsersStore() {
    return { "users": [] };
}

function askLoadUsersStore() {
    var path = askUsersPath();
    if (path == "" or not io.hasFile(path)) {
        return askEmptyUsersStore();
    }
    try {
        var parsed = parseJSON(io.readFile(path));
        if (parsed == null or parsed.users == null) {
            return askEmptyUsersStore();
        }
        return parsed;
    } catch (loadErr) {
        return askEmptyUsersStore();
    }
}

function askSaveUsersStore(store) {
    var path = askUsersPath();
    if (path == "") {
        return false;
    }
    var payload = store;
    if (payload == null) {
        payload = askEmptyUsersStore();
    }
    if (payload.users == null) {
        payload.users = [];
    }
    try {
        var parent = io.getDirectoryName(path);
        if (parent != null and str.trim(askAsText(parent)) != "") {
            io.ensureDir(parent);
        }
        io.writeFile(path, toJSON(payload));
        return true;
    } catch (saveErr) {
        return false;
    }
}

function askUsersCount() {
    var store = askLoadUsersStore();
    if (store == null or store.users == null) {
        return 0;
    }
    return store.users.length;
}

function askNormalizeUsername(raw) {
    return str.trim(askAsText(raw));
}

function askIsValidUsername(raw) {
    var name = askNormalizeUsername(raw);
    // 128 allows typical email-as-username (letters, digits, _ - . @).
    if (str.length(name) < 3 or str.length(name) > 128) {
        return false;
    }
    var allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-.@";
    var i = 0;
    while (i < str.length(name)) {
        var ch = str.substring(name, i, 1);
        if (str.indexOf(allowed, ch) < 0) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

function askFindStoredUser(username) {
    var want = str.lower(askNormalizeUsername(username));
    if (want == "") {
        return null;
    }
    var store = askLoadUsersStore();
    if (store == null or store.users == null) {
        return null;
    }
    foreach (var u in store.users) {
        if (u == null) {
            continue;
        }
        if (str.lower(askNormalizeUsername(u.username)) == want) {
            return u;
        }
    }
    return null;
}

function askVerifyLogin(username, password) {
    var name = askNormalizeUsername(username);
    var pass = askAsText(password);
    if (name == "" or pass == "") {
        return { "ok": false, "username": "", "role": "" };
    }
    var stored = askFindStoredUser(name);
    if (stored != null) {
        if (stored.enabled == false) {
            return { "ok": false, "username": "", "role": "", "disabled": true };
        }
        if (verifyPassword(pass, askAsText(stored.passwordHash))) {
            var role = str.trim(askAsText(stored.role));
            if (role == "") {
                role = "ask";
            }
            return {
                "ok": true,
                "username": askNormalizeUsername(stored.username),
                "role": role
            };
        }
        return { "ok": false, "username": "", "role": "" };
    }
    // Bootstrap env user (always available, even when users.json has others).
    if (str.lower(name) == str.lower(ASK_AUTH_USER) and
            verifyPassword(pass, ASK_AUTH_PASSWORD_HASH)) {
        return { "ok": true, "username": ASK_AUTH_USER, "role": "admin" };
    }
    return { "ok": false, "username": "", "role": "" };
}

function askRegisterUser(username, password) {
    var name = askNormalizeUsername(username);
    var pass = askAsText(password);
    if (not askIsValidUsername(name)) {
        return {
            "ok": false,
            "error": askT(
                "Username must be 3–128 characters: letters, digits, _ - . @ (email ok).",
                "Username: 3–128 caratteri (lettere, cifre, _ - . @; email ok).")
        };
    }
    if (str.length(pass) < 6) {
        return {
            "ok": false,
            "error": askT(
                "Password must be at least 6 characters.",
                "La password deve avere almeno 6 caratteri.")
        };
    }
    if (askFindStoredUser(name) != null) {
        return {
            "ok": false,
            "error": askT("That username is already taken.", "Username gia' in uso.")
        };
    }
    if (str.lower(name) == str.lower(ASK_AUTH_USER)) {
        return {
            "ok": false,
            "error": askT(
                "That username is reserved for the bootstrap admin.",
                "Username riservato all'admin di bootstrap.")
        };
    }
    var store = askLoadUsersStore();
    if (store.users == null) {
        store.users = [];
    }
    store.users.append({
        "username": name,
        "passwordHash": hashPassword(pass),
        "role": "ask",
        "enabled": true,
        "createdAt": string(now())
    });
    if (not askSaveUsersStore(store)) {
        return {
            "ok": false,
            "error": askT(
                "Could not save users file (is the brain folder writable?).",
                "Impossibile salvare users.json (cartella brain scrivibile?).")
        };
    }
    return { "ok": true, "error": "" };
}

function askListUsers() {
    var store = askLoadUsersStore();
    var out = [];
    if (store == null or store.users == null) {
        return out;
    }
    foreach (var u in store.users) {
        if (u == null) {
            continue;
        }
        var role = str.trim(askAsText(u.role));
        if (role == "") {
            role = "ask";
        }
        var enabled = true;
        if (u.enabled == false) {
            enabled = false;
        }
        out.append({
            "username": askNormalizeUsername(u.username),
            "role": role,
            "enabled": enabled,
            "createdAt": askAsText(u.createdAt)
        });
    }
    return out;
}

function askCountEnabledAdmins(store) {
    var n = 0;
    if (store == null or store.users == null) {
        return 0;
    }
    foreach (var u in store.users) {
        if (u == null) {
            continue;
        }
        if (u.enabled == false) {
            continue;
        }
        if (str.trim(askAsText(u.role)) == "admin") {
            n = n + 1;
        }
    }
    return n;
}

function askSetUserRole(username, role) {
    var name = askNormalizeUsername(username);
    var r = str.lower(str.trim(askAsText(role)));
    if (r != "ask" and r != "admin") {
        return { "ok": false, "error": askT("Invalid role.", "Ruolo non valido.") };
    }
    var store = askLoadUsersStore();
    var u = askFindStoredUser(name);
    if (u == null) {
        return { "ok": false, "error": askT("User not found.", "Utente non trovato.") };
    }
    var prev = str.trim(askAsText(u.role));
    if (prev == "") {
        prev = "ask";
    }
    if (prev == "admin" and r != "admin" and askCountEnabledAdmins(store) <= 1) {
        return {
            "ok": false,
            "error": askT("Cannot demote the last admin.", "Non puoi declassare l'ultimo admin.")
        };
    }
    foreach (var row in store.users) {
        if (row != null and str.lower(askNormalizeUsername(row.username)) == str.lower(name)) {
            row.role = r;
        }
    }
    if (not askSaveUsersStore(store)) {
        return { "ok": false, "error": askT("Save failed.", "Salvataggio fallito.") };
    }
    return { "ok": true, "error": "" };
}

function askSetUserEnabled(username, enabled) {
    var name = askNormalizeUsername(username);
    var store = askLoadUsersStore();
    var u = askFindStoredUser(name);
    if (u == null) {
        return { "ok": false, "error": askT("User not found.", "Utente non trovato.") };
    }
    var role = str.trim(askAsText(u.role));
    if (role == "") {
        role = "ask";
    }
    if (enabled != true and role == "admin" and askCountEnabledAdmins(store) <= 1) {
        return {
            "ok": false,
            "error": askT("Cannot disable the last admin.", "Non puoi disabilitare l'ultimo admin.")
        };
    }
    foreach (var row in store.users) {
        if (row != null and str.lower(askNormalizeUsername(row.username)) == str.lower(name)) {
            row.enabled = enabled == true;
        }
    }
    if (not askSaveUsersStore(store)) {
        return { "ok": false, "error": askT("Save failed.", "Salvataggio fallito.") };
    }
    return { "ok": true, "error": "" };
}

function askResetUserPassword(username, newPassword) {
    var name = askNormalizeUsername(username);
    var pass = askAsText(newPassword);
    if (str.length(pass) < 6) {
        return {
            "ok": false,
            "error": askT(
                "Password must be at least 6 characters.",
                "La password deve avere almeno 6 caratteri.")
        };
    }
    var store = askLoadUsersStore();
    if (askFindStoredUser(name) == null) {
        return { "ok": false, "error": askT("User not found.", "Utente non trovato.") };
    }
    foreach (var row in store.users) {
        if (row != null and str.lower(askNormalizeUsername(row.username)) == str.lower(name)) {
            row.passwordHash = hashPassword(pass);
        }
    }
    if (not askSaveUsersStore(store)) {
        return { "ok": false, "error": askT("Save failed.", "Salvataggio fallito.") };
    }
    return { "ok": true, "error": "" };
}

function askDeleteUser(username) {
    var name = askNormalizeUsername(username);
    var store = askLoadUsersStore();
    var u = askFindStoredUser(name);
    if (u == null) {
        return { "ok": false, "error": askT("User not found.", "Utente non trovato.") };
    }
    var role = str.trim(askAsText(u.role));
    if (role == "") {
        role = "ask";
    }
    if (role == "admin" and askCountEnabledAdmins(store) <= 1 and u.enabled != false) {
        return {
            "ok": false,
            "error": askT("Cannot delete the last admin.", "Non puoi eliminare l'ultimo admin.")
        };
    }
    var next = [];
    foreach (var row in store.users) {
        if (row == null) {
            continue;
        }
        if (str.lower(askNormalizeUsername(row.username)) == str.lower(name)) {
            continue;
        }
        next.append(row);
    }
    store.users = next;
    if (not askSaveUsersStore(store)) {
        return { "ok": false, "error": askT("Save failed.", "Salvataggio fallito.") };
    }
    return { "ok": true, "error": "" };
}

function askIssueSessionCookie(res, username, role) {
    var token = createJwt({
        "sub": username,
        "role": role
    }, askAuthJwtSecret, {
        "expiresInSeconds": 86400,
        "issuer": "secondbrain-ask",
        "audience": "secondbrain-ask"
    });
    var setCookie = createSecureCookie(ASK_AUTH_COOKIE, token, askAuthCookieSecret, {
        "maxAge": 86400,
        "sameSite": "Lax",
        "httpOnly": true,
        "secure": askCookieSecureFlag(),
        "path": "/"
    });
    res.header("Set-Cookie", setCookie);
}

function askLoadAuthCredentials() {
    askAuthJwtSecret = askEnvText("MALDA_JWT_SECRET");
    if (askAuthJwtSecret == "") {
        askAuthJwtSecret = "dev-only-jwt-secret-change-me";
    }
    askAuthCookieSecret = askEnvText("MALDA_COOKIE_SECRET");
    if (askAuthCookieSecret == "") {
        askAuthCookieSecret = "dev-only-cookie-secret-change-me";
    }
    askAuthSessionSecret = askEnvText("MALDA_SESSION_SECRET");
    if (askAuthSessionSecret == "") {
        askAuthSessionSecret = "dev-only-session-secret-change-me";
    }

    var user = askEnvText("MALDA_ASK_USER");
    if (user == "") {
        user = "admin";
    }
    ASK_AUTH_USER = user;

    var hash = askEnvText("MALDA_ASK_PASSWORD_HASH");
    ASK_AUTH_USING_DEFAULT_PASSWORD = false;
    if (hash != "") {
        ASK_AUTH_PASSWORD_HASH = hash;
        return;
    }
    var password = askEnvText("MALDA_ASK_PASSWORD");
    if (password == "") {
        password = "password";
        ASK_AUTH_USING_DEFAULT_PASSWORD = true;
    }
    ASK_AUTH_PASSWORD_HASH = hashPassword(password);
}

function askPrintAuthStatus() {
    if (not ASK_AUTH_ENABLED) {
        AnsiConsole.markupLine("[dim]" + askT(
            "ASK auth: off (--no-auth or MALDA_ASK_AUTH=0).",
            "Auth ASK: off (--no-auth o MALDA_ASK_AUTH=0).") + "[/]");
        return;
    }
    var n = askUsersCount();
    AnsiConsole.markupLine("[dim]" + askT(
        "ASK auth: on — bootstrap user=",
        "Auth ASK: on — utente bootstrap=") + ASK_AUTH_USER +
        askT("; registered=", "; registrati=") + string(n) +
        askT("; users file=", "; file utenti=") + askUsersPath() + "[/]");
    if (ASK_ALLOW_REGISTER) {
        AnsiConsole.markupLine("[dim]" + askT(
            "Open registration: on (/register).",
            "Registrazione aperta: on (/register).") + "[/]");
    } else {
        AnsiConsole.markupLine("[dim]" + askT(
            "Open registration: off (use --allow-register).",
            "Registrazione aperta: off (usa --allow-register).") + "[/]");
    }
    if (ASK_AUTH_USING_DEFAULT_PASSWORD) {
        AnsiConsole.markupLine("[yellow]" + askT(
            "Bootstrap password is default 'password'. Set MALDA_ASK_PASSWORD (or HASH).",
            "Password bootstrap di default 'password'. Imposta MALDA_ASK_PASSWORD (o HASH).") + "[/]");
    }
}

function askIsLoopbackHttpHost(raw) {
    var host = str.lower(askNormalizeHttpHost(raw));
    if (host == "") {
        return true;
    }
    return host == "localhost" or host == "127.0.0.1" or host == "::1" or host == "[::1]";
}

function askHasDefaultDevSecrets() {
    return askAuthJwtSecret == "dev-only-jwt-secret-change-me" or
        askAuthCookieSecret == "dev-only-cookie-secret-change-me" or
        askAuthSessionSecret == "dev-only-session-secret-change-me";
}

// True = caller must not listen. Public bind + default password or JWT secrets is refused.
// --no-auth on a public host warns but still starts.
function askRefuseInsecurePublicBind() {
    if (askIsLoopbackHttpHost(ASK_HTTP_HOST)) {
        return false;
    }
    if (not ASK_AUTH_ENABLED) {
        AnsiConsole.markupLine("[yellow]" + askT(
            "ASK is bound on a non-loopback host with auth off. Anyone who can reach this port can query the brain.",
            "ASK e' in ascolto su un host non-loopback senza auth. Chi raggiunge la porta puo' interrogare il brain.") + "[/]");
        return false;
    }
    var defaultPassword = ASK_AUTH_USING_DEFAULT_PASSWORD == true;
    var defaultSecrets = askHasDefaultDevSecrets();
    if (not defaultPassword and not defaultSecrets) {
        return false;
    }
    AnsiConsole.markupLine("[red]" + askT(
        "Refusing to start ASK on a non-loopback host with default credentials.",
        "Rifiuto di avviare ASK su un host non-loopback con credenziali di default.") + "[/]");
    if (defaultPassword) {
        AnsiConsole.markupLine("[red]" + askT(
            "Set MALDA_ASK_PASSWORD or MALDA_ASK_PASSWORD_HASH (bootstrap is still admin/password).",
            "Imposta MALDA_ASK_PASSWORD o MALDA_ASK_PASSWORD_HASH (il bootstrap e' ancora admin/password).") + "[/]");
    }
    if (defaultSecrets) {
        AnsiConsole.markupLine("[red]" + askT(
            "Set MALDA_JWT_SECRET, MALDA_COOKIE_SECRET, and MALDA_SESSION_SECRET.",
            "Imposta MALDA_JWT_SECRET, MALDA_COOKIE_SECRET e MALDA_SESSION_SECRET.") + "[/]");
    }
    return true;
}

function askRequireAuth(req, res, next) {
    // authenticateCookieJwt throws WebRuntimeException (401) when the session
    // cookie is missing/invalid — that must be catchable so we can redirect.
    try {
        req.auth.authenticateCookieJwt(ASK_AUTH_COOKIE, askAuthJwtSecret, askAuthCookieSecret);
        if (req.auth.verified != true) {
            return res.redirect("/login");
        }
        next();
    } catch (authErr) {
        return res.redirect("/login");
    }
}

// Call after askSetAuthUsersRoot + `new HttpServer(...)`, before `start()`.
function askConfigureHttpAuth(server) {
    if (server == null) {
        return false;
    }
    if (not ASK_AUTH_ENABLED) {
        askPrintAuthStatus();
        return false;
    }
    askLoadAuthCredentials();
    if (str.trim(ASK_USERS_PATH) == "") {
        askSetAuthUsersRoot("");
    }
    server.enableSession(askAuthSessionSecret);
    server.use(askRequireAuth, {
        "except": ["/login", "/logout", "/register", "/health"]
    });
    server.setRateLimit(120, 60, "verifiedSubOrIp");
    askPrintAuthStatus();
    return true;
}

function askIsAdminReq(req) {
    if (req == null or req.auth == null) {
        return false;
    }
    try {
        return req.auth.verified == true and req.auth.hasRole("admin");
    } catch (roleErr) {
        return false;
    }
}

// Returns true when admin; otherwise redirects to / and returns false.
// Admin routes stay closed when ASK auth is disabled (--no-auth).
function askRequireAdmin(req, res) {
    if (ASK_AUTH_ENABLED and askIsAdminReq(req)) {
        return true;
    }
    if (res != null) {
        res.redirect("/");
    }
    return false;
}

function askAuthFormStyles() {
    return "<style>.login-wrap{max-width:420px;margin:48px auto;padding:0 16px}" +
        ".login-wrap h1{font-size:1.35rem;margin:0 0 12px}" +
        ".login-wrap label{display:block;margin:12px 0 4px;font-size:.9rem}" +
        ".login-wrap input{width:100%;padding:10px;box-sizing:border-box;" +
        "border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink)}" +
        ".login-wrap button{margin-top:16px;width:100%;padding:10px 14px;cursor:pointer}" +
        ".login-wrap .hint,.login-wrap .alt{opacity:.85;margin-top:14px}" +
        ".login-wrap .ok{color:var(--accent)}</style>";
}

function askRenderLoginPage(errorMessage, noticeMessage) {
    var title = askProductName() + " — " + askT("Sign in", "Accedi");
    var err = str.trim(askAsText(errorMessage));
    var notice = str.trim(askAsText(noticeMessage));
    var errHtml = "";
    if (err != "") {
        errHtml = "<p class='flash error'>" + askEscapeHtml(err) + "</p>";
    }
    var noticeHtml = "";
    if (notice != "") {
        noticeHtml = "<p class='ok'>" + askEscapeHtml(notice) + "</p>";
    }
    var hint = "";
    if (ASK_AUTH_USING_DEFAULT_PASSWORD and askUsersCount() == 0) {
        hint = "<p class='hint'><small>" + askEscapeHtml(askT(
            "Bootstrap: admin / password",
            "Bootstrap: admin / password")) + "</small></p>";
    }
    var alt = "";
    if (ASK_ALLOW_REGISTER) {
        alt = "<p class='alt'><a href='/register'>" + askEscapeHtml(askT(
            "Create an account", "Crea un account")) + "</a></p>";
    }
    return "<!DOCTYPE html><html lang='" + askGetLang() + "' data-theme='" +
        askGetTheme() + "'><head>" +
        "<meta charset='utf-8'>" +
        "<meta name='viewport' content='width=device-width,initial-scale=1'>" +
        "<title>" + askEscapeHtml(title) + "</title>" +
        askPageStyles() + askAuthFormStyles() +
        "</head><body><main class='login-wrap'>" +
        "<h1>" + askEscapeHtml(title) + "</h1>" + noticeHtml + errHtml +
        "<form method='post' action='/login'>" +
        "<label for='username'>" + askEscapeHtml(askT("Username", "Utente")) + "</label>" +
        "<input id='username' name='username' autocomplete='username' required>" +
        "<label for='password'>" + askEscapeHtml(askT("Password", "Password")) + "</label>" +
        "<input id='password' name='password' type='password' autocomplete='current-password' required>" +
        "<button type='submit'>" + askEscapeHtml(askT("Sign in", "Accedi")) + "</button>" +
        "</form>" + hint + alt +
        "</main></body></html>";
}

function askRenderRegisterPage(errorMessage) {
    var title = askProductName() + " — " + askT("Create account", "Crea account");
    var err = str.trim(askAsText(errorMessage));
    var errHtml = "";
    if (err != "") {
        errHtml = "<p class='flash error'>" + askEscapeHtml(err) + "</p>";
    }
    return "<!DOCTYPE html><html lang='" + askGetLang() + "' data-theme='" +
        askGetTheme() + "'><head>" +
        "<meta charset='utf-8'>" +
        "<meta name='viewport' content='width=device-width,initial-scale=1'>" +
        "<title>" + askEscapeHtml(title) + "</title>" +
        askPageStyles() + askAuthFormStyles() +
        "</head><body><main class='login-wrap'>" +
        "<h1>" + askEscapeHtml(title) + "</h1>" + errHtml +
        "<form method='post' action='/register'>" +
        "<label for='username'>" + askEscapeHtml(askT("Username", "Utente")) + "</label>" +
        "<input id='username' name='username' autocomplete='username' required minlength='3' maxlength='128'>" +
        "<label for='password'>" + askEscapeHtml(askT("Password", "Password")) + "</label>" +
        "<input id='password' name='password' type='password' autocomplete='new-password' required minlength='6'>" +
        "<label for='password2'>" + askEscapeHtml(askT("Confirm password", "Conferma password")) + "</label>" +
        "<input id='password2' name='password2' type='password' autocomplete='new-password' required minlength='6'>" +
        "<button type='submit'>" + askEscapeHtml(askT("Register", "Registrati")) + "</button>" +
        "</form>" +
        "<p class='alt'><a href='/login'>" + askEscapeHtml(askT(
            "Back to sign in", "Torna al login")) + "</a></p>" +
        "</main></body></html>";
}

@PAGE("/login")
function askUiLoginPage(queryParams, response, cookies) {
    if (not ASK_AUTH_ENABLED) {
        return RedirectTo("/");
    }
    if (askAuthJwtSecret == "") {
        askLoadAuthCredentials();
    }
    askLoadThemeFromCookie(cookies);
    askSetThemeCookie(response, askGetTheme());
    var err = "";
    var notice = "";
    if (queryParams?["error"] != null) {
        err = askT("Invalid username or password.", "Utente o password non validi.");
    }
    if (queryParams?["registered"] != null) {
        notice = askT(
            "Account created. Sign in with your new credentials.",
            "Account creato. Accedi con le nuove credenziali.");
    }
    return askRenderLoginPage(err, notice);
}

@POST("/login")
function askUiLoginSubmit(req, res, body) {
    if (not ASK_AUTH_ENABLED) {
        return res.redirect("/");
    }
    if (askAuthJwtSecret == "" or ASK_AUTH_PASSWORD_HASH == "") {
        askLoadAuthCredentials();
    }
    var username = "";
    var password = "";
    if (body != null) {
        username = str.trim(askAsText(body.username));
        password = askAsText(body.password);
    }
    var verified = askVerifyLogin(username, password);
    if (verified == null or verified.ok != true) {
        askAudit("login_fail", req, { "username": username });
        return res.redirect("/login?error=1");
    }
    askIssueSessionCookie(res, verified.username, verified.role);
    askAudit("login", req, { "username": verified.username, "role": verified.role });
    return res.redirect("/");
}

@PAGE("/register")
function askUiRegisterPage(queryParams, response, cookies) {
    if (not ASK_AUTH_ENABLED or not ASK_ALLOW_REGISTER) {
        return RedirectTo("/login");
    }
    if (askAuthJwtSecret == "") {
        askLoadAuthCredentials();
    }
    askLoadThemeFromCookie(cookies);
    askSetThemeCookie(response, askGetTheme());
    return askRenderRegisterPage("");
}

@POST("/register")
function askUiRegisterSubmit(req, res, body) {
    if (not ASK_AUTH_ENABLED or not ASK_ALLOW_REGISTER) {
        return res.redirect("/login");
    }
    if (askAuthJwtSecret == "" or ASK_AUTH_PASSWORD_HASH == "") {
        askLoadAuthCredentials();
    }
    var username = "";
    var password = "";
    var password2 = "";
    if (body != null) {
        username = str.trim(askAsText(body.username));
        password = askAsText(body.password);
        password2 = askAsText(body.password2);
    }
    if (password != password2) {
        return askRenderRegisterPage(askT(
            "Passwords do not match.",
            "Le password non coincidono."));
    }
    var result = askRegisterUser(username, password);
    if (result == null or result.ok != true) {
        var msg = "";
        if (result != null) {
            msg = askAsText(result.error);
        }
        if (msg == "") {
            msg = askT("Registration failed.", "Registrazione fallita.");
        }
        return askRenderRegisterPage(msg);
    }
    askAudit("register", req, { "username": username });
    return res.redirect("/login?registered=1");
}

@GET("/logout")
function askUiLogout(req, res) {
    if (res != null) {
        res.clearCookie(ASK_AUTH_COOKIE);
    }
    if (req != null and req.session != null) {
        req.session.clear();
    }
    if (not ASK_AUTH_ENABLED) {
        return res.redirect("/");
    }
    return res.redirect("/login");
}

function askSharedScope() {
    return ASK_SESSION_ID;
}

function askConvScope() {
    var id = str.trim(askAsText(ASK_CONV_CURRENT));
    if (id == "") {
        return askSharedScope();
    }
    return id;
}

function askSanitizeScopeUser(sub) {
    var name = askNormalizeUsername(sub);
    if (name == "") {
        return "anon";
    }
    // Scope keys: keep username charset only (includes @ for email logins).
    if (not askIsValidUsername(name)) {
        var cleaned = "";
        var allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-.@";
        var i = 0;
        while (i < str.length(name) and str.length(cleaned) < 128) {
            var ch = str.substring(name, i, 1);
            if (str.indexOf(allowed, ch) >= 0) {
                cleaned = cleaned + ch;
            }
            i = i + 1;
        }
        if (cleaned == "") {
            return "user";
        }
        return cleaned;
    }
    return name;
}

// Per-user history when auth is on: u:{sub}:{convId}. --no-auth keeps conv-only scope.
function askHistoryScope(req) {
    if (ASK_AUTH_ENABLED and req != null and req.auth != null) {
        try {
            if (req.auth.verified == true) {
                var sub = str.trim(askAsText(req.auth.sub));
                if (sub != "") {
                    return "u:" + askSanitizeScopeUser(sub) + ":" + askConvScope();
                }
            }
        } catch (scopeErr) {
        }
    }
    return askConvScope();
}

function askActiveHistoryScope() {
    var s = str.trim(askAsText(ASK_HISTORY_CURRENT));
    if (s != "") {
        return s;
    }
    return askConvScope();
}

function askLiveChannel() {
    return "ask-" + askActiveHistoryScope();
}

function askCaptureAuthContext(req) {
    ASK_CURRENT_SUB = "";
    ASK_CURRENT_ROLE = "";
    ASK_CURRENT_IS_ADMIN = false;
    if (req == null or req.auth == null) {
        return;
    }
    try {
        if (req.auth.verified == true) {
            ASK_CURRENT_SUB = str.trim(askAsText(req.auth.sub));
            ASK_CURRENT_ROLE = str.trim(askAsText(req.auth.claim("role", "ask")));
            ASK_CURRENT_IS_ADMIN = req.auth.hasRole("admin");
        }
    } catch (ctxErr) {
    }
}

function askNormalizeConvId(raw) {
    var id = str.trim(askAsText(raw));
    if (str.length(id) < 8 or str.length(id) > 64) {
        return "";
    }
    var allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-";
    var i = 0;
    while (i < str.length(id)) {
        var ch = str.substring(id, i, 1);
        if (str.indexOf(allowed, ch) < 0) {
            return "";
        }
        i = i + 1;
    }
    return id;
}

function askMintConvId() {
    var hex = "0123456789abcdef";
    var id = "";
    var i = 0;
    while (i < 32) {
        id = id + str.substring(hex, math.randomInt(0, 15), 1);
        i = i + 1;
    }
    return id;
}

function askCookieGet(cookies, name) {
    if (cookies == null) {
        return "";
    }
    var key = str.trim(askAsText(name));
    if (key == "") {
        return "";
    }
    if (cookies[key] != null) {
        return askAsText(cookies[key]);
    }
    return "";
}

function askPickConvId(queryParams, body, cookies) {
    var id = "";
    if (queryParams != null and queryParams["c"] != null) {
        id = askNormalizeConvId(queryParams["c"]);
    }
    if (id == "" and body != null and body.c != null) {
        id = askNormalizeConvId(body.c);
    }
    if (id == "") {
        id = askNormalizeConvId(askCookieGet(cookies, ASK_CONV_COOKIE));
    }
    if (id == "") {
        id = askMintConvId();
    }
    return id;
}

function askSetConvCookie(response, id) {
    if (response == null) {
        return;
    }
    // Secure cookies only when ASK serves HTTPS (otherwise browsers drop them on http://).
    response.cookie(ASK_CONV_COOKIE, id, {
        "httpOnly": true,
        "secure": askCookieSecureFlag(),
        "sameSite": "Lax",
        "path": "/",
        "maxAge": 2592000
    });
}

function askNormalizeTheme(raw) {
    var theme = str.lower(str.trim(askAsText(raw)));
    if (theme == "dark" or theme == "scuro" or theme == "night") {
        return "dark";
    }
    if (theme == "light" or theme == "chiaro" or theme == "day") {
        return "light";
    }
    return "";
}

function askSetThemeCookie(response, theme) {
    if (response == null) {
        return;
    }
    var t = askNormalizeTheme(theme);
    if (t == "") {
        return;
    }
    // Not httpOnly: preference cookie is not secret; keep readable/writable by UI if needed.
    response.cookie(ASK_THEME_COOKIE, t, {
        "httpOnly": false,
        "secure": askCookieSecureFlag(),
        "sameSite": "Lax",
        "path": "/",
        "maxAge": 31536000
    });
}

function askLoadThemeFromCookie(cookies) {
    var fromCookie = askNormalizeTheme(askCookieGet(cookies, ASK_THEME_COOKIE));
    // Always refresh request cache (empty clears a prior request's value).
    ASK_THEME_CURRENT = fromCookie;
    if (fromCookie != "") {
        ui.setState(ASK_STORE, "theme", fromCookie, askActiveHistoryScope());
    }
    return fromCookie;
}

function askLoadThemeFromRequest(req) {
    if (req == null) {
        return "";
    }
    try {
        return askLoadThemeFromCookie(req.cookies);
    } catch (themeCookieErr) {
        return "";
    }
}

// Bind conversation id + per-user history scope for this request.
function askBeginRequest(queryParams, body, cookies, response, req) {
    var id = askPickConvId(queryParams, body, cookies);
    ASK_CONV_CURRENT = id;
    askSetConvCookie(response, id);
    askCaptureAuthContext(req);
    ASK_HISTORY_CURRENT = askHistoryScope(req);
    askLoadThemeFromCookie(cookies);
    askSetThemeCookie(response, askGetTheme());
    return id;
}

function askConvQuery(extra) {
    var q = "c=" + askConvScope();
    var more = str.trim(askAsText(extra));
    if (more != "") {
        if (str.startsWith(more, "&") or str.startsWith(more, "?")) {
            more = str.substring(more, 1, str.length(more) - 1);
        }
        if (more != "") {
            q = q + "&" + more;
        }
    }
    return q;
}

// First non-empty line of a utf-8 text file (disk or embed:). Empty if missing.
function askReadProductNameFile(path) {
    var p = str.trim(askAsText(path));
    if (p == "" or not io.hasFile(p)) {
        return "";
    }
    var text = io.readFile(p);
    if (text == null) {
        return "";
    }
    var lines = str.split(string(text), "\n");
    foreach (var line in lines) {
        // trim() also strips trailing CR from CRLF files.
        var n = str.trim(askAsText(line));
        if (n != "") {
            return n;
        }
    }
    return "";
}

function askLooksLikeProductNamePath(value) {
    var n = str.trim(askAsText(value));
    if (n == "") {
        return false;
    }
    if (str.startsWith(n, "embed:")) {
        return true;
    }
    if (str.endsWith(str.lower(n), ".txt")) {
        return true;
    }
    if (str.indexOf(n, "/") >= 0 or str.indexOf(n, "\\") >= 0) {
        return true;
    }
    return io.hasFile(n);
}

function askProductNameFromValue(raw) {
    var n = str.trim(askAsText(raw));
    if (n == "") {
        return "";
    }
    if (askLooksLikeProductNamePath(n)) {
        return askReadProductNameFile(n);
    }
    return n;
}

function askTitleSuffix() {
    return str.trim(askAsText(ASK_TITLE_SUFFIX));
}

// Host PRODUCT_NAME — literal display name, or path/embed: to a text file (empty => "Second brain").
function askProductName() {
    var cached = str.trim(askAsText(ui.state(ASK_STORE, "productName", "", ASK_SESSION_ID)));
    if (cached != "") {
        return cached;
    }
    var n = askProductNameFromValue(PRODUCT_NAME);
    if (n == "") {
        return "Second brain";
    }
    return n;
}

// Load brainDir/product_name.txt when present (disk or embed). Updates PRODUCT_NAME + title.
function askApplyProductNameFromBrain(brainDir) {
    var root = str.trim(askAsText(brainDir));
    var fromBrain = "";
    if (root != "") {
        fromBrain = askReadProductNameFile(io.pathJoin(root, "product_name.txt"));
    }
    var loaded = fromBrain;
    if (loaded == "") {
        loaded = askProductNameFromValue(PRODUCT_NAME);
    }
    if (loaded == "") {
        loaded = "Second brain";
    }
    var previous = askProductName();
    var suffix = askTitleSuffix();
    var title = str.trim(askAsText(ASK_PAGE_TITLE));
    // Brain file is branding source of truth; otherwise refresh title only if still default-shaped.
    var titleFollows = (fromBrain != "" or title == "" or title == previous + suffix);
    PRODUCT_NAME = loaded;
    ui.setState(ASK_STORE, "productName", loaded, ASK_SESSION_ID);
    if (titleFollows) {
        ASK_PAGE_TITLE = loaded + suffix;
    }
    return loaded;
}

function askEscapeHtml(value) {
    var s = askAsText(value);
    s = str.replace(s, "&", "&amp;");
    s = str.replace(s, "<", "&lt;");
    s = str.replace(s, ">", "&gt;");
    s = str.replace(s, "\"", "&quot;");
    s = str.replace(s, "'", "&#39;");
    return s;
}

function askHiddenConvField() {
    return "<input type='hidden' name='c' value='" + askEscapeHtml(askConvScope()) + "'>";
}

function askGetLang() {
    var lang = askAsText(ui.state(ASK_STORE, "lang", "", askActiveHistoryScope()));
    if (lang == "en" or lang == "it") {
        return lang;
    }
    return UI_LANG;
}

function askSetLang(raw) {
    var lang = str.lower(str.trim(askAsText(raw)));
    if (lang == "it" or lang == "italiano" or lang == "2") {
        ui.setState(ASK_STORE, "lang", "it", askActiveHistoryScope());
    } else if (lang == "en" or lang == "english" or lang == "1") {
        ui.setState(ASK_STORE, "lang", "en", askActiveHistoryScope());
    }
}

function askGetTheme() {
    if (ASK_THEME_CURRENT == "dark" or ASK_THEME_CURRENT == "light") {
        return ASK_THEME_CURRENT;
    }
    var theme = askNormalizeTheme(ui.state(ASK_STORE, "theme", "", askActiveHistoryScope()));
    if (theme != "") {
        return theme;
    }
    return "light";
}

function askSetTheme(raw) {
    var theme = askNormalizeTheme(raw);
    if (theme == "") {
        return;
    }
    ASK_THEME_CURRENT = theme;
    ui.setState(ASK_STORE, "theme", theme, askActiveHistoryScope());
}

function askT(en, it) {
    if (askGetLang() == "en") {
        return en;
    }
    return it;
}

function askGetHistory() {
    var history = ui.state(ASK_STORE, "history", [], askActiveHistoryScope());
    if (history == null) {
        return [];
    }
    return history;
}

function askSetHistory(history) {
    ui.setState(ASK_STORE, "history", history, askActiveHistoryScope());
}

function askGetFlashError() {
    return askAsText(ui.state(ASK_STORE, "flashError", "", askActiveHistoryScope()));
}

function askSetFlashError(message) {
    ui.setState(ASK_STORE, "flashError", askAsText(message), askActiveHistoryScope());
}

function askClearHistory() {
    askSetHistory([]);
    askSetFlashError("");
}

// Sticky per conversation (+ user when auth on): default off (faster, no tool loop).
function askGetToolsEnabled() {
    return ui.state(ASK_STORE, "toolsEnabled", false, askActiveHistoryScope()) == true;
}

function askSetToolsEnabled(enabled) {
    ui.setState(ASK_STORE, "toolsEnabled", enabled == true, askActiveHistoryScope());
}

function askGetTagFilter() {
    var tags = ui.state(ASK_STORE, "tagFilter", [], askActiveHistoryScope());
    if (tags == null) {
        return [];
    }
    return tags;
}

function askSetTagFilter(tags) {
    if (tags == null) {
        tags = [];
    }
    ui.setState(ASK_STORE, "tagFilter", tags, askActiveHistoryScope());
}

function askApplyTagFilterFromBody(body) {
    var next = [];
    if (body != null and body.tags != null) {
        var raw = body.tags;
        // Form checkboxes often arrive as a string (or as an array when several
        // share name="tags"). Do not use `.length != null` — strings have length too,
        // and foreach requires a real array.
        if (typeOf(raw) == "array") {
            foreach (var t in raw) {
                var s = str.trim(askAsText(t));
                if (s != "") {
                    next.append(s);
                }
            }
        } else {
            var one = str.trim(askAsText(raw));
            if (one != "") {
                // comma-separated fallback
                var parts = str.split(one, ",");
                foreach (var p in parts) {
                    var s2 = str.trim(askAsText(p));
                    if (s2 != "") {
                        next.append(s2);
                    }
                }
            }
        }
    }
    askSetTagFilter(next);
}

function askWeakRetrievalMessage() {
    return askT(
        "I could not find notes relevant enough for this question. Try rephrasing, clearing tag filters, or enable Force answer.",
        "Non ho trovato note abbastanza rilevanti per questa domanda. Prova a riformulare, togliere i filtri tag, oppure attiva Forza risposta.");
}

function askGetForceAnswer() {
    return ui.state(ASK_STORE, "forceAnswer", false, askActiveHistoryScope()) == true;
}

function askNoteMatchesTagFilter(note, tags) {
    if (tags == null or tags.length == 0) {
        return true;
    }
    if (note == null) {
        return false;
    }
    var hay = [];
    if (note.tags != null) {
        foreach (var t in note.tags) {
            hay.append(str.lower(str.trim(askAsText(t))));
        }
    }
    var cat = str.lower(str.trim(askAsText(note.category)));
    if (cat != "") {
        hay.append(cat);
    }
    var topic = str.lower(str.trim(askAsText(note.topic)));
    if (topic != "") {
        hay.append(topic);
    }
    foreach (var want in tags) {
        var w = str.lower(str.trim(askAsText(want)));
        if (w == "") {
            continue;
        }
        var hit = false;
        foreach (var h in hay) {
            if (h == w) {
                hit = true;
            }
        }
        if (hit) {
            return true;
        }
    }
    return false;
}

function askSetForceAnswer(enabled) {
    ui.setState(ASK_STORE, "forceAnswer", enabled == true, askActiveHistoryScope());
}

function askApplyForceAnswerFromBody(body) {
    var raw = "";
    if (body != null and body.forceAnswer != null) {
        raw = str.lower(str.trim(askAsText(body.forceAnswer)));
    }
    askSetForceAnswer(raw == "1" or raw == "on" or raw == "true" or raw == "yes");
}

function askApplyToolsFromBody(body) {
    // HTML checkbox: present when checked, absent when unchecked.
    var raw = "";
    if (body != null and body.useTools != null) {
        raw = str.lower(str.trim(askAsText(body.useTools)));
    }
    askSetToolsEnabled(raw == "1" or raw == "on" or raw == "true" or raw == "yes");
}

function askNormalizeAskMode(raw) {
    var s = str.lower(str.trim(askAsText(raw)));
    if (s == "generate" or s == "document" or s == "doc") {
        return "generate";
    }
    return "ask";
}

function askGetAskMode() {
    return askNormalizeAskMode(ui.state(ASK_STORE, "askMode", "ask", askActiveHistoryScope()));
}

function askSetAskMode(mode) {
    ui.setState(ASK_STORE, "askMode", askNormalizeAskMode(mode), askActiveHistoryScope());
}

function askApplyAskModeFromBody(body) {
    var raw = "ask";
    if (body != null and body.askMode != null) {
        raw = askAsText(body.askMode);
    }
    askSetAskMode(raw);
}

function askFirstMarkdownHeading(markdown) {
    var lines = str.split(askAsText(markdown), "\n");
    foreach (var line in lines) {
        var heading = str.trim(askAsText(line));
        if (str.startsWith(heading, "# ")) {
            return str.trim(str.substring(heading, 2, str.length(heading) - 2));
        }
    }
    return "";
}

function askSanitizeDownloadFilename(raw) {
    var s = str.lower(str.trim(askAsText(raw)));
    if (s == "") {
        return "document";
    }
    if (str.endsWith(s, ".html")) {
        s = str.substring(s, 0, str.length(s) - 5);
    } else if (str.endsWith(s, ".htm")) {
        s = str.substring(s, 0, str.length(s) - 4);
    } else if (str.endsWith(s, ".md")) {
        s = str.substring(s, 0, str.length(s) - 3);
    }
    var allowed = "abcdefghijklmnopqrstuvwxyz0123456789";
    var out = "";
    var lastDash = false;
    var i = 0;
    while (i < str.length(s) and str.length(out) < 60) {
        var ch = str.substring(s, i, 1);
        if (str.indexOf(allowed, ch) >= 0) {
            out = out + ch;
            lastDash = false;
        } else if (not lastDash) {
            out = out + "-";
            lastDash = true;
        }
        i = i + 1;
    }
    while (str.startsWith(out, "-")) {
        out = str.substring(out, 1, str.length(out) - 1);
    }
    while (str.endsWith(out, "-")) {
        out = str.substring(out, 0, str.length(out) - 1);
    }
    if (out == "") {
        return "document";
    }
    return out;
}

function askSuggestDocumentFilename(question, answer) {
    var heading = askFirstMarkdownHeading(answer);
    var base = heading;
    if (base == "") {
        base = str.trim(askAsText(question));
    }
    return askSanitizeDownloadFilename(base);
}

function askMarkGeneratedTurn(turn, question) {
    if (turn == null) {
        return null;
    }
    if (str.trim(askAsText(turn.error)) != "") {
        return turn;
    }
    if (str.trim(askAsText(turn.answer)) == "") {
        return turn;
    }
    if (turn.weakRetrieval == true) {
        return turn;
    }
    turn.generated = true;
    if (str.trim(askAsText(turn.filename)) == "") {
        turn.filename = askSuggestDocumentFilename(question, turn.answer);
    } else {
        turn.filename = askSanitizeDownloadFilename(turn.filename);
    }
    return turn;
}

function askNormalizeDownloadFormat(raw) {
    var s = str.lower(str.trim(askAsText(raw)));
    if (s == "md" or s == "markdown" or s == ".md") {
        return "md";
    }
    if (s == "html" or s == "htm" or s == ".html" or s == ".htm") {
        return "html";
    }
    return "";
}

function askWrapGeneratedHtml(title, markdown) {
    var name = askEscapeHtml(askAsText(title));
    if (name == "") {
        name = "Document";
    }
    var lang = askGetLang();
    if (lang != "en" and lang != "it") {
        lang = "en";
    }
    var body = markdownToHtml(askAsText(markdown));
    return "<!DOCTYPE html><html lang='" + lang + "'><head><meta charset='utf-8'>" +
        "<meta name='viewport' content='width=device-width, initial-scale=1'>" +
        "<title>" + name + "</title>" +
        "<style>body{font-family:Georgia,'Times New Roman',serif;max-width:42rem;" +
        "margin:2rem auto;padding:0 1rem;line-height:1.55;color:#1c2430}" +
        "h1,h2,h3{font-family:system-ui,sans-serif}table{border-collapse:collapse;width:100%}" +
        "th,td{border:1px solid #d5dde6;padding:6px 8px;text-align:left}" +
        "@media print{body{margin:0}}</style></head><body>" + body + "</body></html>";
}

function askBuildGeneratedDownload(turn, fmt) {
    var format = askNormalizeDownloadFormat(fmt);
    if (format == "") {
        return {
            "ok": false,
            "filename": "",
            "contentType": "",
            "body": "",
            "error": "Invalid format."
        };
    }
    if (turn == null or turn.generated != true) {
        return {
            "ok": false,
            "filename": "",
            "contentType": "",
            "body": "",
            "error": "No generated document."
        };
    }
    var markdown = askAsText(turn.answer);
    if (str.trim(markdown) == "" or str.trim(askAsText(turn.error)) != "") {
        return {
            "ok": false,
            "filename": "",
            "contentType": "",
            "body": "",
            "error": "Empty document."
        };
    }
    var base = askSanitizeDownloadFilename(turn.filename);
    if (base == "document") {
        base = askSuggestDocumentFilename(turn.question, markdown);
    }
    if (format == "html") {
        return {
            "ok": true,
            "filename": base + ".html",
            "contentType": "text/html; charset=utf-8",
            "body": askWrapGeneratedHtml(base, markdown),
            "error": ""
        };
    }
    return {
        "ok": true,
        "filename": base + ".md",
        "contentType": "text/markdown; charset=utf-8",
        "body": markdown,
        "error": ""
    };
}

function askAppendTurn(turn) {
    // Rebuild + setState (do not rely on in-place mutation of ui.state arrays).
    var history = askGetHistory();
    var next = [];
    var i = 0;
    while (i < history.length) {
        next.append(history[i]);
        i = i + 1;
    }
    next.append(turn);
    askSetHistory(next);
}

function askConfigureSharedStore() {
    // Conversation scopes create many unpinned entries; keep headroom. Shared
    // brain meta is also ui.pinState'd so LRU/TTL cannot drop it.
    if (ASK_SHARED_STORE_CONFIGURED) {
        return;
    }
    componentStateConfigure(4096, 256, 86400000);
    ASK_SHARED_STORE_CONFIGURED = true;
}

function askPinSharedStore() {
    askConfigureSharedStore();
    ui.pinState(ASK_STORE, ASK_SESSION_ID);
}

function askGetSession() {
    var session = ui.getState(ASK_STORE, "session", null, ASK_SESSION_ID);
    if (session == null) {
        return {};
    }
    return session;
}

function askSetSession(session) {
    askPinSharedStore();
    ui.setState(ASK_STORE, "session", session, ASK_SESSION_ID);
}

function askGetCatalog() {
    return ui.getState(ASK_STORE, "catalog", null, ASK_SESSION_ID);
}

function askSetCatalog(catalog) {
    askPinSharedStore();
    ui.setState(ASK_STORE, "catalog", catalog, ASK_SESSION_ID);
}

function askMetaCount(value) {
    if (value == null) {
        return "0";
    }
    return string(value);
}

function askIsChatOnly() {
    var session = askGetSession();
    return session != null and session.chatOnly == true;
}

function askSourceScoreLabel(note) {
    if (note == null) {
        return "";
    }
    if (note.scoreHint != null and askAsText(note.scoreHint) != "") {
        return askAsText(note.scoreHint);
    }
    if (note.score != null) {
        return askAsText(note.score);
    }
    return "";
}

function askRenderSourcesHtml(sources) {
    if (sources == null or sources.length == 0) {
        if (askIsChatOnly()) {
            return "<p class='muted'>" + askEscapeHtml(askT(
                "Direct chat — no " + askProductName() + " notes used.",
                "Chat diretta — nessuna nota di " + askProductName() + " usata.")) + "</p>";
        }
        return "<p class='muted'>" + askEscapeHtml(askT(
            "No notes retrieved for this question.",
            "Nessuna nota recuperata per questa domanda.")) + "</p>";
    }
    var html = "<div class='sources-chips' role='list'>";
    foreach (var note in sources) {
        var score = askSourceScoreLabel(note);
        var scoreHtml = "";
        if (score != "") {
            scoreHtml = "<span class='score-pill'>" + askEscapeHtml(score) + "</span>";
        }
        var tip = askAsText(note.slug);
        if (note.source != null and askAsText(note.source) != "") {
            if (tip != "") {
                tip = tip + " · ";
            }
            tip = tip + askT("source:", "origine:") + " " + askAsText(note.source);
        }
        var tipAttr = "";
        if (tip != "") {
            tipAttr = " title='" + askEscapeHtml(tip) + "'";
        }
        html = html + "<div class='source-chip' role='listitem'" + tipAttr + ">" +
            "<div class='source-chip-body'>" +
            "<div class='source-chip-title'>" + askEscapeHtml(note.title) + "</div>" +
            "<div class='path'>" + askEscapeHtml(note.path) + "</div>" +
            "</div>" + scoreHtml + "</div>";
    }
    html = html + "</div>";
    return html;
}

function askRenderDownloadBarHtml(turn, index) {
    if (turn == null or turn.generated != true) {
        return "";
    }
    if (str.trim(askAsText(turn.answer)) == "" or str.trim(askAsText(turn.error)) != "") {
        return "";
    }
    var href = "/generate/download?" + askConvQuery("turn=" + string(index));
    return "<div class='download-bar'>" +
        "<a href='" + askEscapeHtml(href + "&fmt=md") + "' download>" +
        askEscapeHtml(askT("Download Markdown", "Scarica Markdown")) + "</a>" +
        "<a href='" + askEscapeHtml(href + "&fmt=html") + "' download>" +
        askEscapeHtml(askT("Download HTML", "Scarica HTML")) + "</a>" +
        "</div>" +
        "<p class='download-hint'>" +
        askEscapeHtml(askT(
            "HTML opens in the browser — use Print to save a PDF.",
            "L'HTML si apre nel browser: usa Stampa per salvare un PDF.")) +
        "</p>";
}

function askRenderModePillsHtml() {
    var mode = askGetAskMode();
    var askChecked = "";
    var genChecked = "";
    if (mode == "generate") {
        genChecked = " checked";
    } else {
        askChecked = " checked";
    }
    return "<div class='mode-pills' role='radiogroup' aria-label='" +
        askEscapeHtml(askT("Mode", "Modalita'")) + "'>" +
        "<label class='mode-pill'><input type='radio' name='askMode' value='ask'" +
        askChecked + "><span>" + askEscapeHtml(askT("Ask", "Chiedi")) +
        "</span></label>" +
        "<label class='mode-pill'><input type='radio' name='askMode' value='generate'" +
        genChecked + "><span>" + askEscapeHtml(askT("Generate document", "Genera documento")) +
        "</span></label></div>";
}

function askRenderTurnHtml(turn, index) {
    var question = askAsText(turn.question);
    var answer = askAsText(turn.answer);
    var error = askAsText(turn.error);
    var pending = turn.pending == true;
    var sources = turn.sources;
    if (sources == null) {
        sources = [];
    }

    var generated = turn.generated == true;
    var qLabel = askT("Question", "Domanda");
    var aLabel = askT("Answer", "Risposta");
    var pendingMsg = askT(
        "Generating answer… keep this tab open. Live tool/LLM rounds appear here and above the Ask box.",
        "Sto generando la risposta… lascia aperta questa scheda. I round LLM/tool compaiono qui e sopra il box Chiedi.");
    if (generated or (pending and askGetAskMode() == "generate")) {
        qLabel = askT("Request", "Richiesta");
        aLabel = askT("Document", "Documento");
        pendingMsg = askT(
            "Generating document… keep this tab open. Live tool/LLM rounds appear here and above the composer.",
            "Sto generando il documento… lascia aperta questa scheda. I round LLM/tool compaiono qui e sopra il composer.");
    }

    var html = "<article class='turn' id='turn-" + string(index) + "'>";
    html = html + "<div class='bubble q'><div class='bubble-label'>" +
        askEscapeHtml(qLabel) + "</div>" +
        "<p class='question-text'>" + askEscapeHtml(question) + "</p></div>";

    if (pending) {
        html = html + "<div class='bubble a'><div class='bubble-label'>" +
            askEscapeHtml(aLabel) + "</div>" +
            "<p class='pending'>" + askEscapeHtml(pendingMsg) +
            "</p>" +
            "<p class='live-status' id='ask-live-status' aria-live='polite'>" +
            askEscapeHtml(askT("Waiting for the model…", "In attesa del modello…")) +
            "</p></div>";
    } else if (error != "") {
        html = html + "<div class='bubble a error-bubble'><p class='error'>" +
            askEscapeHtml(error) + "</p></div>";
    } else {
        html = html + "<div class='bubble a'><div class='bubble-label'>" +
            askEscapeHtml(aLabel) + "</div>" +
            "<div class='answer md'>" + markdownToHtml(answer) + "</div>" +
            askRenderDownloadBarHtml(turn, index) +
            "<div class='sources-block'>" +
            "<div class='sources-label'>" +
            askEscapeHtml(askT("Sources", "Fonti")) +
            " <span class='meta'>(" + string(sources.length) + ")</span></div>" +
            askRenderSourcesHtml(sources) + "</div>" +
            "<div class='feedback-bar'>" +
            "<form method='post' action='/feedback' class='feedback-form'>" +
            askHiddenConvField() +
            "<input type='hidden' name='turnIndex' value='" + string(index) + "'>" +
            "<button type='submit' name='vote' value='up' class='ghost' title='" +
            askEscapeHtml(askT("Helpful", "Utile")) + "'>👍</button>" +
            "<button type='submit' name='vote' value='down' class='ghost' title='" +
            askEscapeHtml(askT("Not helpful", "Non utile")) + "'>👎</button>" +
            "</form></div></div>";
    }
    html = html + "</article>";
    return html;
}

// Normalize a height token ("72", "72px") to a clamped px int string, or "".
function askNormalizeLogoRightHeightToken(raw) {
    var s = str.trim(askAsText(raw));
    if (s == "") {
        return "";
    }
    var lower = str.lower(s);
    if (str.endsWith(lower, "px")) {
        s = str.trim(str.substring(s, 0, str.length(s) - 2));
    }
    var n = toIntOrNull(s);
    if (n == null) {
        return "";
    }
    if (n < 8) {
        n = 8;
    }
    if (n > 256) {
        n = 256;
    }
    return string(n);
}

function askLogoRightHeightFromValue(raw) {
    var n = str.trim(askAsText(raw));
    if (n == "") {
        return "";
    }
    if (askLooksLikeProductNamePath(n)) {
        return askReadProductNameFile(n);
    }
    return n;
}

// Host ASK_LOGO_RIGHT_HEIGHT may be omitted in older harnesses.
function askLogoRightHeightHostRaw() {
    try {
        return ASK_LOGO_RIGHT_HEIGHT;
    } catch (missing) {
        return "";
    }
}

function askLogoRightHeightHostSet(value) {
    try {
        ASK_LOGO_RIGHT_HEIGHT = value;
        return true;
    } catch (missing) {
        return false;
    }
}

// Prefer brainDir/logo_right_height.txt (disk or embed). Else host value / path file.
function askApplyLogoRightHeightFromBrain(brainDir) {
    var root = str.trim(askAsText(brainDir));
    var fromBrain = "";
    if (root != "") {
        fromBrain = askReadProductNameFile(io.pathJoin(root, "logo_right_height.txt"));
    }
    var loaded = fromBrain;
    if (loaded == "") {
        loaded = askLogoRightHeightFromValue(askLogoRightHeightHostRaw());
    }
    var normalized = askNormalizeLogoRightHeightToken(loaded);
    if (normalized == "") {
        return "48";
    }
    askLogoRightHeightHostSet(normalized);
    return normalized;
}

// CSS height for .logo-right from host ASK_LOGO_RIGHT_HEIGHT (default 48px).
function askLogoRightHeightCss() {
    var host = askLogoRightHeightHostRaw();
    var n = askNormalizeLogoRightHeightToken(askLogoRightHeightFromValue(host));
    if (n == "") {
        n = askNormalizeLogoRightHeightToken(host);
    }
    if (n == "") {
        return "48px";
    }
    return n + "px";
}

function askPageStyles() {
    var logoRightH = askLogoRightHeightCss();
    return "<style>" +
        ":root,:root[data-theme=light]{--ink:#1c2430;--muted:#5c6b7a;--line:#d5dde6;--paper:#f7f4ef;" +
