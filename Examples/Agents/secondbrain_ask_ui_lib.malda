}

@POST("/admin/users/role")
function askUiAdminSetRole(req, res, body) {
    if (not askRequireAdmin(req, res)) {
        return "";
    }
    var username = "";
    var role = "";
    if (body != null) {
        username = askAsText(body.username);
        role = askAsText(body.role);
    }
    var result = askSetUserRole(username, role);
    askAudit("admin_set_role", req, { "username": username, "role": role, "ok": result.ok });
    if (result.ok != true) {
        return askRenderAdminUsersPage(result.error);
    }
    return res.redirect("/admin/users");
}

