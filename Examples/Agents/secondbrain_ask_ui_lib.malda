        "--ui:system-ui,-apple-system,Segoe UI,sans-serif;" +
        "--serif:Georgia,'Times New Roman',serif}" +
        ":root[data-theme=dark]{--ink:#e8eef4;--muted:#9aabba;--line:#2f3b48;--paper:#121820;" +
        "--panel:#1a222c;--surface:#222b36;--surface-2:#1e2630;--chip:#243038;" +
        "--accent:#3d9b88;--accent-ink:#a8e0d4;--accent-strong:#2d7a6b;--accent-line:#2f5a50;--pill:#1e3a35;" +
        "--warn:#e0b060;--danger:#e08080;--focus:#2a5a52;--q-bg:#1e3330;" +
        "--sticky-bg:rgba(18,24,32,0.92);--hover:rgba(61,155,136,0.14);" +
        "--error-bg:#3a2222;--error-border:#6a3a3a;--live-bg:#1e3330;" +
        "--switch-off:#3a4654;--switch-off-border:#4a5664;--knob:#e8eef4;" +
        "--shadow:rgba(0,0,0,0.4);--shadow-soft:rgba(0,0,0,0.28);" +
        "--body-glow:#1a2e28;--body-a:#0f141a;--body-b:#121820;--body-c:#151c24;" +
        "--btn-fg:#061510}" +
        "*{box-sizing:border-box}" +
        "html{scroll-behavior:smooth;color-scheme:light}" +
        "html[data-theme=dark]{color-scheme:dark}" +
        "body{margin:0;font-family:var(--ui);color:var(--ink);" +
        "background:radial-gradient(1200px 500px at 10% -10%,var(--body-glow) 0%,transparent 55%)," +
        "linear-gradient(180deg,var(--body-a),var(--body-b) 40%,var(--body-c));min-height:100vh;" +
        "overflow-x:clip}" +
        "main{max-width:760px;width:100%;margin:0 auto;padding:0 18px 48px;" +
        "padding-left:max(18px,env(safe-area-inset-left));" +
        "padding-right:max(18px,env(safe-area-inset-right));" +
        "padding-bottom:max(48px,env(safe-area-inset-bottom))}" +
        /* Widen for logos on desktop only — fit-content overflows phones. */
        "@media (min-width:641px){main.has-logo{width:fit-content;min-width:min(760px,100%);max-width:100%}}" +
        ".sticky-header{position:sticky;top:0;z-index:20;padding:14px 0 10px;" +
        "margin:0 -18px;padding-left:max(18px,env(safe-area-inset-left));" +
        "padding-right:max(18px,env(safe-area-inset-right));" +
        "padding-top:max(14px,env(safe-area-inset-top));" +
        "background:var(--sticky-bg);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);" +
        "border-bottom:1px solid var(--line)}" +
        ".sticky-header-inner{display:flex;justify-content:space-between;gap:16px;" +
        "align-items:flex-start;flex-wrap:wrap}" +
        /* Brand grid: left logo shares row 1 with title+right logo (vertical center);
           powered-by is row 2 under the product name only (not under the left logo).
           min-width:0 lets the flex/grid row shrink on narrow viewports. */
        ".brand{display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto;" +
        "column-gap:12px;row-gap:4px;align-items:center;min-width:0;flex:1 1 12rem}" +
