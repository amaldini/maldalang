// secondbrain_ask_ui_lib.malda - shared ASK web UI for secondbrain*.malda
//
// Included by the host program. Host must define:
//   ASK_HTTP_PORT, ASK_SESSION_ID, ASK_STORE  (vars)
//   PRODUCT_NAME                             (display name, OR path/embed: to a utf-8 text file)
//   ASK_TITLE_SUFFIX                         (e.g. " — ASK"; used when refreshing title from file)
//   ASK_PAGE_TITLE, ASK_POWERED_BY, ASK_POWERED_BY_URL  (header branding)
//   ASK_LOGO  (optional header logo: "", file path, embed:..., http(s):, or data:)
//   askHttpServer                            (var, initially null)
//   runAskTurn(question) -> { question, answer, sources, error }
//   UI_LANG                                  (existing)
//
// Brain branding file (disk or embed root): product_name.txt — first non-empty line.
// Hosts should call askApplyProductNameFromBrain(brainDir) after resolving the brain root.
//
// HttpServer isolates each request: session fields live in ui.state.
// Ask / Clear use @ACTION + componentFragment("ask-panel", ...) so the
// HttpServer AJAX helper patches only #ask-panel (header/meta stay mounted).
// Live LLM/tool progress uses @LIVE + componentLiveEmit (SSE) because the
// POST /ask connection stays blocked until the answer is ready.

function askAsText(value) {
    if (value == null) {
        return "";
    }
    return string(value);
}

// First non-empty line of a utf-8 text file (disk or embed:). Empty if missing.
function askReadProductNameFile(path) {
    var p = str.trim(askAsText(path));
    if (p == "" or not io.hasFile(p)) {
        return "";
    }
    var text = io.readFile(p);
    if (text == null) {
        return "";
    }
    var lines = str.split(string(text), "\n");
    foreach (var line in lines) {
        // trim() also strips trailing CR from CRLF files.
        var n = str.trim(askAsText(line));
        if (n != "") {
            return n;
        }
    }
    return "";
}

function askLooksLikeProductNamePath(value) {
    var n = str.trim(askAsText(value));
    if (n == "") {
        return false;
    }
    if (str.startsWith(n, "embed:")) {
        return true;
    }
    if (str.endsWith(str.lower(n), ".txt")) {
        return true;
    }
    if (str.indexOf(n, "/") >= 0 or str.indexOf(n, "\\") >= 0) {
        return true;
    }
    return io.hasFile(n);
}

function askProductNameFromValue(raw) {
    var n = str.trim(askAsText(raw));
    if (n == "") {
        return "";
    }
    if (askLooksLikeProductNamePath(n)) {
        return askReadProductNameFile(n);
    }
    return n;
}

function askTitleSuffix() {
    var suffix = str.trim(askAsText(ASK_TITLE_SUFFIX));
    if (suffix == "") {
        return " — ASK";
    }
    return suffix;
}

// Host PRODUCT_NAME — literal display name, or path/embed: to a text file (empty => "Second brain").
function askProductName() {
    var cached = str.trim(askAsText(ui.state(ASK_STORE, "productName", "", ASK_SESSION_ID)));
    if (cached != "") {
        return cached;
    }
    var n = askProductNameFromValue(PRODUCT_NAME);
    if (n == "") {
        return "Second brain";
    }
    return n;
}

// Load brainDir/product_name.txt when present (disk or embed). Updates PRODUCT_NAME + title.
function askApplyProductNameFromBrain(brainDir) {
    var root = str.trim(askAsText(brainDir));
    var fromBrain = "";
    if (root != "") {
        fromBrain = askReadProductNameFile(io.pathJoin(root, "product_name.txt"));
    }
    var loaded = fromBrain;
    if (loaded == "") {
        loaded = askProductNameFromValue(PRODUCT_NAME);
    }
    if (loaded == "") {
        loaded = "Second brain";
    }
    var previous = askProductName();
    var suffix = askTitleSuffix();
    var title = str.trim(askAsText(ASK_PAGE_TITLE));
    // Brain file is branding source of truth; otherwise refresh title only if still default-shaped.
    var titleFollows = (fromBrain != "" or title == "" or title == previous + suffix);
    PRODUCT_NAME = loaded;
    ui.setState(ASK_STORE, "productName", loaded, ASK_SESSION_ID);
    if (titleFollows) {
        ASK_PAGE_TITLE = loaded + suffix;
    }
    return loaded;
}

function askEscapeHtml(value) {
    var s = askAsText(value);
    s = str.replace(s, "&", "&amp;");
    s = str.replace(s, "<", "&lt;");
    s = str.replace(s, ">", "&gt;");
    s = str.replace(s, "\"", "&quot;");
    s = str.replace(s, "'", "&#39;");
    return s;
}

function askGetLang() {
    var lang = askAsText(ui.state(ASK_STORE, "lang", "", ASK_SESSION_ID));
    if (lang == "en" or lang == "it") {
        return lang;
    }
    return UI_LANG;
}

function askSetLang(raw) {
    var lang = str.lower(str.trim(askAsText(raw)));
    if (lang == "it" or lang == "italiano" or lang == "2") {
        ui.setState(ASK_STORE, "lang", "it", ASK_SESSION_ID);
        UI_LANG = "it";
    } else if (lang == "en" or lang == "english" or lang == "1") {
        ui.setState(ASK_STORE, "lang", "en", ASK_SESSION_ID);
        UI_LANG = "en";
    }
}

function askT(en, it) {
    if (askGetLang() == "en") {
        return en;
    }
    return it;
}

function askGetHistory() {
    var history = ui.state(ASK_STORE, "history", [], ASK_SESSION_ID);
    if (history == null) {
        return [];
    }
    return history;
}

function askSetHistory(history) {
    ui.setState(ASK_STORE, "history", history, ASK_SESSION_ID);
}

function askGetFlashError() {
    return askAsText(ui.state(ASK_STORE, "flashError", "", ASK_SESSION_ID));
}

function askSetFlashError(message) {
    ui.setState(ASK_STORE, "flashError", askAsText(message), ASK_SESSION_ID);
}

function askClearHistory() {
    askSetHistory([]);
    askSetFlashError("");
}

// Sticky for the ASK session: default off (faster, no tool loop).
function askGetToolsEnabled() {
    return ui.state(ASK_STORE, "toolsEnabled", false, ASK_SESSION_ID) == true;
}

function askSetToolsEnabled(enabled) {
    ui.setState(ASK_STORE, "toolsEnabled", enabled == true, ASK_SESSION_ID);
}

function askApplyToolsFromBody(body) {
    // HTML checkbox: present when checked, absent when unchecked.
    var raw = "";
    if (body != null and body.useTools != null) {
        raw = str.lower(str.trim(askAsText(body.useTools)));
    }
    askSetToolsEnabled(raw == "1" or raw == "on" or raw == "true" or raw == "yes");
}

function askAppendTurn(turn) {
    // Rebuild + setState (do not rely on in-place mutation of ui.state arrays).
    var history = askGetHistory();
    var next = [];
    var i = 0;
    while (i < history.length) {
        next.append(history[i]);
        i = i + 1;
    }
    next.append(turn);
    askSetHistory(next);
}

function askGetSession() {
    return ui.state(ASK_STORE, "session", {}, ASK_SESSION_ID);
}

function askSetSession(session) {
    ui.setState(ASK_STORE, "session", session, ASK_SESSION_ID);
}

function askIsChatOnly() {
    var session = askGetSession();
    return session != null and session.chatOnly == true;
}

function askRenderSourcesHtml(sources) {
    if (sources == null or sources.length == 0) {
        if (askIsChatOnly()) {
            return "<p class='muted'>" + askEscapeHtml(askT(
                "Direct chat — no " + askProductName() + " notes used.",
                "Chat diretta — nessuna nota di " + askProductName() + " usata.")) + "</p>";
        }
        return "<p class='muted'>" + askEscapeHtml(askT(
            "No notes retrieved for this question.",
            "Nessuna nota recuperata per questa domanda.")) + "</p>";
    }
    var html = "<ul class='sources'>";
    foreach (var note in sources) {
        var scoreBit = "";
        if (note.scoreHint != null and askAsText(note.scoreHint) != "") {
            scoreBit = " · <span class='meta'>" + askEscapeHtml(note.scoreHint) + "</span>";
        } else if (note.score != null) {
            scoreBit = " · <span class='meta'>score " + askEscapeHtml(string(note.score)) + "</span>";
        }
        html = html + "<li><strong>" + askEscapeHtml(note.title) + "</strong>" +
            " <span class='slug'>[" + askEscapeHtml(note.slug) + "]</span>" +
            "<br><span class='path'>" + askEscapeHtml(note.path) + "</span>" +
            " · <span class='meta'>" + askEscapeHtml(askT("source:", "origine:")) + " " +
            askEscapeHtml(note.source) + "</span>" + scoreBit + "</li>";
    }
    html = html + "</ul>";
    return html;
}

function askRenderTurnHtml(turn, index) {
    var question = askAsText(turn.question);
    var answer = askAsText(turn.answer);
    var error = askAsText(turn.error);
    var pending = turn.pending == true;
    var sources = turn.sources;
    if (sources == null) {
        sources = [];
    }

    var html = "<article class='turn' id='turn-" + string(index) + "'>";
    html = html + "<div class='bubble q'><div class='bubble-label'>" +
        askEscapeHtml(askT("Question", "Domanda")) + "</div>" +
        "<p class='question-text'>" + askEscapeHtml(question) + "</p></div>";

    if (pending) {
        html = html + "<div class='bubble a'><div class='bubble-label'>" +
            askEscapeHtml(askT("Answer", "Risposta")) + "</div>" +
            "<p class='pending'>" + askEscapeHtml(askT(
                "Generating answer… keep this tab open. Live tool/LLM rounds appear below.",
                "Sto generando la risposta… lascia aperta questa scheda. I round LLM/tool compaiono sotto.")) +
            "</p>" +
            "<p class='live-status' id='ask-live-status' aria-live='polite'>" +
            askEscapeHtml(askT("Waiting for the model…", "In attesa del modello…")) +
            "</p></div>";
    } else if (error != "") {
        html = html + "<div class='bubble a error-bubble'><p class='error'>" +
            askEscapeHtml(error) + "</p></div>";
    } else {
        html = html + "<div class='bubble a'><div class='bubble-label'>" +
            askEscapeHtml(askT("Answer", "Risposta")) + "</div>" +
            "<div class='answer md'>" + markdownToHtml(answer) + "</div>" +
            "<details class='sources-details'><summary>" +
            askEscapeHtml(askT("Sources", "Fonti")) + " (" + string(sources.length) + ")</summary>" +
            askRenderSourcesHtml(sources) + "</details></div>";
    }
    html = html + "</article>";
    return html;
}

function askPageStyles() {
    return "<style>" +
        ":root{--ink:#1c2430;--muted:#5c6b7a;--line:#d5dde6;--paper:#f7f4ef;" +
        "--panel:#fffdf9;--accent:#0f6a5b;--accent-ink:#083f38;--warn:#8a5a12;" +
        "--danger:#8b2e2e;--focus:#c9e7e1;--q-bg:#e8f2ef;--sticky-bg:rgba(247,244,239,0.92)}" +
        "*{box-sizing:border-box}" +
        "html{scroll-behavior:smooth}" +
        "body{margin:0;font-family:Georgia,'Times New Roman',serif;color:var(--ink);" +
        "background:radial-gradient(1200px 500px at 10% -10%,#e7efe9 0%,transparent 55%)," +
        "linear-gradient(180deg,#eef2f5,#f7f4ef 40%,#f3efe8);min-height:100vh}" +
        "main{max-width:760px;width:100%;margin:0 auto;padding:0 18px 48px}" +
        "main.has-logo{width:fit-content;min-width:min(760px,100%);max-width:100%}" +
        ".sticky-header{position:sticky;top:0;z-index:20;padding:16px 0 12px;" +
        "margin:0 -18px;padding-left:18px;padding-right:18px;" +
        "background:var(--sticky-bg);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);" +
        "border-bottom:1px solid var(--line);box-shadow:0 8px 18px rgba(28,36,48,0.04)}" +
        ".sticky-header-inner{display:flex;justify-content:space-between;gap:16px;" +
        "align-items:flex-start;flex-wrap:wrap}" +
        ".brand{display:flex;align-items:flex-start;gap:14px;min-width:min-content;flex:1}" +
        ".logo{height:56px;max-width:min(70vw,100%);object-fit:contain;flex-shrink:0;display:block}" +
        ".brand-text{min-width:0}" +
        "h1{font-size:1.55rem;margin:0 0 4px;letter-spacing:-0.02em}" +
        ".powered-by{margin:0 0 6px;font-family:system-ui,sans-serif;font-size:0.82rem;line-height:1.35}" +
        ".powered-by a{color:var(--accent-ink);text-decoration:none;border-bottom:1px solid transparent}" +
        ".powered-by a:hover{border-bottom-color:var(--accent)}" +
        ".subtitle{margin:0;color:var(--muted);font-family:system-ui,sans-serif;font-size:0.9rem}" +
        ".lang{font-family:system-ui,sans-serif;display:flex;gap:8px;align-items:center;padding-top:4px}" +
        ".lang a{color:var(--accent-ink);text-decoration:none;border-bottom:1px solid transparent}" +
        ".lang a.active{border-bottom-color:var(--accent);font-weight:600}" +
        ".meta-bar,.panel,.composer{background:var(--panel);border:1px solid var(--line);border-radius:10px;" +
        "padding:14px 16px;margin:14px 0 0}" +
        ".meta-bar{font-family:system-ui,sans-serif;font-size:0.9rem;color:var(--muted);" +
        "display:grid;gap:4px}" +
        ".meta-bar strong{color:var(--ink)}" +
        ".thread{display:flex;flex-direction:column;gap:16px;margin-top:18px}" +
        ".turn{display:flex;flex-direction:column;gap:10px}" +
        ".bubble{border:1px solid var(--line);border-radius:12px;padding:12px 14px}" +
        ".bubble.q{background:var(--q-bg);border-color:#c5ddd6}" +
        ".bubble.a{background:var(--panel)}" +
        ".bubble-label{font-family:system-ui,sans-serif;font-size:0.75rem;text-transform:uppercase;" +
        "letter-spacing:0.04em;color:var(--muted);margin:0 0 6px}" +
        ".question-text{margin:0;line-height:1.45;font-size:1.05rem}" +
        ".answer{line-height:1.55;margin:0}" +
        ".answer.md p{margin:0 0 0.75em}" +
        ".answer.md p:last-child{margin-bottom:0}" +
        ".answer.md h3{font-size:1.05rem;margin:1em 0 0.45em}" +
        ".answer.md strong{font-weight:700}" +
        ".answer.md code{font-family:ui-monospace,Consolas,monospace;font-size:0.9em;" +
        "background:#eef2f5;padding:0.1em 0.35em;border-radius:4px}" +
        ".answer.md table{border-collapse:collapse;width:100%;margin:0.6em 0 0.2em;" +
        "font-family:system-ui,sans-serif;font-size:0.9rem}" +
        ".answer.md th,.answer.md td{border:1px solid var(--line);padding:6px 8px;text-align:left}" +
        ".answer.md th{background:#eef2f5;font-weight:600}" +
        ".answer.md ul,.answer.md ol{margin:0.4em 0 0.8em;padding-left:1.3em}" +
        ".sources-details{margin-top:12px;font-family:system-ui,sans-serif;font-size:0.9rem}" +
        ".sources-details summary{cursor:pointer;color:var(--accent-ink);user-select:none}" +
        ".sources{list-style:none;padding:0;margin:10px 0 0;font-size:0.92rem}" +
        ".sources li{padding:10px 0;border-top:1px solid var(--line)}" +
        ".sources li:first-child{border-top:none;padding-top:0}" +
        ".slug,.path,.meta,.muted{color:var(--muted)}" +
        ".slug{font-family:ui-monospace,Consolas,monospace;font-size:0.85rem}" +
        ".path{font-family:ui-monospace,Consolas,monospace;font-size:0.82rem}" +
        "label{display:block;font-family:system-ui,sans-serif;font-size:0.85rem;margin:0 0 8px;" +
        "color:var(--muted)}" +
        "label.tool-toggle{display:flex;align-items:flex-start;gap:10px;margin:10px 0 0;" +
        "font-size:0.9rem;color:var(--ink);cursor:pointer;line-height:1.35}" +
        "label.tool-toggle input{margin-top:3px;flex:0 0 auto;accent-color:var(--accent)}" +
        "label.tool-toggle .hint{display:block;color:var(--muted);font-size:0.82rem;margin-top:2px}" +
        "textarea{width:100%;min-height:96px;resize:vertical;padding:12px 14px;border-radius:8px;" +
        "border:1px solid var(--line);background:#fff;color:var(--ink);font:1rem/1.45 Georgia,serif}" +
        "textarea:focus{outline:2px solid var(--focus);border-color:var(--accent)}" +
        ".actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}" +
        "button,.ghost{font-family:system-ui,sans-serif;border-radius:8px;padding:10px 14px;" +
        "border:1px solid var(--accent);cursor:pointer}" +
        "button{background:var(--accent);color:#fff}" +
        "button:hover{background:var(--accent-ink)}" +
        ".ghost{background:transparent;color:var(--accent-ink);text-decoration:none;display:inline-block}" +
        ".error{color:var(--danger);font-family:system-ui,sans-serif;margin:0}" +
        ".error-bubble{background:#fff5f5;border-color:#efc4c4}" +
        ".pending{color:var(--warn);font-family:system-ui,sans-serif;margin:0;font-style:italic}" +
        ".live-status,.live-dock{font-family:system-ui,sans-serif;font-size:0.88rem;margin:8px 0 0;" +
        "color:var(--accent-ink);background:#e8f2ef;border:1px solid #c5ddd6;border-radius:8px;" +
        "padding:8px 12px}" +
        /* Home is only a safe shelf outside #ask-panel; dock is moved next to the latest turn while live. */
        "#ask-live-home:empty{display:none}" +
        ".live-dock[hidden]{display:none!important}" +
        ".live-dock .live-round{font-weight:600;margin-right:6px}" +
        ".live-dock .live-timer,.live-status .live-timer{font-variant-numeric:tabular-nums;" +
        "font-weight:600;color:var(--muted);margin-right:6px}" +
        ".empty{color:var(--muted);font-family:system-ui,sans-serif;margin:0}" +
        ".composer{position:sticky;bottom:0;z-index:15;margin-top:18px;" +
        "box-shadow:0 -10px 24px rgba(28,36,48,0.05)}" +
        ".busy{font-family:system-ui,sans-serif;font-size:0.85rem;color:var(--muted);margin:8px 0 0}" +
        "</style>";
}

function askLogoMime(path) {
    var lower = str.lower(askAsText(path));
    if (str.endsWith(lower, ".png")) {
        return "image/png";
    }
    if (str.endsWith(lower, ".jpg") or str.endsWith(lower, ".jpeg")) {
        return "image/jpeg";
    }
    if (str.endsWith(lower, ".gif")) {
        return "image/gif";
    }
    if (str.endsWith(lower, ".webp")) {
        return "image/webp";
    }
    if (str.endsWith(lower, ".svg")) {
        return "image/svg+xml";
    }
    if (str.endsWith(lower, ".ico")) {
        return "image/x-icon";
    }
    return "application/octet-stream";
}

// Resolves ASK_LOGO once per ASK session (cached in ui.state).
// Accepts "", http(s):/data: URL, or a local/embed file path.
function askResolveLogoSrc() {
    var cached = ui.state(ASK_STORE, "logoSrc", null, ASK_SESSION_ID);
    if (cached != null) {
        return askAsText(cached);
    }
    var logo = str.trim(askAsText(ASK_LOGO));
    var src = "";
    if (logo != "") {
        if (str.startsWith(logo, "http://") or str.startsWith(logo, "https://") or
                str.startsWith(logo, "data:")) {
            src = logo;
        } else if (io.hasFile(logo)) {
            var b64 = io.readFileBase64(logo);
            if (b64 != null and askAsText(b64) != "") {
                src = "data:" + askLogoMime(logo) + ";base64," + askAsText(b64);
            }
        }
    }
    ui.setState(ASK_STORE, "logoSrc", src, ASK_SESSION_ID);
    return src;
}

// Flash + thread + composer — returned as componentFragment("ask-panel", ...).
function askRenderPanelHtml() {
    var history = askGetHistory();
    var flashError = askGetFlashError();
    var session = askGetSession();
    var html = "";

    if (flashError != "") {
        html = html + "<section class='panel'><p class='error'>" +
            askEscapeHtml(flashError) + "</p></section>";
    }

    html = html + "<section class='thread' id='thread'>";
    if (history.length == 0) {
        var emptyHint = askT(
            "Ask a question below. Answers use " + askProductName() +
                "; scroll up for earlier turns.",
            "Fai una domanda qui sotto. Le risposte usano " + askProductName() +
                "; scorri in alto per i turni precedenti.");
        if (session.chatOnly == true) {
            emptyHint = askT(
                "No " + askProductName() + " loaded — chat directly with the model below.",
                askProductName() + " non caricato — chatta direttamente col modello qui sotto.");
        }
        html = html + "<div class='panel'><p class='empty'>" + askEscapeHtml(emptyHint) + "</p></div>";
    } else {
        var i = 0;
        foreach (var turn in history) {
            html = html + askRenderTurnHtml(turn, i);
            i = i + 1;
        }
    }
    html = html + "</section>";

    var placeholder = askT(
        "Ask about the distilled notes…",
        "Chiedi sulle note distillate…");
    if (session.chatOnly == true) {
        placeholder = askT(
            "Ask the model anything…",
            "Chiedi qualsiasi cosa al modello…");
    }

    var toolsEnabled = askGetToolsEnabled();
    var toolsChecked = "";
    if (toolsEnabled) {
        toolsChecked = " checked";
    }
    var busyHint = askT(
        "Each ask may take a while (LLM). Keep this tab open.",
        "Ogni domanda puo' richiedere tempo (LLM). Lascia aperta questa scheda.");
    if (toolsEnabled and session.chatOnly != true) {
        busyHint = askT(
            "Note search tools are on — the model may take several LLM rounds. Keep this tab open.",
            "Ricerca nelle note attiva — il modello puo' fare piu' round LLM. Lascia aperta questa scheda.");
    }

    html = html + "<section class='composer'>" +
        "<form method='post' action='/ask'>" +
        "<label for='question'>" + askEscapeHtml(askT("New question", "Nuova domanda")) + "</label>" +
        "<textarea id='question' name='question' required autofocus placeholder='" +
        askEscapeHtml(placeholder) +
        "'></textarea>";

    if (session.chatOnly != true) {
        html = html + "<label class='tool-toggle' for='useTools'>" +
            "<input type='checkbox' id='useTools' name='useTools' value='1'" + toolsChecked + ">" +
            "<span>" + askEscapeHtml(askT(
                "Search notes with tools (slower)",
                "Ricerca nelle note con tool (piu' lento)")) +
            "<span class='hint'>" + askEscapeHtml(askT(
                "Off: answer from retrieved excerpts only (faster). On: allow read_file / grep / list_directory.",
                "Off: risponde solo dagli estratti recuperati (piu' veloce). On: consente read_file / grep / list_directory.")) +
            "</span></span></label>";
    }

    html = html + "<p class='busy'>" + askEscapeHtml(busyHint) + "</p>" +
        "<div class='actions'>" +
        "<button type='submit'>" + askEscapeHtml(askT("Ask", "Chiedi")) + "</button>" +
        "</div></form>" +
        "<form method='post' action='/clear' style='margin-top:10px'>" +
        "<div class='actions'>" +
        "<button type='submit' class='ghost' style='background:transparent;color:var(--accent-ink)'>" +
        askEscapeHtml(askT("Clear thread", "Svuota thread")) + "</button>" +
        "</div></form></section>";

    return html;
}

function askPanelFragment() {
    return componentFragment("ask-panel", askRenderPanelHtml());
}

// Scroll + SSE live progress. Scripts inside fragment bodies do not run via innerHTML.
// #ask-live-dock lives in #ask-live-home (outside #ask-panel) so it survives the
// blocking POST; while visible it is moved under the latest turn / above the composer.
function askPageClientScript() {
    return "<script>(function(){" +
        "var es=null;" +
        "var liveLabel='" + askEscapeHtml(askT("Live", "Live")) + "';" +
        "var askStartedAt=null;" +
        "var roundStartedAt=null;" +
        "var lastRound=null;" +
        "var lastMsg='';" +
        "var timerId=null;" +
        "function formatElapsed(ms){" +
        "var s=Math.max(0,Math.floor(ms/1000));" +
        "var m=Math.floor(s/60);" +
        "s=s%60;" +
        "return m+':'+(s<10?'0':'')+s;" +
        "}" +
        "function scrollLatest(){" +
        "var dock=document.getElementById('ask-live-dock');" +
        "if(dock&&!dock.hidden){" +
        "dock.scrollIntoView({block:'nearest',behavior:'smooth'});" +
        "return;" +
        "}" +
        "var thread=document.getElementById('thread');" +
        "if(!thread){return;}" +
        "var turns=thread.querySelectorAll('.turn');" +
        "if(turns.length===0){return;}" +
        "var last=turns[turns.length-1];" +
        "if(last&&last.id){location.hash=last.id;}" +
        "last.scrollIntoView({block:'nearest',behavior:'smooth'});" +
        "}" +
        "function progressMessage(p){" +
        "if(!p){return '';}" +
        "if(p.phase==='tool_calls'&&p.tools&&p.tools.length){" +
        "return 'Tools: '+p.tools.join(', ');" +
        "}" +
        "if(p.phase==='tool_done'&&p.tool){" +
        "return (p.ok===false?'Failed: ':'Done: ')+p.tool;" +
        "}" +
        "return p.message||'';" +
        "}" +
        "function roundLabel(){" +
        "if(lastRound==null){return '';}" +
        "var bit='Round '+lastRound;" +
        "if(roundStartedAt){bit+=' '+formatElapsed(Date.now()-roundStartedAt);}" +
        "return bit;" +
        "}" +
        "function paintTimers(){" +
        "var total=askStartedAt?formatElapsed(Date.now()-askStartedAt):'0:00';" +
        "var roundBit=roundLabel();" +
        "var bodyText=(roundBit?(roundBit+' · '):'')+(lastMsg||'');" +
        "var dock=document.getElementById('ask-live-dock');" +
        "if(dock){" +
        "var t=dock.querySelector('.live-timer');" +
        "if(t){t.textContent=total;}" +
        "var body=dock.querySelector('.live-dock-body');" +
        "if(body){body.textContent=bodyText;}" +
        "}" +
        "var status=document.getElementById('ask-live-status');" +
        "if(status){status.textContent=total+(bodyText?' · '+bodyText:'');}" +
        "}" +
        "function startLiveTimer(){" +
        "if(!askStartedAt){askStartedAt=Date.now();}" +
        "if(!roundStartedAt){roundStartedAt=askStartedAt;}" +
        "if(timerId){return;}" +
        "paintTimers();" +
        "timerId=setInterval(paintTimers,1000);" +
        "}" +
        "function stopLiveTimer(){" +
        "if(timerId){clearInterval(timerId);timerId=null;}" +
        "askStartedAt=null;" +
        "roundStartedAt=null;" +
        "lastRound=null;" +
        "lastMsg='';" +
        "}" +
        "function ensureLiveDock(){" +
        "var dock=document.getElementById('ask-live-dock');" +
        "if(dock){return dock;}" +
        "var home=document.getElementById('ask-live-home');" +
        "if(!home){return null;}" +
        "dock=document.createElement('div');" +
        "dock.id='ask-live-dock';" +
        "dock.className='live-dock';" +
        "dock.hidden=true;" +
        "dock.innerHTML='<span class=\"live-round\"></span><span class=\"live-timer\">0:00</span><span class=\"live-dock-body\"></span>';" +
        "var label=dock.querySelector('.live-round');" +
        "if(label){label.textContent=liveLabel;}" +
        "home.appendChild(dock);" +
        "return dock;" +
        "}" +
        "function placeLiveDock(visible){" +
        "var dock=ensureLiveDock();" +
        "var home=document.getElementById('ask-live-home');" +
        "if(!dock){return null;}" +
        "if(!visible){" +
        "if(home&&dock.parentNode!==home){home.appendChild(dock);}" +
        "return dock;" +
        "}" +
        "var thread=document.getElementById('thread');" +
        "var composer=document.querySelector('#ask-panel .composer');" +
        "if(thread){" +
        "var turns=thread.querySelectorAll('.turn');" +
        "if(turns.length){" +
        "var last=turns[turns.length-1];" +
        "if(dock.previousSibling!==last){last.after(dock);}" +
        "}else if(dock.parentNode!==thread){" +
        "thread.appendChild(dock);" +
        "}" +
        "}else if(composer&&dock.parentNode!==composer.parentNode){" +
        "composer.parentNode.insertBefore(dock,composer);" +
        "}else if(home&&dock.parentNode!==home){" +
        "home.appendChild(dock);" +
        "}" +
        "return dock;" +
        "}" +
        "function showLive(text,visible){" +
        "var dock=placeLiveDock(visible);" +
        "if(visible){" +
        "if(text){lastMsg=text;}" +
        "startLiveTimer();" +
        "}else{" +
        "stopLiveTimer();" +
        "}" +
        "if(dock){" +
        "dock.hidden=!visible;" +
        "if(visible){" +
        "paintTimers();" +
        "dock.scrollIntoView({block:'nearest',behavior:'smooth'});" +
        "}else{" +
        "var body=dock.querySelector('.live-dock-body');" +
        "if(body){body.textContent='';}" +
        "var t=dock.querySelector('.live-timer');" +
        "if(t){t.textContent='0:00';}" +
        "}" +
        "}" +
        "var status=document.getElementById('ask-live-status');" +
        "if(status&&!visible){status.textContent='';}" +
        "}" +
        "function onProgressPayload(payload){" +
        "if(!payload){return;}" +
        "var done=payload.phase==='done';" +
        "if(payload.phase==='round_start'||(payload.round!=null&&payload.round!==lastRound)){" +
        "if(payload.round!=null){" +
        "lastRound=payload.round;" +
        "roundStartedAt=Date.now();" +
        "}" +
        "}" +
        "var msg=progressMessage(payload);" +
        "if(!msg&&!done){return;}" +
        "if(msg){lastMsg=msg;}" +
        "showLive(lastMsg,!done);" +
        "if(done){setTimeout(function(){showLive('',false);},1200);}" +
        "}" +
        "function connectLive(){" +
        "if(es){try{es.close();}catch(e){}}" +
        "es=new EventSource('/ask/live?channel=ask');" +
        "es.onmessage=function(evt){" +
        "try{" +
        "var data=JSON.parse(evt.data);" +
        "var payload=data&&data.payload?data.payload:data;" +
        "if(data&&data.event&&data.event!=='ask-progress'&&data.type==='componentLiveEvent'){" +
        "/* keep going — payload still useful */" +
        "}" +
        "onProgressPayload(payload);" +
        "}catch(err){}" +
        "};" +
        "es.onerror=function(){/* browser will retry EventSource */};" +
        "}" +
        "function bind(){" +
        "var panel=document.getElementById('ask-panel');" +
        "if(panel&&panel.dataset.askScrollBound!=='1'){" +
        "panel.dataset.askScrollBound='1';" +
        "new MutationObserver(function(){" +
        // Panel replace destroys an in-thread dock; shelve a fresh one, then scroll.
        "var home=document.getElementById('ask-live-home');" +
        "var dock=document.getElementById('ask-live-dock');" +
        "if(!dock||(home&&!home.contains(dock))){" +
        "showLive('',false);" +
        "}" +
        "scrollLatest();" +
        "}).observe(panel,{childList:true});" +
        "}" +
        "document.addEventListener('submit',function(e){" +
        "var form=e.target;" +
        "if(!form||!form.action){return;}" +
        "if(String(form.action).indexOf('/ask')<0){return;}" +
        "lastRound=null;" +
        "roundStartedAt=null;" +
        "askStartedAt=null;" +
        "showLive('Starting…',true);" +
        "},true);" +
        "connectLive();" +
        "scrollLatest();" +
        "}" +
        "if(document.readyState==='loading'){" +
        "document.addEventListener('DOMContentLoaded',bind);" +
        "}else{bind();}" +
        "})();</script>";
}

function askRenderPage() {
    var lang = askGetLang();
    var session = askGetSession();
    var title = askAsText(session.title);
    if (title == "") {
        title = askAsText(ASK_PAGE_TITLE);
    }
    if (title == "") {
        title = askProductName() + " — ASK";
    }
    var poweredBy = askAsText(ASK_POWERED_BY);
    var poweredByUrl = askAsText(ASK_POWERED_BY_URL);
    var logoSrc = askResolveLogoSrc();
    var enClass = "";
    var itClass = "";
    if (lang == "en") {
        enClass = " active";
    } else {
        itClass = " active";
    }

    var mainClass = "";
    if (logoSrc != "") {
        mainClass = " class='has-logo'";
    }
    var html = "<!DOCTYPE html><html lang='" + lang + "'><head>" +
        "<meta charset='utf-8'>" +
        "<meta name='viewport' content='width=device-width,initial-scale=1'>" +
        "<title>" + askEscapeHtml(title) + "</title>" +
        askPageStyles() +
        "</head><body><main" + mainClass + ">";

    html = html + "<header class='sticky-header'><div class='sticky-header-inner'>" +
        "<div class='brand'>";
    if (logoSrc != "") {
        html = html + "<img class='logo' src='" + askEscapeHtml(logoSrc) +
            "' alt=''>";
    }
    html = html + "<div class='brand-text'>" +
        "<h1>" + askEscapeHtml(title) + "</h1>";
    if (poweredBy != "") {
        if (poweredByUrl != "") {
            html = html + "<p class='powered-by'><a href='" + askEscapeHtml(poweredByUrl) +
                "' target='_blank' rel='noopener noreferrer'>" +
                askEscapeHtml(poweredBy) + "</a></p>";
        } else {
            html = html + "<p class='powered-by'>" + askEscapeHtml(poweredBy) + "</p>";
        }
    }
    html = html + "<p class='subtitle'>" + askEscapeHtml(askAsText(session.subtitle)) +
        "</p></div></div>" +
        "<div class='lang'>" +
        "<a class='" + str.trim(enClass) + "' href='/?lang=en'>English</a>" +
        "<span aria-hidden='true'>·</span>" +
        "<a class='" + str.trim(itClass) + "' href='/?lang=it'>Italiano</a>" +
        "</div></div></header>";

    html = html + "<div class='meta-bar'>" +
        "<div>" + askEscapeHtml(askT("Notes", "Note")) + ": <strong>" +
        askEscapeHtml(string(session.noteCount)) +
        "</strong> · " + askEscapeHtml(askT("Themes", "Temi")) + ": <strong>" +
        askEscapeHtml(string(session.topicCount)) + "</strong> · " +
        askEscapeHtml(askT("from", "da")) +
        " <strong>" + askEscapeHtml(session.sourceFolder) + "</strong></div>" +
        "<div>" + askEscapeHtml(askT("Retrieval", "Recupero")) + ": <strong>" +
        askEscapeHtml(session.retrieval) + "</strong> · LLM: <strong>" +
        askEscapeHtml(session.llm) + "</strong></div>" +
        "</div>";

    // Shelf outside #ask-panel so the node can be recreated after fragment replace.
    // While live, client JS moves the dock under the latest turn (above the composer).
    html = html + "<div id='ask-live-home'>" +
        "<div id='ask-live-dock' class='live-dock' hidden>" +
        "<span class='live-round'>" + askEscapeHtml(askT("Live", "Live")) +
        "</span><span class='live-timer'>0:00</span>" +
        "<span class='live-dock-body'></span></div></div>";

    html = html + "<div id='ask-panel'>" + askRenderPanelHtml() + "</div>";
    html = html + askPageClientScript();
    html = html + "</main></body></html>";
    return html;
}

@PAGE("/")
function askUiHome(queryParams) {
    if (queryParams != null and queryParams["lang"] != null) {
        askSetLang(queryParams["lang"]);
    }
    // Bookmark / no-JS fallback for clear (AJAX path uses POST /clear).
    if (queryParams != null and queryParams["clear"] != null) {
        askClearHistory();
        return RedirectTo("/");
    }
    return askRenderPage();
}

function askConsumePendingStop() {
    // Web UI does not expose stop (multi-user safe). Hosts may still poll this
    // for a future console/admin signal; nothing in ASK sets pendingStop today.
    var pending = ui.state(ASK_STORE, "pendingStop", false, ASK_SESSION_ID);
    if (pending == true) {
        ui.setState(ASK_STORE, "pendingStop", false, ASK_SESSION_ID);
        return true;
    }
    return false;
}

function askReplaceLastTurn(turn) {
    // Rebuild + setState so the completed answer is what the panel fragment shows.
    var history = askGetHistory();
    if (history.length == 0) {
        askAppendTurn(turn);
        return;
    }
    var next = [];
    var i = 0;
    var last = history.length - 1;
    while (i < last) {
        next.append(history[i]);
        i = i + 1;
    }
    next.append(turn);
    askSetHistory(next);
}

@ACTION("/ask")
function askUiSubmit(body) {
    var question = str.trim(askAsText(body.question));
    askSetFlashError("");
    askApplyToolsFromBody(body);

    if (question == "") {
        askSetFlashError(askT("Enter a question.", "Inserisci una domanda."));
        return askPanelFragment();
    }

    // Visible immediately if the user refreshes while the LLM is still running.
    askAppendTurn({
        "question": question,
        "answer": "",
        "sources": [],
        "error": "",
        "pending": true
    });

    // Channel form works in interpreter and transpile (SSE via componentLiveEmit).
    onAgentProgress("ask");
    try {
        var startMsg = askT("Starting ask…", "Avvio domanda…");
        if (askGetToolsEnabled()) {
            startMsg = askT("Starting ask (tools on)…", "Avvio domanda (tool attivi)…");
        }
        componentLiveEmit("ask", {
            "phase": "round_start",
            "round": 0,
            "message": startMsg
        }, "ask-progress");
        var turn = runAskTurn(question);
        if (turn == null) {
            askReplaceLastTurn({
                "question": question,
                "answer": "",
                "sources": [],
                "error": askT("Ask failed.", "Domanda fallita."),
                "pending": false
            });
            return askPanelFragment();
        }
        turn.pending = false;
        askReplaceLastTurn(turn);
    } catch (e) {
        askReplaceLastTurn({
            "question": question,
            "answer": "",
            "sources": [],
            "error": askT("Ask failed: ", "Domanda fallita: ") + askAsText(e),
            "pending": false
        });
    } finally {
        clearAgentProgress();
    }
    return askPanelFragment();
}

@ACTION("/clear")
function askUiClear() {
    askClearHistory();
    return askPanelFragment();
}

@LIVE("/ask/live")
function askUiLive() {
    return { "sse": true };
}
