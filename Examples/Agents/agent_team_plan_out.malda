// Offline golden: executePlan step.out coerces fixture JSON like a typed prompt.
// A bad fixture fails the step and skips dependents. No LLM.
// Run: malda Examples/Agents/agent_team_plan_out.malda

schema DraftCode { path: string; summary: string; }

var team = agents.team(
    [
        { name: "Writer", role: "programmer", instructions: "Write small diffs." },
        { name: "Reviewer", role: "reviewer", instructions: "Find bugs." }
    ],
    graph directed {
        nodes: ["Writer", "Reviewer"],
        edges: [{ from: "Writer", to: "Reviewer", rel: "handoff" }]
    }
);

var ok = executePlan({
    think: false,
    steps: [
        { id: "write", description: "Write comments", role: "Writer", out: "DraftCode", fixture: { path: "a.malda", summary: "add comments" } },
        { id: "review", description: "Review the draft", role: "Reviewer", dependsOn: ["write"] }
    ]
}, team);
io.print(ok.completed.length);
io.print(ok.results[0].data.path);

var bad = executePlan({
    think: false,
    steps: [
        { id: "write", description: "Write comments", role: "Writer", out: "DraftCode", fixture: { path: 1, summary: "nope" } },
        { id: "review", description: "Review the draft", role: "Reviewer", dependsOn: ["write"] }
    ]
}, team);
io.print(bad.failed[0]);
io.print(bad.skipped[0]);
