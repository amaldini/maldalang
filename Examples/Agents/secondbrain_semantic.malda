// secondbrain_semantic.malda — GraphMemory Second Brain host (MALDA 1.0)
// ASK HTTP service version: ASK_SERVICE_VERSION in secondbrain_ask_ui_lib.malda
// (GET /health). Shared BUILD/ASK helpers live in Examples/Agents/sb/.
//
// Sibling of Examples/Agents/secondbrain.malda for A/B comparison:
//   - secondbrain.malda          ASK retrieves notes with lexical token overlap
//   - secondbrain_semantic.malda ASK retrieves via GraphMemory (vector + BM25 hybrid)
//
// Modes:
//   1) BUILD   same distillation as the lexical sibling, then indexes each note
//              into GraphMemory (saved beside the markdown tree).
//   2) UPDATE  incremental refresh: re-distill only new/changed source files, then
//              rebuild GraphMemory from the full note set (content hashes in brain.json).
//   3) ASK     local HttpServer web UI: GraphMemory.query (hybridLexical / BM25),
//              falling back to the lexical catalog scorer if memory is missing.
//              LLM answers in Markdown (rendered with markdownToHtml), plus Generate
//              document (download .md / .html from indexed examples).
//              Optional ASK tools include find_related_notes (new Tool + GraphMemory.findRelated).
//   4) language  switch console/UI language (English / Italian).
//   5) PACK    compile a portable ASK-only .exe with the brain embedded.
//
// Run:   malda Examples/Agents/secondbrain_semantic.malda
//
// Non-interactive CLI (skips menu + confirmations; exits when done):
//   malda Examples/Agents/secondbrain_semantic.malda build --docs ./docs [--brain secondbrain_semantic]
//       [--taxonomy llm|folders] [--lang en|it] [--product-name "Acme Brain"]
//   malda Examples/Agents/secondbrain_semantic.malda update [--docs ./docs] [--brain secondbrain_semantic]
//       [--remove-orphans] [--lang en|it] [--product-name "Acme Brain"]
//   malda Examples/Agents/secondbrain_semantic.malda ask [--brain secondbrain_semantic] [--port 8080]
//       [--host 0.0.0.0] [--https --cert ask.pfx [--cert-password secret]]
//       [--lang en|it] [--product-name "Acme Brain"]
//       [--auth|--no-auth] [--allow-register|--no-register]
//       [--examples|--no-examples]
//       [--no-powered-by | --powered-by "…"] [--powered-by-url URL]
//   malda Examples/Agents/secondbrain_semantic.malda generate --prompt "…" [--brain secondbrain_semantic]
//       [--out document.md] [--format md|html] [--force] [--lang en|it]
//   malda Examples/Agents/secondbrain_semantic.malda help
//   (--name is an alias for --product-name; overrides brain product_name.txt)
//
// ASK auth (cookie JWT) is on by default. Disable with --no-auth or MALDA_ASK_AUTH=0.
// Bootstrap: MALDA_ASK_USER / MALDA_ASK_PASSWORD (or HASH); default admin / password.
// Non-loopback --host refuses default password and default JWT/cookie/session secrets.
// Multi-user: users.json in the brain folder (or .malda/ask_users.json for embed).
// Open registration: --allow-register (or MALDA_ASK_ALLOW_REGISTER=1).
// Sample questions on empty ASK UI: on by default; hide with --no-examples (or MALDA_ASK_EXAMPLES=0).
// Header powered-by: hide with --no-powered-by (or MALDA_ASK_POWERED_BY=0).
// Admin (role admin): /admin/users, /admin/upload (sync UPDATE; not for embed packs).
// Also: per-user history, tag filters, force-answer, /health, ask_audit.jsonl, thumbs.
//
// LLM:   if OPENROUTER_API_KEY is set, uses OpenRouter (client default model,
//        override with MALDA_BRAIN_MODEL); otherwise MALDA's default local model
//        (downloaded on first use).
//
// Embeddings (ASK quality for synonyms / paraphrases / cross-language):
//   Place this multilingual GGUF next to this .malda (or next to the compiled .exe):
//     bge-m3-Q4_K_M.gguf   (~438 MB, 1024-dim, BGE-M3, 100+ languages)
//   Download:
//     https://huggingface.co/gpustack/bge-m3-GGUF/resolve/main/bge-m3-Q4_K_M.gguf
//   If the file is present, llama embeddings are used automatically.
//   If missing, ASK/BUILD fall back to embedHash and the UI shows the download link.
//   Rebuild the brain after changing the embedding model (vector index is not portable).
//   Overrides:
//     MALDA_MEMORY_EMBED=hash|bow|llama
//     MALDA_BRAIN_EMBED_MODEL=/path/to/embedding.gguf
//
// UI:    at startup (interactive), choose UI message language (English / Italian).
//        Notes stay in the source document language; technical terms are unchanged.
//        ASK opens http://localhost:39019/ by default (Ctrl+C in console returns to menu).
//        Override ASK port/host from the command line (menu mode 3, ask CLI, or packed exe):
//          malda Examples/Agents/secondbrain_semantic.malda --port 8080
//          malda Examples/Agents/secondbrain_semantic.malda ask --port 80 --host 0.0.0.0
//          SecondBrain.exe --port 8080 --host 0.0.0.0
//          (also: -p 8080, --port=8080, --host=0.0.0.0 / --host=*)
//
// Pack portable ASK exe (menu option 5, interactive):
//   malda compile Examples/Agents/secondbrain_semantic.malda -o dist/SecondBrain.exe --mode transpile --embed-folder secondbrain_semantic
//   Embeds notes + GraphMemory artifacts (brain_memory.*) for read-only hybrid ASK.
//   (copy the .gguf next to the .exe for neural retrieval; GGUF is not embedded)
//   Native llama.cpp load chatter is quiet by default; set MALDA_LLAMA_LOG=1 to see it.
//   When the embedded folder is present at runtime, startup skips the console
//   menu/language prompt and opens ASK immediately (language is chosen in the
//   web UI; exits when the server stops).

// ---------------------------------------------------------------- configuration

var MAX_DOC_CHARS = 12000;      // document characters sent per LLM call
var MAX_CHUNKS = 15;            // max parts for a very long document
var MAX_NOTE_CHARS = 5000;      // characters per note in an answer context
var TOP_K = 5;                  // notes retrieved per question
var MAX_EXPLORE_DOCS = 300;     // documents listed for the explorer agent
var CATALOG_NAME = "brain.json";
var DEFAULT_BRAIN_DIR = "secondbrain_semantic";
var MEMORY_BASE_NAME = "brain_memory";  // -> brain_memory.graph.json (+ metadata / vectordb)
var EMBED_DIM = 1024;
var EMBED_FILE_NAME = "bge-m3-Q4_K_M.gguf";
var EMBED_DOWNLOAD_PAGE = "https://huggingface.co/gpustack/bge-m3-GGUF";
var EMBED_DOWNLOAD_FILE = "https://huggingface.co/gpustack/bge-m3-GGUF/resolve/main/bge-m3-Q4_K_M.gguf";
var UI_LANG = "it";             // "en" | "it" — UI messages
var ASK_HTTP_PORT = 39019;  // override with --port / -p on the command line
var ASK_HTTP_HOST = "localhost";  // override with --host (0.0.0.0 / * = all interfaces)
// ASK_HTTPS / ASK_CERT_* defaults live in secondbrain_ask_ui_lib.malda
var ASK_SESSION_ID = "secondbrain-ask-semantic";
var ASK_STORE = "SecondBrainAskSemantic";
// Display name for UI / console / generated index (folder aliases stay EMBED_ALIAS).
// Literal name, OR path / embed:… to a utf-8 text file (first non-empty line).
// Prefer brain file product_name.txt (auto-loaded when the brain root is known).
var PRODUCT_NAME = "Second brain";
var ASK_TITLE_SUFFIX = "";
// ASK web header — defaults from PRODUCT_NAME; override freely if needed.
var ASK_PAGE_TITLE = PRODUCT_NAME + ASK_TITLE_SUFFIX;
var ASK_POWERED_BY = "Powered by MALDA: Multi Agent Language with Development Automation";
var ASK_POWERED_BY_URL = "https://github.com/amaldini/maldalang";
// Optional logos beside the title (works in normal ASK and in packed/embed exe):
//   ASK_LOGO       -> left of title (company); auto-load logo.png/.svg/.jpg/…
//   ASK_LOGO_RIGHT -> right of title (product); auto-load logo_right.png/.svg/.jpg/…
//   ASK_LOGO_RIGHT_HEIGHT -> CSS height in px (default 48; also "64"/"64px", or path/embed: text file)
//      Brain file logo_right_height.txt (first line) overrides this when present.
// Path forms for either:
//   ""              -> auto-load from the brain folder
//   "logo.png"      -> same folder as the brain (resolved at ASK start)
//   "P:/brain/logo.png" or "P:\\brain\\logo.png"  -> absolute disk path
//      Prefer / or \\ — a single \ in "P:\Second..." is a string escape, not a folder slash.
//   "embed:ALIAS/logo.png" -> packed brain only
//   "https://..." / "data:..." -> remote or inline
var ASK_LOGO = "";
var ASK_LOGO_RIGHT = "";
var ASK_LOGO_RIGHT_HEIGHT = 48;
var SOURCE_SCRIPT_NAME = "secondbrain_semantic.malda";
var EMBED_ALIAS = "secondbrain_semantic";
var DEFAULT_PACK_OUTPUT = "dist/SecondBrain.exe";
var askHttpServer = null;
var embedMode = "hash";
var memoryEmbedder = null;
var embedHintShown = false;
// Cached GraphMemory for ASK (avoids reloading GGUF / embed artifacts every turn).
var askMemoryCache = null;
var askMemoryCacheDir = "";

include "sb/00-i18n.malda";
import "secondbrain_cli_lib.malda";
include "secondbrain_cli_apply_lib.malda";
include "sb/01-llm.malda";
include "sb/02-text.malda";
include "sb/03-distill.malda";
include "sb/06-memory.malda";

// Host hooks (semantic GraphMemory).

function addHostAskTools(agent, brainDir) {
    var memory = getAskMemory(brainDir);
    if (memory != null) {
        agent.addTool(createFindRelatedNotesTool());
    }
    return agent;
}

function hostAskToolExtraInstructions() {
    return "Se e' disponibile, usa find_related_notes(slug) per esplorare note collegate " +
        "nel GraphMemory a partire da uno slug delle fonti. ";
}

function hostAskToolsOnLabel() {
    return t(
        "ASK tools: on (read_file / grep / list_directory / find_related_notes)",
        "Tool ASK: attivi (read_file / grep / list_directory / find_related_notes)");
}

function indexBrainAfterFinalize(brainDir, notes) {
    indexBrainMemory(brainDir, notes);
}

function catalogExtraFields() {
    return {
        "retrieval": "graphmemory",
        "embed": embedLabel()
    };
}

function brainIndexHowToLines() {
    return [
        "- Modalita' 3 di `" + SOURCE_SCRIPT_NAME + "`: domande via GraphMemory (vettoriale + BM25).",
        "- Modalita' 2: aggiornamento incrementale da file nuovi/modificati nell'origine.",
        "- Sibling lessicale per confronto: `Examples/Agents/secondbrain.malda`.",
        "- `" + CATALOG_NAME + "`: catalogo leggibile a macchina.",
        "- `" + MEMORY_BASE_NAME + ".*`: indici GraphMemory usati dal recupero ASK."
    ];
}

function printEmbedStatus() {
    AnsiConsole.markupLine("Embed: [bold]" + resolveEmbedMode() + "[/]" + t(
        " (drop " + EMBED_FILE_NAME + " next to this .malda/.exe for neural synonyms)",
        " (metti " + EMBED_FILE_NAME + " accanto a questo .malda/.exe per sinonimi neurali)"));
}

function appendRetrievalSummary(rows, colKey, colVal) {
    var r = {};
    r[colKey] = t("retrieval", "recupero");
    r[colVal] = "GraphMemory / " + embedLabel();
    rows.append(r);
}

function selectNotesForAsk(brainDir, catalog, question, tagFilter) {
    var memory = getAskMemory(brainDir);
    return selectNotesSemantic(brainDir, catalog, memory, question, tagFilter);
}

function afterNoteSelection(selection) {
    showRetrievalHint(selection);
}

function prepareAskMemory(brainDir, chatOnly) {
    if (not chatOnly) {
        askMemoryCache = null;
        askMemoryCacheDir = "";
        getAskMemory(brainDir);
    }
}

function askModeRetrievalLabel() {
    return t("GraphMemory hybrid", "ibrido GraphMemory");
}

include "sb/04-build.malda";
include "sb/05-ask-common.malda";
include "secondbrain_ask_ui_lib.malda";

function askBrain(cli) {
    AnsiConsole.markupLine("");
    AnsiConsole.panel(
        t("Opens a local web UI with GraphMemory hybrid retrieval — ask questions or generate downloadable documents.",
            "Apre una UI web locale con recupero ibrido GraphMemory — domande o generazione di documenti scaricabili."),
        t("[bold]Mode 3 - ASK (semantic web)[/]", "[bold]Modalita' 3 - CHIEDI (web semantico)[/]"), "rounded");

    var brainDir = resolveAskBrainRoot(cli);
    askApplyProductNameFromBrain(brainDir);
    sbCliApplyProductName(cli);
    sbCliApplyPoweredBy(cli);
    askApplyLogoFromBrain(brainDir);
    askApplyLogoRightFromBrain(brainDir);
    if (askLogoPathMissing()) {
        AnsiConsole.markupLine("[yellow]" + t(
            "ASK_LOGO not found (check path; use / or \\\\ in Windows strings): ",
            "ASK_LOGO non trovato (controlla il path; in stringhe Windows usa / o \\\\): ") +
            ASK_LOGO + "[/]");
    }
    if (askLogoRightPathMissing()) {
        AnsiConsole.markupLine("[yellow]" + t(
            "ASK_LOGO_RIGHT not found (check path; use / or \\\\ in Windows strings): ",
            "ASK_LOGO_RIGHT non trovato (controlla il path; in stringhe Windows usa / o \\\\): ") +
            ASK_LOGO_RIGHT + "[/]");
    }
    var catalog = loadCatalog(brainDir);
    var noteCount = catalogNoteCount(catalog);
    var topicCount = 0;
    var sourceFolder = brainDir;
    var chatOnly = noteCount == 0;
    if (catalog != null) {
        if (catalog.topics != null) {
            topicCount = catalog.topics.length;
        }
        if (catalog.sourceFolder != null and askAsText(catalog.sourceFolder) != "") {
            sourceFolder = catalog.sourceFolder;
        }
    }

    var memory = null;
    var retrievalLabel = t("none (direct chat)", "nessuno (chat diretta)");
    var subtitle = t(
        "Direct chat with the model (no " + productName() + " retrieval).",
        "Chat diretta col modello (nessun recupero da " + productName() + ").");
    if (chatOnly) {
        AnsiConsole.markupLine("[yellow]" + t(
            "No " + productName() + " notes found — ASK will open as direct chat with the model.",
            "Nessuna nota di " + productName() + " — ASK si apre in chat diretta col modello.") + "[/]");
        if (catalog == null) {
            AnsiConsole.markupLine("[dim]" + t("Missing", "Manca") + " " + CATALOG_NAME +
                t(" in ", " in ") + brainDir +
                t(". Run mode 1 later to enable retrieval.",
                    ". Esegui dopo la modalita' 1 per abilitare il recupero.") + "[/]");
        }
    } else {
        askMemoryCache = null;
        askMemoryCacheDir = "";
        memory = getAskMemory(brainDir);
        retrievalLabel = t("lexical fallback", "fallback lessicale");
        subtitle = t(
            "GraphMemory hybrid retrieval (vector + BM25) over the distilled notes.",
            "Recupero ibrido GraphMemory (vettore + BM25) sulle note distillate.");
        if (memory != null) {
            retrievalLabel = "GraphMemory / " + embedLabel();
            try {
                var st0 = memory.stats();
                AnsiConsole.markupLine("[dim]GraphMemory: " + string(st0.nodes) + " " +
                    t("nodes", "nodi") + ", embed=" + embedLabel() + "[/]");
            } catch (statsBootErr) {
            }
        } else {
            AnsiConsole.markupLine("[yellow]" + t(
                "GraphMemory artifacts missing; ASK will use lexical catalog scoring.",
                "Artifact GraphMemory assenti; ASK usera' lo scoring lessicale del catalogo.") + "[/]");
        }
    }

    ui.setState(ASK_STORE, "lang", UI_LANG, ASK_SESSION_ID);
    askSetCatalog(catalog);
    ui.setState(ASK_STORE, "pendingStop", false, ASK_SESSION_ID);
    askSetToolsEnabled(false);
    askClearHistory();
    askSetSession({
        "brainDir": brainDir,
        "chatOnly": chatOnly,
        "noteCount": noteCount,
        "topicCount": topicCount,
        "sourceFolder": sourceFolder,
        "retrieval": retrievalLabel,
        "llm": modelLabel(),
        "title": ASK_PAGE_TITLE,
        "subtitle": subtitle
    });

    if (chatOnly) {
        AnsiConsole.markupLine(t("Mode:", "Modalita':") + " [bold]" +
            t("direct chat", "chat diretta") + "[/]");
    } else {
        AnsiConsole.markupLine(productName() + ": [bold]" + string(noteCount) + "[/] " +
            t("notes", "note") + ", [bold]" +
            string(topicCount) + "[/] " + t("themes", "temi") +
            t(", from `", ", da `") + string(sourceFolder) + "`");
    }
    AnsiConsole.markupLine("LLM: [bold]" + modelLabel() + "[/]");
    AnsiConsole.markupLine(t("Retrieval:", "Recupero:") + " [bold]" + retrievalLabel + "[/]");

    askApplyAuthFromCli(cli);
    askSetAuthUsersRoot(brainDir);
    if (ASK_AUTH_ENABLED) {
        askLoadAuthCredentials();
    }
    if (askRefuseInsecurePublicBind()) {
        return false;
    }
    askHttpServer = new HttpServer(ASK_HTTP_PORT);
    askHttpServer.setHost(ASK_HTTP_HOST);
    if (ASK_HTTPS) {
        askHttpServer.enableHttps(ASK_CERT_PATH, ASK_CERT_PASSWORD);
    }
    askConfigureHttpAuth(askHttpServer);
    askHttpServer.start();
    AnsiConsole.markupLine("");
    askPrintOpenUrlHint();
    AnsiConsole.markupLine("[dim]" + t(
        "Stop the process from the console (Ctrl+C) to return here. The web UI cannot stop the server.",
        "Ferma il processo dalla console (Ctrl+C) per tornare qui. La pagina web non puo' fermare il server.") + "[/]");
    AnsiConsole.markupLine("[dim]" + t(
        "Lexical sibling uses port 39018.",
        "Il sibling lessicale usa la porta 39018.") + "[/]");

    while (askHttpServer != null and askHttpServer.isRunning) {
        if (askConsumePendingStop()) {
            askHttpServer.stop();
            break;
        }
        sleep(200);
    }
    askHttpServer = null;
    AnsiConsole.markupLine(t("ASK server stopped.", "Server ASK fermato."));
    return true;
}

function packPortableAskExe() {
    AnsiConsole.markupLine("");
    AnsiConsole.panel(
        t("Compiles a portable ASK-only .exe that embeds the " + productName() + " folder " +
            "(notes + GraphMemory artifacts, no disk extract). Requires a brain built with mode 1.",
            "Compila un .exe ASK portatile che incorpora la cartella di " + productName() + " " +
            "(note + artifact GraphMemory, nessuna estrazione su disco). Serve un brain " +
            "creato con la modalita' 1."),
        t("[bold]Mode 4 - PACK[/]", "[bold]Modalita' 4 - PACCHETTO[/]"), "rounded");

    var brainDir = str.trim(io.input(t(
        productName() + " folder [" + EMBED_ALIAS + "]: ",
        "Cartella " + productName() + " [" + EMBED_ALIAS + "]: ")));
    if (brainDir == "") {
        brainDir = EMBED_ALIAS;
    }
    applyProductNameFromBrain(brainDir);
    sbCliApplyProductName(cli);
    if (not io.hasDirectory(brainDir)) {
        AnsiConsole.markupLine("[red]" + t("Folder not found:", "Cartella non trovata:") +
            "[/] " + brainDir);
        return false;
    }
    if (not io.hasFile(io.pathJoin(brainDir, CATALOG_NAME))) {
        AnsiConsole.markupLine("[red]" + t("Missing", "Manca") + " " + CATALOG_NAME +
            t(" in ", " in ") + brainDir +
            t(". Run mode 1 (BUILD) first.", ". Esegui prima la modalita' 1 (COSTRUISCI).") + "[/]");
        return false;
    }

    var outputPath = str.trim(io.input(t(
        "Output exe [" + DEFAULT_PACK_OUTPUT + "]: ",
        "Exe di output [" + DEFAULT_PACK_OUTPUT + "]: ")));
    if (outputPath == "") {
        outputPath = DEFAULT_PACK_OUTPUT;
    }
    // If the user types a folder, pack into <folder>/<default exe name>.
    if (io.hasDirectory(outputPath)) {
        var packExeName = io.getFileName(DEFAULT_PACK_OUTPUT);
        if (packExeName == "") {
            packExeName = "SecondBrain.exe";
        }
        outputPath = io.pathJoin(outputPath, packExeName);
    }

    var sourcePath = io.pathJoin(getProgramDirectory(), SOURCE_SCRIPT_NAME);
    if (not io.hasFile(sourcePath)) {
        sourcePath = SOURCE_SCRIPT_NAME;
    }
    if (not io.hasFile(sourcePath)) {
        AnsiConsole.markupLine("[red]" + t("Source script not found:", "Sorgente non trovato:") +
            "[/] " + SOURCE_SCRIPT_NAME);
        return false;
    }

    // Keep the runtime alias stable so the packed exe auto-starts ASK.
    var embedSpec = brainDir + "=" + EMBED_ALIAS;
    AnsiConsole.markupLine("[dim]" + t("Compiling (this may take a minute)…",
        "Compilazione in corso (puo' richiedere un minuto)…") + "[/]");
    AnsiConsole.markupLine("[dim]compileMALDA(\"" + sourcePath + "\", \"" + outputPath +
        "\", \"transpile\", \"" + embedSpec + "\")[/]");
    AnsiConsole.markupLine("[dim]" + t(
        "Tip: copy " + EMBED_FILE_NAME + " next to the .exe for neural retrieval (GGUF is not embedded).",
        "Suggerimento: copia " + EMBED_FILE_NAME +
            " accanto all'.exe per il recupero neurale (il GGUF non viene incorporato).") + "[/]");

    var result = compileMALDA(sourcePath, outputPath, "transpile", embedSpec);
    if (result == null or result.success != true) {
        var err = "";
        if (result != null and result.error != null) {
            err = string(result.error);
        }
        if (err == "") {
            err = t("Unknown compilation error.", "Errore di compilazione sconosciuto.");
        }
        // Escape dynamic text: compile errors often contain [paths] that Spectre would treat as styles.
        AnsiConsole.markupLine("[red]" + t("Pack failed:", "Pacchetto non riuscito:") +
            "[/] " + str.replace(str.replace(err, "[", "[["), "]", "]]"));
        return false;
    }

    var written = outputPath;
    if (result.outputPath != null and string(result.outputPath) != "") {
        written = string(result.outputPath);
    }
    AnsiConsole.markupLine("[green]" + t("Portable ASK exe ready:", "Exe ASK portatile pronto:") +
        "[/] [bold]" + str.replace(str.replace(string(written), "[", "[["), "]", "]]") + "[/]");
    AnsiConsole.markupLine("[dim]" + t(
        "Run the .exe to open ASK with the embedded brain. Optional: --port 8080 (or -p), --host 0.0.0.0. " +
            "Branding in the brain folder (auto-loaded): product_name.txt, logo_right_height.txt, and optional logo.png / logo_right.png.",
        "Avvia l'.exe per aprire ASK col brain incorporato. Opzionale: --port 8080 (o -p), --host 0.0.0.0. " +
            "Branding nella cartella del brain (auto-caricato): product_name.txt, logo_right_height.txt e logo.png / logo_right.png opzionali.") + "[/]");
    return true;
}

// ---------------------------------------------------------------- menu

function showMenu() {
    AnsiConsole.markupLine("");
    AnsiConsole.panel(
        t("[bold]1[/]  BUILD   distill notes + index GraphMemory\n" +
            "[bold]2[/]  UPDATE  refresh brain from new/changed source files only\n" +
            "[bold]3[/]  ASK     web UI — questions and document generation (GraphMemory)\n" +
            "[bold]4[/]  language  switch UI language (English / Italian)\n" +
            "[bold]5[/]  PACK    portable ASK .exe with embedded " + productName() + "\n" +
            "[bold]0[/]  quit\n\n" +
            "[dim]Lexical sibling: Examples/Agents/secondbrain.malda (port 39018)[/]",
            "[bold]1[/]  COSTRUISCI  distilla note + indicizza GraphMemory\n" +
            "[bold]2[/]  AGGIORNA    aggiorna il brain solo con file nuovi/modificati\n" +
            "[bold]3[/]  CHIEDI      UI web — domande e generazione documenti (GraphMemory)\n" +
            "[bold]4[/]  lingua      cambia lingua interfaccia (English / Italiano)\n" +
            "[bold]5[/]  PACCHETTO  .exe ASK portatile con " + productName() + " incorporato\n" +
            "[bold]0[/]  esci\n\n" +
            "[dim]Sibling lessicale: Examples/Agents/secondbrain.malda (porta 39018)[/]"),
        "[bold blue]MALDA " + productName() + " (semantic)[/]", "double");
}

var cliOpts = sbCliParseArgs(getCommandLineArgs());

if (cliOpts.error != "") {
    AnsiConsole.markupLine("[red]" + cliOpts.error + "[/]");
    sbCliPrintHelp(DEFAULT_BRAIN_DIR, ASK_HTTP_PORT);
    exit(1);
}

if (io.hasEmbeddedFolder("secondbrain_semantic")) {
    // Portable ASK-only exe: skip console menu/language — ASK web UI has EN/IT.
    if (cliOpts.mode == "build" or cliOpts.mode == "update" or cliOpts.mode == "pack") {
        AnsiConsole.markupLine("[red]" + t(
            "Packed ASK exe supports ask and generate only (not build/update/pack).",
            "L'exe ASK packato supporta solo ask e generate (non build/update/pack).") + "[/]");
        exit(1);
    }
    if (cliOpts.mode == "help") {
        sbCliPrintHelp(DEFAULT_BRAIN_DIR, ASK_HTTP_PORT);
        exit(0);
    }
    sbCliApplyLang(cliOpts);
    sbCliApplyProductName(cliOpts);
    if (cliOpts.mode == "generate") {
        if (generateDocumentCli(cliOpts)) {
            exit(0);
        }
        exit(1);
    }
    if (cliOpts.port != null) {
        sbCliApplyPort(cliOpts);
    } else {
        applyAskHttpPortFromCli();
    }
    if (cliOpts.host != null) {
        sbCliApplyHost(cliOpts);
    } else {
        applyAskHttpHostFromCli();
    }
    if (cliOpts.https == true) {
        sbCliApplyHttps(cliOpts);
    } else {
        if (applyAskHttpsFromCli() != true) {
            exit(1);
        }
    }
    askBrain(cliOpts);
} else if (cliOpts.mode == "help") {
    sbCliApplyLang(cliOpts);
    sbCliApplyProductName(cliOpts);
    sbCliPrintHelp(DEFAULT_BRAIN_DIR, ASK_HTTP_PORT);
    exit(0);
} else if (cliOpts.mode == "pack") {
    AnsiConsole.markupLine("[yellow]" + t(
        "PACK is interactive — use menu option 5.",
        "PACK e' interattivo — usa la voce di menu 5.") + "[/]");
    exit(1);
} else if (cliOpts.mode == "build" or cliOpts.mode == "update" or cliOpts.mode == "ask" or
        cliOpts.mode == "generate") {
    sbCliApplyLang(cliOpts);
    sbCliApplyProductName(cliOpts);
    if (cliOpts.lang == "") {
        ui.setState(ASK_STORE, "lang", UI_LANG, ASK_SESSION_ID);
    }
    if (cliOpts.mode == "ask") {
        if (cliOpts.port != null) {
            sbCliApplyPort(cliOpts);
        } else {
            applyAskHttpPortFromCli();
        }
        if (cliOpts.host != null) {
            sbCliApplyHost(cliOpts);
        } else {
            applyAskHttpHostFromCli();
        }
        if (cliOpts.https == true) {
            sbCliApplyHttps(cliOpts);
        } else {
            if (applyAskHttpsFromCli() != true) {
                exit(1);
            }
        }
        askBrain(cliOpts);
        exit(0);
    }
    if (cliOpts.mode == "generate") {
        if (generateDocumentCli(cliOpts)) {
            exit(0);
        }
        exit(1);
    }
    var ok = false;
    if (cliOpts.mode == "build") {
        ok = buildBrain(cliOpts);
    } else {
        ok = updateBrain(cliOpts);
    }
    if (ok) {
        exit(0);
    }
    exit(1);
} else {
    chooseLanguage();
    sbCliApplyProductName(cliOpts);
    if (cliOpts.port != null) {
        sbCliApplyPort(cliOpts);
    } else {
        applyAskHttpPortFromCli();
    }
    if (cliOpts.host != null) {
        sbCliApplyHost(cliOpts);
    } else {
        applyAskHttpHostFromCli();
    }
    if (cliOpts.https == true) {
        sbCliApplyHttps(cliOpts);
    } else {
        if (applyAskHttpsFromCli() != true) {
            exit(1);
        }
    }
    showMenu();
    while (true) {
        var choice = str.trim(io.input(t("Choice (1/2/3/4/5/0): ", "Scelta (1/2/3/4/5/0): ")));
        if (choice == "" or choice == "0") {
            io.print(t("Goodbye.", "A presto."));
            break;
        }
        if (choice == "1") {
            buildBrain(null);
            showMenu();
        } else if (choice == "2") {
            updateBrain(null);
            showMenu();
        } else if (choice == "3") {
            askBrain(null);
            showMenu();
        } else if (choice == "4") {
            chooseLanguage();
            showMenu();
        } else if (choice == "5") {
            packPortableAskExe();
            showMenu();
        } else {
            AnsiConsole.markupLine("[yellow]" + t("Invalid choice.", "Scelta non valida.") + "[/]");
        }
    }
}
