// ops_report.malda — leave a FAILED instance for malda workflow report
// Run: malda Examples/Workflows/ops_report.malda
// Then (same working directory / DB):
//   malda workflow report <instanceId>
//   malda workflow report <instanceId> --json
//   malda workflow dlq list --pending-only
// Persistence: ./.malda/workflows.db (local SQLite; no cloud).

function alwaysFail() {
    error("ops smoke: storage unavailable");
}

workflow OpsReportJob(input) {
    step task = alwaysFail() retry 1 backoff "fixed" delay 1;
    return task;
}

io.print("=== ops report smoke (terminal failure expected) ===");
var failId = null;
try {
    failId = startWorkflow("OpsReportJob", null);
} catch (err) {
    io.print("startWorkflow threw (expected): " + err);
}

var failed = listWorkflows("FAILED", "OpsReportJob", 5);
if (str.length(failed) > 0) {
    failId = failed[0].id;
}

if (failId == null) {
    error("ops_report: expected a FAILED OpsReportJob instance");
}

io.print("instanceId=" + failId);
io.print("status=" + getWorkflowStatus(failId));
io.print("");
io.print("Inspect with:");
io.print("  malda workflow report " + failId);
io.print("  malda workflow report " + failId + " --json");
io.print("  malda workflow dlq list --pending-only");
io.print("Done.");
