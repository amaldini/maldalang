// retry_and_inspect.malda — durable workflow retry, inspect, and dead-letter peek
// Run: malda Examples/Workflows/retry_and_inspect.malda
// Persistence: ./.malda/workflows.db (local SQLite; no cloud).
//
// CLI footnote (not used here): malda workflow report|list|get|steps|dlq|maintenance run ...
// For a CLI-first ops smoke, see ops_report.malda.

var attempt = 0;

function flakyThenOk() {
    attempt = attempt + 1;
    if (attempt < 2) {
        error("temporary glitch on attempt " + attempt);
    }
    return "recovered on attempt " + attempt;
}

function alwaysFail() {
    error("storage unavailable");
}

workflow RecoverableJob(input) {
    step result = flakyThenOk() retry 2 backoff "fixed" delay 1;
    return result;
}

workflow TerminalFailJob(input) {
    step task = alwaysFail() retry 1 backoff "fixed" delay 1;
    return task;
}

io.print("=== recoverable workflow (retries then succeeds) ===");
var okId = startWorkflow("RecoverableJob", null);
io.print("id=" + okId + " status=" + getWorkflowStatus(okId));
var okSteps = getWorkflowSteps(okId);
io.print("steps:");
for (var k = 0; k < str.length(okSteps); k = k + 1) {
    var okStep = okSteps[k];
    io.print("  " + okStep.step_name + " state=" + okStep.state + " attempt=" + okStep.attempt +
        " output=" + okStep.output_json);
}

io.print("=== terminal failure (caught so the script exits 0) ===");
var failId = null;
try {
    failId = startWorkflow("TerminalFailJob", null);
} catch (err) {
    io.print("startWorkflow threw (expected): " + err);
}

var failed = listWorkflows("FAILED", "TerminalFailJob", 5);
io.print("FAILED TerminalFailJob count=" + str.length(failed));
if (str.length(failed) > 0) {
    failId = failed[0].id;
    io.print("inspect id=" + failId + " status=" + getWorkflowStatus(failId));

    var steps = getWorkflowSteps(failId);
    io.print("steps:");
    for (var i = 0; i < str.length(steps); i = i + 1) {
        var s = steps[i];
        io.print("  " + s.step_name + " state=" + s.state + " attempt=" + s.attempt);
    }

    var events = getWorkflowEvents(failId, 20);
    io.print("events:");
    for (var j = 0; j < str.length(events); j = j + 1) {
        var e = events[j];
        io.print("  " + e.event_type);
    }
}

var deadLetters = listWorkflowDeadLetters(20, false);
io.print("pending dead letters=" + str.length(deadLetters));
if (str.length(deadLetters) > 0) {
    var dl = deadLetters[0];
    io.print("  dlq step=" + dl.step_name + " workflow=" + dl.workflow_instance_id);
}

io.print("Done.");
