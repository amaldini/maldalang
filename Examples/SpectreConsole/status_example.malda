// Spectre.Console Status Example
// Demonstrates status spinner with async operations

// Simple status spinner
AnsiConsole.status("Processing...", () => {
  var delay = 0;
  while (delay < 100) {
    delay = delay + 1;
  }
});

AnsiConsole.markupLine("[green]Done![/]");
AnsiConsole.markupLine("");

// Status with multiple operations
AnsiConsole.status("Loading data...", () => {
  var delay = 0;
  while (delay < 50) {
    delay = delay + 1;
  }
});

AnsiConsole.markupLine("[blue]Data loaded[/]");
AnsiConsole.markupLine("");

AnsiConsole.status("Processing files...", () => {
  var delay = 0;
  while (delay < 50) {
    delay = delay + 1;
  }
});

AnsiConsole.markupLine("[blue]Files processed[/]");
AnsiConsole.markupLine("");

AnsiConsole.status("Finalizing...", () => {
  var delay = 0;
  while (delay < 50) {
    delay = delay + 1;
  }
});

AnsiConsole.markupLine("[green]All operations completed![/]");
