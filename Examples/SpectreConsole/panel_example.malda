// Spectre.Console Panel Example
// Demonstrates displaying content in panels

var content = "This is important information that needs to be highlighted.\n" +
              "Panels are great for drawing attention to specific content.\n" +
              "You can use different border styles to match your design.";

// Panel with title
AnsiConsole.panel(content, "Important Notice");

AnsiConsole.markupLine("");

// Panel with rounded border
var code = "function greet(name) {\n" +
           "  return 'Hello, ' + name + '!';\n" +
           "}";

AnsiConsole.panel(code, "Code Example", "rounded");

AnsiConsole.markupLine("");

// Panel with double border
var warning = "⚠ WARNING: This operation cannot be undone!\n" +
              "Please make sure you want to proceed.";

AnsiConsole.panel(warning, "Warning", "double");

AnsiConsole.markupLine("");

// Panel with heavy border
var success = "✓ Operation completed successfully!\n" +
              "All files have been processed.";

AnsiConsole.panel(success, "Success", "heavy");

AnsiConsole.markupLine("");

// Simple panel without title
AnsiConsole.panel("This is a simple panel without a title.");
