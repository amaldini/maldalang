// LLM Server - Cost Optimization Example
// Cost-based routing between local and cloud backends

var PORT = 8080;
var MODEL_PATH = "models/qwen2.5-0.5b-instruct-q4_k_m.gguf";
var localAppData = io.getEnv("LOCALAPPDATA");
if (localAppData != null && localAppData != "") {
    MODEL_PATH = localAppData + "/MaldaLang/Models/default/qwen2.5-0.5b-instruct-q4_k_m.gguf";
}

io.print("=== LLM Server - Cost Optimization Example ===");
io.print("Setting up cost-optimized configuration...");

// Create bridge with local and cloud backends
var bridge = new LLMClientBridge([
    {
        "type": "local",
        "modelPath": MODEL_PATH,
        "cost": 0.0  // Free local model
    },
    {
        "type": "api",
        "url": "https://api.openai.com/v1",
        "apiKey": "sk-your-api-key",
        "model": "gpt-4",
        "cost": 0.03  // $0.03 per 1K tokens
    },
    {
        "type": "api",
        "url": "https://api.openai.com/v1",
        "apiKey": "sk-your-api-key",
        "model": "gpt-3.5-turbo",
        "cost": 0.0015  // $0.0015 per 1K tokens
    }
]);

// Use cost-based routing
bridge.setRoutingStrategy("cost");

io.print("Cost optimization configuration:");
io.print("  - Backend 1: Local model (free)");
io.print("  - Backend 2: GPT-4 ($0.03/1K tokens)");
io.print("  - Backend 3: GPT-3.5-turbo ($0.0015/1K tokens)");
io.print("  - Routing strategy: Cost-based");
io.print("");
io.print("The server will route requests to the most cost-effective backend.");
io.print("");

io.print("Starting server on port " + string(PORT) + "...");
var server = new LLMServer(bridge, PORT);
server.start();

io.print("Server started successfully!");
io.print("");
io.print("Cost optimization features:");
io.print("  - Simple queries → Local model (free)");
io.print("  - Complex queries → GPT-3.5-turbo (cheap)");
io.print("  - Very complex queries → GPT-4 (expensive but powerful)");
io.print("");
io.print("Server running. Press Ctrl+C to stop.");

// Keep server running
while (server.isRunning) {
    sleep(1000);
}

io.print("Server stopped.");
