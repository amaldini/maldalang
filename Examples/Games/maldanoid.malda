var root = dom.query("#app");

if (root == null) {
    println("No #app container found.");
} else {
    dom.clear(root);

    var head = dom.query("head");
    if (head != null) {
        var styleNode = dom.create("style");
        var styleText = "body { margin: 0; background: #020617; }\n";
        styleText = styleText + "#app canvas { width: 100%; max-width: 960px; height: auto; display: block; margin: 0 auto; }\n";
        dom.setText(styleNode, styleText);
        dom.append(head, styleNode);
    }

    var canvasWidth = 960;
    var canvasHeight = 600;

    var paddleBaseWidth = 130;
    var paddleHeight = 18;
    var paddleY = canvasHeight - 44;
    var paddleX = (canvasWidth - paddleBaseWidth) / 2;
    var paddleVx = 0;
    var paddleWidth = paddleBaseWidth;
    var paddleSpeed = 640;

    var ballRadius = 10;
    var ballsX = [];
    var ballsY = [];
    var ballsVx = [];
    var ballsVy = [];
    var ballSpeedCap = 690;
    var maxBalls = 3;
    var ballTrailX = [];
    var ballTrailY = [];
    var ballTrailLife = [];
    var ballTrailMax = 22;
    var sparkX = [];
    var sparkY = [];
    var sparkVx = [];
    var sparkVy = [];
    var sparkLife = [];
    var sparkColor = [];
    var sparkMax = 48;
    var shakeMs = 0;
    var shakeMag = 0;
    var serveAim = 0.35;
    var brickAnimClockMs = 0;

    var score = 0;
    var highScore = 0;
    var bestCombo = 0;
    var savedStats = game.load("maldanoid_save");
    if (savedStats != null) {
        if (savedStats.high != null) {
            highScore = savedStats.high;
        }
        if (savedStats.bestCombo != null) {
            bestCombo = savedStats.bestCombo;
        }
    } else {
        var savedHigh = game.load("maldanoid_high");
        if (savedHigh != null) {
            highScore = savedHigh;
        }
    }
    var combo = 0;
    var comboFlashMs = 0;
    var lastBrickHit = -1;
    var lastBrickCoolMs = 0;
    var pauseResumeState = "serve";
    var lives = 3;
    var level = 1;
    var maxLevel = 3;
    var state = "serve"; // serve, playing, paused, gameover, win
    var splashDismissed = false;
    var stateTextTimerMs = 0;
    var bricksLeft = 0;
    var levelClearTimerMs = 0;

    var starsX = [];
    var starsY = [];
    var starsSpeed = [];
    var starsSize = [];

    var bricksX = [];
    var bricksY = [];
    var bricksW = [];
    var bricksH = [];
    var bricksHp = [];
    var bricksMaxHp = [];
    var bricksAlive = [];
    var bricksRow = [];
    var bricksCol = [];
    var bricksColor = [];
    var brickGridRows = 0;
    var brickGridCols = 0;
    var brickGridGap = 0;
    var brickGridMarginX = 0;
    var brickGridTopY = 0;
    var brickMoveTimerMs = 0;
    var brickMoveIntervalMs = 430;
    var brickMoveDurationMs = 170;
    var bricksMoveActive = [];
    var bricksMoveFromX = [];
    var bricksMoveFromY = [];
    var bricksMoveToX = [];
    var bricksMoveToY = [];
    var bricksMoveElapsed = [];
    var brickRngState = 104729;

    var puX = [];
    var puY = [];
    var puVy = [];
    var puType = [];
    var puActive = [];

    var expandTimerMs = 0;
    var slowTimerMs = 0;
    var audioBooted = false;
    var gameOverSfxPlayed = false;
    var winSfxPlayed = false;
    var bgmTrackPrimaryUrl = "Examples/Web/wwwroot/audio/maldanoid.mp3";
    var bgmBootstrapState = "idle"; // idle, requested, failed

    var lastMouseX = 0;
    var mouseAttached = true;
    var prevMouseDown = false;
    var mouseDown = false;

    function abs(v) {
        if (v < 0) {
            return 0 - v;
        }
        return v;
    }

    function clamp(v, mn, mx) {
        var out = v;
        if (out < mn) {
            out = mn;
        }
        if (out > mx) {
            out = mx;
        }
        return out;
    }

    function formatMsWithTenths(ms) {
        if (ms < 0) {
            ms = 0;
        }
        var displayMs = ms + 1000;
        if (displayMs < 0) {
            displayMs = 0;
        }
        // Approximate integer division using math that compiles cleanly to JS.
        var tenths = (displayMs - (displayMs % 100)) / 100;
        if (tenths < 0) {
            tenths = 0;
        }
        var whole = (tenths - (tenths % 10)) / 10;
        var frac = tenths % 10;
        return whole + "." + frac;
    }

    function persistStats() {
        var changed = false;
        if (score > highScore) {
            highScore = score;
            changed = true;
        }
        if (combo > bestCombo) {
            bestCombo = combo;
            changed = true;
        }
        if (changed) {
            game.save("maldanoid_save", { "high": highScore, "bestCombo": bestCombo });
        }
    }

    function punchCamera(ms, mag) {
        if (ms >= shakeMs) {
            shakeMs = ms;
            shakeMag = mag;
        }
    }

    function spawnSparks(cx, cy, color, count) {
        var n = 0;
        while (n < count) {
            var slot = -1;
            var s = 0;
            while (s < sparkLife.length) {
                if (sparkLife[s] <= 0) {
                    slot = s;
                    break;
                }
                s = s + 1;
            }
            var ang = (n * 0.85) + ((cx + cy + brickAnimClockMs) * 0.01);
            var sp = 90 + ((n * 41) % 150);
            var vx = math.cos(ang) * sp;
            var vy = (math.sin(ang) * sp) - 40;
            if (slot >= 0) {
                sparkX[slot] = cx;
                sparkY[slot] = cy;
                sparkVx[slot] = vx;
                sparkVy[slot] = vy;
                sparkLife[slot] = 280;
                sparkColor[slot] = color;
            } else {
                if (sparkX.length < sparkMax) {
                    sparkX[sparkX.length] = cx;
                    sparkY[sparkY.length] = cy;
                    sparkVx[sparkVx.length] = vx;
                    sparkVy[sparkVy.length] = vy;
                    sparkLife[sparkLife.length] = 280;
                    sparkColor[sparkColor.length] = color;
                }
            }
            n = n + 1;
        }
    }

    function updateSparks(dt) {
        var i = 0;
        while (i < sparkLife.length) {
            if (sparkLife[i] > 0) {
                sparkLife[i] = sparkLife[i] - dt;
                sparkX[i] = sparkX[i] + ((sparkVx[i] * dt) / 1000);
                sparkY[i] = sparkY[i] + ((sparkVy[i] * dt) / 1000);
                sparkVy[i] = sparkVy[i] + ((420 * dt) / 1000);
            }
            i = i + 1;
        }
    }

    function tryStartMusicTrack() {
        if (!audioBooted) {
            return;
        }
        if (bgmBootstrapState != "idle") {
            return;
        }
        bgmBootstrapState = "requested";
        game.audioLoadTrack(bgmTrackPrimaryUrl, { "autoplay": true, "loop": true, "volume": 0.42 });
    }

    function tryBootAudio() {
        if (audioBooted) {
            tryStartMusicTrack();
            return;
        }

        var wantsAudio =
            game.isKeyDown(" ") ||
            game.isMouseDown(0) ||
            game.isKeyDown("arrowleft") ||
            game.isKeyDown("arrowright") ||
            game.isKeyDown("a") ||
            game.isKeyDown("d") ||
            game.isKeyDown("r") ||
            game.isKeyDown("enter") ||
            game.wasGamepadButtonPressed(0, 0) ||
            game.isGamepadButtonDown(0, 14) ||
            game.isGamepadButtonDown(0, 15);

        if (!wantsAudio) {
            return;
        }

        game.audioInit();
        game.audioSetMasterVolume(0.42);
        audioBooted = true;
        tryStartMusicTrack();
    }

    function addBall(x, y, vx, vy) {
        ballsX[ballsX.length] = x;
        ballsY[ballsY.length] = y;
        ballsVx[ballsVx.length] = vx;
        ballsVy[ballsVy.length] = vy;
    }

    function removeBall(index) {
        var last = ballsX.length - 1;
        if (index < 0 || index > last) {
            return;
        }
        ballsX[index] = ballsX[last];
        ballsY[index] = ballsY[last];
        ballsVx[index] = ballsVx[last];
        ballsVy[index] = ballsVy[last];
        ballsX.length = last;
        ballsY.length = last;
        ballsVx.length = last;
        ballsVy.length = last;
    }

    function resetBallOnPaddle(direction) {
        ballsX = [];
        ballsY = [];
        ballsVx = [];
        ballsVy = [];
        addBall(
            paddleX + (paddleWidth / 2),
            paddleY - ballRadius - 2,
            40 * direction,
            -250
        );
        ballTrailX = [];
        ballTrailY = [];
        ballTrailLife = [];
        lastBrickHit = -1;
        lastBrickCoolMs = 0;
    }

    function rebuildStars() {
        starsX = [];
        starsY = [];
        starsSpeed = [];
        starsSize = [];

        var i = 0;
        while (i < 70) {
            var seedA = ((i * 97) + (level * 131)) % canvasWidth;
            var seedB = ((i * 53) + (level * 193)) % canvasHeight;
            var seedS = 25 + ((i * 29) % 120);
            var seedZ = 1 + (i % 3);
            starsX[starsX.length] = seedA;
            starsY[starsY.length] = seedB;
            starsSpeed[starsSpeed.length] = seedS;
            starsSize[starsSize.length] = seedZ;
            i = i + 1;
        }
    }

    function clearBricks() {
        bricksX = [];
        bricksY = [];
        bricksW = [];
        bricksH = [];
        bricksHp = [];
        bricksMaxHp = [];
        bricksAlive = [];
        bricksRow = [];
        bricksCol = [];
        bricksColor = [];
        bricksMoveActive = [];
        bricksMoveFromX = [];
        bricksMoveFromY = [];
        bricksMoveToX = [];
        bricksMoveToY = [];
        bricksMoveElapsed = [];
        bricksLeft = 0;
        brickMoveTimerMs = 0;
    }

    function brickColorByHp(hp, maxHp, row) {
        var palette = ["#ef4444", "#f97316", "#facc15", "#22c55e", "#14b8a6", "#3b82f6", "#8b5cf6", "#ec4899"];
        var base = palette[row % palette.length];
        if (maxHp == 3) {
            if (hp == 3) return base;
            if (hp == 2) return "#cbd5e1";
            return "#e2e8f0";
        }
        if (maxHp == 2) {
            if (hp == 2) return base;
            return "#cbd5e1";
        }
        return base;
    }

    function triWave01(t, periodMs) {
        var p = t % periodMs;
        var half = periodMs / 2;
        if (p < half) {
            return p / half;
        }
        return (periodMs - p) / half;
    }

    function hslColor(h, s, l) {
        var hue = h % 360;
        if (hue < 0) {
            hue = hue + 360;
        }
        var sat = clamp(s, 0, 100);
        var light = clamp(l, 0, 100);
        return "hsl(" + string(hue) + "," + string(sat) + "%," + string(light) + "%)";
    }

    function nextBrickRand(maxExclusive) {
        if (maxExclusive <= 1) {
            return 0;
        }
        // Runtime-safe pseudo-random generator (no randomInt dependency).
        brickRngState = ((brickRngState * 48271) + (level * 31) + bricksLeft + combo + 17) % 2147483647;
        if (brickRngState < 0) {
            brickRngState = 0 - brickRngState;
        }
        return brickRngState % maxExclusive;
    }

    function animatedBrickColor(index) {
        var hp = bricksHp[index];
        var maxHp = bricksMaxHp[index];
        var row = bricksRow[index];
        var wave = triWave01(brickAnimClockMs + (row * 170) + (index * 51), 2400);
        var pulse = (wave - 0.5) * 2;

        if (hp >= maxHp) {
            var hueShift = brickAnimClockMs / 95;
            var hue = (row * 41) + hueShift + (index * 3);
            var light = 55 + (pulse * 6);
            return hslColor(hue, 83, light);
        }

        if (maxHp == 3 && hp == 1) {
            return hslColor(210 + (pulse * 4), 30, 86 + (pulse * 2));
        }
        return hslColor(206 + (pulse * 5), 36, 80 + (pulse * 2));
    }

    function addBrick(x, y, w, h, hp, row, col) {
        bricksX[bricksX.length] = x;
        bricksY[bricksY.length] = y;
        bricksW[bricksW.length] = w;
        bricksH[bricksH.length] = h;
        bricksHp[bricksHp.length] = hp;
        bricksMaxHp[bricksMaxHp.length] = hp;
        bricksAlive[bricksAlive.length] = true;
        bricksRow[bricksRow.length] = row;
        bricksCol[bricksCol.length] = col;
        bricksColor[bricksColor.length] = brickColorByHp(hp, hp, row);
        bricksMoveActive[bricksMoveActive.length] = false;
        bricksMoveFromX[bricksMoveFromX.length] = x;
        bricksMoveFromY[bricksMoveFromY.length] = y;
        bricksMoveToX[bricksMoveToX.length] = x;
        bricksMoveToY[bricksMoveToY.length] = y;
        bricksMoveElapsed[bricksMoveElapsed.length] = 0;
        bricksLeft = bricksLeft + 1;
    }

    function buildLevel(levelId) {
        clearBricks();
        rebuildStars();

        var rows = 7 + levelId;
        var cols = 12;
        var gap = 8;
        var marginX = 70;
        var topY = 80;
        var brickWVal = (canvasWidth - (marginX * 2) - (gap * (cols - 1))) / cols;
        var brickHVal = 24;
        brickGridRows = rows;
        brickGridCols = cols;
        brickGridGap = gap;
        brickGridMarginX = marginX;
        brickGridTopY = topY;

        var r = 0;
        while (r < rows) {
            var c = 0;
            while (c < cols) {
                var x = marginX + (c * (brickWVal + gap));
                var y = topY + (r * (brickHVal + gap));

                var hp = 1;
                if (levelId >= 2 && ((r + c) % 3 == 0)) {
                    hp = 2;
                }
                if (levelId >= 3 && (r % 2 == 0) && (c % 4 == 0)) {
                    hp = 3;
                }

                if (levelId == 1 || r < 7 || (c % 2 == 0)) {
                    addBrick(x, y, brickWVal, brickHVal, hp, r, c);
                }

                c = c + 1;
            }
            r = r + 1;
        }
    }

    function brickAtCell(row, col, ignoreIndex) {
        var i = 0;
        while (i < bricksX.length) {
            if (i != ignoreIndex && bricksAlive[i] && bricksRow[i] == row && bricksCol[i] == col) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    function isCellWithinBrickGrid(row, col) {
        return row >= 0 && row < brickGridRows && col >= 0 && col < brickGridCols;
    }

    function setBrickToCell(index, row, col) {
        bricksRow[index] = row;
        bricksCol[index] = col;
        bricksX[index] = brickGridMarginX + (col * (bricksW[index] + brickGridGap));
        bricksY[index] = brickGridTopY + (row * (bricksH[index] + brickGridGap));
        bricksMoveActive[index] = false;
        bricksMoveFromX[index] = bricksX[index];
        bricksMoveFromY[index] = bricksY[index];
        bricksMoveToX[index] = bricksX[index];
        bricksMoveToY[index] = bricksY[index];
        bricksMoveElapsed[index] = 0;
    }

    function beginBrickMoveToCell(index, row, col) {
        var targetX = brickGridMarginX + (col * (bricksW[index] + brickGridGap));
        var targetY = brickGridTopY + (row * (bricksH[index] + brickGridGap));

        // Reserve the destination grid cell immediately to avoid overlaps.
        bricksRow[index] = row;
        bricksCol[index] = col;
        bricksMoveActive[index] = true;
        bricksMoveFromX[index] = bricksX[index];
        bricksMoveFromY[index] = bricksY[index];
        bricksMoveToX[index] = targetX;
        bricksMoveToY[index] = targetY;
        bricksMoveElapsed[index] = 0;
    }

    function tryMoveBrickToRandomAdjacent(index) {
        if (!bricksAlive[index]) {
            return false;
        }
        if (bricksMoveActive[index]) {
            return false;
        }

        var row = bricksRow[index];
        var col = bricksCol[index];
        var dirStart = nextBrickRand(4);
        var offset = 0;
        while (offset < 4) {
            var dir = (dirStart + offset) % 4;
            var nextRow = row;
            var nextCol = col;

            if (dir == 0) {
                nextRow = row - 1;
            } else if (dir == 1) {
                nextCol = col + 1;
            } else if (dir == 2) {
                nextRow = row + 1;
            } else {
                nextCol = col - 1;
            }

            if (isCellWithinBrickGrid(nextRow, nextCol) && brickAtCell(nextRow, nextCol, index) < 0) {
                beginBrickMoveToCell(index, nextRow, nextCol);
                return true;
            }
            offset = offset + 1;
        }
        return false;
    }

    function updateBrickAnimations(dt) {
        if (state != "playing") {
            return;
        }

        var i = 0;
        while (i < bricksX.length) {
            if (bricksAlive[i] && bricksMoveActive[i]) {
                var elapsed = bricksMoveElapsed[i] + dt;
                bricksMoveElapsed[i] = elapsed;

                var t = elapsed / brickMoveDurationMs;
                if (t >= 1) {
                    t = 1;
                }
                if (t < 0) {
                    t = 0;
                }

                bricksX[i] = bricksMoveFromX[i] + ((bricksMoveToX[i] - bricksMoveFromX[i]) * t);
                bricksY[i] = bricksMoveFromY[i] + ((bricksMoveToY[i] - bricksMoveFromY[i]) * t);

                if (t >= 1) {
                    bricksMoveActive[i] = false;
                    bricksX[i] = bricksMoveToX[i];
                    bricksY[i] = bricksMoveToY[i];
                }
            }
            i = i + 1;
        }
    }

    function updateMovingBricks(dt) {
        if (state != "playing") {
            return;
        }
        if (bricksLeft <= 0 || bricksX.length <= 0) {
            return;
        }

        brickMoveTimerMs = brickMoveTimerMs + dt;
        if (brickMoveTimerMs < brickMoveIntervalMs) {
            return;
        }

        var ticks = (brickMoveTimerMs - (brickMoveTimerMs % brickMoveIntervalMs)) / brickMoveIntervalMs;
        brickMoveTimerMs = brickMoveTimerMs % brickMoveIntervalMs;
        if (ticks > 3) {
            ticks = 3;
        }

        var t = 0;
        while (t < ticks) {
            var tries = 0;
            while (tries < 3) {
                var index = nextBrickRand(bricksX.length);
                if (bricksAlive[index] && tryMoveBrickToRandomAdjacent(index)) {
                    break;
                }
                tries = tries + 1;
            }
            t = t + 1;
        }
    }

    function spawnPowerUp(x, y, seed) {
        var dropType = "expand";
        var roll = seed % 10;
        if (roll == 2 || roll == 7) {
            dropType = "slow";
        }
        if (roll == 4) {
            dropType = "multiball";
        }
        if (roll == 9) {
            dropType = "life";
        }

        puX[puX.length] = x;
        puY[puY.length] = y;
        puVy[puVy.length] = 160 + ((seed % 4) * 20);
        puType[puType.length] = dropType;
        puActive[puActive.length] = true;
    }

    function applyPowerUp(kind) {
        if (kind == "expand") {
            expandTimerMs = 14000;
            paddleWidth = paddleBaseWidth + 70;
            stateTextTimerMs = 1300;
            game.audioPlayTone(610, 55, "triangle", 0.12);
        } else if (kind == "slow") {
            slowTimerMs = 9000;
            stateTextTimerMs = 1300;
            game.audioPlayTone(480, 70, "sine", 0.11);
        } else if (kind == "multiball") {
            if (state == "playing" && ballsX.length > 0) {
                var sourceX = ballsX[0];
                var sourceY = ballsY[0];
                var sourceVx = ballsVx[0];
                var sourceVy = ballsVy[0];

                var speed = abs(sourceVx) + abs(sourceVy);
                if (speed < 420) {
                    speed = 420;
                }
                if (speed > ballSpeedCap) {
                    speed = ballSpeedCap;
                }

                var nextDir = 1;
                if (sourceVx < 0) {
                    nextDir = -1;
                }

                while (ballsX.length < maxBalls) {
                    var spawnedVx = nextDir * ((speed * 48) / 100);
                    var spawnedVy = 0 - (speed - abs(spawnedVx));
                    if (spawnedVy > -185) {
                        spawnedVy = -185;
                    }
                    addBall(sourceX + (nextDir * 8), sourceY + 2, spawnedVx, spawnedVy);
                    nextDir = 0 - nextDir;
                }
            }
            stateTextTimerMs = 1500;
            game.audioPlayTone(560, 55, "square", 0.12);
            game.audioPlayTone(700, 60, "square", 0.10);
        } else if (kind == "life") {
            lives = lives + 1;
            if (lives > 6) {
                lives = 6;
            }
            stateTextTimerMs = 1300;
            game.audioPlayTone(660, 65, "square", 0.12);
            game.audioPlayTone(820, 70, "square", 0.10);
        }
    }

    function updatePowerUps(dt) {
        var i = 0;
        while (i < puX.length) {
            if (puActive[i]) {
                puY[i] = puY[i] + ((puVy[i] * dt) / 1000);

                if (puY[i] > canvasHeight + 30) {
                    puActive[i] = false;
                } else {
                    var paddleCx = paddleX + (paddleWidth / 2);
                    var paddleCy = paddleY + (paddleHeight / 2);
                    var hitPaddle = game.overlapCircle(
                        puX[i],
                        puY[i],
                        11,
                        paddleCx,
                        paddleCy,
                        (paddleWidth / 2) + 8
                    );

                    if (hitPaddle) {
                        applyPowerUp(puType[i]);
                        puActive[i] = false;
                        score = score + 35;
                        persistStats();
                    }
                }
            }
            i = i + 1;
        }
    }

    function bounceOffPaddle(ballIndex, paddleMotionX) {
        var ballX = ballsX[ballIndex];
        var ballVx = ballsVx[ballIndex];
        var ballVy = ballsVy[ballIndex];
        var paddleCenter = paddleX + (paddleWidth / 2);
        var deltaFromCenter = ballX - paddleCenter;
        var halfWidth = paddleWidth / 2;
        if (halfWidth < 1) {
            halfWidth = 1;
        }
        var speed = abs(ballVx) + abs(ballVy) + 26;
        if (speed < 360) {
            speed = 360;
        }
        if (speed > ballSpeedCap) {
            speed = ballSpeedCap;
        }

        // Use integer-safe math so transpiled JS keeps left/right sign.
        ballVx = ((speed * deltaFromCenter) / halfWidth) + ((paddleMotionX * 24) / 100);
        var maxHorizontal = (speed * 80) / 100;
        if (abs(ballVx) > maxHorizontal) {
            if (ballVx < 0) {
                ballVx = 0 - maxHorizontal;
            } else {
                ballVx = maxHorizontal;
            }
        }
        if (abs(ballVx) < 70) {
            if (deltaFromCenter < 0) {
                ballVx = -70;
            } else if (deltaFromCenter > 0) {
                ballVx = 70;
            } else {
                if (ballVx < 0) {
                    ballVx = -70;
                } else {
                    ballVx = 70;
                }
            }
        }
        ballVy = 0 - (speed - abs(ballVx));
        if (ballVy > -160) {
            ballVy = -160;
        }
        ballsVx[ballIndex] = ballVx;
        ballsVy[ballIndex] = ballVy;
    }

    function hitBrick(index) {
        var hp = bricksHp[index] - 1;
        bricksHp[index] = hp;

        if (hp <= 0) {
            bricksAlive[index] = false;
            bricksLeft = bricksLeft - 1;
            score = score + (100 + (combo * 12));
            if (combo < 12) {
                combo = combo + 1;
            }
            persistStats();
            spawnSparks(
                bricksX[index] + (bricksW[index] / 2),
                bricksY[index] + (bricksH[index] / 2),
                animatedBrickColor(index),
                8
            );
            punchCamera(140, 4);

            var spawnSeed = (index * 17) + score + level;
            if ((spawnSeed % 5) == 0) {
                // Use a separate seed for power-up type so drop chance gating
                // does not collapse all rolls to expand-only outcomes.
                var typeSeed = (index * 31) + (score * 7) + (level * 13) + (combo * 19);
                spawnPowerUp(bricksX[index] + (bricksW[index] / 2), bricksY[index] + (bricksH[index] / 2), typeSeed);
            }
            var destroyPitch = 350 + (bricksRow[index] * 22) + (combo * 16);
            game.audioPlayTone(destroyPitch, 36, "square", 0.12);
        } else {
            bricksColor[index] = brickColorByHp(hp, bricksMaxHp[index], bricksRow[index]);
            score = score + 30;
            persistStats();
            spawnSparks(
                bricksX[index] + (bricksW[index] / 2),
                bricksY[index] + (bricksH[index] / 2),
                bricksColor[index],
                4
            );
            punchCamera(70, 2);
            game.audioPlayTone(240 + (bricksRow[index] * 12), 24, "triangle", 0.08);
        }
    }

    function collideBallWithBricks(ballIndex, prevX, prevY) {
        var ballX = ballsX[ballIndex];
        var ballY = ballsY[ballIndex];
        var ballVx = ballsVx[ballIndex];
        var ballVy = ballsVy[ballIndex];
        var i = 0;
        var collided = false;

        while (i < bricksX.length) {
            if (bricksAlive[i]) {
                var bx = bricksX[i];
                var by = bricksY[i];
                var bw = bricksW[i];
                var bh = bricksH[i];

                var overlaps = game.overlapRect(
                    ballX - ballRadius,
                    ballY - ballRadius,
                    ballRadius * 2,
                    ballRadius * 2,
                    bx,
                    by,
                    bw,
                    bh
                );

                if (i == lastBrickHit && lastBrickCoolMs > 0) {
                    overlaps = false;
                }

                if (overlaps && !collided) {
                    var prevOverlapX = game.overlapRect(
                        prevX - ballRadius,
                        by,
                        ballRadius * 2,
                        bh,
                        bx,
                        by,
                        bw,
                        bh
                    );
                    var prevOverlapY = game.overlapRect(
                        bx,
                        prevY - ballRadius,
                        bw,
                        ballRadius * 2,
                        bx,
                        by,
                        bw,
                        bh
                    );

                    var bounceY = false;
                    var bounceX = false;
                    if (!prevOverlapY && prevOverlapX) {
                        bounceY = true;
                    } else if (!prevOverlapX && prevOverlapY) {
                        bounceX = true;
                    } else {
                        if ((abs(ballVy) * 12) >= (abs(ballVx) * 10)) {
                            bounceY = true;
                        } else {
                            bounceX = true;
                        }
                    }

                    if (bounceY) {
                        ballVy = 0 - ballVy;
                        if (ballVy > 0) {
                            ballY = by + bh + ballRadius + 1;
                        } else {
                            ballY = by - ballRadius - 1;
                        }
                    }
                    if (bounceX) {
                        ballVx = 0 - ballVx;
                        if (ballVx > 0) {
                            ballX = bx + bw + ballRadius + 1;
                        } else {
                            ballX = bx - ballRadius - 1;
                        }
                    }

                    lastBrickHit = i;
                    lastBrickCoolMs = 50;
                    hitBrick(i);
                    collided = true;
                }
            }
            i = i + 1;
        }

        ballsX[ballIndex] = ballX;
        ballsY[ballIndex] = ballY;
        ballsVx[ballIndex] = ballVx;
        ballsVy[ballIndex] = ballVy;
    }

    function updateStars(dt) {
        var i = 0;
        while (i < starsX.length) {
            starsY[i] = starsY[i] + ((starsSpeed[i] * dt) / 1000);
            if (starsY[i] > canvasHeight + 4) {
                starsY[i] = -4;
                starsX[i] = (starsX[i] + (73 + (i * 13))) % canvasWidth;
            }
            i = i + 1;
        }
    }

    function updateBallTrail(dt) {
        var keptX = [];
        var keptY = [];
        var keptLife = [];
        var i = 0;
        while (i < ballTrailLife.length) {
            var life = ballTrailLife[i] - dt;
            if (life > 0) {
                keptX[keptX.length] = ballTrailX[i];
                keptY[keptY.length] = ballTrailY[i];
                keptLife[keptLife.length] = life;
            }
            i = i + 1;
        }

        i = 0;
        while (i < ballsX.length) {
            keptX[keptX.length] = ballsX[i];
            keptY[keptY.length] = ballsY[i];
            keptLife[keptLife.length] = 220;
            i = i + 1;
        }

        if (keptX.length > ballTrailMax) {
            var skip = keptX.length - ballTrailMax;
            var slimX = [];
            var slimY = [];
            var slimLife = [];
            i = skip;
            while (i < keptX.length) {
                slimX[slimX.length] = keptX[i];
                slimY[slimY.length] = keptY[i];
                slimLife[slimLife.length] = keptLife[i];
                i = i + 1;
            }
            ballTrailX = slimX;
            ballTrailY = slimY;
            ballTrailLife = slimLife;
        } else {
            ballTrailX = keptX;
            ballTrailY = keptY;
            ballTrailLife = keptLife;
        }
    }

    function resetForNewLife() {
        combo = 0;
        paddleWidth = paddleBaseWidth;
        expandTimerMs = 0;
        slowTimerMs = 0;
        state = "serve";
        resetBallOnPaddle(1);
    }

    function beginLevel(nextLevel) {
        level = nextLevel;
        combo = 0;
        paddleWidth = paddleBaseWidth;
        expandTimerMs = 0;
        slowTimerMs = 0;
        puX = [];
        puY = [];
        puVy = [];
        puType = [];
        puActive = [];
        buildLevel(level);
        state = "serve";
        resetBallOnPaddle(1);
    }

    function updateGame(dtMs) {
        tryBootAudio();

        var dt = dtMs;
        brickAnimClockMs = brickAnimClockMs + dt;

        if (stateTextTimerMs > 0) stateTextTimerMs = stateTextTimerMs - dt;
        if (shakeMs > 0) {
            shakeMs = shakeMs - dt;
            if (shakeMs < 0) {
                shakeMs = 0;
            }
        }
        if (comboFlashMs > 0) {
            comboFlashMs = comboFlashMs - dt;
            if (comboFlashMs < 0) {
                comboFlashMs = 0;
            }
        }
        if (lastBrickCoolMs > 0) {
            lastBrickCoolMs = lastBrickCoolMs - dt;
            if (lastBrickCoolMs <= 0) {
                lastBrickHit = -1;
            }
        }
        updateSparks(dt);

        if (game.wasKeyPressed("p") || game.wasGamepadButtonPressed(0, 9)) {
            if (state == "playing" || state == "serve") {
                pauseResumeState = state;
                state = "paused";
                game.audioPlayTone(330, 40, "triangle", 0.09);
            } else if (state == "paused") {
                state = pauseResumeState;
                game.audioPlayTone(520, 40, "triangle", 0.09);
            }
        }

        var mouseX = game.getMouseX();
        prevMouseDown = mouseDown;
        mouseDown = game.isMouseDown(0);
        var mouseClick = mouseDown && !prevMouseDown;

        var touches = game.getTouches();
        var usingTouch = length(touches) > 0;

        var moveLeft = game.isKeyDown("arrowleft") || game.isKeyDown("a");
        var moveRight = game.isKeyDown("arrowright") || game.isKeyDown("d");
        if (game.isGamepadConnected(0)) {
            if (game.isGamepadButtonDown(0, 14)) {
                moveLeft = true;
            }
            if (game.isGamepadButtonDown(0, 15)) {
                moveRight = true;
            }
        }
        var paddleStep = (paddleSpeed * dt) / 1000;
        var prevPaddleX = paddleX;

        var padAxis = 0;
        if (game.isGamepadConnected(0)) {
            padAxis = game.getGamepadAxis(0, 0);
            if (abs(padAxis) < 0.2) {
                padAxis = 0;
            }
        }

        if (usingTouch) {
            var touchTarget = touches[0].x - (paddleWidth / 2);
            paddleX = paddleX + ((touchTarget - paddleX) * 0.28);
            mouseAttached = false;
        } else {
            if (moveLeft) {
                paddleX = paddleX - paddleStep;
            }
            if (moveRight) {
                paddleX = paddleX + paddleStep;
            }
            if (padAxis != 0) {
                paddleX = paddleX + (padAxis * paddleStep);
                mouseAttached = false;
            }

            var mouseMoved = (mouseX > 0 && mouseX != lastMouseX);
            lastMouseX = mouseX;

            if (moveLeft || moveRight) {
                mouseAttached = false;
            } else if (mouseMoved) {
                mouseAttached = true;
            }

            if (mouseAttached && !moveLeft && !moveRight && mouseX > 0) {
                var targetX = mouseX - (paddleWidth / 2);
                paddleX = paddleX + ((targetX - paddleX) * 0.16);
            }
        }

        lastMouseX = mouseX;
        paddleX = clamp(paddleX, 0, canvasWidth - paddleWidth);
        if (dt > 0) {
            paddleVx = ((paddleX - prevPaddleX) * 1000) / dt;
        } else {
            paddleVx = 0;
        }
        updateStars(dt);
        updateBrickAnimations(dt);
        updateMovingBricks(dt);

        if (state == "gameover" || state == "win") {
            var restartPressed =
                game.wasKeyPressed("r") ||
                game.wasKeyPressed("enter") ||
                mouseClick ||
                game.wasGamepadButtonPressed(0, 0);
            if (restartPressed) {
                game.audioStopAll();
                bgmBootstrapState = "idle";
                score = 0;
                lives = 3;
                gameOverSfxPlayed = false;
                winSfxPlayed = false;
                splashDismissed = false;
                beginLevel(1);
                game.audioPlayTone(560, 65, "square", 0.12);
                game.audioPlayTone(760, 72, "square", 0.10);
            }
            return;
        }

        if (state == "paused") {
            return;
        }

        if (state == "serve") {
            if (ballsX.length <= 0) {
                resetBallOnPaddle(1);
            }

            serveAim = clamp(paddleVx / paddleSpeed, -1, 1);
            if (usingTouch) {
                var touchAim = ((touches[0].x - (paddleX + (paddleWidth / 2))) / 120);
                serveAim = clamp(touchAim, -1, 1);
            } else if (moveLeft && !moveRight) {
                serveAim = -0.8;
            } else if (moveRight && !moveLeft) {
                serveAim = 0.8;
            } else if (padAxis != 0) {
                serveAim = padAxis;
            }
            if (abs(serveAim) < 0.12) {
                serveAim = 0;
            }

            var aimVx = serveAim * 240;
            if (abs(aimVx) < 28) {
                aimVx = 28;
                if (paddleVx < 0) {
                    aimVx = -28;
                }
            }
            ballsX[0] = paddleX + (paddleWidth / 2) + (serveAim * 18);
            ballsY[0] = paddleY - ballRadius - 2;
            ballsVx[0] = aimVx;
            ballsVy[0] = -250;

            var tapLaunch = false;
            if (usingTouch && mouseClick) {
                if (touches[0].y < paddleY - 60) {
                    tapLaunch = true;
                }
            }
            var launchPressed =
                game.wasKeyPressed(" ") ||
                game.wasGamepadButtonPressed(0, 0) ||
                tapLaunch;
            if (mouseClick && !usingTouch) {
                launchPressed = true;
            }
            if (launchPressed) {
                state = "playing";
                splashDismissed = true;
                game.audioPlayTone(700, 44, "square", 0.12);
            }
            return;
        }

        if (expandTimerMs > 0) {
            expandTimerMs = expandTimerMs - dt;
            if (expandTimerMs <= 0) {
                paddleWidth = paddleBaseWidth;
                paddleX = clamp(paddleX, 0, canvasWidth - paddleWidth);
            }
        }
        if (slowTimerMs > 0) {
            slowTimerMs = slowTimerMs - dt;
        }

        var speedScale = 1.0;
        if (slowTimerMs > 0) {
            speedScale = 0.78;
        }

        var i = 0;
        while (i < ballsX.length) {
            var prevX = ballsX[i];
            var prevY = ballsY[i];
            var ballX = ballsX[i] + ((ballsVx[i] * dt * speedScale) / 1000);
            var ballY = ballsY[i] + ((ballsVy[i] * dt * speedScale) / 1000);
            var ballVx = ballsVx[i];
            var ballVy = ballsVy[i];

            if (ballX - ballRadius <= 0) {
                ballX = ballRadius;
                if (ballVx < 0) {
                    ballVx = 0 - ballVx;
                    game.audioPlayTone(300, 20, "triangle", 0.06);
                }
            }
            if (ballX + ballRadius >= canvasWidth) {
                ballX = canvasWidth - ballRadius;
                if (ballVx > 0) {
                    ballVx = 0 - ballVx;
                    game.audioPlayTone(300, 20, "triangle", 0.06);
                }
            }
            if (ballY - ballRadius <= 0) {
                ballY = ballRadius;
                if (ballVy < 0) {
                    ballVy = 0 - ballVy;
                    game.audioPlayTone(250, 18, "triangle", 0.05);
                }
            }

            var hitsPaddle =
                ballVy > 0 &&
                game.overlapRect(
                    ballX - ballRadius,
                    ballY - ballRadius,
                    ballRadius * 2,
                    ballRadius * 2,
                    paddleX,
                    paddleY,
                    paddleWidth,
                    paddleHeight
                );

            ballsX[i] = ballX;
            ballsY[i] = ballY;
            ballsVx[i] = ballVx;
            ballsVy[i] = ballVy;

            if (hitsPaddle) {
                ballsY[i] = paddleY - ballRadius;
                bounceOffPaddle(i, paddleVx);
                if (combo > 1) {
                    comboFlashMs = 160;
                }
                combo = 0;
                punchCamera(50, 2);
                game.audioPlayTone(940, 30, "square", 0.12);
            }

            collideBallWithBricks(i, prevX, prevY);
            i = i + 1;
        }
        updateBallTrail(dt);
        updatePowerUps(dt);

        if (bricksLeft <= 0) {
            levelClearTimerMs = levelClearTimerMs + dt;
            if (levelClearTimerMs > 350) {
                levelClearTimerMs = 0;
                if (level >= maxLevel) {
                    state = "win";
                    persistStats();
                    if (!winSfxPlayed) {
                        game.audioStopPattern();
                        game.audioPlayTone(620, 90, "square", 0.13);
                        game.audioPlayTone(760, 100, "square", 0.11);
                        game.audioPlayTone(930, 120, "square", 0.10);
                        winSfxPlayed = true;
                    }
                } else {
                    game.audioPlayTone(520, 85, "triangle", 0.12);
                    game.audioPlayTone(690, 95, "triangle", 0.11);
                    beginLevel(level + 1);
                }
            }
        }

        i = 0;
        while (i < ballsY.length) {
            if (ballsY[i] - ballRadius > canvasHeight + 4) {
                removeBall(i);
            } else {
                i = i + 1;
            }
        }

        if (ballsY.length <= 0) {
            lives = lives - 1;
            game.audioPlayNoise(90, 0.12);
            game.audioPlayTone(190, 95, "sawtooth", 0.10);
            if (lives <= 0) {
                state = "gameover";
                persistStats();
                if (!gameOverSfxPlayed) {
                    game.audioStopPattern();
                    game.audioPlayTone(220, 130, "sawtooth", 0.12);
                    game.audioPlayTone(160, 160, "sawtooth", 0.10);
                    gameOverSfxPlayed = true;
                }
            }
            else {
                resetForNewLife();
            }
        }
    }

    function drawBackground() {
        var i = 0;
        while (i < starsX.length) {
            var size = starsSize[i];
            var c = "#1f2937";
            if (size == 2) c = "#334155";
            if (size == 3) c = "#475569";
            game.fillRect(starsX[i], starsY[i], size, size, c);
            i = i + 1;
        }
    }

    function drawBricks() {
        var i = 0;
        while (i < bricksX.length) {
            if (bricksAlive[i]) {
                var bx = bricksX[i];
                var by = bricksY[i];
                var bw = bricksW[i];
                var bh = bricksH[i];
                game.fillRect(bx, by, bw, bh, animatedBrickColor(i));
                game.fillRect(bx + 2, by + 2, bw - 4, 4, "#ffffff22");
                if (bricksMaxHp[i] >= 2) {
                    game.strokeRect(bx + 1, by + 1, bw - 2, bh - 2, "#0f172a88", 2);
                }
                if (bricksHp[i] >= 2) {
                    game.fillRect(bx + 5, by + bh - 7, bw - 10, 3, "#0f172acc");
                }
                if (bricksHp[i] >= 3) {
                    game.fillRect(bx + 5, by + bh - 12, bw - 10, 3, "#0f172acc");
                }
            }
            i = i + 1;
        }
    }

    function drawPowerUps() {
        var i = 0;
        while (i < puX.length) {
            if (puActive[i]) {
                var px = puX[i];
                var py = puY[i];
                if (puType[i] == "expand") {
                    game.fillRect(px - 16, py - 5, 32, 10, "#facc15");
                    game.fillRect(px - 12, py - 2, 24, 4, "#0f172a");
                } else if (puType[i] == "slow") {
                    game.fillCircle(px, py, 11, "#38bdf8");
                    game.drawLine(px - 6, py - 5, px, py + 6, "#0f172a", 3);
                    game.drawLine(px + 6, py - 5, px, py + 6, "#0f172a", 3);
                } else if (puType[i] == "life") {
                    game.fillCircle(px, py, 11, "#4ade80");
                    game.fillRect(px - 2, py - 7, 4, 14, "#0f172a");
                    game.fillRect(px - 7, py - 2, 14, 4, "#0f172a");
                } else if (puType[i] == "multiball") {
                    game.fillCircle(px - 6, py + 3, 5, "#a78bfa");
                    game.fillCircle(px + 6, py + 3, 5, "#a78bfa");
                    game.fillCircle(px, py - 5, 5, "#a78bfa");
                } else {
                    game.fillCircle(px, py, 11, "#facc15");
                }
            }
            i = i + 1;
        }
    }

    function drawBallTrail() {
        var i = 0;
        while (i < ballTrailX.length) {
            if (ballTrailLife[i] > 0) {
                var r = (ballRadius * ballTrailLife[i]) / 220;
                if (r < 2) r = 2;
                game.setAlpha(ballTrailLife[i] / 220);
                game.fillCircle(ballTrailX[i], ballTrailY[i], r, "#f8fafc");
            }
            i = i + 1;
        }
        game.setAlpha(1);
    }

    function drawSparks() {
        var i = 0;
        while (i < sparkLife.length) {
            if (sparkLife[i] > 0) {
                game.setAlpha(sparkLife[i] / 280);
                game.fillCircle(sparkX[i], sparkY[i], 3, sparkColor[i]);
            }
            i = i + 1;
        }
        game.setAlpha(1);
    }

    function drawOverlayPanel(title, titleColor, line1, line2, line3) {
        game.setAlpha(0.55);
        game.fillRect(0, 0, canvasWidth, canvasHeight, "#020617");
        game.setAlpha(1);

        var panelW = 620;
        var panelH = 240;
        var panelX = (canvasWidth - panelW) / 2;
        var panelY = 168;
        game.fillRect(panelX, panelY, panelW, panelH, "#020617ee");
        game.strokeRect(panelX, panelY, panelW, panelH, "#38bdf8", 3);
        game.drawText(title, panelX + 48, panelY + 58, titleColor, "bold 36px sans-serif");
        game.drawText(line1, panelX + 48, panelY + 110, "#e2e8f0", "20px sans-serif");
        game.drawText(line2, panelX + 48, panelY + 146, "#cbd5e1", "18px sans-serif");
        game.drawText(line3, panelX + 48, panelY + 190, "#94a3b8", "18px sans-serif");
    }

    function renderGame() {
        game.clear();

        var camX = 0;
        var camY = 0;
        if (shakeMs > 0 && shakeMag > 0) {
            var fade = shakeMs / 140;
            if (fade > 1) {
                fade = 1;
            }
            camX = ((((brickAnimClockMs * 13) % 7) - 3) * shakeMag * fade) / 3;
            camY = ((((brickAnimClockMs * 17) % 5) - 2) * shakeMag * fade) / 2;
        }
        game.setCamera(camX, camY);

        drawBackground();

        var wallColor = "#38bdf8";
        var wallThickness = 4;
        game.drawLine(0, wallThickness / 2, canvasWidth, wallThickness / 2, wallColor, wallThickness);
        game.drawLine(wallThickness / 2, 0, wallThickness / 2, canvasHeight, wallColor, wallThickness);
        game.drawLine(canvasWidth - (wallThickness / 2), 0, canvasWidth - (wallThickness / 2), canvasHeight, wallColor, wallThickness);

        drawBricks();
        drawPowerUps();
        drawSparks();
        drawBallTrail();

        game.fillRect(paddleX, paddleY, paddleWidth, paddleHeight, "#22d3ee");
        game.fillRect(paddleX + 4, paddleY + 4, paddleWidth - 8, 5, "#a5f3fc");
        var i = 0;
        while (i < ballsX.length) {
            game.fillCircle(ballsX[i], ballsY[i], ballRadius, "#f8fafc");
            game.fillCircle(ballsX[i] - 3, ballsY[i] - 3, 3, "#ffffff");
            i = i + 1;
        }

        if (state == "serve" && ballsX.length > 0) {
            game.drawLine(
                ballsX[0],
                ballsY[0],
                ballsX[0] + (ballsVx[0] * 0.14),
                ballsY[0] + (ballsVy[0] * 0.14),
                "#e2e8f0",
                2
            );
        }

        game.setCamera(0, 0);

        if (comboFlashMs > 0) {
            game.setAlpha(comboFlashMs / 280);
            game.fillRect(0, 0, canvasWidth, canvasHeight, "#fb7185");
            game.setAlpha(1);
        }

        game.fillRect(0, 0, canvasWidth, 60, "#0b1320");
        game.drawText("Maldanoid", 18, 36, "#f8fafc", "bold 26px sans-serif");
        game.drawText("Score " + string(score), 230, 34, "#cbd5e1", "18px sans-serif");
        game.drawText("High " + string(highScore), 380, 34, "#94a3b8", "17px sans-serif");
        game.drawText("Lives " + string(lives), 530, 34, "#cbd5e1", "18px sans-serif");
        game.drawText("Level " + string(level) + "/" + string(maxLevel), 660, 34, "#cbd5e1", "18px sans-serif");
        game.drawText("Bricks " + string(bricksLeft), 810, 34, "#cbd5e1", "18px sans-serif");

        if (combo > 0) {
            game.drawText("Combo x" + string(combo), 18, 80, "#facc15", "bold 18px sans-serif");
            game.fillRect(18, 90, 160, 6, "#1e293b");
            var comboBar = (combo * 160) / 12;
            if (comboBar > 160) {
                comboBar = 160;
            }
            game.fillRect(18, 90, comboBar, 6, "#facc15");
        }

        if (expandTimerMs > 0) {
            game.drawText("EXPAND " + formatMsWithTenths(expandTimerMs) + "s", 18, canvasHeight - 14, "#fbbf24", "15px monospace");
        }
        if (slowTimerMs > 0) {
            game.drawText("SLOW " + formatMsWithTenths(slowTimerMs) + "s", 190, canvasHeight - 14, "#38bdf8", "15px monospace");
        }

        if (state == "serve" && !splashDismissed) {
            var panelW = 620;
            var panelH = 260;
            var panelX = (canvasWidth - panelW) / 2;
            var panelY = 170;

            game.fillRect(panelX, panelY, panelW, panelH, "#020617ee");
            game.strokeRect(panelX, panelY, panelW, panelH, wallColor, 3);

            game.drawText("Maldanoid", panelX + 180, panelY + 54, "#e5e7eb", "bold 32px sans-serif");
            game.drawText("Move or drag to aim the serve", panelX + 60, panelY + 110, "#cbd5e1", "18px sans-serif");
            game.drawText("Touch follows the paddle. Tap above it to launch", panelX + 60, panelY + 138, "#cbd5e1", "18px sans-serif");
            game.drawText("Pause with P or Start (works on the serve too)", panelX + 60, panelY + 166, "#cbd5e1", "18px sans-serif");
            game.drawText("Catch power-ups for upgrades", panelX + 60, panelY + 194, "#facc15", "18px sans-serif");
            game.drawText("Press SPACE, click, or A to launch", panelX + 60, panelY + 228, "#e2e8f0", "20px sans-serif");
        } else if (state == "serve") {
            game.drawText("Move to aim  ·  SPACE / click / A to launch", 248, 312, "#e2e8f0", "20px sans-serif");
        } else if (state == "paused") {
            drawOverlayPanel(
                "Paused",
                "#f8fafc",
                "Score " + string(score) + "   High " + string(highScore),
                "Best combo x" + string(bestCombo) + "   Lives " + string(lives),
                "Press P or Start to continue"
            );
        } else if (state == "gameover") {
            drawOverlayPanel(
                "Game Over",
                "#fb7185",
                "Score " + string(score) + "   High " + string(highScore),
                "Level " + string(level) + "/" + string(maxLevel) + "   Best combo x" + string(bestCombo),
                "Press R, Enter, or A to restart"
            );
        } else if (state == "win") {
            drawOverlayPanel(
                "You cleared Maldanoid!",
                "#4ade80",
                "Score " + string(score) + "   High " + string(highScore),
                "Best combo x" + string(bestCombo) + "   All " + string(maxLevel) + " levels",
                "Press R, Enter, or A to play again"
            );
        }
    }

    beginLevel(1);
    game.createCanvas(canvasWidth, canvasHeight, "#app");
    game.setBackground("#020617");
    game.startFixed(updateGame, renderGame);
}
