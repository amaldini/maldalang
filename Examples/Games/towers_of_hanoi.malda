// Interactive Towers of Hanoi Game
// Move all disks from the left tower to the right tower.
// Rules: Only one disk can be moved at a time.
//        A disk can only be placed on top of a larger disk or an empty tower.
// Click a disk to select it, then click a tower to move it there.
// Press 'A' to auto-solve, 'R' to reset, 'H' for hints.

var root = dom.query("#app");

if (root == null) {
    println("No #app container found.");
} else {
    dom.clear(root);

    var head = dom.query("head");
    if (head != null) {
        var styleNode = dom.create("style");
        var styleText = "body { margin: 0; background: #1a1a2e; color: #e7eef7; font-family: sans-serif; }\n";
        styleText = styleText + "h1, p { max-width: 900px; margin: 12px auto; padding: 0 12px; }\n";
        styleText = styleText + "#app canvas { width: 100%; max-width: 900px; height: auto; display: block; margin: 0 auto; touch-action: none; }\n";
        if (dom.query("#malda-autoplay") != null) {
            styleText = styleText + "#status{display:none!important}html,body{overflow:hidden;margin:0;background:#1a1a2e}#app{min-height:0!important;background:#1a1a2e}#app>p{display:none!important}#app h1{margin:8px 12px 0;font-size:14px;font-weight:600;line-height:1.2}#app canvas{position:fixed!important;left:8px!important;top:32px!important;width:calc(100vw - 16px)!important;height:calc(100vh - 44px)!important;object-fit:contain;object-position:center center;background:#1a1a2e}";
        }
        dom.setText(styleNode, styleText);
        dom.append(head, styleNode);
    }

    var title = dom.create("h1");
    dom.setText(title, "Towers of Hanoi");
    dom.append(root, title);

    var hint = dom.create("p");
    dom.setText(hint, "Click a disk to select it, then click a tower to move it. Press A to auto-solve, R to reset.");
    dom.append(root, hint);

    var canvasWidth = 900;
    var canvasHeight = 500;
    
    var numDisks = 4;
    var towers = [[4, 3, 2, 1], [], []];
    var towerNames = ["A", "B", "C"];
    var selectedTower = -1;
    var moveCount = 0;
    var gameWon = false;
    
    var autoSolving = false;
    var autoMoves = [];

    var animOn = false;
    var animDisk = 0;
    var animToTower = 0;
    var animElapsed = 0;
    var animDuration = 480;
    var animStartX = 0;
    var animStartY = 0;
    var animEndX = 0;
    var animEndY = 0;
    var animHoverY = 64;
    
    var towerX = [150, 450, 750];
    var towerWidth = 20;
    var towerHeight = 300;
    var towerBaseY = 400;
    var towerBaseWidth = 180;
    var towerBaseHeight = 20;
    
    var diskHeight = 25;
    var diskMinWidth = 40;
    var diskWidthStep = 30;
    
    var diskColors = ["#ff6b6b", "#4ecdc4", "#45b7d1", "#96ceb4", "#ffeaa7", "#dfe6e9"];
    
    function resetGame() {
        towers = [[4, 3, 2, 1], [], []];
        if (numDisks == 3) {
            towers = [[3, 2, 1], [], []];
        }
        if (numDisks == 5) {
            towers = [[5, 4, 3, 2, 1], [], []];
        }
        selectedTower = -1;
        moveCount = 0;
        gameWon = false;
        autoSolving = false;
        autoMoves = [];
        animOn = false;
        animElapsed = 0;
    }
    
    function getDiskWidth(diskSize) {
        return diskMinWidth + (diskSize * diskWidthStep);
    }
    
    function getDiskY(towerIndex, positionInTower) {
        return towerBaseY - towerBaseHeight - (positionInTower * diskHeight);
    }
    
    function getDiskRect(towerIndex, positionInTower, diskSize) {
        var diskW = getDiskWidth(diskSize);
        var diskX = towerX[towerIndex] - (diskW / 2);
        var diskY = getDiskY(towerIndex, positionInTower);
        return {"x": diskX, "y": diskY, "w": diskW, "h": diskHeight};
    }
    
    function isPointInRect(px, py, rect) {
        return px >= rect.x && px <= rect.x + rect.w && py >= rect.y && py <= rect.y + rect.h;
    }
    
    function getTowerAtX(x) {
        var i = 0;
        while (i < 3) {
            var towerLeft = towerX[i] - (towerBaseWidth / 2);
            var towerRight = towerX[i] + (towerBaseWidth / 2);
            if (x >= towerLeft && x <= towerRight) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }
    
    function canMoveDisk(fromTower, toTower) {
        if (fromTower < 0 || fromTower >= 3 || toTower < 0 || toTower >= 3) {
            return false;
        }
        
        var sourceTower = towers[fromTower];
        if (sourceTower.length == 0) {
            return false;
        }
        
        var destTower = towers[toTower];
        var movingDisk = sourceTower[sourceTower.length - 1];
        
        if (destTower.length == 0) {
            return true;
        }
        
        var topDisk = destTower[destTower.length - 1];
        return movingDisk < topDisk;
    }
    
    function lerp(a, b, t) {
        return a + ((b - a) * t);
    }

    function smooth(t) {
        if (t < 0) {
            t = 0;
        }
        if (t > 1) {
            t = 1;
        }
        return t * t * (3 - (2 * t));
    }

    function animDiskPos() {
        var t = animElapsed / animDuration;
        if (t < 0) {
            t = 0;
        }
        if (t > 1) {
            t = 1;
        }
        var liftEnd = 0.32;
        var slideEnd = 0.68;
        if (t < liftEnd) {
            return {"x": animStartX, "y": lerp(animStartY, animHoverY, smooth(t / liftEnd))};
        }
        if (t < slideEnd) {
            var slide = smooth((t - liftEnd) / (slideEnd - liftEnd));
            return {"x": lerp(animStartX, animEndX, slide), "y": animHoverY};
        }
        var drop = smooth((t - slideEnd) / (1 - slideEnd));
        return {"x": animEndX, "y": lerp(animHoverY, animEndY, drop)};
    }

    function beginMove(fromTower, toTower) {
        if (animOn || !canMoveDisk(fromTower, toTower)) {
            return false;
        }

        var sourceTower = towers[fromTower];
        var disk = sourceTower[sourceTower.length - 1];
        var startRect = getDiskRect(fromTower, sourceTower.length - 1, disk);
        var endRect = getDiskRect(toTower, towers[toTower].length, disk);
        sourceTower.pop();
        towers[fromTower] = sourceTower;

        animOn = true;
        animDisk = disk;
        animToTower = toTower;
        animElapsed = 0;
        animStartX = startRect.x;
        animStartY = startRect.y;
        animEndX = endRect.x;
        animEndY = endRect.y;
        selectedTower = -1;
        return true;
    }

    function landDisk() {
        var destTower = towers[animToTower];
        destTower.append(animDisk);
        towers[animToTower] = destTower;
        moveCount = moveCount + 1;
        animOn = false;
        if (towers[2].length == numDisks) {
            gameWon = true;
            autoSolving = false;
            autoMoves = [];
        }
    }
    
    function generateSolution(n, from, to, aux) {
        if (n <= 0) {
            return [];
        }
        if (n == 1) {
            return [{"from": from, "to": to}];
        }
        
        var moves1 = generateSolution(n - 1, from, aux, to);
        var mainMove = [{"from": from, "to": to}];
        var moves2 = generateSolution(n - 1, aux, to, from);
        
        return moves1.concat(mainMove).concat(moves2);
    }
    
    function startAutoSolve() {
        autoSolving = true;
        autoMoves = generateSolution(numDisks, 0, 2, 1);
    }
    
    function updateGame(dtMs) {
        if (game.wasKeyPressed("r")) {
            resetGame();
        }
        
        if (game.wasKeyPressed("a") && !autoSolving && !gameWon && !animOn) {
            startAutoSolve();
        }
        
        if (game.wasKeyPressed("h")) {
            if (numDisks == 3) {
                numDisks = 4;
            } else {
                if (numDisks == 4) {
                    numDisks = 5;
                } else {
                    numDisks = 3;
                }
            }
            resetGame();
        }
        
        if (animOn) {
            var step = dtMs;
            if (step > 48) {
                step = 48;
            }
            animElapsed = animElapsed + step;
            if (animElapsed >= animDuration) {
                landDisk();
            }
        }

        if (autoSolving && !animOn && !gameWon && str.length(autoMoves) > 0) {
            var nextMove = autoMoves[0];
            if (beginMove(nextMove.from, nextMove.to)) {
                autoMoves = autoMoves.slice(1, str.length(autoMoves));
            } else {
                autoMoves = [];
                autoSolving = false;
            }
        }
        
        if (!autoSolving && !animOn && game.wasMousePressed(0)) {
            var mx = game.getMouseX();
            var my = game.getMouseY();
            
            var clickedTower = getTowerAtX(mx);
            
            if (clickedTower >= 0) {
                if (selectedTower < 0) {
                    if (towers[clickedTower].length > 0) {
                        selectedTower = clickedTower;
                    }
                } else {
                    if (clickedTower == selectedTower) {
                        selectedTower = -1;
                    } else {
                        beginMove(selectedTower, clickedTower);
                        selectedTower = -1;
                    }
                }
            }
        }
    }
    
    function renderGame() {
        game.clear();
        
        var i = 0;
        while (i < 3) {
            var baseX = towerX[i] - (towerBaseWidth / 2);
            game.fillRect(baseX, towerBaseY, towerBaseWidth, towerBaseHeight, "#8b7355");
            
            var poleX = towerX[i] - (towerWidth / 2);
            var poleY = towerBaseY - towerHeight;
            game.fillRect(poleX, poleY, towerWidth, towerHeight, "#654321");
            
            game.drawText(towerNames[i], towerX[i] - 8, towerBaseY + towerBaseHeight + 25, "#ffffff", "20px sans-serif");
            
            i = i + 1;
        }
        
        var t = 0;
        while (t < 3) {
            var tower = towers[t];
            var pos = 0;
            while (pos < tower.length) {
                var diskSize = tower[pos];
                var rect = getDiskRect(t, pos, diskSize);
                var color = diskColors[(diskSize - 1) % str.length(diskColors)];
                
                if (t == selectedTower && pos == tower.length - 1) {
                    color = "#ffff00";
                }
                
                game.fillRect(rect.x, rect.y, rect.w, rect.h, color);
                
                game.drawText(string(diskSize), rect.x + (rect.w / 2) - 6, rect.y + 18, "#000000", "14px bold sans-serif");
                
                pos = pos + 1;
            }
            t = t + 1;
        }

        if (animOn) {
            var flying = animDiskPos();
            var flyW = getDiskWidth(animDisk);
            var flyColor = diskColors[(animDisk - 1) % str.length(diskColors)];
            game.fillRect(flying.x, flying.y, flyW, diskHeight, flyColor);
            game.drawText(string(animDisk), flying.x + (flyW / 2) - 6, flying.y + 18, "#000000", "14px bold sans-serif");
        }
        
        var statusY = 30;
        game.drawText("Moves: " + string(moveCount), 20, statusY, "#ffffff", "18px sans-serif");
        
        var minMoves = expectedMoves(numDisks);
        game.drawText("Minimum: " + string(minMoves), 20, statusY + 25, "#aaaaaa", "14px sans-serif");
        
        if (gameWon) {
            var msg = "You Won in " + string(moveCount) + " moves!";
            game.drawText(msg, canvasWidth / 2 - 120, 80, "#00ff00", "24px bold sans-serif");
            if (moveCount == minMoves) {
                game.drawText("Perfect!", canvasWidth / 2 - 50, 110, "#ffff00", "20px bold sans-serif");
            }
        }
        
        if (autoSolving) {
            game.drawText("Auto-solving...", canvasWidth / 2 - 70, 80, "#ffaa00", "20px sans-serif");
        }
        
        game.drawText("Controls: A=Auto-solve, R=Reset, H=Change disks (" + string(numDisks) + ")", 20, canvasHeight - 20, "#888888", "14px monospace");
    }
    
    function expectedMoves(n) {
        var total = 1;
        var i = 0;
        while (i < n) {
            total = total * 2;
            i = i + 1;
        }
        return total - 1;
    }

    if (dom.query("#malda-autoplay") != null) {
        numDisks = 3;
        animDuration = 300;
        resetGame();
        startAutoSolve();
    }
    
    game.createCanvas(canvasWidth, canvasHeight, "#app");
    game.setBackground("#1a1a2e");
    game.start(updateGame, renderGame);
}
