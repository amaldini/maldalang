var root = dom.query("#app");

if (root == null) {
    println("No #app container found.");
} else {
    dom.clear(root);

    var heading = dom.create("h1");
    dom.setText(heading, "MALDA three.js Cube");
    dom.append(root, heading);

    var hint = dom.create("p");
    dom.setText(hint, "Use Left/Right to change spin speed. Click and drag over the canvas to inspect mouse tracking.");
    dom.append(root, hint);

    var width = 860;
    var height = 520;
    var aspect = width / height;

    var renderer = three.createRenderer(width, height, "#app");
    three.setClearColor(renderer, "#101722");
    three.setRendererSize(renderer, width, height);

    var scene = three.createScene();
    var camera = three.createPerspectiveCamera(70, aspect, 0.1, 100.0);
    three.setCameraAspect(camera, aspect);
    three.setPosition(camera, 0, 0.4, 4.8);

    var world = three.createGroup();
    three.add(scene, world);

    var floorGeometry = three.createPlaneGeometry(8.5, 8.5);
    var floorMaterial = three.createStandardMaterial({
        "color": "#18212f",
        "roughness": 0.95,
        "metalness": 0.02
    });
    var floor = three.createMesh(floorGeometry, floorMaterial);
    three.setRotation(floor, -1.5708, 0.0, 0.0);
    three.setPosition(floor, 0.0, -1.1, 0.0);
    three.add(world, floor);

    var cubeGeometry = three.createBoxGeometry(1.2, 1.2, 1.2);
    var cubeMaterial = three.createStandardMaterial({
        "color": "#44aaff",
        "roughness": 0.35,
        "metalness": 0.15
    });
    var cube = three.createMesh(cubeGeometry, cubeMaterial);
    three.add(world, cube);

    var orbGeometry = three.createSphereGeometry(0.34, 24, 16);
    var orbMaterial = three.createStandardMaterial({
        "color": "#f59e0b",
        "roughness": 0.4,
        "metalness": 0.08
    });
    var orb = three.createMesh(orbGeometry, orbMaterial);
    three.setPosition(orb, 1.5, 0.15, 0.0);
    three.setScale(orb, 1.0, 1.25, 1.0);
    three.add(world, orb);

    var keyLight = three.createDirectionalLight("#ffffff", 1.25);
    three.setPosition(keyLight, 2.5, 3.0, 4.0);
    three.add(scene, keyLight);

    var fillLight = three.createDirectionalLight("#8ec5ff", 0.65);
    three.setPosition(fillLight, -3.0, 1.2, 2.0);
    three.add(scene, fillLight);

    var ambient = three.createAmbientLight("#9bbcff", 0.35);
    three.add(scene, ambient);

    var spinX = 0.9;
    var spinY = 1.35;
    var angleX = 0.0;
    var angleY = 0.0;

    function update(dtMs) {
        var dt = dtMs;
        if (dt > 40) {
            dt = 40;
        }

        if (three.isKeyDown("arrowleft")) {
            spinY = spinY - ((1.5 * dt) / 1000);
        }
        if (three.isKeyDown("arrowright")) {
            spinY = spinY + ((1.5 * dt) / 1000);
        }

        if (spinY < -2.5) {
            spinY = -2.5;
        }
        if (spinY > 2.5) {
            spinY = 2.5;
        }

        angleX = angleX + ((spinX * dt) / 1000);
        angleY = angleY + ((spinY * dt) / 1000);

        three.setRotation(cube, angleX, angleY, 0.0);
        three.setRotation(orb, 0.0, -angleY * 1.1, angleX * 0.35);
    }

    function render() {
        three.render(renderer, scene, camera);
    }

    three.start(update, render);
}
