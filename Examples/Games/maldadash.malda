var root = dom.query("#app");

if (root == null) {
    println("No #app container found.");
} else {
    dom.clear(root);

    var head = dom.query("head");
    if (head != null) {
        var styleNode = dom.create("style");
        var styleText = "body { margin: 0; background: #0b0a08; color: #e7e5e4; }\n";
        styleText = styleText + "#app canvas { width: 100%; max-width: 960px; height: auto; display: block; margin: 0 auto; image-rendering: pixelated; }\n";
        dom.setText(styleNode, styleText);
        dom.append(head, styleNode);
    }

    var EMPTY = 0;
    var DIRT = 1;
    var STEEL = 2;
    var BRICK = 3;
    var BOULDER = 4;
    var DIAMOND = 5;
    var PLAYER = 6;
    var EXIT_CLOSED = 7;
    var EXIT_OPEN = 8;
    var FIREFLY = 9;
    var BUTTERFLY = 10;

    var tileSize = 32;
    var srcSize = 16;
    var atlasCols = 8;
    var cols = 40;
    var rows = 22;
    var canvasW = 640;
    var canvasH = 360;
    var worldW = cols * tileSize;
    var worldH = rows * tileSize;

    var atlas = game.loadImage("assets/cave_tiles.png");
    var cells = [];
    var falling = [];
    var facing = [];
    var moved = [];

    var playerX = 1;
    var playerY = 1;
    var playerAlive = true;
    var facingLeft = false;

    var level = 1;
    var maxLevel = 3;
    var diamondsGot = 0;
    var diamondsNeed = 6;
    var timeLeft = 150;
    var timeAccMs = 0;
    var lives = 3;
    var score = 0;
    var high = 0;
    var exitOpen = false;
    var exitX = 1;
    var exitY = 1;

    var state = "splash";
    var physicsAccMs = 0;
    var physicsIntervalMs = 110;
    var animMs = 0;
    var deadTimerMs = 0;
    var winTimerMs = 0;
    var camZoom = 1.0;
    var shakeMs = 0.0;
    var flashMs = 0.0;
    var lookZoom = false;

    var boomX = [];
    var boomY = [];
    var boomFill = [];
    var sparkX = [];
    var sparkY = [];
    var sparkDx = [];
    var sparkDy = [];
    var sparkLife = [];

    var audioBooted = false;
    var patternStarted = false;
    var fanfarePlayed = false;
    var crushSfxPlayed = false;

    var loadedHigh = game.load("maldadash_high");
    if (loadedHigh != null) {
        high = loadedHigh;
    }

    function tileFromChar(ch) {
        if (ch == "W") {
            return STEEL;
        }
        if (ch == "#") {
            return BRICK;
        }
        if (ch == ".") {
            return DIRT;
        }
        if (ch == " ") {
            return EMPTY;
        }
        if (ch == "O") {
            return BOULDER;
        }
        if (ch == "*") {
            return DIAMOND;
        }
        if (ch == "P") {
            return PLAYER;
        }
        if (ch == "X") {
            return EXIT_CLOSED;
        }
        if (ch == "F") {
            return FIREFLY;
        }
        if (ch == "Y") {
            return BUTTERFLY;
        }
        return DIRT;
    }

    function idx(x, y) {
        return (y * cols) + x;
    }

    function inBounds(x, y) {
        return x >= 0 && x < cols && y >= 0 && y < rows;
    }

    function getTile(x, y) {
        return game.tileAt(cells, x, y, { "columns": cols, "rows": rows, "out": STEEL });
    }

    function setTile(x, y, tile) {
        if (inBounds(x, y)) {
            var cellIndex = idx(x, y);
            cells[cellIndex] = tile;
        }
    }

    function getFalling(x, y) {
        if (!inBounds(x, y)) {
            return 0;
        }
        return falling[idx(x, y)];
    }

    function setFalling(x, y, value) {
        if (inBounds(x, y)) {
            var fallIndex = idx(x, y);
            falling[fallIndex] = value;
        }
    }

    function isRound(tile) {
        return tile == BOULDER || tile == DIAMOND;
    }

    function isEnemy(tile) {
        return tile == FIREFLY || tile == BUTTERFLY;
    }

    function dirDx(d) {
        if (d == 1) {
            return 1;
        }
        if (d == 3) {
            return -1;
        }
        return 0;
    }

    function dirDy(d) {
        if (d == 2) {
            return 1;
        }
        if (d == 0) {
            return -1;
        }
        return 0;
    }

    function playerWorldX() {
        return (playerX + 0.5) * tileSize;
    }

    function playerWorldY() {
        return (playerY + 0.5) * tileSize;
    }

    function samplePan() {
        var z = game.getCameraZoom();
        if (z <= 0) {
            z = 1;
        }
        var viewW = canvasW / z;
        var mid = game.getCameraX() + (viewW / 2);
        var pan = (playerWorldX() - mid) / (viewW / 2);
        if (pan < -1) {
            pan = -1;
        }
        if (pan > 1) {
            pan = 1;
        }
        return pan;
    }

    function bumpShake(ms) {
        shakeMs = ms;
        flashMs = 90;
    }

    function rememberHigh() {
        if (score > high) {
            high = score;
            game.save("maldadash_high", high);
        }
    }

    function spawnSparks(cx, cy, n) {
        var i = 0;
        while (i < n) {
            if (sparkX.length >= 32) {
                return;
            }
            var ang = (i / n) * 6.2832;
            sparkX.append((cx + 0.5) * tileSize);
            sparkY.append((cy + 0.5) * tileSize);
            sparkDx.append(math.cos(ang) * 1.6);
            sparkDy.append(math.sin(ang) * 1.6);
            sparkLife.append(260);
            i = i + 1;
        }
    }

    function loadRows(mapRows, need, seconds) {
        cells = [];
        falling = [];
        facing = [];
        moved = [];
        boomX = [];
        boomY = [];
        boomFill = [];
        sparkX = [];
        sparkY = [];
        sparkDx = [];
        sparkDy = [];
        sparkLife = [];
        diamondsGot = 0;
        diamondsNeed = need;
        timeLeft = seconds;
        timeAccMs = 0;
        physicsAccMs = 0;
        exitOpen = false;
        fanfarePlayed = false;
        crushSfxPlayed = false;
        playerAlive = true;
        deadTimerMs = 0;
        winTimerMs = 0;
        shakeMs = 0;
        flashMs = 0;
        playerX = 1;
        playerY = 1;
        facingLeft = false;
        exitX = 1;
        exitY = 1;

        var y = 0;
        while (y < rows) {
            var line = mapRows[y];
            var x = 0;
            while (x < cols) {
                var ch = str.substring(line, x, 1);
                var tile = tileFromChar(ch);
                cells.append(tile);
                falling.append(0);
                var dir = 1;
                if (x > 20) {
                    dir = 3;
                }
                facing.append(dir);
                moved.append(0);
                if (tile == PLAYER) {
                    playerX = x;
                    playerY = y;
                }
                if (tile == EXIT_CLOSED || tile == EXIT_OPEN) {
                    exitX = x;
                    exitY = y;
                }
                x = x + 1;
            }
            y = y + 1;
        }
    }

    function loadLevel(n) {
        level = n;
        if (n == 1) {
            loadRows([
                "WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW",
                "W........P.............................W",
                "W......................................W",
                "W............OOOO......................W",
                "W............O**O.........O............W",
                "W............OOOO.........O............W",
                "W.........................O....*.......W",
                "W..........####.................*......W",
                "W..........#  #.............####.......W",
                "W..........#F.#.............#  #.......W",
                "W..........####.............#.*#.......W",
                "W...........................####.......W",
                "W....O.................................W",
                "W....O............***..................W",
                "W......................................W",
                "W################....##################W",
                "W................    .................XW",
                "W......................................W",
                "W......O................O..............W",
                "W......O........*.......O..............W",
                "W......................................W",
                "WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW"
            ], 6, 150);
        } else if (n == 2) {
            loadRows([
                "WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW",
                "W....P.................................W",
                "W......................................W",
                "W....OOOOO.............OOOOO...........W",
                "W....O***O.............*   *...........W",
                "W....OOOOO.............O   O...........W",
                "W......................OOOOO...........W",
                "W......................................W",
                "W##########................############W",
                "W         #................#           W",
                "W    F   .#........O.......#.    Y     W",
                "W         #................#           W",
                "W##########........O.......############W",
                "W..................O...................W",
                "W.........***......O......***..........W",
                "W......................................W",
                "W....O.........................O.......W",
                "W....O..........X..............O.......W",
                "W....OOOOOOOOOOOOOOOOOOOOOOOOOOO.......W",
                "W......................................W",
                "W......................................W",
                "WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW"
            ], 8, 140);
        } else {
            loadRows([
                "WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW",
                "WP.....................................W",
                "W......................................W",
                "W..############..........############..W",
                "W..#F         #..........#         Y#..W",
                "W..#          #..........#          #..W",
                "W..#    **    #..........#    **    #..W",
                "W..############..........############..W",
                "W......................................W",
                "W....O..O..O..O..........O..O..O..O....W",
                "W....O**O**O**O..........O**O**O**O....W",
                "W....OOOOOOOOOO..........OOOOOOOOOO....W",
                "W......................................W",
                "W##################  ##################W",
                "W                  F                   W",
                "W######################################W",
                "W......................................W",
                "W......*........X.........*............W",
                "W......O..................O............W",
                "W......O........Y.........O............W",
                "W......................................W",
                "WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW"
            ], 12, 160);
        }
        state = "playing";
    }

    function queueBoom(x, y, fillTile) {
        boomX.append(x);
        boomY.append(y);
        boomFill.append(fillTile);
    }

    function collectDiamond() {
        diamondsGot = diamondsGot + 1;
        score = score + 10;
        if (exitOpen) {
            score = score + 10;
        }
        spawnSparks(playerX, playerY, 6);
        game.audioPlayTone(880 + (diamondsGot * 18), 70, "square", 0.12);
        game.audioPlaySample("assets/beep_hi.wav", 0.8, { "pan": samplePan(), "playbackRate": 1.05 + (diamondsGot * 0.03) });
        if (!exitOpen && diamondsGot >= diamondsNeed) {
            openExit();
        }
    }

    function openExit() {
        exitOpen = true;
        var y = 0;
        while (y < rows) {
            var x = 0;
            while (x < cols) {
                if (getTile(x, y) == EXIT_CLOSED) {
                    setTile(x, y, EXIT_OPEN);
                    exitX = x;
                    exitY = y;
                }
                x = x + 1;
            }
            y = y + 1;
        }
        if (!fanfarePlayed) {
            game.audioPlayTone(520, 90, "square", 0.12);
            game.audioPlayTone(660, 110, "square", 0.12);
            game.audioPlayTone(780, 140, "square", 0.12);
            game.audioPlaySample("assets/beep_hi.wav", 0.9, { "playbackRate": 1.4 });
            fanfarePlayed = true;
            bumpShake(140);
        }
    }

    function killPlayer() {
        if (!playerAlive) {
            return;
        }
        playerAlive = false;
        setTile(playerX, playerY, EMPTY);
        crushSfxPlayed = true;
        spawnSparks(playerX, playerY, 10);
        bumpShake(220);
        game.audioPlayNoise(160, 0.16);
        game.audioPlayTone(180, 220, "sawtooth", 0.12);
        game.audioPlaySample("assets/beep_lo.wav", 0.9, { "pan": samplePan(), "playbackRate": 0.55 });
        deadTimerMs = 900;
        state = "dead";
    }

    function applyExplosion(cx, cy, fillTile) {
        var dy = -1;
        while (dy <= 1) {
            var dx = -1;
            while (dx <= 1) {
                var x = cx + dx;
                var y = cy + dy;
                var tile = getTile(x, y);
                if (tile != STEEL) {
                    if (tile == PLAYER) {
                        killPlayer();
                    }
                    if (isEnemy(tile) && !(x == cx && y == cy)) {
                        var nestedFill = EMPTY;
                        if (tile == BUTTERFLY) {
                            nestedFill = DIAMOND;
                        }
                        queueBoom(x, y, nestedFill);
                    }
                    setTile(x, y, fillTile);
                    setFalling(x, y, 0);
                }
                dx = dx + 1;
            }
            dy = dy + 1;
        }
        spawnSparks(cx, cy, 8);
        bumpShake(160);
        game.audioPlayNoise(120, 0.14);
        game.audioPlayTone(140, 80, "sawtooth", 0.10);
        game.audioPlaySample("assets/beep_lo.wav", 0.75, { "pan": samplePan(), "playbackRate": 0.7 });
    }

    function flushBooms() {
        var i = 0;
        while (i < boomX.length && i < 64) {
            applyExplosion(boomX[i], boomY[i], boomFill[i]);
            i = i + 1;
        }
        boomX = [];
        boomY = [];
        boomFill = [];
    }

    function moveRock(x, y, nx, ny, tile) {
        setTile(x, y, EMPTY);
        setFalling(x, y, 0);
        setTile(nx, ny, tile);
        setFalling(nx, ny, 1);
    }

    function physicsRocks() {
        var y = rows - 2;
        while (y >= 0) {
            var x = 0;
            while (x < cols) {
                var tile = getTile(x, y);
                if (isRound(tile)) {
                    var below = getTile(x, y + 1);
                    if (below == EMPTY) {
                        moveRock(x, y, x, y + 1, tile);
                    } else {
                        if (getFalling(x, y) == 1) {
                            if (below == PLAYER) {
                                killPlayer();
                            } else if (isEnemy(below)) {
                                var fill = EMPTY;
                                if (below == BUTTERFLY) {
                                    fill = DIAMOND;
                                }
                                queueBoom(x, y + 1, fill);
                            } else {
                                game.audioPlayTone(90, 40, "triangle", 0.08);
                            }
                            setFalling(x, y, 0);
                        }
                        if (isRound(below)) {
                            if (getTile(x - 1, y) == EMPTY && getTile(x - 1, y + 1) == EMPTY) {
                                moveRock(x, y, x - 1, y, tile);
                            } else if (getTile(x + 1, y) == EMPTY && getTile(x + 1, y + 1) == EMPTY) {
                                moveRock(x, y, x + 1, y, tile);
                            }
                        }
                    }
                }
                x = x + 1;
            }
            y = y - 1;
        }
    }

    function tryEnemyDir(x, y, d, tile) {
        var nx = x + dirDx(d);
        var ny = y + dirDy(d);
        var dest = getTile(nx, ny);
        if (dest == PLAYER) {
            var fill = EMPTY;
            if (tile == BUTTERFLY) {
                fill = DIAMOND;
            }
            queueBoom(x, y, fill);
            killPlayer();
            return true;
        }
        if (dest == EMPTY) {
            setTile(x, y, EMPTY);
            setTile(nx, ny, tile);
            var destIndex = idx(nx, ny);
            facing[destIndex] = d;
            moved[destIndex] = 1;
            return true;
        }
        return false;
    }

    function physicsEnemies() {
        var i = 0;
        while (i < moved.length) {
            moved[i] = 0;
            i = i + 1;
        }

        var y = 0;
        while (y < rows) {
            var x = 0;
            while (x < cols) {
                var tile = getTile(x, y);
                if (isEnemy(tile) && moved[idx(x, y)] == 0) {
                    var d = facing[idx(x, y)];
                    var prefer = (d + 3) % 4;
                    if (tile == BUTTERFLY) {
                        prefer = (d + 1) % 4;
                    }
                    var second = d;
                    var third = (d + 1) % 4;
                    if (tile == BUTTERFLY) {
                        third = (d + 3) % 4;
                    }
                    var fourth = (d + 2) % 4;
                    if (!tryEnemyDir(x, y, prefer, tile)) {
                        if (!tryEnemyDir(x, y, second, tile)) {
                            if (!tryEnemyDir(x, y, third, tile)) {
                                tryEnemyDir(x, y, fourth, tile);
                            }
                        }
                    }
                }
                x = x + 1;
            }
            y = y + 1;
        }
    }

    function tryPlayerMove(dx, dy) {
        if (!playerAlive) {
            return;
        }
        var nx = playerX + dx;
        var ny = playerY + dy;
        var dest = getTile(nx, ny);

        if (dx < 0) {
            facingLeft = true;
        }
        if (dx > 0) {
            facingLeft = false;
        }

        if (dest == STEEL || dest == BRICK || dest == EXIT_CLOSED) {
            return;
        }

        if (dest == BOULDER) {
            if (dy != 0) {
                return;
            }
            var bx = nx + dx;
            var by = ny;
            if (getTile(bx, by) != EMPTY) {
                return;
            }
            if (getFalling(nx, ny) == 1) {
                return;
            }
            setTile(nx, ny, EMPTY);
            setTile(bx, by, BOULDER);
            setFalling(bx, by, 0);
            dest = EMPTY;
            game.audioPlayTone(160, 30, "triangle", 0.07);
            game.audioPlaySample("assets/beep_lo.wav", 0.45, { "pan": samplePan(), "playbackRate": 0.85 });
        }

        if (isEnemy(dest)) {
            var fill = EMPTY;
            if (dest == BUTTERFLY) {
                fill = DIAMOND;
            }
            queueBoom(nx, ny, fill);
            killPlayer();
            return;
        }

        if (dest == DIAMOND) {
            collectDiamond();
            dest = EMPTY;
        } else if (dest == DIRT) {
            game.audioPlayTone(210, 18, "triangle", 0.05);
            dest = EMPTY;
        } else if (dest == EXIT_OPEN) {
            score = score + timeLeft;
            rememberHigh();
            game.audioPlayTone(620, 80, "square", 0.12);
            game.audioPlayTone(780, 100, "square", 0.12);
            game.audioPlayTone(940, 140, "square", 0.12);
            game.audioPlaySample("assets/beep_hi.wav", 0.9, { "playbackRate": 1.6 });
            winTimerMs = 700;
            state = "cleared";
        }

        setTile(playerX, playerY, EMPTY);
        playerX = nx;
        playerY = ny;
        setTile(playerX, playerY, PLAYER);
    }

    function readMoveDx() {
        if (game.isKeyDown("arrowleft") || game.isKeyDown("a")) {
            return -1;
        }
        if (game.isKeyDown("arrowright") || game.isKeyDown("d")) {
            return 1;
        }
        if (game.isGamepadConnected(0)) {
            if (game.isGamepadButtonDown(0, 14)) {
                return -1;
            }
            if (game.isGamepadButtonDown(0, 15)) {
                return 1;
            }
            var ax = game.getGamepadAxis(0, 0, 0.35);
            if (ax < -0.45) {
                return -1;
            }
            if (ax > 0.45) {
                return 1;
            }
        }
        return 0;
    }

    function readMoveDy() {
        if (game.isKeyDown("arrowup") || game.isKeyDown("w")) {
            return -1;
        }
        if (game.isKeyDown("arrowdown") || game.isKeyDown("s")) {
            return 1;
        }
        if (game.isGamepadConnected(0)) {
            if (game.isGamepadButtonDown(0, 12)) {
                return -1;
            }
            if (game.isGamepadButtonDown(0, 13)) {
                return 1;
            }
            var ay = game.getGamepadAxis(0, 1, 0.35);
            if (ay < -0.45) {
                return -1;
            }
            if (ay > 0.45) {
                return 1;
            }
        }
        return 0;
    }

    function pointerMove() {
        var wx = 0.0;
        var wy = 0.0;
        var hasAim = false;
        var touches = game.getTouches();
        if (touches.length > 0) {
            var world = game.screenToWorld(touches[0].x, touches[0].y);
            wx = world.x;
            wy = world.y;
            hasAim = true;
        } else if (game.isMouseDown(0)) {
            wx = game.getMouseWorldX();
            wy = game.getMouseWorldY();
            hasAim = true;
        }
        if (!hasAim) {
            return;
        }
        var mx = int(wx / tileSize);
        var my = int(wy / tileSize);
        var dx = mx - playerX;
        var dy = my - playerY;
        if (dx == 0 && dy == 0) {
            return;
        }
        var adx = dx;
        if (adx < 0) {
            adx = 0 - adx;
        }
        var ady = dy;
        if (ady < 0) {
            ady = 0 - ady;
        }
        if (adx > ady) {
            if (dx < 0) {
                tryPlayerMove(-1, 0);
            } else {
                tryPlayerMove(1, 0);
            }
        } else {
            if (dy < 0) {
                tryPlayerMove(0, -1);
            } else {
                tryPlayerMove(0, 1);
            }
        }
    }

    function bootAudioIfNeeded() {
        if (audioBooted) {
            return;
        }
        var wants =
            game.wasKeyPressed("enter") ||
            game.wasKeyPressed(" ") ||
            game.wasMousePressed(0) ||
            game.wasGamepadButtonPressed(0, 0) ||
            game.isKeyDown("arrowleft") ||
            game.isKeyDown("arrowright") ||
            game.isKeyDown("arrowup") ||
            game.isKeyDown("arrowdown") ||
            game.isKeyDown("a") ||
            game.isKeyDown("d") ||
            game.isKeyDown("w") ||
            game.isKeyDown("s") ||
            game.isMouseDown(0);
        if (wants) {
            game.audioInit();
            audioBooted = true;
            game.audioSetMasterVolume(0.42);
        }
    }

    function maybeStartPattern() {
        if (audioBooted && game.audioIsReady() && !patternStarted) {
            game.audioPlayPattern({
                "tempoBpm": 96,
                "loop": true,
                "tracks": [
                    [
                        { "atBeats": 0.0, "noteHz": 98, "durBeats": 0.4, "waveType": "triangle", "volume": 0.08 },
                        { "atBeats": 0.5, "noteHz": 130, "durBeats": 0.4, "waveType": "triangle", "volume": 0.07 },
                        { "atBeats": 1.0, "noteHz": 98, "durBeats": 0.4, "waveType": "triangle", "volume": 0.08 },
                        { "atBeats": 1.5, "noteHz": 147, "durBeats": 0.4, "waveType": "triangle", "volume": 0.07 }
                    ]
                ]
            });
            patternStarted = true;
        }
    }

    function restartRun() {
        game.audioStopAll();
        patternStarted = false;
        score = 0;
        lives = 3;
        loadLevel(1);
    }

    function afterDeath() {
        lives = lives - 1;
        if (lives <= 0) {
            rememberHigh();
            state = "gameover";
            game.audioStopPattern();
            game.audioPlayTone(220, 160, "sawtooth", 0.12);
            game.audioPlayTone(140, 220, "sawtooth", 0.12);
        } else {
            loadLevel(level);
        }
    }

    function afterClear() {
        if (level >= maxLevel) {
            rememberHigh();
            state = "win";
            game.audioStopPattern();
        } else {
            loadLevel(level + 1);
        }
    }

    function caveTick() {
        if (state != "playing" || !playerAlive) {
            return;
        }

        var dy = readMoveDy();
        var dx = 0;
        if (dy == 0) {
            dx = readMoveDx();
        }
        if (dx != 0 || dy != 0) {
            tryPlayerMove(dx, dy);
        } else {
            pointerMove();
        }

        physicsRocks();
        physicsEnemies();
        flushBooms();
    }

    function updateSparks() {
        var i = 0;
        while (i < sparkX.length) {
            sparkLife[i] = sparkLife[i] - 16;
            if (sparkLife[i] <= 0) {
                sparkX[i] = sparkX[sparkX.length - 1];
                sparkY[i] = sparkY[sparkY.length - 1];
                sparkDx[i] = sparkDx[sparkDx.length - 1];
                sparkDy[i] = sparkDy[sparkDy.length - 1];
                sparkLife[i] = sparkLife[sparkLife.length - 1];
                sparkX.pop();
                sparkY.pop();
                sparkDx.pop();
                sparkDy.pop();
                sparkLife.pop();
            } else {
                var hit = game.sweepTiles(
                    sparkX[i] - 2,
                    sparkY[i] - 2,
                    4,
                    4,
                    sparkDx[i],
                    sparkDy[i],
                    cells,
                    tileSize,
                    tileSize,
                    { "columns": cols, "rows": rows, "solids": [STEEL, BRICK], "out": STEEL }
                );
                sparkX[i] = hit.x + 2;
                sparkY[i] = hit.y + 2;
                if (hit.hit) {
                    if (hit.nx != 0) {
                        sparkDx[i] = 0 - sparkDx[i];
                    }
                    if (hit.ny != 0) {
                        sparkDy[i] = 0 - sparkDy[i];
                    }
                }
                i = i + 1;
            }
        }
    }

    function wantsStart() {
        return game.wasKeyPressed("enter") ||
            game.wasKeyPressed(" ") ||
            game.wasMousePressed(0) ||
            game.wasGamepadButtonPressed(0, 0);
    }

    function wantsPause() {
        return game.wasKeyPressed("p") || game.wasGamepadButtonPressed(0, 9);
    }

    function wantsRestart() {
        return game.wasKeyPressed("r") || game.wasKeyPressed("enter") || game.wasGamepadButtonPressed(0, 0);
    }

    function updateZoom() {
        if (game.wasKeyPressed("]") || game.wasKeyPressed("=")) {
            camZoom = camZoom * 1.12;
        }
        if (game.wasKeyPressed("[") || game.wasKeyPressed("-")) {
            camZoom = camZoom / 1.12;
        }
        if (game.wasKeyPressed("0")) {
            camZoom = 1.0;
        }
        if (game.isGamepadButtonDown(0, 1)) {
            lookZoom = true;
        }
        if (game.wasGamepadButtonReleased(0, 1)) {
            lookZoom = false;
        }
        game.setCameraZoom(camZoom);
        camZoom = game.getCameraZoom();
        if (lookZoom) {
            game.setCameraZoom(camZoom * 0.72);
        }
    }

    function updateGame(dtMs) {
        animMs = animMs + dtMs;
        if (shakeMs > 0) {
            shakeMs = shakeMs - dtMs;
        }
        if (flashMs > 0) {
            flashMs = flashMs - dtMs;
        }

        bootAudioIfNeeded();
        maybeStartPattern();
        updateZoom();
        updateSparks();

        if (state == "splash") {
            if (wantsStart()) {
                loadLevel(1);
                game.audioPlayTone(520, 70, "square", 0.12);
                game.audioPlayTone(660, 80, "square", 0.10);
            }
            return;
        }

        if (wantsPause()) {
            if (state == "playing") {
                state = "paused";
                game.audioPlayTone(330, 40, "triangle", 0.09);
            } else if (state == "paused") {
                state = "playing";
                game.audioPlayTone(520, 40, "triangle", 0.09);
            }
        }

        if (state == "gameover" || state == "win") {
            if (wantsRestart()) {
                restartRun();
            }
            return;
        }

        if (state == "dead") {
            deadTimerMs = deadTimerMs - dtMs;
            if (deadTimerMs <= 0) {
                afterDeath();
            }
            return;
        }

        if (state == "cleared") {
            winTimerMs = winTimerMs - dtMs;
            if (winTimerMs <= 0) {
                afterClear();
            }
            return;
        }

        if (state == "paused") {
            return;
        }

        if (game.wasKeyPressed("r")) {
            loadLevel(level);
            return;
        }

        timeAccMs = timeAccMs + dtMs;
        if (timeAccMs >= 1000) {
            timeAccMs = timeAccMs - 1000;
            timeLeft = timeLeft - 1;
            if (timeLeft <= 0) {
                timeLeft = 0;
                killPlayer();
                return;
            }
            if (timeLeft == 10) {
                game.audioPlayTone(740, 80, "square", 0.12);
            }
        }

        physicsAccMs = physicsAccMs + dtMs;
        while (physicsAccMs >= physicsIntervalMs) {
            physicsAccMs = physicsAccMs - physicsIntervalMs;
            caveTick();
            if (state != "playing") {
                break;
            }
        }
    }

    function atlasReady() {
        return game.imageIsReady(atlas);
    }

    function blitId(id, px, py, extra) {
        var index = id - 1;
        var sx = (index % atlasCols) * srcSize;
        var sy = int(index / atlasCols) * srcSize;
        var opts = extra;
        if (opts == null) {
            opts = {};
        }
        opts["sx"] = sx;
        opts["sy"] = sy;
        opts["sw"] = srcSize;
        opts["sh"] = srcSize;
        if (opts["w"] == null) {
            opts["w"] = tileSize;
        }
        if (opts["h"] == null) {
            opts["h"] = tileSize;
        }
        game.drawImageEx(atlas, px, py, opts);
    }

    function drawFallbackTile(x, y) {
        var tile = getTile(x, y);
        var px = x * tileSize;
        var py = y * tileSize;
        if (tile == STEEL) {
            game.fillRect(px, py, tileSize, tileSize, "#4b5563");
        } else if (tile == BRICK) {
            game.fillRect(px, py, tileSize, tileSize, "#9a3412");
        } else if (tile == DIRT) {
            game.fillRect(px, py, tileSize, tileSize, "#6b3f1f");
        } else if (tile == BOULDER) {
            game.fillRect(px, py, tileSize, tileSize, "#1c1917");
            game.fillCircle(px + 16, py + 17, 12, "#57534e");
        } else if (tile == DIAMOND) {
            game.fillRect(px, py, tileSize, tileSize, "#1c1917");
            game.fillCircle(px + 16, py + 16, 10, "#22d3ee");
        } else if (tile == PLAYER) {
            game.fillRect(px, py, tileSize, tileSize, "#1c1917");
            game.fillCircle(px + 16, py + 17, 12, "#f59e0b");
        } else if (tile == FIREFLY) {
            game.fillRect(px, py, tileSize, tileSize, "#1c1917");
            game.fillCircle(px + 16, py + 16, 10, "#4ade80");
        } else if (tile == BUTTERFLY) {
            game.fillRect(px, py, tileSize, tileSize, "#1c1917");
            game.fillCircle(px + 16, py + 16, 10, "#e879f9");
        } else if (tile == EXIT_CLOSED) {
            game.fillRect(px + 6, py + 4, tileSize - 12, tileSize - 6, "#334155");
        } else if (tile == EXIT_OPEN) {
            game.fillRect(px + 6, py + 4, tileSize - 12, tileSize - 6, "#22c55e");
        }
    }

    function drawActors() {
        var y = 0;
        while (y < rows) {
            var x = 0;
            while (x < cols) {
                var tile = getTile(x, y);
                var px = x * tileSize;
                var py = y * tileSize;
                var cx = px + (tileSize / 2);
                var cy = py + (tileSize / 2);
                if (tile == DIAMOND) {
                    var gemId = DIAMOND;
                    if ((int(animMs / 180) % 2) == 1) {
                        gemId = 12;
                    }
                    blitId(gemId, cx, cy, {
                        "ox": tileSize / 2,
                        "oy": tileSize / 2,
                        "angle": animMs / 420
                    });
                    if (game.overlapCircle(playerWorldX(), playerWorldY(), 28, cx, cy, 12)) {
                        game.setBlend("add");
                        game.strokeCircle(cx, cy, 14 + ((int(animMs / 80) % 3)), "#67e8f9", 2);
                        game.setBlend("alpha");
                    }
                } else if (tile == PLAYER) {
                    var pId = PLAYER;
                    if ((int(animMs / 140) % 2) == 1) {
                        pId = 13;
                    }
                    var popts = {
                        "ox": tileSize / 2,
                        "oy": tileSize / 2,
                        "flipX": facingLeft
                    };
                    if (flashMs > 0 || !playerAlive) {
                        popts["tint"] = "#ffffff";
                        popts["tintFill"] = true;
                    }
                    blitId(pId, cx, cy, popts);
                } else if (tile == FIREFLY) {
                    var fId = FIREFLY;
                    if ((int(animMs / 120) % 2) == 1) {
                        fId = 15;
                    }
                    blitId(fId, cx, cy, { "ox": tileSize / 2, "oy": tileSize / 2 });
                } else if (tile == BUTTERFLY) {
                    blitId(BUTTERFLY, cx, cy, {
                        "ox": tileSize / 2,
                        "oy": tileSize / 2,
                        "angle": math.sin(animMs / 90) * 0.25
                    });
                }
                x = x + 1;
            }
            y = y + 1;
        }
    }

    function drawSparks() {
        if (sparkX.length == 0) {
            return;
        }
        game.setBlend("add");
        var i = 0;
        while (i < sparkX.length) {
            if (atlasReady()) {
                blitId(14, sparkX[i], sparkY[i], {
                    "w": 12,
                    "h": 12,
                    "ox": 6,
                    "oy": 6,
                    "angle": animMs / 80
                });
            } else {
                game.fillCircle(sparkX[i], sparkY[i], 3, "#fde68a");
            }
            i = i + 1;
        }
        game.setBlend("alpha");
    }

    function applyCamera() {
        var z = game.getCameraZoom();
        if (z <= 0) {
            z = 1;
        }
        var cw = game.getCanvasWidth();
        var ch = game.getCanvasHeight();
        if (cw <= 0) {
            cw = canvasW;
        }
        if (ch <= 0) {
            ch = canvasH;
        }
        var viewW = cw / z;
        var viewH = ch / z;
        var targetX = playerWorldX();
        var targetY = playerWorldY();
        if (state == "splash") {
            targetX = worldW / 2;
            targetY = worldH / 2;
        }
        game.followCamera(targetX, targetY, viewW, viewH, worldW, worldH, {
            "snap": true
        });
        if (shakeMs > 0) {
            var mag = shakeMs / 28;
            game.setCamera(
                game.getCameraX() + (math.sin(animMs / 16) * mag),
                game.getCameraY() + (math.cos(animMs / 13) * mag)
            );
        }
    }

    function drawCaveLighting() {
        var z = game.getCameraZoom();
        if (z <= 0) {
            z = 1;
        }
        var viewW = canvasW / z;
        var viewH = canvasH / z;
        game.setBlend("multiply");
        game.fillRect(game.getCameraX(), game.getCameraY(), viewW, viewH, "#8b9aab");
        game.setBlend("add");
        game.fillCircle(playerWorldX(), playerWorldY(), 92, "#2a2214");
        if (exitOpen) {
            game.strokeCircle((exitX + 0.5) * tileSize, (exitY + 0.5) * tileSize, 18 + ((int(animMs / 160) % 4)), "#86efac", 2);
        }
        game.setBlend("alpha");
    }

    function beginHud() {
        game.pushCamera();
        game.setCamera(0, 0);
        game.setCameraZoom(1);
    }

    function endHud() {
        game.popCamera();
    }

    function renderHud() {
        beginHud();
        game.setAlpha(0.82);
        game.fillRect(0, 0, canvasW, 36, "#0c0a09");
        game.setAlpha(1);
        game.drawLine(0, 36, canvasW, 36, "#fbbf24", 2);

        var gemColor = "#67e8f9";
        if (exitOpen) {
            gemColor = "#86efac";
        }
        var timeColor = "#e7e5e4";
        if (timeLeft <= 10) {
            timeColor = "#f87171";
        }
        var hud = "Maldadash  Lv " + string(level) + "/" + string(maxLevel);
        hud = hud + "   * " + string(diamondsGot) + "/" + string(diamondsNeed);
        hud = hud + "   Time " + string(timeLeft);
        hud = hud + "   Lives " + string(lives);
        hud = hud + "   Score " + string(score);
        hud = hud + "   High " + string(high);
        var font = "bold 14px monospace";
        var measured = game.measureText(hud, font);
        if (measured.width > canvasW - 24) {
            font = "12px monospace";
        }
        game.drawText(hud, 12, 24, "#f8fafc", font);
        var barW = 160;
        var filled = 0;
        if (diamondsNeed > 0) {
            filled = int((diamondsGot / diamondsNeed) * barW);
            if (filled > barW) {
                filled = barW;
            }
        }
        game.fillRect(canvasW - barW - 12, 8, barW, 6, "#292524");
        game.fillRect(canvasW - barW - 12, 8, filled, 6, gemColor);
        game.strokeRect(canvasW - barW - 12, 8, barW, 6, timeColor, 1);

        if (flashMs > 0) {
            var a = flashMs / 220;
            if (a > 0.45) {
                a = 0.45;
            }
            game.setAlpha(a);
            game.fillRect(0, 0, canvasW, canvasH, "#fff7ed");
            game.setAlpha(1);
        }
        endHud();
    }

    function renderPanel(title, subtitle) {
        beginHud();
        var panelW = 520;
        var panelH = 200;
        var panelX = (canvasW - panelW) / 2;
        var panelY = 88;
        game.setAlpha(0.92);
        game.fillRect(panelX, panelY, panelW, panelH, "#0c0a09");
        game.setAlpha(1);
        game.strokeRect(panelX, panelY, panelW, panelH, "#fbbf24", 3);
        game.drawText(title, panelX + 28, panelY + 70, "#f8fafc", "bold 28px sans-serif");
        game.drawText(subtitle, panelX + 28, panelY + 118, "#d6d3d1", "16px sans-serif");
        endHud();
    }

    function renderGame() {
        game.clear();
        applyCamera();

        if (atlasReady()) {
            var iw = game.imageWidth(atlas);
            if (iw >= srcSize) {
                atlasCols = int(iw / srcSize);
            }
            game.drawTiles(atlas, cells, tileSize, tileSize, {
                "columns": cols,
                "rows": rows,
                "srcW": srcSize,
                "srcH": srcSize,
                "atlasColumns": atlasCols,
                "firstId": 1,
                "empty": 0
            });
            drawActors();
        } else {
            var y = 0;
            while (y < rows) {
                var x = 0;
                while (x < cols) {
                    drawFallbackTile(x, y);
                    x = x + 1;
                }
                y = y + 1;
            }
        }

        drawSparks();
        if (state != "splash") {
            drawCaveLighting();
            renderHud();
        }

        if (state == "splash") {
            beginHud();
            if (atlasReady()) {
                blitId(5, canvasW / 2, 58, {
                    "w": 48,
                    "h": 48,
                    "ox": 24,
                    "oy": 24,
                    "angle": animMs / 280
                });
            }
            endHud();
            renderPanel("Maldadash", "Arrows / WASD / pad / click to dig. SPACE starts. P pauses.");
            beginHud();
            game.drawText("Collect diamonds, shove boulders, reach the glowing exit.", 80, 300, "#a8a29e", "14px sans-serif");
            game.drawText("[ ] zoom   0 reset   B look   High " + string(high), 80, 322, "#a8a29e", "14px sans-serif");
            endHud();
        } else if (state == "paused") {
            renderPanel("Paused", "Press P or Start to continue");
        } else if (state == "dead") {
            renderPanel("Crushed!", "Reloading cave...");
        } else if (state == "cleared") {
            renderPanel("Cave cleared!", "Next cave...");
        } else if (state == "gameover") {
            renderPanel("Game Over", "Press R or Enter  —  High " + string(high));
        } else if (state == "win") {
            renderPanel("You cleared Maldadash!", "Press R or Enter to play again  —  High " + string(high));
        }
    }

    game.createCanvas(canvasW, canvasH, "#app");
    game.setBackground("#1c1917");
    game.setPixelated(true);
    game.startFixed(updateGame, renderGame);
}
