function randomMatrix(rows: int, cols: int, scale: float) -> array {
    var matrix = [];
    var i = 0;
    while (i < rows) {
        var row = [];
        var j = 0;
        while (j < cols) {
            row.append(math.randomFloat(-scale, scale));
            j = j + 1;
        }
        matrix.append(row);
        i = i + 1;
    }
    return matrix;
}

function randomVector(n: int, scale: float) -> array {
    var values = [];
    var i = 0;
    while (i < n) {
        values.append(math.randomFloat(-scale, scale));
        i = i + 1;
    }
    return values;
}

function zeroMatrix(rows: int, cols: int) -> array {
    var matrix = [];
    var i = 0;
    while (i < rows) {
        var row = [];
        var j = 0;
        while (j < cols) {
            row.append(0.0);
            j = j + 1;
        }
        matrix.append(row);
        i = i + 1;
    }
    return matrix;
}

function zeroVector(n: int) -> array {
    var values = [];
    var i = 0;
    while (i < n) {
        values.append(0.0);
        i = i + 1;
    }
    return values;
}

function addMatrix(dst: array, src: array) {
    var i = 0;
    while (i < dst.length) {
        var j = 0;
        while (j < dst[i].length) {
            dst[i][j] = dst[i][j] + src[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
}

function addVector(dst: array, src: array) {
    var i = 0;
    while (i < dst.length) {
        dst[i] = dst[i] + src[i];
        i = i + 1;
    }
}

function applyMatrix(weights: array, grad: array, lr: float) {
    var i = 0;
    while (i < weights.length) {
        var j = 0;
        while (j < weights[i].length) {
            var g = grad[i][j];
            if (g > 4.0) {
                g = 4.0;
            }
            if (g < -4.0) {
                g = -4.0;
            }
            weights[i][j] = weights[i][j] - lr * g;
            j = j + 1;
        }
        i = i + 1;
    }
}

function applyVector(bias: array, grad: array, lr: float) {
    var i = 0;
    while (i < bias.length) {
        var g = grad[i];
        if (g > 4.0) {
            g = 4.0;
        }
        if (g < -4.0) {
            g = -4.0;
        }
        bias[i] = bias[i] - lr * g;
        i = i + 1;
    }
}

@shader()
function vertexMain() {
    vUv = uv;
    gl_Position = vec4(position.xy, 0.0, 1.0);
}

@shader()
function hitSphere(center: vec3, radius: float, origin: vec3, dir: vec3) -> float {
    var oc: vec3 = origin - center;
    var a: float = dot(dir, dir);
    var b: float = dot(oc, dir);
    var c: float = dot(oc, oc) - radius * radius;
    var disc: float = b * b - a * c;
    if (disc < 0.0) {
        return -1.0;
    }
    var root: float = sqrt(disc);
    var t: float = (-b - root) / a;
    if (t > EPSILON) {
        return t;
    }
    t = (-b + root) / a;
    if (t > EPSILON) {
        return t;
    }
    return -1.0;
}

@shader()
function hitBox(bmin: vec3, bmax: vec3, origin: vec3, dir: vec3) -> float {
    var inv: vec3 = vec3(1.0, 1.0, 1.0) / dir;
    var t0: vec3 = (bmin - origin) * inv;
    var t1: vec3 = (bmax - origin) * inv;
    var tmin: vec3 = min(t0, t1);
    var tmax: vec3 = max(t0, t1);
    var tEnter: float = max(max(tmin.x, tmin.y), tmin.z);
    var tExit: float = min(min(tmax.x, tmax.y), tmax.z);
    if (tExit < tEnter) {
        return -1.0;
    }
    if (tEnter > EPSILON) {
        return tEnter;
    }
    if (tExit > EPSILON) {
        return tExit;
    }
    return -1.0;
}

@shader()
function boxNormal(bmin: vec3, bmax: vec3, p: vec3) -> vec3 {
    var c: vec3 = (bmin + bmax) * 0.5;
    var d: vec3 = (p - c) / max(bmax - bmin, vec3(EPSILON, EPSILON, EPSILON));
    var ad: vec3 = abs(d);
    if (ad.x > ad.y && ad.x > ad.z) {
        return vec3(sign(d.x), 0.0, 0.0);
    }
    if (ad.y > ad.z) {
        return vec3(0.0, sign(d.y), 0.0);
    }
    return vec3(0.0, 0.0, sign(d.z));
}

@shader()
function hitBoxRotated(center: vec3, halfSize: vec3, angle: float, origin: vec3, dir: vec3) -> float {
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var o: vec3 = origin - center;
    var oLocal: vec3 = vec3(ca * o.x + sa * o.z, o.y, -sa * o.x + ca * o.z);
    var dLocal: vec3 = vec3(ca * dir.x + sa * dir.z, dir.y, -sa * dir.x + ca * dir.z);
    return hitBox(-halfSize, halfSize, oLocal, dLocal);
}

@shader()
function boxNormalRotated(center: vec3, halfSize: vec3, angle: float, p: vec3) -> vec3 {
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var o: vec3 = p - center;
    var pLocal: vec3 = vec3(ca * o.x + sa * o.z, o.y, -sa * o.x + ca * o.z);
    var nLocal: vec3 = boxNormal(-halfSize, halfSize, pLocal);
    return vec3(ca * nLocal.x - sa * nLocal.z, nLocal.y, sa * nLocal.x + ca * nLocal.z);
}

@shader()
function hitCylinder(center: vec3, radius: float, y0: float, y1: float, origin: vec3, dir: vec3) -> float {
    var ocx: float = origin.x - center.x;
    var ocz: float = origin.z - center.z;
    var a: float = dir.x * dir.x + dir.z * dir.z;
    var b: float = ocx * dir.x + ocz * dir.z;
    var c: float = ocx * ocx + ocz * ocz - radius * radius;
    var tBest: float = -1.0;
    if (abs(a) > EPSILON) {
        var disc: float = b * b - a * c;
        if (disc >= 0.0) {
            var root: float = sqrt(disc);
            var t: float = (-b - root) / a;
            var y: float = origin.y + dir.y * t;
            if (t > EPSILON && y >= y0 && y <= y1) {
                tBest = t;
            }
            t = (-b + root) / a;
            y = origin.y + dir.y * t;
            if (t > EPSILON && y >= y0 && y <= y1 && (tBest < 0.0 || t < tBest)) {
                tBest = t;
            }
        }
    }
    if (abs(dir.y) > EPSILON) {
        var tCap: float = (y0 - origin.y) / dir.y;
        var qx: float = origin.x + dir.x * tCap - center.x;
        var qz: float = origin.z + dir.z * tCap - center.z;
        if (tCap > EPSILON && qx * qx + qz * qz <= radius * radius && (tBest < 0.0 || tCap < tBest)) {
            tBest = tCap;
        }
        tCap = (y1 - origin.y) / dir.y;
        qx = origin.x + dir.x * tCap - center.x;
        qz = origin.z + dir.z * tCap - center.z;
        if (tCap > EPSILON && qx * qx + qz * qz <= radius * radius && (tBest < 0.0 || tCap < tBest)) {
            tBest = tCap;
        }
    }
    return tBest;
}

@shader()
function cylinderNormal(center: vec3, radius: float, y0: float, y1: float, p: vec3) -> vec3 {
    var radial: vec3 = vec3(p.x - center.x, 0.0, p.z - center.z);
    var dr: float = abs(length(radial) - radius);
    var dy0: float = abs(p.y - y0);
    var dy1: float = abs(p.y - y1);
    if (dy0 < dr && dy0 <= dy1) {
        return vec3(0.0, -1.0, 0.0);
    }
    if (dy1 < dr) {
        return vec3(0.0, 1.0, 0.0);
    }
    return normalize(radial);
}

@shader()
function hitWheel(center: vec3, radius: float, halfWidth: float, angle: float, origin: vec3, dir: vec3) -> float {
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var o: vec3 = origin - center;
    var oLocal: vec3 = vec3(ca * o.x + sa * o.z, -sa * o.x + ca * o.z, o.y);
    var dLocal: vec3 = vec3(ca * dir.x + sa * dir.z, -sa * dir.x + ca * dir.z, dir.y);
    return hitCylinder(vec3(0.0, 0.0, 0.0), radius, -halfWidth, halfWidth, oLocal, dLocal);
}

@shader()
function wheelNormal(center: vec3, radius: float, halfWidth: float, angle: float, p: vec3) -> vec3 {
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var o: vec3 = p - center;
    var pLocal: vec3 = vec3(ca * o.x + sa * o.z, -sa * o.x + ca * o.z, o.y);
    var nLocal: vec3 = cylinderNormal(vec3(0.0, 0.0, 0.0), radius, -halfWidth, halfWidth, pLocal);
    return vec3(ca * nLocal.x - sa * nLocal.y, nLocal.z, sa * nLocal.x + ca * nLocal.y);
}

@shader()
function carPosition(index: int) -> vec3 {
    return uCars[index];
}

@shader()
function carAngle(index: int) -> float {
    return uAngles[index];
}

@shader()
function carColor(index: int) -> vec3 {
    if (index == 0) {
        return vec3(0.92, 0.15, 0.18);
    }
    if (index == 1) {
        return vec3(0.12, 0.52, 0.95);
    }
    if (index == 2) {
        return vec3(0.15, 0.82, 0.28);
    }
    if (index == 3) {
        return vec3(0.95, 0.72, 0.12);
    }
    if (index == 4) {
        return vec3(0.85, 0.42, 0.15);
    }
    if (index == 5) {
        return vec3(0.58, 0.18, 0.72);
    }
    if (index == 6) {
        return vec3(0.18, 0.68, 0.72);
    }
    return vec3(0.72, 0.72, 0.72);
}

@shader()
function wheelOffset(w: int) -> vec3 {
    if (w == 0) {
        return vec3(0.78, 0.0, 0.52);
    }
    if (w == 1) {
        return vec3(0.78, 0.0, -0.52);
    }
    if (w == 2) {
        return vec3(-0.78, 0.0, 0.52);
    }
    return vec3(-0.78, 0.0, -0.52);
}

@shader()
function carBodyPart(slot: int) -> int {
    if (slot == 0) {
        return 0;
    }
    if (slot == 1) {
        return 5;
    }
    if (slot == 2) {
        return 6;
    }
    if (slot == 3) {
        return 7;
    }
    if (slot == 4) {
        return 8;
    }
    if (slot == 5) {
        return 11;
    }
    if (slot == 6) {
        return 12;
    }
    if (slot == 7) {
        return 13;
    }
    return 14;
}

@shader()
function carBoxCenter(part: int) -> vec3 {
    if (part == 5) {
        return vec3(0.86, 0.20, 0.0);
    }
    if (part == 6) {
        return vec3(-0.06, 0.40, 0.0);
    }
    if (part == 7) {
        return vec3(-0.46, 0.33, 0.0);
    }
    if (part == 8) {
        return vec3(-1.00, 0.62, 0.0);
    }
    if (part == 11) {
        return vec3(1.06, 0.11, 0.0);
    }
    if (part == 12) {
        return vec3(0.10, 0.26, 0.30);
    }
    if (part == 13) {
        return vec3(0.10, 0.26, -0.30);
    }
    if (part == 14) {
        return vec3(-0.20, 0.54, 0.0);
    }
    return vec3(0.0, 0.22, 0.0);
}

@shader()
function carBoxHalf(part: int) -> vec3 {
    if (part == 5) {
        return vec3(0.26, 0.065, 0.10);
    }
    if (part == 6) {
        return vec3(0.24, 0.11, 0.15);
    }
    if (part == 7) {
        return vec3(0.24, 0.08, 0.17);
    }
    if (part == 8) {
        return vec3(0.06, 0.03, 0.46);
    }
    if (part == 11) {
        return vec3(0.07, 0.022, 0.52);
    }
    if (part == 12 || part == 13) {
        return vec3(0.36, 0.09, 0.08);
    }
    if (part == 14) {
        return vec3(0.07, 0.07, 0.09);
    }
    return vec3(0.70, 0.10, 0.22);
}

@shader()
function hitLocalBox(pos: vec3, angle: float, localCenter: vec3, halfSize: vec3, origin: vec3, dir: vec3) -> float {
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var center: vec3 = pos + vec3(ca * localCenter.x - sa * localCenter.z, localCenter.y, sa * localCenter.x + ca * localCenter.z);
    return hitBoxRotated(center, halfSize, angle, origin, dir);
}

@shader()
function localBoxNormal(pos: vec3, angle: float, localCenter: vec3, halfSize: vec3, p: vec3) -> vec3 {
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var center: vec3 = pos + vec3(ca * localCenter.x - sa * localCenter.z, localCenter.y, sa * localCenter.x + ca * localCenter.z);
    return boxNormalRotated(center, halfSize, angle, p);
}

@shader()
function wheelCenterOf(pos: vec3, angle: float, w: int) -> vec3 {
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var offset: vec3 = wheelOffset(w);
    var wx: float = ca * offset.x - sa * offset.z;
    var wz: float = sa * offset.x + ca * offset.z;
    return vec3(pos.x + wx, pos.y + 0.2, pos.z + wz);
}

@shader()
function carPartAlbedo(index: int, part: int) -> vec3 {
    var paint: vec3 = carColor(index);
    if (part >= 1 && part <= 4) {
        return vec3(0.05, 0.05, 0.055);
    }
    if (part >= 15 && part <= 18) {
        return vec3(0.82, 0.83, 0.86);
    }
    if (part == 6) {
        return vec3(0.02, 0.04, 0.07);
    }
    if (part == 19) {
        return paint * 0.35 + vec3(0.12, 0.12, 0.13);
    }
    if (part == 8 || part == 11) {
        return vec3(0.06, 0.06, 0.065);
    }
    if (part == 7 || part == 14) {
        return paint * 0.55;
    }
    if (part == 32) {
        var hot: float = uGrip;
        if (hot < 0.0) {
            hot = 0.0;
        }
        if (hot > 1.0) {
            hot = 1.0;
        }
        return vec3(0.15 + hot * 0.8, 0.72 - hot * 0.62, 0.12);
    }
    if (part >= 24) {
        return vec3(0.03, 0.03, 0.034);
    }
    if (part == 20) {
        return vec3(0.012, 0.012, 0.014);
    }
    if (part == 21) {
        return vec3(0.16, 0.16, 0.17);
    }
    if (part == 22 || part == 23) {
        return paint * 0.62;
    }
    return paint;
}

@shader()
function carSteer(index: int) -> float {
    return uSteers[index];
}

@shader()
function wheelYaw(index: int, w: int) -> float {
    var yaw: float = carAngle(index);
    if (w < 2) {
        yaw = yaw + carSteer(index) * 0.46;
    }
    return yaw;
}

@shader()
function inCockpit(index: int) -> bool {
    return uCockpitCar > -0.5 && abs(float(index) - uCockpitCar) < 0.5;
}

@shader()
function cockpitCenter(index: int, part: int) -> vec3 {
    if (part == 20) {
        return vec3(0.32, 0.34, 0.0);
    }
    if (part == 21) {
        return vec3(0.20, 0.64, 0.0);
    }
    if (part == 22) {
        return vec3(0.22, 0.54, -0.18);
    }
    if (part == 23) {
        return vec3(0.22, 0.54, 0.18);
    }
    if (part == 32) {
        var g: float = uGrip;
        if (g < 0.0) {
            g = 0.0;
        }
        if (g > 1.0) {
            g = 1.0;
        }
        return vec3(0.34, 0.40, -0.05 + g * 0.05);
    }
    var bead: int = part - 24;
    var a: float = carSteer(index) * 1.15 + float(bead) * 0.785398;
    return vec3(0.22, 0.36 + cos(a) * 0.05, sin(a) * 0.05);
}

@shader()
function cockpitHalf(part: int) -> vec3 {
    if (part == 32) {
        var g: float = uGrip;
        if (g < 0.0) {
            g = 0.0;
        }
        if (g > 1.0) {
            g = 1.0;
        }
        return vec3(0.01, 0.007, 0.012 + g * 0.042);
    }
    if (part >= 24) {
        return vec3(0.012, 0.014, 0.014);
    }
    if (part == 20) {
        return vec3(0.055, 0.028, 0.11);
    }
    if (part == 21) {
        return vec3(0.02, 0.012, 0.07);
    }
    return vec3(0.015, 0.05, 0.012);
}

@shader()
function hitCar(index: int, origin: vec3, dir: vec3, tHit: out float, kind: out int) -> bool {
    var pos: vec3 = carPosition(index);
    var angle: float = carAngle(index);
    tHit = 1000000.0;
    kind = -1;
    var slot: int = 0;
    while (slot < 9) {
        var part: int = carBodyPart(slot);
        if (!(inCockpit(index) && part == 6)) {
            var tBox: float = hitLocalBox(pos, angle, carBoxCenter(part), carBoxHalf(part), origin, dir);
            if (tBox > 0.0 && tBox < tHit) {
                tHit = tBox;
                kind = part;
            }
        }
        slot = slot + 1;
    }
    if (!inCockpit(index)) {
        var ca: float = cos(angle);
        var sa: float = sin(angle);
        var helmetLocal: vec3 = vec3(-0.02, 0.48, 0.0);
        var helmetCenter: vec3 = pos + vec3(ca * helmetLocal.x - sa * helmetLocal.z, helmetLocal.y, sa * helmetLocal.x + ca * helmetLocal.z);
        var tHelmet: float = hitSphere(helmetCenter, 0.10, origin, dir);
        if (tHelmet > 0.0 && tHelmet < tHit) {
            tHit = tHelmet;
            kind = 19;
        }
    }
    var w: int = 0;
    while (w < 4) {
        var wheelCenter: vec3 = wheelCenterOf(pos, angle, w);
        var axle: float = wheelYaw(index, w);
        var tWheel: float = hitWheel(wheelCenter, 0.2, 0.11, axle, origin, dir);
        if (tWheel > 0.0 && tWheel < tHit) {
            tHit = tWheel;
            kind = 1 + w;
        }
        var tHub: float = hitWheel(wheelCenter, 0.085, 0.125, axle, origin, dir);
        if (tHub > 0.0 && tHub < tHit) {
            tHit = tHub;
            kind = 15 + w;
        }
        w = w + 1;
    }
        if (inCockpit(index)) {
            var ip: int = 20;
            while (ip <= 32) {
                if (ip < 21 || ip > 23) {
                    var tIn: float = hitLocalBox(pos, angle, cockpitCenter(index, ip), cockpitHalf(ip), origin, dir);
                    if (tIn > 0.0 && tIn < tHit) {
                        tHit = tIn;
                        kind = ip;
                    }
                }
                ip = ip + 1;
            }
        }
    return kind >= 0;
}

@shader()
function carNormal(index: int, kind: int, p: vec3) -> vec3 {
    var pos: vec3 = carPosition(index);
    var angle: float = carAngle(index);
    if (kind >= 1 && kind <= 4) {
        return wheelNormal(wheelCenterOf(pos, angle, kind - 1), 0.2, 0.11, wheelYaw(index, kind - 1), p);
    }
    if (kind >= 15 && kind <= 18) {
        return wheelNormal(wheelCenterOf(pos, angle, kind - 15), 0.085, 0.125, wheelYaw(index, kind - 15), p);
    }
    if (kind >= 20) {
        return localBoxNormal(pos, angle, cockpitCenter(index, kind), cockpitHalf(kind), p);
    }
    if (kind == 19) {
        var ca: float = cos(angle);
        var sa: float = sin(angle);
        var helmetLocal: vec3 = vec3(-0.02, 0.48, 0.0);
        var helmetCenter: vec3 = pos + vec3(ca * helmetLocal.x - sa * helmetLocal.z, helmetLocal.y, sa * helmetLocal.x + ca * helmetLocal.z);
        return normalize(p - helmetCenter);
    }
    return localBoxNormal(pos, angle, carBoxCenter(kind), carBoxHalf(kind), p);
}

@shader()
function considerHit(t: float, tHit: float) -> bool {
    return t > 0.0 && t < tHit;
}

@shader()
function trackSample(index: int) -> vec4 {
    var u: float = (float(index) + 0.5) / uTrackTexW;
    return texture2D(uTrack, vec2(u, 0.5));
}

@shader()
function trackPoint(index: int) -> vec2 {
    return trackSample(index).xy;
}

@shader()
function considerSegment(p: vec2, index: int, minDist: float, bestAlong: float) -> vec2 {
    var next: int = index + 1;
    if (next >= int(uTrackPts)) {
        next = 0;
    }
    var aTex: vec4 = trackSample(index);
    var bTex: vec4 = trackSample(next);
    var a: vec2 = aTex.xy;
    var b: vec2 = bTex.xy;
    var pa: vec2 = p - a;
    var ba: vec2 = b - a;
    var baLen: float = dot(ba, ba);
    if (baLen < 0.0001) {
        baLen = 0.0001;
    }
    var segLen: float = sqrt(baLen);
    var h: float = clamp(dot(pa, ba) / baLen, 0.0, 1.0);
    var d: float = length(pa - ba * h);
    if (d < minDist) {
        return vec2(d, aTex.z + segLen * h);
    }
    return vec2(minDist, bestAlong);
}

@shader()
function gridSegment(cellX: int, cellZ: int, slot: int) -> float {
    var texelCol: int = int(floor(float(slot) / 4.0));
    var channel: int = slot - texelCol * 4;
    var texelX: int = cellX * 4 + texelCol;
    var u: float = (float(texelX) + 0.5) / uGridTexW;
    var v: float = (float(cellZ) + 0.5) / uGridTexH;
    var texel: vec4 = texture2D(uGrid, vec2(u, v));
    if (channel == 0) {
        return texel.x;
    }
    if (channel == 1) {
        return texel.y;
    }
    if (channel == 2) {
        return texel.z;
    }
    return texel.w;
}

@shader()
function distanceToTrack(p: vec2, trackW: float, along: out float) -> float {
    var minDist: float = 1000000.0;
    var bestAlong: float = 0.0;
    var best: vec2 = vec2(minDist, bestAlong);
    if (uGridOn < 0.5) {
        var i: int = 0;
        while (i < int(uTrackPts)) {
            best = considerSegment(p, i, minDist, bestAlong);
            minDist = best.x;
            bestAlong = best.y;
            i = i + 1;
        }
    } else {
        var cellX: int = int(floor((p.x - uGridMin.x) / uGridCell));
        var cellZ: int = int(floor((p.y - uGridMin.y) / uGridCell));
        var rad: int = int(uGridRadius);
        var dz: int = -rad;
        while (dz <= rad) {
            var dx: int = -rad;
            while (dx <= rad) {
                var cx: int = cellX + dx;
                var cz: int = cellZ + dz;
                if (cx >= 0 && cz >= 0 && cx < int(uGridW) && cz < int(uGridH)) {
                    var slot: int = 0;
                    while (slot < 16) {
                        var seg: float = gridSegment(cx, cz, slot);
                        if (seg < 0.0) {
                            slot = 16;
                        } else {
                            best = considerSegment(p, int(seg + 0.5), minDist, bestAlong);
                            minDist = best.x;
                            bestAlong = best.y;
                            slot = slot + 1;
                        }
                    }
                }
                dx = dx + 1;
            }
            dz = dz + 1;
        }
    }
    along = bestAlong;
    return minDist - trackW;
}

// Hilly circuits store the ground on a square grid. Each texel holds the
// heights of its own corner and of the three corners next to it, so one fetch
// is enough for bilinear filtering (the texture itself is nearest-filtered).
@shader()
function terrainHeight(p: vec2) -> float {
    var gx: float = clamp((p.x - uHeightMin.x) / uHeightCell, 0.0, uHeightN - 1.001);
    var gz: float = clamp((p.y - uHeightMin.y) / uHeightCell, 0.0, uHeightN - 1.001);
    var cx: float = floor(gx);
    var cz: float = floor(gz);
    var fx: float = gx - cx;
    var fz: float = gz - cz;
    var h: vec4 = texture2D(uHeight, vec2((cx + 0.5) / uHeightN, (cz + 0.5) / uHeightN));
    return mix(mix(h.x, h.y, fx), mix(h.z, h.w, fx), fz);
}

// March the ray over the height grid. The step is half the height above the
// ground (safe for slopes up to 1:1) with a floor that grows with distance,
// then six halvings pin down the crossing.
@shader()
function hitTerrain(origin: vec3, dir: vec3, tMax: float) -> float {
    var t: float = 0.0;
    if (origin.y > uHeightTop) {
        if (dir.y > -EPSILON) {
            return -1.0;
        }
        t = (uHeightTop - origin.y) / dir.y;
    }
    var tPrev: float = t;
    var i: int = 0;
    while (i < 120) {
        if (t > tMax) {
            return -1.0;
        }
        var p: vec3 = origin + dir * t;
        var gap: float = p.y - terrainHeight(vec2(p.x, p.z)) + 0.02;
        if (gap < 0.0) {
            var lo: float = tPrev;
            var hi: float = t;
            var k: int = 0;
            while (k < 6) {
                var mid: float = (lo + hi) * 0.5;
                var q: vec3 = origin + dir * mid;
                if (q.y - terrainHeight(vec2(q.x, q.z)) + 0.02 < 0.0) {
                    hi = mid;
                } else {
                    lo = mid;
                }
                k = k + 1;
            }
            return hi;
        }
        if (p.y > uHeightTop && dir.y >= 0.0) {
            return -1.0;
        }
        tPrev = t;
        t = t + max(gap * 0.5, 0.03 + t * 0.02);
        i = i + 1;
    }
    return -1.0;
}

@shader()
function terrainNormal(p: vec3) -> vec3 {
    var e: float = uHeightCell * 0.5;
    var hl: float = terrainHeight(vec2(p.x - e, p.z));
    var hr: float = terrainHeight(vec2(p.x + e, p.z));
    var hd: float = terrainHeight(vec2(p.x, p.z - e));
    var hu: float = terrainHeight(vec2(p.x, p.z + e));
    return normalize(vec3(hl - hr, 2.0 * e, hd - hu));
}

@shader()
function carMayHit(index: int, origin: vec3, dir: vec3, tMax: float) -> bool {
    var center: vec3 = carPosition(index) + vec3(0.0, 0.32, 0.0);
    var radius: float = 1.5;
    var oc: vec3 = origin - center;
    if (dot(oc, oc) <= radius * radius) {
        return true;
    }
    var t: float = hitSphere(center, radius, origin, dir);
    if (t < 0.0) {
        return false;
    }
    return t < tMax;
}

@shader()
function closestHit(
    origin: vec3,
    dir: vec3,
    tMax: float,
    tHit: out float,
    kind: out int,
    index: out int,
    material: out int,
    normal: out vec3,
    albedo: out vec3
) -> bool {
    tHit = tMax;
    kind = 0;
    index = -1;
    material = 0;
    normal = vec3(0.0, 1.0, 0.0);
    albedo = vec3(0.0);

    var i: int = 0;
    while (i < 8) {
        if (carMayHit(i, origin, dir, tHit)) {
            var tCar: float = 0.0;
            var carKind: int = -1;
            if (hitCar(i, origin, dir, tCar, carKind)) {
                if (considerHit(tCar, tHit)) {
                    tHit = tCar;
                    kind = 1;
                    index = i * 40 + carKind;
                    if (carKind >= 1 && carKind <= 4) {
                        material = 0;
                    } else {
                        material = 1;
                    }
                }
            }
        }
        i = i + 1;
    }

    if (uHillsOn > 0.5) {
        var tTerrain: float = hitTerrain(origin, dir, tHit);
        if (tTerrain > EPSILON && tTerrain < tHit) {
            tHit = tTerrain;
            kind = 4;
            index = -1;
            material = 0;
        }
    } else if (abs(dir.y) > EPSILON) {
        var tGround: float = (-0.02 - origin.y) / dir.y;
        if (tGround > EPSILON && tGround < tHit) {
            tHit = tGround;
            kind = 4;
            index = -1;
            material = 0;
        }
    }

    if (kind == 0) {
        return false;
    }

    var hit: vec3 = origin + dir * tHit;
    if (kind == 1) {
        var carIdx: int = index / 40;
        var carPart: int = index - carIdx * 40;
        normal = carNormal(carIdx, carPart, hit);
        albedo = carPartAlbedo(carIdx, carPart);
    } else {
        normal = vec3(0.0, 1.0, 0.0);
        if (uHillsOn > 0.5) {
            normal = terrainNormal(hit);
        } else if (dot(normal, dir) > 0.0) {
            normal = -normal;
        }
        var along: float = 0.0;
        var distToTrack: float = distanceToTrack(vec2(hit.x, hit.z), uTrackW, along);
        if (distToTrack < 0.0) {
            var cell: float = max(uTrackW * 0.7, 0.4);
            var check: float = mod(floor(hit.x / cell) + floor(hit.z / cell), 2.0);
            if (check < 0.5) {
                albedo = vec3(0.16, 0.16, 0.17);
            } else {
                albedo = vec3(0.22, 0.22, 0.24);
            }
            if (distToTrack > -uTrackW * 0.09) {
                var stripe: float = max(uTrackW * 0.55, 1.0);
                var band: float = mod(floor(along / stripe), 2.0);
                if (band < 0.5) {
                    albedo = vec3(0.95, 0.95, 0.93);
                } else {
                    albedo = vec3(0.86, 0.05, 0.06);
                }
            }
        } else {
            var cell: float = max(uTrackW * 1.6, 0.8);
            var check: float = mod(floor(hit.x / cell) + floor(hit.z / cell), 2.0);
            if (check < 0.5) {
                albedo = vec3(0.18, 0.42, 0.18);
            } else {
                albedo = vec3(0.12, 0.28, 0.12);
            }
            // Steep hillsides turn to bare rock.
            if (uHillsOn > 0.5) {
                var rock: float = clamp((0.9 - normal.y) * 5.0, 0.0, 1.0);
                albedo = mix(albedo, vec3(0.42, 0.39, 0.35), rock);
            }
        }
    }
    normal = normalize(normal);
    return true;
}

@shader()
function occludedByCar(origin: vec3, dir: vec3, tMax: float) -> bool {
    var i: int = 0;
    while (i < 8) {
        if (carMayHit(i, origin, dir, tMax)) {
            var tCar: float = 0.0;
            var carKind: int = -1;
            if (hitCar(i, origin, dir, tCar, carKind)) {
                if (tCar > 0.0 && tCar < tMax) {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

@shader()
function inShadow(hit: vec3, normal: vec3) -> bool {
    var origin: vec3 = hit + normal * 0.02;
    var toLight: vec3 = uLightPos - origin;
    var lightDist: float = length(toLight);
    if (lightDist <= EPSILON) {
        return false;
    }
    var dir: vec3 = toLight / lightDist;
    return occludedByCar(origin, dir, lightDist - 0.05);
}

@shader()
function localShade(hit: vec3, normal: vec3, albedo: vec3, viewDir: vec3, glossy: bool) -> vec3 {
    var toLight: vec3 = uLightPos - hit;
    var lightDir: vec3 = normalize(toLight);
    var diff: float = max(dot(normal, lightDir), 0.0);
    var light: float = 0.18;
    if (!inShadow(hit, normal)) {
        light = 0.18 + diff * 0.82;
        if (glossy) {
            var halfV: vec3 = normalize(lightDir + viewDir);
            var spec: float = pow(max(dot(normal, halfV), 0.0), 48.0);
            return albedo * light + vec3(spec, spec, spec) * 0.42;
        }
    }
    return albedo * light;
}

@shader()
function shadeSky(dir: vec3) -> vec3 {
    var t: float = clamp((dir.y + 1.0) * 0.5, 0.0, 1.0);
    return mix(vec3(0.55, 0.72, 0.92), vec3(0.12, 0.22, 0.38), t);
}

@shader()
function traceScene(origin: vec3, dir: vec3, depth: out float) -> vec3 {
    var tHit: float = 0.0;
    var kind: int = 0;
    var index: int = 0;
    var material: int = 0;
    var normal: vec3 = vec3(0.0);
    var albedo: vec3 = vec3(0.0);
    depth = -1.0;
    if (!closestHit(origin, dir, 1000000.0, tHit, kind, index, material, normal, albedo)) {
        return shadeSky(dir);
    }
    // Distance along the view axis, the z a perspective camera would see.
    depth = tHit * dot(dir, uCamForward);
    var hit: vec3 = origin + dir * tHit;
    var viewDir: vec3 = normalize(origin - hit);
    return localShade(hit, normal, albedo, viewDir, material == 1);
}

@shader()
function fragmentMain() {
    var ndc: vec2 = vUv * 2.0 - 1.0;
    var dir: vec3 = normalize(
        uCamForward
        + uCamRight * (ndc.x * uAspect * uTanHalf)
        + uCamUp * (ndc.y * uTanHalf)
    );
    var depth: float = -1.0;
    var color: vec3 = traceScene(uCamPos, dir, depth);
    gl_FragColor = vec4(sqrt(color), 1.0);
    // Same depth the roadside pass's perspective camera (uNear, uFar) writes,
    // so the rasterized signs, trees, and buildings test against ray hits.
    if (depth <= 0.0) {
        gl_FragDepth = 1.0;
    } else {
        var ndcZ: float = (uFar + uNear) / (uFar - uNear) - (2.0 * uFar * uNear) / ((uFar - uNear) * depth);
        gl_FragDepth = clamp(ndcZ * 0.5 + 0.5, 0.0, 1.0);
    }
}

var vertexShader = glsl.compile({
    varyings: ["vec2 vUv"],
    functions: ["vertexMain"],
    main: "vertexMain"
});

var fragmentShader = glsl.compile({
    varyings: ["vec2 vUv"],
    uniforms: [
        "vec2 uResolution",
        "vec3 uCamPos",
        "vec3 uCamForward",
        "vec3 uCamRight",
        "vec3 uCamUp",
        "vec3 uLightPos",
        "float uTanHalf",
        "float uAspect",
        "float uTrackW",
        "float uTrackPts",
        "float uTrackTexW",
        "sampler2D uTrack",
        "sampler2D uGrid",
        "vec2 uGridMin",
        "float uGridCell",
        "float uGridW",
        "float uGridH",
        "float uGridRadius",
        "float uGridTexW",
        "float uGridTexH",
        "float uGridOn",
        "sampler2D uHeight",
        "vec2 uHeightMin",
        "float uHeightCell",
        "float uHeightN",
        "float uHeightTop",
        "float uHillsOn",
        "float uNear",
        "float uFar",
        "vec3 uCars[CAR_COUNT]",
        "float uAngles[CAR_COUNT]",
        "float uSteers[CAR_COUNT]",
        "float uCockpitCar",
        "float uGrip"
    ],
    consts: [
        "int CAR_COUNT = 8",
        "float EPSILON = 0.0015"
    ],
    functions: [
        "hitSphere",
        "hitBox",
        "boxNormal",
        "hitBoxRotated",
        "boxNormalRotated",
        "hitCylinder",
        "cylinderNormal",
        "hitWheel",
        "wheelNormal",
        "carPosition",
        "carAngle",
        "carSteer",
        "wheelYaw",
        "inCockpit",
        "cockpitCenter",
        "cockpitHalf",
        "carColor",
        "wheelOffset",
        "carBodyPart",
        "carBoxCenter",
        "carBoxHalf",
        "hitLocalBox",
        "localBoxNormal",
        "wheelCenterOf",
        "carPartAlbedo",
        "hitCar",
        "carNormal",
        "considerHit",
        "trackSample",
        "trackPoint",
        "considerSegment",
        "gridSegment",
        "distanceToTrack",
        "terrainHeight",
        "hitTerrain",
        "terrainNormal",
        "carMayHit",
        "closestHit",
        "occludedByCar",
        "inShadow",
        "localShade",
        "shadeSky",
        "traceScene",
        "fragmentMain"
    ],
    main: "fragmentMain"
});

