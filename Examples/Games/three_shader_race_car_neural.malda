// Grand Prix 3D Neural Race with GPU Ray Tracing
// Run: malda play Examples/Games/three_shader_race_car_neural.malda
//
// Eight cars share a 15-20-2 net (tanh, tanh). The first eleven inputs match
// grand_prix_neural.malda. Three more report sideways speed, yaw rate, and
// how close the tires are to the grip limit, then the bias. The centerline is smoothed and resampled the same
// way, then scaled so the road half-width is 3.2. Speeds and turn rate scale
// with that road, so the coach's steering still points back to the racing line.
// The ground shader reads the same polyline from a float texture.
// Edge lines are red and white kerb blocks measured along that polyline.
// A segment grid and a bounding sphere skip tests that cannot change the hit.
// Signs, trees, and buildings are not ray traced. They are instanced meshes,
// as in three_forest.malda: one draw call per part for every tree trunk, every
// canopy, every building, and so on. The ray tracer writes the depth of its
// first hit (gl_FragDepth, with the projection of a perspective camera that
// matches the ray camera), then a second pass draws the roadside meshes over
// it with depth testing, so cars and roadside things hide each other properly.
// Signs turn to face the camera every frame; their text is a small texture per
// phrase, drawn from the same 5x7 font.
// Hilly circuits (Spa, Monaco, Interlagos, Austin, and the Mount Panorama
// mountain climb) list a height per key point. The ground is a height grid in
// a float texture: the road follows those heights, hills and a ring of
// mountains rise away from it, and the shader marches each ray over the grid.
// Cars ride the ground, gravity slows them uphill and pushes them downhill,
// and the cameras follow the slopes. Flat circuits keep the flat ground plane.
// 1, 2, and 3 toggle signs, trees, and buildings (setInstanceCount 0 hides a kind).
//
// Q/E change circuit. C cycles the camera (chase, bumper, side, nose, orbit,
// aerial, cockpit). Each shot keeps moving. N network only. T coach only.
// L blend mode. R reset brain. Space pause. Tab drives the selected car from
// the cockpit (WASD or arrows: steer, throttle, brake). Z and X change car.
// Showcase autoplay (#malda-autoplay) advances the shot on its own.
// A side panel matches the 2D grand prix HUD: speed, laps, neural share, and order.
// Tires have a grip limit. Steering past that limit, or a shove from another
// car, leaves sideways speed that the tires scrub off. Grass grips less.
// The coach holds a corner pace and only lifts when the tires are at the limit.
// The net is trained on that gas, so a slow car is pulled back up to the pace.
// Speed then falls by drag and by a closed throttle, for every car.
// Car contact uses the billiards equal-mass impulse (restitution 0.5) against
// the car's oriented box, and the hit keeps its sideways component.
// The race runs on three.startFixed at 60 Hz, so physics and training do not
// depend on the display rate. Render pushes the uniforms and the side panel once
// per frame. Keys use three.wasKeyPressed edges.
// Auto render scale keeps 60 fps by trading resolution (0.5 to 1). F shows the
// fps / scale overlay (or open the page with #malda-stats).
// Each car has its own engine voice placed on the car, and the audio listener
// rides the camera, so engines pan and fade as cars pass. M mutes.

function wrapAngle(a: float) -> float {
    var turns = math.floor((a + 3.14159265) / 6.2831853);
    return a - turns * 6.2831853;
}

function wrapIndex(i: int, n: int) -> int {
    if (n < 1) {
        return 0;
    }
    var k = i % n;
    if (k < 0) {
        k = k + n;
    }
    return k;
}

function formatTime(seconds: float) -> string {
    if (seconds < 0.0) {
        return "--:--.---";
    }
    var mins = int(seconds / 60.0);
    var rem = seconds - mins * 60.0;
    var whole = int(rem);
    var ms = int((rem - whole) * 1000.0);
    if (ms < 0) {
        ms = 0;
    }
    if (ms > 999) {
        ms = 999;
    }
    return string(mins) + ":" + str.padStart(string(whole), 2, "0") + "." + str.padStart(string(ms), 3, "0");
}

