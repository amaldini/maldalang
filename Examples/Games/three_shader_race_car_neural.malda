// Grand Prix 3D Neural Race with GPU Ray Tracing
// Run: malda play Examples/Games/three_shader_race_car_neural.malda
//
// Eight cars share a 12-20-2 neural network (tanh activations). Scene rendered
// using realtime GPU ray tracing with 3D geometry, lighting, and shadows.
// Pure-pursuit coach teaches the network via supervised learning.
//
// Q/E change circuit. C chase camera. N network only. T coach only. 
// L blend mode. R reset brain. Space pause. Tab manual drive (WASD/arrows).

function wrapAngle(a: float) -> float {
    var turns = math.floor((a + 3.14159265) / 6.2831853);
    return a - turns * 6.2831853;
}

function wrapIndex(i: int, n: int) -> int {
    if (n < 1) {
        return 0;
    }
    var k = i % n;
    if (k < 0) {
        k = k + n;
    }
    return k;
}

function circuitCatalog() -> array {
    var circuits = [];
    circuits.append({
        "name": "Monza",
        "scale": 0.12,
        "pts": [
            0.0, 80.0, 50.0, 78.0, 95.0, 70.0, 125.0, 50.0, 
            135.0, 20.0, 128.0, -15.0, 105.0, -35.0, 75.0, -40.0,
            40.0, -35.0, 10.0, -20.0, -15.0, 0.0, -20.0, 30.0,
            -10.0, 55.0, 10.0, 70.0, -20.0, 75.0
        ]
    });
    circuits.append({
        "name": "Spa",
        "scale": 0.11,
        "pts": [
            0.0, 70.0, 40.0, 65.0, 75.0, 50.0, 105.0, 25.0,
            125.0, -5.0, 130.0, -35.0, 115.0, -55.0, 85.0, -65.0,
            50.0, -60.0, 15.0, -45.0, -15.0, -20.0, -25.0, 10.0,
            -20.0, 40.0, 0.0, 60.0
        ]
    });
    circuits.append({
        "name": "Monaco",
        "scale": 0.15,
        "pts": [
            0.0, 55.0, 30.0, 52.0, 55.0, 42.0, 72.0, 25.0,
            78.0, 0.0, 70.0, -22.0, 50.0, -35.0, 22.0, -38.0,
            -5.0, -32.0, -25.0, -18.0, -35.0, 5.0, -30.0, 28.0,
            -15.0, 45.0, 5.0, 52.0
        ]
    });
    return circuits;
}

function randomMatrix(rows: int, cols: int, scale: float) -> array {
    var matrix = [];
    var i = 0;
    while (i < rows) {
        var row = [];
        var j = 0;
        while (j < cols) {
            row.append(math.randomFloat(-scale, scale));
            j = j + 1;
        }
        matrix.append(row);
        i = i + 1;
    }
    return matrix;
}

function randomVector(n: int, scale: float) -> array {
    var values = [];
    var i = 0;
    while (i < n) {
        values.append(math.randomFloat(-scale, scale));
        i = i + 1;
    }
    return values;
}

function zeroMatrix(rows: int, cols: int) -> array {
    var matrix = [];
    var i = 0;
    while (i < rows) {
        var row = [];
        var j = 0;
        while (j < cols) {
            row.append(0.0);
            j = j + 1;
        }
        matrix.append(row);
        i = i + 1;
    }
    return matrix;
}

function zeroVector(n: int) -> array {
    var values = [];
    var i = 0;
    while (i < n) {
        values.append(0.0);
        i = i + 1;
    }
    return values;
}

function addMatrix(dst: array, src: array) {
    var i = 0;
    while (i < dst.length) {
        var j = 0;
        while (j < dst[i].length) {
            dst[i][j] = dst[i][j] + src[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
}

function addVector(dst: array, src: array) {
    var i = 0;
    while (i < dst.length) {
        dst[i] = dst[i] + src[i];
        i = i + 1;
    }
}

function applyMatrix(weights: array, grad: array, lr: float) {
    var i = 0;
    while (i < weights.length) {
        var j = 0;
        while (j < weights[i].length) {
            var g = grad[i][j];
            if (g > 4.0) {
                g = 4.0;
            }
            if (g < -4.0) {
                g = -4.0;
            }
            weights[i][j] = weights[i][j] - lr * g;
            j = j + 1;
        }
        i = i + 1;
    }
}

function applyVector(bias: array, grad: array, lr: float) {
    var i = 0;
    while (i < bias.length) {
        var g = grad[i];
        if (g > 4.0) {
            g = 4.0;
        }
        if (g < -4.0) {
            g = -4.0;
        }
        bias[i] = bias[i] - lr * g;
        i = i + 1;
    }
}

@shader()
function vertexMain() {
    vUv = uv;
    gl_Position = vec4(position.xy, 0.0, 1.0);
}

@shader()
function hitSphere(center: vec3, radius: float, origin: vec3, dir: vec3) -> float {
    var oc: vec3 = origin - center;
    var a: float = dot(dir, dir);
    var b: float = dot(oc, dir);
    var c: float = dot(oc, oc) - radius * radius;
    var disc: float = b * b - a * c;
    if (disc < 0.0) {
        return -1.0;
    }
    var root: float = sqrt(disc);
    var t: float = (-b - root) / a;
    if (t > EPSILON) {
        return t;
    }
    t = (-b + root) / a;
    if (t > EPSILON) {
        return t;
    }
    return -1.0;
}

@shader()
function hitBox(bmin: vec3, bmax: vec3, origin: vec3, dir: vec3) -> float {
    var inv: vec3 = vec3(1.0, 1.0, 1.0) / dir;
    var t0: vec3 = (bmin - origin) * inv;
    var t1: vec3 = (bmax - origin) * inv;
    var tmin: vec3 = min(t0, t1);
    var tmax: vec3 = max(t0, t1);
    var tEnter: float = max(max(tmin.x, tmin.y), tmin.z);
    var tExit: float = min(min(tmax.x, tmax.y), tmax.z);
    if (tExit < tEnter) {
        return -1.0;
    }
    if (tEnter > EPSILON) {
        return tEnter;
    }
    if (tExit > EPSILON) {
        return tExit;
    }
    return -1.0;
}

@shader()
function boxNormal(bmin: vec3, bmax: vec3, p: vec3) -> vec3 {
    var c: vec3 = (bmin + bmax) * 0.5;
    var d: vec3 = (p - c) / max(bmax - bmin, vec3(EPSILON, EPSILON, EPSILON));
    var ad: vec3 = abs(d);
    if (ad.x > ad.y && ad.x > ad.z) {
        return vec3(sign(d.x), 0.0, 0.0);
    }
    if (ad.y > ad.z) {
        return vec3(0.0, sign(d.y), 0.0);
    }
    return vec3(0.0, 0.0, sign(d.z));
}

@shader()
function hitBoxRotated(center: vec3, halfSize: vec3, angle: float, origin: vec3, dir: vec3) -> float {
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var o: vec3 = origin - center;
    var oLocal: vec3 = vec3(ca * o.x + sa * o.z, o.y, -sa * o.x + ca * o.z);
    var dLocal: vec3 = vec3(ca * dir.x + sa * dir.z, dir.y, -sa * dir.x + ca * dir.z);
    return hitBox(-halfSize, halfSize, oLocal, dLocal);
}

@shader()
function boxNormalRotated(center: vec3, halfSize: vec3, angle: float, p: vec3) -> vec3 {
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var o: vec3 = p - center;
    var pLocal: vec3 = vec3(ca * o.x + sa * o.z, o.y, -sa * o.x + ca * o.z);
    var nLocal: vec3 = boxNormal(-halfSize, halfSize, pLocal);
    return vec3(ca * nLocal.x - sa * nLocal.z, nLocal.y, sa * nLocal.x + ca * nLocal.z);
}

@shader()
function hitCylinder(center: vec3, radius: float, y0: float, y1: float, origin: vec3, dir: vec3) -> float {
    var ocx: float = origin.x - center.x;
    var ocz: float = origin.z - center.z;
    var a: float = dir.x * dir.x + dir.z * dir.z;
    var b: float = ocx * dir.x + ocz * dir.z;
    var c: float = ocx * ocx + ocz * ocz - radius * radius;
    var tBest: float = -1.0;
    if (abs(a) > EPSILON) {
        var disc: float = b * b - a * c;
        if (disc >= 0.0) {
            var root: float = sqrt(disc);
            var t: float = (-b - root) / a;
            var y: float = origin.y + dir.y * t;
            if (t > EPSILON && y >= y0 && y <= y1) {
                tBest = t;
            }
            t = (-b + root) / a;
            y = origin.y + dir.y * t;
            if (t > EPSILON && y >= y0 && y <= y1 && (tBest < 0.0 || t < tBest)) {
                tBest = t;
            }
        }
    }
    if (abs(dir.y) > EPSILON) {
        var tCap: float = (y0 - origin.y) / dir.y;
        var qx: float = origin.x + dir.x * tCap - center.x;
        var qz: float = origin.z + dir.z * tCap - center.z;
        if (tCap > EPSILON && qx * qx + qz * qz <= radius * radius && (tBest < 0.0 || tCap < tBest)) {
            tBest = tCap;
        }
        tCap = (y1 - origin.y) / dir.y;
        qx = origin.x + dir.x * tCap - center.x;
        qz = origin.z + dir.z * tCap - center.z;
        if (tCap > EPSILON && qx * qx + qz * qz <= radius * radius && (tBest < 0.0 || tCap < tBest)) {
            tBest = tCap;
        }
    }
    return tBest;
}

@shader()
function cylinderNormal(center: vec3, radius: float, y0: float, y1: float, p: vec3) -> vec3 {
    var radial: vec3 = vec3(p.x - center.x, 0.0, p.z - center.z);
    var dr: float = abs(length(radial) - radius);
    var dy0: float = abs(p.y - y0);
    var dy1: float = abs(p.y - y1);
    if (dy0 < dr && dy0 <= dy1) {
        return vec3(0.0, -1.0, 0.0);
    }
    if (dy1 < dr) {
        return vec3(0.0, 1.0, 0.0);
    }
    return normalize(radial);
}

@shader()
function carPosition(index: int) -> vec3 {
    if (index == 0) {
        return uCar0;
    }
    if (index == 1) {
        return uCar1;
    }
    if (index == 2) {
        return uCar2;
    }
    if (index == 3) {
        return uCar3;
    }
    if (index == 4) {
        return uCar4;
    }
    if (index == 5) {
        return uCar5;
    }
    if (index == 6) {
        return uCar6;
    }
    return uCar7;
}

@shader()
function carAngle(index: int) -> float {
    if (index == 0) {
        return uAngle0;
    }
    if (index == 1) {
        return uAngle1;
    }
    if (index == 2) {
        return uAngle2;
    }
    if (index == 3) {
        return uAngle3;
    }
    if (index == 4) {
        return uAngle4;
    }
    if (index == 5) {
        return uAngle5;
    }
    if (index == 6) {
        return uAngle6;
    }
    return uAngle7;
}

@shader()
function carColor(index: int) -> vec3 {
    if (index == 0) {
        return vec3(0.92, 0.15, 0.18);
    }
    if (index == 1) {
        return vec3(0.12, 0.52, 0.95);
    }
    if (index == 2) {
        return vec3(0.15, 0.82, 0.28);
    }
    if (index == 3) {
        return vec3(0.95, 0.72, 0.12);
    }
    if (index == 4) {
        return vec3(0.85, 0.42, 0.15);
    }
    if (index == 5) {
        return vec3(0.58, 0.18, 0.72);
    }
    if (index == 6) {
        return vec3(0.18, 0.68, 0.72);
    }
    return vec3(0.72, 0.72, 0.72);
}

@shader()
function wheelOffset(w: int) -> vec3 {
    if (w == 0) {
        return vec3(0.35, 0.0, 0.22);
    }
    if (w == 1) {
        return vec3(0.35, 0.0, -0.22);
    }
    if (w == 2) {
        return vec3(-0.35, 0.0, 0.22);
    }
    return vec3(-0.35, 0.0, -0.22);
}

@shader()
function hitCar(index: int, origin: vec3, dir: vec3, tHit: out float, kind: out int) -> bool {
    var pos: vec3 = carPosition(index);
    var angle: float = carAngle(index);
    var bodyHalf: vec3 = vec3(0.48, 0.18, 0.22);
    var bodyCenter: vec3 = vec3(pos.x, pos.y + 0.18, pos.z);
    var tBody: float = hitBoxRotated(bodyCenter, bodyHalf, angle, origin, dir);
    var wheelR: float = 0.12;
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    tHit = 1000000.0;
    kind = -1;
    if (tBody > 0.0 && tBody < tHit) {
        tHit = tBody;
        kind = 0;
    }
    var w: int = 0;
    while (w < 4) {
        var offset: vec3 = wheelOffset(w);
        var wx: float = ca * offset.x - sa * offset.z;
        var wz: float = sa * offset.x + ca * offset.z;
        var wheelCenter: vec3 = vec3(pos.x + wx, pos.y + wheelR, pos.z + wz);
        var tWheel: float = hitCylinder(wheelCenter, wheelR, pos.y, pos.y + wheelR * 2.0, origin, dir);
        if (tWheel > 0.0 && tWheel < tHit) {
            tHit = tWheel;
            kind = 1 + w;
        }
        w = w + 1;
    }
    return kind >= 0;
}

@shader()
function carNormal(index: int, kind: int, p: vec3) -> vec3 {
    var pos: vec3 = carPosition(index);
    var angle: float = carAngle(index);
    if (kind == 0) {
        var bodyHalf: vec3 = vec3(0.48, 0.18, 0.22);
        var bodyCenter: vec3 = vec3(pos.x, pos.y + 0.18, pos.z);
        return boxNormalRotated(bodyCenter, bodyHalf, angle, p);
    }
    var wheelR: float = 0.12;
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var w: int = kind - 1;
    var offset: vec3 = wheelOffset(w);
    var wx: float = ca * offset.x - sa * offset.z;
    var wz: float = sa * offset.x + ca * offset.z;
    var wheelCenter: vec3 = vec3(pos.x + wx, pos.y + wheelR, pos.z + wz);
    return cylinderNormal(wheelCenter, wheelR, pos.y, pos.y + wheelR * 2.0, p);
}

@shader()
function considerHit(t: float, tHit: float) -> bool {
    return t > 0.0 && t < tHit;
}

@shader()
function closestHit(
    origin: vec3,
    dir: vec3,
    tMax: float,
    tHit: out float,
    kind: out int,
    index: out int,
    material: out int,
    normal: out vec3,
    albedo: out vec3
) -> bool {
    tHit = tMax;
    kind = 0;
    index = -1;
    material = 0;
    normal = vec3(0.0, 1.0, 0.0);
    albedo = vec3(0.0);

    var i: int = 0;
    while (i < 8) {
        var tCar: float = 0.0;
        var carKind: int = -1;
        if (hitCar(i, origin, dir, tCar, carKind)) {
            if (considerHit(tCar, tHit)) {
                tHit = tCar;
                kind = 1;
                index = i * 10 + carKind;
                material = 1;
            }
        }
        i = i + 1;
    }

    var trackW: float = uTrackW;
    var trackL: float = uTrackL;
    var wallH: float = 1.2;
    var tTrack: float = hitBox(vec3(-trackW, 0.0, -trackL), vec3(trackW, 0.02, trackL), origin, dir);
    if (considerHit(tTrack, tHit)) {
        tHit = tTrack;
        kind = 2;
        index = 0;
        material = 0;
    }
    var wallT: float = 0.25;
    var tWall1: float = hitBox(vec3(-trackW - wallT, 0.0, -trackL), vec3(-trackW, wallH, trackL), origin, dir);
    if (considerHit(tWall1, tHit)) {
        tHit = tWall1;
        kind = 3;
        index = 0;
        material = 0;
    }
    var tWall2: float = hitBox(vec3(trackW, 0.0, -trackL), vec3(trackW + wallT, wallH, trackL), origin, dir);
    if (considerHit(tWall2, tHit)) {
        tHit = tWall2;
        kind = 3;
        index = 1;
        material = 0;
    }
    var tWall3: float = hitBox(vec3(-trackW, 0.0, -trackL - wallT), vec3(trackW, wallH, -trackL), origin, dir);
    if (considerHit(tWall3, tHit)) {
        tHit = tWall3;
        kind = 3;
        index = 2;
        material = 0;
    }
    var tWall4: float = hitBox(vec3(-trackW, 0.0, trackL), vec3(trackW, wallH, trackL + wallT), origin, dir);
    if (considerHit(tWall4, tHit)) {
        tHit = tWall4;
        kind = 3;
        index = 3;
        material = 0;
    }

    if (abs(dir.y) > EPSILON) {
        var tGround: float = (-0.02 - origin.y) / dir.y;
        if (tGround > EPSILON && tGround < tHit) {
            tHit = tGround;
            kind = 4;
            index = -1;
            material = 0;
        }
    }

    if (kind == 0) {
        return false;
    }

    var hit: vec3 = origin + dir * tHit;
    if (kind == 1) {
        var carIdx: int = index / 10;
        var carPart: int = index - carIdx * 10;
        normal = carNormal(carIdx, carPart, hit);
        if (carPart == 0) {
            albedo = carColor(carIdx);
        } else {
            albedo = vec3(0.08, 0.08, 0.09);
        }
    } else if (kind == 2) {
        normal = boxNormal(vec3(-trackW, 0.0, -trackL), vec3(trackW, 0.02, trackL), hit);
        var check: float = mod(floor(hit.x * 0.5) + floor(hit.z * 0.5), 2.0);
        if (check < 0.5) {
            albedo = vec3(0.15, 0.15, 0.16);
        } else {
            albedo = vec3(0.92, 0.92, 0.88);
        }
        if (abs(hit.x) < 0.08) {
            var stripe: float = mod(floor(hit.z * 2.0), 4.0);
            if (stripe < 2.0) {
                albedo = vec3(0.95, 0.85, 0.12);
            }
        }
    } else if (kind == 3) {
        if (index == 0) {
            normal = boxNormal(vec3(-trackW - wallT, 0.0, -trackL), vec3(-trackW, wallH, trackL), hit);
        } else if (index == 1) {
            normal = boxNormal(vec3(trackW, 0.0, -trackL), vec3(trackW + wallT, wallH, trackL), hit);
        } else if (index == 2) {
            normal = boxNormal(vec3(-trackW, 0.0, -trackL - wallT), vec3(trackW, wallH, -trackL), hit);
        } else {
            normal = boxNormal(vec3(-trackW, 0.0, trackL), vec3(trackW, wallH, trackL + wallT), hit);
        }
        albedo = vec3(0.72, 0.18, 0.22);
    } else {
        normal = vec3(0.0, 1.0, 0.0);
        if (dot(normal, dir) > 0.0) {
            normal = -normal;
        }
        var check: float = mod(floor(hit.x * 0.25) + floor(hit.z * 0.25), 2.0);
        if (check < 0.5) {
            albedo = vec3(0.18, 0.42, 0.18);
        } else {
            albedo = vec3(0.12, 0.28, 0.12);
        }
    }
    normal = normalize(normal);
    return true;
}

@shader()
function inShadow(hit: vec3, normal: vec3) -> bool {
    var origin: vec3 = hit + normal * 0.02;
    var toLight: vec3 = uLightPos - origin;
    var lightDist: float = length(toLight);
    if (lightDist <= EPSILON) {
        return false;
    }
    var dir: vec3 = toLight / lightDist;
    var tHit: float = 0.0;
    var kind: int = 0;
    var index: int = 0;
    var material: int = 0;
    var n: vec3 = vec3(0.0);
    var albedo: vec3 = vec3(0.0);
    return closestHit(origin, dir, lightDist - 0.05, tHit, kind, index, material, n, albedo);
}

@shader()
function localShade(hit: vec3, normal: vec3, albedo: vec3, viewDir: vec3, glossy: bool) -> vec3 {
    var toLight: vec3 = uLightPos - hit;
    var lightDir: vec3 = normalize(toLight);
    var diff: float = max(dot(normal, lightDir), 0.0);
    var light: float = 0.18;
    if (!inShadow(hit, normal)) {
        light = 0.18 + diff * 0.82;
        if (glossy) {
            var halfV: vec3 = normalize(lightDir + viewDir);
            var spec: float = pow(max(dot(normal, halfV), 0.0), 48.0);
            return albedo * light + vec3(spec, spec, spec) * 0.42;
        }
    }
    return albedo * light;
}

@shader()
function shadeSky(dir: vec3) -> vec3 {
    var t: float = clamp((dir.y + 1.0) * 0.5, 0.0, 1.0);
    return mix(vec3(0.55, 0.72, 0.92), vec3(0.12, 0.22, 0.38), t);
}

@shader()
function traceScene(origin: vec3, dir: vec3) -> vec3 {
    var tHit: float = 0.0;
    var kind: int = 0;
    var index: int = 0;
    var material: int = 0;
    var normal: vec3 = vec3(0.0);
    var albedo: vec3 = vec3(0.0);
    if (!closestHit(origin, dir, 1000000.0, tHit, kind, index, material, normal, albedo)) {
        return shadeSky(dir);
    }
    var hit: vec3 = origin + dir * tHit;
    var viewDir: vec3 = normalize(origin - hit);
    return localShade(hit, normal, albedo, viewDir, material == 1);
}

@shader()
function fragmentMain() {
    var ndc: vec2 = vUv * 2.0 - 1.0;
    var dir: vec3 = normalize(
        uCamForward
        + uCamRight * (ndc.x * uAspect * uTanHalf)
        + uCamUp * (ndc.y * uTanHalf)
    );
    var color: vec3 = traceScene(uCamPos, dir);
    gl_FragColor = vec4(sqrt(color), 1.0);
}

var vertexShader = glsl.compile({
    varyings: ["vec2 vUv"],
    functions: ["vertexMain"],
    main: "vertexMain"
});

var fragmentShader = glsl.compile({
    varyings: ["vec2 vUv"],
    uniforms: [
        "vec2 uResolution",
        "vec3 uCamPos",
        "vec3 uCamForward",
        "vec3 uCamRight",
        "vec3 uCamUp",
        "vec3 uLightPos",
        "float uTanHalf",
        "float uAspect",
        "float uTrackW",
        "float uTrackL",
        "vec3 uCar0",
        "vec3 uCar1",
        "vec3 uCar2",
        "vec3 uCar3",
        "vec3 uCar4",
        "vec3 uCar5",
        "vec3 uCar6",
        "vec3 uCar7",
        "float uAngle0",
        "float uAngle1",
        "float uAngle2",
        "float uAngle3",
        "float uAngle4",
        "float uAngle5",
        "float uAngle6",
        "float uAngle7"
    ],
    consts: ["float EPSILON = 0.0015"],
    functions: [
        "hitSphere",
        "hitBox",
        "boxNormal",
        "hitBoxRotated",
        "boxNormalRotated",
        "hitCylinder",
        "cylinderNormal",
        "carPosition",
        "carAngle",
        "carColor",
        "wheelOffset",
        "hitCar",
        "carNormal",
        "considerHit",
        "closestHit",
        "inShadow",
        "localShade",
        "shadeSky",
        "traceScene",
        "fragmentMain"
    ],
    main: "fragmentMain"
});

var root = dom.query("#app");

if (root == null) {
    println("No #app container found.");
} else {
    dom.clear(root);

    var heading = dom.create("h1");
    dom.setText(heading, "MALDA Grand Prix 3D Neural Ray Tracer");
    dom.append(root, heading);

    var hint = dom.create("p");
    dom.setText(hint, "GPU ray-traced 3D racing with neural network learning. Q/E change circuit. C chase camera. N network. T coach. L blend. R reset brain. Space pause. Tab manual drive (WASD/arrows).");
    dom.append(root, hint);

    var statusLine = dom.create("p");
    dom.setText(statusLine, "Loading...");
    dom.append(root, statusLine);

    var lossLine = dom.create("p");
    dom.setText(lossLine, "");
    dom.append(root, lossLine);

    if (dom.query("#malda-autoplay") != null) {
        var showcaseFit = dom.create("style");
        dom.setText(showcaseFit, "#status{display:none!important}html,body{overflow:hidden;margin:0;background:#0a1628}#app{min-height:0!important;background:#0a1628}#app>p,#app>div{display:none!important}#app h1{margin:8px 12px 0;font-size:14px;font-weight:600;line-height:1.2}#app canvas{position:fixed!important;left:8px!important;top:32px!important;width:calc(100vw - 16px)!important;height:calc(100vh - 44px)!important;object-fit:contain;object-position:center center;background:#0a1628}");
        dom.append(root, showcaseFit);
    }

    var width = 960;
    var height = 540;
    var aspect = width / height;
    var tanHalf = math.tan(math.degToRad(32));

    var circuits = circuitCatalog();
    var circuitIndex = 0;
    var trackPx = [];
    var trackPz = [];
    var trackTx = [];
    var trackTz = [];
    var trackNx = [];
    var trackNz = [];
    var trackTang = [];
    var trackCum = [];
    var trackBend = [];
    var totalLen = 1.0;
    var nPts = 0;
    var trackScale = 0.12;
    var trackW = 4.0;
    var trackL = 25.0;

    function buildTrack(spec: map) {
        var pts = spec.pts;
        trackPx = [];
        trackPz = [];
        trackScale = spec.scale;
        var i = 0;
        while (i < pts.length) {
            trackPx.append(pts[i] * trackScale);
            trackPz.append(pts[i + 1] * trackScale);
            i = i + 2;
        }
        nPts = trackPx.length;
        trackTx = [];
        trackTz = [];
        trackNx = [];
        trackNz = [];
        trackTang = [];
        trackCum = [];
        trackBend = [];
        var acc = 0.0;
        var n = 0;
        while (n < nPts) {
            var nxt = wrapIndex(n + 1, nPts);
            var sdx = trackPx[nxt] - trackPx[n];
            var sdz = trackPz[nxt] - trackPz[n];
            var sl = math.sqrt(sdx * sdx + sdz * sdz);
            if (sl < 0.001) {
                sl = 0.001;
            }
            var ux = sdx / sl;
            var uz = sdz / sl;
            trackTx.append(ux);
            trackTz.append(uz);
            trackNx.append(-uz);
            trackNz.append(ux);
            trackTang.append(math.atan2(uz, ux));
            trackCum.append(acc);
            acc = acc + sl;
            n = n + 1;
        }
        totalLen = acc;
        if (totalLen < 1.0) {
            totalLen = 1.0;
        }
        var b = 0;
        while (b < nPts) {
            var ahead = wrapIndex(b + 8, nPts);
            trackBend.append(wrapAngle(trackTang[ahead] - trackTang[b]));
            b = b + 1;
        }
        trackW = 4.0;
        trackL = totalLen * 0.6;
    }

    function loadCircuit(index: int) {
        if (index < 0) {
            index = circuits.length - 1;
        }
        if (index >= circuits.length) {
            index = 0;
        }
        circuitIndex = index;
        var spec = circuits[circuitIndex];
        buildTrack(spec);
        resetCars();
    }

    function poseAt(dist: float, side: float) -> array {
        var s = dist;
        while (s < 0.0) {
            s = s + totalLen;
        }
        while (s >= totalLen) {
            s = s - totalLen;
        }
        var idx = 0;
        var i = 0;
        while (i < nPts) {
            if (trackCum[i] <= s) {
                idx = i;
            }
            i = i + 1;
        }
        var j = wrapIndex(idx + 1, nPts);
        var seg = 0.0;
        if (j == 0) {
            seg = totalLen - trackCum[idx];
        } else {
            seg = trackCum[j] - trackCum[idx];
        }
        var t = 0.0;
        if (seg > 0.001) {
            t = (s - trackCum[idx]) / seg;
        }
        var x = trackPx[idx] + (trackPx[j] - trackPx[idx]) * t + trackNx[idx] * side;
        var z = trackPz[idx] + (trackPz[j] - trackPz[idx]) * t + trackNz[idx] * side;
        return [x, z, trackTang[idx], idx, s];
    }

    var carCount = 8;
    var carX = [];
    var carZ = [];
    var carH = [];
    var carV = [];
    var carIdx = [];
    var carS = [];
    var carStyle = [];
    var manualDrive = false;

    function resetCars() {
        carX = [];
        carZ = [];
        carH = [];
        carV = [];
        carIdx = [];
        carS = [];
        carStyle = [];
        var i = 0;
        while (i < carCount) {
            var side = trackW * 0.26;
            if (i % 2 == 0) {
                side = -side;
            }
            var pose = poseAt(totalLen - 3.0 - i * 3.5, side);
            carX.append(pose[0]);
            carZ.append(pose[1]);
            carH.append(pose[2]);
            carV.append(0.0);
            carIdx.append(int(pose[3]));
            carS.append(pose[4]);
            carStyle.append(math.randomFloat(-0.12, 0.12));
            i = i + 1;
        }
    }

    var w1 = randomMatrix(20, 12, 0.35);
    var b1 = randomVector(20, 0.15);
    var w2 = randomMatrix(2, 20, 0.35);
    var b2 = randomVector(2, 0.15);
    var samples = [];
    var maxSamples = 512;
    var batchSize = 32;
    var shownLoss = 0.5;
    var brainMode = "blend";
    var paused = false;

    function pushSample(obs: array, target: array) {
        samples.append({"obs": obs, "target": target});
        if (samples.length > maxSamples) {
            samples.shift();
        }
    }

    function trainStep() {
        if (samples.length < batchSize) {
            return;
        }
        var g1w = zeroMatrix(20, 12);
        var g1b = zeroVector(20);
        var g2w = zeroMatrix(2, 20);
        var g2b = zeroVector(2);
        var totalLoss = 0.0;
        var b = 0;
        while (b < batchSize) {
            var idx = int(math.random() * samples.length);
            var sample = samples[idx];
            var obs = sample.obs;
            var target = sample.target;
            var hidden = nn.dense(obs, w1, b1, "tanh");
            var out = nn.dense(hidden.out, w2, b2, "tanh");
            var loss = nn.mseGrad(out.out, target);
            totalLoss = totalLoss + loss.loss;
            var back2 = nn.denseBackward(out, loss.grad, "tanh");
            var back1 = nn.denseBackward(hidden, back2.dInput, "tanh");
            addMatrix(g2w, back2.dWeights);
            addVector(g2b, back2.dBias);
            addMatrix(g1w, back1.dWeights);
            addVector(g1b, back1.dBias);
            b = b + 1;
        }
        var lr = 0.0012;
        applyMatrix(w1, g1w, lr / batchSize);
        applyVector(b1, g1b, lr / batchSize);
        applyMatrix(w2, g2w, lr / batchSize);
        applyVector(b2, g2b, lr / batchSize);
        shownLoss = shownLoss * 0.96 + (totalLoss / batchSize) * 0.04;
    }

    function query(x: float, z: float, hint: int) -> array {
        var best = 1000000.0;
        var bestIdx = hint;
        var range = 16;
        var check = hint - range;
        while (check <= hint + range) {
            var ci = wrapIndex(check, nPts);
            var dx = x - trackPx[ci];
            var dz = z - trackPz[ci];
            var d2 = dx * dx + dz * dz;
            if (d2 < best) {
                best = d2;
                bestIdx = ci;
            }
            check = check + 1;
        }
        var dx = x - trackPx[bestIdx];
        var dz = z - trackPz[bestIdx];
        var lat = dx * trackNx[bestIdx] + dz * trackNz[bestIdx];
        var along = dx * trackTx[bestIdx] + dz * trackTz[bestIdx];
        var s = trackCum[bestIdx] + along;
        if (s < 0.0) {
            s = s + totalLen;
        }
        if (s >= totalLen) {
            s = s - totalLen;
        }
        return [bestIdx, lat, along, s];
    }

    function castRay(x: float, z: float, angle: float, hint: int) -> float {
        var step = 0.5;
        var maxD = 12.0;
        var rx = math.cos(angle);
        var rz = math.sin(angle);
        var d = 0.0;
        while (d < maxD) {
            var testX = x + rx * d;
            var testZ = z + rz * d;
            var hit = query(testX, testZ, hint);
            if (math.abs(hit[1]) > trackW) {
                return d / maxD;
            }
            d = d + step;
        }
        return 1.0;
    }

    function observe(hit: array, heading: float, speed: float, rays: array) -> array {
        var lat = hit[1];
        var latN = lat / trackW;
        if (latN > 1.4) {
            latN = 1.4;
        }
        if (latN < -1.4) {
            latN = -1.4;
        }
        var idx = int(hit[0]);
        var headErr = wrapAngle(heading - trackTang[idx]);
        var headN = headErr / 1.57079632;
        if (headN > 1.4) {
            headN = 1.4;
        }
        if (headN < -1.4) {
            headN = -1.4;
        }
        var near = trackBend[idx];
        var mid = trackBend[wrapIndex(idx + 4, nPts)];
        var far = trackBend[wrapIndex(idx + 8, nPts)];
        if (near > 1.4) {
            near = 1.4;
        }
        if (near < -1.4) {
            near = -1.4;
        }
        if (mid > 1.4) {
            mid = 1.4;
        }
        if (mid < -1.4) {
            mid = -1.4;
        }
        if (far > 1.4) {
            far = 1.4;
        }
        if (far < -1.4) {
            far = -1.4;
        }
        var speedN = speed / 150.0;
        return [latN, headN, speedN, near, mid, far, rays[0], rays[1], rays[2], rays[3], rays[4], 1.0];
    }

    function teacherOf(obs: array) -> array {
        var steer = obs[0] * 1.05 + obs[1] * 0.95 + obs[4] * 0.82 + obs[3] * 0.28;
        if (obs[8] < 0.45) {
            var side = -0.95;
            if (obs[6] < obs[10]) {
                side = 0.95;
            }
            steer = steer * 0.25 + side;
        }
        if (steer > 1.0) {
            steer = 1.0;
        }
        if (steer < -1.0) {
            steer = -1.0;
        }
        var sharp = math.abs(obs[4]);
        if (math.abs(obs[5]) > sharp) {
            sharp = math.abs(obs[5]);
        }
        var thr = 1.0 - 0.78 * sharp - 0.22 * math.abs(steer);
        if (obs[8] < 0.38) {
            thr = thr * 0.4;
        }
        if (math.abs(obs[0]) > 1.05) {
            thr = 0.26;
            steer = obs[0] * 1.35;
            if (steer > 1.0) {
                steer = 1.0;
            }
            if (steer < -1.0) {
                steer = -1.0;
            }
        }
        if (thr < 0.16) {
            thr = 0.16;
        }
        if (thr > 1.0) {
            thr = 1.0;
        }
        return [steer, thr];
    }

    function shareNow() -> float {
        if (brainMode == "net") {
            return 1.0;
        }
        if (brainMode == "coach") {
            return 0.0;
        }
        var share = 1.0 - shownLoss / 0.30;
        if (share < 0.0) {
            share = 0.0;
        }
        if (share > 1.0) {
            share = 1.0;
        }
        return share;
    }

    function updateCar(i: int, dt: float) {
        var hit = query(carX[i], carZ[i], int(carIdx[i]));
        var rays = [
            castRay(carX[i], carZ[i], carH[i] - 0.95, int(hit[0])),
            castRay(carX[i], carZ[i], carH[i] - 0.42, int(hit[0])),
            castRay(carX[i], carZ[i], carH[i], int(hit[0])),
            castRay(carX[i], carZ[i], carH[i] + 0.42, int(hit[0])),
            castRay(carX[i], carZ[i], carH[i] + 0.95, int(hit[0]))
        ];
        var obs = observe(hit, carH[i], carV[i], rays);
        var teach = teacherOf(obs);
        var hidden = nn.dense(obs, w1, b1, "tanh");
        var out = nn.dense(hidden.out, w2, b2, "tanh");
        var netSteer = out.out[0];
        var netThr = (out.out[1] + 1.0) * 0.5;
        if (netThr < 0.0) {
            netThr = 0.0;
        }
        if (netThr > 1.0) {
            netThr = 1.0;
        }
        var share = shareNow();
        var steer = teach[0] * (1.0 - share) + netSteer * share;
        var thr = teach[1] * (1.0 - share) + netThr * share;
        steer = steer + carStyle[i];
        if (steer > 1.0) {
            steer = 1.0;
        }
        if (steer < -1.0) {
            steer = -1.0;
        }
        var brake = false;
        if (i == 0 && manualDrive) {
            var keySteer = 0.0;
            if (three.isKeyDown("arrowleft") || three.isKeyDown("a")) {
                keySteer = keySteer - 1.0;
            }
            if (three.isKeyDown("arrowright") || three.isKeyDown("d")) {
                keySteer = keySteer + 1.0;
            }
            steer = keySteer;
            thr = 0.18;
            if (three.isKeyDown("arrowup") || three.isKeyDown("w")) {
                thr = 1.0;
            }
            if (three.isKeyDown("arrowdown") || three.isKeyDown("s")) {
                brake = true;
                thr = 0.0;
            }
        }
        if (i == 0 || brainMode != "net" || !manualDrive) {
            var targetThr = teach[1] * 2.0 - 1.0;
            pushSample(obs, [teach[0], targetThr]);
        }
        var onGrass = math.abs(hit[1]) > trackW * 1.02;
        var sharp = math.abs(obs[4]);
        var vTarget = 46.0 + thr * (108.0 - 70.0 * sharp);
        if (onGrass) {
            vTarget = 34.0;
        }
        if (vTarget < 28.0) {
            vTarget = 28.0;
        }
        carV[i] = carV[i] + (vTarget - carV[i]) * 3.1 * dt;
        if (brake) {
            carV[i] = carV[i] - 90.0 * dt;
        }
        if (carV[i] < 0.0) {
            carV[i] = 0.0;
        }
        if (carV[i] > 158.0) {
            carV[i] = 158.0;
        }
        var yaw = steer * (2.25 - carV[i] * 0.0065);
        carH[i] = wrapAngle(carH[i] + yaw * dt);
        carX[i] = carX[i] + math.cos(carH[i]) * carV[i] * dt;
        carZ[i] = carZ[i] + math.sin(carH[i]) * carV[i] * dt;
        var after = query(carX[i], carZ[i], int(hit[0]));
        carIdx[i] = int(after[0]);
        carS[i] = after[3];
        if (math.abs(after[1]) > trackW * 2.6 || (onGrass && carV[i] < 18.0)) {
            var back = poseAt(hit[3], 0.0);
            carX[i] = back[0];
            carZ[i] = back[1];
            carH[i] = back[2];
            carV[i] = 42.0;
            carIdx[i] = int(back[3]);
            carS[i] = back[4];
        }
    }

    var camRadius = 8.5;
    var camHeight = 3.2;
    var chaseMode = true;
    var focusX = 0.0;
    var focusZ = 0.0;

    var qWasDown = false;
    var eWasDown = false;
    var cWasDown = false;
    var nWasDown = false;
    var tWasDown = false;
    var lWasDown = false;
    var rWasDown = false;
    var spaceWasDown = false;
    var tabWasDown = false;

    var lightX = 5.0;
    var lightY = 12.0;
    var lightZ = 8.0;

    function updateCamera() {
        if (chaseMode) {
            focusX = carX[0];
            focusZ = carZ[0];
        }
        var targetAngle = carH[0] + 3.14159265;
        var camX = focusX + math.sin(targetAngle) * camRadius;
        var camY = camHeight;
        var camZ = focusZ + math.cos(targetAngle) * camRadius;

        var fx = focusX - camX;
        var fy = 0.5 - camY;
        var fz = focusZ - camZ;
        var fl = math.sqrt(fx * fx + fy * fy + fz * fz);
        fx = fx / fl;
        fy = fy / fl;
        fz = fz / fl;

        var rx = 0.0 - fz;
        var ry = 0.0;
        var rz = fx;
        var rl = math.sqrt(rx * rx + ry * ry + rz * rz);
        rx = rx / rl;
        ry = ry / rl;
        rz = rz / rl;

        var ux = ry * fz - rz * fy;
        var uy = rz * fx - rx * fz;
        var uz = rx * fy - ry * fx;

        return {
            "camX": camX,
            "camY": camY,
            "camZ": camZ,
            "forwardX": fx,
            "forwardY": fy,
            "forwardZ": fz,
            "rightX": rx,
            "rightY": ry,
            "rightZ": rz,
            "upX": ux,
            "upY": uy,
            "upZ": uz
        };
    }

    var renderer = three.createRenderer(width, height, "#app");
    three.setClearColor(renderer, "#0a1628");
    three.setRendererSize(renderer, width, height);

    var scene = three.createScene();
    var camera = three.createOrthographicCamera(-1, 1, 1, -1, 0, 1);

    var material = three.createShaderMaterial({
        "vertexShader": vertexShader,
        "fragmentShader": fragmentShader,
        "depthWrite": false,
        "uniforms": {
            "uResolution": [width, height],
            "uCamPos": [0, 3.2, 8.5],
            "uCamForward": [0, 0, -1],
            "uCamRight": [1, 0, 0],
            "uCamUp": [0, 1, 0],
            "uLightPos": [lightX, lightY, lightZ],
            "uTanHalf": tanHalf,
            "uAspect": aspect,
            "uTrackW": trackW,
            "uTrackL": trackL,
            "uCar0": [0, 0, -5],
            "uCar1": [-3, 0, -8],
            "uCar2": [3, 0, -8],
            "uCar3": [0, 0, -11],
            "uCar4": [-3, 0, -14],
            "uCar5": [3, 0, -14],
            "uCar6": [0, 0, -17],
            "uCar7": [0, 0, -20],
            "uAngle0": 0,
            "uAngle1": 0,
            "uAngle2": 0,
            "uAngle3": 0,
            "uAngle4": 0,
            "uAngle5": 0,
            "uAngle6": 0,
            "uAngle7": 0
        }
    });

    var quad = three.createMesh(three.createPlaneGeometry(2, 2), material);
    three.add(scene, quad);

    loadCircuit(0);

    function update(dtMs) {
        var dt = dtMs;
        if (dt > 50) {
            dt = 50;
        }
        var dtSec = dt / 1000.0;

        var qDown = three.isKeyDown("q");
        if (qDown && !qWasDown) {
            loadCircuit(circuitIndex - 1);
        }
        qWasDown = qDown;

        var eDown = three.isKeyDown("e");
        if (eDown && !eWasDown) {
            loadCircuit(circuitIndex + 1);
        }
        eWasDown = eDown;

        var cDown = three.isKeyDown("c");
        if (cDown && !cWasDown) {
            chaseMode = !chaseMode;
        }
        cWasDown = cDown;

        var nDown = three.isKeyDown("n");
        if (nDown && !nWasDown) {
            brainMode = "net";
        }
        nWasDown = nDown;

        var tDown = three.isKeyDown("t");
        if (tDown && !tWasDown) {
            brainMode = "coach";
        }
        tWasDown = tDown;

        var lDown = three.isKeyDown("l");
        if (lDown && !lWasDown) {
            brainMode = "blend";
        }
        lWasDown = lDown;

        var rDown = three.isKeyDown("r");
        if (rDown && !rWasDown) {
            w1 = randomMatrix(20, 12, 0.35);
            b1 = randomVector(20, 0.15);
            w2 = randomMatrix(2, 20, 0.35);
            b2 = randomVector(2, 0.15);
            samples = [];
            shownLoss = 0.5;
        }
        rWasDown = rDown;

        var spaceDown = three.isKeyDown(" ");
        if (spaceDown && !spaceWasDown) {
            paused = !paused;
        }
        spaceWasDown = spaceDown;

        var tabDown = three.isKeyDown("tab");
        if (tabDown && !tabWasDown) {
            manualDrive = !manualDrive;
        }
        tabWasDown = tabDown;

        if (!paused) {
            var i = 0;
            while (i < carCount) {
                updateCar(i, dtSec);
                i = i + 1;
            }
            trainStep();
        }

        var cam = updateCamera();
        three.setUniform(material, "uCamPos", [cam.camX, cam.camY, cam.camZ]);
        three.setUniform(material, "uCamForward", [cam.forwardX, cam.forwardY, cam.forwardZ]);
        three.setUniform(material, "uCamRight", [cam.rightX, cam.rightY, cam.rightZ]);
        three.setUniform(material, "uCamUp", [cam.upX, cam.upY, cam.upZ]);
        three.setUniform(material, "uLightPos", [lightX, lightY, lightZ]);
        three.setUniform(material, "uTrackW", trackW);
        three.setUniform(material, "uTrackL", trackL);
        three.setUniform(material, "uCar0", [carX[0], 0, carZ[0]]);
        three.setUniform(material, "uCar1", [carX[1], 0, carZ[1]]);
        three.setUniform(material, "uCar2", [carX[2], 0, carZ[2]]);
        three.setUniform(material, "uCar3", [carX[3], 0, carZ[3]]);
        three.setUniform(material, "uCar4", [carX[4], 0, carZ[4]]);
        three.setUniform(material, "uCar5", [carX[5], 0, carZ[5]]);
        three.setUniform(material, "uCar6", [carX[6], 0, carZ[6]]);
        three.setUniform(material, "uCar7", [carX[7], 0, carZ[7]]);
        three.setUniform(material, "uAngle0", carH[0]);
        three.setUniform(material, "uAngle1", carH[1]);
        three.setUniform(material, "uAngle2", carH[2]);
        three.setUniform(material, "uAngle3", carH[3]);
        three.setUniform(material, "uAngle4", carH[4]);
        three.setUniform(material, "uAngle5", carH[5]);
        three.setUniform(material, "uAngle6", carH[6]);
        three.setUniform(material, "uAngle7", carH[7]);

        var circuitName = circuits[circuitIndex].name;
        var share = shareNow();
        var modeStr = "Blend " + string(int(share * 100)) + "%";
        if (brainMode == "net") {
            modeStr = "Network 100%";
        }
        if (brainMode == "coach") {
            modeStr = "Coach 100%";
        }
        var driveStr = "AI";
        if (manualDrive) {
            driveStr = "Manual";
        }
        dom.setText(statusLine, circuitName + " | " + modeStr + " | " + driveStr + " | " + string(carCount) + " cars" + (paused && " | PAUSED" || ""));
        dom.setText(lossLine, "Loss: " + string(int(shownLoss * 1000) / 1000.0) + " | Samples: " + string(samples.length) + "/" + string(maxSamples));
    }

    function render() {
        three.render(renderer, scene, camera);
    }

    three.start(update, render);
}
