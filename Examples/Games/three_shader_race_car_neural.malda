function randomMatrix(rows: int, cols: int, scale: float) -> array {
    var matrix = [];
    var i = 0;
    while (i < rows) {
        var row = [];
        var j = 0;
        while (j < cols) {
            row.append(math.randomFloat(-scale, scale));
            j = j + 1;
        }
        matrix.append(row);
        i = i + 1;
    }
    return matrix;
}

function randomVector(n: int, scale: float) -> array {
    var values = [];
    var i = 0;
    while (i < n) {
        values.append(math.randomFloat(-scale, scale));
        i = i + 1;
    }
    return values;
}

function zeroMatrix(rows: int, cols: int) -> array {
    var matrix = [];
    var i = 0;
    while (i < rows) {
        var row = [];
        var j = 0;
        while (j < cols) {
            row.append(0.0);
            j = j + 1;
        }
        matrix.append(row);
        i = i + 1;
    }
    return matrix;
}

function zeroVector(n: int) -> array {
    var values = [];
    var i = 0;
    while (i < n) {
        values.append(0.0);
        i = i + 1;
    }
    return values;
}

function addMatrix(dst: array, src: array) {
    var i = 0;
    while (i < dst.length) {
        var j = 0;
        while (j < dst[i].length) {
            dst[i][j] = dst[i][j] + src[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
}

function addVector(dst: array, src: array) {
    var i = 0;
    while (i < dst.length) {
        dst[i] = dst[i] + src[i];
        i = i + 1;
    }
}

function applyMatrix(weights: array, grad: array, lr: float) {
    var i = 0;
    while (i < weights.length) {
        var j = 0;
        while (j < weights[i].length) {
            var g = grad[i][j];
            if (g > 4.0) {
                g = 4.0;
            }
            if (g < -4.0) {
                g = -4.0;
            }
            weights[i][j] = weights[i][j] - lr * g;
            j = j + 1;
        }
        i = i + 1;
    }
}

function applyVector(bias: array, grad: array, lr: float) {
    var i = 0;
    while (i < bias.length) {
        var g = grad[i];
        if (g > 4.0) {
            g = 4.0;
        }
        if (g < -4.0) {
            g = -4.0;
        }
        bias[i] = bias[i] - lr * g;
        i = i + 1;
    }
}

@shader()
function vertexMain() {
    vUv = uv;
    gl_Position = vec4(position.xy, 0.0, 1.0);
}

@shader()
function hitSphere(center: vec3, radius: float, origin: vec3, dir: vec3) -> float {
    var oc: vec3 = origin - center;
    var a: float = dot(dir, dir);
    var b: float = dot(oc, dir);
    var c: float = dot(oc, oc) - radius * radius;
    var disc: float = b * b - a * c;
    if (disc < 0.0) {
        return -1.0;
    }
    var root: float = sqrt(disc);
    var t: float = (-b - root) / a;
    if (t > EPSILON) {
        return t;
    }
    t = (-b + root) / a;
    if (t > EPSILON) {
        return t;
    }
    return -1.0;
}

@shader()
function hitBox(bmin: vec3, bmax: vec3, origin: vec3, dir: vec3) -> float {
    var inv: vec3 = vec3(1.0, 1.0, 1.0) / dir;
    var t0: vec3 = (bmin - origin) * inv;
    var t1: vec3 = (bmax - origin) * inv;
    var tmin: vec3 = min(t0, t1);
    var tmax: vec3 = max(t0, t1);
    var tEnter: float = max(max(tmin.x, tmin.y), tmin.z);
    var tExit: float = min(min(tmax.x, tmax.y), tmax.z);
    if (tExit < tEnter) {
        return -1.0;
    }
    if (tEnter > EPSILON) {
        return tEnter;
    }
    if (tExit > EPSILON) {
        return tExit;
    }
    return -1.0;
}

@shader()
function boxNormal(bmin: vec3, bmax: vec3, p: vec3) -> vec3 {
    var c: vec3 = (bmin + bmax) * 0.5;
    var d: vec3 = (p - c) / max(bmax - bmin, vec3(EPSILON, EPSILON, EPSILON));
    var ad: vec3 = abs(d);
    if (ad.x > ad.y && ad.x > ad.z) {
        return vec3(sign(d.x), 0.0, 0.0);
    }
    if (ad.y > ad.z) {
        return vec3(0.0, sign(d.y), 0.0);
    }
    return vec3(0.0, 0.0, sign(d.z));
}

@shader()
function hitBoxRotated(center: vec3, halfSize: vec3, angle: float, origin: vec3, dir: vec3) -> float {
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var o: vec3 = origin - center;
    var oLocal: vec3 = vec3(ca * o.x + sa * o.z, o.y, -sa * o.x + ca * o.z);
    var dLocal: vec3 = vec3(ca * dir.x + sa * dir.z, dir.y, -sa * dir.x + ca * dir.z);
    return hitBox(-halfSize, halfSize, oLocal, dLocal);
}

@shader()
function boxNormalRotated(center: vec3, halfSize: vec3, angle: float, p: vec3) -> vec3 {
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var o: vec3 = p - center;
    var pLocal: vec3 = vec3(ca * o.x + sa * o.z, o.y, -sa * o.x + ca * o.z);
    var nLocal: vec3 = boxNormal(-halfSize, halfSize, pLocal);
    return vec3(ca * nLocal.x - sa * nLocal.z, nLocal.y, sa * nLocal.x + ca * nLocal.z);
}

@shader()
function hitCylinder(center: vec3, radius: float, y0: float, y1: float, origin: vec3, dir: vec3) -> float {
    var ocx: float = origin.x - center.x;
    var ocz: float = origin.z - center.z;
    var a: float = dir.x * dir.x + dir.z * dir.z;
    var b: float = ocx * dir.x + ocz * dir.z;
    var c: float = ocx * ocx + ocz * ocz - radius * radius;
    var tBest: float = -1.0;
    if (abs(a) > EPSILON) {
        var disc: float = b * b - a * c;
        if (disc >= 0.0) {
            var root: float = sqrt(disc);
            var t: float = (-b - root) / a;
            var y: float = origin.y + dir.y * t;
            if (t > EPSILON && y >= y0 && y <= y1) {
                tBest = t;
            }
            t = (-b + root) / a;
            y = origin.y + dir.y * t;
            if (t > EPSILON && y >= y0 && y <= y1 && (tBest < 0.0 || t < tBest)) {
                tBest = t;
            }
        }
    }
    if (abs(dir.y) > EPSILON) {
        var tCap: float = (y0 - origin.y) / dir.y;
        var qx: float = origin.x + dir.x * tCap - center.x;
        var qz: float = origin.z + dir.z * tCap - center.z;
        if (tCap > EPSILON && qx * qx + qz * qz <= radius * radius && (tBest < 0.0 || tCap < tBest)) {
            tBest = tCap;
        }
        tCap = (y1 - origin.y) / dir.y;
        qx = origin.x + dir.x * tCap - center.x;
        qz = origin.z + dir.z * tCap - center.z;
        if (tCap > EPSILON && qx * qx + qz * qz <= radius * radius && (tBest < 0.0 || tCap < tBest)) {
            tBest = tCap;
        }
    }
    return tBest;
}

@shader()
function cylinderNormal(center: vec3, radius: float, y0: float, y1: float, p: vec3) -> vec3 {
    var radial: vec3 = vec3(p.x - center.x, 0.0, p.z - center.z);
    var dr: float = abs(length(radial) - radius);
    var dy0: float = abs(p.y - y0);
    var dy1: float = abs(p.y - y1);
    if (dy0 < dr && dy0 <= dy1) {
        return vec3(0.0, -1.0, 0.0);
    }
    if (dy1 < dr) {
        return vec3(0.0, 1.0, 0.0);
    }
    return normalize(radial);
}

@shader()
function hitWheel(center: vec3, radius: float, halfWidth: float, angle: float, origin: vec3, dir: vec3) -> float {
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var o: vec3 = origin - center;
    var oLocal: vec3 = vec3(ca * o.x + sa * o.z, -sa * o.x + ca * o.z, o.y);
    var dLocal: vec3 = vec3(ca * dir.x + sa * dir.z, -sa * dir.x + ca * dir.z, dir.y);
    return hitCylinder(vec3(0.0, 0.0, 0.0), radius, -halfWidth, halfWidth, oLocal, dLocal);
}

@shader()
function wheelNormal(center: vec3, radius: float, halfWidth: float, angle: float, p: vec3) -> vec3 {
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var o: vec3 = p - center;
    var pLocal: vec3 = vec3(ca * o.x + sa * o.z, -sa * o.x + ca * o.z, o.y);
    var nLocal: vec3 = cylinderNormal(vec3(0.0, 0.0, 0.0), radius, -halfWidth, halfWidth, pLocal);
    return vec3(ca * nLocal.x - sa * nLocal.y, nLocal.z, sa * nLocal.x + ca * nLocal.y);
}

@shader()
function carPosition(index: int) -> vec3 {
    if (index == 0) {
        return uCar0;
    }
    if (index == 1) {
        return uCar1;
    }
    if (index == 2) {
        return uCar2;
    }
    if (index == 3) {
        return uCar3;
    }
    if (index == 4) {
        return uCar4;
    }
    if (index == 5) {
        return uCar5;
    }
    if (index == 6) {
        return uCar6;
    }
    return uCar7;
}

@shader()
function carAngle(index: int) -> float {
    if (index == 0) {
        return uAngle0;
    }
    if (index == 1) {
        return uAngle1;
    }
    if (index == 2) {
        return uAngle2;
    }
    if (index == 3) {
        return uAngle3;
    }
    if (index == 4) {
        return uAngle4;
    }
    if (index == 5) {
        return uAngle5;
    }
    if (index == 6) {
        return uAngle6;
    }
    return uAngle7;
}

@shader()
function carColor(index: int) -> vec3 {
    if (index == 0) {
        return vec3(0.92, 0.15, 0.18);
    }
    if (index == 1) {
        return vec3(0.12, 0.52, 0.95);
    }
    if (index == 2) {
        return vec3(0.15, 0.82, 0.28);
    }
    if (index == 3) {
        return vec3(0.95, 0.72, 0.12);
    }
    if (index == 4) {
        return vec3(0.85, 0.42, 0.15);
    }
    if (index == 5) {
        return vec3(0.58, 0.18, 0.72);
    }
    if (index == 6) {
        return vec3(0.18, 0.68, 0.72);
    }
    return vec3(0.72, 0.72, 0.72);
}

@shader()
function wheelOffset(w: int) -> vec3 {
    if (w == 0) {
        return vec3(0.78, 0.0, 0.52);
    }
    if (w == 1) {
        return vec3(0.78, 0.0, -0.52);
    }
    if (w == 2) {
        return vec3(-0.78, 0.0, 0.52);
    }
    return vec3(-0.78, 0.0, -0.52);
}

@shader()
function hitCar(index: int, origin: vec3, dir: vec3, tHit: out float, kind: out int) -> bool {
    var pos: vec3 = carPosition(index);
    var angle: float = carAngle(index);
    var bodyHalf: vec3 = vec3(1.15, 0.26, 0.48);
    var bodyCenter: vec3 = vec3(pos.x, pos.y + 0.32, pos.z);
    var tBody: float = hitBoxRotated(bodyCenter, bodyHalf, angle, origin, dir);
    var wheelR: float = 0.2;
    var wheelHalf: float = 0.11;
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    tHit = 1000000.0;
    kind = -1;
    if (tBody > 0.0 && tBody < tHit) {
        tHit = tBody;
        kind = 0;
    }
    var w: int = 0;
    while (w < 4) {
        var offset: vec3 = wheelOffset(w);
        var wx: float = ca * offset.x - sa * offset.z;
        var wz: float = sa * offset.x + ca * offset.z;
        var wheelCenter: vec3 = vec3(pos.x + wx, pos.y + wheelR, pos.z + wz);
        var tWheel: float = hitWheel(wheelCenter, wheelR, wheelHalf, angle, origin, dir);
        if (tWheel > 0.0 && tWheel < tHit) {
            tHit = tWheel;
            kind = 1 + w;
        }
        w = w + 1;
    }
    return kind >= 0;
}

@shader()
function carNormal(index: int, kind: int, p: vec3) -> vec3 {
    var pos: vec3 = carPosition(index);
    var angle: float = carAngle(index);
    if (kind == 0) {
        var bodyHalf: vec3 = vec3(1.15, 0.26, 0.48);
        var bodyCenter: vec3 = vec3(pos.x, pos.y + 0.32, pos.z);
        return boxNormalRotated(bodyCenter, bodyHalf, angle, p);
    }
    var wheelR: float = 0.2;
    var wheelHalf: float = 0.11;
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var w: int = kind - 1;
    var offset: vec3 = wheelOffset(w);
    var wx: float = ca * offset.x - sa * offset.z;
    var wz: float = sa * offset.x + ca * offset.z;
    var wheelCenter: vec3 = vec3(pos.x + wx, pos.y + wheelR, pos.z + wz);
    return wheelNormal(wheelCenter, wheelR, wheelHalf, angle, p);
}

@shader()
function considerHit(t: float, tHit: float) -> bool {
    return t > 0.0 && t < tHit;
}

@shader()
function trackPoint(index: int) -> vec2 {
    var u: float = (float(index) + 0.5) / uTrackTexW;
    return texture2D(uTrack, vec2(u, 0.5)).xy;
}

@shader()
function distanceToTrack(p: vec2, trackW: float) -> float {
    var minDist: float = 1000000.0;
    var i: int = 0;
    while (i < int(uTrackPts)) {
        var next: int = i + 1;
        if (next >= int(uTrackPts)) {
            next = 0;
        }
        var a: vec2 = trackPoint(i);
        var b: vec2 = trackPoint(next);
        var pa: vec2 = p - a;
        var ba: vec2 = b - a;
        var baLen: float = dot(ba, ba);
        if (baLen < 0.0001) {
            baLen = 0.0001;
        }
        var h: float = clamp(dot(pa, ba) / baLen, 0.0, 1.0);
        var d: float = length(pa - ba * h);
        if (d < minDist) {
            minDist = d;
        }
        i = i + 1;
    }
    return minDist - trackW;
}

@shader()
function closestHit(
    origin: vec3,
    dir: vec3,
    tMax: float,
    tHit: out float,
    kind: out int,
    index: out int,
    material: out int,
    normal: out vec3,
    albedo: out vec3
) -> bool {
    tHit = tMax;
    kind = 0;
    index = -1;
    material = 0;
    normal = vec3(0.0, 1.0, 0.0);
    albedo = vec3(0.0);

    var i: int = 0;
    while (i < 8) {
        var tCar: float = 0.0;
        var carKind: int = -1;
        if (hitCar(i, origin, dir, tCar, carKind)) {
            if (considerHit(tCar, tHit)) {
                tHit = tCar;
                kind = 1;
                index = i * 10 + carKind;
                material = 1;
            }
        }
        i = i + 1;
    }

    if (abs(dir.y) > EPSILON) {
        var tGround: float = (-0.02 - origin.y) / dir.y;
        if (tGround > EPSILON && tGround < tHit) {
            tHit = tGround;
            kind = 4;
            index = -1;
            material = 0;
        }
    }

    if (kind == 0) {
        return false;
    }

    var hit: vec3 = origin + dir * tHit;
    if (kind == 1) {
        var carIdx: int = index / 10;
        var carPart: int = index - carIdx * 10;
        normal = carNormal(carIdx, carPart, hit);
        if (carPart == 0) {
            albedo = carColor(carIdx);
        } else {
            albedo = vec3(0.08, 0.08, 0.09);
        }
    } else {
        normal = vec3(0.0, 1.0, 0.0);
        if (dot(normal, dir) > 0.0) {
            normal = -normal;
        }
        var distToTrack: float = distanceToTrack(vec2(hit.x, hit.z), uTrackW);
        if (distToTrack < 0.0) {
            var cell: float = max(uTrackW * 0.7, 0.4);
            var check: float = mod(floor(hit.x / cell) + floor(hit.z / cell), 2.0);
            if (check < 0.5) {
                albedo = vec3(0.16, 0.16, 0.17);
            } else {
                albedo = vec3(0.22, 0.22, 0.24);
            }
            var fromCenter: float = abs(distToTrack + uTrackW);
            if (fromCenter < uTrackW * 0.045) {
                albedo = vec3(0.95, 0.82, 0.12);
            }
            if (distToTrack > -uTrackW * 0.09) {
                albedo = vec3(0.92, 0.92, 0.9);
            }
        } else {
            var cell: float = max(uTrackW * 1.6, 0.8);
            var check: float = mod(floor(hit.x / cell) + floor(hit.z / cell), 2.0);
            if (check < 0.5) {
                albedo = vec3(0.18, 0.42, 0.18);
            } else {
                albedo = vec3(0.12, 0.28, 0.12);
            }
        }
    }
    normal = normalize(normal);
    return true;
}

@shader()
function inShadow(hit: vec3, normal: vec3) -> bool {
    var origin: vec3 = hit + normal * 0.02;
    var toLight: vec3 = uLightPos - origin;
    var lightDist: float = length(toLight);
    if (lightDist <= EPSILON) {
        return false;
    }
    var dir: vec3 = toLight / lightDist;
    var tHit: float = 0.0;
    var kind: int = 0;
    var index: int = 0;
    var material: int = 0;
    var n: vec3 = vec3(0.0);
    var albedo: vec3 = vec3(0.0);
    return closestHit(origin, dir, lightDist - 0.05, tHit, kind, index, material, n, albedo);
}

@shader()
function localShade(hit: vec3, normal: vec3, albedo: vec3, viewDir: vec3, glossy: bool) -> vec3 {
    var toLight: vec3 = uLightPos - hit;
    var lightDir: vec3 = normalize(toLight);
    var diff: float = max(dot(normal, lightDir), 0.0);
    var light: float = 0.18;
    if (!inShadow(hit, normal)) {
        light = 0.18 + diff * 0.82;
        if (glossy) {
            var halfV: vec3 = normalize(lightDir + viewDir);
            var spec: float = pow(max(dot(normal, halfV), 0.0), 48.0);
            return albedo * light + vec3(spec, spec, spec) * 0.42;
        }
    }
    return albedo * light;
}

@shader()
function shadeSky(dir: vec3) -> vec3 {
    var t: float = clamp((dir.y + 1.0) * 0.5, 0.0, 1.0);
    return mix(vec3(0.55, 0.72, 0.92), vec3(0.12, 0.22, 0.38), t);
}

@shader()
function traceScene(origin: vec3, dir: vec3) -> vec3 {
    var tHit: float = 0.0;
    var kind: int = 0;
    var index: int = 0;
    var material: int = 0;
    var normal: vec3 = vec3(0.0);
    var albedo: vec3 = vec3(0.0);
    if (!closestHit(origin, dir, 1000000.0, tHit, kind, index, material, normal, albedo)) {
        return shadeSky(dir);
    }
    var hit: vec3 = origin + dir * tHit;
    var viewDir: vec3 = normalize(origin - hit);
    return localShade(hit, normal, albedo, viewDir, material == 1);
}

@shader()
function fragmentMain() {
    var ndc: vec2 = vUv * 2.0 - 1.0;
    var dir: vec3 = normalize(
        uCamForward
        + uCamRight * (ndc.x * uAspect * uTanHalf)
        + uCamUp * (ndc.y * uTanHalf)
    );
    var color: vec3 = traceScene(uCamPos, dir);
    gl_FragColor = vec4(sqrt(color), 1.0);
}

var vertexShader = glsl.compile({
    varyings: ["vec2 vUv"],
    functions: ["vertexMain"],
    main: "vertexMain"
});

var fragmentShader = glsl.compile({
    varyings: ["vec2 vUv"],
    uniforms: [
        "vec2 uResolution",
        "vec3 uCamPos",
        "vec3 uCamForward",
        "vec3 uCamRight",
        "vec3 uCamUp",
        "vec3 uLightPos",
        "float uTanHalf",
        "float uAspect",
        "float uTrackW",
        "float uTrackPts",
        "float uTrackTexW",
        "sampler2D uTrack",
        "vec3 uCar0",
        "vec3 uCar1",
        "vec3 uCar2",
        "vec3 uCar3",
        "vec3 uCar4",
        "vec3 uCar5",
        "vec3 uCar6",
        "vec3 uCar7",
        "float uAngle0",
        "float uAngle1",
        "float uAngle2",
        "float uAngle3",
        "float uAngle4",
        "float uAngle5",
        "float uAngle6",
        "float uAngle7"
    ],
    consts: ["float EPSILON = 0.0015"],
    functions: [
        "hitSphere",
        "hitBox",
        "boxNormal",
        "hitBoxRotated",
        "boxNormalRotated",
        "hitCylinder",
        "cylinderNormal",
        "hitWheel",
        "wheelNormal",
        "carPosition",
        "carAngle",
        "carColor",
        "wheelOffset",
        "hitCar",
        "carNormal",
        "considerHit",
        "trackPoint",
        "distanceToTrack",
        "closestHit",
        "inShadow",
        "localShade",
        "shadeSky",
        "traceScene",
        "fragmentMain"
    ],
    main: "fragmentMain"
});

var root = dom.query("#app");

if (root == null) {
    println("No #app container found.");
} else {
    dom.clear(root);

    var heading = dom.create("h1");
    dom.setText(heading, "MALDA Grand Prix 3D Neural Ray Tracer");
    dom.append(root, heading);

    var hint = dom.create("p");
    dom.setText(hint, "GPU ray-traced 3D racing with neural network learning. Keys are listed on the timing panel.");
    dom.append(root, hint);

    var hudStyle = dom.create("style");
    var hudCss = "#app{display:flex;flex-wrap:wrap;align-items:flex-start;background:#0a1628}";
    hudCss = hudCss + "#app h1,#app>p{flex:1 0 100%;color:#f6f3ec}";
    hudCss = hudCss + "#app canvas{display:block;flex:0 0 auto;background:#0a1628}";
    hudCss = hudCss + "#gp-hud{width:320px;min-height:540px;box-sizing:border-box;background:#0c1018;color:#f6f3ec;font-family:Segoe UI,sans-serif;border-left:4px solid #e10600;padding:16px 16px 12px 18px;overflow:auto}";
    hudCss = hudCss + "#gp-hud .top{display:flex;justify-content:space-between;align-items:center}";
    hudCss = hudCss + "#gp-hud .kicker{color:#e10600;font-size:12px;letter-spacing:.14em;font-weight:700}";
    hudCss = hudCss + "#gp-hud .status{font-size:13px;font-weight:700}";
    hudCss = hudCss + "#gp-hud h2{margin:4px 0 0;font-size:26px;font-weight:600;color:#f6f3ec}";
    hudCss = hudCss + "#gp-hud .sub{color:#a7b0c0;font-size:13px;margin-top:2px}";
    hudCss = hudCss + "#gp-hud .speed{font-size:40px;line-height:1;margin-top:14px;color:#f7f4ee}";
    hudCss = hudCss + "#gp-hud .unit{font-size:13px;color:#8b93a7;margin-left:8px}";
    hudCss = hudCss + "#gp-hud .row{display:flex;justify-content:space-between;gap:8px;margin-top:6px;font-size:14px}";
    hudCss = hudCss + "#gp-hud .best{color:#f0d78c}#gp-hud .muted{color:#8b93a7}#gp-hud .dim{color:#c5cad6}";
    hudCss = hudCss + "#gp-hud .label{color:#9aa3b5;font-size:12px;margin-top:14px;display:flex;justify-content:space-between;align-items:center}";
    hudCss = hudCss + "#gp-hud .share{height:10px;background:#c6a15a;margin-top:4px}";
    hudCss = hudCss + "#gp-hud .share i{display:block;height:10px;background:#1f8f72}";
    hudCss = hudCss + "#gp-hud .bars{display:grid;grid-template-columns:58px 1fr 1fr;gap:6px 8px;align-items:center;margin-top:8px;font-size:11px;color:#8b93a7}";
    hudCss = hudCss + "#gp-hud .coach{color:#e6c56a}#gp-hud .netc{color:#7dface}";
    hudCss = hudCss + "#gp-hud .track{position:relative;height:8px;background:#1a2030}";
    hudCss = hudCss + "#gp-hud .track i{position:absolute;top:0;height:8px;display:block}";
    hudCss = hudCss + "#gp-hud .netrow{display:flex;justify-content:flex-end;margin-top:8px}";
    hudCss = hudCss + "#gp-hud .lossbox{height:44px;background:#121722;margin-top:4px}";
    hudCss = hudCss + "#gp-hud .lossbox svg{width:100%;height:44px;display:block}";
    hudCss = hudCss + "#gp-hud .order div{display:flex;align-items:center;gap:8px;height:16px;font-size:13px;margin-top:2px}";
    hudCss = hudCss + "#gp-hud .dot{width:9px;height:9px;border-radius:50%;flex:0 0 9px}";
    hudCss = hudCss + "#gp-hud .gap{margin-left:auto;color:#a7b0c0;font-size:12px}";
    hudCss = hudCss + "#gp-hud .chips{display:grid;grid-template-columns:1fr 1fr;gap:4px;margin-top:12px}";
    hudCss = hudCss + "#gp-hud .chips span{background:#171d2a;color:#c5cad6;font-size:11px;padding:3px 8px}";
    hudCss = hudCss + "#gp-hud .chips span.on{background:#e10600;color:#fff7f4}";
    hudCss = hudCss + "#gp-hud .keys{margin-top:12px;color:#d5dbe8;font-size:11px;line-height:1.45}";
    dom.setText(hudStyle, hudCss);
    dom.append(root, hudStyle);

    var hud = dom.create("div");
    hud.id = "gp-hud";
    dom.setText(hud, "Loading...");

    if (dom.query("#malda-autoplay") != null) {
        var showcaseFit = dom.create("style");
        dom.setText(showcaseFit, "#status{display:none!important}html,body{overflow:hidden;margin:0;background:#0a1628}#app{min-height:0!important;background:#0a1628}#app>p,#app>div:not(#gp-hud){display:none!important}#gp-hud{display:block!important;position:fixed!important;right:0;top:0;bottom:0;z-index:4;min-height:0}#app h1{margin:8px 12px 0;font-size:14px;font-weight:600;line-height:1.2}#app canvas{position:fixed!important;left:8px!important;top:32px!important;width:calc(100vw - 336px)!important;height:calc(100vh - 44px)!important;object-fit:contain;object-position:center center;background:#0a1628}");
        dom.append(root, showcaseFit);
    }

    var width = 960;
    var height = 540;
    var aspect = width / height;
    var tanHalf = math.tan(math.degToRad(32));

    var circuits = circuitCatalog();
    var circuitIndex = 0;
    var trackPx = [];
    var trackPz = [];
    var trackTx = [];
    var trackTz = [];
    var trackNx = [];
    var trackNz = [];
    var trackTang = [];
    var trackCum = [];
    var trackBend = [];
    var totalLen = 1.0;
    var nPts = 0;
    var trackW = 3.2;
    var worldScale = 0.2;
    var targetHalf = 3.2;
    var cenX = 0.0;
    var cenZ = 0.0;
    var trackSpan = 40.0;

    function buildTrack(spec: map) {
        var keys = spec.pts;
        var nK = int(keys.length / 2);
        var minX = 1000000.0;
        var maxX = -1000000.0;
        var minZ = 1000000.0;
        var maxZ = -1000000.0;
        var i = 0;
        while (i < nK) {
            var kx = keys[i * 2];
            var kz = keys[i * 2 + 1];
            if (kx < minX) {
                minX = kx;
            }
            if (kx > maxX) {
                maxX = kx;
            }
            if (kz < minZ) {
                minZ = kz;
            }
            if (kz > maxZ) {
                maxZ = kz;
            }
            i = i + 1;
        }
        var spanX = maxX - minX;
        var spanZ = maxZ - minZ;
        if (spanX < 1.0) {
            spanX = 1.0;
        }
        if (spanZ < 1.0) {
            spanZ = 1.0;
        }
        var viewL = 40.0;
        var viewT = 36.0;
        var viewR = 918.0;
        var viewB = 688.0;
        var scale = (viewR - viewL) / spanX;
        var scaleZ = (viewB - viewT) / spanZ;
        if (scaleZ < scale) {
            scale = scaleZ;
        }
        var usedW = spanX * scale;
        var usedH = spanZ * scale;
        var offX = viewL + ((viewR - viewL) - usedW) / 2.0;
        var offZ = viewT + ((viewB - viewT) - usedH) / 2.0;
        var fitX = [];
        var fitZ = [];
        var p = 0;
        while (p < nK) {
            fitX.append(offX + (keys[p * 2] - minX) * scale);
            fitZ.append(offZ + (keys[p * 2 + 1] - minZ) * scale);
            p = p + 1;
        }
        var pixelHalf = spec.width * scale * 0.34;
        if (pixelHalf < 8.0) {
            pixelHalf = 8.0;
        }
        if (pixelHalf > 16.0) {
            pixelHalf = 16.0;
        }

        var rawX = fitX;
        var rawZ = fitZ;
        var pass = 0;
        while (pass < 4) {
            var nextX = [];
            var nextZ = [];
            var nSmooth = rawX.length;
            var s = 0;
            while (s < nSmooth) {
                var j = wrapIndex(s + 1, nSmooth);
                nextX.append(rawX[s] * 0.75 + rawX[j] * 0.25);
                nextZ.append(rawZ[s] * 0.75 + rawZ[j] * 0.25);
                nextX.append(rawX[s] * 0.25 + rawX[j] * 0.75);
                nextZ.append(rawZ[s] * 0.25 + rawZ[j] * 0.75);
                s = s + 1;
            }
            rawX = nextX;
            rawZ = nextZ;
            pass = pass + 1;
        }

        trackPx = [];
        trackPz = [];
        var spacing = 9.0;
        var count = rawX.length;
        var cursor = 0.0;
        trackPx.append(rawX[0]);
        trackPz.append(rawZ[0]);
        var r = 1;
        while (r <= count) {
            var j = r;
            if (j == count) {
                j = 0;
            }
            var x1 = rawX[r - 1];
            var z1 = rawZ[r - 1];
            if (r == count) {
                x1 = rawX[count - 1];
                z1 = rawZ[count - 1];
            }
            var x2 = rawX[j];
            var z2 = rawZ[j];
            var dx = x2 - x1;
            var dz = z2 - z1;
            var segLen = math.sqrt(dx * dx + dz * dz);
            var pos = 0.0;
            if (segLen > 0.001) {
                while (pos + (spacing - cursor) <= segLen) {
                    var need = spacing - cursor;
                    pos = pos + need;
                    cursor = 0.0;
                    var u = pos / segLen;
                    trackPx.append(x1 + dx * u);
                    trackPz.append(z1 + dz * u);
                }
                cursor = cursor + (segLen - pos);
            }
            r = r + 1;
        }
        if (trackPx.length > 3) {
            var cdx = trackPx[trackPx.length - 1] - trackPx[0];
            var cdz = trackPz[trackPz.length - 1] - trackPz[0];
            if (cdx * cdx + cdz * cdz < spacing * spacing * 0.36) {
                trackPx.pop();
                trackPz.pop();
            }
        }
        var openPass = 0;
        while (openPass < 2) {
            var openedX = [];
            var openedZ = [];
            var nOpen = trackPx.length;
            var oi = 0;
            while (oi < nOpen) {
                var op = wrapIndex(oi - 1, nOpen);
                var on = wrapIndex(oi + 1, nOpen);
                var inAng = math.atan2(trackPz[oi] - trackPz[op], trackPx[oi] - trackPx[op]);
                var outAng = math.atan2(trackPz[on] - trackPz[oi], trackPx[on] - trackPx[oi]);
                var turn = math.abs(wrapAngle(outAng - inAng));
                if (turn > 0.55) {
                    openedX.append(trackPx[oi] * 0.45 + (trackPx[op] + trackPx[on]) * 0.275);
                    openedZ.append(trackPz[oi] * 0.45 + (trackPz[op] + trackPz[on]) * 0.275);
                } else {
                    openedX.append(trackPx[oi]);
                    openedZ.append(trackPz[oi]);
                }
                oi = oi + 1;
            }
            trackPx = openedX;
            trackPz = openedZ;
            openPass = openPass + 1;
        }
        while (trackPx.length > 480) {
            var thinX = [];
            var thinZ = [];
            var t = 0;
            while (t < trackPx.length) {
                thinX.append(trackPx[t]);
                thinZ.append(trackPz[t]);
                t = t + 2;
            }
            if (thinX.length < 8) {
                break;
            }
            trackPx = thinX;
            trackPz = thinZ;
        }

        worldScale = targetHalf / pixelHalf;
        nPts = trackPx.length;
        var sc = 0;
        while (sc < nPts) {
            trackPx[sc] = trackPx[sc] * worldScale;
            trackPz[sc] = trackPz[sc] * worldScale;
            sc = sc + 1;
        }
        trackW = targetHalf;

        trackTx = [];
        trackTz = [];
        trackNx = [];
        trackNz = [];
        trackTang = [];
        trackCum = [];
        trackBend = [];
        var acc = 0.0;
        var n = 0;
        while (n < nPts) {
            var nxt = wrapIndex(n + 1, nPts);
            var sdx = trackPx[nxt] - trackPx[n];
            var sdz = trackPz[nxt] - trackPz[n];
            var sl = math.sqrt(sdx * sdx + sdz * sdz);
            if (sl < 0.001) {
                sl = 0.001;
            }
            var ux = sdx / sl;
            var uz = sdz / sl;
            trackTx.append(ux);
            trackTz.append(uz);
            trackNx.append(uz);
            trackNz.append(-ux);
            trackTang.append(math.atan2(uz, ux));
            trackCum.append(acc);
            acc = acc + sl;
            n = n + 1;
        }
        totalLen = acc;
        if (totalLen < 1.0) {
            totalLen = 1.0;
        }
        var b = 0;
        while (b < nPts) {
            var ahead = wrapIndex(b + 16, nPts);
            trackBend.append(wrapAngle(trackTang[ahead] - trackTang[b]));
            b = b + 1;
        }
        cenX = 0.0;
        cenZ = 0.0;
        var c = 0;
        var boxMinX = trackPx[0];
        var boxMaxX = trackPx[0];
        var boxMinZ = trackPz[0];
        var boxMaxZ = trackPz[0];
        while (c < nPts) {
            cenX = cenX + trackPx[c];
            cenZ = cenZ + trackPz[c];
            if (trackPx[c] < boxMinX) {
                boxMinX = trackPx[c];
            }
            if (trackPx[c] > boxMaxX) {
                boxMaxX = trackPx[c];
            }
            if (trackPz[c] < boxMinZ) {
                boxMinZ = trackPz[c];
            }
            if (trackPz[c] > boxMaxZ) {
                boxMaxZ = trackPz[c];
            }
            c = c + 1;
        }
        if (nPts > 0) {
            cenX = cenX / nPts;
            cenZ = cenZ / nPts;
        }
        trackSpan = boxMaxX - boxMinX;
        if (boxMaxZ - boxMinZ > trackSpan) {
            trackSpan = boxMaxZ - boxMinZ;
        }
        if (trackSpan < 8.0) {
            trackSpan = 8.0;
        }
    }

    function loadCircuit(index: int) {
        if (index < 0) {
            index = circuits.length - 1;
        }
        if (index >= circuits.length) {
            index = 0;
        }
        circuitIndex = index;
        var spec = circuits[circuitIndex];
        buildTrack(spec);
        resetCars();
        sessionBest = -1.0;
        uploadTrackTexture();
    }

    function poseAt(dist: float, side: float) -> array {
        var s = dist;
        while (s < 0.0) {
            s = s + totalLen;
        }
        while (s >= totalLen) {
            s = s - totalLen;
        }
        var idx = 0;
        var i = 0;
        while (i < nPts) {
            if (trackCum[i] <= s) {
                idx = i;
            }
            i = i + 1;
        }
        var j = wrapIndex(idx + 1, nPts);
        var seg = 0.0;
        if (j == 0) {
            seg = totalLen - trackCum[idx];
        } else {
            seg = trackCum[j] - trackCum[idx];
        }
        var t = 0.0;
        if (seg > 0.001) {
            t = (s - trackCum[idx]) / seg;
        }
        var x = trackPx[idx] + (trackPx[j] - trackPx[idx]) * t + trackNx[idx] * side;
        var z = trackPz[idx] + (trackPz[j] - trackPz[idx]) * t + trackNz[idx] * side;
        return [x, z, trackTang[idx], idx, s];
    }

    var carCount = 8;
    var carX = [];
    var carZ = [];
    var carH = [];
    var carV = [];
    var carIdx = [];
    var carS = [];
    var carLap = [];
    var carLapTime = [];
    var carLast = [];
    var carBest = [];
    var carAge = [];
    var carStyle = [];
    var manualDrive = false;
    var leadCar = 0;
    var order = [];
    var hudCar = 0;

    function resetCars() {
        carX = [];
        carZ = [];
        carH = [];
        carV = [];
        carIdx = [];
        carS = [];
        carLap = [];
        carLapTime = [];
        carLast = [];
        carBest = [];
        carAge = [];
        carStyle = [];
        order = [];
        leadCar = 0;
        var i = 0;
        while (i < carCount) {
            var side = trackW * 0.26;
            if (i % 2 == 0) {
                side = -side;
            }
            var pose = poseAt(totalLen - 26.0 * worldScale - i * 28.0 * worldScale, side);
            carX.append(pose[0]);
            carZ.append(pose[1]);
            carH.append(pose[2]);
            carV.append(0.0);
            carIdx.append(int(pose[3]));
            carS.append(pose[4]);
            carLap.append(0);
            carLapTime.append(0.0);
            carLast.append(-1.0);
            carBest.append(-1.0);
            carAge.append(0.0);
            carStyle.append((i - 3.5) * 0.045);
            order.append(i);
            i = i + 1;
        }
    }

    var inN = 12;
    var hidN = 20;
    var w1 = [];
    var b1 = [];
    var w2 = [];
    var b2 = [];
    var bufX = [];
    var bufY = [];
    var shownLoss = 0.46;
    var lastLoss = 0.46;
    var sessionBest = -1.0;
    var brainMode = "blend";
    var paused = false;
    var trainTick = 0;
    var lossHist = [];
    var lastSteerNet = 0.0;
    var lastThrNet = 0.0;
    var lastSteerCoach = 0.0;
    var lastThrCoach = 0.0;
    var lastHidden = [];
    var carColors = ["#eb262e", "#1f85f2", "#26d147", "#f2b81f", "#d96b26", "#942eb8", "#2eadb8", "#b8b8b8"];

    function resetBrain() {
        math.seed(11);
        var s1 = math.sqrt(6.0 / (inN + hidN));
        var s2 = math.sqrt(6.0 / (hidN + 2));
        w1 = randomMatrix(inN, hidN, s1);
        b1 = randomVector(hidN, 0.04);
        w2 = randomMatrix(hidN, 2, s2);
        b2 = randomVector(2, 0.04);
        bufX = [];
        bufY = [];
        lastLoss = 0.46;
        shownLoss = 0.46;
        trainTick = 0;
        lossHist = [];
        lastHidden = [];
        var z = 0;
        while (z < hidN) {
            lastHidden.append(0.0);
            z = z + 1;
        }
    }

    resetBrain();

    function pushSample(obs: array, target: array) {
        bufX.append(obs);
        bufY.append(target);
        if (bufX.length > 72) {
            bufX.shift();
            bufY.shift();
        }
    }

    function imitate() {
        var n = bufX.length;
        if (n < 12) {
            return;
        }
        var g1w = zeroMatrix(inN, hidN);
        var g1b = zeroVector(hidN);
        var g2w = zeroMatrix(hidN, 2);
        var g2b = zeroVector(2);
        var lossSum = 0.0;
        var i = 0;
        while (i < n) {
            var x = bufX[i];
            var target = bufY[i];
            var hidden = nn.dense(x, w1, b1, "tanh");
            var out = nn.dense(hidden.out, w2, b2, "tanh");
            var upstream = nn.mseGrad(out.out, target);
            lossSum = lossSum + 0.5 * (upstream[0] * upstream[0] + upstream[1] * upstream[1]);
            var back2 = nn.denseBackward(hidden.out, w2, upstream, "tanh", out.pre);
            var back1 = nn.denseBackward(x, w1, back2.dInput, "tanh", hidden.pre);
            addMatrix(g1w, back1.dWeights);
            addVector(g1b, back1.dBias);
            addMatrix(g2w, back2.dWeights);
            addVector(g2b, back2.dBias);
            i = i + 1;
        }
        var step = 0.16 / n;
        applyMatrix(w1, g1w, step);
        applyVector(b1, g1b, step);
        applyMatrix(w2, g2w, step);
        applyVector(b2, g2b, step);
        lastLoss = lossSum / n;
        lossHist.append(lastLoss);
        if (lossHist.length > 48) {
            lossHist.shift();
        }
    }

    function query(x: float, z: float, hint: int) -> array {
        var bestI = wrapIndex(hint, nPts);
        var bestD = 1000000000.0;
        var bestT = 0.0;
        var pass = 0;
        while (pass < 2) {
            var from = hint - 10;
            var to = hint + 42;
            if (pass == 1) {
                if (bestD <= trackW * trackW * 16.0) {
                    break;
                }
                from = 0;
                to = nPts - 1;
            }
            var k = from;
            while (k <= to) {
                var i = k;
                if (pass == 0) {
                    i = wrapIndex(k, nPts);
                }
                var j = wrapIndex(i + 1, nPts);
                var ax = trackPx[i];
                var az = trackPz[i];
                var bx = trackPx[j];
                var bz = trackPz[j];
                var dx = bx - ax;
                var dz = bz - az;
                var len2 = dx * dx + dz * dz;
                var t = 0.0;
                if (len2 > 0.0001) {
                    t = ((x - ax) * dx + (z - az) * dz) / len2;
                    if (t < 0.0) {
                        t = 0.0;
                    }
                    if (t > 1.0) {
                        t = 1.0;
                    }
                }
                var qx = ax + dx * t;
                var qz = az + dz * t;
                var ex = x - qx;
                var ez = z - qz;
                var d2 = ex * ex + ez * ez;
                if (d2 < bestD) {
                    bestD = d2;
                    bestI = i;
                    bestT = t;
                }
                k = k + 1;
            }
            pass = pass + 1;
        }
        var jn = wrapIndex(bestI + 1, nPts);
        var sx = trackPx[jn] - trackPx[bestI];
        var sz = trackPz[jn] - trackPz[bestI];
        var seg = math.sqrt(sx * sx + sz * sz);
        var qx2 = trackPx[bestI] + sx * bestT;
        var qz2 = trackPz[bestI] + sz * bestT;
        var lat = (x - qx2) * trackNx[bestI] + (z - qz2) * trackNz[bestI];
        var along = trackCum[bestI] + bestT * seg;
        if (along < 0.0) {
            along = along + totalLen;
        }
        if (along >= totalLen) {
            along = along - totalLen;
        }
        return [bestI, lat, bestT, along];
    }

    function castRay(x: float, z: float, angle: float, hint: int) -> float {
        var dirx = math.cos(angle);
        var dirz = math.sin(angle);
        var maxD = 128.0 * worldScale;
        var dist = 8.0 * worldScale;
        var step = 10.0 * worldScale;
        var h = hint;
        while (dist <= maxD) {
            var hit = query(x + dirx * dist, z + dirz * dist, h);
            h = int(hit[0]);
            if (math.abs(hit[1]) > trackW) {
                return dist / maxD;
            }
            dist = dist + step;
        }
        return 1.0;
    }

    function observe(hit: array, heading: float, speed: float, rays: array) -> array {
        var latN = hit[1] / trackW;
        if (latN > 1.7) {
            latN = 1.7;
        }
        if (latN < -1.7) {
            latN = -1.7;
        }
        var idx = int(hit[0]);
        var headN = wrapAngle(trackTang[idx] - heading) / 3.14159265;
        if (headN > 1.0) {
            headN = 1.0;
        }
        if (headN < -1.0) {
            headN = -1.0;
        }
        var near = trackBend[idx] / 1.15;
        var mid = trackBend[wrapIndex(idx + 10, nPts)] / 1.25;
        var far = trackBend[wrapIndex(idx + 24, nPts)] / 1.35;
        if (near > 1.4) {
            near = 1.4;
        }
        if (near < -1.4) {
            near = -1.4;
        }
        if (mid > 1.4) {
            mid = 1.4;
        }
        if (mid < -1.4) {
            mid = -1.4;
        }
        if (far > 1.4) {
            far = 1.4;
        }
        if (far < -1.4) {
            far = -1.4;
        }
        var speedScale = 150.0 * worldScale;
        if (speedScale < 1.0) {
            speedScale = 1.0;
        }
        var speedN = speed / speedScale;
        return [latN, headN, speedN, near, mid, far, rays[0], rays[1], rays[2], rays[3], rays[4], 1.0];
    }

    function teacherOf(obs: array) -> array {
        var steer = obs[0] * 1.05 + obs[1] * 0.95 + obs[4] * 0.82 + obs[3] * 0.28;
        if (obs[8] < 0.45) {
            var side = -0.95;
            if (obs[6] < obs[10]) {
                side = 0.95;
            }
            steer = steer * 0.25 + side;
        }
        if (steer > 1.0) {
            steer = 1.0;
        }
        if (steer < -1.0) {
            steer = -1.0;
        }
        var sharp = math.abs(obs[4]);
        if (math.abs(obs[5]) > sharp) {
            sharp = math.abs(obs[5]);
        }
        var thr = 1.0 - 0.78 * sharp - 0.22 * math.abs(steer);
        if (obs[8] < 0.38) {
            thr = thr * 0.4;
        }
        if (math.abs(obs[0]) > 1.05) {
            thr = 0.26;
            steer = obs[0] * 1.35;
            if (steer > 1.0) {
                steer = 1.0;
            }
            if (steer < -1.0) {
                steer = -1.0;
            }
        }
        if (thr < 0.16) {
            thr = 0.16;
        }
        if (thr > 1.0) {
            thr = 1.0;
        }
        return [steer, thr];
    }

    function shareNow() -> float {
        if (brainMode == "net") {
            return 1.0;
        }
        if (brainMode == "coach") {
            return 0.0;
        }
        var share = 1.0 - shownLoss / 0.30;
        if (share < 0.0) {
            share = 0.0;
        }
        if (share > 1.0) {
            share = 1.0;
        }
        return share;
    }

    function updateCar(i: int, dt: float) {
        var hit = query(carX[i], carZ[i], int(carIdx[i]));
        var rays = [
            castRay(carX[i], carZ[i], carH[i] - 0.95, int(hit[0])),
            castRay(carX[i], carZ[i], carH[i] - 0.42, int(hit[0])),
            castRay(carX[i], carZ[i], carH[i], int(hit[0])),
            castRay(carX[i], carZ[i], carH[i] + 0.42, int(hit[0])),
            castRay(carX[i], carZ[i], carH[i] + 0.95, int(hit[0]))
        ];
        var obs = observe(hit, carH[i], carV[i], rays);
        var teach = teacherOf(obs);
        var hidden = nn.dense(obs, w1, b1, "tanh");
        var out = nn.dense(hidden.out, w2, b2, "tanh");
        var netSteer = out.out[0];
        var netThr = (out.out[1] + 1.0) * 0.5;
        if (netThr < 0.0) {
            netThr = 0.0;
        }
        if (netThr > 1.0) {
            netThr = 1.0;
        }
        if (i == hudCar) {
            lastSteerNet = netSteer;
            lastThrNet = netThr;
            lastSteerCoach = teach[0];
            lastThrCoach = teach[1];
            lastHidden = [];
            var hCopy = 0;
            while (hCopy < hidN) {
                lastHidden.append(hidden.out[hCopy]);
                hCopy = hCopy + 1;
            }
        }
        var share = shareNow();
        var steer = teach[0] * (1.0 - share) + netSteer * share;
        var thr = teach[1] * (1.0 - share) + netThr * share;
        steer = steer + carStyle[i];
        if (steer > 1.0) {
            steer = 1.0;
        }
        if (steer < -1.0) {
            steer = -1.0;
        }
        var brake = false;
        if (i == 0 && manualDrive) {
            var keySteer = 0.0;
            if (three.isKeyDown("arrowleft") || three.isKeyDown("a")) {
                keySteer = keySteer - 1.0;
            }
            if (three.isKeyDown("arrowright") || three.isKeyDown("d")) {
                keySteer = keySteer + 1.0;
            }
            steer = keySteer;
            thr = 0.18;
            if (three.isKeyDown("arrowup") || three.isKeyDown("w")) {
                thr = 1.0;
            }
            if (three.isKeyDown("arrowdown") || three.isKeyDown("s")) {
                brake = true;
                thr = 0.0;
            }
        }
        if (i != 0 || !manualDrive || brainMode != "net") {
            var targetThr = teach[1] * 2.0 - 1.0;
            pushSample(obs, [teach[0], targetThr]);
        }
        var onGrass = math.abs(hit[1]) > trackW * 1.02;
        var sharp = math.abs(obs[4]);
        var vTarget = (46.0 + thr * (108.0 - 70.0 * sharp)) * worldScale;
        if (onGrass) {
            vTarget = 34.0 * worldScale;
        }
        if (vTarget < 28.0 * worldScale) {
            vTarget = 28.0 * worldScale;
        }
        carV[i] = carV[i] + (vTarget - carV[i]) * 3.1 * dt;
        if (brake) {
            carV[i] = carV[i] - 90.0 * worldScale * dt;
        }
        if (carV[i] < 0.0) {
            carV[i] = 0.0;
        }
        var vMax = 158.0 * worldScale;
        if (carV[i] > vMax) {
            carV[i] = vMax;
        }
        var yawK = 0.0065 / worldScale;
        var yaw = steer * (2.25 - carV[i] * yawK);
        carH[i] = wrapAngle(carH[i] + yaw * dt);
        carX[i] = carX[i] + math.cos(carH[i]) * carV[i] * dt;
        carZ[i] = carZ[i] + math.sin(carH[i]) * carV[i] * dt;
        var after = query(carX[i], carZ[i], int(hit[0]));
        var prevS = carS[i];
        carIdx[i] = int(after[0]);
        carS[i] = after[3];
        carAge[i] = carAge[i] + dt;
        carLapTime[i] = carLapTime[i] + dt;
        if (prevS > totalLen * 0.70 && carS[i] < totalLen * 0.30) {
            if (carLap[i] >= 1 && carLapTime[i] > 6.0) {
                carLast[i] = carLapTime[i];
                if (carBest[i] < 0.0 || carLapTime[i] < carBest[i]) {
                    carBest[i] = carLapTime[i];
                }
                if (sessionBest < 0.0 || carLapTime[i] < sessionBest) {
                    sessionBest = carLapTime[i];
                }
            }
            carLap[i] = carLap[i] + 1;
            carLapTime[i] = 0.0;
        }
        if (math.abs(after[1]) > trackW * 2.6 || (onGrass && carV[i] < 18.0 * worldScale && carAge[i] > 1.2)) {
            var back = poseAt(prevS, 0.0);
            carX[i] = back[0];
            carZ[i] = back[1];
            carH[i] = back[2];
            carV[i] = 42.0 * worldScale;
            carIdx[i] = int(back[3]);
            carS[i] = back[4];
        }
    }

    function bumpCar(i: int, vx: float, vz: float) {
        var fwdX = math.cos(carH[i]);
        var fwdZ = math.sin(carH[i]);
        var along = vx * fwdX + vz * fwdZ;
        var speed = math.sqrt(vx * vx + vz * vz);
        if (speed > 1.0) {
            var kick = wrapAngle(math.atan2(vz, vx) - carH[i]) * 0.35;
            if (kick > 0.18) {
                kick = 0.18;
            }
            if (kick < -0.18) {
                kick = -0.18;
            }
            carH[i] = wrapAngle(carH[i] + kick);
        }
        if (along < 0.0) {
            along = 0.0;
        }
        var vMax = 158.0 * worldScale;
        if (along > vMax) {
            along = vMax;
        }
        carV[i] = along;
    }

    function separateCars() {
        var carRest = 0.5;
        var i = 0;
        while (i < carCount) {
            var j = i + 1;
            while (j < carCount) {
                var dx = carX[j] - carX[i];
                var dz = carZ[j] - carZ[i];
                var d2 = dx * dx + dz * dz;
                var minD = trackW * 0.55;
                if (d2 < minD * minD && d2 > 0.0001) {
                    var d = math.sqrt(d2);
                    var nx = dx / d;
                    var nz = dz / d;
                    var overlap = minD - d;
                    carX[i] = carX[i] - nx * overlap * 0.5;
                    carZ[i] = carZ[i] - nz * overlap * 0.5;
                    carX[j] = carX[j] + nx * overlap * 0.5;
                    carZ[j] = carZ[j] + nz * overlap * 0.5;
                    var vix = math.cos(carH[i]) * carV[i];
                    var viz = math.sin(carH[i]) * carV[i];
                    var vjx = math.cos(carH[j]) * carV[j];
                    var vjz = math.sin(carH[j]) * carV[j];
                    var rel = ((vix - vjx) * nx) + ((viz - vjz) * nz);
                    if (rel > 0.0) {
                        var impulse = -(1.0 + carRest) * rel * 0.5;
                        bumpCar(i, vix + nx * impulse, viz + nz * impulse);
                        bumpCar(j, vjx - nx * impulse, vjz - nz * impulse);
                    }
                }
                j = j + 1;
            }
            i = i + 1;
        }
    }

    function updateLead() {
        order = [];
        var i = 0;
        while (i < carCount) {
            order.append(i);
            i = i + 1;
        }
        var a = 0;
        while (a < carCount) {
            var b = 0;
            while (b < carCount - 1) {
                var ia = order[b];
                var ib = order[b + 1];
                var pa = carLap[ia] * totalLen + carS[ia];
                var pb = carLap[ib] * totalLen + carS[ib];
                if (pb > pa) {
                    order[b] = ib;
                    order[b + 1] = ia;
                }
                b = b + 1;
            }
            a = a + 1;
        }
        if (order.length > 0) {
            leadCar = order[0];
        }
    }

    var camRadius = 14.0;
    var camHeight = 5.4;
    var chaseMode = true;
    var focusX = 0.0;
    var focusZ = 0.0;

    var qWasDown = false;
    var eWasDown = false;
    var cWasDown = false;
    var nWasDown = false;
    var tWasDown = false;
    var lWasDown = false;
    var rWasDown = false;
    var spaceWasDown = false;
    var tabWasDown = false;

    var lightX = 5.0;
    var lightY = 12.0;
    var lightZ = 8.0;

    function updateCamera() {
        var camX = cenX;
        var camY = trackSpan * 1.15;
        var camZ = cenZ + trackSpan * 0.08;
        var lookX = cenX;
        var lookY = 0.0;
        var lookZ = cenZ;
        if (chaseMode) {
            var focusI = leadCar;
            if (manualDrive) {
                focusI = 0;
            }
            focusX = carX[focusI];
            focusZ = carZ[focusI];
            var heading = carH[focusI];
            var aheadX = math.cos(heading);
            var aheadZ = math.sin(heading);
            camX = focusX - aheadX * camRadius;
            camY = camHeight;
            camZ = focusZ - aheadZ * camRadius;
            lookX = focusX + aheadX * 4.2;
            lookY = 0.9;
            lookZ = focusZ + aheadZ * 4.2;
        } else {
            focusX = cenX;
            focusZ = cenZ;
        }

        var fx = lookX - camX;
        var fy = lookY - camY;
        var fz = lookZ - camZ;
        var fl = math.sqrt(fx * fx + fy * fy + fz * fz);
        if (fl < 0.001) {
            fl = 1.0;
        }
        fx = fx / fl;
        fy = fy / fl;
        fz = fz / fl;

        var rx = 0.0 - fz;
        var ry = 0.0;
        var rz = fx;
        var rl = math.sqrt(rx * rx + ry * ry + rz * rz);
        if (rl < 0.001) {
            rl = 1.0;
        }
        rx = rx / rl;
        ry = ry / rl;
        rz = rz / rl;

        var ux = ry * fz - rz * fy;
        var uy = rz * fx - rx * fz;
        var uz = rx * fy - ry * fx;

        return {
            "camX": camX,
            "camY": camY,
            "camZ": camZ,
            "forwardX": fx,
            "forwardY": fy,
            "forwardZ": fz,
            "rightX": rx,
            "rightY": ry,
            "rightZ": rz,
            "upX": ux,
            "upY": uy,
            "upZ": uz
        };
    }

    var renderer = three.createRenderer(width, height, "#app");
    three.setClearColor(renderer, "#0a1628");
    three.setRendererSize(renderer, width, height);
    dom.append(root, hud);

    var scene = three.createScene();
    var camera = three.createOrthographicCamera(-1, 1, 1, -1, 0, 1);

    var trackTexW = 512;
    var trackPixels = [];
    var pix = 0;
    while (pix < trackTexW * 4) {
        trackPixels.append(0.0);
        pix = pix + 1;
    }
    var trackTex = three.createDataTexture(trackTexW, 1, trackPixels, {"type": "float"});

    var material = three.createShaderMaterial({
        "vertexShader": vertexShader,
        "fragmentShader": fragmentShader,
        "depthWrite": false,
        "uniforms": {
            "uResolution": [width, height],
            "uCamPos": [0, 3.2, 8.5],
            "uCamForward": [0, 0, -1],
            "uCamRight": [1, 0, 0],
            "uCamUp": [0, 1, 0],
            "uLightPos": [lightX, lightY, lightZ],
            "uTanHalf": tanHalf,
            "uAspect": aspect,
            "uTrackW": trackW,
            "uTrackPts": 0,
            "uTrackTexW": trackTexW,
            "uTrack": trackTex,
            "uCar0": [0, 0, -5],
            "uCar1": [-3, 0, -8],
            "uCar2": [3, 0, -8],
            "uCar3": [0, 0, -11],
            "uCar4": [-3, 0, -14],
            "uCar5": [3, 0, -14],
            "uCar6": [0, 0, -17],
            "uCar7": [0, 0, -20],
            "uAngle0": 0,
            "uAngle1": 0,
            "uAngle2": 0,
            "uAngle3": 0,
            "uAngle4": 0,
            "uAngle5": 0,
            "uAngle6": 0,
            "uAngle7": 0
        }
    });

    var quad = three.createMesh(three.createPlaneGeometry(2, 2), material);
    three.add(scene, quad);

    function uploadTrackTexture() {
        var count = nPts;
        if (count > trackTexW) {
            count = trackTexW;
        }
        var i = 0;
        while (i < trackTexW) {
            var o = i * 4;
            if (i < count) {
                trackPixels[o] = trackPx[i];
                trackPixels[o + 1] = trackPz[i];
                trackPixels[o + 2] = 0.0;
                trackPixels[o + 3] = 1.0;
            } else {
                trackPixels[o] = 0.0;
                trackPixels[o + 1] = 0.0;
                trackPixels[o + 2] = 0.0;
                trackPixels[o + 3] = 0.0;
            }
            i = i + 1;
        }
        three.updateDataTexture(trackTex, trackPixels);
        three.setUniform(material, "uTrackPts", count);
        three.setUniform(material, "uTrackW", trackW);
    }

    loadCircuit(0);

    function steerFill(value: float, color: string) -> string {
        var w = value * 50.0;
        if (w < -50.0) {
            w = -50.0;
        }
        if (w > 50.0) {
            w = 50.0;
        }
        if (w < 0.0) {
            return "<i style='left:" + string(50.0 + w) + "%;width:" + string(-w) + "%;background:" + color + "'></i>";
        }
        return "<i style='left:50%;width:" + string(w) + "%;background:" + color + "'></i>";
    }

    function thrFill(value: float, color: string) -> string {
        var w = value * 100.0;
        if (w < 0.0) {
            w = 0.0;
        }
        if (w > 100.0) {
            w = 100.0;
        }
        return "<i style='left:0;width:" + string(w) + "%;background:" + color + "'></i>";
    }

    function sparkline() -> string {
        if (lossHist.length < 2) {
            return "<svg viewBox='0 0 280 44'></svg>";
        }
        var maxL = 0.08;
        var hi = 0;
        while (hi < lossHist.length) {
            if (lossHist[hi] > maxL) {
                maxL = lossHist[hi];
            }
            hi = hi + 1;
        }
        var slot = 280.0 / lossHist.length;
        var pts = "";
        var p = 0;
        while (p < lossHist.length) {
            var x = p * slot;
            var y = 40.0 - (lossHist[p] / maxL) * 36.0;
            if (p > 0) {
                pts = pts + " ";
            }
            pts = pts + string(int(x * 10.0) / 10.0) + "," + string(int(y * 10.0) / 10.0);
            p = p + 1;
        }
        return "<svg viewBox='0 0 280 44' preserveAspectRatio='none'><polyline points='" + pts + "' fill='none' stroke='#7dface' stroke-width='1.6'/></svg>";
    }

    function miniNet() -> string {
        var svg = "<svg viewBox='0 0 96 72' width='96' height='72'>";
        var h = 0;
        while (h < 5) {
            var act = 0.5;
            if (lastHidden.length > h * 4) {
                act = (lastHidden[h * 4] + 1.0) * 0.5;
            }
            if (act < 0.0) {
                act = 0.0;
            }
            if (act > 1.0) {
                act = 1.0;
            }
            var y = 8.0 + h * 14.0;
            var r = 3.5 + act * 2.2;
            var fade = string(int((0.35 + act * 0.5) * 100.0) / 100.0);
            svg = svg + "<line x1='8' y1='36' x2='48' y2='" + string(y) + "' stroke='#7dface' stroke-opacity='" + fade + "'/>";
            svg = svg + "<line x1='48' y1='" + string(y) + "' x2='88' y2='22' stroke='#7dface' stroke-opacity='" + fade + "'/>";
            svg = svg + "<line x1='48' y1='" + string(y) + "' x2='88' y2='50' stroke='#7dface' stroke-opacity='" + fade + "'/>";
            svg = svg + "<circle cx='48' cy='" + string(y) + "' r='" + string(int(r * 10.0) / 10.0) + "' fill='#1f8f72'/>";
            h = h + 1;
        }
        svg = svg + "<circle cx='8' cy='36' r='4' fill='#e6c56a'/>";
        svg = svg + "<circle cx='88' cy='22' r='4' fill='#f4f1ea'/>";
        svg = svg + "<circle cx='88' cy='50' r='4' fill='#9ad7ff'/>";
        svg = svg + "</svg>";
        return svg;
    }

    function refreshHud() {
        var spec = circuits[circuitIndex];
        var kmText = string(math.round(spec.km * 1000.0) / 1000.0);
        var status = "LEARNING";
        var statusColor = "#f0d78c";
        var share = shareNow();
        if (paused) {
            status = "PAUSED";
            statusColor = "#f0d78c";
        } else if (manualDrive) {
            status = "YOU DRIVE";
            statusColor = "#9ad7ff";
        } else if (brainMode == "net") {
            status = "NETWORK";
            statusColor = "#7dface";
        } else if (brainMode == "coach") {
            status = "COACH";
            statusColor = "#f0d78c";
        } else if (share > 0.85) {
            status = "NET IN CONTROL";
            statusColor = "#7dface";
        }
        var leader = leadCar;
        if (order.length > 0) {
            leader = order[0];
        }
        var show = leader;
        if (manualDrive) {
            show = 0;
        }
        var speedDiv = 150.0 * worldScale;
        if (speedDiv < 0.001) {
            speedDiv = 1.0;
        }
        var kmh = int((carV[show] / speedDiv) * 325.0);
        var lapNo = carLap[show];
        if (lapNo < 1) {
            lapNo = 1;
        }
        var lastText = "--:--.---";
        if (carLast[show] >= 0.0) {
            lastText = formatTime(carLast[show]);
        }
        var sharePct = int(share * 100.0);
        var html = "<div class='top'><span class='kicker'>GRAND PRIX</span><span class='status' style='color:" + statusColor + "'>" + status + "</span></div>";
        html = html + "<h2>" + spec.name + "</h2>";
        html = html + "<div class='sub'>" + spec.place + "   " + kmText + " km</div>";
        html = html + "<div class='speed'>" + string(kmh) + "<span class='unit'>KM/H</span></div>";
        html = html + "<div class='row'><span>LAP  " + formatTime(carLapTime[show]) + "</span><span class='muted'>LAP " + string(lapNo) + "</span></div>";
        html = html + "<div class='row'><span class='best'>BEST  " + formatTime(sessionBest) + "</span><span class='dim'>LAST  " + lastText + "</span></div>";
        html = html + "<div class='label'><span>NEURAL SHARE</span><span class='netc'>" + string(sharePct) + "%</span></div>";
        html = html + "<div class='share'><i style='width:" + string(sharePct) + "%'></i></div>";
        html = html + "<div class='bars'><span></span><span class='coach'>coach</span><span class='netc'>net</span>";
        html = html + "<span>steer</span><span class='track'>" + steerFill(lastSteerCoach, "#e6c56a") + "</span><span class='track'>" + steerFill(lastSteerNet, "#7dface") + "</span>";
        html = html + "<span>throttle</span><span class='track'>" + thrFill(lastThrCoach, "#e6c56a") + "</span><span class='track'>" + thrFill(lastThrNet, "#7dface") + "</span></div>";
        html = html + "<div class='netrow'>" + miniNet() + "</div>";
        html = html + "<div class='label'><span>LOSS</span><span>" + string(int(shownLoss * 1000.0) / 1000.0) + "</span></div>";
        html = html + "<div class='lossbox'>" + sparkline() + "</div>";
        html = html + "<div class='label'><span>ORDER</span><span></span></div><div class='order'>";
        var leaderProg = carLap[leader] * totalLen + carS[leader];
        var rank = 0;
        while (rank < order.length) {
            var ci = order[rank];
            var gap = "leader";
            if (rank > 0) {
                var prog = carLap[ci] * totalLen + carS[ci];
                var behind = leaderProg - prog;
                var gapDiv = 120.0 * worldScale;
                if (gapDiv < 0.001) {
                    gapDiv = 1.0;
                }
                var gapSec = behind / gapDiv;
                if (carLap[leader] > carLap[ci] && behind > totalLen * 0.5) {
                    gap = "+" + string(carLap[leader] - carLap[ci]) + " LAP";
                } else {
                    gap = "+" + string(int(gapSec * 100.0) / 100.0);
                }
            }
            var tag = string(rank + 1);
            if (manualDrive && ci == 0) {
                tag = tag + "  YOU";
            }
            var ink = "#b8b8b8";
            if (ci >= 0 && ci < carColors.length) {
                ink = carColors[ci];
            }
            html = html + "<div><i class='dot' style='background:" + ink + "'></i><span>" + tag + "</span><span class='gap'>" + gap + "</span></div>";
            rank = rank + 1;
        }
        html = html + "</div><div class='chips'>";
        var bi = 0;
        while (bi < circuits.length) {
            var shortName = circuits[bi].name;
            if (shortName == "Spa-Francorchamps") {
                shortName = "Spa";
            }
            if (bi == circuitIndex) {
                html = html + "<span class='on'>" + shortName + "</span>";
            } else {
                html = html + "<span>" + shortName + "</span>";
            }
            bi = bi + 1;
        }
        html = html + "</div>";
        html = html + "<div class='keys'>Q E circuit &nbsp; C camera &nbsp; Tab drive<br>N net &nbsp; T coach &nbsp; L blend &nbsp; R reset &nbsp; Space pause</div>";
        dom.html(hud, html);
    }

    function update(dtMs) {
        var dt = dtMs;
        if (dt > 50) {
            dt = 50;
        }
        var dtSec = dt / 1000.0;

        var qDown = three.isKeyDown("q");
        if (qDown && !qWasDown) {
            loadCircuit(circuitIndex - 1);
        }
        qWasDown = qDown;

        var eDown = three.isKeyDown("e");
        if (eDown && !eWasDown) {
            loadCircuit(circuitIndex + 1);
        }
        eWasDown = eDown;

        var cDown = three.isKeyDown("c");
        if (cDown && !cWasDown) {
            chaseMode = !chaseMode;
        }
        cWasDown = cDown;

        var nDown = three.isKeyDown("n");
        if (nDown && !nWasDown) {
            brainMode = "net";
        }
        nWasDown = nDown;

        var tDown = three.isKeyDown("t");
        if (tDown && !tWasDown) {
            brainMode = "coach";
        }
        tWasDown = tDown;

        var lDown = three.isKeyDown("l");
        if (lDown && !lWasDown) {
            brainMode = "blend";
        }
        lWasDown = lDown;

        var rDown = three.isKeyDown("r");
        if (rDown && !rWasDown) {
            resetBrain();
        }
        rWasDown = rDown;

        var spaceDown = three.isKeyDown(" ");
        if (spaceDown && !spaceWasDown) {
            paused = !paused;
        }
        spaceWasDown = spaceDown;

        var tabDown = three.isKeyDown("tab");
        if (tabDown && !tabWasDown) {
            manualDrive = !manualDrive;
        }
        tabWasDown = tabDown;

        if (!paused) {
            hudCar = leadCar;
            if (manualDrive) {
                hudCar = 0;
            }
            var i = 0;
            while (i < carCount) {
                updateCar(i, dtSec);
                i = i + 1;
            }
            separateCars();
            updateLead();
            shownLoss = shownLoss * 0.97 + lastLoss * 0.03;
            trainTick = trainTick + 1;
            if (trainTick >= 4) {
                trainTick = 0;
                imitate();
            }
        }

        var cam = updateCamera();
        three.setUniform(material, "uCamPos", [cam.camX, cam.camY, cam.camZ]);
        three.setUniform(material, "uCamForward", [cam.forwardX, cam.forwardY, cam.forwardZ]);
        three.setUniform(material, "uCamRight", [cam.rightX, cam.rightY, cam.rightZ]);
        three.setUniform(material, "uCamUp", [cam.upX, cam.upY, cam.upZ]);
        lightX = focusX + trackSpan * 0.45;
        lightY = trackSpan * 0.9;
        lightZ = focusZ + trackSpan * 0.22;
        three.setUniform(material, "uLightPos", [lightX, lightY, lightZ]);
        three.setUniform(material, "uTrackW", trackW);
        three.setUniform(material, "uCar0", [carX[0], 0, carZ[0]]);
        three.setUniform(material, "uCar1", [carX[1], 0, carZ[1]]);
        three.setUniform(material, "uCar2", [carX[2], 0, carZ[2]]);
        three.setUniform(material, "uCar3", [carX[3], 0, carZ[3]]);
        three.setUniform(material, "uCar4", [carX[4], 0, carZ[4]]);
        three.setUniform(material, "uCar5", [carX[5], 0, carZ[5]]);
        three.setUniform(material, "uCar6", [carX[6], 0, carZ[6]]);
        three.setUniform(material, "uCar7", [carX[7], 0, carZ[7]]);
        three.setUniform(material, "uAngle0", carH[0]);
        three.setUniform(material, "uAngle1", carH[1]);
        three.setUniform(material, "uAngle2", carH[2]);
        three.setUniform(material, "uAngle3", carH[3]);
        three.setUniform(material, "uAngle4", carH[4]);
        three.setUniform(material, "uAngle5", carH[5]);
        three.setUniform(material, "uAngle6", carH[6]);
        three.setUniform(material, "uAngle7", carH[7]);
        refreshHud();
    }

    function render() {
        three.render(renderer, scene, camera);
    }

    three.start(update, render);
}
