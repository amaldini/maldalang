// Grand Prix 3D Neural Race with GPU Ray Tracing
// Run: malda play Examples/Games/three_shader_race_car_neural.malda
//
// Eight cars share a 12-20-2 net (tanh, tanh), the same coach as
// grand_prix_neural.malda. The centerline is smoothed and resampled the same
// way, then scaled so the road half-width is 3.2. Speeds and turn rate scale
// with that road, so the coach's steering still points back to the racing line.
// The ground shader reads the same polyline from a float texture.
//
// Q/E change circuit. C chase camera. N network only. T coach only.
// L blend mode. R reset brain. Space pause. Tab manual drive (WASD/arrows).
// A side panel matches the 2D grand prix HUD: speed, laps, neural share, and order.
// Car contact uses the billiards equal-mass impulse (restitution 0.5). Speed
// stays on the nose; a glancing hit adds a small yaw.

function wrapAngle(a: float) -> float {
    var turns = math.floor((a + 3.14159265) / 6.2831853);
    return a - turns * 6.2831853;
}

function wrapIndex(i: int, n: int) -> int {
    if (n < 1) {
        return 0;
    }
    var k = i % n;
    if (k < 0) {
        k = k + n;
    }
    return k;
}

function formatTime(seconds: float) -> string {
    if (seconds < 0.0) {
        return "--:--.---";
    }
    var mins = int(seconds / 60.0);
    var rem = seconds - mins * 60.0;
    var whole = int(rem);
    var ms = int((rem - whole) * 1000.0);
    if (ms < 0) {
        ms = 0;
    }
    if (ms > 999) {
        ms = 999;
    }
    return string(mins) + ":" + str.padStart(string(whole), 2, "0") + "." + str.padStart(string(ms), 3, "0");
}

