// Infinite Mandelbrot zoom: BigInt reference orbit on the host, perturbation
// kernel in @shader() → GLSL. The GPU never adds the pixel offset to the
// high-precision center, so the dive stays sharp past float32 ulp.
//
// Compile:
//   malda compile Examples/Games/three_shader_mandelbrot.malda --mode js -o Examples/Games/three_shader_mandelbrot.js

@shader()
function vertexMain() {
    vUv = uv;
    gl_Position = vec4(position.xy, 0.0, 1.0);
}

@shader()
function cMul(a: vec2, b: vec2) -> vec2 {
    return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}

@shader()
function palette(t: float) -> vec3 {
    return vec3(0.52, 0.42, 0.38)
        + vec3(0.48, 0.50, 0.55)
        * cos(vec3(0.15, 0.85, 1.35) + vec3(0.95, 1.20, 1.55) * t);
}

@shader()
function fragmentMain() {
    var fragCoord: vec2 = vUv * uResolution;
    var p: vec2 = (fragCoord - 0.5 * uResolution) / uResolution.y;
    var w: vec2 = vec2(0.0, 0.0);
    var i: float = 0.0;
    var escaped: float = 0.0;
    var smoothIter: float = 0.0;
    var mag: float = 0.0;

    while (i < 400.0) {
        var zn: vec4 = texture2D(uOrbit, vec2((i + 0.5) / uOrbitLen, 0.5));
        var wSq: vec2 = cMul(w, w);
        w = cMul(zn.xy, w) * 2.0 + wSq * uScale + p;
        i = i + 1.0;
        var znp: vec4 = texture2D(uOrbit, vec2((i + 0.5) / uOrbitLen, 0.5));
        var z: vec2 = znp.xy + w * uScale;
        mag = dot(z, z);
        if (mag > 1.0e20) {
            mag = 1.0e20;
        }
        if (mag > 16.0 || znp.z < 0.5) {
            escaped = 1.0;
            smoothIter = i - log(log(max(mag, 16.0))) / log(2.0);
            break;
        }
    }

    var color: vec3 = vec3(0.015, 0.01, 0.04);
    if (escaped > 0.5) {
        color = palette(smoothIter * 0.085) * (0.55 + 0.45 * fract(smoothIter * 0.08));
    }
    gl_FragColor = vec4(color, 1.0);
}

var vertexShader = glsl.compile({
    varyings: ["vec2 vUv"],
    functions: ["vertexMain"],
    main: "vertexMain"
});

var fragmentShader = glsl.compile({
    varyings: ["vec2 vUv"],
    uniforms: [
        "vec2 uResolution",
        "float uScale",
        "float uOrbitLen",
        "sampler2D uOrbit"
    ],
    functions: ["cMul", "palette", "fragmentMain"],
    main: "fragmentMain"
});

var root = dom.query("#app");

if (root == null) {
    io.print("No #app container found.");
} else {
    dom.clear(root);

    var heading = dom.create("h1");
    dom.setText(heading, "MALDA Infinite Mandelbrot Zoom");
    dom.append(root, heading);

    var hint = dom.create("p");
    dom.setText(hint, "Host BigInt reference orbit + GPU perturbation via @shader(). Exponential zoom into Seahorse Valley; wraps after 32 decades. Hold Space to pause. [ ] change speed.");
    dom.append(root, hint);

    var zoomLabel = dom.create("p");
    dom.setText(zoomLabel, "depth 10^-0");
    dom.append(root, zoomLabel);

    var width = 960;
    var height = 540;
    var maxIter = 400;
    var orbit = three.mandelbrotOrbit(
        "-0.743643887037158704752191506114774",
        "0.131825904205311970493132056385139",
        maxIter
    );

    var renderer = three.createRenderer(width, height, "#app");
    three.setClearColor(renderer, "#020617");
    three.setRendererSize(renderer, width, height);

    var scene = three.createScene();
    var camera = three.createOrthographicCamera(-1, 1, 1, -1, 0, 1);

    var material = three.createShaderMaterial({
        "vertexShader": vertexShader,
        "fragmentShader": fragmentShader,
        "depthWrite": false,
        "uniforms": {
            "uResolution": [width, height],
            "uScale": 2.55,
            "uOrbitLen": maxIter + 1,
            "uOrbit": orbit
        }
    });

    var quad = three.createMesh(three.createPlaneGeometry(2, 2), material);
    three.add(scene, quad);

    var decades = 0.0;
    var speedMul = 1.0;
    var wrapDecades = 32.0;
    var zoomPerSecond = 0.55;
    var startScale = 2.55;

    function update(dtMs) {
        var dt = dtMs;
        if (dt > 50) {
            dt = 50;
        }
        var step = dt / 1000;

        if (three.isKeyDown("]")) {
            speedMul = speedMul + (0.7 * step);
        }
        if (three.isKeyDown("[")) {
            speedMul = speedMul - (0.7 * step);
        }
        if (speedMul < 0.2) {
            speedMul = 0.2;
        }
        if (speedMul > 3.0) {
            speedMul = 3.0;
        }

        if (!three.isKeyDown(" ")) {
            decades = decades + (step * speedMul * zoomPerSecond);
        }

        var wrapped = decades - math.floor(decades / wrapDecades) * wrapDecades;
        var scale = startScale * math.pow(10.0, -wrapped);
        three.setUniform(material, "uScale", scale);

        var shown = int(wrapped * 10.0) / 10.0;
        dom.setText(zoomLabel, "depth 10^-" + string(shown) + "  speed x" + string(int(speedMul * 10.0) / 10.0));
    }

    function render() {
        three.render(renderer, scene, camera);
    }

    three.start(update, render);
}
