var root = dom.query("#app");

if (root == null) {
    println("No #app container found.");
} else {
    dom.clear(root);

    var title = dom.create("h1");
    dom.setText(title, "MALDA Game: Sprite smoke");
    dom.append(root, title);

    var hint = dom.create("p");
    dom.setText(hint, "Arrows pan. [ / - zoom out, ] / = zoom in, 0 resets zoom. Green and magenta tiles come from a PNG atlas. The extra pair is drawImageEx: spin + flipX around the dest center, with multiply tint and tintFill flash. Click places a marker; the marker glow uses setBlend add. HUD uses measureText; the marker ring is strokeCircle.");
    dom.append(root, hint);

    var tiles = game.loadImage("assets/sprite_tiles.png");
    var camX = 0.0;
    var camY = 0.0;
    var camZoom = 1.0;
    var camSpeed = 140;
    var spin = 0.0;
    var markX = 320.0;
    var markY = 180.0;

    function update(dtMs) {
        var step = (camSpeed * dtMs) / 1000;
        if (game.isKeyDown("arrowleft")) {
            camX = camX - step;
        }
        if (game.isKeyDown("arrowright")) {
            camX = camX + step;
        }
        if (game.isKeyDown("arrowup")) {
            camY = camY - step;
        }
        if (game.isKeyDown("arrowdown")) {
            camY = camY + step;
        }
        if (game.wasKeyPressed("]") || game.wasKeyPressed("=")) {
            camZoom = camZoom * 1.15;
        }
        if (game.wasKeyPressed("[") || game.wasKeyPressed("-")) {
            camZoom = camZoom / 1.15;
        }
        if (game.wasKeyPressed("0")) {
            camZoom = 1.0;
        }
        spin = spin + ((dtMs / 1000) * 1.4);
        game.setCamera(camX, camY);
        game.setCameraZoom(camZoom);
        camZoom = game.getCameraZoom();
        if (game.wasMousePressed(0)) {
            markX = game.getMouseWorldX();
            markY = game.getMouseWorldY();
        }
    }

    function render() {
        game.clear();

        if (game.imageIsReady(tiles)) {
            game.drawImageRect(tiles, 0, 0, 16, 16, 40, 80, 64, 64);
            game.drawImageRect(tiles, 16, 0, 16, 16, 120, 80, 64, 64);
            game.drawImage(tiles, 220, 96, 64, 32);
            game.drawImageEx(tiles, 400, 112, {
                "sx": 0,
                "sy": 0,
                "sw": 16,
                "sh": 16,
                "w": 64,
                "h": 64,
                "ox": 32,
                "oy": 32,
                "angle": spin,
                "tint": "#ff6644"
            });
            game.drawImageEx(tiles, 500, 112, {
                "sx": 16,
                "sy": 0,
                "sw": 16,
                "sh": 16,
                "w": 64,
                "h": 64,
                "ox": 32,
                "oy": 32,
                "flipX": true,
                "tint": "#ffffff",
                "tintFill": true
            });
        } else {
            game.fillRect(40, 80, 64, 64, "#334455");
        }

        game.setAlpha(0.55);
        game.strokeRect(32, 64, 260, 112, "#88ffcc", 3);
        game.setAlpha(1);
        game.drawLine(32, 200, 292, 200, "#ffcc66", 2);
        game.setBlend("add");
        game.fillCircle(markX, markY, 16, "#ffee88");
        game.setBlend("alpha");
        game.fillCircle(markX, markY, 6, "#ff88aa");
        game.strokeCircle(markX, markY, 10, "#ff88aa", 2);
        game.setBlend("multiply");
        game.fillRect(32, 220, 88, 36, "#4466aa");
        game.setBlend("alpha");
        var center = game.screenToWorld(320, 180);
        game.fillCircle(center.x, center.y, 8, "#66ccff");

        game.pushCamera();
        game.setCamera(0, 0);
        game.setCameraZoom(1);
        var status = "loading tiles";
        if (game.imageIsReady(tiles)) {
            status = "atlas " + string(game.imageWidth(tiles)) + "x" + string(game.imageHeight(tiles));
        }
        var hud = status + "  cam " + string(int(camX)) + "," + string(int(camY)) + "  z " + string(camZoom) + "  " + string(game.getCanvasWidth()) + "x" + string(game.getCanvasHeight());
        var metrics = game.measureText(hud, "14px monospace");
        game.strokeRect(8, 8, metrics.width + 8, 22, "#334155", 1);
        game.drawText(hud, 12, 24, "#ffffff", "14px monospace");
        game.drawText("Arrows pan. [ ] zoom. Click world marker. Spin tint, flip tintFill, add glow, multiply strip.", 12, 44, "#99ddee", "12px monospace");
        game.popCamera();
    }

    game.createCanvas(640, 360, "#app");
    game.setPixelated(true);
    game.setBackground("#151b24");
    game.start(update, render);
}
