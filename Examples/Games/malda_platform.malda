var root = dom.query("#app");

if (root == null) {
    println("No #app container found.");
} else {
    dom.clear(root);

    var title = dom.create("h1");
    dom.setText(title, "MALDA Game: Platform");
    dom.append(root, title);

    var hint = dom.create("p");
    dom.setText(hint, "Arrows run. Space or Up jumps. Camera follows. R restarts. Click or a key unlocks jump/coin SFX.");
    dom.append(root, hint);

    var canvasW = 640;
    var canvasH = 360;
    var worldW = 1600;

    var tiles = game.loadImage("assets/platform_tiles.png");
    var tileSize = 32;

    var playerW = 18.0;
    var playerH = 26.0;
    var runSpeed = 210;
    var jumpSpeed = -430;
    var gravity = 1150;
    var maxFall = 540;

    var playerX = 48.0;
    var playerY = 286.0;
    var vy = 0.0;
    var onGround = false;
    var facingLeft = false;

    var plats = [
        { "x": 0, "y": 312, "w": 1600, "h": 48 },
        { "x": 200, "y": 240, "w": 140, "h": 24 },
        { "x": 430, "y": 186, "w": 150, "h": 24 },
        { "x": 700, "y": 228, "w": 170, "h": 24 },
        { "x": 980, "y": 164, "w": 140, "h": 24 },
        { "x": 1280, "y": 248, "w": 180, "h": 24 }
    ];

    var coinX = [248, 486, 760, 1028, 1348];
    var coinY = [216, 162, 204, 140, 224];
    var coinGot = [false, false, false, false, false];
    var coinSize = 16.0;

    var coins = 0;
    var high = 0;
    var audioBooted = false;
    var coinSpin = 0.0;
    var moving = false;
    var walkMs = 0.0;
    var flashMs = 0.0;
    var sparkMs = 0.0;
    var sparkX = 0.0;
    var sparkY = 0.0;
    var autoplay = dom.query("#malda-autoplay") != null;
    var demoJumpAt = [115.0, 305.0, 520.0, 820.0, 1080.0, 1320.0];
    var demoJumpIndex = 0;

    var loaded = game.load("platform_high");
    if (loaded != null) {
        high = loaded;
    }

    function resetRun() {
        playerX = 48.0;
        playerY = 286.0;
        vy = 0.0;
        onGround = false;
        facingLeft = false;
        coins = 0;
        flashMs = 0.0;
        sparkMs = 0.0;
        demoJumpIndex = 0;
        var i = 0;
        while (i < coinGot.length) {
            coinGot[i] = false;
            i = i + 1;
        }
    }

    function tryStartAudio() {
        if (!audioBooted) {
            game.audioInit();
            audioBooted = true;
            game.audioSetMasterVolume(0.65);
        }
    }

    function updateGame(dtMs) {
        if (game.wasKeyPressed("r")) {
            resetRun();
        }

        if (autoplay && (game.isKeyDown("arrowleft") || game.isKeyDown("arrowright") || game.wasKeyPressed(" ") || game.wasKeyPressed("arrowup"))) {
            autoplay = false;
        }

        if (game.isKeyDown("arrowleft") ||
            game.isKeyDown("arrowright") ||
            game.wasKeyPressed(" ") ||
            game.wasKeyPressed("arrowup") ||
            game.isMouseDown(0)) {
            tryStartAudio();
        }

        var goLeft = game.isKeyDown("arrowleft");
        var goRight = game.isKeyDown("arrowright");
        var jump = game.wasKeyPressed(" ") || game.wasKeyPressed("arrowup");
        if (autoplay) {
            goRight = true;
            if (onGround && demoJumpIndex < demoJumpAt.length && playerX >= demoJumpAt[demoJumpIndex]) {
                jump = true;
                demoJumpIndex = demoJumpIndex + 1;
            }
            if (playerX > 1500) {
                resetRun();
            }
        }

        var dx = 0.0;
        var step = (runSpeed * dtMs) / 1000;
        if (goLeft) {
            dx = dx - step;
            facingLeft = true;
        }
        if (goRight) {
            dx = dx + step;
            facingLeft = false;
        }
        moving = goLeft || goRight;
        if (moving) {
            walkMs = walkMs + dtMs;
        } else {
            walkMs = 0.0;
        }
        coinSpin = coinSpin + ((dtMs / 1000) * 2.4);
        if (flashMs > 0) {
            flashMs = flashMs - dtMs;
        }
        if (sparkMs > 0) {
            sparkMs = sparkMs - dtMs;
        }

        if (onGround && jump) {
            vy = jumpSpeed;
            onGround = false;
            game.audioPlaySample("assets/beep_hi.wav", 0.8);
        }

        vy = vy + ((gravity * dtMs) / 1000);
        if (vy > maxFall) {
            vy = maxFall;
        }
        var dy = (vy * dtMs) / 1000;

        var movedX = game.sweepRects(playerX, playerY, playerW, playerH, dx, 0, plats);
        playerX = movedX.x;
        if (playerX < 0) {
            playerX = 0;
        }
        if (playerX + playerW > worldW) {
            playerX = worldW - playerW;
        }

        var movedY = game.sweepRects(playerX, playerY, playerW, playerH, 0, dy, plats);
        playerY = movedY.y;
        onGround = false;
        if (movedY.hit) {
            if (movedY.ny < 0) {
                onGround = true;
                vy = 0;
            }
            if (movedY.ny > 0) {
                vy = 0;
            }
        }

        var c = 0;
        while (c < coinX.length) {
            if (!coinGot[c]) {
                if (game.overlapRect(playerX, playerY, playerW, playerH, coinX[c], coinY[c], coinSize, coinSize)) {
                    coinGot[c] = true;
                    coins = coins + 1;
                    flashMs = 140;
                    sparkMs = 220;
                    sparkX = coinX[c] + (coinSize / 2);
                    sparkY = coinY[c] + (coinSize / 2);
                    game.audioPlaySample("assets/beep_lo.wav", 0.85);
                    if (coins > high && !autoplay) {
                        high = coins;
                        game.save("platform_high", high);
                    }
                }
            }
            c = c + 1;
        }
    }

    function drawBackdrop() {
        var scroll = game.getCameraX();
        game.pushCamera();
        game.setCamera(0, 0);
        game.setCameraZoom(1);
        game.fillRect(0, 0, canvasW, 150, "#16324d");
        game.fillRect(0, 150, canvasW, 90, "#1e4468");
        game.fillRect(0, 240, canvasW, 120, "#2a5d86");
        game.fillCircle(520, 58, 26, "#f6d98a");
        game.fillCircle(512, 52, 10, "#fff6c8");
        var i = 0;
        while (i < 4) {
            var cloud = (i * 210) - (scroll * 0.12);
            while (cloud < -80) {
                cloud = cloud + 840;
            }
            while (cloud > canvasW) {
                cloud = cloud - 840;
            }
            var cy = 34 + ((i % 2) * 26);
            game.fillCircle(cloud, cy, 16, "#e7eef6");
            game.fillCircle(cloud + 18, cy + 4, 12, "#e7eef6");
            game.fillCircle(cloud - 16, cy + 6, 10, "#e7eef6");
            i = i + 1;
        }
        var h = 0;
        while (h < 6) {
            var hx = (h * 180) - (scroll * 0.35);
            while (hx < -140) {
                hx = hx + 1080;
            }
            game.fillCircle(hx, 292, 86, "#1b4034");
            game.fillCircle(hx + 64, 310, 64, "#143028");
            h = h + 1;
        }
        game.popCamera();
    }

    function drawPlatform(x, y, w, h) {
        if (!game.imageIsReady(tiles)) {
            game.fillRect(x, y, w, h, "#6b4428");
            game.fillRect(x, y, w, 8, "#4ade80");
            return;
        }
        var col = 0;
        while (col < w) {
            var dw = tileSize;
            if (col + dw > w) {
                dw = w - col;
            }
            var sw = 16;
            if (dw < tileSize) {
                sw = int((dw * 16) / tileSize);
                if (sw < 1) {
                    sw = 1;
                }
            }
            var row = 0;
            while (row < h) {
                var dh = tileSize;
                if (row + dh > h) {
                    dh = h - row;
                }
                var sh = 16;
                if (dh < tileSize) {
                    sh = int((dh * 16) / tileSize);
                    if (sh < 1) {
                        sh = 1;
                    }
                }
                game.drawImageRect(tiles, 0, 0, sw, sh, x + col, y + row, dw, dh);
                row = row + tileSize;
            }
            var cap = 14;
            if (cap > h) {
                cap = h;
            }
            var capSrc = int((cap * 16) / tileSize);
            if (capSrc < 1) {
                capSrc = 1;
            }
            if (capSrc > 8) {
                capSrc = 8;
            }
            var grassSx = 16;
            var colIndex = int((x + col) / tileSize);
            if ((colIndex % 2) == 1) {
                grassSx = 32;
            }
            game.drawImageRect(tiles, grassSx, 0, sw, capSrc, x + col, y, dw, cap);
            col = col + tileSize;
        }
        if (h > 4) {
            game.fillRect(x, y + h - 3, w, 3, "#3a2416");
        }
    }

    function renderGame() {
        game.clear();

        game.followCamera(playerX, playerY, canvasW, canvasH, worldW, canvasH, {
            "screenX": 280,
            "snap": true
        });
        drawBackdrop();

        var p = 0;
        while (p < plats.length) {
            drawPlatform(plats[p].x, plats[p].y, plats[p].w, plats[p].h);
            p = p + 1;
        }

        var c = 0;
        while (c < coinX.length) {
            if (!coinGot[c]) {
                if (game.imageIsReady(tiles)) {
                    game.drawImageEx(tiles, coinX[c] + (coinSize / 2), coinY[c] + (coinSize / 2), {
                        "sx": 48,
                        "sy": 0,
                        "sw": 16,
                        "sh": 16,
                        "w": 22,
                        "h": 22,
                        "ox": 11,
                        "oy": 11,
                        "angle": coinSpin
                    });
                } else {
                    game.fillCircle(coinX[c] + 8, coinY[c] + 8, 8, "#fbbf24");
                }
            }
            c = c + 1;
        }

        if (game.imageIsReady(tiles)) {
            var playerSx = 64;
            if (!onGround || (moving && (int(walkMs / 90) % 2) == 1)) {
                playerSx = 80;
            }
            var playerDraw = {
                "sx": playerSx,
                "sy": 0,
                "sw": 16,
                "sh": 16,
                "w": 32,
                "h": 32,
                "ox": 16,
                "oy": 28,
                "flipX": facingLeft
            };
            if (flashMs > 0) {
                playerDraw["tint"] = "#ffffff";
                playerDraw["tintFill"] = true;
            }
            game.drawImageEx(tiles, playerX + (playerW / 2), playerY + playerH, playerDraw);
        } else {
            game.fillRect(playerX, playerY, playerW, playerH, "#66ccff");
        }

        if (sparkMs > 0) {
            game.setBlend("add");
            game.fillCircle(sparkX, sparkY, 10 + ((220 - sparkMs) / 18), "#ffee88");
            game.setBlend("alpha");
        }

        game.pushCamera();
        game.setCamera(0, 0);
        game.setCameraZoom(1);
        game.setAlpha(0.78);
        game.fillRect(0, 0, canvasW, 58, "#0b1c2e");
        game.setAlpha(1);
        game.drawText("Coins: " + string(coins) + "/" + string(coinX.length) + "  High: " + string(high), 16, 26, "#ffffff", "14px monospace");
        if (coins >= coinX.length) {
            game.drawText("All coins! Press R to restart.", 12, 46, "#ffee88", "14px monospace");
        } else {
            if (autoplay) {
                game.drawText("Autoplay", 12, 46, "#99ddee", "12px monospace");
            } else {
                game.drawText("Arrows run  Space/Up jump  R restart", 12, 46, "#99ddee", "12px monospace");
            }
        }
        game.popCamera();
    }

    game.createCanvas(canvasW, canvasH, "#app");
    game.setPixelated(true);
    game.setBackground("#16324d");
    game.startFixed(updateGame, renderGame);
}
