var root = dom.query("#app");

if (root == null) {
    println("No #app container found.");
} else {
    dom.clear(root);

    var title = dom.create("h1");
    dom.setText(title, "MALDA Game: Platform");
    dom.append(root, title);

    var hint = dom.create("p");
    dom.setText(hint, "Arrows run. Space or Up jumps. Camera follows. Green tiles are ground; magenta tiles are coins. R restarts. Click or a key unlocks jump/coin SFX.");
    dom.append(root, hint);

    var canvasW = 640;
    var canvasH = 360;
    var worldW = 1600;

    var tiles = game.loadImage("assets/sprite_tiles.png");
    var tileSize = 32;

    var playerW = 18.0;
    var playerH = 26.0;
    var runSpeed = 210;
    var jumpSpeed = -430;
    var gravity = 1150;
    var maxFall = 540;

    var playerX = 48.0;
    var playerY = 286.0;
    var vy = 0.0;
    var onGround = false;
    var facingLeft = false;

    var plats = [
        { "x": 0, "y": 312, "w": 1600, "h": 48 },
        { "x": 200, "y": 240, "w": 140, "h": 24 },
        { "x": 430, "y": 186, "w": 150, "h": 24 },
        { "x": 700, "y": 228, "w": 170, "h": 24 },
        { "x": 980, "y": 164, "w": 140, "h": 24 },
        { "x": 1280, "y": 248, "w": 180, "h": 24 }
    ];

    var coinX = [248, 486, 760, 1028, 1348];
    var coinY = [216, 162, 204, 140, 224];
    var coinGot = [false, false, false, false, false];
    var coinSize = 16.0;

    var coins = 0;
    var high = 0;
    var audioBooted = false;
    var coinSpin = 0.0;
    var flashMs = 0.0;
    var sparkMs = 0.0;
    var sparkX = 0.0;
    var sparkY = 0.0;

    var loaded = game.load("platform_high");
    if (loaded != null) {
        high = loaded;
    }

    function resetRun() {
        playerX = 48.0;
        playerY = 286.0;
        vy = 0.0;
        onGround = false;
        facingLeft = false;
        coins = 0;
        flashMs = 0.0;
        sparkMs = 0.0;
        var i = 0;
        while (i < coinGot.length) {
            coinGot[i] = false;
            i = i + 1;
        }
    }

    function tryStartAudio() {
        if (!audioBooted) {
            game.audioInit();
            audioBooted = true;
            game.audioSetMasterVolume(0.65);
        }
    }

    function updateGame(dtMs) {
        if (game.wasKeyPressed("r")) {
            resetRun();
        }

        if (game.isKeyDown("arrowleft") ||
            game.isKeyDown("arrowright") ||
            game.wasKeyPressed(" ") ||
            game.wasKeyPressed("arrowup") ||
            game.isMouseDown(0)) {
            tryStartAudio();
        }

        var dx = 0.0;
        var step = (runSpeed * dtMs) / 1000;
        if (game.isKeyDown("arrowleft")) {
            dx = dx - step;
            facingLeft = true;
        }
        if (game.isKeyDown("arrowright")) {
            dx = dx + step;
            facingLeft = false;
        }
        coinSpin = coinSpin + ((dtMs / 1000) * 2.4);
        if (flashMs > 0) {
            flashMs = flashMs - dtMs;
        }
        if (sparkMs > 0) {
            sparkMs = sparkMs - dtMs;
        }

        if (onGround && (game.wasKeyPressed(" ") || game.wasKeyPressed("arrowup"))) {
            vy = jumpSpeed;
            onGround = false;
            game.audioPlaySample("assets/beep_hi.wav", 0.8);
        }

        vy = vy + ((gravity * dtMs) / 1000);
        if (vy > maxFall) {
            vy = maxFall;
        }
        var dy = (vy * dtMs) / 1000;

        var movedX = game.sweepRects(playerX, playerY, playerW, playerH, dx, 0, plats);
        playerX = movedX.x;
        if (playerX < 0) {
            playerX = 0;
        }
        if (playerX + playerW > worldW) {
            playerX = worldW - playerW;
        }

        var movedY = game.sweepRects(playerX, playerY, playerW, playerH, 0, dy, plats);
        playerY = movedY.y;
        onGround = false;
        if (movedY.hit) {
            if (movedY.ny < 0) {
                onGround = true;
                vy = 0;
            }
            if (movedY.ny > 0) {
                vy = 0;
            }
        }

        var c = 0;
        while (c < coinX.length) {
            if (!coinGot[c]) {
                if (game.overlapRect(playerX, playerY, playerW, playerH, coinX[c], coinY[c], coinSize, coinSize)) {
                    coinGot[c] = true;
                    coins = coins + 1;
                    flashMs = 140;
                    sparkMs = 220;
                    sparkX = coinX[c] + (coinSize / 2);
                    sparkY = coinY[c] + (coinSize / 2);
                    game.audioPlaySample("assets/beep_lo.wav", 0.85);
                    if (coins > high) {
                        high = coins;
                        game.save("platform_high", high);
                    }
                }
            }
            c = c + 1;
        }
    }

    function drawPlatform(x, y, w, h) {
        if (game.imageIsReady(tiles)) {
            var t = 0;
            while (t < w) {
                var tw = tileSize;
                if (t + tw > w) {
                    tw = w - t;
                }
                game.drawImageRect(tiles, 0, 0, 16, 16, x + t, y, tw, h);
                t = t + tileSize;
            }
        } else {
            game.fillRect(x, y, w, h, "#33aa55");
        }
    }

    function renderGame() {
        game.clear();

        game.followCamera(playerX, playerY, canvasW, canvasH, worldW, canvasH, {
            "screenX": 280,
            "snap": true
        });

        var p = 0;
        while (p < plats.length) {
            drawPlatform(plats[p].x, plats[p].y, plats[p].w, plats[p].h);
            p = p + 1;
        }

        var c = 0;
        while (c < coinX.length) {
            if (!coinGot[c]) {
                if (game.imageIsReady(tiles)) {
                    game.drawImageEx(tiles, coinX[c] + (coinSize / 2), coinY[c] + (coinSize / 2), {
                        "sx": 16,
                        "sy": 0,
                        "sw": 16,
                        "sh": 16,
                        "w": coinSize,
                        "h": coinSize,
                        "ox": coinSize / 2,
                        "oy": coinSize / 2,
                        "angle": coinSpin
                    });
                } else {
                    game.fillRect(coinX[c], coinY[c], coinSize, coinSize, "#ee66cc");
                }
            }
            c = c + 1;
        }

        if (game.imageIsReady(tiles)) {
            var playerDraw = {
                "sx": 0,
                "sy": 0,
                "sw": 16,
                "sh": 16,
                "w": playerW,
                "h": playerH,
                "ox": playerW / 2,
                "oy": playerH / 2,
                "flipX": facingLeft
            };
            if (flashMs > 0) {
                playerDraw["tint"] = "#ffffff";
                playerDraw["tintFill"] = true;
            }
            game.drawImageEx(tiles, playerX + (playerW / 2), playerY + (playerH / 2), playerDraw);
        } else {
            game.fillRect(playerX, playerY, playerW, playerH, "#66ccff");
        }

        if (sparkMs > 0) {
            game.setBlend("add");
            game.fillCircle(sparkX, sparkY, 10 + ((220 - sparkMs) / 18), "#ffee88");
            game.setBlend("alpha");
        }

        game.pushCamera();
        game.setCamera(0, 0);
        game.setCameraZoom(1);
        game.drawText("Coins: " + string(coins) + "/" + string(coinX.length) + "  High: " + string(high), 12, 24, "#ffffff", "14px monospace");
        if (coins >= coinX.length) {
            game.drawText("All coins! Press R to restart.", 12, 46, "#ffee88", "14px monospace");
        } else {
            game.drawText("Arrows run  Space/Up jump  R restart", 12, 46, "#99ddee", "12px monospace");
        }
        game.popCamera();
    }

    game.createCanvas(canvasW, canvasH, "#app");
    game.setBackground("#151b24");
    game.startFixed(updateGame, renderGame);
}
