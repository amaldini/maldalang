@shader()
function vertexMain() {
    vUv = uv;
    gl_Position = vec4(position.xy, 0.0, 1.0);
}

@shader()
function hitSphere(center: vec3, radius: float, origin: vec3, dir: vec3) -> float {
    var oc: vec3 = origin - center;
    var a: float = dot(dir, dir);
    var b: float = dot(oc, dir);
    var c: float = dot(oc, oc) - radius * radius;
    var disc: float = b * b - a * c;
    if (disc < 0.0) {
        return -1.0;
    }
    var root: float = sqrt(disc);
    var t: float = (-b - root) / a;
    if (t > EPSILON) {
        return t;
    }
    t = (-b + root) / a;
    if (t > EPSILON) {
        return t;
    }
    return -1.0;
}

@shader()
function hitBox(bmin: vec3, bmax: vec3, origin: vec3, dir: vec3) -> float {
    var inv: vec3 = vec3(1.0, 1.0, 1.0) / dir;
    var t0: vec3 = (bmin - origin) * inv;
    var t1: vec3 = (bmax - origin) * inv;
    var tmin: vec3 = min(t0, t1);
    var tmax: vec3 = max(t0, t1);
    var tEnter: float = max(max(tmin.x, tmin.y), tmin.z);
    var tExit: float = min(min(tmax.x, tmax.y), tmax.z);
    if (tExit < tEnter) {
        return -1.0;
    }
    if (tEnter > EPSILON) {
        return tEnter;
    }
    if (tExit > EPSILON) {
        return tExit;
    }
    return -1.0;
}

@shader()
function boxNormal(bmin: vec3, bmax: vec3, p: vec3) -> vec3 {
    var c: vec3 = (bmin + bmax) * 0.5;
    var d: vec3 = (p - c) / max(bmax - bmin, vec3(EPSILON, EPSILON, EPSILON));
    var ad: vec3 = abs(d);
    if (ad.x > ad.y && ad.x > ad.z) {
        return vec3(sign(d.x), 0.0, 0.0);
    }
    if (ad.y > ad.z) {
        return vec3(0.0, sign(d.y), 0.0);
    }
    return vec3(0.0, 0.0, sign(d.z));
}

@shader()
function hitBoxRotated(center: vec3, halfSize: vec3, angle: float, origin: vec3, dir: vec3) -> float {
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var o: vec3 = origin - center;
    var oLocal: vec3 = vec3(ca * o.x + sa * o.z, o.y, -sa * o.x + ca * o.z);
    var dLocal: vec3 = vec3(ca * dir.x + sa * dir.z, dir.y, -sa * dir.x + ca * dir.z);
    return hitBox(-halfSize, halfSize, oLocal, dLocal);
}

@shader()
function boxNormalRotated(center: vec3, halfSize: vec3, angle: float, p: vec3) -> vec3 {
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var o: vec3 = p - center;
    var pLocal: vec3 = vec3(ca * o.x + sa * o.z, o.y, -sa * o.x + ca * o.z);
    var nLocal: vec3 = boxNormal(-halfSize, halfSize, pLocal);
    return vec3(ca * nLocal.x - sa * nLocal.z, nLocal.y, sa * nLocal.x + ca * nLocal.z);
}

@shader()
function hitCylinder(center: vec3, radius: float, y0: float, y1: float, origin: vec3, dir: vec3) -> float {
    var ocx: float = origin.x - center.x;
    var ocz: float = origin.z - center.z;
    var a: float = dir.x * dir.x + dir.z * dir.z;
    var b: float = ocx * dir.x + ocz * dir.z;
    var c: float = ocx * ocx + ocz * ocz - radius * radius;
    var tBest: float = -1.0;
    if (abs(a) > EPSILON) {
        var disc: float = b * b - a * c;
        if (disc >= 0.0) {
            var root: float = sqrt(disc);
            var t: float = (-b - root) / a;
            var y: float = origin.y + dir.y * t;
            if (t > EPSILON && y >= y0 && y <= y1) {
                tBest = t;
            }
            t = (-b + root) / a;
            y = origin.y + dir.y * t;
            if (t > EPSILON && y >= y0 && y <= y1 && (tBest < 0.0 || t < tBest)) {
                tBest = t;
            }
        }
    }
    if (abs(dir.y) > EPSILON) {
        var tCap: float = (y0 - origin.y) / dir.y;
        var qx: float = origin.x + dir.x * tCap - center.x;
        var qz: float = origin.z + dir.z * tCap - center.z;
        if (tCap > EPSILON && qx * qx + qz * qz <= radius * radius && (tBest < 0.0 || tCap < tBest)) {
            tBest = tCap;
        }
        tCap = (y1 - origin.y) / dir.y;
        qx = origin.x + dir.x * tCap - center.x;
        qz = origin.z + dir.z * tCap - center.z;
        if (tCap > EPSILON && qx * qx + qz * qz <= radius * radius && (tBest < 0.0 || tCap < tBest)) {
            tBest = tCap;
        }
    }
    return tBest;
}

@shader()
function cylinderNormal(center: vec3, radius: float, y0: float, y1: float, p: vec3) -> vec3 {
    var radial: vec3 = vec3(p.x - center.x, 0.0, p.z - center.z);
    var dr: float = abs(length(radial) - radius);
    var dy0: float = abs(p.y - y0);
    var dy1: float = abs(p.y - y1);
    if (dy0 < dr && dy0 <= dy1) {
        return vec3(0.0, -1.0, 0.0);
    }
    if (dy1 < dr) {
        return vec3(0.0, 1.0, 0.0);
    }
    return normalize(radial);
}

@shader()
function carPosition(index: int) -> vec3 {
    if (index == 0) {
        return uCar0;
    }
    if (index == 1) {
        return uCar1;
    }
    if (index == 2) {
        return uCar2;
    }
    return uCar3;
}

@shader()
function carAngle(index: int) -> float {
    if (index == 0) {
        return uAngle0;
    }
    if (index == 1) {
        return uAngle1;
    }
    if (index == 2) {
        return uAngle2;
    }
    return uAngle3;
}

@shader()
function carColor(index: int) -> vec3 {
    if (index == 0) {
        return vec3(0.92, 0.15, 0.18);
    }
    if (index == 1) {
        return vec3(0.12, 0.52, 0.95);
    }
    if (index == 2) {
        return vec3(0.15, 0.82, 0.28);
    }
    return vec3(0.95, 0.72, 0.12);
}

@shader()
function wheelOffset(w: int) -> vec3 {
    if (w == 0) {
        return vec3(0.35, 0.0, 0.22);
    }
    if (w == 1) {
        return vec3(0.35, 0.0, -0.22);
    }
    if (w == 2) {
        return vec3(-0.35, 0.0, 0.22);
    }
    return vec3(-0.35, 0.0, -0.22);
}

@shader()
function hitCar(index: int, origin: vec3, dir: vec3, tHit: out float, kind: out int) -> bool {
    var pos: vec3 = carPosition(index);
    var angle: float = carAngle(index);
    var bodyHalf: vec3 = vec3(0.48, 0.18, 0.22);
    var bodyCenter: vec3 = vec3(pos.x, pos.y + 0.18, pos.z);
    var tBody: float = hitBoxRotated(bodyCenter, bodyHalf, angle, origin, dir);
    var wheelR: float = 0.12;
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    tHit = 1000000.0;
    kind = -1;
    if (tBody > 0.0 && tBody < tHit) {
        tHit = tBody;
        kind = 0;
    }
    var w: int = 0;
    while (w < 4) {
        var offset: vec3 = wheelOffset(w);
        var wx: float = ca * offset.x - sa * offset.z;
        var wz: float = sa * offset.x + ca * offset.z;
        var wheelCenter: vec3 = vec3(pos.x + wx, pos.y + wheelR, pos.z + wz);
        var tWheel: float = hitCylinder(wheelCenter, wheelR, pos.y, pos.y + wheelR * 2.0, origin, dir);
        if (tWheel > 0.0 && tWheel < tHit) {
            tHit = tWheel;
            kind = 1 + w;
        }
        w = w + 1;
    }
    return kind >= 0;
}

@shader()
function carNormal(index: int, kind: int, p: vec3) -> vec3 {
    var pos: vec3 = carPosition(index);
    var angle: float = carAngle(index);
    if (kind == 0) {
        var bodyHalf: vec3 = vec3(0.48, 0.18, 0.22);
        var bodyCenter: vec3 = vec3(pos.x, pos.y + 0.18, pos.z);
        return boxNormalRotated(bodyCenter, bodyHalf, angle, p);
    }
    var wheelR: float = 0.12;
    var ca: float = cos(angle);
    var sa: float = sin(angle);
    var w: int = kind - 1;
    var offset: vec3 = wheelOffset(w);
    var wx: float = ca * offset.x - sa * offset.z;
    var wz: float = sa * offset.x + ca * offset.z;
    var wheelCenter: vec3 = vec3(pos.x + wx, pos.y + wheelR, pos.z + wz);
    return cylinderNormal(wheelCenter, wheelR, pos.y, pos.y + wheelR * 2.0, p);
}

@shader()
function considerHit(t: float, tHit: float) -> bool {
    return t > 0.0 && t < tHit;
}

@shader()
function closestHit(
    origin: vec3,
    dir: vec3,
    tMax: float,
    tHit: out float,
    kind: out int,
    index: out int,
    material: out int,
    normal: out vec3,
    albedo: out vec3
) -> bool {
    tHit = tMax;
    kind = 0;
    index = -1;
    material = 0;
    normal = vec3(0.0, 1.0, 0.0);
    albedo = vec3(0.0);

    var i: int = 0;
    while (i < 4) {
        var tCar: float = 0.0;
        var carKind: int = -1;
        if (hitCar(i, origin, dir, tCar, carKind)) {
            if (considerHit(tCar, tHit)) {
                tHit = tCar;
                kind = 1;
                index = i * 10 + carKind;
                material = 1;
            }
        }
        i = i + 1;
    }

    var trackW: float = 8.0;
    var trackL: float = 40.0;
    var wallH: float = 1.2;
    var tTrack: float = hitBox(vec3(-trackW, 0.0, -trackL), vec3(trackW, 0.02, trackL), origin, dir);
    if (considerHit(tTrack, tHit)) {
        tHit = tTrack;
        kind = 2;
        index = 0;
        material = 0;
    }
    var wallT: float = 0.25;
    var tWall1: float = hitBox(vec3(-trackW - wallT, 0.0, -trackL), vec3(-trackW, wallH, trackL), origin, dir);
    if (considerHit(tWall1, tHit)) {
        tHit = tWall1;
        kind = 3;
        index = 0;
        material = 0;
    }
    var tWall2: float = hitBox(vec3(trackW, 0.0, -trackL), vec3(trackW + wallT, wallH, trackL), origin, dir);
    if (considerHit(tWall2, tHit)) {
        tHit = tWall2;
        kind = 3;
        index = 1;
        material = 0;
    }
    var tWall3: float = hitBox(vec3(-trackW, 0.0, -trackL - wallT), vec3(trackW, wallH, -trackL), origin, dir);
    if (considerHit(tWall3, tHit)) {
        tHit = tWall3;
        kind = 3;
        index = 2;
        material = 0;
    }
    var tWall4: float = hitBox(vec3(-trackW, 0.0, trackL), vec3(trackW, wallH, trackL + wallT), origin, dir);
    if (considerHit(tWall4, tHit)) {
        tHit = tWall4;
        kind = 3;
        index = 3;
        material = 0;
    }

    if (abs(dir.y) > EPSILON) {
        var tGround: float = (-0.02 - origin.y) / dir.y;
        if (tGround > EPSILON && tGround < tHit) {
            tHit = tGround;
            kind = 4;
            index = -1;
            material = 0;
        }
    }

    if (kind == 0) {
        return false;
    }

    var hit: vec3 = origin + dir * tHit;
    if (kind == 1) {
        var carIdx: int = index / 10;
        var carPart: int = index - carIdx * 10;
        normal = carNormal(carIdx, carPart, hit);
        if (carPart == 0) {
            albedo = carColor(carIdx);
        } else {
            albedo = vec3(0.08, 0.08, 0.09);
        }
    } else if (kind == 2) {
        normal = boxNormal(vec3(-trackW, 0.0, -trackL), vec3(trackW, 0.02, trackL), hit);
        var check: float = mod(floor(hit.x * 0.5) + floor(hit.z * 0.5), 2.0);
        if (check < 0.5) {
            albedo = vec3(0.15, 0.15, 0.16);
        } else {
            albedo = vec3(0.92, 0.92, 0.88);
        }
        if (abs(hit.x) < 0.08) {
            var stripe: float = mod(floor(hit.z * 2.0), 4.0);
            if (stripe < 2.0) {
                albedo = vec3(0.95, 0.85, 0.12);
            }
        }
    } else if (kind == 3) {
        if (index == 0) {
            normal = boxNormal(vec3(-trackW - wallT, 0.0, -trackL), vec3(-trackW, wallH, trackL), hit);
        } else if (index == 1) {
            normal = boxNormal(vec3(trackW, 0.0, -trackL), vec3(trackW + wallT, wallH, trackL), hit);
        } else if (index == 2) {
            normal = boxNormal(vec3(-trackW, 0.0, -trackL - wallT), vec3(trackW, wallH, -trackL), hit);
        } else {
            normal = boxNormal(vec3(-trackW, 0.0, trackL), vec3(trackW, wallH, trackL + wallT), hit);
        }
        albedo = vec3(0.72, 0.18, 0.22);
    } else {
        normal = vec3(0.0, 1.0, 0.0);
        if (dot(normal, dir) > 0.0) {
            normal = -normal;
        }
        var check: float = mod(floor(hit.x * 0.25) + floor(hit.z * 0.25), 2.0);
        if (check < 0.5) {
            albedo = vec3(0.18, 0.42, 0.18);
        } else {
            albedo = vec3(0.12, 0.28, 0.12);
        }
    }
    normal = normalize(normal);
    return true;
}

@shader()
function inShadow(hit: vec3, normal: vec3) -> bool {
    var origin: vec3 = hit + normal * 0.02;
    var toLight: vec3 = uLightPos - origin;
    var lightDist: float = length(toLight);
    if (lightDist <= EPSILON) {
        return false;
    }
    var dir: vec3 = toLight / lightDist;
    var tHit: float = 0.0;
    var kind: int = 0;
    var index: int = 0;
    var material: int = 0;
    var n: vec3 = vec3(0.0);
    var albedo: vec3 = vec3(0.0);
    return closestHit(origin, dir, lightDist - 0.05, tHit, kind, index, material, n, albedo);
}

@shader()
function localShade(hit: vec3, normal: vec3, albedo: vec3, viewDir: vec3, glossy: bool) -> vec3 {
    var toLight: vec3 = uLightPos - hit;
    var lightDir: vec3 = normalize(toLight);
    var diff: float = max(dot(normal, lightDir), 0.0);
    var light: float = 0.18;
    if (!inShadow(hit, normal)) {
        light = 0.18 + diff * 0.82;
        if (glossy) {
            var halfV: vec3 = normalize(lightDir + viewDir);
            var spec: float = pow(max(dot(normal, halfV), 0.0), 48.0);
            return albedo * light + vec3(spec, spec, spec) * 0.42;
        }
    }
    return albedo * light;
}

@shader()
function shadeSky(dir: vec3) -> vec3 {
    var t: float = clamp((dir.y + 1.0) * 0.5, 0.0, 1.0);
    return mix(vec3(0.55, 0.72, 0.92), vec3(0.12, 0.22, 0.38), t);
}

@shader()
function traceScene(origin: vec3, dir: vec3) -> vec3 {
    var tHit: float = 0.0;
    var kind: int = 0;
    var index: int = 0;
    var material: int = 0;
    var normal: vec3 = vec3(0.0);
    var albedo: vec3 = vec3(0.0);
    if (!closestHit(origin, dir, 1000000.0, tHit, kind, index, material, normal, albedo)) {
        return shadeSky(dir);
    }
    var hit: vec3 = origin + dir * tHit;
    var viewDir: vec3 = normalize(origin - hit);
    return localShade(hit, normal, albedo, viewDir, material == 1);
}

@shader()
function fragmentMain() {
    var ndc: vec2 = vUv * 2.0 - 1.0;
    var dir: vec3 = normalize(
        uCamForward
        + uCamRight * (ndc.x * uAspect * uTanHalf)
        + uCamUp * (ndc.y * uTanHalf)
    );
    var color: vec3 = traceScene(uCamPos, dir);
    gl_FragColor = vec4(sqrt(color), 1.0);
}

var vertexShader = glsl.compile({
    varyings: ["vec2 vUv"],
    functions: ["vertexMain"],
    main: "vertexMain"
});

var fragmentShader = glsl.compile({
    varyings: ["vec2 vUv"],
    uniforms: [
        "vec2 uResolution",
        "vec3 uCamPos",
        "vec3 uCamForward",
        "vec3 uCamRight",
        "vec3 uCamUp",
        "vec3 uLightPos",
        "float uTanHalf",
        "float uAspect",
        "vec3 uCar0",
        "vec3 uCar1",
        "vec3 uCar2",
        "vec3 uCar3",
        "float uAngle0",
        "float uAngle1",
        "float uAngle2",
        "float uAngle3"
    ],
    consts: ["float EPSILON = 0.0015"],
    functions: [
        "hitSphere",
        "hitBox",
        "boxNormal",
        "hitBoxRotated",
        "boxNormalRotated",
        "hitCylinder",
        "cylinderNormal",
        "carPosition",
        "carAngle",
        "carColor",
        "wheelOffset",
        "hitCar",
        "carNormal",
        "considerHit",
        "closestHit",
        "inShadow",
        "localShade",
        "shadeSky",
        "traceScene",
        "fragmentMain"
    ],
    main: "fragmentMain"
});

var root = dom.query("#app");

if (root == null) {
    println("No #app container found.");
} else {
    dom.clear(root);

    var heading = dom.create("h1");
    dom.setText(heading, "MALDA GPU Race Car Ray Tracer");
    dom.append(root, heading);

    var hint = dom.create("p");
    dom.setText(hint, "Realtime GLSL ray tracer with 3D race cars. Use Arrow keys to control the red car (forward/backward/left/right). C toggles chase camera. Space resets positions. The scene uses GPU ray tracing for realistic lighting and shadows.");
    dom.append(root, hint);

    if (dom.query("#malda-autoplay") != null) {
        var showcaseFit = dom.create("style");
        dom.setText(showcaseFit, "#status{display:none!important}html,body{overflow:hidden;margin:0;background:#0a1628}#app{min-height:0!important;background:#0a1628}#app>p,#app>div{display:none!important}#app h1{margin:8px 12px 0;font-size:14px;font-weight:600;line-height:1.2}#app canvas{position:fixed!important;left:8px!important;top:32px!important;width:calc(100vw - 16px)!important;height:calc(100vh - 44px)!important;object-fit:contain;object-position:center center;background:#0a1628}");
        dom.append(root, showcaseFit);
    }

    var width = 960;
    var height = 540;
    var aspect = width / height;
    var tanHalf = math.tan(math.degToRad(32));

    var carX = [0.0, -3.0, 3.0, 0.0];
    var carY = [0.0, 0.0, 0.0, 0.0];
    var carZ = [-5.0, -8.0, -8.0, -11.0];
    var carAngle = [0.0, 0.0, 0.0, 0.0];
    var carVel = [0.0, 0.0, 0.0, 0.0];
    var carSteer = [0.0, 0.0, 0.0, 0.0];

    var camRadius = 8.5;
    var camHeight = 3.2;
    var camAngle = 3.14159265;
    var chaseMode = true;
    var cWasDown = false;
    var spaceWasDown = false;

    var lightX = 5.0;
    var lightY = 12.0;
    var lightZ = 8.0;

    function resetPositions() {
        carX = [0.0, -3.0, 3.0, 0.0];
        carZ = [-5.0, -8.0, -8.0, -11.0];
        carAngle = [0.0, 0.0, 0.0, 0.0];
        carVel = [0.0, 0.0, 0.0, 0.0];
        carSteer = [0.0, 0.0, 0.0, 0.0];
    }

    function updateCamera() {
        var targetX = 0.0;
        var targetZ = 0.0;
        var targetAngle = 0.0;
        if (chaseMode) {
            targetX = carX[0];
            targetZ = carZ[0];
            targetAngle = carAngle[0] + 3.14159265;
        }
        var camX = targetX + math.sin(targetAngle) * camRadius;
        var camY = camHeight;
        var camZ = targetZ + math.cos(targetAngle) * camRadius;

        var fx = targetX - camX;
        var fy = 0.5 - camY;
        var fz = targetZ - camZ;
        var fl = math.sqrt(fx * fx + fy * fy + fz * fz);
        fx = fx / fl;
        fy = fy / fl;
        fz = fz / fl;

        var rx = 0.0 - fz;
        var ry = 0.0;
        var rz = fx;
        var rl = math.sqrt(rx * rx + ry * ry + rz * rz);
        rx = rx / rl;
        ry = ry / rl;
        rz = rz / rl;

        var ux = ry * fz - rz * fy;
        var uy = rz * fx - rx * fz;
        var uz = rx * fy - ry * fx;

        return {
            "camX": camX,
            "camY": camY,
            "camZ": camZ,
            "forwardX": fx,
            "forwardY": fy,
            "forwardZ": fz,
            "rightX": rx,
            "rightY": ry,
            "rightZ": rz,
            "upX": ux,
            "upY": uy,
            "upZ": uz
        };
    }

    var renderer = three.createRenderer(width, height, "#app");
    three.setClearColor(renderer, "#0a1628");
    three.setRendererSize(renderer, width, height);

    var scene = three.createScene();
    var camera = three.createOrthographicCamera(-1, 1, 1, -1, 0, 1);

    var material = three.createShaderMaterial({
        "vertexShader": vertexShader,
        "fragmentShader": fragmentShader,
        "depthWrite": false,
        "uniforms": {
            "uResolution": [width, height],
            "uCamPos": [0, 3.2, 8.5],
            "uCamForward": [0, 0, -1],
            "uCamRight": [1, 0, 0],
            "uCamUp": [0, 1, 0],
            "uLightPos": [lightX, lightY, lightZ],
            "uTanHalf": tanHalf,
            "uAspect": aspect,
            "uCar0": [0, 0, -5],
            "uCar1": [-3, 0, -8],
            "uCar2": [3, 0, -8],
            "uCar3": [0, 0, -11],
            "uAngle0": 0,
            "uAngle1": 0,
            "uAngle2": 0,
            "uAngle3": 0
        }
    });

    var quad = three.createMesh(three.createPlaneGeometry(2, 2), material);
    three.add(scene, quad);

    function update(dtMs) {
        var dt = dtMs;
        if (dt > 50) {
            dt = 50;
        }
        var dtSec = dt / 1000.0;

        var accel = 0.0;
        var steerInput = 0.0;
        if (three.isKeyDown("arrowup") || three.isKeyDown("w")) {
            accel = 8.0;
        }
        if (three.isKeyDown("arrowdown") || three.isKeyDown("s")) {
            accel = -6.0;
        }
        if (three.isKeyDown("arrowleft") || three.isKeyDown("a")) {
            steerInput = -2.8;
        }
        if (three.isKeyDown("arrowright") || three.isKeyDown("d")) {
            steerInput = 2.8;
        }

        carVel[0] = carVel[0] + accel * dtSec;
        carVel[0] = carVel[0] * 0.92;
        if (carVel[0] > 15.0) {
            carVel[0] = 15.0;
        }
        if (carVel[0] < -10.0) {
            carVel[0] = -10.0;
        }

        carSteer[0] = steerInput;
        carAngle[0] = carAngle[0] + carSteer[0] * dtSec;

        carX[0] = carX[0] + math.sin(carAngle[0]) * carVel[0] * dtSec;
        carZ[0] = carZ[0] + math.cos(carAngle[0]) * carVel[0] * dtSec;

        var trackW = 7.5;
        var trackL = 39.0;
        if (carX[0] < -trackW) {
            carX[0] = -trackW;
        }
        if (carX[0] > trackW) {
            carX[0] = trackW;
        }
        if (carZ[0] < -trackL) {
            carZ[0] = -trackL;
        }
        if (carZ[0] > trackL) {
            carZ[0] = trackL;
        }

        var i = 1;
        while (i < 4) {
            carVel[i] = 5.0 + i * 0.5;
            carZ[i] = carZ[i] + carVel[i] * dtSec;
            if (carZ[i] > trackL) {
                carZ[i] = -trackL;
            }
            i = i + 1;
        }

        var cDown = three.isKeyDown("c");
        if (cDown && !cWasDown) {
            chaseMode = !chaseMode;
        }
        cWasDown = cDown;

        var spaceDown = three.isKeyDown(" ");
        if (spaceDown && !spaceWasDown) {
            resetPositions();
        }
        spaceWasDown = spaceDown;

        var cam = updateCamera();
        three.setUniform(material, "uCamPos", [cam.camX, cam.camY, cam.camZ]);
        three.setUniform(material, "uCamForward", [cam.forwardX, cam.forwardY, cam.forwardZ]);
        three.setUniform(material, "uCamRight", [cam.rightX, cam.rightY, cam.rightZ]);
        three.setUniform(material, "uCamUp", [cam.upX, cam.upY, cam.upZ]);
        three.setUniform(material, "uLightPos", [lightX, lightY, lightZ]);
        three.setUniform(material, "uCar0", [carX[0], carY[0], carZ[0]]);
        three.setUniform(material, "uCar1", [carX[1], carY[1], carZ[1]]);
        three.setUniform(material, "uCar2", [carX[2], carY[2], carZ[2]]);
        three.setUniform(material, "uCar3", [carX[3], carY[3], carZ[3]]);
        three.setUniform(material, "uAngle0", carAngle[0]);
        three.setUniform(material, "uAngle1", carAngle[1]);
        three.setUniform(material, "uAngle2", carAngle[2]);
        three.setUniform(material, "uAngle3", carAngle[3]);
    }

    function render() {
        three.render(renderer, scene, camera);
    }

    three.start(update, render);
}
