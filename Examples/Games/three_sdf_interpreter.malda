// SDF interpreter: one raymarching shader, compiled once, runs a scene stored as bytecode.
//
// A shader generated from the scene must be compiled again whenever the scene changes shape,
// and a big shader can take seconds to compile. Here the shader is a small interpreter instead:
// the host writes the scene as instructions into a float data texture, and the fragment shader
// reads them with texelFetch and runs them for every raymarching step. Adding, removing or moving
// a shape only rewrites the texture (three.updateDataTexture); the shader never changes.
//
// Instruction = two RGBA texels:
//   UNION  (1, kind, -, k)   (x, y, z, size)   smooth-union the shape into the distance so far
//   CUT    (2, kind, -, k)   (x, y, z, size)   subtract the shape from the distance so far
//   GROUP  (3, -, jump, -)   (cx, cy, cz, r)   what follows, up to `jump`, lies in this sphere
//
// The host sorts the shapes into a tree of GROUPs by position. One pixel takes up to ~180 distance
// evaluations (march, normal, shadow), so running the whole program for each would be far too
// slow. Instead each ray first walks the program once, skipping every group whose sphere it
// misses, and keeps in a local array (`var cand: int[MAX_CAND];`) the shapes it passes near.
// Shapes away from the ray can neither be hit nor bend the surface where it is hit, so every
// march step then runs only those few. B turns the culling off to compare. Rays also march only
// inside the box around the shapes, and the floor is hit analytically.
// The same bytecode runs on the host (cpuSceneDistance) to find the surface under the mouse.
//
// Controls: click drops the current tool on the surface. 1-4 pick sphere / box / torus / cylinder,
// X toggles add / cut, Backspace undoes, [ ] change the blend, B toggles the ray culling,
// M toggles motion (the texture is rewritten every frame), R resets, arrows orbit, + / - zoom.
//
// Build: malda compile Examples/Games/three_sdf_interpreter.malda --mode js -o three_sdf_interpreter.js

@shader()
function vertexMain() {
    vUv = uv;
    gl_Position = vec4(position.xy, 0.0, 1.0);
}

@shader()
function sdBox(q: vec3, s: float) -> float {
    var d: vec3 = abs(q) - vec3(s, s, s);
    return length(max(d, vec3(0.0, 0.0, 0.0))) + min(max(d.x, max(d.y, d.z)), 0.0);
}

@shader()
function sdTorus(q: vec3, s: float) -> float {
    var t: vec2 = vec2(length(q.xz) - s, q.y);
    return length(t) - s * 0.35;
}

@shader()
function sdCylinder(q: vec3, s: float) -> float {
    var d: vec2 = abs(vec2(length(q.xz), q.y)) - vec2(s * 0.7, s);
    return min(max(d.x, d.y), 0.0) + length(max(d, vec2(0.0, 0.0)));
}

@shader()
function sdShape(kind: int, q: vec3, s: float) -> float {
    if (kind == 0) {
        return length(q) - s;
    }
    if (kind == 1) {
        return sdBox(q, s);
    }
    if (kind == 2) {
        return sdTorus(q, s);
    }
    return sdCylinder(q, s);
}

@shader()
function shapeColor(kind: int) -> vec3 {
    if (kind == 0) {
        return vec3(0.96, 0.28, 0.18);
    }
    if (kind == 1) {
        return vec3(0.12, 0.72, 0.92);
    }
    if (kind == 2) {
        return vec3(0.98, 0.78, 0.16);
    }
    return vec3(0.58, 0.28, 0.95);
}

// Radius of a sphere around the shape (mirrors boundRadius on the host).
@shader()
function shapeRadius(kind: int, s: float) -> float {
    if (kind == 0) {
        return s;
    }
    if (kind == 1) {
        return s * 1.74;
    }
    if (kind == 2) {
        return s * 1.35;
    }
    return s * 1.23;
}

// The whole program at one point, for a ray that passes near more than MAX_CAND shapes (or with
// the culling off). One instruction per iteration, the distance and color so far in registers.
// With the culling on, a shape or group farther than the distance so far plus the blend is
// skipped: it cannot change the result.
@shader()
function runProgram(p: vec3, color: out vec3) -> float {
    var acc: float = FAR;
    var tint: vec3 = vec3(0.5, 0.5, 0.5);
    var skip: bool = uSkip > 0.5;
    var i: int = 0;
    while (i < uCount) {
        var head: vec4 = texelFetch(uProgram, ivec2(i * 2, 0), 0);
        var data: vec4 = texelFetch(uProgram, ivec2(i * 2 + 1, 0), 0);
        var op: int = int(head.x + 0.5);
        if (op == OP_GROUP) {
            if (skip && length(p - data.xyz) - data.w > acc + uBlend) {
                i = int(head.z + 0.5);
                continue;
            }
        } else {
            var kind: int = int(head.y + 0.5);
            var k: float = max(head.w, 0.0001);
            var bound: float = length(p - data.xyz) - shapeRadius(kind, data.w);
            if (op == OP_UNION) {
                if (!skip || bound < acc + k) {
                    var d: float = sdShape(kind, p - data.xyz, data.w);
                    var h: float = clamp(0.5 + 0.5 * (d - acc) / k, 0.0, 1.0);
                    acc = mix(d, acc, h) - k * h * (1.0 - h);
                    tint = mix(shapeColor(kind), tint, h);
                }
            } else if (!skip || bound < k - acc) {
                var c: float = sdShape(kind, p - data.xyz, data.w);
                var hc: float = clamp(0.5 + 0.5 * (c + acc) / k, 0.0, 1.0);
                acc = mix(0.0 - c, acc, hc) + k * hc * (1.0 - hc);
                tint = mix(shapeColor(kind) * 0.85, tint, hc);
            }
        }
        i++;
    }
    color = tint;
    return acc;
}

// The box around every shape (from the host): rays march only inside it.
@shader()
function rayBox(origin: vec3, dir: vec3, tNear: out float, tFar: out float) -> bool {
    var inv: vec3 = 1.0 / (dir + vec3(0.0000001, 0.0000001, 0.0000001));
    var t0: vec3 = (uBoxMin - origin) * inv;
    var t1: vec3 = (uBoxMax - origin) * inv;
    var lo: vec3 = min(t0, t1);
    var hi: vec3 = max(t0, t1);
    tNear = max(max(lo.x, lo.y), lo.z);
    tFar = min(min(hi.x, hi.y), hi.z);
    return tFar > max(tNear, 0.0);
}

// March one ray from tStart to tEnd. First walk the program once and keep, in program order, the
// shapes whose bounding sphere (grown by the blend, or the penumbra for a shadow ray) comes near
// the ray: the others can neither be hit nor bend the surface where it is hit. Then every march
// step runs only those few. More than MAX_CAND near shapes: every step runs the whole program.
// A primary ray returns 1.0 on a hit (with tHit, normal and albedo); a shadow ray returns how
// much light gets through.
@shader()
function traceRay(origin: vec3, dir: vec3, tStart: float, tEnd: float, shadowRay: bool, tHit: out float, normal: out vec3, albedo: out vec3) -> float {
    var cand: int[MAX_CAND];
    var count: int = 0;
    var overflow: bool = uSkip < 0.5;
    var margin: float = 0.0;
    if (shadowRay) {
        margin = 0.25;
    }
    var i: int = 0;
    while (i < uCount && !overflow) {
        var head: vec4 = texelFetch(uProgram, ivec2(i * 2, 0), 0);
        var data: vec4 = texelFetch(uProgram, ivec2(i * 2 + 1, 0), 0);
        var op: int = int(head.x + 0.5);
        var reach: float = data.w + uBlend + margin;
        if (op != OP_GROUP) {
            reach = shapeRadius(int(head.y + 0.5), data.w) + max(head.w, 0.0001) + margin;
        }
        var along: float = clamp(dot(data.xyz - origin, dir), tStart, tEnd);
        var close: bool = length(origin + dir * along - data.xyz) <= reach;
        if (op == OP_GROUP) {
            if (!close) {
                i = int(head.z + 0.5);
                continue;
            }
        } else if (close) {
            if (count < MAX_CAND) {
                cand[count] = i;
                count++;
            } else {
                overflow = true;
            }
        }
        i++;
    }
    tHit = tEnd;
    normal = vec3(0.0, 1.0, 0.0);
    albedo = vec3(0.5, 0.5, 0.5);
    if (count == 0 && !overflow) {
        if (shadowRay) {
            return 1.0;
        }
        return 0.0;
    }

    // March. After a hit, four more samples around the hit point give the normal.
    var e: vec2 = vec2(0.001, -0.001);
    var t: float = tStart;
    var light: float = 1.0;
    var hit: bool = false;
    var normalSample: int = 0;
    var grad: vec3 = vec3(0.0, 0.0, 0.0);
    for (var step: int = 0; step < 132; step++) {
        var offset: vec3 = vec3(0.0, 0.0, 0.0);
        if (hit) {
            if (normalSample == 0) {
                offset = e.xyy;
            } else if (normalSample == 1) {
                offset = e.yyx;
            } else if (normalSample == 2) {
                offset = e.yxy;
            } else {
                offset = e.xxx;
            }
        } else if (t > tEnd || (shadowRay && step >= 40)) {
            break;
        }
        var p: vec3 = origin + dir * t + offset;
        var acc: float = FAR;
        var tint: vec3 = vec3(0.5, 0.5, 0.5);
        if (overflow) {
            acc = runProgram(p, tint);
        } else {
            for (var c: int = 0; c < MAX_CAND; c++) {
                if (c >= count) {
                    break;
                }
                var at: int = cand[c];
                var head: vec4 = texelFetch(uProgram, ivec2(at * 2, 0), 0);
                var data: vec4 = texelFetch(uProgram, ivec2(at * 2 + 1, 0), 0);
                var kind: int = int(head.y + 0.5);
                var k: float = max(head.w, 0.0001);
                var d: float = sdShape(kind, p - data.xyz, data.w);
                if (int(head.x + 0.5) == OP_UNION) {
                    var h: float = clamp(0.5 + 0.5 * (d - acc) / k, 0.0, 1.0);
                    acc = mix(d, acc, h) - k * h * (1.0 - h);
                    tint = mix(shapeColor(kind), tint, h);
                } else {
                    var hc: float = clamp(0.5 + 0.5 * (d + acc) / k, 0.0, 1.0);
                    acc = mix(0.0 - d, acc, hc) + k * hc * (1.0 - hc);
                    tint = mix(shapeColor(kind) * 0.85, tint, hc);
                }
            }
        }
        if (hit) {
            grad += offset * acc;
            normalSample++;
            if (normalSample == 4) {
                break;
            }
        } else if (shadowRay) {
            light = min(light, 16.0 * acc / t);
            if (light < 0.01) {
                break;
            }
            t += clamp(acc, 0.03, 0.6);
        } else if (acc < 0.0005 + 0.0008 * t) {
            hit = true;
            tHit = t;
            albedo = tint;
        } else {
            t += acc;
        }
    }
    if (shadowRay) {
        return clamp(light, 0.0, 1.0);
    }
    if (hit) {
        normal = normalize(grad);
        return 1.0;
    }
    return 0.0;
}

@shader()
function softShadow(origin: vec3, dir: vec3) -> float {
    var tNear: float = 0.0;
    var tFar: float = 0.0;
    if (!rayBox(origin, dir, tNear, tFar)) {
        return 1.0;
    }
    var tHit: float = 0.0;
    var normal: vec3 = vec3(0.0, 0.0, 0.0);
    var albedo: vec3 = vec3(0.0, 0.0, 0.0);
    return traceRay(origin, dir, max(tNear, 0.03), tFar, true, tHit, normal, albedo);
}

@shader()
function shade(p: vec3, n: vec3, albedo: vec3, dir: vec3) -> vec3 {
    var lightDir: vec3 = normalize(vec3(0.55, 0.9, 0.35));
    var key: float = max(dot(n, lightDir), 0.0);
    if (key > 0.0) {
        key = key * softShadow(p + n * 0.003, lightDir);
    }
    var fill: float = max(dot(n, normalize(vec3(-0.45, 0.35, -0.55))), 0.0);
    var ambient: float = 0.34 + 0.16 * n.y;
    var spec: float = pow(max(dot(reflect(dir, n), lightDir), 0.0), 32.0) * key;
    return albedo * (ambient + key * 1.05 + fill * 0.38) + vec3(spec * 0.45, spec * 0.45, spec * 0.45);
}

@shader()
function fragmentMain() {
    var ndc: vec2 = vUv * 2.0 - 1.0;
    var dir: vec3 = normalize(
        uCamForward
        + uCamRight * (ndc.x * uAspect * uTanHalf)
        + uCamUp * (ndc.y * uTanHalf)
    );
    var sky: vec3 = mix(vec3(0.12, 0.18, 0.38), vec3(0.55, 0.72, 0.95), clamp(dir.y * 1.4 + 0.25, 0.0, 1.0));
    var tFloor: float = FAR;
    if (dir.y < -0.0001) {
        tFloor = (0.0 - uCamPos.y) / dir.y;
    }
    var t: float = 0.0;
    var hit: bool = false;
    var normal: vec3 = vec3(0.0, 1.0, 0.0);
    var albedo: vec3 = vec3(0.0, 0.0, 0.0);
    var tNear: float = 0.0;
    var tFar: float = 0.0;
    if (rayBox(uCamPos, dir, tNear, tFar)) {
        hit = traceRay(uCamPos, dir, max(tNear, 0.0), min(tFar, tFloor), false, t, normal, albedo) > 0.5;
    }
    var color: vec3 = sky;
    if (hit) {
        color = shade(uCamPos + dir * t, normal, albedo, dir);
    } else if (tFloor < FAR) {
        t = tFloor;
        var q: vec3 = uCamPos + dir * t;
        var cell: float = mod(floor(q.x) + floor(q.z), 2.0);
        var floorColor: vec3 = mix(vec3(0.34, 0.36, 0.42), vec3(0.55, 0.58, 0.66), cell);
        color = shade(q, vec3(0.0, 1.0, 0.0), floorColor, dir);
    } else {
        t = 0.0;
    }
    color = mix(color, sky, clamp((t - 26.0) / 36.0, 0.0, 1.0));
    gl_FragColor = vec4(sqrt(color), 1.0);
}

var vertexShader = glsl.compile({
    varyings: ["vec2 vUv"],
    functions: ["vertexMain"],
    main: "vertexMain"
});

var fragmentShader = glsl.compile({
    varyings: ["vec2 vUv"],
    uniforms: [
        "sampler2D uProgram",
        "int uCount",
        "float uBlend",
        "float uSkip",
        "vec3 uBoxMin",
        "vec3 uBoxMax",
        "vec3 uCamPos",
        "vec3 uCamForward",
        "vec3 uCamRight",
        "vec3 uCamUp",
        "float uTanHalf",
        "float uAspect"
    ],
    consts: [
        "int OP_UNION = 1",
        "int OP_CUT = 2",
        "int OP_GROUP = 3",
        "int MAX_CAND = 24",
        "float FAR = 100000.0"
    ],
    functions: [
        "sdBox",
        "sdTorus",
        "sdCylinder",
        "sdShape",
        "shapeColor",
        "shapeRadius",
        "runProgram",
        "rayBox",
        "traceRay",
        "softShadow",
        "shade",
        "fragmentMain"
    ],
    main: "fragmentMain"
});

const OP_UNION = 1;
const OP_CUT = 2;
const OP_GROUP = 3;
// A group with this many shapes or fewer lists them; a bigger one splits in two.
const GROUP_LEAF = 4;
const MAX_OPS = 384;
const SHAPE_NAMES = ["sphere", "box", "torus", "cylinder"];

var root = dom.query("#app");

if (root == null) {
    io.print("No #app container found.");
} else {
    dom.clear(root);

    var heading = dom.create("h1");
    dom.setText(heading, "MALDA SDF Interpreter");
    dom.append(root, heading);

    var hint = dom.create("p");
    dom.setText(hint, "One shader, compiled once, runs the scene as bytecode from a data texture. Click to drop the tool on the surface. 1-4 sphere / box / torus / cylinder, X add or cut, Backspace undo, [ ] blend, B ray culling, M motion, R reset, arrows orbit, + / - zoom.");
    dom.append(root, hint);

    var status = dom.create("p");
    dom.append(root, status);

    var width = 960;
    var height = 540;
    var aspect = width / height;
    var tanHalf = math.tan(math.degToRad(30));

    // The program the shader runs: MAX_OPS instructions, 8 floats each.
    var program = buf.float32(MAX_OPS * 8);
    var opCount = 0;
    var objects = [];
    var blend = 0.25;
    var skipOn = true;
    var motionOn = false;
    var tool = 0;
    var cutMode = false;
    var uploads = 0;
    var dirty = true;
    var timeSec = 0.0;

    var camAngle = 0.7;
    var camPitch = 0.42;
    var camDist = 11.0;
    var camX = 0.0;
    var camY = 0.0;
    var camZ = 0.0;
    var fwdX = 0.0;
    var fwdY = 0.0;
    var fwdZ = 1.0;
    var rightX = 1.0;
    var rightY = 0.0;
    var rightZ = 0.0;
    var upX = 0.0;
    var upY = 1.0;
    var upZ = 0.0;

    // Radius of a sphere around the shape: the SKIP test needs a distance that is never larger
    // than the shape's own.
    function boundRadius(kind, size) {
        if (kind == 0) {
            return size;
        }
        if (kind == 1) {
            return size * 1.74;
        }
        if (kind == 2) {
            return size * 1.35;
        }
        return size * 1.23;
    }

    // Room an object can take in the program: its own instruction, plus at most one group
    // (a tree over n shapes in leaves of two or more has fewer than n groups).
    function opsFor(obj) {
        if (obj.cut) {
            return 1;
        }
        return 2;
    }

    function writeOp(index, op, kind, jump, k, x, y, z, w) {
        var base = index * 8;
        program[base] = op;
        program[base + 1] = kind;
        program[base + 2] = jump;
        program[base + 3] = k;
        program[base + 4] = x;
        program[base + 5] = y;
        program[base + 6] = z;
        program[base + 7] = w;
    }

    // The box around every added shape, grown by the blend (a smooth union bulges by up to k).
    // Cuts only remove material, so they do not grow it. An empty scene gets an inverted box.
    var boxMin = [1, 1, 1];
    var boxMax = [-1, -1, -1];

    function growBox(x, y, z, r) {
        if (boxMin[0] > boxMax[0]) {
            boxMin = [x - r, y - r, z - r];
            boxMax = [x + r, y + r, z + r];
            return;
        }
        boxMin = [math.min(boxMin[0], x - r), math.min(boxMin[1], y - r), math.min(boxMin[2], z - r)];
        boxMax = [math.max(boxMax[0], x + r), math.max(boxMax[1], y + r), math.max(boxMax[2], z + r)];
    }

    function sphereAround(items) {
        var minX = items[0].x;
        var maxX = items[0].x;
        var minY = items[0].y;
        var maxY = items[0].y;
        var minZ = items[0].z;
        var maxZ = items[0].z;
        for (var it in items) {
            minX = math.min(minX, it.x - it.r);
            maxX = math.max(maxX, it.x + it.r);
            minY = math.min(minY, it.y - it.r);
            maxY = math.max(maxY, it.y + it.r);
            minZ = math.min(minZ, it.z - it.r);
            maxZ = math.max(maxZ, it.z + it.r);
        }
        var cx = (minX + maxX) * 0.5;
        var cy = (minY + maxY) * 0.5;
        var cz = (minZ + maxZ) * 0.5;
        var radius = 0.0;
        for (var it in items) {
            var dx = it.x - cx;
            var dy = it.y - cy;
            var dz = it.z - cz;
            radius = math.max(radius, math.sqrt(dx * dx + dy * dy + dz * dz) + it.r);
        }
        return { x: cx, y: cy, z: cz, r: radius, alongX: maxX - minX >= maxZ - minZ };
    }

    // Writes a tree of GROUPs over `items` (union shapes: { obj, x, y, z, r }) at opCount: a group
    // with the sphere around its members and a jump past them, then either its shapes or its
    // two halves, split at the middle of the longer side.
    function emitGroup(items) {
        if (items.length == 0) {
            return;
        }
        var sphere = sphereAround(items);
        var groupAt = opCount;
        opCount = opCount + 1;
        if (items.length <= GROUP_LEAF) {
            for (var it in items) {
                writeOp(opCount, OP_UNION, it.obj.kind, 0, blend, it.x, it.y, it.z, it.obj.size);
                opCount = opCount + 1;
            }
        } else {
            var low = [];
            var high = [];
            for (var it in items) {
                var coord = it.z;
                var middle = sphere.z;
                if (sphere.alongX) {
                    coord = it.x;
                    middle = sphere.x;
                }
                if (coord < middle) {
                    low.append(it);
                } else {
                    high.append(it);
                }
            }
            if (low.length == 0 || high.length == 0) {
                // All on one side of the middle (stacked shapes): split the list in two instead.
                low = [];
                high = [];
                for (var j = 0; j < items.length; j++) {
                    if (j * 2 < items.length) {
                        low.append(items[j]);
                    } else {
                        high.append(items[j]);
                    }
                }
            }
            emitGroup(low);
            emitGroup(high);
        }
        writeOp(groupAt, OP_GROUP, 0, opCount, 0, sphere.x, sphere.y, sphere.z, sphere.r);
    }

    // A cut subtracts from everything before it, so the order is kept: each run of added
    // shapes between two cuts becomes one tree of groups, then the cut follows.
    function buildProgram() {
        opCount = 0;
        boxMin = [1, 1, 1];
        boxMax = [-1, -1, -1];
        var run = [];
        for (var obj in objects) {
            var y = obj.y;
            if (motionOn) {
                y = y + math.sin(timeSec * 1.6 + obj.phase) * 0.3;
            }
            if (obj.cut) {
                emitGroup(run);
                run = [];
                writeOp(opCount, OP_CUT, obj.kind, 0, blend * 0.5, obj.x, y, obj.z, obj.size);
                opCount = opCount + 1;
            } else {
                var r = boundRadius(obj.kind, obj.size);
                growBox(obj.x, y, obj.z, r + blend + 0.01);
                run.append({ obj: obj, x: obj.x, y: y, z: obj.z, r: r });
            }
        }
        emitGroup(run);
    }

    function addObject(kind, x, y, z, size, cut) {
        var obj = { kind: kind, x: x, y: y, z: z, size: size, cut: cut, phase: objects.length * 0.7 };
        if (opCount + opsFor(obj) > MAX_OPS) {
            return false;
        }
        objects.append(obj);
        opCount = opCount + opsFor(obj);
        dirty = true;
        return true;
    }

    function resetScene() {
        objects = [];
        opCount = 0;
        for (var row = 0; row < 6; row++) {
            for (var col = 0; col < 6; col++) {
                var kind = (row + col) % 4;
                var size = 0.38 + ((row * 7 + col * 3) % 5) * 0.04;
                addObject(kind, -4.0 + col * 1.6, size, -4.0 + row * 1.6, size, false);
            }
        }
        addObject(0, 0.0, 0.2, 0.0, 1.5, true);
        addObject(1, 3.2, 0.9, -3.2, 0.55, true);
    }

    // ---- the same bytecode on the host (reference interpreter, used for picking) ----

    function cpuShape(kind, qx, qy, qz, s) {
        if (kind == 0) {
            return math.sqrt(qx * qx + qy * qy + qz * qz) - s;
        }
        if (kind == 1) {
            var dx = math.abs(qx) - s;
            var dy = math.abs(qy) - s;
            var dz = math.abs(qz) - s;
            var ox = math.max(dx, 0.0);
            var oy = math.max(dy, 0.0);
            var oz = math.max(dz, 0.0);
            return math.sqrt(ox * ox + oy * oy + oz * oz) + math.min(math.max(dx, math.max(dy, dz)), 0.0);
        }
        if (kind == 2) {
            var ring = math.sqrt(qx * qx + qz * qz) - s;
            return math.sqrt(ring * ring + qy * qy) - s * 0.35;
        }
        var cx = math.sqrt(qx * qx + qz * qz) - s * 0.7;
        var cy = math.abs(qy) - s;
        var px = math.max(cx, 0.0);
        var py = math.max(cy, 0.0);
        return math.min(math.max(cx, cy), 0.0) + math.sqrt(px * px + py * py);
    }

    function cpuSceneDistance(x, y, z) {
        var acc = 100000.0;
        var i = 0;
        while (i < opCount) {
            var base = i * 8;
            var op = int(program[base]);
            var qx = x - program[base + 4];
            var qy = y - program[base + 5];
            var qz = z - program[base + 6];
            var centerDistance = math.sqrt(qx * qx + qy * qy + qz * qz);
            if (op == OP_GROUP) {
                if (skipOn && centerDistance - program[base + 7] > acc + blend) {
                    i = int(program[base + 2]);
                    continue;
                }
            } else {
                var kind = int(program[base + 1]);
                var k = math.max(program[base + 3], 0.0001);
                var bound = centerDistance - boundRadius(kind, program[base + 7]);
                if (op == OP_UNION) {
                    if (!skipOn || bound < acc + k) {
                        var d = cpuShape(kind, qx, qy, qz, program[base + 7]);
                        var h = math.clamp(0.5 + 0.5 * (d - acc) / k, 0.0, 1.0);
                        acc = d + (acc - d) * h - k * h * (1.0 - h);
                    }
                } else if (!skipOn || bound < k - acc) {
                    var c = cpuShape(kind, qx, qy, qz, program[base + 7]);
                    var hc = math.clamp(0.5 + 0.5 * (c + acc) / k, 0.0, 1.0);
                    acc = 0.0 - c + (acc + c) * hc + k * hc * (1.0 - hc);
                }
            }
            i = i + 1;
        }
        return math.min(acc, y);
    }

    // March the mouse ray on the host; returns [x, y, z] of the hit, or null.
    function pickSurface(mx, my) {
        var ndcX = (mx / width) * 2.0 - 1.0;
        var ndcY = 1.0 - (my / height) * 2.0;
        var dx = fwdX + rightX * ndcX * aspect * tanHalf + upX * ndcY * tanHalf;
        var dy = fwdY + rightY * ndcX * aspect * tanHalf + upY * ndcY * tanHalf;
        var dz = fwdZ + rightZ * ndcX * aspect * tanHalf + upZ * ndcY * tanHalf;
        var dl = math.sqrt(dx * dx + dy * dy + dz * dz);
        dx = dx / dl;
        dy = dy / dl;
        dz = dz / dl;
        // Same stop rule as the shader: a hit when the distance is below a tolerance that grows
        // with t. A ray that grazes a surface may run out of steps close to it: still a hit.
        var t = 0.0;
        for (var step = 0; step < 128; step++) {
            var d = cpuSceneDistance(camX + dx * t, camY + dy * t, camZ + dz * t);
            if (d < 0.0005 + 0.0008 * t) {
                break;
            }
            t = t + d;
            if (t > 60.0) {
                return null;
            }
        }
        return [camX + dx * t, camY + dy * t, camZ + dz * t];
    }

    // ---- camera, renderer, material ----

    function updateCamera() {
        camX = math.sin(camAngle) * math.cos(camPitch) * camDist;
        camY = math.sin(camPitch) * camDist;
        camZ = math.cos(camAngle) * math.cos(camPitch) * camDist;
        var fx = 0.0 - camX;
        var fy = 0.4 - camY;
        var fz = 0.0 - camZ;
        var fl = math.sqrt(fx * fx + fy * fy + fz * fz);
        fwdX = fx / fl;
        fwdY = fy / fl;
        fwdZ = fz / fl;
        var rl = math.sqrt(fwdZ * fwdZ + fwdX * fwdX);
        rightX = (0.0 - fwdZ) / rl;
        rightY = 0.0;
        rightZ = fwdX / rl;
        upX = rightY * fwdZ - rightZ * fwdY;
        upY = rightZ * fwdX - rightX * fwdZ;
        upZ = rightX * fwdY - rightY * fwdX;
    }

    var renderer = three.createRenderer(width, height, "#app");
    three.setClearColor(renderer, "#0b1120");
    three.setRendererSize(renderer, width, height);
    three.setAutoRenderScale(renderer, 60, 0.5, 1);

    var scene = three.createScene();
    var camera = three.createOrthographicCamera(-1, 1, 1, -1, 0, 1);

    resetScene();
    buildProgram();
    var programTexture = three.createDataTexture(MAX_OPS * 2, 1, program, { "type": "float" });

    var material = three.createShaderMaterial({
        "vertexShader": vertexShader,
        "fragmentShader": fragmentShader,
        "depthWrite": false,
        "uniforms": {
            "uProgram": programTexture,
            "uCount": opCount,
            "uBlend": blend,
            "uSkip": 1.0,
            "uBoxMin": boxMin,
            "uBoxMax": boxMax,
            "uCamPos": [0, 4, 10],
            "uCamForward": [0, 0, -1],
            "uCamRight": [1, 0, 0],
            "uCamUp": [0, 1, 0],
            "uTanHalf": tanHalf,
            "uAspect": aspect
        }
    });
    three.add(scene, three.createMesh(three.createPlaneGeometry(2, 2), material));

    var statusMs = 0.0;

    function showStatus() {
        var stats = three.getStats();
        var mode = "add";
        if (cutMode) {
            mode = "cut";
        }
        var skipText = "off";
        if (skipOn) {
            skipText = "on";
        }
        dom.setText(status, "Tool: " + SHAPE_NAMES[tool] + " (" + mode + ")   Objects " + string(objects.length)
            + "   Instructions " + string(opCount) + " / " + string(MAX_OPS)
            + "   Blend " + string(math.round(blend * 100) / 100) + "   Ray culling " + skipText
            + "   Texture uploads " + string(uploads) + "   Shader compiles 1   "
            + string(math.round(stats.fps)) + " fps");
    }

    function update(dtMs) {
        var dt = math.min(dtMs, 50) / 1000;
        timeSec = timeSec + dt;

        if (three.isKeyDown("arrowleft")) {
            camAngle = camAngle - dt * 1.2;
        }
        if (three.isKeyDown("arrowright")) {
            camAngle = camAngle + dt * 1.2;
        }
        if (three.isKeyDown("arrowup")) {
            camPitch = math.min(camPitch + dt * 0.8, 1.35);
        }
        if (three.isKeyDown("arrowdown")) {
            camPitch = math.max(camPitch - dt * 0.8, 0.08);
        }
        if (three.isKeyDown("+") || three.isKeyDown("=")) {
            camDist = math.max(camDist - dt * 6, 4);
        }
        if (three.isKeyDown("-")) {
            camDist = math.min(camDist + dt * 6, 24);
        }

        for (var k = 0; k < 4; k++) {
            if (three.wasKeyPressed(string(k + 1))) {
                tool = k;
            }
        }
        if (three.wasKeyPressed("x")) {
            cutMode = !cutMode;
        }
        if (three.wasKeyPressed("b")) {
            skipOn = !skipOn;
            three.setUniform(material, "uSkip", skipOn ? 1.0 : 0.0);
        }
        if (three.wasKeyPressed("m")) {
            motionOn = !motionOn;
            dirty = true;
        }
        if (three.wasKeyPressed("r")) {
            resetScene();
        }
        if (three.wasKeyPressed("backspace") && objects.length > 0) {
            var removed = objects.pop();
            opCount = opCount - opsFor(removed);
            dirty = true;
        }
        if (three.wasKeyPressed("[")) {
            blend = math.max(blend - 0.05, 0.0);
            dirty = true;
        }
        if (three.wasKeyPressed("]")) {
            blend = math.min(blend + 0.05, 1.0);
            dirty = true;
        }

        updateCamera();

        if (three.wasMousePressed(0)) {
            var mx = three.getMouseX();
            var my = three.getMouseY();
            if (mx >= 0 && my >= 0 && mx < width && my < height) {
                var hitPoint = pickSurface(mx, my);
                if (hitPoint != null) {
                    var size = 0.45;
                    if (cutMode) {
                        size = 0.6;
                    }
                    addObject(tool, hitPoint[0], hitPoint[1], hitPoint[2], size, cutMode);
                }
            }
        }

        // Only data changes: rewrite the program texture, never the shader.
        if (dirty || motionOn) {
            buildProgram();
            three.updateDataTexture(programTexture, program);
            three.setUniform(material, "uCount", opCount);
            three.setUniform(material, "uBlend", blend);
            three.setUniform(material, "uBoxMin", boxMin);
            three.setUniform(material, "uBoxMax", boxMax);
            uploads = uploads + 1;
            dirty = false;
        }

        three.setUniform(material, "uCamPos", [camX, camY, camZ]);
        three.setUniform(material, "uCamForward", [fwdX, fwdY, fwdZ]);
        three.setUniform(material, "uCamRight", [rightX, rightY, rightZ]);
        three.setUniform(material, "uCamUp", [upX, upY, upZ]);

        statusMs = statusMs + dtMs;
        if (statusMs > 250) {
            statusMs = 0.0;
            showStatus();
        }
    }

    function render() {
        three.render(renderer, scene, camera);
    }

    showStatus();
    three.start(update, render);
}
