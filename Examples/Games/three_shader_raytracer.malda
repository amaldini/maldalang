@shader()
function vertexMain() {
    vUv = uv;
    gl_Position = vec4(position.xy, 0.0, 1.0);
}

@shader()
function hitSphere(center: vec3, radius: float, origin: vec3, dir: vec3) -> float {
    var oc: vec3 = origin - center;
    var a: float = dot(dir, dir);
    var b: float = dot(oc, dir);
    var c: float = dot(oc, oc) - radius * radius;
    var disc: float = b * b - a * c;
    if (disc < 0.0) {
        return -1.0;
    }
    var root: float = sqrt(disc);
    var t: float = (-b - root) / a;
    if (t > EPSILON) {
        return t;
    }
    t = (-b + root) / a;
    if (t > EPSILON) {
        return t;
    }
    return -1.0;
}

@shader()
function closestHit(
    origin: vec3,
    dir: vec3,
    tMax: float,
    includeGlass: bool,
    tHit: out float,
    kind: out int,
    index: out int,
    material: out int,
    normal: out vec3,
    albedo: out vec3
) -> bool {
    tHit = tMax;
    kind = 0;
    index = -1;
    material = 0;
    normal = vec3(0.0, 1.0, 0.0);
    albedo = vec3(0.0);

    var c0: vec3 = vec3(0.0, 1.0, 0.0);
    var c1: vec3 = vec3(-1.85, 0.55, 0.35);
    var c2: vec3 = vec3(1.55, 0.42, -0.28);
    var r0: float = 1.0;
    var r1: float = 0.55;
    var r2: float = 0.42;

    var t0: float = hitSphere(c0, r0, origin, dir);
    if (includeGlass) {
        if (t0 > 0.0 && t0 < tHit) {
            tHit = t0;
            kind = 1;
            index = 0;
        }
    }
    var t1: float = hitSphere(c1, r1, origin, dir);
    if (t1 > 0.0 && t1 < tHit) {
        tHit = t1;
        kind = 1;
        index = 1;
    }
    var t2: float = hitSphere(c2, r2, origin, dir);
    if (t2 > 0.0 && t2 < tHit) {
        tHit = t2;
        kind = 1;
        index = 2;
    }

    if (abs(dir.y) > EPSILON) {
        var tPlane: float = -origin.y / dir.y;
        if (tPlane > EPSILON && tPlane < tHit) {
            tHit = tPlane;
            kind = 2;
            index = -1;
        }
    }

    if (kind == 0) {
        return false;
    }

    var hit: vec3 = origin + dir * tHit;
    if (kind == 1) {
        if (index == 0) {
            normal = (hit - c0) / r0;
            albedo = vec3(0.86, 0.22, 0.18);
            material = 2;
        } else if (index == 1) {
            normal = (hit - c1) / r1;
            albedo = vec3(0.72, 0.84, 0.98);
            material = 1;
        } else {
            normal = (hit - c2) / r2;
            albedo = vec3(0.95, 0.74, 0.22);
            material = 0;
        }
    } else {
        normal = vec3(0.0, 1.0, 0.0);
        material = 0;
        if (dot(normal, dir) > 0.0) {
            normal = -normal;
        }
        var check: float = mod(floor(hit.x) + floor(hit.z), 2.0);
        if (check < 0.5) {
            albedo = vec3(0.78, 0.78, 0.74);
        } else {
            albedo = vec3(0.18, 0.22, 0.20);
        }
    }
    normal = normalize(normal);
    return true;
}

@shader()
function inShadow(hit: vec3, normal: vec3) -> bool {
    var origin: vec3 = hit + normal * 0.02;
    var toLight: vec3 = uLightPos - origin;
    var lightDist: float = length(toLight);
    if (lightDist <= EPSILON) {
        return false;
    }
    var dir: vec3 = toLight / lightDist;
    var tHit: float = 0.0;
    var kind: int = 0;
    var index: int = 0;
    var material: int = 0;
    var n: vec3 = vec3(0.0);
    var albedo: vec3 = vec3(0.0);
    return closestHit(origin, dir, lightDist - 0.05, false, tHit, kind, index, material, n, albedo);
}

@shader()
function localShade(hit: vec3, normal: vec3, albedo: vec3) -> vec3 {
    var toLight: vec3 = uLightPos - hit;
    var lightDir: vec3 = normalize(toLight);
    var diff: float = max(dot(normal, lightDir), 0.0);
    var light: float = 0.12;
    if (!inShadow(hit, normal)) {
        light = 0.12 + diff * 0.88;
    }
    return albedo * light;
}

@shader()
function shadeSky(dir: vec3) -> vec3 {
    var t: float = clamp((dir.y + 1.0) * 0.5, 0.0, 1.0);
    return mix(vec3(0.62, 0.78, 0.96), vec3(0.16, 0.38, 0.74), t);
}

@shader()
function shadePrimary(origin: vec3, dir: vec3) -> vec3 {
    var tHit: float = 0.0;
    var kind: int = 0;
    var index: int = 0;
    var material: int = 0;
    var normal: vec3 = vec3(0.0);
    var albedo: vec3 = vec3(0.0);
    if (!closestHit(origin, dir, 1000000.0, true, tHit, kind, index, material, normal, albedo)) {
        return shadeSky(dir);
    }
    var hit: vec3 = origin + dir * tHit;
    return localShade(hit, normal, albedo);
}

@shader()
function traceScene(origin: vec3, dir: vec3) -> vec3 {
    var ro: vec3 = origin;
    var rd: vec3 = dir;
    var throughput: vec3 = vec3(1.0);
    var color: vec3 = vec3(0.0);
    var bounce: int = 0;
    while (bounce < 8) {
        bounce = bounce + 1;
        var tHit: float = 0.0;
        var kind: int = 0;
        var index: int = 0;
        var material: int = 0;
        var normal: vec3 = vec3(0.0);
        var albedo: vec3 = vec3(0.0);
        if (!closestHit(ro, rd, 1000000.0, true, tHit, kind, index, material, normal, albedo)) {
            color = color + throughput * shadeSky(rd);
            break;
        }

        var hit: vec3 = ro + rd * tHit;
        if (material == 1) {
            var mirrorLocal: vec3 = localShade(hit, normal, albedo * 0.06);
            color = color + throughput * mirrorLocal;
            var mirrorCos: float = max((-dot(rd, normal)), 0.0);
            var mirrorF: float = 0.62 + 0.38 * pow(1.0 - mirrorCos, 5.0);
            throughput = throughput * (mirrorF * albedo);
            rd = reflect(rd, normal);
            ro = hit + normal * 0.02;
        } else if (material == 2) {
            // Low IOR so the sphere stays see-through. n=1.45 is a ball lens:
            // it inverts the floor into the top half and fills the bottom.
            var n: vec3 = normal;
            var entering: bool = dot(rd, n) < 0.0;
            if (!entering) {
                n = -n;
            }
            var eta: float = 1.0 / GLASS_IOR;
            if (!entering) {
                eta = GLASS_IOR;
            }
            var glassCos: float = max((-dot(rd, n)), 0.0);
            var glassF: float = 0.05 + 0.40 * pow(1.0 - glassCos, 5.0);
            var reflDir: vec3 = reflect(rd, n);
            color = color + throughput * glassF * shadePrimary(hit + n * 0.02, reflDir);
            var refrDir: vec3 = refract(rd, n, eta);
            if (dot(refrDir, refrDir) < EPSILON) {
                rd = reflDir;
                ro = hit + n * 0.02;
            } else if (entering) {
                var innerDir: vec3 = normalize(refrDir);
                var innerOrig: vec3 = hit + innerDir * 0.02;
                var glassC: vec3 = vec3(0.0, 1.0, 0.0);
                var tExit: float = hitSphere(glassC, 1.0, innerOrig, innerDir);
                if (tExit < EPSILON) {
                    throughput = throughput * ((1.0 - glassF) * mix(vec3(1.0), albedo, 0.22));
                    rd = innerDir;
                    ro = innerOrig;
                } else {
                    var hitExit: vec3 = innerOrig + innerDir * tExit;
                    var nExit: vec3 = -normalize(hitExit - glassC);
                    var etaOut: float = GLASS_IOR;
                    var outDir: vec3 = refract(innerDir, nExit, etaOut);
                    var tintAmt: float = clamp(0.14 + tExit * 0.12, 0.14, 0.36);
                    throughput = throughput * ((1.0 - glassF) * mix(vec3(1.0), albedo, tintAmt));
                    if (dot(outDir, outDir) < EPSILON) {
                        rd = reflect(innerDir, nExit);
                        ro = hitExit + nExit * 0.02;
                    } else {
                        rd = normalize(outDir);
                        ro = hitExit + rd * 0.02;
                    }
                }
            } else {
                throughput = throughput * ((1.0 - glassF) * mix(vec3(1.0), albedo, 0.18));
                rd = normalize(refrDir);
                ro = hit + rd * 0.02;
            }
        } else {
            color = color + throughput * localShade(hit, normal, albedo);
            break;
        }
    }
    return color;
}

@shader()
function fragmentMain() {
    var ndc: vec2 = vUv * 2.0 - 1.0;
    var dir: vec3 = normalize(
        uCamForward
        + uCamRight * (ndc.x * uAspect * uTanHalf)
        + uCamUp * (ndc.y * uTanHalf)
    );
    var color: vec3 = traceScene(uCamPos, dir);
    gl_FragColor = vec4(sqrt(color), 1.0);
}

var vertexShader = glsl.compile({
    varyings: ["vec2 vUv"],
    functions: ["vertexMain"],
    main: "vertexMain"
});

var fragmentShader = glsl.compile({
    varyings: ["vec2 vUv"],
    uniforms: [
        "vec2 uResolution",
        "vec3 uCamPos",
        "vec3 uCamForward",
        "vec3 uCamRight",
        "vec3 uCamUp",
        "vec3 uLightPos",
        "float uTanHalf",
        "float uAspect"
    ],
    consts: ["float EPSILON = 0.0015", "float GLASS_IOR = 1.1"],
    functions: ["hitSphere", "closestHit", "inShadow", "localShade", "shadeSky", "shadePrimary", "traceScene", "fragmentMain"],
    main: "fragmentMain"
});

var root = dom.query("#app");

if (root == null) {
    println("No #app container found.");
} else {
    dom.clear(root);

    var heading = dom.create("h1");
    dom.setText(heading, "MALDA GPU Ray Tracer");
    dom.append(root, heading);

    var hint = dom.create("p");
    dom.setText(hint, "Realtime GLSL tracer via three.createShaderMaterial. The large red sphere is lightly refractive tinted glass; the blue sphere is a mirror. Left/Right change orbit speed. Move the mouse to slide the light.");
    dom.append(root, hint);

    var width = 960;
    var height = 540;
    var aspect = width / height;
    var tanHalf = math.tan(math.degToRad(28));

    var camRadius = 4.35;
    var camAngle = 0.55;
    var camSpeed = 0.55;
    var camX = 0.0;
    var camY = 1.65;
    var camZ = 0.0;
    var forwardX = 0.0;
    var forwardY = 0.0;
    var forwardZ = 1.0;
    var rightX = 1.0;
    var rightY = 0.0;
    var rightZ = 0.0;
    var upX = 0.0;
    var upY = 1.0;
    var upZ = 0.0;

    var lightX = 5.0;
    var lightY = 8.5;
    var lightZ = 3.2;
    var lastMouseX = -1;
    var lastMouseY = -1;

    function updateCamera() {
        camX = math.sin(camAngle) * camRadius;
        camY = 1.65;
        camZ = math.cos(camAngle) * camRadius;

        var fx = 0.0 - camX;
        var fy = 0.85 - camY;
        var fz = 0.0 - camZ;
        var fl = math.sqrt(fx * fx + fy * fy + fz * fz);
        fx = fx / fl;
        fy = fy / fl;
        fz = fz / fl;

        var rx = 0 - fz;
        var ry = 0.0;
        var rz = fx;
        var rl = math.sqrt(rx * rx + ry * ry + rz * rz);
        rx = rx / rl;
        ry = ry / rl;
        rz = rz / rl;

        forwardX = fx;
        forwardY = fy;
        forwardZ = fz;
        rightX = rx;
        rightY = ry;
        rightZ = rz;
        upX = ry * fz - rz * fy;
        upY = rz * fx - rx * fz;
        upZ = rx * fy - ry * fx;
    }

    var renderer = three.createRenderer(width, height, "#app");
    three.setClearColor(renderer, "#020617");
    three.setRendererSize(renderer, width, height);

    var scene = three.createScene();
    var camera = three.createOrthographicCamera(-1, 1, 1, -1, 0, 1);

    var material = three.createShaderMaterial({
        "vertexShader": vertexShader,
        "fragmentShader": fragmentShader,
        "depthWrite": false,
        "uniforms": {
            "uResolution": [width, height],
            "uCamPos": [0, 1.65, 4.35],
            "uCamForward": [0, 0, -1],
            "uCamRight": [1, 0, 0],
            "uCamUp": [0, 1, 0],
            "uLightPos": [lightX, lightY, lightZ],
            "uTanHalf": tanHalf,
            "uAspect": aspect
        }
    });

    var quad = three.createMesh(three.createPlaneGeometry(2, 2), material);
    three.add(scene, quad);

    function pushCameraUniforms() {
        three.setUniform(material, "uCamPos", [camX, camY, camZ]);
        three.setUniform(material, "uCamForward", [forwardX, forwardY, forwardZ]);
        three.setUniform(material, "uCamRight", [rightX, rightY, rightZ]);
        three.setUniform(material, "uCamUp", [upX, upY, upZ]);
        three.setUniform(material, "uLightPos", [lightX, lightY, lightZ]);
    }

    updateCamera();
    pushCameraUniforms();

    function update(dtMs) {
        var dt = dtMs;
        if (dt > 50) {
            dt = 50;
        }

        if (three.isKeyDown("arrowleft")) {
            camSpeed = camSpeed - ((1.2 * dt) / 1000);
        }
        if (three.isKeyDown("arrowright")) {
            camSpeed = camSpeed + ((1.2 * dt) / 1000);
        }
        if (camSpeed < -2.4) {
            camSpeed = -2.4;
        }
        if (camSpeed > 2.4) {
            camSpeed = 2.4;
        }

        camAngle = camAngle + ((camSpeed * dt) / 1000);

        var mx = int(three.getMouseX());
        var my = int(three.getMouseY());
        if (lastMouseX < 0) {
            lastMouseX = mx;
            lastMouseY = my;
        } else if (mx != lastMouseX || my != lastMouseY) {
            lastMouseX = mx;
            lastMouseY = my;
            lightX = 4.2 + ((mx / width) - 0.5) * 12;
            lightZ = 2.4 - ((my / height) - 0.5) * 8;
        }

        updateCamera();
        pushCameraUniforms();
    }

    function render() {
        three.render(renderer, scene, camera);
    }

    three.start(update, render);
}
