// Grand Prix neural race.
// Run: malda play Examples/Games/grand_prix_neural.malda
//
// Eight cars share a 12-20-2 net (tanh, tanh). Each step the net sees lateral
// error, heading error, speed, three looks at curvature, five edge rays, and
// a constant. A pure-pursuit coach labels steer and throttle; nn.denseBackward
// fits those labels with nn.mseGrad. While the loss is high the coach drives.
// As it falls, the blend hands the grid to the network.
//
// Centerlines are original simplified drawings of the public circuit shapes.
// They are not a copied GPS trace.
//
// Q/E or the buttons change circuit. C chase camera. Tab drive (WASD / arrows).
// N network only. T coach only. L blend again. R reset the brain. Space pause.

function wrapAngle(a: float) -> float {
    var turns = math.floor((a + 3.14159265) / 6.2831853);
    return a - turns * 6.2831853;
}

function wrapIndex(i: int, n: int) -> int {
    if (n < 1) {
        return 0;
    }
    var k = i % n;
    if (k < 0) {
        k = k + n;
    }
    return k;
}

function formatTime(seconds: float) -> string {
    if (seconds < 0.0) {
        return "--:--.---";
    }
    var mins = int(seconds / 60.0);
    var rem = seconds - mins * 60.0;
    var whole = int(rem);
    var ms = int((rem - whole) * 1000.0);
    if (ms < 0) {
        ms = 0;
    }
    if (ms > 999) {
        ms = 999;
    }
    return string(mins) + ":" + str.padStart(string(whole), 2, "0") + "." + str.padStart(string(ms), 3, "0");
}

function randomMatrix(rows: int, cols: int, scale: float) -> array {
    var matrix = [];
    for (var i = 0; i < rows; i = i + 1) {
        var row = [];
        for (var j = 0; j < cols; j = j + 1) {
            row.append(math.randomFloat(-scale, scale));
        }
        matrix.append(row);
    }
    return matrix;
}

function randomVector(n: int, scale: float) -> array {
    var values = [];
    for (var i = 0; i < n; i = i + 1) {
        values.append(math.randomFloat(-scale, scale));
    }
    return values;
}

function zeroMatrix(rows: int, cols: int) -> array {
    var matrix = [];
    for (var i = 0; i < rows; i = i + 1) {
        var row = [];
        for (var j = 0; j < cols; j = j + 1) {
            row.append(0.0);
        }
        matrix.append(row);
    }
    return matrix;
}

function zeroVector(n: int) -> array {
    var values = [];
    for (var i = 0; i < n; i = i + 1) {
        values.append(0.0);
    }
    return values;
}

function addMatrix(dst: array, src: array) {
    for (var i = 0; i < dst.length; i = i + 1) {
        for (var j = 0; j < dst[i].length; j = j + 1) {
            dst[i][j] = dst[i][j] + src[i][j];
        }
    }
}

function addVector(dst: array, src: array) {
    for (var i = 0; i < dst.length; i = i + 1) {
        dst[i] = dst[i] + src[i];
    }
}

function applyMatrix(weights: array, grad: array, lr: float) {
    for (var i = 0; i < weights.length; i = i + 1) {
        for (var j = 0; j < weights[i].length; j = j + 1) {
            var g = grad[i][j];
            if (g > 4.0) {
                g = 4.0;
            }
            if (g < -4.0) {
                g = -4.0;
            }
            weights[i][j] = weights[i][j] - lr * g;
        }
    }
}

function applyVector(bias: array, grad: array, lr: float) {
    for (var i = 0; i < bias.length; i = i + 1) {
        var g = grad[i];
        if (g > 4.0) {
            g = 4.0;
        }
        if (g < -4.0) {
            g = -4.0;
        }
        bias[i] = bias[i] - lr * g;
    }
}

