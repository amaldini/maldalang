var root = dom.query("#app");

if (root == null) {
    println("No #app container found.");
} else {
    dom.clear(root);

    var head = dom.query("head");
    if (head != null) {
        var styleNode = dom.create("style");
        var styleText = "body { margin: 0; background: #0f172a; color: #e2e8f0; font-family: sans-serif; }\n";
        styleText = styleText + "h1, p { max-width: 960px; margin: 12px auto; padding: 0 12px; }\n";
        styleText = styleText + "#app canvas { width: 100%; max-width: 960px; height: auto; display: block; margin: 0 auto; touch-action: none; }\n";
        dom.setText(styleNode, styleText);
        dom.append(head, styleNode);
    }

    var title = dom.create("h1");
    dom.setText(title, "MALDA Game: Chess");
    dom.append(root, title);

    var hint = dom.create("p");
    dom.setText(hint, "Click or tap a piece, then a highlighted square. R new game. U undo. C toggle computer (Black). Pawns promote to queen.");
    dom.append(root, hint);

    // ---------------------------------------------------------------------------
    // How to read this file
    //
    // The board is a 64-slot array. Index 0 is a8 (top-left on screen), 63 is h1.
    // Row 0 is rank 8; row 7 is rank 1. Column 0 is file a.
    //
    // A cell is EMPTY (0) or kind * side:
    //   kind   PAWN=1 KNIGHT=2 BISHOP=3 ROOK=4 QUEEN=5 KING=6
    //   side   WHITE=+1  BLACK=-1
    // White's king is +6, Black's king is -6. Same-side test: piece * side > 0.
    // Integers (not sum types) so color is the sign, captures use arithmetic,
    // and game.save stores a plain JSON array.
    //
    // Move flags and game status are named `const` values — MALDA's enum style.
    // `const NAME;` means the string "NAME"; `match` compares those consts with ==.
    // Status strings stay "play"/"check"/"mate"/"stale" so old saves still load.
    //
    // Specials: king-side / queen-side castle, en passant, always-queen promotion.
    // Castling rights are four booleans. `epSq` is the square a capturing pawn
    // would land on (the jumped-over square), or NO_SQUARE.
    // ---------------------------------------------------------------------------

    const EMPTY = 0;
    const PAWN = 1;
    const KNIGHT = 2;
    const BISHOP = 3;
    const ROOK = 4;
    const QUEEN = 5;
    const KING = 6;

    const WHITE = 1;
    const BLACK = -1;
    const NO_SQUARE = -1;

    // Algebraic indices for the squares the rules actually name (castling).
    const A8 = 0;
    const B8 = 1;
    const C8 = 2;
    const D8 = 3;
    const E8 = 4;
    const F8 = 5;
    const G8 = 6;
    const H8 = 7;
    const A1 = 56;
    const B1 = 57;
    const C1 = 58;
    const D1 = 59;
    const E1 = 60;
    const F1 = 61;
    const G1 = 62;
    const H1 = 63;

    const WHITE_PAWN_ROW = 6;
    const BLACK_PAWN_ROW = 1;
    const WHITE_PROMO_ROW = 0;
    const BLACK_PROMO_ROW = 7;

    const MOVE_NORMAL, MOVE_CASTLE_KING, MOVE_CASTLE_QUEEN, MOVE_EN_PASSANT, MOVE_PROMOTE;
    const STATUS_PLAY = "play";
    const STATUS_CHECK = "check";
    const STATUS_MATE = "mate";
    const STATUS_STALE = "stale";

    const CANVAS_W = 960;
    const CANVAS_H = 640;
    const TILE = 68;
    const BOARD_X = 28;
    const BOARD_Y = 28;
    const PANEL_X = 600;
    const BTN_W = 320;
    const BTN_H = 40;
    const BTN_NEW_Y = 248;
    const BTN_UNDO_Y = 298;
    const BTN_CPU_Y = 348;

    const AI_THINK_MS = 220;
    const AI_EXTRA_PLY = 1;
    const MATE_SCORE = 20000;

    const FILES = ["a", "b", "c", "d", "e", "f", "g", "h"];

    // Knight leaps: pair KNIGHT_DR[i] with KNIGHT_DC[i].
    const KNIGHT_DR = [-2, -2, -1, -1, 1, 1, 2, 2];
    const KNIGHT_DC = [-1, 1, -2, 2, -2, 2, -1, 1];
    const KING_DR = [-1, -1, -1, 0, 0, 1, 1, 1];
    const KING_DC = [-1, 0, 1, -1, 1, -1, 0, 1];
    // Slider rays: 0..3 rook (N,S,W,E), 4..7 bishop.
    const SLIDE_DR = [-1, 1, 0, 0, -1, -1, 1, 1];
    const SLIDE_DC = [0, 0, -1, 1, -1, 1, -1, 1];
    const RAY_ROOK_START = 0;
    const RAY_ROOK_STOP = 4;
    const RAY_BISHOP_START = 4;
    const RAY_BISHOP_STOP = 8;

    // Centipawns by pieceKind. King is 0 — mate is a search terminal, not material.
    const MATERIAL = [0, 100, 320, 330, 500, 900, 0];

    var board = [];
    var side = WHITE;
    var castleWK = true;
    var castleWQ = true;
    var castleBK = true;
    var castleBQ = true;
    var epSq = NO_SQUARE;
    var selSq = NO_SQUARE;
    var legalForSel = [];
    var lastFrom = NO_SQUARE;
    var lastTo = NO_SQUARE;
    var status = STATUS_PLAY;
    var vsCpu = true;
    var aiWaitMs = 0;
    var aiThinking = false;
    var history = [];
    var winsW = 0;
    var winsB = 0;
    var gameOverLogged = false;
    var audioBooted = false;
    var hoverSq = NO_SQUARE;

    var saved = game.load("chess_save");
    if (saved != null) {
        if (saved.winsW != null) {
            winsW = saved.winsW;
        }
        if (saved.winsB != null) {
            winsB = saved.winsB;
        }
        if (saved.vsCpu != null) {
            vsCpu = saved.vsCpu;
        }
    }

    // --- squares and pieces ---------------------------------------------------

    function rowOf(sq) {
        return math.floor(sq / 8);
    }

    function colOf(sq) {
        return sq % 8;
    }

    function at(row, col) {
        return row * 8 + col;
    }

    function onBoard(row, col) {
        return row >= 0 and row < 8 and col >= 0 and col < 8;
    }

    function pieceKind(piece) {
        if (piece < 0) {
            return 0 - piece;
        }
        return piece;
    }

    function coded(kind, who) {
        return kind * who;
    }

    function opponent(who) {
        return 0 - who;
    }

    function isEmpty(piece) {
        return piece == EMPTY;
    }

    function isWhite(piece) {
        return piece > 0;
    }

    function isFriendly(piece, who) {
        return piece * who > 0;
    }

    function isEnemy(piece, who) {
        return piece != EMPTY and piece * who < 0;
    }

    // --- position snapshot (search, undo, save) -------------------------------

    function cloneBoard() {
        var out = [];
        for (var i = 0; i < 64; i = i + 1) {
            out.append(board[i]);
        }
        return out;
    }

    function snapshot() {
        return {
            "board": cloneBoard(),
            "side": side,
            "wk": castleWK,
            "wq": castleWQ,
            "bk": castleBK,
            "bq": castleBQ,
            "ep": epSq,
            "lastFrom": lastFrom,
            "lastTo": lastTo,
            "status": status,
            "logged": gameOverLogged
        };
    }

    function restore(s) {
        for (var i = 0; i < 64; i = i + 1) {
            board[i] = s.board[i];
        }
        side = s.side;
        castleWK = s.wk;
        castleWQ = s.wq;
        castleBK = s.bk;
        castleBQ = s.bq;
        epSq = s.ep;
        lastFrom = s.lastFrom;
        lastTo = s.lastTo;
        status = s.status;
        gameOverLogged = s.logged;
    }

    function setupStart() {
        board = [];
        for (var i = 0; i < 64; i = i + 1) {
            board.append(EMPTY);
        }
        var backRank = [ROOK, KNIGHT, BISHOP, QUEEN, KING, BISHOP, KNIGHT, ROOK];
        for (var file = 0; file < 8; file = file + 1) {
            board[at(0, file)] = coded(backRank[file], BLACK);
            board[at(BLACK_PAWN_ROW, file)] = coded(PAWN, BLACK);
            board[at(WHITE_PAWN_ROW, file)] = coded(PAWN, WHITE);
            board[at(7, file)] = coded(backRank[file], WHITE);
        }
        side = WHITE;
        castleWK = true;
        castleWQ = true;
        castleBK = true;
        castleBQ = true;
        epSq = NO_SQUARE;
        selSq = NO_SQUARE;
        legalForSel = [];
        lastFrom = NO_SQUARE;
        lastTo = NO_SQUARE;
        status = STATUS_PLAY;
        history = [];
        gameOverLogged = false;
        aiWaitMs = 0;
        aiThinking = false;
    }

    function persist() {
        game.save("chess_save", {
            "board": cloneBoard(),
            "side": side,
            "wk": castleWK,
            "wq": castleWQ,
            "bk": castleBK,
            "bq": castleBQ,
            "ep": epSq,
            "lastFrom": lastFrom,
            "lastTo": lastTo,
            "status": status,
            "vsCpu": vsCpu,
            "winsW": winsW,
            "winsB": winsB,
            "logged": gameOverLogged
        });
    }

    function tryLoadGame() {
        if (saved == null) {
            return false;
        }
        if (saved.board == null) {
            return false;
        }
        if (saved.board.length != 64) {
            return false;
        }
        board = [];
        for (var i = 0; i < 64; i = i + 1) {
            board.append(saved.board[i]);
        }
        side = saved.side;
        castleWK = saved.wk;
        castleWQ = saved.wq;
        castleBK = saved.bk;
        castleBQ = saved.bq;
        epSq = saved.ep;
        lastFrom = saved.lastFrom;
        lastTo = saved.lastTo;
        status = saved.status;
        gameOverLogged = saved.logged;
        if (gameOverLogged == null) {
            gameOverLogged = false;
        }
        if (status == null) {
            status = STATUS_PLAY;
        }
        return true;
    }

    // --- attacks --------------------------------------------------------------

    function findKing(who) {
        var want = coded(KING, who);
        for (var i = 0; i < 64; i = i + 1) {
            if (board[i] == want) {
                return i;
            }
        }
        return NO_SQUARE;
    }

    function slideHits(sq, dr, dc, wantA, wantB) {
        var r = rowOf(sq) + dr;
        var c = colOf(sq) + dc;
        while (onBoard(r, c)) {
            var p = board[at(r, c)];
            if (!isEmpty(p)) {
                return p == wantA or p == wantB;
            }
            r = r + dr;
            c = c + dc;
        }
        return false;
    }

    function isAttacked(sq, bySide) {
        if (sq == NO_SQUARE) {
            return false;
        }
        var r = rowOf(sq);
        var c = colOf(sq);

        // A pawn attacks one row forward. Look one row backward from the target.
        var pawnBack = 1;
        if (bySide == BLACK) {
            pawnBack = -1;
        }
        var dc = -1;
        while (dc <= 1) {
            if (dc != 0) {
                var pr = r + pawnBack;
                var pc = c + dc;
                if (onBoard(pr, pc) and board[at(pr, pc)] == coded(PAWN, bySide)) {
                    return true;
                }
            }
            dc = dc + 1;
        }

        for (var i = 0; i < 8; i = i + 1) {
            var nr = r + KNIGHT_DR[i];
            var nc = c + KNIGHT_DC[i];
            if (onBoard(nr, nc) and board[at(nr, nc)] == coded(KNIGHT, bySide)) {
                return true;
            }
        }
        for (var i = 0; i < 8; i = i + 1) {
            var kr = r + KING_DR[i];
            var kc = c + KING_DC[i];
            if (onBoard(kr, kc) and board[at(kr, kc)] == coded(KING, bySide)) {
                return true;
            }
        }

        var bishop = coded(BISHOP, bySide);
        var queen = coded(QUEEN, bySide);
        var rook = coded(ROOK, bySide);
        for (var i = RAY_BISHOP_START; i < RAY_BISHOP_STOP; i = i + 1) {
            if (slideHits(sq, SLIDE_DR[i], SLIDE_DC[i], bishop, queen)) {
                return true;
            }
        }
        for (var i = RAY_ROOK_START; i < RAY_ROOK_STOP; i = i + 1) {
            if (slideHits(sq, SLIDE_DR[i], SLIDE_DC[i], rook, queen)) {
                return true;
            }
        }
        return false;
    }

    // --- move generation ------------------------------------------------------

    function pushMove(moves, from, to, flag) {
        moves.append({ "from": from, "to": to, "flag": flag });
    }

    function addPawnMoves(moves, from, who) {
        var r = rowOf(from);
        var c = colOf(from);
        var forward = -1;
        var startRow = WHITE_PAWN_ROW;
        var promoRow = WHITE_PROMO_ROW;
        if (who == BLACK) {
            forward = 1;
            startRow = BLACK_PAWN_ROW;
            promoRow = BLACK_PROMO_ROW;
        }
        var nr = r + forward;
        if (!onBoard(nr, c)) {
            return;
        }
        var ahead = at(nr, c);
        if (isEmpty(board[ahead])) {
            if (nr == promoRow) {
                pushMove(moves, from, ahead, MOVE_PROMOTE);
            } else {
                pushMove(moves, from, ahead, MOVE_NORMAL);
                if (r == startRow) {
                    var jump = at(r + forward + forward, c);
                    if (isEmpty(board[jump])) {
                        pushMove(moves, from, jump, MOVE_NORMAL);
                    }
                }
            }
        }
        var d = -1;
        while (d <= 1) {
            if (d != 0) {
                var nc = c + d;
                if (onBoard(nr, nc)) {
                    var dest = at(nr, nc);
                    var victim = board[dest];
                    if (isEnemy(victim, who)) {
                        if (nr == promoRow) {
                            pushMove(moves, from, dest, MOVE_PROMOTE);
                        } else {
                            pushMove(moves, from, dest, MOVE_NORMAL);
                        }
                    }
                    if (dest == epSq) {
                        pushMove(moves, from, dest, MOVE_EN_PASSANT);
                    }
                }
            }
            d = d + 1;
        }
    }

    function addStepMoves(moves, from, who, drs, dcs) {
        var r = rowOf(from);
        var c = colOf(from);
        for (var i = 0; i < drs.length; i = i + 1) {
            var nr = r + drs[i];
            var nc = c + dcs[i];
            if (onBoard(nr, nc)) {
                var dest = at(nr, nc);
                var victim = board[dest];
                if (isEmpty(victim) or isEnemy(victim, who)) {
                    pushMove(moves, from, dest, MOVE_NORMAL);
                }
            }
        }
    }

    function addSlideMoves(moves, from, who, start, stop) {
        var r0 = rowOf(from);
        var c0 = colOf(from);
        for (var i = start; i < stop; i = i + 1) {
            var r = r0 + SLIDE_DR[i];
            var c = c0 + SLIDE_DC[i];
            while (onBoard(r, c)) {
                var dest = at(r, c);
                var victim = board[dest];
                if (isEmpty(victim)) {
                    pushMove(moves, from, dest, MOVE_NORMAL);
                } else {
                    if (isEnemy(victim, who)) {
                        pushMove(moves, from, dest, MOVE_NORMAL);
                    }
                    break;
                }
                r = r + SLIDE_DR[i];
                c = c + SLIDE_DC[i];
            }
        }
    }

    function addCastleMoves(moves, who) {
        var k = findKing(who);
        if (k == NO_SQUARE) {
            return;
        }
        // Cannot castle out of check (through / into check is tested on the path).
        if (isAttacked(k, opponent(who))) {
            return;
        }
        if (who == WHITE) {
            if (castleWK and isEmpty(board[F1]) and isEmpty(board[G1]) and board[H1] == coded(ROOK, WHITE)) {
                if (!isAttacked(F1, BLACK) and !isAttacked(G1, BLACK)) {
                    pushMove(moves, E1, G1, MOVE_CASTLE_KING);
                }
            }
            if (castleWQ and isEmpty(board[D1]) and isEmpty(board[C1]) and isEmpty(board[B1]) and board[A1] == coded(ROOK, WHITE)) {
                if (!isAttacked(D1, BLACK) and !isAttacked(C1, BLACK)) {
                    pushMove(moves, E1, C1, MOVE_CASTLE_QUEEN);
                }
            }
        } else {
            if (castleBK and isEmpty(board[F8]) and isEmpty(board[G8]) and board[H8] == coded(ROOK, BLACK)) {
                if (!isAttacked(F8, WHITE) and !isAttacked(G8, WHITE)) {
                    pushMove(moves, E8, G8, MOVE_CASTLE_KING);
                }
            }
            if (castleBQ and isEmpty(board[D8]) and isEmpty(board[C8]) and isEmpty(board[B8]) and board[A8] == coded(ROOK, BLACK)) {
                if (!isAttacked(D8, WHITE) and !isAttacked(C8, WHITE)) {
                    pushMove(moves, E8, C8, MOVE_CASTLE_QUEEN);
                }
            }
        }
    }

    function genPseudo(who) {
        var moves = [];
        for (var i = 0; i < 64; i = i + 1) {
            var p = board[i];
            if (isFriendly(p, who)) {
                match pieceKind(p) {
                    case PAWN: {
                        addPawnMoves(moves, i, who);
                    }
                    case KNIGHT: {
                        addStepMoves(moves, i, who, KNIGHT_DR, KNIGHT_DC);
                    }
                    case BISHOP: {
                        addSlideMoves(moves, i, who, RAY_BISHOP_START, RAY_BISHOP_STOP);
                    }
                    case ROOK: {
                        addSlideMoves(moves, i, who, RAY_ROOK_START, RAY_ROOK_STOP);
                    }
                    case QUEEN: {
                        addSlideMoves(moves, i, who, RAY_ROOK_START, RAY_BISHOP_STOP);
                    }
                    case KING: {
                        addStepMoves(moves, i, who, KING_DR, KING_DC);
                    }
                    default: {
                    }
                }
            }
        }
        addCastleMoves(moves, who);
        return moves;
    }

    // --- make move ------------------------------------------------------------

    function applyMove(m) {
        var from = m.from;
        var to = m.to;
        var flag = m.flag;
        var piece = board[from];
        board[to] = piece;
        board[from] = EMPTY;

        match flag {
            case MOVE_EN_PASSANT: {
                // Captured pawn sits one rank behind the landing (jumped-over) square.
                if (isWhite(piece)) {
                    board[to + 8] = EMPTY;
                } else {
                    board[to - 8] = EMPTY;
                }
            }
            case MOVE_PROMOTE: {
                if (isWhite(piece)) {
                    board[to] = coded(QUEEN, WHITE);
                } else {
                    board[to] = coded(QUEEN, BLACK);
                }
            }
            case MOVE_CASTLE_KING: {
                if (isWhite(piece)) {
                    board[H1] = EMPTY;
                    board[F1] = coded(ROOK, WHITE);
                } else {
                    board[H8] = EMPTY;
                    board[F8] = coded(ROOK, BLACK);
                }
            }
            case MOVE_CASTLE_QUEEN: {
                if (isWhite(piece)) {
                    board[A1] = EMPTY;
                    board[D1] = coded(ROOK, WHITE);
                } else {
                    board[A8] = EMPTY;
                    board[D8] = coded(ROOK, BLACK);
                }
            }
            default: {
                // MOVE_NORMAL: the piece already moved onto `to` above.
            }
        }

        if (from == E1 or to == E1) {
            castleWK = false;
            castleWQ = false;
        }
        if (from == E8 or to == E8) {
            castleBK = false;
            castleBQ = false;
        }
        if (from == H1 or to == H1) {
            castleWK = false;
        }
        if (from == A1 or to == A1) {
            castleWQ = false;
        }
        if (from == H8 or to == H8) {
            castleBK = false;
        }
        if (from == A8 or to == A8) {
            castleBQ = false;
        }

        epSq = NO_SQUARE;
        if (pieceKind(piece) == PAWN) {
            if (math.abs(rowOf(to) - rowOf(from)) == 2) {
                epSq = (from + to) / 2;
            }
        }
        side = opponent(side);
    }

    function genLegal(who) {
        var raw = genPseudo(who);
        var out = [];
        for (var i = 0; i < raw.length; i = i + 1) {
            var snap = snapshot();
            applyMove(raw[i]);
            var k = findKing(who);
            if (!isAttacked(k, opponent(who))) {
                out.append(raw[i]);
            }
            restore(snap);
        }
        return out;
    }

    function refreshStatus() {
        var moves = genLegal(side);
        var k = findKing(side);
        var check = isAttacked(k, opponent(side));
        if (moves.length == 0) {
            if (check) {
                status = STATUS_MATE;
            } else {
                status = STATUS_STALE;
            }
        } else if (check) {
            status = STATUS_CHECK;
        } else {
            status = STATUS_PLAY;
        }
        if (status == STATUS_MATE and !gameOverLogged) {
            if (side == WHITE) {
                winsB = winsB + 1;
            } else {
                winsW = winsW + 1;
            }
            gameOverLogged = true;
        }
    }

    function isGameOver() {
        return status == STATUS_MATE or status == STATUS_STALE;
    }

    function bootAudio() {
        if (!audioBooted) {
            game.audioInit();
            game.audioSetMasterVolume(0.35);
            audioBooted = true;
        }
    }

    function playSfx(m, captured) {
        if (!audioBooted) {
            return;
        }
        if (status == STATUS_MATE) {
            game.audioPlayTone(420, 140, "sawtooth", 0.14);
            game.audioPlayTone(280, 180, "sawtooth", 0.12);
            return;
        }
        if (status == STATUS_CHECK) {
            game.audioPlayTone(880, 70, "square", 0.12);
            game.audioPlayTone(660, 80, "square", 0.10);
            return;
        }
        if (captured or m.flag == MOVE_EN_PASSANT) {
            game.audioPlayTone(320, 50, "triangle", 0.12);
        } else {
            game.audioPlayTone(540, 36, "triangle", 0.09);
        }
    }

    function playMove(m) {
        var captured = !isEmpty(board[m.to]) or m.flag == MOVE_EN_PASSANT;
        history.append(snapshot());
        applyMove(m);
        lastFrom = m.from;
        lastTo = m.to;
        selSq = NO_SQUARE;
        legalForSel = [];
        refreshStatus();
        playSfx(m, captured);
        persist();
    }

    // --- small CPU: material + centre, then 2-ply negamax ---------------------

    function evaluate() {
        var score = 0;
        for (var i = 0; i < 64; i = i + 1) {
            var p = board[i];
            if (!isEmpty(p)) {
                var t = pieceKind(p);
                var v = MATERIAL[t];
                var r = rowOf(i);
                var c = colOf(i);
                var dist = math.abs(r - 3.5) + math.abs(c - 3.5);
                v = v + (4 - dist) * 3;
                if (t == PAWN) {
                    if (isWhite(p)) {
                        v = v + (6 - r) * 6;
                    } else {
                        v = v + (r - 1) * 6;
                    }
                }
                if (isWhite(p)) {
                    score = score + v;
                } else {
                    score = score - v;
                }
            }
        }
        return score;
    }

    function negamax(depth, who) {
        if (depth <= 0) {
            return evaluate() * who;
        }
        var moves = genLegal(who);
        if (moves.length == 0) {
            if (isAttacked(findKing(who), opponent(who))) {
                return 0 - MATE_SCORE - depth;
            }
            return 0;
        }
        var best = -1000000;
        for (var i = 0; i < moves.length; i = i + 1) {
            var snap = snapshot();
            applyMove(moves[i]);
            var sc = 0 - negamax(depth - 1, opponent(who));
            restore(snap);
            if (sc > best) {
                best = sc;
            }
        }
        return best;
    }

    function pickAiMove() {
        var moves = genLegal(side);
        if (moves.length == 0) {
            return null;
        }
        var bestScore = -1000000;
        var best = moves[0];
        for (var i = 0; i < moves.length; i = i + 1) {
            var snap = snapshot();
            applyMove(moves[i]);
            var sc = 0 - negamax(AI_EXTRA_PLY, side);
            restore(snap);
            sc = sc + (i % 5);
            if (sc > bestScore) {
                bestScore = sc;
                best = moves[i];
            }
        }
        return best;
    }

    function newGame() {
        setupStart();
        persist();
    }

    function undoMove() {
        if (history.length == 0) {
            return;
        }
        restore(history[history.length - 1]);
        history.pop();
        if (vsCpu and side == BLACK and history.length > 0) {
            restore(history[history.length - 1]);
            history.pop();
        }
        selSq = NO_SQUARE;
        legalForSel = [];
        aiWaitMs = 0;
        aiThinking = false;
        refreshStatus();
        persist();
    }

    function selectSquare(sq) {
        var p = board[sq];
        if (!isFriendly(p, side)) {
            selSq = NO_SQUARE;
            legalForSel = [];
            return;
        }
        selSq = sq;
        legalForSel = [];
        var all = genLegal(side);
        for (var i = 0; i < all.length; i = i + 1) {
            if (all[i].from == sq) {
                legalForSel.append(all[i]);
            }
        }
    }

    function moveIfLegal(sq) {
        for (var i = 0; i < legalForSel.length; i = i + 1) {
            if (legalForSel[i].to == sq) {
                playMove(legalForSel[i]);
                return true;
            }
        }
        return false;
    }

    function squareAt(mx, my) {
        var c = math.floor((mx - BOARD_X) / TILE);
        var r = math.floor((my - BOARD_Y) / TILE);
        if (!onBoard(r, c)) {
            return NO_SQUARE;
        }
        return at(r, c);
    }

    function handleClick(mx, my) {
        if (game.pointInRect(mx, my, PANEL_X, BTN_NEW_Y, BTN_W, BTN_H)) {
            newGame();
            return;
        }
        if (game.pointInRect(mx, my, PANEL_X, BTN_UNDO_Y, BTN_W, BTN_H)) {
            undoMove();
            return;
        }
        if (game.pointInRect(mx, my, PANEL_X, BTN_CPU_Y, BTN_W, BTN_H)) {
            vsCpu = !vsCpu;
            persist();
            return;
        }
        if (isGameOver()) {
            return;
        }
        if (aiThinking) {
            return;
        }
        if (vsCpu and side == BLACK) {
            return;
        }
        var sq = squareAt(mx, my);
        if (sq == NO_SQUARE) {
            return;
        }
        if (selSq != NO_SQUARE) {
            if (moveIfLegal(sq)) {
                return;
            }
        }
        selectSquare(sq);
    }

    // --- drawing (glyphs only; rules live above) ------------------------------

    function pieceFill(p) {
        if (isWhite(p)) {
            return "#f4ead6";
        }
        return "#1c212b";
    }

    function pieceShade(p) {
        if (isWhite(p)) {
            return "#d4c3a4";
        }
        return "#0f1218";
    }

    function pieceGlint(p) {
        if (isWhite(p)) {
            return "#fff8ea";
        }
        return "#4b5568";
    }

    function pieceStroke(p) {
        if (isWhite(p)) {
            return "#3a2818";
        }
        return "#e8d7b8";
    }

    function pieceGold(p) {
        if (isWhite(p)) {
            return "#b45309";
        }
        return "#fbbf24";
    }

    function drawPieceShadow(cx, cy) {
        game.setAlpha(0.24);
        game.fillCircle(cx, cy + 22, 12, "#020617");
        game.fillRect(cx - 16, cy + 20, 32, 7, "#020617");
        game.setAlpha(1);
    }

    function drawPieceFoot(cx, cy, fill, shade, ink) {
        game.fillRect(cx - 13, cy + 12, 26, 5, shade);
        game.fillRect(cx - 16, cy + 16, 32, 4, fill);
        game.fillRect(cx - 18, cy + 19, 36, 5, fill);
        game.strokeRect(cx - 18, cy + 19, 36, 5, ink, 1.5);
        game.drawLine(cx - 14, cy + 17, cx + 14, cy + 17, ink, 1);
    }

    function drawPieceStem(cx, yTop, yBot, wTop, wBot, fill, shade) {
        var steps = 6;
        var i = 0;
        while (i < steps) {
            var t = i / steps;
            var y = yTop + (yBot - yTop) * t;
            var h = (yBot - yTop) / steps + 1;
            var w = wTop + (wBot - wTop) * t;
            var color = fill;
            if (i >= 4) {
                color = shade;
            }
            game.fillRect(cx - w, y, w * 2, h, color);
            i = i + 1;
        }
    }

    function drawPieceRing(cx, y, half, fill, ink) {
        game.fillRect(cx - half, y, half * 2, 4, fill);
        game.strokeRect(cx - half, y, half * 2, 4, ink, 1);
    }

    function drawPieceGlint(cx, cy, r, p) {
        game.setAlpha(0.42);
        game.fillCircle(cx, cy, r, pieceGlint(p));
        game.setAlpha(1);
    }

    function drawPawn(cx, cy, fill, shade, ink, p) {
        drawPieceStem(cx, cy + 2, cy + 14, 6, 10, fill, shade);
        drawPieceRing(cx, cy + 1, 10, fill, ink);
        drawPieceFoot(cx, cy, fill, shade, ink);
        game.fillCircle(cx, cy - 10, 11, fill);
        game.strokeCircle(cx, cy - 10, 11, ink, 2);
        drawPieceGlint(cx - 4, cy - 14, 4, p);
    }

    function drawKnight(cx, cy, fill, shade, ink, p) {
        drawPieceStem(cx - 2, cy + 2, cy + 14, 8, 11, fill, shade);
        drawPieceRing(cx, cy + 2, 12, fill, ink);
        drawPieceFoot(cx, cy, fill, shade, ink);

        game.fillCircle(cx - 8, cy - 4, 6, fill);
        game.fillCircle(cx - 9, cy - 12, 6, fill);
        game.fillRect(cx - 8, cy - 8, 10, 16, fill);
        game.fillCircle(cx + 1, cy - 11, 11, fill);
        game.fillCircle(cx + 11, cy - 8, 7, fill);
        game.fillRect(cx + 4, cy - 12, 12, 9, fill);
        game.fillCircle(cx + 8, cy - 2, 6, fill);
        game.fillRect(cx - 4, cy - 23, 7, 11, fill);
        game.fillCircle(cx - 1, cy - 23, 4, fill);

        game.strokeCircle(cx + 1, cy - 11, 11, ink, 2);
        game.strokeCircle(cx + 11, cy - 8, 7, ink, 1.5);
        game.drawLine(cx - 4, cy - 22, cx + 2, cy - 12, ink, 1.5);
        game.fillCircle(cx + 5, cy - 13, 2, ink);
        game.fillCircle(cx + 14, cy - 7, 1.5, ink);
        drawPieceGlint(cx - 2, cy - 15, 3, p);
        game.setAlpha(0.35);
        game.fillCircle(cx + 8, cy - 4, 3, shade);
        game.setAlpha(1);
    }

    function drawBishop(cx, cy, fill, shade, ink, gold, p) {
        drawPieceStem(cx, cy + 1, cy + 14, 6, 10, fill, shade);
        drawPieceRing(cx, cy + 1, 11, fill, ink);
        drawPieceFoot(cx, cy, fill, shade, ink);
        game.fillCircle(cx, cy - 6, 10, fill);
        game.fillRect(cx - 7, cy - 16, 14, 12, fill);
        game.fillCircle(cx, cy - 16, 7, fill);
        game.fillRect(cx - 3, cy - 24, 6, 8, fill);
        game.fillCircle(cx, cy - 26, 3, fill);
        game.strokeCircle(cx, cy - 6, 10, ink, 2);
        game.strokeCircle(cx, cy - 16, 7, ink, 1.5);
        game.strokeCircle(cx, cy - 26, 3, ink, 1);
        game.drawLine(cx - 3, cy - 18, cx + 4, cy - 6, gold, 2);
        drawPieceGlint(cx - 4, cy - 18, 3, p);
    }

    function drawRook(cx, cy, fill, shade, ink, p) {
        drawPieceStem(cx, cy - 2, cy + 14, 10, 12, fill, shade);
        drawPieceRing(cx, cy + 2, 13, fill, ink);
        drawPieceFoot(cx, cy, fill, shade, ink);
        game.fillRect(cx - 13, cy - 12, 26, 16, fill);
        game.strokeRect(cx - 13, cy - 12, 26, 16, ink, 2);
        game.fillRect(cx - 15, cy - 18, 8, 9, fill);
        game.fillRect(cx - 4, cy - 18, 8, 9, fill);
        game.fillRect(cx + 7, cy - 18, 8, 9, fill);
        game.strokeRect(cx - 15, cy - 18, 8, 9, ink, 1.5);
        game.strokeRect(cx - 4, cy - 18, 8, 9, ink, 1.5);
        game.strokeRect(cx + 7, cy - 18, 8, 9, ink, 1.5);
        game.drawLine(cx - 11, cy - 6, cx + 11, cy - 6, ink, 1);
        drawPieceGlint(cx - 7, cy - 8, 3, p);
    }

    function drawQueen(cx, cy, fill, shade, ink, gold, p) {
        drawPieceStem(cx, cy + 2, cy + 14, 8, 12, fill, shade);
        drawPieceRing(cx, cy + 2, 13, gold, ink);
        drawPieceFoot(cx, cy, fill, shade, ink);
        game.fillCircle(cx, cy - 4, 12, fill);
        game.strokeCircle(cx, cy - 4, 12, ink, 2);
        game.fillRect(cx - 14, cy - 12, 28, 6, fill);
        game.strokeRect(cx - 14, cy - 12, 28, 6, ink, 1);

        game.fillCircle(cx - 14, cy - 16, 4, fill);
        game.fillCircle(cx - 7, cy - 20, 4, fill);
        game.fillCircle(cx, cy - 23, 5, fill);
        game.fillCircle(cx + 7, cy - 20, 4, fill);
        game.fillCircle(cx + 14, cy - 16, 4, fill);
        game.strokeCircle(cx - 14, cy - 16, 4, ink, 1);
        game.strokeCircle(cx - 7, cy - 20, 4, ink, 1);
        game.strokeCircle(cx, cy - 23, 5, ink, 1);
        game.strokeCircle(cx + 7, cy - 20, 4, ink, 1);
        game.strokeCircle(cx + 14, cy - 16, 4, ink, 1);
        game.fillCircle(cx, cy - 23, 2, gold);
        drawPieceGlint(cx - 5, cy - 8, 4, p);
    }

    function drawKing(cx, cy, fill, shade, ink, gold, p) {
        drawPieceStem(cx, cy + 2, cy + 14, 9, 12, fill, shade);
        drawPieceRing(cx, cy + 2, 14, gold, ink);
        drawPieceFoot(cx, cy, fill, shade, ink);
        game.fillCircle(cx, cy - 4, 13, fill);
        game.strokeCircle(cx, cy - 4, 13, ink, 2);
        game.fillRect(cx - 14, cy - 12, 28, 7, fill);
        game.strokeRect(cx - 14, cy - 12, 28, 7, ink, 1);
        game.fillRect(cx - 3, cy - 28, 6, 18, gold);
        game.fillRect(cx - 10, cy - 23, 20, 6, gold);
        game.strokeRect(cx - 3, cy - 28, 6, 18, ink, 1);
        game.strokeRect(cx - 10, cy - 23, 20, 6, ink, 1);
        drawPieceGlint(cx - 5, cy - 8, 4, p);
    }

    function drawPiece(cx, cy, p) {
        var fill = pieceFill(p);
        var shade = pieceShade(p);
        var ink = pieceStroke(p);
        var gold = pieceGold(p);
        drawPieceShadow(cx, cy);
        match pieceKind(p) {
            case PAWN: {
                drawPawn(cx, cy, fill, shade, ink, p);
            }
            case KNIGHT: {
                drawKnight(cx, cy, fill, shade, ink, p);
            }
            case BISHOP: {
                drawBishop(cx, cy, fill, shade, ink, gold, p);
            }
            case ROOK: {
                drawRook(cx, cy, fill, shade, ink, p);
            }
            case QUEEN: {
                drawQueen(cx, cy, fill, shade, ink, gold, p);
            }
            case KING: {
                drawKing(cx, cy, fill, shade, ink, gold, p);
            }
            default: {
            }
        }
    }

    function statusText() {
        if (aiThinking) {
            return "Black is thinking…";
        }
        if (status == STATUS_MATE) {
            if (side == WHITE) {
                return "Checkmate — Black wins";
            }
            return "Checkmate — White wins";
        }
        if (status == STATUS_STALE) {
            return "Stalemate";
        }
        var turn = "White to move";
        if (side == BLACK) {
            turn = "Black to move";
        }
        if (status == STATUS_CHECK) {
            return turn + " — check";
        }
        return turn;
    }

    function drawButton(x, y, w, h, label, hot) {
        var bg = "#1e293b";
        if (hot) {
            bg = "#334155";
        }
        game.fillRect(x, y, w, h, bg);
        game.strokeRect(x, y, w, h, "#64748b", 1);
        game.drawText(label, x + 14, y + 26, "#e2e8f0", "16px sans-serif");
    }

    function updateGame(dtMs) {
        hoverSq = squareAt(game.getMouseX(), game.getMouseY());

        if (game.wasMousePressed(0) or game.wasKeyPressed("r") or game.wasKeyPressed("u") or game.wasKeyPressed("c")) {
            bootAudio();
        }

        if (game.wasKeyPressed("r")) {
            newGame();
        }
        if (game.wasKeyPressed("u")) {
            undoMove();
        }
        if (game.wasKeyPressed("c")) {
            vsCpu = !vsCpu;
            persist();
        }
        if (game.wasMousePressed(0)) {
            handleClick(game.getMouseX(), game.getMouseY());
        }

        if (vsCpu and side == BLACK and (status == STATUS_PLAY or status == STATUS_CHECK) and !aiThinking) {
            aiThinking = true;
            aiWaitMs = AI_THINK_MS;
        }

        if (aiThinking) {
            aiWaitMs = aiWaitMs - dtMs;
            if (aiWaitMs <= 0) {
                var m = pickAiMove();
                aiThinking = false;
                if (m != null) {
                    playMove(m);
                }
            }
        }
    }

    function renderGame() {
        game.clear();
        game.fillRect(0, 0, CANVAS_W, CANVAS_H, "#0f172a");

        for (var r = 0; r < 8; r = r + 1) {
            for (var c = 0; c < 8; c = c + 1) {
                var sq = at(r, c);
                var x = BOARD_X + c * TILE;
                var y = BOARD_Y + r * TILE;
                var light = ((r + c) % 2) == 0;
                var color = "#edd4a2";
                if (!light) {
                    color = "#8b5a2b";
                }
                if (sq == lastFrom or sq == lastTo) {
                    if (light) {
                        color = "#f0d36a";
                    } else {
                        color = "#c9a227";
                    }
                }
                if (sq == selSq) {
                    color = "#6ea8fe";
                }
                game.fillRect(x, y, TILE, TILE, color);

                if (status == STATUS_CHECK or status == STATUS_MATE) {
                    if (board[sq] == coded(KING, side)) {
                        game.setAlpha(0.35);
                        game.fillRect(x, y, TILE, TILE, "#ef4444");
                        game.setAlpha(1);
                    }
                }

                for (var i = 0; i < legalForSel.length; i = i + 1) {
                    if (legalForSel[i].to == sq) {
                        if (!isEmpty(board[sq]) or legalForSel[i].flag == MOVE_EN_PASSANT) {
                            game.strokeCircle(x + TILE / 2, y + TILE / 2, 22, "#14532d", 3);
                        } else {
                            game.fillCircle(x + TILE / 2, y + TILE / 2, 8, "#166534");
                        }
                    }
                }

                if (!isEmpty(board[sq])) {
                    drawPiece(x + TILE / 2, y + TILE / 2 + 4, board[sq]);
                }
            }
        }

        game.strokeRect(BOARD_X, BOARD_Y, TILE * 8, TILE * 8, "#0f172a", 3);

        for (var i = 0; i < 8; i = i + 1) {
            game.drawText(string(8 - i), 8, BOARD_Y + i * TILE + 40, "#94a3b8", "13px monospace");
            game.drawText(FILES[i], BOARD_X + i * TILE + 28, BOARD_Y + TILE * 8 + 20, "#94a3b8", "13px monospace");
        }

        if (hoverSq != NO_SQUARE) {
            var hx = BOARD_X + colOf(hoverSq) * TILE;
            var hy = BOARD_Y + rowOf(hoverSq) * TILE;
            game.strokeRect(hx, hy, TILE, TILE, "#f8fafc", 1);
        }

        game.drawText("Chess", PANEL_X, 48, "#f8fafc", "32px sans-serif");
        game.drawText(statusText(), PANEL_X, 84, "#fde68a", "18px sans-serif");

        var mode = "Human vs computer";
        if (!vsCpu) {
            mode = "Human vs human";
        }
        game.drawText(mode, PANEL_X, 114, "#cbd5e1", "16px sans-serif");
        game.drawText($"White {winsW}  —  Black {winsB}", PANEL_X, 142, "#93c5fd", "16px sans-serif");
        game.drawText("Click a piece, then a green square.", PANEL_X, 178, "#94a3b8", "14px sans-serif");
        game.drawText("Castling, en passant, queen promo.", PANEL_X, 200, "#94a3b8", "14px sans-serif");

        var mx = game.getMouseX();
        var my = game.getMouseY();
        drawButton(PANEL_X, BTN_NEW_Y, BTN_W, BTN_H, "New game  (R)", game.pointInRect(mx, my, PANEL_X, BTN_NEW_Y, BTN_W, BTN_H));
        drawButton(PANEL_X, BTN_UNDO_Y, BTN_W, BTN_H, "Undo  (U)", game.pointInRect(mx, my, PANEL_X, BTN_UNDO_Y, BTN_W, BTN_H));
        var cpuLabel = "Play vs computer  (C)";
        if (vsCpu) {
            cpuLabel = "Play vs human  (C)";
        }
        drawButton(PANEL_X, BTN_CPU_Y, BTN_W, BTN_H, cpuLabel, game.pointInRect(mx, my, PANEL_X, BTN_CPU_Y, BTN_W, BTN_H));

        game.drawText("Local two-player or a 2-ply CPU.", PANEL_X, 420, "#64748b", "14px sans-serif");
        game.drawText("Position and score survive reload.", PANEL_X, 442, "#64748b", "14px sans-serif");
    }

    if (!tryLoadGame()) {
        setupStart();
    } else {
        refreshStatus();
    }

    game.createCanvas(CANVAS_W, CANVAS_H, "#app");
    game.setBackground("#0f172a");
    game.startFixed(updateGame, renderGame);
}
