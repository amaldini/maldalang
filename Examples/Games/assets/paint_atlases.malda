    return saveAtlas(io.pathJoin(getProgramDirectory(), "platform_tiles.png"), img, w, 16);
}

var caveOk = paintCave();
var platformOk = paintPlatform();
if (caveOk && platformOk) {
    io.print("atlases ready");
}
