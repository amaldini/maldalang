// MCP Tools Server Example
// Demonstrates how to create custom MCP tools in MALDA
// These tools can be used with Claude Desktop, ChatGPT, and other MCP clients

// Simple tool: Add two numbers
@MCPTool("add", "Adds two numbers together")
function add(a, b) {
    return int(a) + int(b);
}

// Tool with string operations
@MCPTool("reverse_string", "Reverses a string")
function reverseString(text) {
    if (text == null || text == "") {
        return "";
    }
    var reversed = "";
    var i = length(text) - 1;
    while (i >= 0) {
        reversed = reversed + substring(text, i, 1);
        i = i - 1;
    }
    return reversed;
}

// Tool that processes text
@MCPTool("count_words", "Counts words in a text string")
function countWords(text) {
    if (text == null || text == "") {
        return 0;
    }
    var words = 0;
    var inWord = false;
    var i = 0;
    while (i < length(text)) {
        var char = substring(text, i, 1);
        if (char != " " && char != "\t" && char != "\n") {
            if (!inWord) {
                words = words + 1;
                inWord = true;
            }
        } else {
            inWord = false;
        }
        i = i + 1;
    }
    return words;
}

// Tool with custom JSON Schema
@MCPTool("get_weather", "Gets weather for a location", "{\"type\":\"object\",\"properties\":{\"location\":{\"type\":\"string\",\"description\":\"City name\"},\"unit\":{\"type\":\"string\",\"enum\":[\"celsius\",\"fahrenheit\"],\"default\":\"celsius\"}},\"required\":[\"location\"]}")
function getWeather(location, unit) {
    // Simulated weather data
    var temp = 25;
    if (unit == "fahrenheit") {
        temp = temp * 9 / 5 + 32;
    }
    var unitStr = unit == "fahrenheit" ? "F" : "C";
    return "Weather in " + location + ": Sunny, " + string(temp) + "°" + unitStr;
}

// Start the MCP server with STDIO transport (default)
var server = new MCPServer();
server.start();

print("MCP Server started with STDIO transport");
print("Available tools:");
print("  - add: Adds two numbers together");
print("  - reverse_string: Reverses a string");
print("  - count_words: Counts words in a text string");
print("  - get_weather: Gets weather for a location");
print("Server running... Waiting for MCP client connections");
print("");
print("To use with Claude Desktop, configure it to run this script.");
print("The server communicates via JSON-RPC 2.0 over STDIO.");

// Keep the server running
while (server.isRunning) {
    sleep(1000);  // Sleep for 1 second
}

print("MCP Server stopped");
