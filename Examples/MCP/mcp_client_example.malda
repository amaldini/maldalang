// MCP Client Example
// Demonstrates how to connect to an MCP server and use its tools
// This example connects to the Example MCP Server (mcp_tools_server.malda)

io.print("=== MCP Client Example ===");
io.print("");

// Create an MCP client instance
var client = new MCPClient("example-server");
io.print("Created MCPClient instance: " + client.serverName);
io.print("");

// Connect to the MCP server
// We'll use the malda.exe interpreter directly to run the server script
io.print("Connecting to MCP server...");
var serverScriptPath = "Examples/MCP/mcp_tools_server.malda";

// Try different executable names and paths
// Most common: malda.exe in PATH or current directory
var exeNames = ["malda.exe", "malda"];
var scriptPaths = [
    "Examples/MCP/mcp_tools_server.malda",
    "../Examples/MCP/mcp_tools_server.malda"
];

var connected = false;
var usedExe = "";
var usedPath = "";

// Try each combination (quietly, only show errors)
for (var i = 0; i < exeNames.length && !connected; i++) {
    for (var j = 0; j < scriptPaths.length && !connected; j++) {
        connected = client.connect(exeNames[i], [scriptPaths[j]]);
        if (connected) {
            usedExe = exeNames[i];
            usedPath = scriptPaths[j];
            break;
        }
    }
}

if (!connected) {
    io.print("Failed to connect to MCP server!");
    io.print("");
    io.print("Tried the following combinations:");
    for (var i = 0; i < exeNames.length; i++) {
        for (var j = 0; j < scriptPaths.length; j++) {
            io.print("  - " + exeNames[i] + " " + scriptPaths[j]);
        }
    }
    io.print("");
    io.print("Please ensure:");
    io.print("  1. malda.exe is built and available (in PATH or current directory)");
    io.print("  2. The server script exists at: Examples/MCP/mcp_tools_server.malda");
    io.print("  3. You're running from the project root directory");
    io.print("");
    io.print("To build malda.exe, run:");
    io.print("  cd MaldaLang");
    io.print("  dotnet build");
    io.print("The executable will be in: MaldaLang/bin/Debug/net8.0/malda.exe");
    return;
}

io.print("✓ Connected to MCP server successfully!");
io.print("  Using: " + usedExe + " " + usedPath);
io.print("");

// Check connection status
if (!client.isConnected) {
    io.print("Error: Client is not connected. Cannot proceed.");
    return;
}

io.print("Connection status: " + string(client.isConnected));
io.print("");

// Discover and list available tools
io.print("Discovering available tools...");
var tools = client.getTools();
io.print("Found " + string(tools.length) + " tools:");
io.print("");

for (var i = 0; i < tools.length; i++) {
    var tool = tools[i];
    io.print("  Tool " + string(i + 1) + ":");
    io.print("    Name: " + tool.name);
    io.print("    Description: " + tool.description);
    io.print("");
}

// Example 1: Call a simple tool (add)
io.print("=== Example 1: Calling the 'add' tool ===");
var addResult = client.callTool("add", {"a": 5, "b": 3});
io.print("Result of add(5, 3): " + string(addResult));
io.print("");

// Example 2: Call a string manipulation tool
io.print("=== Example 2: Calling the 'reverse_string' tool ===");
var reverseResult = client.callTool("reverse_string", {"text": "Hello, World!"});
io.print("Result of reverse_string('Hello, World!'): " + string(reverseResult));
io.print("");

// Example 3: Call a text processing tool
io.print("=== Example 3: Calling the 'count_words' tool ===");
var text = "This is a sample text with multiple words";
var wordCount = client.callTool("count_words", {"text": text});
io.print("Text: '" + text + "'");
io.print("Word count: " + string(wordCount));
io.print("");

// Example 4: Call a tool with custom schema (get_weather)
io.print("=== Example 4: Calling the 'get_weather' tool ===");
var weatherResult = client.callTool("get_weather", {"location": "New York", "unit": "fahrenheit"});
io.print("Weather result: " + string(weatherResult));
io.print("");

// Example 5: Create a tool instance and use it
io.print("=== Example 5: Creating a tool instance ===");
var addTool = client.createTool("add", "my_add_tool", true);
io.print("Created tool instance: " + addTool.name);
io.print("Tool is registered: " + string(addTool.isRegistered));
io.print("");

// Example 6: Create a wrapper agent with all MCP tools
io.print("=== Example 6: Creating a wrapper agent ===");
io.print("Note: This requires an LLM client. Skipping for this example.");
io.print("You can create a wrapper agent like this:");
io.print("  var agent = client.createWrapperAgent(");
io.print("    'Assistant',");
io.print("    'Helper',");
io.print("    'You are a helpful assistant with access to MCP tools',");
io.print("    llmClient");
io.print("  );");
io.print("");

// Clean up: disconnect from the server
io.print("=== Disconnecting from MCP server ===");
client.disconnect();
io.print("✓ Disconnected successfully");
io.print("");

io.print("=== Example completed ===");
io.print("");
io.print("Note: The client automatically starts the MCP server process via STDIO.");
io.print("The server runs in the background and communicates with the client.");
io.print("");
io.print("To test manually, you can run the server separately:");
io.print("  malda Examples/MCP/mcp_tools_server.malda");
