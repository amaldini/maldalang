// @MCPTool third argument is a MALDA schema name (or a bare identifier).
// server.getTools() lists inputSchema; callTool() host-validates args. No STDIO.

schema AddArgs {
    a: int;
    b: int;
}

schema WeatherArgs {
    location: string;
    unit: string?;
}

@MCPTool("add", "Adds two numbers together", "AddArgs")
function add(a, b) {
    return int(a) + int(b);
}

@MCPTool("get_weather", "Gets weather for a location", WeatherArgs)
function getWeather(location, unit) {
    return "Weather in " + location;
}

var server = new MCPServer();
var tools = server.getTools();
io.print(tools.length);
var i = 0;
while (i < tools.length) {
    var t = tools[i];
    if (t.name == "add") {
        io.print(t.inputSchema.properties.a.type);
        io.print(t.inputSchema.required.length);
    }
    if (t.name == "get_weather") {
        io.print(t.inputSchema.properties.location.type);
        io.print(t.inputSchema.required.length);
    }
    i = i + 1;
}

var sum = server.callTool("add", dict { "a": 1, "b": 2 });
io.print(sum.ok);
io.print(sum.data);

var badType = server.callTool("add", dict { "a": "x", "b": 2 });
io.print(badType.ok);

var weather = server.callTool("get_weather", dict { "location": "Paris" });
io.print(weather.ok);
