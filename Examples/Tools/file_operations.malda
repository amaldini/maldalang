// Write a file
var content = "Hello, World!
This is a test file.";
io.writeFile("test.txt", content);
io.print("File written");

// Read it back
var readContent = io.readFile("test.txt");
if (readContent != null) {
    io.print("File content:");
    io.print(readContent);
} else {
    io.print("File not found");
}

// List directory
var items = io.listDirectory(".");
io.print("
Directory contents:");
var i = 0;
while (i < items.length) {
    var item = items[i];
    io.print($"{item.name} ({item.type})");
    i = i + 1;
}
