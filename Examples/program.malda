actor Worker {
    on start() {
        io.print("Started");
        var me = self;
        io.print("Self reference obtained");
    }
}

var worker = spawn Worker();
send worker.start();

// Give actor time to process
var x = 0;
while (x < 10) {
    x = x + 1;
    io.print(x);
    sleep(500);
}

io.print("Done");
