class Calculator {
    function add(a, b) {
        return a + b;
    }

    function subtract(a, b) {
        return a - b;
    }

    function multiply(a, b) {
        return a * b;
    }

    function divide(a, b) {
        if (b == 0) {
            io.print("Error: Division by zero!");
            return 0;
        }
        return a / b;
    }
}

var calc = new Calculator();
var a = 20;
var b = 5;

io.print("Calculator Demo");
io.print($"a = {a}, b = {b}");
io.print($"a + b = {calc.add(a, b)}");
io.print($"a - b = {calc.subtract(a, b)}");
io.print($"a * b = {calc.multiply(a, b)}");
io.print($"a / b = {calc.divide(a, b)}");

// Test division by zero
io.print($"10 / 0 = {calc.divide(10, 0)}");
