property stableIdentity(x) {
    return (x + 0) == x;
}

var result = runProperty("stableIdentity", 40, 1337);

io.print("Property: " + string(result.propertyName));
io.print("Passed: " + string(result.passed));
io.print("Seed: " + string(result.seed));
io.print("Iterations: " + string(result.iterations));

if (!result.passed) {
    io.print("Failed trial: " + string(result.failedTrial));
    io.print("Counterexample: " + string(result.counterexample));
}
