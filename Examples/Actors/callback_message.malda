// Callback-style messaging example
// Demonstrates send target.handler(args) then (result) { ... } and reply()

actor Worker {
    on compute(value) {
        // Perform some work and reply with the result
        var result = value * 2;
        reply(result);
    }
}

actor Coordinator {
    on start() {
        var worker = spawn Worker();
        
        // Send a request with a callback that will run
        // in the Coordinator's actor context when the reply is received.
        send worker.compute(21) then (result) {
            print($"Coordinator: received result = {result}");
        };
    }
}

var coordinator = spawn Coordinator();

// Small initial delay to ensure Coordinator actor loop has started
sleep(100);

send coordinator.start();

// Give actors time to process messages and callbacks
// This delay ensures the program doesn't exit before async actor work completes
sleep(500);

