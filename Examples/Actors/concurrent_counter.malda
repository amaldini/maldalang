// Concurrent Counter Example
// Demonstrates multiple actors working concurrently on counters

actor ConcurrentCounter {
    var counterId;
    var value = 0;
    
    function ConcurrentCounter(id) {
        counterId = id;
    }
    
    on increment() {
        value = value + 1;
    }
    
    on incrementBy(amount) {
        value = value + amount;
    }
    
    on get() {
        print($"Counter {counterId}: value = {value}");
    }
    
    on getValue() {
        return value;
    }
}

// Create multiple counters
print("Creating concurrent counters...");
var counters = [];
for (var i = 0; i < 3; i = i + 1) {
    counters.append(spawn ConcurrentCounter(i + 1));
}

// Small initial delay to ensure actor loops have started
sleep(100);

// Send many increment operations to each counter concurrently
print("Sending increment operations...");
for (var i = 0; i < 10; i = i + 1) {
    // Send to all counters concurrently
    for (var j = 0; j < counters.length; j = j + 1) {
        send counters[j].increment();
    }
}

// Also send some incrementBy operations
for (var i = 0; i < 5; i = i + 1) {
    for (var j = 0; j < counters.length; j = j + 1) {
        send counters[j].incrementBy(2);
    }
}

// Check final values
print("\nFinal counter values:");
for (var i = 0; i < counters.length; i = i + 1) {
    send counters[i].get();
}

// Give all actors time to process their messages
sleep(500);

print("\nConcurrent counter example complete!");
print("Each counter processed operations independently and concurrently.");
