// Basic Actor Example - Counter
// Demonstrates actor declaration, message handlers, and state

actor Counter {
    var count = 0;
    
    // Message handler for incrementing
    on increment() {
        count = count + 1;
        print($"Counter incremented to {count}");
    }
    
    // Message handler for getting the count
    on get() {
        print($"Current count: {count}");
    }
    
    // Message handler for resetting
    on reset() {
        count = 0;
        print("Counter reset to 0");
    }
}

// Spawn an actor instance
var counter = spawn Counter();

// Small initial delay to ensure Counter actor loop has started
sleep(100);

// Send messages to the actor
print("Sending increment messages...");
send counter.increment();
send counter.increment();
send counter.increment();

send counter.get();
send counter.reset();
send counter.get();

// Give actor time to process messages
sleep(500);

print("Done!");
