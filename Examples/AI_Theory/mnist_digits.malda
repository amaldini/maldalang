// Ten 5x5 digits, trained as a small MNIST MLP.
//
// Chapter 14: you keep the weights. There is no autograd tape and no optimizer.
// The hidden layer is ReLU. The ten logits are linear, because softmax lives
// in the loss (14.5), not as a second nonlinearity on pre:
//   loss     = nn.crossEntropyFromLogits(logits, class)
//   upstream = nn.softmaxGrad(logits, class)
//   backOut  = nn.denseBackward(hidden.out, w2, upstream, "linear", out.pre)
//   backHid  = nn.denseBackward(pixels, w1, backOut.dInput, "relu", hidden.pre)
// Then subtract learningRate * each gradient (14.4.2).
//
// The training set is ten 5x5 glyphs in this file. The loop is the one you
// would run on a flattened 28x28 row: pixels, one hidden dense layer, 10 logits.
// Offline and seeded — no API key.

function randomMatrix(rows: int, cols: int, scale: float) -> array {
    var matrix = [];
    for (var i = 0; i < rows; i = i + 1) {
        var row = [];
        for (var j = 0; j < cols; j = j + 1) {
            row.append(math.randomFloat(-scale, scale));
        }
        matrix.append(row);
    }
    return matrix;
}

function zeros(n: int) -> array {
    var values = [];
    for (var i = 0; i < n; i = i + 1) {
        values.append(0.0);
    }
    return values;
}

function sgdMatrix(weights: array, grad: array, lr: float) {
    for (var i = 0; i < weights.length; i = i + 1) {
        for (var j = 0; j < weights[i].length; j = j + 1) {
            weights[i][j] = weights[i][j] - lr * grad[i][j];
        }
    }
}

function sgdVector(bias: array, grad: array, lr: float) {
    for (var i = 0; i < bias.length; i = i + 1) {
        bias[i] = bias[i] - lr * grad[i];
    }
}

function pixelsOf(rows: array) -> array {
    var values = [];
    for (var r = 0; r < rows.length; r = r + 1) {
        var row = rows[r];
        for (var c = 0; c < 5; c = c + 1) {
            var bit = 0.0;
            if (str.substring(row, c, 1) == "#") {
                bit = 1.0;
            }
            values.append(bit);
        }
    }
    return values;
}

function fmt(x: float) -> string {
    return string(math.round(x * 1000.0) / 1000.0);
}

math.seed(7);

var glyphRows = [
    [".###.", "#...#", "#...#", "#...#", ".###."],
    ["..#..", ".##..", "..#..", "..#..", ".###."],
    [".###.", "....#", ".###.", "#....", "#####"],
    [".###.", "....#", ".###.", "....#", ".###."],
    ["#...#", "#...#", "#####", "....#", "....#"],
    ["#####", "#....", "####.", "....#", "####."],
    [".###.", "#....", "####.", "#...#", ".###."],
    ["#####", "....#", "...#.", "..#..", ".#..."],
    [".###.", "#...#", ".###.", "#...#", ".###."],
    [".###.", "#...#", ".####", "....#", ".###."]
];

var inputs = [];
var labels = [];
for (var d = 0; d < glyphRows.length; d = d + 1) {
    inputs.append(pixelsOf(glyphRows[d]));
    labels.append(d);
}

var hiddenSize: int = 24;
var learningRate: float = 0.25;
var epochs: int = 40;
var w1 = randomMatrix(25, hiddenSize, 0.4);
var b1 = zeros(hiddenSize);
var w2 = randomMatrix(hiddenSize, 10, 0.3);
var b2 = zeros(10);

io.print("Tiny digits (5x5 -> 24 ReLU -> 10 logits)");
io.print("Chapter 14 step: nn.dense, nn.softmaxGrad, nn.denseBackward");
io.print("");

for (var epoch = 1; epoch <= epochs; epoch = epoch + 1) {
    var epochLoss = 0.0;
    for (var s = 0; s < inputs.length; s = s + 1) {
        var x = inputs[s];
        var target = labels[s];
        var hidden = nn.dense(x, w1, b1, "relu");
        var out = nn.dense(hidden.out, w2, b2, "linear");
        var logits = out.out;
        epochLoss = epochLoss + nn.crossEntropyFromLogits(logits, target);

        var upstream = nn.softmaxGrad(logits, target);
        var backOut = nn.denseBackward(hidden.out, w2, upstream, "linear", out.pre);
        var backHidden = nn.denseBackward(x, w1, backOut.dInput, "relu", hidden.pre);
        sgdMatrix(w2, backOut.dWeights, learningRate);
        sgdVector(b2, backOut.dBias, learningRate);
        sgdMatrix(w1, backHidden.dWeights, learningRate);
        sgdVector(b1, backHidden.dBias, learningRate);
    }

    if (epoch == 1 || epoch % 10 == 0 || epoch == epochs) {
        io.print("epoch " + string(epoch) + ": loss=" + fmt(epochLoss / inputs.length));
    }
}

io.print("");
io.print("Predictions after training:");
var correct = 0;
for (var s = 0; s < inputs.length; s = s + 1) {
    var x = inputs[s];
    var hidden = nn.dense(x, w1, b1, "relu");
    var logits = nn.dense(hidden.out, w2, b2, "linear").out;
    var predicted = math.argmax(logits);
    if (predicted == labels[s]) {
        correct = correct + 1;
    }
    io.print("  " + string(labels[s]) + " -> " + string(predicted));
}

io.print("");
io.print("Accuracy: " + string(correct) + "/" + string(inputs.length));
if (correct == inputs.length) {
    io.print("mnist digits ok");
}
