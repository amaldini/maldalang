// The same learning-rate step, with and without a velocity.
//
// f(x, y) = 1/2 * ax * x^2 + 1/2 * ay * y^2 is steep in y and flat in x.
// Plain SGD uses one learning rate for both axes, so the steep axis
// overshoots and the distance stays large. Momentum keeps a velocity:
//   v = beta * v + grad
//   param = param - learningRate * v
// and walks down the valley. This is the hand step from chapter 14.4.2.
// Offline — no API key.

function distance(x: float, y: float) -> float {
    return math.sqrt(x * x + y * y);
}

function fmt(value: float) -> string {
    return string(math.round(value * 1000.0) / 1000.0);
}

var ax = 0.15;
var ay = 11.0;
var learningRate = 0.2;
var beta = 0.85;
var steps = 40;
var x0 = 3.0;
var y0 = 1.0;

var sgdX = x0;
var sgdY = y0;
for (var step = 0; step < steps; step = step + 1) {
    var gx = ax * sgdX;
    var gy = ay * sgdY;
    sgdX = sgdX - learningRate * gx;
    sgdY = sgdY - learningRate * gy;
}

var momX = x0;
var momY = y0;
var vx = 0.0;
var vy = 0.0;
for (var step = 0; step < steps; step = step + 1) {
    var gx = ax * momX;
    var gy = ay * momY;
    vx = beta * vx + gx;
    vy = beta * vy + gy;
    momX = momX - learningRate * vx;
    momY = momY - learningRate * vy;
}

var sgdDistance = distance(sgdX, sgdY);
var momDistance = distance(momX, momY);

io.print("Momentum on a steep valley (" + string(steps) + " steps)");
io.print("sgd distance:      " + fmt(sgdDistance));
io.print("momentum distance: " + fmt(momDistance));
if (momDistance < 0.5 && sgdDistance > momDistance * 5.0) {
    io.print("momentum valley ok");
}
