// Advanced CNN with composable networks
//
// Demonstrates modern convolutional neural network architecture
// using the advanced CNN layers: Conv2D, MaxPool2D, BatchNorm2D,
// Dropout2D, GlobalAvgPool2D, Flatten, and Dense layers.
//
// Shows how to:
// 1. Build multi-channel convolutional layers
// 2. Use pooling for downsampling
// 3. Apply batch normalization for training stability
// 4. Use dropout for regularization
// 5. Compose networks from smaller networks
// 6. Train end-to-end with backpropagation

function createConvBlock(inChannels: int, outChannels: int) -> object {
    return new Sequential([
        new Conv2D(inChannels, outChannels, 3, 1, "same", 0.1),
        new BatchNorm2D(outChannels),
        new MaxPool2D(2, 2)
    ]);
}

function createClassifier(inputSize: int, numClasses: int) -> object {
    return new Sequential([
        new Flatten(),
        new Dense(inputSize, 64, "relu", 0.1),
        new Dropout2D(0.3),
        new Dense(64, numClasses, "linear", 0.1)
    ]);
}

function createSimpleImage(value: float) -> array {
    // Create a 8x8 single-channel image
    var channels = [];
    var channel = [];
    for (var r = 0; r < 8; r = r + 1) {
        var row = [];
        for (var c = 0; c < 8; c = c + 1) {
            row.append(value + (r * 8 + c) * 0.01);
        }
        channel.append(row);
    }
    channels.append(channel);
    return channels;
}

io.print("Building advanced CNN architecture...");
math.seed(42);

// Build a composable CNN architecture
var convBlock1 = createConvBlock(1, 4);   // 8x8x1 -> 4x4x4
var convBlock2 = createConvBlock(4, 8);   // 4x4x4 -> 2x2x8
var classifier = createClassifier(32, 2); // 2x2x8=32 -> 2 classes

// Compose the full network from building blocks
var cnn = new Sequential([convBlock1, convBlock2, classifier]);

io.print("Network architecture:");
io.print("  Conv Block 1: Conv2D(1->4) + BatchNorm + MaxPool");
io.print("  Conv Block 2: Conv2D(4->8) + BatchNorm + MaxPool");
io.print("  Classifier: Flatten + Dense(32->64) + Dropout + Dense(64->2)");

// Create simple training data
var images = [];
var labels = [];

// Class 0: bright images
for (var i = 0; i < 4; i = i + 1) {
    images.append(createSimpleImage(0.8));
    labels.append(0);
}

// Class 1: dark images
for (var i = 0; i < 4; i = i + 1) {
    images.append(createSimpleImage(0.2));
    labels.append(1);
}

io.print("");
io.print("Training CNN on 8 samples (4 per class)...");

// Training loop
var learningRate = 0.01;
var epochs = 50;

for (var epoch = 0; epoch < epochs; epoch = epoch + 1) {
    var totalLoss = 0.0;
    var correct = 0;
    
    for (var s = 0; s < images.length; s = s + 1) {
        // Forward pass
        var output = cnn.forward(images[s]);
        
        // Compute loss and accuracy
        var target = [0.0, 0.0];
        target[labels[s]] = 1.0;
        var loss = nn.mse(output, target);
        totalLoss = totalLoss + loss;
        
        // Check prediction
        var predicted = 0;
        if (output[1] > output[0]) {
            predicted = 1;
        }
        if (predicted == labels[s]) {
            correct = correct + 1;
        }
        
        // Backward pass
        var upstream = nn.mseGrad(output, target);
        cnn.backward(upstream);
        cnn.sgd(learningRate);
    }
    
    if ((epoch + 1) % 10 == 0) {
        var avgLoss = totalLoss / float(images.length);
        var accuracy = float(correct) / float(images.length) * 100.0;
        io.print("Epoch " + string(epoch + 1) + "/" + string(epochs) + 
                 " - Loss: " + string(avgLoss) + 
                 " - Accuracy: " + string(accuracy) + "%");
    }
}

io.print("");
io.print("Testing trained CNN...");

// Test on training data
var correct = 0;
for (var s = 0; s < images.length; s = s + 1) {
    var output = cnn.forward(images[s]);
    var predicted = 0;
    if (output[1] > output[0]) {
        predicted = 1;
    }
    if (predicted == labels[s]) {
        correct = correct + 1;
    }
    io.print("Sample " + string(s) + ": predicted=" + string(predicted) + 
             ", actual=" + string(labels[s]) + 
             " [" + string(output[0]) + ", " + string(output[1]) + "]");
}

var finalAccuracy = float(correct) / float(images.length) * 100.0;
io.print("");
io.print("Final accuracy: " + string(finalAccuracy) + "%");
io.print("");
io.print("CNN advanced features demonstrated:");
io.print("  ✓ Multi-channel Conv2D with same padding");
io.print("  ✓ Batch normalization for training stability");
io.print("  ✓ Max pooling for spatial downsampling");
io.print("  ✓ Dropout for regularization");
io.print("  ✓ Network composition from building blocks");
io.print("  ✓ End-to-end training with backpropagation");

if (finalAccuracy >= 80.0) {
    io.print("");
    io.print("✓ CNN successfully learned to classify images!");
}
