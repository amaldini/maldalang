// A skip keeps a deep sigmoid stack near the identity, then a mask
// zeros a unit only while training.
//
// Residual. Six sigmoid layers fit y = x on five points in [-1, 1].
// The plain stack can only emit (0, 1). The skip is
//   h = h + sigmoid(w * h + b) - 0.5
// so a zero-centered sigmoid branch starts as the identity.
//
// Dropout. One ReLU hidden layer. A Bernoulli mask (keep probability 0.5)
// zeros units on the train forward and scales the rest by 1/p. The eval
// forward uses every unit. Offline and seeded — no API key.

function zeros(n: int) -> array {
    var values = [];
    for (var i = 0; i < n; i = i + 1) {
        values.append(0.0);
    }
    return values;
}

function fmt(value: float) -> string {
    return string(math.round(value * 1000.0) / 1000.0);
}

var depth = 6;
var xs = [-1.0, -0.5, 0.0, 0.5, 1.0];
var learningRate = 0.4;
var steps = 80;

var plainW = [];
var plainB = [];
var skipW = [];
var skipB = [];
for (var layer = 0; layer < depth; layer = layer + 1) {
    plainW.append(0.2);
    plainB.append(0.0);
    skipW.append(0.2);
    skipB.append(0.0);
}

function plainForward(x: float, weights: array, bias: array) -> array {
    var h = x;
    var values = [];
    for (var layer = 0; layer < weights.length; layer = layer + 1) {
        var z = weights[layer] * h + bias[layer];
        h = math.sigmoid(z);
        values.append(h);
    }
    return values;
}

function skipForward(x: float, weights: array, bias: array) -> array {
    var h = x;
    var values = [];
    for (var layer = 0; layer < weights.length; layer = layer + 1) {
        var z = weights[layer] * h + bias[layer];
        var branch = math.sigmoid(z) - 0.5;
        h = h + branch;
        values.append(h);
    }
    return values;
}

function meanLoss(weights: array, bias: array, residual: bool) -> float {
    var loss = 0.0;
    for (var i = 0; i < xs.length; i = i + 1) {
        var values = [];
        if (residual) {
            values = skipForward(xs[i], weights, bias);
        } else {
            values = plainForward(xs[i], weights, bias);
        }
        var delta = values[values.length - 1] - xs[i];
        loss = loss + 0.5 * delta * delta;
    }
    return loss / xs.length;
}

for (var step = 0; step < steps; step = step + 1) {
    var dPlainW = zeros(depth);
    var dPlainB = zeros(depth);
    var dSkipW = zeros(depth);
    var dSkipB = zeros(depth);
    for (var s = 0; s < xs.length; s = s + 1) {
        var x = xs[s];
        var plainH = plainForward(x, plainW, plainB);
        var dH = (plainH[depth - 1] - x) / xs.length;
        for (var layer = depth - 1; layer >= 0; layer = layer - 1) {
            var prev = x;
            if (layer > 0) {
                prev = plainH[layer - 1];
            }
            var y = plainH[layer];
            var dZ = dH * y * (1.0 - y);
            dPlainW[layer] = dPlainW[layer] + dZ * prev;
            dPlainB[layer] = dPlainB[layer] + dZ;
            dH = dZ * plainW[layer];
        }

        var skipH = skipForward(x, skipW, skipB);
        dH = (skipH[depth - 1] - x) / xs.length;
        for (var layer = depth - 1; layer >= 0; layer = layer - 1) {
            var prev = x;
            if (layer > 0) {
                prev = skipH[layer - 1];
            }
            var z = skipW[layer] * prev + skipB[layer];
            var sig = math.sigmoid(z);
            var dZ = dH * sig * (1.0 - sig);
            dSkipW[layer] = dSkipW[layer] + dZ * prev;
            dSkipB[layer] = dSkipB[layer] + dZ;
            dH = dH + dZ * skipW[layer];
        }
    }
    for (var layer = 0; layer < depth; layer = layer + 1) {
        plainW[layer] = plainW[layer] - learningRate * dPlainW[layer];
        plainB[layer] = plainB[layer] - learningRate * dPlainB[layer];
        skipW[layer] = skipW[layer] - learningRate * dSkipW[layer];
        skipB[layer] = skipB[layer] - learningRate * dSkipB[layer];
    }
}

var plainLoss = meanLoss(plainW, plainB, false);
var skipLoss = meanLoss(skipW, skipB, true);
io.print("Residual vs plain sigmoid stack");
io.print("plain loss:    " + fmt(plainLoss));
io.print("residual loss: " + fmt(skipLoss));

math.seed(9);
var hiddenSize = 6;
var keep = 0.5;
var xDrop = [1.0, 0.5];
var w1 = [];
for (var i = 0; i < 2; i = i + 1) {
    var row = [];
    for (var j = 0; j < hiddenSize; j = j + 1) {
        row.append(math.randomFloat(0.2, 0.8));
    }
    w1.append(row);
}
var b1 = [];
for (var j = 0; j < hiddenSize; j = j + 1) {
    b1.append(0.1);
}

var hidden = nn.dense(xDrop, w1, b1, "relu").out;
var trainHidden = [];
var maskedIndex = -1;
var maskedValue = -1.0;
for (var j = 0; j < hidden.length; j = j + 1) {
    var keepUnit = math.randomFloat(0.0, 1.0) < keep;
    if (keepUnit) {
        trainHidden.append(hidden[j] / keep);
    } else {
        trainHidden.append(0.0);
        if (maskedIndex < 0) {
            maskedIndex = j;
            maskedValue = 0.0;
        }
    }
}

var evalZeros = 0;
for (var j = 0; j < hidden.length; j = j + 1) {
    if (hidden[j] == 0.0) {
        evalZeros = evalZeros + 1;
    }
}

io.print("Dropout keep p=" + fmt(keep));
io.print("masked activation: " + fmt(maskedValue));
io.print("eval zeros: " + string(evalZeros));
if (skipLoss < plainLoss * 0.5 && maskedValue == 0.0 && evalZeros == 0) {
    io.print("residual dropout ok");
}
