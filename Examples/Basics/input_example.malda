// Note: Enter input values in the 'Program Input' field below
// One value per line, e.g.:
// Alice
// 25

io.print("Starting input example...");

var name = io.input("Enter your name: ");
io.print($"Name received: {name}");

var ageStr = io.input("Enter your age: ");
io.print($"Age string received: {ageStr}");

if (ageStr != "") {
    var age = int(ageStr);
    io.print($"You are {age} years old.");
    
    if (age >= 18) {
        io.print("You are an adult.");
    } else {
        io.print("You are a minor.");
    }
} else {
    io.print("No age provided.");
}
