// errors_and_match.malda — try/catch/finally and match expressions
// Run: malda Examples/Basics/errors_and_match.malda

io.print("=== try / catch (string throw) ===");
try {
    throw "something went wrong";
} catch (error) {
    io.print("caught: " + error);
}

io.print("=== tagged catch (dict kind) ===");
try {
    throw dict { "kind": "IO", "message": "disk full" };
} catch (e if e.kind == "IO") {
    io.print("IO: " + e.message);
} catch (e) {
    io.print("other: " + e);
}

io.print("=== finally always runs ===");
try {
    io.print("in try");
} catch (error) {
    io.print("caught: " + error);
} finally {
    io.print("cleanup");
}

io.print("=== match on status code ===");
var status = 404;
var label = match status {
    case 200: "ok";
    case 404: "not found";
    default: "other";
};
io.print("status " + status + " => " + label);

io.print("=== match as statement ===");
match status {
    case 200: io.print("success path");
    case 404: io.print("missing resource");
    default: io.print("unexpected status");
}

io.print("Done.");
