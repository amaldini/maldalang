// modules_include.malda — compose programs with include
// Run: malda Examples/Basics/modules_include.malda
//
// include "path"; splices another .malda file at the top level (relative to this file).
// That is different from import/export — see modules_import.malda and the Reference Manual.

include "helpers/greet_lib.malda";

io.print(greet("MALDA"));
io.print("2 + 3 = " + add(2, 3));
io.print("Done.");
