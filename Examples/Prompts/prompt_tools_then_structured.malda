// prompt_tools_then_structured.malda — Mode C: gather-then-extract as one declaration
//
// Offline-first: builds a PromptInstance and prints gather tools (no LLM).
// With a configured LLM, `await research(...)` runs a tool round, then a typed
// extract without tools (Mode A response_format + validate/repair).
// Run: malda Examples/Prompts/prompt_tools_then_structured.malda
//
// `gather:` + `-> Type` is Mode C. Plain `tools:` stays Mode B (one call, no format).

schema ResearchAnswer {
    summary: string;
    sources: string[];
}

prompt research(question) -> ResearchAnswer {
    gather: ["read_file", "grep"];
    system: "Use tools, then the extract step will structure the answer.";
    user: "Question: {question}"
}

var inst = research("What is Mode C for typed prompts?");

print("Mode C gather-then-extract (offline PromptInstance):");
print("gather=" + toJSON(inst.gather));
print("tools=" + toJSON(inst.tools));
print("user preview: " + str.substring(inst.user, 0, 40) + "...");
print("Live: await research(question) — tool round, then typed extract.");
