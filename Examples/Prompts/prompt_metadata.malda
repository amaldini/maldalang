// Prompt with Metadata
// Demonstrates optional metadata fields: model, temperature, tools, maxTokens

prompt advancedPrompt(task) {
    system: "You are an expert assistant.",
    user: "Help me with: {task}",
    model: "openai/gpt-4",
    temperature: 0.7,
    tools: ["read_file", "write_file", "grep"],
    maxTokens: 2000
}

var prompt = advancedPrompt("analyze codebase");

io.print("Prompt metadata:");
io.print("System: " + (p.system != null ? p.system : "null"));
io.print("User: " + p.user);
io.print("Model: " + (p.model != null ? p.model : "null"));
io.print("Temperature: " + (p.temperature != null ? string(p.temperature) : "null"));
io.print("Max Tokens: " + (p.maxTokens != null ? string(p.maxTokens) : "null"));

if (p.tools != null) {
    io.print("Tools: " + toJSON(p.tools));
} else {
    io.print("Tools: null");
}
