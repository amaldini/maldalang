// RAG Pipeline — named functions over |> primitives
// Runs without a live LLM (structure demo + mock parseJson)

schema Answer {
    text: string;
    sources: string[];
}

prompt answerPrompt(question, context) -> Answer {
    system: "Answer using only the provided context.",
    user: "Context:\n{context}\n\nQuestion: {question}"
}

function embedText(text) {
    return embedBagOfWords(text, 16);
}

// --- Setup knowledge base ---
var vdb = new VectorDB(16, "single");
vdb.init(embedText);

var docs = [
    { content: "GraphMemory stores facts in a graph with semantic retrieval.", metadata: { source: "memory.md" } },
    { content: "VectorDB provides cosine similarity search over embeddings.", metadata: { source: "vectordb.md" } }
];

indexInto(vdb, docs);
var retriever = vdb.asRetriever({ topK: 2 });

// --- Named pipeline functions ---
function ragContext(question, retriever) {
    var hits = question |> retriever.get;
    var text = formatRetrievedDocs(hits);
    return text;
}

function ragPrompt(question, context) {
    return context |> (ctx) => answerPrompt(question, ctx);
}

function ragParse(mockResponse) {
    return mockResponse |> parseJson("Answer");
}

var question = "How does GraphMemory work?";
var context = ragContext(question, retriever);
var p = ragPrompt(question, context);

io.print("=== Function: ragContext ===");
io.print(context);
io.print("");
io.print("=== Function: ragPrompt ===");
io.print(p.user);

var mockResponse = "{\"text\":\"GraphMemory stores facts with semantic retrieval.\",\"sources\":[\"memory.md\"]}";
var parsed = ragParse(mockResponse);
io.print("");
io.print("=== Function: ragParse ===");
io.print(parsed.text);
io.print(str.join(parsed.sources, ", "));

io.print("");
io.print("End-to-end with LLM (set OPENROUTER_API_KEY):");
io.print("  function ragAnswer(question, client) {");
io.print("      return question |> retriever.get |> formatRetrievedDocs");
io.print("          |> (ctx) => answerPrompt(question, ctx) |> runPrompt(client) |> parseJson(\"Answer\");");
io.print("  }");
io.print("  var result = await ragAnswer(question, client);");
