// RAG Pipeline — composePipe / parallelRun over |> primitives
// Runs without a live LLM (structure demo)

schema Answer {
    text: string;
    sources: string[];
}

prompt answerPrompt(question, context) {
    system: "Answer using only the provided context.",
    user: "Context:\n{context}\n\nQuestion: {question}"
}

function embedText(text) {
    return embedBagOfWords(text, 16);
}

var vdb = new VectorDB(16, "single");
vdb.init(embedText);

var docs = [
    { content: "GraphMemory stores facts in a graph with semantic retrieval.", metadata: { source: "memory.md" } },
    { content: "VectorDB provides cosine similarity search over embeddings.", metadata: { source: "vectordb.md" } }
];

indexInto(vdb, docs);
var retriever = vdb.asRetriever({ topK: 2 });

// --- parallelRun: same query, multiple retrieval branches ---
function buildContext(question) {
    var parallel = parallelRun(question, {
        primary: (q) => q |> retriever.get,
        secondary: (q) => q |> retriever.get
    });
    var merged = mergeRetrievedDocs(parallel.primary, parallel.secondary);
    var text = formatRetrievedDocs(merged);
    return text;
}

var question = "How does GraphMemory work?";
var context = buildContext(question);

// composePipe builds a reusable sequence. Ending on a PromptInstance would
// auto-run the LLM via composePipe coercion — keep the demo offline:
var summarize = composePipe(
    buildContext,
    (ctx) => "chars=" + string(length(ctx))
);

var p = answerPrompt(question, context);

print("=== parallelRun + mergeRetrievedDocs ===");
print(context);
print("");
print("=== composePipe ===");
print(summarize(question));
print("");
print("=== prompt template ===");
print(p.user);

print("");
print("End-to-end with LLM (set OPENROUTER_API_KEY):");
print("  var pipeline = composePipe(buildContext, (ctx) => answerPrompt(q, ctx), runPrompt(client), parseJson(\"Answer\"));");
print("  var result = await pipeline(question);");
