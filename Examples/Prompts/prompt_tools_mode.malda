// prompt_tools_mode.malda — Mode B: tools listed → no response_format / no schema appendix
//
// Offline: builds PromptInstance only (no await / no LLM).
// Run: malda Examples/Prompts/prompt_tools_mode.malda
//
// Policy: when the prompt body lists tools, MALDA does not send OpenAI
// response_format and does not append MALDA_OUTPUT_SCHEMA. On await with
// -> Type, validate + repair still run (fragile for local models).
// Prefer Mode A (schema_prompt_structured.malda) or Mode C
// (prompt_tools_then_structured.malda) for reliable structured JSON.

prompt researchWithTools(topic) {
    system: "You are a research assistant with file tools.",
    user: "Investigate: {topic}",
    tools: ["read_file", "grep", "list_dir"],
    temperature: 0.2
}

var inst = researchWithTools("how prompts bind tools");

print("Mode B tools prompt (offline PromptInstance):");
print("user=" + inst.user);
print("tools=" + toJSON(inst.tools));
print("Note: no response_format / no schema appendix while tools are set.");
