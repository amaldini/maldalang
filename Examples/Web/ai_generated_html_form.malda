// Note: Requires OPENROUTER_API_KEY environment variable
// This example demonstrates AI-generated HTML input forms using HttpServer with @AIPAGE and @POST decorators

var server = new HttpServer(8080);

// Use @AIPAGE decorator to automatically generate HTML using AI
// The description tells the AI what kind of form to create
@AIPAGE("/", "Contact form with name, email, and message fields")
function homePage() {
    // AI will automatically generate the HTML on first access
    // The generated HTML includes AJAX form submission automatically
    return "";
}

// Handle form submissions with @POST decorator
@POST("/submit")
function handleSubmit(body) {
    print("Form submitted!");
    print("Name: " + body.name);
    print("Email: " + body.email);
    print("Message: " + body.message);
    
    // Return a success page
    return {
        "status": 200,
        "body": "<html><head><title>Thank You</title></head><body><h1>Thank You!</h1><p>Your message has been received.</p><p><a href='/'>Back to form</a></p></body></html>"
    };
}

server.start();
print("Server running at http://localhost:8080");
print("Open http://localhost:8080 in your browser");
print("The form will be automatically generated by AI on first access");
print("Press Ctrl+C to stop the server");
