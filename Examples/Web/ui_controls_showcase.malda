// Comprehensive server-side UI showcase with all available ui.* controls.

var sid = "ui-controls-showcase";

function buildShowcase(statusKey, showExtra) {
    var baseCard = ui.panel(
        {"className": "slot-card"},
        [
            ui.slot({"name": "title"}),
            ui.slot({"name": "body"})
        ]
    );

    var cardWithTitle = ui.withSlot(baseCard, "title", ui.heading({"value": "Slot Showcase"}));
    var cardComplete = ui.withSlot(
        cardWithTitle,
        "body",
        ui.text({"value": "Body content injected using ui.withSlot()."})
    );

    var conditionalNode = ui.when(
        showExtra,
        ui.badge({"value": "extra-visible"}),
        ui.badge({"value": "extra-hidden"})
    );

    var chosenStatus = ui.choose(
        statusKey,
        {
            "success": ui.alert({"variant": "success"}, [ui.text({"value": "Everything looks good."})]),
            "warning": ui.alert({"variant": "warning"}, [ui.text({"value": "Please review highlighted fields."})])
        },
        ui.alert({"variant": "info"}, [ui.text({"value": "Unknown status."})])
    );

    var tagItems = ui.each(["alpha", "beta", "gamma"], "value");

    return ui.column(
        {"componentId": "UiShowcaseRoot", "className": "showcase-root"},
        [
            ui.heading({"value": "MALDA UI Controls Showcase"}),
            ui.text({"value": "Demonstrates all currently available UI controls."}),

            ui.panel(
                {"className": "layout-panel"},
                [
                    ui.heading({"value": "Layout Controls"}),
                    ui.row(
                        {"className": "layout-row"},
                        [
                            ui.panel({"className": "box-left"}, [ui.text({"value": "Left panel"})]),
                            ui.spacer({}),
                            ui.panel({"className": "box-right"}, [ui.text({"value": "Right panel"})])
                        ]
                    ),
                    ui.stack(
                        {"className": "layout-stack"},
                        [
                            ui.badge({"value": "stack-item-1"}),
                            ui.badge({"value": "stack-item-2"})
                        ]
                    ),
                    ui.drawer({"open": true, "title": "Drawer Content"}, [ui.text({"value": "Drawer body"})]),
                    ui.tabs({"value": "overview"}, [
                        ui.panel({"key": "overview"}, [ui.text({"value": "Overview tab"})]),
                        ui.panel({"key": "details"}, [ui.text({"value": "Details tab"})])
                    ]),
                    ui.accordion({}, [
                        ui.panel({"key": "faq-1"}, [ui.text({"value": "Accordion section A"})]),
                        ui.panel({"key": "faq-2"}, [ui.text({"value": "Accordion section B"})])
                    ]),
                    ui.breadcrumbs({"items": "Home / Web / Showcase"})
                ]
            ),

            ui.panel(
                {
                    "className": "display-panel",
                    "style": {"padding": "14px", "border": "1px solid #d9e0ea", "borderRadius": "10px"}
                },
                [
                    ui.heading({"value": "Display Controls"}),
                    ui.icon({"name": "sparkles", "size": 18}),
                    ui.image({
                        "src": "https://via.placeholder.com/160x60?text=MALDA+UI",
                        "alt": "Placeholder image",
                        "width": 160,
                        "height": 60
                    }),
                    cardComplete,
                    conditionalNode,
                    chosenStatus
                ]
            ),

            ui.form(
                {"componentId": "DemoForm", "onSubmit": "submitDemoForm"},
                [
                    ui.heading({"value": "Input and Form Controls"}),
                    ui.field({}, [
                        ui.text({"value": "Name"}),
                        ui.textField({"name": "name", "placeholder": "Your name", "onInput": "trackName"})
                    ]),
                    ui.field({}, [
                        ui.text({"value": "Email"}),
                        ui.textField({"name": "email", "placeholder": "name@example.com", "onChange": "validateEmail"})
                    ]),
                    ui.field({}, [
                        ui.text({"value": "Message"}),
                        ui.textArea({"name": "message", "rows": 4, "placeholder": "Write something..."})
                    ]),
                    ui.checkbox({"name": "updates", "defaultChecked": true, "label": "Receive updates", "onChange": "toggleUpdates"}),
                    ui.switch({"name": "darkMode", "checked": false, "label": "Enable dark mode", "onChange": "toggleDarkMode"}),
                    ui.select({
                        "name": "priority",
                        "value": "normal",
                        "options": [
                            {"label": "Low", "value": "low"},
                            {"label": "Normal", "value": "normal"},
                            {"label": "High", "value": "high"}
                        ],
                        "onChange": "changePriority"
                    }),
                    ui.radioGroup({
                        "name": "plan",
                        "value": "pro",
                        "options": [
                            {"label": "Free", "value": "free"},
                            {"label": "Pro", "value": "pro"}
                        ],
                        "onChange": "changePlan"
                    }),
                    ui.slider({"name": "volume", "value": 40, "min": 0, "max": 100, "step": 5, "onInput": "previewVolume"}),
                    ui.field({}, [
                        ui.text({"value": "Due date"}),
                        ui.datePicker({"name": "dueDate", "value": "2026-02-22", "placeholder": "Pick a date", "onChange": "changeDueDate"})
                    ]),
                    ui.field({}, [
                        ui.text({"value": "Scheduled at"}),
                        ui.datePicker({"name": "scheduledAt", "value": "2026-02-22T14:30", "includeTime": true, "placeholder": "Date and time"})
                    ]),
                    ui.button({"label": "Submit", "variant": "primary", "onClick": "submit"})
                ]
            ),

            ui.panel(
                {"className": "data-panel"},
                [
                    ui.heading({"value": "Data and Feedback Controls"}),
                    ui.list({}, tagItems),
                    ui.table(
                        {"className": "basic-table"},
                        [
                            ui.row({}, [ui.text({"value": "Name"}), ui.text({"value": "Role"})]),
                            ui.row({}, [ui.text({"value": "Andrea"}), ui.text({"value": "Maintainer"})])
                        ]
                    ),
                    ui.dataGrid({
                        "columns": [
                            {"key": "name", "title": "Name", "sortable": true},
                            {"key": "role", "title": "Role", "sortable": true}
                        ],
                        "rows": [
                            {"id": 1, "name": "Andrea", "role": "Owner"},
                            {"id": 2, "name": "Alex", "role": "Contributor"}
                        ],
                        "rowKey": "id",
                        "selectionMode": "single",
                        "selectedKeys": [1],
                        "sortable": true,
                        "sort": {"key": "name", "direction": "asc"},
                        "filter": {"name": "A"},
                        "page": 1,
                        "pageSize": 10,
                        "totalItems": 2,
                        "virtualize": true,
                        "rowHeight": 32,
                        "overscan": 3,
                        "height": 220,
                        "onRowClick": "openRow",
                        "onSelectionChange": "setSelection",
                        "onSort": "sortRows",
                        "onFilter": "filterRows",
                        "onPageChange": "changePage",
                        "onViewportChange": "viewportChanged"
                    }),
                    ui.treeView({
                        "nodes": [
                            {
                                "id": "root",
                                "label": "Root",
                                "children": [
                                    {"id": "child-1", "label": "Child 1"},
                                    {"id": "child-2", "label": "Child 2"}
                                ]
                            }
                        ],
                        "nodeKey": "id",
                        "expandedKeys": ["root"],
                        "selectedKeys": ["child-1"],
                        "selectionMode": "single",
                        "showLines": true,
                        "lazy": false,
                        "onNodeSelect": "selectNode",
                        "onNodeToggle": "toggleNode",
                        "onNodeExpand": "expandNode",
                        "onNodeCollapse": "collapseNode",
                        "onNodeActivate": "activateNode"
                    }),
                    ui.paginator({"page": 1, "pageSize": 10, "totalItems": 100, "onChange": "paginate"}),
                    ui.emptyState({}, [ui.text({"value": "No records found for the current filter."})]),
                    ui.progress({"value": 72, "max": 100}),
                    ui.skeleton({"className": "skeleton-line"}),
                    ui.spinner({"className": "loading-spinner"}),
                    ui.errorBoundary({}, [ui.text({"value": "Error boundary fallback content"})]),
                    ui.modal({"open": true, "title": "Modal Preview", "onClose": "closeModal"}, [
                        ui.text({"value": "This modal demonstrates overlay-based content."})
                    ]),
                    ui.toast({"open": true, "message": "Changes saved", "variant": "success", "onClose": "dismissToast"})
                ]
            )
        ]
    );
}

ui.configure("maxPatchCount", 1024, sid);
ui.configure("maxEventQueueDepth", 1024, sid);
ui.configure("sessionTtlMs", 1800000);

var mountedTree = buildShowcase("success", true);
print(ui.mount(mountedTree, sid));

ui.dispatchEvent({"type": "click", "targetPath": "/3/9/", "payload": {"action": "submit"}}, sid, 1);
print(ui.pullEvent(sid));

ui.setState("UiShowcaseRoot", "lastAction", "submit", sid);
print(ui.state("UiShowcaseRoot", "lastAction", "none", sid));

var rerenderedTree = buildShowcase("warning", false);
print(ui.render(rerenderedTree, sid));
print(ui.snapshot(sid));
print(ui.resync(sid));

var server = new HttpServer(8080);

@PAGE("/web/ui-controls-showcase")
function uiControlsShowcasePage() {
    var html = "<!DOCTYPE html><html><head><meta charset='utf-8'><title>UI Controls Showcase</title>";
    html = html + "<style>body{font-family:Arial,sans-serif;margin:20px;background:#f6f8fb}h1,h2{margin:8px 0}.card{background:#fff;border:1px solid #d9e0ea;border-radius:10px;padding:14px;margin:12px 0}.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.tabs button{padding:6px 10px}.tab-panel{display:none;padding:10px;border:1px solid #d9e0ea;border-radius:8px;margin-top:8px}.tab-panel.active{display:block}.drawer{position:fixed;top:0;right:-320px;width:300px;height:100%;background:#fff;border-left:1px solid #d9e0ea;box-shadow:-4px 0 12px rgba(0,0,0,.15);padding:16px;transition:right .25s}.drawer.open{right:0}.badge{display:inline-block;background:#e8f0ff;color:#224;padding:2px 8px;border-radius:999px}.toast{position:fixed;bottom:20px;right:20px;background:#1f7a1f;color:#fff;padding:10px 14px;border-radius:8px;display:none}.spinner{width:18px;height:18px;border:3px solid #d9e0ea;border-top-color:#3b82f6;border-radius:50%;display:inline-block;animation:spin 1s linear infinite}.skeleton{height:14px;background:linear-gradient(90deg,#eef2f8,#f8faff,#eef2f8);background-size:200% 100%;animation:sh 1.2s infinite;border-radius:6px}.grid{border-collapse:collapse;width:100%}.grid th,.grid td{border:1px solid #d9e0ea;padding:6px;text-align:left}.tree ul{margin:0;padding-left:20px}.pager button{padding:4px 8px}dialog{border:1px solid #d9e0ea;border-radius:10px;padding:14px}@keyframes spin{to{transform:rotate(360deg)}}@keyframes sh{0%{background-position:200% 0}100%{background-position:-200% 0}}</style>";
    html = html + "</head><body>";
    html = html + "<h1>UI Controls Showcase</h1><p>Interactive controls demo. Envelope JSON is available at <code>/web/api/ui-controls-showcase</code>.</p>";
    html = html + "<div class='card'><h2>Navigation</h2><div>Home / Web / Showcase</div><div class='tabs'><button type='button' data-tab='overview'>Overview</button><button type='button' data-tab='details'>Details</button></div><div id='overview' class='tab-panel active'>Overview tab content</div><div id='details' class='tab-panel'>Details tab content</div><details><summary>Accordion section A</summary><p>Accordion body A</p></details><details><summary>Accordion section B</summary><p>Accordion body B</p></details></div>";
    html = html + "<div class='card'><h2>Display</h2><div class='row'><span class='badge'>beta</span><img src='https://via.placeholder.com/140x50?text=MALDA+UI' alt='placeholder'><span class='spinner'></span></div><div class='skeleton' style='width:220px;margin-top:10px'></div></div>";
    html = html + "<div class='card'><h2>Inputs and Form</h2><form id='demoForm'><div class='row'><label>Name <input name='name' placeholder='Your name'></label><label>Email <input name='email' type='email' placeholder='name@example.com'></label></div><label>Message <textarea name='message' rows='3'></textarea></label><div class='row'><label><input type='checkbox' id='updates'> Receive updates</label><label><input type='checkbox' id='switch'> Enable dark mode (switch)</label><label>Priority <select name='priority'><option>Low</option><option selected>Normal</option><option>High</option></select></label></div><div>Plan: <label><input type='radio' name='plan' value='free'> Free</label> <label><input type='radio' name='plan' value='pro' checked> Pro</label></div><label>Volume <input id='volume' type='range' min='0' max='100' value='40'> <span id='volumeOut'>40</span></label><div class='row'><button type='submit'>Submit</button><button type='button' id='openDrawer'>Open Drawer</button><button type='button' id='openModal'>Open Modal</button><button type='button' id='showToast'>Show Toast</button></div></form></div>";
    html = html + "<div class='card'><h2>Data Controls</h2><label>Filter table: <input id='gridFilter' placeholder='Type a name'></label><table class='grid' id='grid'><thead><tr><th>Name</th><th>Role</th></tr></thead><tbody><tr><td>Andrea</td><td>Owner</td></tr><tr><td>Alex</td><td>Contributor</td></tr><tr><td>Marta</td><td>QA</td></tr></tbody></table><div class='tree'><strong>Tree View</strong><ul><li><details open><summary>Root</summary><ul><li>Child 1</li><li>Child 2</li></ul></details></li></ul></div><div class='pager row'><button type='button' id='prevPage'>Prev</button><span id='pageLabel'>Page 1 / 3</span><button type='button' id='nextPage'>Next</button></div><progress max='100' value='72'></progress><div style='margin-top:8px;border:1px dashed #ccd4df;padding:8px;border-radius:8px'>Error boundary fallback area</div></div>";
    html = html + "<div class='card'><h2>List / Table / Empty State</h2><ul><li>alpha</li><li>beta</li><li>gamma</li></ul><table class='grid'><tr><th>Name</th><th>Role</th></tr><tr><td>Andrea</td><td>Maintainer</td></tr></table><div style='padding:10px;border:1px dashed #ccd4df;border-radius:8px;margin-top:8px'>No records found for current filter.</div></div>";
    html = html + "<div id='drawer' class='drawer'><h2>Drawer</h2><p>Drawer content area</p><button type='button' id='closeDrawer'>Close</button></div><dialog id='modal'><h2>Modal</h2><p>This is a modal preview.</p><button id='closeModal'>Close</button></dialog><div id='toast' class='toast'>Changes saved</div><pre id='events' class='card' style='max-height:220px;overflow:auto'>Event log:\n</pre>";
    html = html + "<script>(function(){var events=document.getElementById('events');function log(m){events.textContent+=m+'\\n';events.scrollTop=events.scrollHeight;}document.querySelectorAll('[data-tab]').forEach(function(btn){btn.addEventListener('click',function(){document.querySelectorAll('.tab-panel').forEach(function(p){p.classList.remove('active')});document.getElementById(btn.getAttribute('data-tab')).classList.add('active');log('tab:'+btn.getAttribute('data-tab'));});});var drawer=document.getElementById('drawer');document.getElementById('openDrawer').onclick=function(){drawer.classList.add('open');log('drawer:open');};document.getElementById('closeDrawer').onclick=function(){drawer.classList.remove('open');log('drawer:close');};var modal=document.getElementById('modal');document.getElementById('openModal').onclick=function(){modal.showModal();log('modal:open');};document.getElementById('closeModal').onclick=function(e){e.preventDefault();modal.close();log('modal:close');};var toast=document.getElementById('toast');document.getElementById('showToast').onclick=function(){toast.style.display='block';log('toast:show');setTimeout(function(){toast.style.display='none';},1800);};var vol=document.getElementById('volume');var out=document.getElementById('volumeOut');vol.oninput=function(){out.textContent=vol.value;log('slider:'+vol.value);};document.getElementById('demoForm').onsubmit=function(e){e.preventDefault();var fd=new FormData(e.target);log('submit:'+JSON.stringify(Object.fromEntries(fd.entries())));};document.getElementById('gridFilter').oninput=function(){var q=this.value.toLowerCase();document.querySelectorAll('#grid tbody tr').forEach(function(tr){tr.style.display=tr.children[0].textContent.toLowerCase().indexOf(q)>=0?'':'none';});log('filter:'+q);};var page=1,total=3;function updatePage(){document.getElementById('pageLabel').textContent='Page '+page+' / '+total;log('page:'+page);}document.getElementById('prevPage').onclick=function(){if(page>1){page--;updatePage();}};document.getElementById('nextPage').onclick=function(){if(page<total){page++;updatePage();}};updatePage();})();</script>";
    html = html + "</body></html>";
    return html;
}

@GET("/web/api/ui-controls-showcase")
function uiControlsShowcaseApi() {
    ui.configure("maxPatchCount", 1024, sid);
    ui.configure("maxEventQueueDepth", 1024, sid);
    ui.configure("sessionTtlMs", 1800000);

    var mounted = ui.mount(buildShowcase("success", true), sid);
    var patched = ui.render(buildShowcase("warning", false), sid);
    return {
        "status": 200,
        "sessionId": sid,
        "mount": mounted,
        "patch": patched,
        "snapshot": ui.snapshot(sid),
        "resync": ui.resync(sid)
    };
}

server.start();
print("Open: http://localhost:8080/web/ui-controls-showcase");
