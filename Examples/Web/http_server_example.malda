// Example: HttpServer with static files and dynamic pages
// Demonstrates serving static HTML files from web/ folder and dynamic pages using @PAGE decorator

// Create HTTP server on port 8080
var server = new HttpServer(8080);

// Define dynamic routes using @PAGE decorator
@PAGE("/")
function handleHome() {
    return "<html><head><title>Home</title><link rel='stylesheet' href='/style.css'></head><body><h1>Welcome to MALDA HttpServer</h1><nav><a href='/'>Home</a> | <a href='/about'>About</a> | <a href='/users'>Users</a></nav><p>This is a dynamic page generated by MALDA!</p></body></html>";
}

@PAGE("/about")
function handleAbout() {
    return "<html><head><title>About</title><link rel='stylesheet' href='/style.css'></head><body><h1>About Us</h1><nav><a href='/'>Home</a> | <a href='/about'>About</a> | <a href='/users'>Users</a></nav><p>This is the about page. It's generated dynamically by a MALDA function.</p></body></html>";
}

@PAGE("/user/{id}")
function handleUser(id) {
    return "<html><head><title>User " + id + "</title><link rel='stylesheet' href='/style.css'></head><body><h1>User Profile</h1><nav><a href='/'>Home</a> | <a href='/about'>About</a> | <a href='/users'>Users</a></nav><p>User ID: " + id + "</p><p>This page demonstrates path parameters in HttpServer routes.</p></body></html>";
}

@PAGE("/users")
function handleUsers() {
    var users = ["Alice", "Bob", "Charlie"];
    var html = "<html><head><title>Users</title><link rel='stylesheet' href='/style.css'></head><body><h1>User List</h1><nav><a href='/'>Home</a> | <a href='/about'>About</a> | <a href='/users'>Users</a></nav><ul>";
    var i = 0;
    while (i < users.length) {
        var userId = i + 1;
        html = html + "<li><a href='/user/" + userId + "'>" + users[i] + "</a></li>";
        i = i + 1;
    }
    html = html + "</ul></body></html>";
    return html;
}

// Advanced response example with custom status and headers
@PAGE("/api/data")
function handleApiData() {
    var response = {};
    response.status = 200;
    response.headers = {
        "Content-Type": "application/json",
        "X-Custom-Header": "my-value"
    };
    response.body = "{\"message\": \"This is JSON data\", \"timestamp\": \"" + string(1234567890) + "\"}";
    return response;
}

// Start server (automatically scans for @PAGE decorated functions and loads static files)
server.start();
print("HttpServer running at http://localhost:8080");
print("Static files directory: " + server.webDirectory);
print("Registered dynamic routes: " + server.getRoutes().length);

// Print registered routes
var routes = server.getRoutes();
var i = 0;
while (i < routes.length) {
    var route = routes[i];
    print("  " + route.method + " " + route.path);
    i = i + 1;
}

print("\nTry these URLs:");
print("  http://localhost:8080/          - Dynamic home page");
print("  http://localhost:8080/about     - Dynamic about page");
print("  http://localhost:8080/users    - Dynamic user list");
print("  http://localhost:8080/user/1   - Dynamic user page with path parameter");
print("  http://localhost:8080/api/data - Advanced response with custom headers");
print("  http://localhost:8080/style.css - Static file (if exists in web/ folder)");
print("\nPress Ctrl+C to stop the server");

// Keep script alive
while (server.isRunning) {
    sleep(1000);
}

server.stop();
print("Server stopped.");
