// Local LLM Example using LlamaCppClient
// This example demonstrates how to use a local LLM model with MALDA
// No API keys or network connection required - complete privacy and works offline

// Step 1: Create a LlamaCppClient
// With no path, MALDA uses the default Qwen/Qwen2.5-0.5B-Instruct local model
// and auto-downloads the GGUF file on first use if needed.
var client = new LlamaCppClient();

// Step 2: Configure the client (optional)
client.setTemperature(0.7);  // Control randomness (0.0 = deterministic, 2.0 = very creative)
client.setMaxTokens(2000);   // Maximum tokens in response

// Optional: Enable GPU acceleration if you have CUDA installed
// Set to the number of layers in your model (e.g., 35 for 7B models)
// client.setGpuLayerCount(35);  // 0 = CPU only, >0 = GPU layers

io.print("Local LLM client created successfully!");
io.print("Model path: " + client.modelPath);
io.print("Temperature: " + client.temperature);
io.print("Max tokens: " + client.maxTokens);
io.print("");

// Step 3: Simple completion example
io.print("=== Simple Completion ===");
var response = client.complete("What is the capital of France?");
io.print("Response: " + response);
io.print("");

// Step 4: Using with Conversation class for multi-turn conversations
io.print("=== Conversation Example ===");
var conversation = new Conversation(client, "You are a helpful assistant.");
conversation.addUserMessage("Write a function to calculate the factorial of a number.");
var convResponse = conversation.send();
io.print("Assistant: " + convResponse.content);
io.print("");

conversation.addUserMessage("Now make it iterative instead of recursive.");
var convResponse2 = conversation.send();
io.print("Assistant: " + convResponse2.content);
io.print("");

// Step 5: Using with Agent class for autonomous behavior
io.print("=== Agent Example ===");
var agent = new Agent(
    "LocalAI",
    "assistant",
    "You are a helpful coding assistant that explains concepts clearly.",
    client
);

var agentResponse = agent.think("Explain what a recursive function is in simple terms.");
io.print("Agent: " + agentResponse.content);
io.print("");

// Step 6: Example with custom temperature for creative tasks
io.print("=== Creative Writing Example ===");
client.setTemperature(0.9);  // Higher temperature for more creativity
var creativeResponse = client.complete("Write a short haiku about programming.");
io.print("Creative response: " + creativeResponse);
io.print("");

// Reset to default for factual tasks
client.setTemperature(0.7);
io.print("Temperature reset to 0.7 for factual tasks");
io.print("");

io.print("=== Example Complete ===");
io.print("Local LLM inference works completely offline with no API costs!");
io.print("Your data stays private and never leaves your machine.");
