function interviewLocaleIsItalian() {
    var raw = io.getEnv("MALDA_RALPH_LOCALE");
    if (raw == null || raw == "") {
        return false;
    }
    var lowered = str.lower(raw);
    return lowered == "it" or str.indexOf(lowered, "it-") == 0 or lowered == "italian";
}

function interviewText(enText, itText) {
    if (interviewLocaleIsItalian()) {
        return itText;
    }
    return enText;
}

function interviewBriefDraftPath(workDir) {
    return io.pathJoin(workDir, ".ralph-interview-brief.json");
}

function saveInterviewBriefDraft(workDir, brief, profile, mode) {
    if (envBool("MALDA_RALPH_INTERVIEW_NO_DRAFT", false)) {
        return;
    }
    var payload = {
        "profile": profile,
        "mode": mode,
        "brief": brief,
        "savedAt": string(now())
    };
    try {
        io.writeFile(interviewBriefDraftPath(workDir), toJSON(payload));
    } catch (error) {
        ralphLog("interview", "Could not save interview draft: " + string(error));
    }
}

function loadInterviewBriefDraft(workDir) {
    var draftPath = interviewBriefDraftPath(workDir);
    if (!io.hasFile(draftPath)) {
        return null;
    }
    try {
        return parseJSON(io.readFile(draftPath));
    } catch (error) {
        return null;
    }
}

function printInterviewBanner(workDir, prdRelativePath, modelLabel, profile, mode) {
    if (ralphQuietEnabled()) {
        return;
    }
    var rows = [
        {"Setting": "Mode", "Value": "PRD interview (terminal)"},
        {"Setting": "Profile", "Value": profile},
        {"Setting": "PRD mode", "Value": mode},
        {"Setting": "Workdir", "Value": workDir},
        {"Setting": "Output PRD", "Value": prdRelativePath},
        {"Setting": "Model", "Value": modelLabel}
    ];
    if (agentRichEnabled()) {
        ralphMarkup("[bold]Ralph Interview[/] [dim]· guided PRD authoring[/]");
        AnsiConsole.table(rows, null, ["Setting", "Value"]);
        io.print("");
    } else {
        io.print("Ralph Interview — guided PRD authoring");
        io.print("Profile: " + profile);
        io.print("PRD mode: " + mode);
        io.print("Workdir: " + workDir);
        io.print("Output PRD: " + prdRelativePath);
        io.print("Model: " + modelLabel);
        io.print("");
    }
}

function readInterviewLine(prompt, defaultValue) {
    var hint = prompt;
    if (defaultValue != null && defaultValue != "") {
        hint = hint + " [" + defaultValue + "]";
    }
    hint = hint + ": ";
    var line = io.input(hint);
    if (line == null) {
        line = "";
    }
    line = str.trim(string(line));
    if (line == "" && defaultValue != null && defaultValue != "") {
        return defaultValue;
    }
    return line;
}

function readInterviewMultiline(prompt) {
    io.print("");
    io.print(prompt);
    io.print(interviewText("(Press Enter on an empty line when done)", "(Invio su riga vuota per terminare)"));
    var lines = [];
    while (true) {
        var line = io.input("> ");
        if (line == null) {
            break;
        }
        line = string(line);
        if (str.trim(line) == "") {
            break;
        }
        lines.append(line);
    }
    if (str.length(lines) == 0) {
        return "";
    }
    return str.join(lines, "\n");
}

function resolveInterviewProfileFromEnv() {
    var raw = io.getEnv("MALDA_RALPH_INTERVIEW_PROFILE");
    if (raw == null || raw == "") {
        return "";
    }
    return str.lower(str.trim(raw));
}

function collectInterviewProfileChoice() {
    var fromEnv = resolveInterviewProfileFromEnv();
    if (fromEnv == "new" or fromEnv == "append" or fromEnv == "features" or fromEnv == "brief") {
        return fromEnv;
    }
    if (ralphQuietEnabled()) {
        return "new";
    }
    io.print("");
    io.print(interviewText("Interview profile:", "Profilo interview:"));
    io.print(interviewText("  1) new — full greenfield PRD (default)", "  1) new — PRD completo greenfield (default)"));
    io.print(interviewText("  2) append — add checklist items to existing PRD", "  2) append — aggiungi feature al PRD esistente"));
    io.print(interviewText("  3) features — only collect features (minimal questions)", "  3) features — solo raccolta feature"));
    io.print(interviewText("  4) brief — reuse saved .ralph-interview-brief.json", "  4) brief — riusa .ralph-interview-brief.json salvato"));
    var choice = readInterviewLine(interviewText("Profile", "Profilo"), "1");
    var lowerChoice = str.lower(choice);
    if (lowerChoice == "2" or lowerChoice == "append") {
        return "append";
    }
    if (lowerChoice == "3" or lowerChoice == "features") {
        return "features";
    }
    if (lowerChoice == "4" or lowerChoice == "brief") {
        return "brief";
    }
    return "new";
}

function resolveInterviewPrdMode(prdPath, profile) {
    if (profile == "append") {
        return "append";
    }
    if (!io.hasFile(prdPath)) {
        return "new";
    }
    if (envBool("MALDA_RALPH_INTERVIEW_OVERWRITE", false)) {
        return "new";
    }
    var modeEnv = io.getEnv("MALDA_RALPH_INTERVIEW_MODE");
    if (modeEnv != null && modeEnv != "") {
        var lowerMode = str.lower(str.trim(modeEnv));
        if (lowerMode == "append" or lowerMode == "new") {
            return lowerMode;
        }
    }
    if (ralphQuietEnabled()) {
        return "new";
    }
    io.print("");
    io.print(interviewText("PRD already exists:", "PRD già presente:") + " " + prdPath);
    io.print(interviewText("  o) overwrite  a) append features  c) cancel", "  o) sovrascrivi  a) aggiungi feature  c) annulla"));
    var answer = readInterviewLine(interviewText("Choice", "Scelta"), "c");
    var lowered = str.lower(answer);
    if (lowered == "a" or lowered == "append") {
        return "append";
    }
    if (lowered == "o" or lowered == "y" or lowered == "yes" or lowered == "overwrite") {
        return "new";
    }
    return "cancel";
}

function loadInterviewBriefFile() {
    var briefPath = io.getEnv("MALDA_RALPH_BRIEF");
    if (briefPath == null || briefPath == "") {
        return "";
    }
    if (!io.hasFile(briefPath)) {
        io.print(interviewText("Brief file not found (MALDA_RALPH_BRIEF): ", "File brief non trovato (MALDA_RALPH_BRIEF): ") + briefPath);
        return "";
    }
    return io.readFile(briefPath);
}

function collectStructuredFeaturesList() {
    io.print("");
    io.print(interviewText("Structured features (one at a time). Empty title to finish.", "Feature strutturate (una alla volta). Titolo vuoto per finire."));
    var items = [];
    var index = 1;
    while (true) {
        var title = readInterviewLine(interviewText("Feature F" + string(index) + " title", "Feature F" + string(index) + " titolo"), "");
        if (title == "") {
            break;
        }
        var priority = readInterviewLine(interviewText("Priority (P0/P1/P2)", "Priorità (P0/P1/P2)"), "P1");
        if (priority == "") {
            priority = "P1";
        }
        var depends = readInterviewLine(interviewText("Depends (none or F1,F2)", "Dipende da (none o F1,F2)"), "none");
        items.append({
            "id": "F" + string(index),
            "title": title,
            "priority": priority,
            "depends": depends
        });
        index = index + 1;
    }
    return items;
}

function formatStructuredFeaturesText(items) {
    if (items == null || str.length(items) == 0) {
        return "";
    }
    var text = "";
    var i = 0;
    while (i < str.length(items)) {
        var item = items[i];
        text = text + item.id + " [" + item.priority + "] " + item.title + " (depends: " + item.depends + ")\n";
        i = i + 1;
    }
    return text;
}

function collectStructuredInterviewBrief(profile, workDir) {
    if (profile == "brief") {
        var draft = loadInterviewBriefDraft(workDir);
        if (draft != null && draft.brief != null) {
            io.print(interviewText("Loaded saved brief draft.", "Caricata bozza salvata."));
            return draft.brief;
        }
        io.print(interviewText("No saved brief found — falling back to full interview.", "Nessuna bozza — interview completa."));
        profile = "new";
    }

    io.print("");
    io.print("=== Step 1 — " + interviewText("Your answers (terminal)", "Le tue risposte (terminale)") + " ===");
    io.print(interviewText("Answer in plain language. The assistant will turn this into a Ralph PRD.", "Rispondi in linguaggio naturale. L'assistente creerà un PRD Ralph."));
    io.print("");

    var title = "";
    var vision = "";
    var deliverables = "";
    var constraints = "";
    var metrics = "";
    var features = "";
    var structuredFeatures = [];
    var stack = "";
    var validation = "";
    var notes = "";
    var clarifications = "";
    var brownfield = false;

    if (profile == "features") {
        title = readInterviewLine(interviewText("Project title", "Titolo progetto"), "Feature update");
        structuredFeatures = collectStructuredFeaturesList();
        while (str.length(structuredFeatures) == 0) {
            structuredFeatures = collectStructuredFeaturesList();
        }
        features = formatStructuredFeaturesText(structuredFeatures);
        deliverables = interviewText("Checklist items in PRD.md", "Voci checklist in PRD.md");
        return {
            "title": title,
            "vision": vision,
            "deliverables": deliverables,
            "constraints": constraints,
            "metrics": metrics,
            "features": features,
            "structuredFeatures": structuredFeatures,
            "stack": stack,
            "validation": validation,
            "notes": notes,
            "clarifications": clarifications,
            "externalBrief": loadInterviewBriefFile(),
            "brownfield": brownfield
        };
    }

    title = readInterviewLine(interviewText("Project title", "Titolo progetto"), "");
    while (title == "") {
        title = readInterviewLine(interviewText("Project title (required)", "Titolo progetto (obbligatorio)"), "");
    }

    var projectKind = readInterviewLine(interviewText("Greenfield or existing repo? (greenfield/existing)", "Greenfield o repo esistente? (greenfield/existing)"), "greenfield");
    brownfield = str.lower(projectKind) == "existing" or str.lower(projectKind) == "brownfield" or str.lower(projectKind) == "e";

    vision = readInterviewMultiline(interviewText("Product vision — what are you building and for whom?", "Visione prodotto — cosa stai costruendo e per chi?"));
    while (vision == "") {
        vision = readInterviewMultiline(interviewText("Product vision (required)", "Visione prodotto (obbligatoria)"));
    }

    deliverables = readInterviewMultiline(interviewText("Deliverables — files, apps, or artifacts Ralph should produce", "Deliverable — file, app o artefatti che Ralph deve produrre"));
    if (deliverables == "") {
        deliverables = interviewText("To be refined with the assistant", "Da affinare con l'assistente");
    }

    constraints = readInterviewMultiline(interviewText("Non-negotiable constraints (stack, offline, no deps, etc.)", "Vincoli non negoziabili (stack, offline, no dipendenze, ecc.)"));
    metrics = readInterviewMultiline(interviewText("Success metrics — how will you know it is done?", "Metriche di successo — come capisci che è finito?"));

    var useStructured = readInterviewLine(interviewText("Structured feature entry? (y/n)", "Inserimento feature strutturato? (s/n)"), "y");
    if (str.lower(useStructured) == "y" or str.lower(useStructured) == "yes" or str.lower(useStructured) == "s" or str.lower(useStructured) == "si") {
        structuredFeatures = collectStructuredFeaturesList();
        features = formatStructuredFeaturesText(structuredFeatures);
    }
    if (features == "") {
        features = readInterviewMultiline(interviewText("Main features — one per line (rough order top to bottom)", "Feature principali — una per riga"));
        if (features == "") {
            features = readInterviewLine(interviewText("At least one feature to implement", "Almeno una feature"), "");
        }
    }

    stack = readInterviewLine(interviewText("Tech stack / runtime (e.g. single HTML file, .NET API, MALDA)", "Stack / runtime (es. HTML singolo, .NET API, MALDA)"), "");
    validation = readInterviewLine(interviewText("How should Ralph verify work? (e.g. open in browser, dotnet test)", "Come verificare il lavoro? (es. browser, dotnet test)"), "");
    notes = readInterviewMultiline(interviewText("Extra notes for the agent (optional)", "Note extra per l'agente (opzionale)"));
    clarifications = readInterviewMultiline(interviewText("Anything else the PRD author should know? (optional)", "Altro che l'autore del PRD deve sapere? (opzionale)"));
    var externalBrief = loadInterviewBriefFile();

    return {
        "title": title,
        "vision": vision,
        "deliverables": deliverables,
        "constraints": constraints,
        "metrics": metrics,
        "features": features,
        "structuredFeatures": structuredFeatures,
        "stack": stack,
        "validation": validation,
        "notes": notes,
        "clarifications": clarifications,
        "externalBrief": externalBrief,
        "brownfield": brownfield
    };
}

function buildInterviewBriefText(brief) {
    var text = "Project title: " + brief.title + "\n\n" +
        "Vision:\n" + brief.vision + "\n\n" +
        "Deliverables:\n" + brief.deliverables + "\n\n" +
        "Constraints:\n" + brief.constraints + "\n\n" +
        "Success metrics:\n" + brief.metrics + "\n\n" +
        "Feature ideas (user order):\n" + brief.features + "\n";
    if (brief.stack != null && brief.stack != "") {
        text = text + "\nTech stack:\n" + brief.stack + "\n";
    }
    if (brief.validation != null && brief.validation != "") {
        text = text + "\nVerification:\n" + brief.validation + "\n";
    }
    if (brief.notes != null && brief.notes != "") {
        text = text + "\nExtra notes:\n" + brief.notes + "\n";
    }
    if (brief.clarifications != null && brief.clarifications != "") {
        text = text + "\nClarifications:\n" + brief.clarifications + "\n";
    }
    if (brief.externalBrief != null && brief.externalBrief != "") {
        text = text + "\nExternal brief file:\n" + brief.externalBrief + "\n";
    }
    if (brief.brownfield == true) {
        text = text + "\nProject type: existing repository (brownfield)\n";
    }
    return text;
}

function previewAndConfirmBrief(brief) {
    if (ralphQuietEnabled() or envBool("MALDA_RALPH_INTERVIEW_SKIP_PREVIEW", false)) {
        return brief;
    }
    io.print("");
    io.print("=== " + interviewText("Brief preview", "Anteprima brief") + " ===");
    io.print(buildInterviewBriefText(brief));
    io.print("=== " + interviewText("End preview", "Fine anteprima") + " ===");
    var answer = readInterviewLine(interviewText("Continue to LLM step? (Y/edit/cancel)", "Continuare allo step LLM? (S/modifica/annulla)"), "y");
    var lowered = str.lower(answer);
    if (lowered == "c" or lowered == "cancel" or lowered == "n" or lowered == "no") {
        return null;
    }
    if (lowered == "edit" or lowered == "modifica" or lowered == "e") {
        io.print(interviewText("Re-enter project title (leave empty to keep):", "Reinserisci titolo (vuoto = mantieni):"));
        var newTitle = readInterviewLine("", brief.title);
        if (newTitle != "") {
            brief.title = newTitle;
        }
        var newVision = readInterviewMultiline(interviewText("Re-enter vision (empty line only to keep current):", "Reinserisci visione (solo invio = mantieni):"));
        if (newVision != "") {
            brief.vision = newVision;
        }
    }
    return brief;
}

function loadInterviewTemplateContent() {
    var templatePath = io.getEnv("MALDA_RALPH_INTERVIEW_TEMPLATE");
    if (templatePath != null && templatePath != "" && io.hasFile(templatePath)) {
        return io.readFile(templatePath);
    }
    return "";
}

function loadInterviewFewShotExcerpt() {
    var customPath = io.getEnv("MALDA_RALPH_INTERVIEW_FEWSHOT");
    if (customPath != null && customPath != "" && io.hasFile(customPath)) {
        return io.readFile(customPath);
    }
    return "- [TODO] [P0] **F1 — Scaffold** (depends: none)\n" +
        "  - Files: main.html\n" +
        "  - Verify: main.html\n" +
        "  - Acceptance: app loads; core loop works\n" +
        "- [TODO] [P1] **F2 — Polish** (depends: F1)\n" +
        "  - Acceptance: improved UI; stable FPS\n";
}

function buildBrownfieldContext(workDir, brief) {
    if (brief == null || brief.brownfield != true) {
        if (!envBool("MALDA_RALPH_INTERVIEW_BROWNFIELD", false)) {
            return "";
        }
    }
    var lines = [];
    var entries = io.listDirectory(workDir);
    var i = 0;
    while (i < str.length(entries) && str.length(lines) < 40) {
        var entry = entries[i];
        if (entry.name != null && entry.name != "." && entry.name != "..") {
            if (entry.type == "directory") {
                lines.append("[dir] " + entry.name);
            } else {
                lines.append("[file] " + entry.name);
            }
        }
        i = i + 1;
    }
    var fileSummary = str.join(lines, "\n");
    var samplePaths = ralphGlobPaths(workDir, "**/*", 30);
    var globSummary = str.join(samplePaths, "\n");
    return "BROWNFIELD WORKDIR SNAPSHOT:\nTop-level entries:\n" + fileSummary + "\n\nSample paths (glob **/*):\n" + globSummary;
}

function buildPrdSectionLabels() {
    if (interviewLocaleIsItalian()) {
        return {
            "vision": "## Visione prodotto",
            "checklist": "## Checklist feature",
            "notes": "## Note per l'agente"
        };
    }
    return {
        "vision": "## Product vision",
        "checklist": "## Feature checklist",
        "notes": "## Agent notes"
    };
}

function buildPrdAuthoringPrompt(briefText, prdRelativePath, prdMode, brownfieldContext) {
    var maxFollowUps = envInt("MALDA_RALPH_INTERVIEW_MAX_FOLLOWUPS", 8);
    var labels = buildPrdSectionLabels();
    var fewShot = loadInterviewFewShotExcerpt();
    var template = loadInterviewTemplateContent();
    var validateHint = "";
    if (envBool("MALDA_RALPH_INTERVIEW_SUGGEST_VALIDATE_CMD", false)) {
        validateHint = "- In agent notes, mention copying templates/ralph-validate.bat.sample to .ralph-validate.bat when tests apply.\n";
    }
    var modeRule = "- Write the complete PRD to " + prdRelativePath + " using write_file.\n";
    if (prdMode == "append") {
        modeRule = "- Read the existing " + prdRelativePath + " first. Append NEW checklist items only; preserve existing [DONE] items and sections.\n" +
            "- Do not remove or rewrite completed work unless the user brief requires it.\n";
    }
    var brownfieldRule = "";
    if (brownfieldContext != null && brownfieldContext != "") {
        brownfieldRule = "BROWNFIELD CONTEXT:\n" + brownfieldContext + "\n\n" +
            "- Infer realistic Files:/Verify: paths from the repo snapshot before writing the PRD.\n";
    }
    var templateRule = "";
    if (template != null && template != "") {
        templateRule = "OPTIONAL TEMPLATE (adapt placeholders):\n" + template + "\n\n";
    }
    return "You are authoring a Ralph Wiggum PRD for autonomous development.\n\n" +
        "USER BRIEF (from terminal interview — Step 1):\n" + briefText + "\n\n" +
        brownfieldRule +
        templateRule +
        "EXAMPLE CHECKLIST SYNTAX (few-shot):\n" + fewShot + "\n\n" +
        "RULES:\n" +
        "- Step 2: use ask_user for up to " + string(maxFollowUps) + " short clarifying questions when the brief is ambiguous.\n" +
        "  Each question must be one sentence. Wait for the answer before the next question.\n" +
        "  Skip ask_user if the brief is already clear enough to write the PRD.\n" +
        modeRule +
        "- Do not modify any other files except the PRD markdown.\n" +
        "- Use this exact checklist syntax on its own line per feature:\n" +
        "  - [TODO] [P0] **F1 — Short title** (depends: none)\n" +
        "  - [TODO] [P1] **F2 — Next feature** (depends: F1)\n" +
        "- Under each item include indented lines:\n" +
        "  - Acceptance: semicolon-separated testable criteria\n" +
        "  - Files: comma-separated paths to edit (when known)\n" +
        "  - Verify: comma-separated paths to validate (optional)\n" +
        "- Priorities: [P0] critical path, [P1] important, [P2] polish. Use [SKIP] only for explicitly deferred items.\n" +
        "- Sections: # title, " + labels.vision + ", constraints bullet list, metrics bullet list, " + labels.checklist + ", " + labels.notes + ".\n" +
        "- Agent notes must say: one feature per Ralph iteration; mark [DONE] only when acceptance is met and validation passes.\n" +
        "- Number features F1, F2, F3... with sensible depends: chains.\n" +
        validateHint +
        "- Reply PRD_READY when the file is written and checklist has at least one [TODO] item.";
}

function extractPrdFeatureIdFromLine(line) {
    if (line == null || line == "") {
        return "";
    }
    var upperLine = str.upper(line);
    var idx = str.indexOf(upperLine, "**F");
    if (idx < 0) {
        return "";
    }
    var rest = str.substring(line, idx + 3, str.length(line) - idx - 3);
    var id = "F";
    var j = 0;
    while (j < str.length(rest)) {
        var ch = str.substring(rest, j, 1);
        if (ch >= "0" && ch <= "9") {
            id = id + ch;
            j = j + 1;
        } else {
            break;
        }
    }
    if (id == "F") {
        return "";
    }
    return str.upper(id);
}

function validateInterviewPrdStrict(prdPath) {
    var errors = [];
    var warnings = [];
    if (!io.hasFile(prdPath)) {
        return {"ok": false, "reason": "PRD file was not created", "errors": errors, "warnings": warnings, "progress": {"done": 0, "open": 0, "total": 0, "percent": 0}};
    }
    var progress = countPrdChecklistProgress(prdPath);
    if (progress.total == 0) {
        errors.append("No checklist items found (need lines with - [TODO] or - [ ])");
    }
    if (progress.open == 0) {
        errors.append("No open [TODO] items — Ralph needs at least one open checklist item");
    }
    var lines = str.split(io.readFile(prdPath), "\n");
    var allIds = [];
    var i = 0;
    while (i < str.length(lines)) {
        var scanLine = lines[i];
        var scanLower = str.lower(scanLine);
        if (!isPrdSkippedStatus(scanLower)) {
            var scanId = extractPrdFeatureIdFromLine(scanLine);
            if (scanId != "") {
                allIds.append(scanId);
            }
        }
        i = i + 1;
    }
    var hasOpenP0 = false;
    i = 0;
    while (i < str.length(lines)) {
        var line = lines[i];
        var lineLower = str.lower(line);
        if (isPrdSkippedStatus(lineLower)) {
            i = i + 1;
            continue;
        }
        var isOpen = str.indexOf(lineLower, "- [todo]") >= 0 or str.indexOf(lineLower, "- [ ]") >= 0;
        var isDone = str.indexOf(lineLower, "- [done]") >= 0;
        if (isOpen or isDone) {
            var fid = extractPrdFeatureIdFromLine(line);
            if (fid == "") {
                errors.append("Checklist line missing feature id (**F1 — title**): " + str.trim(line));
            }
            if (isOpen && str.indexOf(lineLower, "[p0]") >= 0) {
                hasOpenP0 = true;
            }
            if (isOpen) {
                var acceptance = collectAcceptanceForLine(prdPath, i);
                if (acceptance == null || acceptance == "") {
                    errors.append("Missing Acceptance: under open item " + fid);
                }
            }
            var deps = parsePrdDepends(line);
            var d = 0;
            while (d < str.length(deps)) {
                var depId = deps[d];
                var found = false;
                var k = 0;
                while (k < str.length(allIds)) {
                    if (allIds[k] == depId) {
                        found = true;
                    }
                    k = k + 1;
                }
                if (!found && depId != "NONE") {
                    errors.append("Unknown dependency " + depId + " on line: " + str.trim(line));
                }
                d = d + 1;
            }
        }
        i = i + 1;
    }
    if (progress.open > 0 && !hasOpenP0) {
        warnings.append("No open [P0] item — consider marking at least one critical-path feature as P0");
    }
    var ok = str.length(errors) == 0;
    var reason = "";
    if (!ok && str.length(errors) > 0) {
        reason = errors[0];
    }
    return {"ok": ok, "reason": reason, "errors": errors, "warnings": warnings, "progress": progress};
}

function interviewPrdLooksValid(prdPath) {
    return validateInterviewPrdStrict(prdPath);
}

function responseHasPrdReady(text) {
    if (text == null || text == "") {
        return false;
    }
    var upperText = str.upper(text);
    return str.indexOf(upperText, "PRD_READY") >= 0;
}

function createPrdInterviewAgent(client, workDir, includeSymbols) {
    var instructions = interviewText(
        "You help users produce Ralph-compatible PRD.md files. Use ask_user for brief clarifications when needed, explore the repo with read-only tools, then write the PRD with write_file only. Never implement product code in this session.",
        "Aiuti a produrre PRD.md compatibili con Ralph. Usa ask_user per chiarimenti, esplora il repo con tool read-only, poi scrivi il PRD solo con write_file. Non implementare codice prodotto in questa sessione."
    );
    return new DevAgent(
        "PrdInterviewer",
        "product requirements author",
        instructions,
        client,
        workDir,
        includeSymbols,
        true
    );
}

function runInterviewPrdRepair(agent, prdRelativePath, validationResult) {
    var errors = validationResult.errors;
    if (errors == null || str.length(errors) == 0) {
        return null;
    }
    var errorText = str.join(errors, "\n- ");
    var repairPrompt = "The PRD at " + prdRelativePath + " failed Ralph interview validation:\n- " + errorText +
        "\n\nFix ONLY " + prdRelativePath + " using read_file and write_file. Keep valid existing content. Reply PRD_READY when fixed.";
    ralphLog("interview", "Attempting automatic PRD repair...");
    return agent.think(repairPrompt);
}

function printInterviewPrdPreview(prdPath, maxLines) {
    if (ralphQuietEnabled()) {
        return;
    }
    if (!io.hasFile(prdPath)) {
        return;
    }
    var lines = str.split(io.readFile(prdPath), "\n");
    var limit = maxLines;
    if (limit == null || limit <= 0) {
        limit = 30;
    }
    io.print("");
    io.print(interviewText("PRD preview (first " + string(limit) + " lines):", "Anteprima PRD (prime " + string(limit) + " righe):"));
    io.print(interviewText("Absolute path:", "Percorso assoluto:") + " " + prdPath);
    var i = 0;
    while (i < str.length(lines) && i < limit) {
        io.print(lines[i]);
        i = i + 1;
    }
    if (str.length(lines) > limit) {
        io.print("...");
    }
    io.print("");
}

function writeInterviewSummary(workDir, brief, progress, prdPath, profile, prdMode) {
    if (envBool("MALDA_RALPH_INTERVIEW_NO_SUMMARY", false)) {
        return;
    }
    var summaryPath = io.pathJoin(workDir, "ralph-interview-summary.md");
    var text = "# Ralph Interview Summary\n\n" +
        "- Profile: " + profile + "\n" +
        "- PRD mode: " + prdMode + "\n" +
        "- Project: " + brief.title + "\n" +
        "- PRD path: " + prdPath + "\n" +
        "- Checklist: " + string(progress.open) + " open / " + string(progress.total) + " total\n" +
        "- Estimated Ralph iterations (minimum): " + string(progress.open) + "\n\n" +
        "## Next step\n\n" +
        "```bat\nset MALDA_RALPH_WORKDIR=" + workDir + "\nrun_ralph.bat\n```\n";
    io.writeFile(summaryPath, text);
    ralphLog("interview", "Summary written: " + summaryPath);
}

function suggestWorktreeIfNeeded(workDir) {
    if (ralphQuietEnabled()) {
        return;
    }
    var worktree = io.getEnv("MALDA_RALPH_WORKTREE");
    if (worktree != null && worktree != "") {
        return;
    }
    if (envBool("MALDA_RALPH_INTERVIEW_NO_WORKTREE_HINT", false)) {
        return;
    }
    io.print(interviewText(
        "Tip: for Ralph commits isolated from your main repo, use a git worktree (scripts/Ensure-RalphWorktree.ps1) and set MALDA_RALPH_WORKTREE.",
        "Suggerimento: per commit Ralph isolati, usa un git worktree (scripts/Ensure-RalphWorktree.ps1) e imposta MALDA_RALPH_WORKTREE."
    ));
}

function runInterviewPreflightCheck(workDir, prdRelativePath) {
    var mode = ralphPreflightMode();
    if (mode == "off") {
        return true;
    }
    var prdPath = io.pathJoin(workDir, prdRelativePath);
    var errors = [];
    if (!io.hasFile(prdPath)) {
        errors.append("PRD not found: " + prdPath);
    } else {
        var progress = countPrdChecklistProgress(prdPath);
        if (progress.open == 0) {
            errors.append("PRD has no open checklist items");
        }
    }
    var client = createAgentClient();
    if (client == null) {
        errors.append("LLM client not configured (API key / backend)");
    }
    if (str.length(errors) > 0) {
        var i = 0;
        while (i < str.length(errors)) {
            ralphLog("interview", "[preflight] " + errors[i]);
            i = i + 1;
        }
        return mode != "strict";
    }
    return true;
}

function tryInterviewThenLoop(workDir) {
    if (!envBool("MALDA_RALPH_INTERVIEW_THEN_LOOP", false)) {
        return;
    }
    var loopExe = io.getEnv("MALDA_RALPH_LOOP_EXE");
    if (loopExe == null || loopExe == "" || !io.hasFile(loopExe)) {
        ralphLog("interview", "MALDA_RALPH_INTERVIEW_THEN_LOOP set but MALDA_RALPH_LOOP_EXE missing — skip smoke loop");
        return;
    }
    io.print(interviewText("Running Ralph smoke loop (1 iteration)...", "Avvio smoke loop Ralph (1 iterazione)..."));
    var hookEnv = {
        "MALDA_RALPH_WORKDIR": workDir,
        "MALDA_RALPH_MAX_ITER": "1",
        "MALDA_RALPH_QUIET": "true"
    };
    var result = runCommand(loopExe, [], workDir, hookEnv);
    if (result != null && result.exitCode != null && result.exitCode != 0) {
        ralphLog("interview", "Smoke loop exited with code " + string(result.exitCode));
    }
}

function runRalphInterview(workDir, prdRelativePath) {
    var client = createAgentClient();
    if (client == null) {
        return -1;
    }

    var prdPath = io.pathJoin(workDir, prdRelativePath);
    var profile = collectInterviewProfileChoice();
    var prdMode = resolveInterviewPrdMode(prdPath, profile);
    if (prdMode == "cancel") {
        io.print(interviewText("Interview cancelled — existing PRD kept.", "Interview annullata — PRD esistente conservato."));
        return 0;
    }
    if (profile == "append") {
        prdMode = "append";
    }
    if (prdMode == "append" && !io.hasFile(prdPath)) {
        io.print(interviewText("Append mode requires an existing PRD — switching to new.", "Modalità append richiede un PRD esistente — passo a new."));
        prdMode = "new";
    }

    printInterviewBanner(workDir, prdRelativePath, resolveRalphModelLabel(), profile, prdMode);
    suggestWorktreeIfNeeded(workDir);

    var brief = collectStructuredInterviewBrief(profile, workDir);
    brief = previewAndConfirmBrief(brief);
    if (brief == null) {
        io.print(interviewText("Interview cancelled at preview.", "Interview annullata in anteprima."));
        return 0;
    }

    saveInterviewBriefDraft(workDir, brief, profile, prdMode);
    var briefText = buildInterviewBriefText(brief);
    var brownfieldContext = buildBrownfieldContext(workDir, brief);

    io.print("");
    io.print("=== Step 2 — " + interviewText("LLM follow-up (live in this terminal)", "Follow-up LLM (live in questo terminale)") + " ===");
    io.print(interviewText(
        "The assistant may ask clarifying questions via ask_user, then writes the PRD.",
        "L'assistente può fare domande con ask_user, poi scrive il PRD."
    ));
    io.print("");

    var includeSymbols = envBool("MALDA_RALPH_INCLUDE_SYMBOLS", false) or envBool("MALDA_RALPH_INTERVIEW_BROWNFIELD", false) or brief.brownfield == true;
    var agent = createPrdInterviewAgent(client, workDir, includeSymbols);

    setIterationVerbosePhase("interview");
    ralphLog("interview", "Starting PRD authoring assistant...");

    var prompt = buildPrdAuthoringPrompt(briefText, prdRelativePath, prdMode, brownfieldContext);
    var response = agent.think(prompt);
    var responseText = responseTextOrEmpty(response);
    printAgentFinalResponse(responseText);

    if (!responseHasPrdReady(responseText) && io.hasFile(prdPath)) {
        ralphLog("interview", "PRD_READY not signaled — validating written file anyway");
    }

    var check = validateInterviewPrdStrict(prdPath);
    if (!check.ok) {
        var repairResponse = runInterviewPrdRepair(agent, prdRelativePath, check);
        if (repairResponse != null) {
            printAgentFinalResponse(responseTextOrEmpty(repairResponse));
        }
        check = validateInterviewPrdStrict(prdPath);
    }

    if (!check.ok) {
        ralphLog("interview", "PRD validation failed: " + check.reason);
        var ei = 0;
        while (check.errors != null && ei < str.length(check.errors)) {
            io.print("  - " + check.errors[ei]);
            ei = ei + 1;
        }
        io.print(interviewText("Fix the PRD manually or rerun the interview.", "Correggi il PRD manualmente o rilancia l'interview."));
        return -1;
    }

    var wi = 0;
    while (check.warnings != null && wi < str.length(check.warnings)) {
        ralphLog("interview", "[warn] " + check.warnings[wi]);
        wi = wi + 1;
    }

    var progress = check.progress;
    ralphLog("interview", "PRD written: " + prdPath + " (" + string(progress.open) + " open items, " + string(progress.total) + " total)");

    printInterviewPrdPreview(prdPath, envInt("MALDA_RALPH_INTERVIEW_PREVIEW_LINES", 30));
    writeInterviewSummary(workDir, brief, progress, prdPath, profile, prdMode);
    persistInterviewMemoryAfterSuccess(workDir, brief, progress, prdRelativePath);
    runInterviewPreflightCheck(workDir, prdRelativePath);

    io.print("");
    io.print(interviewText("Next step — run the Ralph development loop on this folder:", "Prossimo passo — avvia il loop Ralph su questa cartella:"));
    io.print("  set MALDA_RALPH_WORKDIR=" + workDir);
    io.print("  run_ralph.bat");
    io.print("  (or ralph.exe from the distribution bin folder)");

    tryInterviewThenLoop(workDir);
    return 0;
}
