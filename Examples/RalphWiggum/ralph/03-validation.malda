function countOccurrences(text, needle) {
    var count = 0;
    var remaining = text;
    while (true) {
        var idx = str.indexOf(remaining, needle);
        if (idx < 0) {
            break;
        }
        count = count + 1;
        var skip = idx + str.length(needle);
        if (skip >= str.length(remaining)) {
            remaining = "";
        } else {
            remaining = str.substring(remaining, skip, str.length(remaining) - skip);
        }
    }
    return count;
}

function braceBalanceOk(text) {
    var depth = 0;
    var i = 0;
    while (i < str.length(text)) {
        var ch = str.substring(text, i, 1);
        if (ch == "{") {
            depth = depth + 1;
        }
        if (ch == "}") {
            depth = depth - 1;
        }
        if (depth < 0) {
            return false;
        }
        i = i + 1;
    }
    return depth == 0;
}

function addValidationError(errors, message) {
    errors.append(message);
}

function isRalphMemoryArtifact(filePath) {
    if (filePath == null || filePath == "") {
        return false;
    }
    var lowerPath = str.lower(filePath);
    if (str.endsWith(lowerPath, ".graph.json") || str.endsWith(lowerPath, ".metadata.json")) {
        return true;
    }
    if (str.endsWith(lowerPath, ".vectordb.bin")) {
        return true;
    }
    if (str.endsWith(lowerPath, ".ralph-state.json") || str.endsWith(lowerPath, ".ralph-validate.js")) {
        return true;
    }
    if (str.indexOf(lowerPath, ".ralph-memory.") >= 0) {
        return true;
    }
    return false;
}

function shouldSkipValidationFile(fileName) {
    if (fileName == null || fileName == "") {
        return true;
    }
    if (str.indexOf(fileName, ".") == 0) {
        return true;
    }
    if (str.lower(fileName) == "prd.md") {
        return true;
    }
    if (isRalphMemoryArtifact(fileName)) {
        return true;
    }
    return false;
}

function ralphMemoryPersisted(workDir) {
    var memoryPath = io.pathJoin(workDir, ".ralph-memory");
    if (io.hasFile(memoryPath + ".graph.json")) {
        return true;
    }
    if (io.hasFile(io.pathJoin(workDir, ".graph.json"))) {
        return true;
    }
    return false;
}

function isMergeConflictMarkerLine(line) {
    if (line == null || line == "") {
        return false;
    }
    var trimmed = str.trim(line);
    if (trimmed == "=======") {
        return true;
    }
    if (str.startsWith(trimmed, "<<<<<<<")) {
        return true;
    }
    if (str.startsWith(trimmed, ">>>>>>>")) {
        return true;
    }
    return false;
}

function hasMergeConflictMarkers(content) {
    var lines = str.split(content, "\n");
    var i = 0;
    while (i < str.length(lines)) {
        if (isMergeConflictMarkerLine(lines[i])) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

function validateGenericContent(content, filePath) {
    var errors = [];
    if (content == null || content == "") {
        addValidationError(errors, filePath + ": file is empty");
        return errors;
    }
    if (hasMergeConflictMarkers(content)) {
        addValidationError(errors, filePath + ": merge conflict markers detected");
    }
    if (countOccurrences(str.lower(content), "<!doctype html") > 1) {
        addValidationError(errors, filePath + ": multiple <!DOCTYPE html> roots (likely concatenated files)");
    }
    return errors;
}

function ralphAutoFormatJsEnabled() {
    return envBool("MALDA_RALPH_AUTO_FORMAT_JS", false);
}

function countLinesBeforeOffset(content, offset) {
    var line = 1;
    var i = 0;
    while (i < offset && i < str.length(content)) {
        if (str.substring(content, i, 1) == "\n") {
            line = line + 1;
        }
        i = i + 1;
    }
    return line;
}

function htmlLineForScriptLine(startLine, scriptLine) {
    if (scriptLine == null || scriptLine <= 0) {
        return startLine;
    }
    return startLine + scriptLine - 1;
}

function formatFileLineContext(content, centerLine, radius) {
    if (content == null || content == "" || centerLine == null || centerLine <= 0) {
        return "";
    }
    var lines = str.split(content, "\n");
    var start = centerLine - radius - 1;
    if (start < 0) {
        start = 0;
    }
    var end = centerLine + radius - 1;
    if (end >= str.length(lines)) {
        end = str.length(lines) - 1;
    }
    var text = "";
    var i = start;
    while (i <= end) {
        var lineNo = i + 1;
        var marker = "   ";
        if (lineNo == centerLine) {
            marker = ">> ";
        }
        if (text != "") {
            text = text + "\n";
        }
        text = text + marker + string(lineNo) + ": " + lines[i];
        i = i + 1;
    }
    return text;
}

function parseNodeErrorLineNumber(detail, tmpFileName) {
    if (detail == null || detail == "" || tmpFileName == null || tmpFileName == "") {
        return -1;
    }
    var idx = str.indexOf(detail, tmpFileName);
    if (idx < 0) {
        idx = str.indexOf(str.lower(detail), str.lower(tmpFileName));
    }
    if (idx < 0) {
        return -1;
    }
    var after = str.substring(detail, idx + str.length(tmpFileName), str.length(detail) - idx - str.length(tmpFileName));
    if (str.length(after) == 0 || str.substring(after, 0, 1) != ":") {
        return -1;
    }
    after = str.substring(after, 1, str.length(after) - 1);
    var digits = "";
    var i = 0;
    while (i < str.length(after)) {
        var ch = str.substring(after, i, 1);
        if (ch >= "0" && ch <= "9") {
            digits = digits + ch;
        } else {
            break;
        }
        i = i + 1;
    }
    if (digits == "") {
        return -1;
    }
    var lineNo = toIntOrNull(digits);
    if (lineNo == null || lineNo <= 0) {
        return -1;
    }
    return lineNo;
}

function formatNodeJsValidationError(filePath, fileContent, tmpFileName, detail, mappedLine) {
    var msg = filePath;
    if (mappedLine != null && mappedLine > 0) {
        msg = msg + " line " + string(mappedLine);
    }
    msg = msg + ": " + str.trim(detail);
    if (mappedLine != null && mappedLine > 0 && fileContent != null && fileContent != "") {
        var ctx = formatFileLineContext(fileContent, mappedLine, 3);
        if (ctx != null && ctx != "") {
            msg = msg + "\n" + ctx;
        }
    }
    return msg;
}

function tryPrettierFormatContent(content, workDir, tmpBase) {
    var inPath = io.pathJoin(workDir, tmpBase + ".prettier.js");
    try {
        io.writeFile(inPath, content);
        var cmd = runCommand("npx", ["--yes", "prettier", "--write", "--parser", "babel", inPath]);
        if (cmd == null || cmd.exitCode == null || cmd.exitCode != 0) {
            return null;
        }
        return io.readFile(inPath);
    } catch (error) {
        return null;
    }
}

function spliceContentAt(content, start, len, replacement) {
    return str.substring(content, 0, start) + replacement + str.substring(content, start + len, str.length(content) - start - len);
}

function extractHtmlScriptBlocksWithMeta(content) {
    var blocks = [];
    var searchFrom = 0;
    while (searchFrom < str.length(content)) {
        var slice = str.substring(content, searchFrom, str.length(content) - searchFrom);
        var lowerSlice = str.lower(slice);
        var relOpen = str.indexOf(lowerSlice, "<script");
        if (relOpen < 0) {
            break;
        }
        var absOpen = searchFrom + relOpen;
        var afterOpen = str.substring(content, absOpen, str.length(content) - absOpen);
        var lowerAfter = str.lower(afterOpen);
        var relOpenEnd = str.indexOf(lowerAfter, ">");
        if (relOpenEnd < 0) {
            break;
        }
        var relClose = str.indexOf(lowerAfter, "</script>");
        if (relClose < 0) {
            break;
        }
        var bodyStart = relOpenEnd + 1;
        var bodyLen = relClose - bodyStart;
        if (bodyLen > 0) {
            var bodyText = str.substring(afterOpen, bodyStart, bodyLen);
            var bodyStartOffset = absOpen + bodyStart;
            blocks.append({
                "body": bodyText,
                "bodyStartOffset": bodyStartOffset,
                "bodyLength": bodyLen,
                "startLine": countLinesBeforeOffset(content, bodyStartOffset)
            });
        }
        var nextStart = relClose + str.length("</script>");
        searchFrom = absOpen + nextStart;
    }
    return blocks;
}

function extractHtmlScriptBlocks(content) {
    var blocks = [];
    var meta = extractHtmlScriptBlocksWithMeta(content);
    var i = 0;
    while (i < str.length(meta)) {
        blocks.append(meta[i].body);
        i = i + 1;
    }
    return blocks;
}

function tryNodeJsCheck(content, workDir, tmpName) {
    var tmpPath = io.pathJoin(workDir, tmpName);
    try {
        io.writeFile(tmpPath, content);
        var cmd = runCommand("node", ["--check", tmpPath]);
        if (cmd != null && cmd.exitCode != null && cmd.exitCode != 0) {
            var detail = cmd.stderr;
            if (detail == null || detail == "") {
                detail = cmd.stdout;
            }
            if (detail == null) {
                detail = "node --check failed";
            }
            return {"available": true, "ok": false, "detail": detail};
        }
        return {"available": true, "ok": true, "detail": ""};
    } catch (error) {
        return {"available": false, "ok": true, "detail": ""};
    }
}

function validateHtmlFile(content, filePath, workDir) {
    var errors = validateGenericContent(content, filePath);
    var lowerContent = str.lower(content);

    if (countOccurrences(lowerContent, "<html") != countOccurrences(lowerContent, "</html>")) {
        addValidationError(errors, filePath + ": unbalanced <html> tags");
    }
    if (countOccurrences(lowerContent, "<head") != countOccurrences(lowerContent, "</head>")) {
        addValidationError(errors, filePath + ": unbalanced <head> tags");
    }
    if (countOccurrences(lowerContent, "<body") != countOccurrences(lowerContent, "</body>")) {
        addValidationError(errors, filePath + ": unbalanced <body> tags");
    }
    if (countOccurrences(lowerContent, "<script") != countOccurrences(lowerContent, "</script>")) {
        addValidationError(errors, filePath + ": unbalanced <script> tags");
    }
    if (countOccurrences(lowerContent, "<style") != countOccurrences(lowerContent, "</style>")) {
        addValidationError(errors, filePath + ": unbalanced <style> tags");
    }
    if (str.indexOf(lowerContent, "<script") >= 0 && str.indexOf(lowerContent, "</style>") >= 0) {
        var scriptPos = str.indexOf(lowerContent, "<script");
        var styleClose = str.indexOf(lowerContent, "</style>");
        var styleOpen = str.indexOf(lowerContent, "<style");
        if (styleOpen >= 0 && scriptPos > styleOpen && scriptPos < styleClose) {
            addValidationError(errors, filePath + ": <script> appears inside <style> block");
        }
    }

    var scripts = extractHtmlScriptBlocksWithMeta(content);
    var si = 0;
    while (si < str.length(scripts)) {
        var scriptMeta = scripts[si];
        var scriptBody = scriptMeta.body;
        var tmpName = ".ralph-validate-script-" + string(si + 1) + ".js";
        var nodeCheck = tryNodeJsCheck(scriptBody, workDir, tmpName);
        if (!nodeCheck.ok && ralphAutoFormatJsEnabled()) {
            var formatted = tryPrettierFormatContent(scriptBody, workDir, tmpName + "-fmt");
            if (formatted != null) {
                var recheck = tryNodeJsCheck(formatted, workDir, tmpName + "-fmt-check");
                if (recheck.ok) {
                    content = spliceContentAt(content, scriptMeta.bodyStartOffset, scriptMeta.bodyLength, formatted);
                    io.writeFile(filePath, content);
                    return validateHtmlFile(io.readFile(filePath), filePath, workDir);
                }
            }
        }
        if (nodeCheck.available) {
            if (!nodeCheck.ok) {
                var scriptLine = parseNodeErrorLineNumber(nodeCheck.detail, tmpName);
                var htmlLine = htmlLineForScriptLine(scriptMeta.startLine, scriptLine);
                var label = filePath + " (inline script " + string(si + 1) + ")";
                addValidationError(errors, formatNodeJsValidationError(label, content, tmpName, nodeCheck.detail, htmlLine));
            }
        } else if (!braceBalanceOk(scriptBody)) {
            addValidationError(errors, filePath + ": inline script block " + string(si + 1) + " has unbalanced braces");
        }
        si = si + 1;
    }

    return errors;
}

function validateMaldaFile(filePath) {
    var errors = [];
    var result = checkMalda(filePath);
    if (result == null) {
        return errors;
    }
    if (result.error != null && string(result.error) != "") {
        addValidationError(errors, filePath + ": " + string(result.error));
        return errors;
    }
    var diags = result.diagnostics;
    if (diags == null) {
        return errors;
    }
    var i = 0;
    while (i < str.length(diags)) {
        var entry = diags[i];
        var severity = "";
        if (entry.severity != null) {
            severity = str.lower(string(entry.severity));
        }
        if (severity != "error") {
            i = i + 1;
            continue;
        }
        var msg = entry.message;
        if (msg == null || string(msg) == "") {
            msg = "check error";
        }
        var loc = "";
        if (entry.line != null) {
            loc = ":" + string(entry.line);
            if (entry.column != null) {
                loc = loc + ":" + string(entry.column);
            }
        }
        var code = "";
        if (entry.code != null && string(entry.code) != "") {
            code = "[" + string(entry.code) + "] ";
        }
        addValidationError(errors, filePath + loc + ": " + code + msg);
        i = i + 1;
    }
    return errors;
}

function validateJsonFile(content, filePath) {
    var errors = validateGenericContent(content, filePath);
    try {
        parseJSON(content);
    } catch (error) {
        addValidationError(errors, filePath + ": invalid JSON (" + string(error) + ")");
    }
    return errors;
}

function validateJsFile(content, filePath, workDir) {
    var errors = validateGenericContent(content, filePath);
    var tmpName = ".ralph-validate.js";
    var nodeCheck = tryNodeJsCheck(content, workDir, tmpName);
    if (!nodeCheck.ok && ralphAutoFormatJsEnabled()) {
        try {
            io.writeFile(filePath, content);
            var cmd = runCommand("npx", ["--yes", "prettier", "--write", "--parser", "babel", filePath]);
            if (cmd != null && cmd.exitCode != null && cmd.exitCode == 0) {
                content = io.readFile(filePath);
                nodeCheck = tryNodeJsCheck(content, workDir, tmpName + "-fmt");
            }
        } catch (error) {
        }
    }
    if (nodeCheck.available) {
        if (!nodeCheck.ok) {
            var lineNo = parseNodeErrorLineNumber(nodeCheck.detail, tmpName);
            addValidationError(errors, formatNodeJsValidationError(filePath, content, tmpName, nodeCheck.detail, lineNo));
        }
    } else if (!braceBalanceOk(content)) {
        addValidationError(errors, filePath + ": unbalanced braces");
    }
    return errors;
}

function validateWorkdirFile(workDir, filePath) {
    var errors = [];
    if (!io.hasFile(filePath)) {
        addValidationError(errors, filePath + ": file not found");
        return {"ok": false, "errors": errors};
    }

    var content = io.readFile(filePath);
    var fileName = io.getFileName(filePath);
    var lowerName = str.lower(fileName);
    var fileErrors = validateGenericContent(content, filePath);

    if (str.endsWith(lowerName, ".html") || str.endsWith(lowerName, ".htm")) {
        fileErrors = validateHtmlFile(content, filePath, workDir);
    } else if (str.endsWith(lowerName, ".malda")) {
        fileErrors = validateMaldaFile(filePath);
    } else if (str.endsWith(lowerName, ".json")) {
        fileErrors = validateJsonFile(content, filePath);
    } else if (str.endsWith(lowerName, ".js")) {
        fileErrors = validateJsFile(content, filePath, workDir);
    } else if (str.endsWith(lowerName, ".css")) {
        if (str.indexOf(content, "<script") >= 0 || str.indexOf(content, "<html") >= 0) {
            addValidationError(fileErrors, filePath + ": CSS file contains HTML markup (possible misplaced edit)");
        }
    }

    var ei = 0;
    while (ei < str.length(fileErrors)) {
        errors.append(fileErrors[ei]);
        ei = ei + 1;
    }

    return {"ok": str.length(errors) == 0, "errors": errors};
}

function isValidationExcludedDir(dirName) {
    if (dirName == null || dirName == "") {
        return true;
    }
    var lowerName = str.lower(dirName);
    if (lowerName == ".git" or lowerName == "node_modules" or lowerName == "bin" or lowerName == "obj") {
        return true;
    }
    var extra = io.getEnv("MALDA_RALPH_VALIDATE_EXCLUDE");
    if (extra != null && extra != "") {
        var parts = str.split(extra, ",");
        var i = 0;
        while (i < str.length(parts)) {
            if (str.lower(str.trim(parts[i])) == lowerName) {
                return true;
            }
            i = i + 1;
        }
    }
    return false;
}

function collectWorkdirFilesFlat(workDir, allFiles) {
    var entries = io.listDirectory(workDir);
    var i = 0;
    while (i < str.length(entries)) {
        var entry = entries[i];
        if (entry.type == "file" && !shouldSkipValidationFile(entry.name)) {
            var filePath = entry.path;
            if (filePath == null || filePath == "") {
                filePath = io.pathJoin(workDir, entry.name);
            }
            allFiles.append(filePath);
        }
        i = i + 1;
    }
}

function collectWorkdirFilesRecursive(workDir, allFiles) {
    var entries = io.listDirectory(workDir);
    var i = 0;
    while (i < str.length(entries)) {
        var entry = entries[i];
        if (entry.type == "directory") {
            if (!isValidationExcludedDir(entry.name)) {
                var subDir = entry.path;
                if (subDir == null || subDir == "") {
                    subDir = io.pathJoin(workDir, entry.name);
                }
                collectWorkdirFilesRecursive(subDir, allFiles);
            }
        } else if (entry.type == "file" && !shouldSkipValidationFile(entry.name)) {
            var filePath = entry.path;
            if (filePath == null || filePath == "") {
                filePath = io.pathJoin(workDir, entry.name);
            }
            allFiles.append(filePath);
        }
        i = i + 1;
    }
}

function shouldSkipValidationPath(filePath) {
    if (filePath == null || filePath == "") {
        return true;
    }
    return shouldSkipValidationFile(io.getFileName(filePath));
}

function resolveValidationAbsolutePath(workDir, filePath) {
    if (filePath == null || filePath == "") {
        return "";
    }
    if (str.indexOf(filePath, ":") >= 0) {
        return io.pathNormalize(filePath);
    }
    if (str.indexOf(filePath, "\\") >= 0 || str.indexOf(filePath, "/") >= 0) {
        var workNorm = str.lower(io.pathNormalize(workDir));
        var fileNorm = str.lower(io.pathNormalize(filePath));
        if (str.startsWith(fileNorm, workNorm)) {
            return io.pathNormalize(filePath);
        }
        return io.pathNormalize(io.pathJoin(workDir, filePath));
    }
    return io.pathNormalize(io.pathJoin(workDir, filePath));
}

function validationPathAlreadyListed(files, absPath) {
    if (absPath == null || absPath == "" || files == null) {
        return true;
    }
    var target = str.lower(absPath);
    var i = 0;
    while (i < str.length(files)) {
        if (str.lower(files[i]) == target) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

function appendValidationPath(files, workDir, filePath) {
    var absPath = resolveValidationAbsolutePath(workDir, filePath);
    if (absPath == "" || shouldSkipValidationPath(absPath)) {
        return;
    }
    if (!validationPathAlreadyListed(files, absPath)) {
        files.append(absPath);
    }
}

function effectiveValidationScope(phase) {
    if (phase != null && phase == "validation-fix") {
        return "changed";
    }
    return ralphValidateScope();
}

function ralphValidateAlwaysRelPaths() {
    var raw = envStr("MALDA_RALPH_VALIDATE_ALWAYS", "");
    var paths = [];
    if (raw == null || str.trim(raw) == "") {
        return paths;
    }
    var parts = str.split(raw, ",");
    var i = 0;
    while (i < str.length(parts)) {
        appendUniqueRelPath(paths, parts[i]);
        i = i + 1;
    }
    return paths;
}

function mergeValidationRelPaths(changedRelPaths, prdRelPaths, prdRelativePath) {
    var merged = [];
    if (changedRelPaths != null) {
        var ci = 0;
        while (ci < str.length(changedRelPaths)) {
            appendUniqueRelPath(merged, changedRelPaths[ci]);
            ci = ci + 1;
        }
    }
    if (prdRelPaths != null) {
        var pi = 0;
        while (pi < str.length(prdRelPaths)) {
            appendUniqueRelPath(merged, prdRelPaths[pi]);
            pi = pi + 1;
        }
    }
    if (prdRelativePath != null && prdRelativePath != "") {
        appendUniqueRelPath(merged, prdRelativePath);
    }
    var alwaysPaths = ralphValidateAlwaysRelPaths();
    var ai = 0;
    while (ai < str.length(alwaysPaths)) {
        appendUniqueRelPath(merged, alwaysPaths[ai]);
        ai = ai + 1;
    }
    return merged;
}

function collectAllValidationFiles(workDir) {
    var allFiles = [];
    if (ralphValidateDepth() == "recursive") {
        collectWorkdirFilesRecursive(workDir, allFiles);
    } else {
        collectWorkdirFilesFlat(workDir, allFiles);
    }
    return allFiles;
}

function resolveFilesForValidation(workDir, changedRelPaths, phase) {
    var scope = effectiveValidationScope(phase);
    var files = [];
    if (scope == "all") {
        return collectAllValidationFiles(workDir);
    }
    if (changedRelPaths != null) {
        var i = 0;
        while (i < str.length(changedRelPaths)) {
            appendValidationPath(files, workDir, changedRelPaths[i]);
            i = i + 1;
        }
    }
    if (str.length(files) == 0) {
        if (ralphValidateFallback() == "all") {
            return collectAllValidationFiles(workDir);
        }
    }
    return files;
}

function shouldRunValidationHook(hasChanges) {
    var mode = ralphValidateHook();
    if (mode == "never") {
        return false;
    }
    if (mode == "on_change") {
        return hasChanges;
    }
    return true;
}

function validateFiles(workDir, filePaths) {
    var allErrors = [];
    var i = 0;
    while (i < str.length(filePaths)) {
        var result = validateWorkdirFile(workDir, filePaths[i]);
        if (!result.ok) {
            var j = 0;
            while (j < str.length(result.errors)) {
                allErrors.append(result.errors[j]);
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return {"ok": str.length(allErrors) == 0, "errors": allErrors, "fileCount": str.length(filePaths)};
}

function formatRalphEnvFileList(relPaths) {
    if (relPaths == null || str.length(relPaths) == 0) {
        return "";
    }
    var text = relPaths[0];
    var i = 1;
    while (i < str.length(relPaths)) {
        text = text + "," + relPaths[i];
        i = i + 1;
    }
    return text;
}

function buildRalphValidationHookEnv(workDir, validationRelPaths, gitChangedRelPaths) {
    return {
        "RALPH_WORKDIR": io.pathNormalize(workDir),
        "RALPH_CHANGED_FILES": formatRalphEnvFileList(gitChangedRelPaths),
        "RALPH_VALIDATION_FILES": formatRalphEnvFileList(validationRelPaths)
    };
}

function runCustomValidationHook(workDir, runHook, validationRelPaths, gitChangedRelPaths) {
    var errors = [];
    if (!runHook) {
        return errors;
    }
    var hookEnv = buildRalphValidationHookEnv(workDir, validationRelPaths, gitChangedRelPaths);
    var cmd = io.getEnv("MALDA_RALPH_VALIDATE_CMD");
    if (cmd != null && cmd != "") {
        try {
            var result = runCommand("cmd", ["/c", cmd], workDir, hookEnv);
            if (result != null && result.exitCode != null && result.exitCode != 0) {
                addValidationError(errors, "custom validate cmd failed: " + string(result.stderr));
            }
        } catch (error) {
            addValidationError(errors, "custom validate cmd: " + string(error));
        }
    }
    var hookBat = io.pathJoin(workDir, ".ralph-validate.bat");
    var hookSh = io.pathJoin(workDir, ".ralph-validate.sh");
    if (io.hasFile(hookBat)) {
        try {
            var bat = runCommand(hookBat, [], workDir, hookEnv);
            if (bat != null && bat.exitCode != null && bat.exitCode != 0) {
                addValidationError(errors, ".ralph-validate.bat failed");
            }
        } catch (error) {
            addValidationError(errors, ".ralph-validate.bat: " + string(error));
        }
    }
    if (io.hasFile(hookSh)) {
        try {
            var sh = runCommand("sh", [hookSh], workDir, hookEnv);
            if (sh != null && sh.exitCode != null && sh.exitCode != 0) {
                addValidationError(errors, ".ralph-validate.sh failed");
            }
        } catch (error) {
            // sh may be unavailable on Windows
        }
    }
    return errors;
}

function validateWorkdirWithContext(workDir, prdRelativePath, validationRelPaths, phase, gitChangedRelPaths) {
    var scope = effectiveValidationScope(phase);
    var filesToValidate = resolveFilesForValidation(workDir, validationRelPaths, phase);
    var fileResult = validateFiles(workDir, filesToValidate);
    var allErrors = [];
    if (fileResult.errors != null) {
        var ei = 0;
        while (ei < str.length(fileResult.errors)) {
            allErrors.append(fileResult.errors[ei]);
            ei = ei + 1;
        }
    }
    var hasGitChanges = gitChangedRelPaths != null && str.length(gitChangedRelPaths) > 0;
    var customErrors = runCustomValidationHook(workDir, shouldRunValidationHook(hasGitChanges), validationRelPaths, gitChangedRelPaths);
    var k = 0;
    while (k < str.length(customErrors)) {
        allErrors.append(customErrors[k]);
        k = k + 1;
    }
    var errorCount = str.length(allErrors);
    return {
        "ok": errorCount == 0,
        "errors": allErrors,
        "scope": scope,
        "fileCount": fileResult.fileCount,
        "hookRan": shouldRunValidationHook(hasGitChanges)
    };
}

function validateWorkdir(workDir, prdRelativePath) {
    return validateWorkdirWithContext(workDir, prdRelativePath, [], "", []);
}

function formatValidationStatusLine(validation) {
    if (validation == null) {
        return "Validation: unknown";
    }
    var scope = validation.scope;
    if (scope == null || scope == "") {
        scope = "all";
    }
    var count = validation.fileCount;
    if (count == null) {
        count = 0;
    }
    var hookNote = "";
    if (validation.hookRan != null && validation.hookRan) {
        hookNote = ", hook=ran";
    } else if (ralphValidateHook() != "never") {
        hookNote = ", hook=skipped";
    }
    if (validation.ok) {
        return "Validation: OK (" + string(count) + " files, scope=" + scope + hookNote + ")";
    }
    return "Validation FAILED (" + string(count) + " files, scope=" + scope + hookNote + ")";
}

function formatValidationErrors(errors) {
    if (errors == null || str.length(errors) == 0) {
        return "";
    }
    var text = "";
    var i = 0;
    while (i < str.length(errors)) {
        if (text != "") {
            text = text + "\n";
        }
        text = text + "- " + errors[i];
        i = i + 1;
    }
    return text;
}
