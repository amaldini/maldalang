function isPrdSkippedStatus(lineLower) {
    return indexOf(lineLower, "- [skip]") >= 0 || indexOf(lineLower, "- [wont]") >= 0;
}

function countPrdChecklistProgress(prdPath) {
    var done = 0;
    var open = 0;
    if (!hasFile(prdPath)) {
        return {"done": 0, "open": 0, "total": 0, "percent": 0};
    }
    var lines = split(readFile(prdPath), "\n");
    var i = 0;
    while (i < length(lines)) {
        var lineLower = lower(lines[i]);
        if (isPrdSkippedStatus(lineLower)) {
            i = i + 1;
            continue;
        }
        if (indexOf(lineLower, "- [done]") >= 0) {
            done = done + 1;
        } else if (indexOf(lineLower, "- [todo]") >= 0 || indexOf(lineLower, "- [ ]") >= 0) {
            open = open + 1;
        }
        i = i + 1;
    }
    var total = done + open;
    var percent = 0;
    if (total > 0) {
        percent = round((done * 100) / total);
    }
    return {"done": done, "open": open, "total": total, "percent": percent};
}

function parsePrdPriority(lineLower) {
    if (indexOf(lineLower, "[p0]") >= 0) {
        return 0;
    }
    if (indexOf(lineLower, "[p1]") >= 0) {
        return 1;
    }
    if (indexOf(lineLower, "[p2]") >= 0) {
        return 2;
    }
    return 9;
}

function parsePrdDepends(line) {
    var deps = [];
    var lineLower = lower(line);
    var idx = indexOf(lineLower, "depends:");
    if (idx < 0) {
        return deps;
    }
    var rest = trim(substring(line, idx + length("depends:"), length(line) - idx - length("depends:")));
    rest = replace(rest, ")", "");
    rest = replace(rest, "(", "");
    var parts = split(rest, ",");
    var i = 0;
    while (i < length(parts)) {
        var dep = trim(parts[i]);
        if (dep != "" && dep != "none") {
            deps.append(upper(dep));
        }
        i = i + 1;
    }
    return deps;
}

function prdItemDone(prdPath, itemId) {
    if (itemId == null || itemId == "" || !hasFile(prdPath)) {
        return true;
    }
    var lines = split(readFile(prdPath), "\n");
    var i = 0;
    while (i < length(lines)) {
        var lineLower = lower(lines[i]);
        if (indexOf(lineLower, "- [done]") >= 0 && indexOf(upper(lines[i]), upper(itemId)) >= 0) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

function prdDependsSatisfied(prdPath, deps) {
    if (deps == null || length(deps) == 0) {
        return true;
    }
    var i = 0;
    while (i < length(deps)) {
        if (!prdItemDone(prdPath, deps[i])) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

function isPrdChecklistItemLine(line) {
    if (line == null || line == "") {
        return false;
    }
    return indexOf(line, "- [") >= 0;
}

function getCurrentPrdItemIndex(prdPath) {
    if (!hasFile(prdPath)) {
        return -1;
    }
    var lines = split(readFile(prdPath), "\n");
    var bestIdx = -1;
    var bestPri = 99;
    var i = 0;
    while (i < length(lines)) {
        var line = lines[i];
        var lineLower = lower(line);
        if (isPrdSkippedStatus(lineLower)) {
            i = i + 1;
            continue;
        }
        if (indexOf(lineLower, "- [todo]") >= 0 || indexOf(lineLower, "- [ ]") >= 0) {
            var pri = parsePrdPriority(lineLower);
            var deps = parsePrdDepends(line);
            if (prdDependsSatisfied(prdPath, deps) && pri <= bestPri) {
                bestPri = pri;
                bestIdx = i;
            }
        }
        i = i + 1;
    }
    return bestIdx;
}

function extractPrdHintSuffix(line) {
    var lineLower = lower(line);
    var filesIdx = indexOf(lineLower, "files:");
    var verifyIdx = indexOf(lineLower, "verify:");
    var idx = -1;
    var keyLen = 0;
    if (filesIdx >= 0 && (verifyIdx < 0 || filesIdx <= verifyIdx)) {
        idx = filesIdx;
        keyLen = length("files:");
    } else if (verifyIdx >= 0) {
        idx = verifyIdx;
        keyLen = length("verify:");
    }
    if (idx < 0) {
        return "";
    }
    return trim(substring(line, idx + keyLen, length(line) - idx - keyLen));
}

function appendUniqueRelPath(paths, relPath) {
    var normalized = trim(relPath);
    if (normalized == "" || paths == null) {
        return;
    }
    var target = lower(normalized);
    var i = 0;
    while (i < length(paths)) {
        if (lower(paths[i]) == target) {
            return;
        }
        i = i + 1;
    }
    paths.append(normalized);
}

function appendPrdFileHintList(paths, rawList) {
    if (rawList == null || trim(rawList) == "") {
        return;
    }
    var parts = split(rawList, ",");
    var i = 0;
    while (i < length(parts)) {
        appendUniqueRelPath(paths, parts[i]);
        i = i + 1;
    }
}

function collectPrdFileHintsForLine(prdPath, startIndex) {
    var paths = [];
    var lines = split(readFile(prdPath), "\n");
    var j = startIndex + 1;
    while (j < length(lines)) {
        var ln = lines[j];
        if (isPrdChecklistItemLine(ln)) {
            break;
        }
        var lnLower = lower(ln);
        if (indexOf(lnLower, "files:") >= 0 || indexOf(lnLower, "verify:") >= 0) {
            appendPrdFileHintList(paths, extractPrdHintSuffix(ln));
        }
        j = j + 1;
    }
    return paths;
}

function getCurrentPrdFileHints(prdPath, validationNote) {
    if (!hasFile(prdPath)) {
        return [];
    }
    var itemIdx = getCurrentPrdItemIndex(prdPath);
    if (itemIdx < 0) {
        return [];
    }
    return collectPrdFileHintsForLine(prdPath, itemIdx);
}

function collectAcceptanceForLine(prdPath, startIndex) {
    var lines = split(readFile(prdPath), "\n");
    var text = "";
    var j = startIndex + 1;
    while (j < length(lines)) {
        var ln = lines[j];
        if (isPrdChecklistItemLine(ln) && indexOf(ln, "Acceptance") < 0) {
            break;
        }
        if (indexOf(lower(ln), "acceptance:") >= 0 || indexOf(lower(ln), "- acceptance:") >= 0) {
            if (text != "") {
                text = text + "\n";
            }
            text = text + trim(ln);
        }
        j = j + 1;
    }
    return text;
}

function isPrdComplete(prdPath) {
    if (!hasFile(prdPath)) {
        return false;
    }
    var lines = split(readFile(prdPath), "\n");
    var i = 0;
    while (i < length(lines)) {
        var line = lower(lines[i]);
        if (isPrdSkippedStatus(line)) {
            i = i + 1;
            continue;
        }
        if (indexOf(line, "- [todo]") >= 0 || indexOf(line, "- [ ]") >= 0) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

function extractPhaseTitle(line) {
    var a = indexOf(line, "**");
    if (a >= 0) {
        var rest = substring(line, a + 2, length(line) - a - 2);
        var b = indexOf(rest, "**");
        if (b >= 0) {
            return trim(substring(rest, 0, b));
        }
    }
    var lineLower = lower(line);
    var todoIdx = indexOf(lineLower, "- [todo]");
    if (todoIdx >= 0) {
        return trim(substring(line, todoIdx + length("- [TODO]"), length(line) - todoIdx - length("- [TODO]")));
    }
    var openIdx = indexOf(lineLower, "- [ ]");
    if (openIdx >= 0) {
        return trim(substring(line, openIdx + length("- [ ]"), length(line) - openIdx - length("- [ ]")));
    }
    return "unknown";
}

function getCurrentPrdPhase(prdPath, validationNote) {
    if (!hasFile(prdPath)) {
        return "PRD missing";
    }
    var lines = split(readFile(prdPath), "\n");
    var bestIdx = getCurrentPrdItemIndex(prdPath);
    if (bestIdx >= 0) {
        return extractPhaseTitle(lines[bestIdx]);
    }
    if (validationNote != null && validationNote != "") {
        return "validation-fix";
    }
    return "complete";
}

function getCurrentPrdAcceptance(prdPath, validationNote) {
    if (!hasFile(prdPath)) {
        return "";
    }
    var bestIdx = getCurrentPrdItemIndex(prdPath);
    if (bestIdx >= 0) {
        return collectAcceptanceForLine(prdPath, bestIdx);
    }
    return "";
}

function formatPrdFileHintsBlock(fileHints) {
    if (fileHints == null || length(fileHints) == 0) {
        return "";
    }
    var text = "Focus files for this PRD item (from Files:/Verify: lines):\n";
    var i = 0;
    while (i < length(fileHints)) {
        text = text + "- " + fileHints[i] + "\n";
        i = i + 1;
    }
    return text;
}

function isCompleteSignal(responseText) {
    if (responseText == null || responseText == "") {
        return false;
    }
    var responseLower = lower(responseText);
    if (indexOf(responseLower, "ralph_done") >= 0) {
        return true;
    }
    if (indexOf(responseLower, "\"ralph\":\"done\"") >= 0 || indexOf(responseLower, "\"ralph\": \"done\"") >= 0) {
        return true;
    }
    if (indexOf(responseLower, "task_complete") < 0) {
        return false;
    }
    var trimmed = responseLower;
    while (length(trimmed) > 0 && indexOf(" \t\r\n", substring(trimmed, length(trimmed) - 1, 1)) >= 0) {
        trimmed = substring(trimmed, 0, length(trimmed) - 1);
    }
    return endsWith(trimmed, "task_complete") || indexOf(trimmed, "task_complete.") >= 0;
}

function shouldMarkTaskComplete(responseText, prdPath, validationOk) {
    if (!validationOk || !isPrdComplete(prdPath)) {
        return false;
    }
    if (isCompleteSignal(responseText)) {
        return true;
    }
    if (!ralphRequireCompleteSignal()) {
        return true;
    }
    return false;
}

function extractGlobPaths(globResult, maxCount) {
    var paths = [];
    if (globResult == null) {
        return paths;
    }
    var items = globResult.items;
    if (items == null) {
        return paths;
    }
    var i = 0;
    while (i < length(items)) {
        if (maxCount != null && maxCount > 0 && length(paths) >= maxCount) {
            break;
        }
        var item = items[i];
        if (item != null && item.path != null && string(item.path) != "") {
            paths.append(string(item.path));
        }
        i = i + 1;
    }
    return paths;
}

function ralphGlobPaths(workDir, pattern, maxResults) {
    if (maxResults == null || maxResults <= 0) {
        maxResults = 200;
    }
    var result = glob(pattern, workDir, maxResults);
    return extractGlobPaths(result, maxResults);
}
