// while (status.status != "awaiting") {
//     sleep(100);
//     status = acpClient.getRunStatus("interactive-agent", runId);
// }
// 
// print("Agent is awaiting input");
// 
// // Resume with user input
// var resumeResponse = acpClient.resumeRun("interactive-agent", runId, "John Doe");
// print("Resume response: " + resumeResponse);

// Keep server running
print("Server running. Press Ctrl+C to stop.");
while (server.isRunning) {
    sleep(1000);
}
