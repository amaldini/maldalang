// Graph Algorithms Example
// Demonstrates BFS, DFS, and shortest path algorithms

io.print("=== Graph Algorithms ===\n");

// Create a directed graph
var g = graph directed {
    nodes: ["A", "B", "C", "D", "E", "F"],
    edges: [
        { from: "A", to: "B", weight: 4 },
        { from: "A", to: "C", weight: 2 },
        { from: "B", to: "D", weight: 5 },
        { from: "C", to: "D", weight: 1 },
        { from: "C", to: "E", weight: 3 },
        { from: "D", to: "F", weight: 2 },
        { from: "E", to: "F", weight: 4 }
    ]
};

io.print("Graph structure:");
io.print("Nodes: " + g.nodes());
io.print("Edges: " + g.edges());
io.print("");

// Breadth-first search (BFS) - visit all nodes
io.print("=== Breadth-First Search (BFS) ===");
var visited = g.bfs("A");
io.print("BFS traversal from 'A': " + visited);
io.print("");

// BFS with target - find path
var pathResult = g.bfs("A", "F");
io.print("BFS path from 'A' to 'F':");
io.print("  Path: " + pathResult.path);
io.print("  Found: " + pathResult.found);
io.print("");

// Depth-first search (DFS) - visit all nodes
io.print("=== Depth-First Search (DFS) ===");
var dfsVisited = g.dfs("A");
io.print("DFS traversal from 'A': " + dfsVisited);
io.print("");

// DFS with target - find path
var dfsPath = g.dfs("A", "F");
io.print("DFS path from 'A' to 'F':");
io.print("  Path: " + dfsPath.path);
io.print("  Found: " + dfsPath.found);
io.print("");

// Shortest path using Dijkstra's algorithm
io.print("=== Shortest Path (Dijkstra) ===");
var shortest = g.shortestPath("A", "F");
io.print("Shortest path from 'A' to 'F':");
io.print("  Path: " + shortest.path);
io.print("  Distance: " + shortest.distance);
io.print("  Found: " + shortest.found);
io.print("");

// Compare different paths
var path1 = g.shortestPath("A", "D");
var path2 = g.shortestPath("A", "E");
io.print("Shortest path A->D: " + path1.path + " (distance: " + path1.distance + ")");
io.print("Shortest path A->E: " + path2.path + " (distance: " + path2.distance + ")");
