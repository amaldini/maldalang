// Graph Serialization Example
// Demonstrates serializing and deserializing graphs to/from JSON

io.print("=== Graph Serialization ===\n");

// Create a graph with nodes, edges, and data
var g1 = graph directed {
    nodes: ["A", "B", "C", "D"],
    edges: [
        { from: "A", to: "B", weight: 4 },
        { from: "A", to: "C", weight: 2 },
        { from: "B", to: "D", weight: 5 },
        { from: "C", to: "D", weight: 1 }
    ]
};

// Add node data
g1.addNode("A", "start node");
g1.addNode("B", 100);
g1.addNode("C", "intermediate");
g1.addNode("D", "end node");

// Add edge with properties
g1.addEdge("A", "B", 4, dict { "label": "primary", "type": "connection" });

io.print("Original graph:");
io.print("Nodes: " + g1.nodeCount());
io.print("Edges: " + g1.edgeCount());
io.print("Node A data: " + g1.getNode("A"));
io.print("");

// Serialize to JSON string
io.print("=== Serialization ===");
var json = g1.serialize();
io.print("Serialized JSON (first 200 chars): " + json.substring(0, 200) + "...");
io.print("");

// Deserialize from JSON string
io.print("=== Deserialization ===");
var g2 = g1.deserialize(json);
io.print("Deserialized graph:");
io.print("Nodes: " + g2.nodeCount());
io.print("Edges: " + g2.edgeCount());
io.print("Is directed: " + g2.isDirected());
io.print("Has node A: " + g2.hasNode("A"));
io.print("Has edge A->B: " + g2.hasEdge("A", "B"));
io.print("Weight A->B: " + g2.getWeight("A", "B"));
io.print("Node A data: " + g2.getNode("A"));
io.print("Node B data: " + g2.getNode("B"));
io.print("");

// Verify graph structure is preserved
io.print("=== Verification ===");
io.print("Original nodes: " + g1.nodes());
io.print("Deserialized nodes: " + g2.nodes());
io.print("Graphs are equivalent: " + (g1.nodeCount() == g2.nodeCount() && g1.edgeCount() == g2.edgeCount()));
io.print("");

// Test with undirected graph
io.print("=== Undirected Graph Serialization ===");
var g3 = graph undirected {
    nodes: ["X", "Y", "Z"],
    edges: [
        { from: "X", to: "Y", weight: 10 },
        { from: "Y", to: "Z", weight: 5 }
    ]
};

var json3 = g3.serialize();
var g4 = g3.deserialize(json3);

io.print("Original undirected graph:");
io.print("Is directed: " + g3.isDirected());
io.print("Edge count: " + g3.edgeCount());
io.print("Has X->Y: " + g3.hasEdge("X", "Y"));
io.print("Has Y->X: " + g3.hasEdge("Y", "X"));
io.print("");

io.print("Deserialized undirected graph:");
io.print("Is directed: " + g4.isDirected());
io.print("Edge count: " + g4.edgeCount());
io.print("Has X->Y: " + g4.hasEdge("X", "Y"));
io.print("Has Y->X: " + g4.hasEdge("Y", "X"));
io.print("");

// Test empty graph
io.print("=== Empty Graph Serialization ===");
var g5 = graph directed {};
var json5 = g5.serialize();
var g6 = g5.deserialize(json5);
io.print("Empty graph nodes: " + g6.nodeCount());
io.print("Empty graph edges: " + g6.edgeCount());
io.print("Is directed: " + g6.isDirected());
