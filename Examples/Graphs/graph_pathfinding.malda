// Graph Pathfinding Example
// Demonstrates various pathfinding algorithms and use cases

io.print("=== Graph Pathfinding ===\n");

// Create a graph representing a map with cities and roads
var map = graph directed {
    nodes: ["Start", "CityA", "CityB", "CityC", "CityD", "End"],
    edges: [
        { from: "Start", to: "CityA", weight: 5 },
        { from: "Start", to: "CityB", weight: 2 },
        { from: "CityA", to: "CityC", weight: 4 },
        { from: "CityA", to: "CityD", weight: 2 },
        { from: "CityB", to: "CityA", weight: 8 },
        { from: "CityB", to: "CityD", weight: 7 },
        { from: "CityC", to: "End", weight: 3 },
        { from: "CityD", to: "CityC", weight: 1 },
        { from: "CityD", to: "End", weight: 4 }
    ]
};

io.print("Map graph:");
io.print("Nodes: " + map.nodes());
io.print("Edges: " + map.edges());
io.print("");

// Find shortest path from Start to End
io.print("=== Shortest Path (Dijkstra) ===");
var shortest = map.shortestPath("Start", "End");
io.print("Shortest path from Start to End:");
io.print("  Path: " + shortest.path);
io.print("  Distance: " + shortest.distance);
io.print("  Found: " + shortest.found);
io.print("");

// Find path using BFS (unweighted, finds shortest in terms of edges)
io.print("=== BFS Path (fewest edges) ===");
var bfsPath = map.bfs("Start", "End");
io.print("BFS path from Start to End:");
io.print("  Path: " + bfsPath.path);
io.print("  Found: " + bfsPath.found);
io.print("  Number of edges: " + bfsPath.path.length);
io.print("");

// Find path using DFS (may not be shortest)
io.print("=== DFS Path ===");
var dfsPath = map.dfs("Start", "End");
io.print("DFS path from Start to End:");
io.print("  Path: " + dfsPath.path);
io.print("  Found: " + dfsPath.found);
io.print("");

// Compare different routes
io.print("=== Route Comparison ===");
var route1 = map.shortestPath("Start", "CityA");
var route2 = map.shortestPath("Start", "CityB");
var route3 = map.shortestPath("CityA", "End");
var route4 = map.shortestPath("CityB", "End");

io.print("Start -> CityA: " + route1.path + " (distance: " + route1.distance + ")");
io.print("Start -> CityB: " + route2.path + " (distance: " + route2.distance + ")");
io.print("CityA -> End: " + route3.path + " (distance: " + route3.distance + ")");
io.print("CityB -> End: " + route4.path + " (distance: " + route4.distance + ")");
io.print("");

// Find all paths to a node
io.print("=== Finding All Paths ===");
io.print("All nodes reachable from Start:");
var allReachable = map.bfs("Start");
io.print("  " + allReachable);
io.print("");

// Check if path exists
var pathExists = map.bfs("Start", "End").found;
io.print("Path exists from Start to End: " + pathExists);
