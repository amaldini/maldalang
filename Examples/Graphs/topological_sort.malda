// Topological Sort Example
// Demonstrates topological sorting for directed acyclic graphs (DAGs)

io.print("=== Topological Sort ===\n");

// Create a DAG representing task dependencies
// Example: Course prerequisites or build dependencies
var courseGraph = graph directed {
    nodes: ["Intro", "DataStructures", "Algorithms", "Database", "WebDev", "Advanced"],
    edges: [
        { from: "Intro", to: "DataStructures", weight: 1 },
        { from: "Intro", to: "Database", weight: 1 },
        { from: "DataStructures", to: "Algorithms", weight: 1 },
        { from: "Database", to: "WebDev", weight: 1 },
        { from: "Algorithms", to: "Advanced", weight: 1 },
        { from: "WebDev", to: "Advanced", weight: 1 }
    ]
};

io.print("Course dependency graph:");
io.print("Nodes: " + courseGraph.nodes());
io.print("Edges: " + courseGraph.edges());
io.print("");

// Topological sort
var topo = courseGraph.topologicalSort();
io.print("Topological sort result:");
io.print("  Order: " + topo.order);
io.print("  Valid: " + topo.valid);
io.print("");

if (topo.valid) {
    io.print("Valid course order (prerequisites first):");
    var i = 1;
    for (var course in topo.order) {
        io.print("  " + i + ". " + course);
        i = i + 1;
    }
} else {
    io.print("Graph has cycles - cannot determine valid order");
}
io.print("");

// Check for cycles
io.print("Graph is cyclic: " + courseGraph.isCyclic());
io.print("");

// Create a graph with a cycle (invalid for topological sort)
var cyclicGraph = graph directed {
    nodes: ["A", "B", "C"],
    edges: [
        { from: "A", to: "B", weight: 1 },
        { from: "B", to: "C", weight: 1 },
        { from: "C", to: "A", weight: 1 }  // Creates a cycle
    ]
};

io.print("Cyclic graph:");
io.print("Is cyclic: " + cyclicGraph.isCyclic());
var cyclicTopo = cyclicGraph.topologicalSort();
io.print("Topological sort valid: " + cyclicTopo.valid);
if (!cyclicTopo.valid) {
    io.print("Cannot perform topological sort on cyclic graph");
}
