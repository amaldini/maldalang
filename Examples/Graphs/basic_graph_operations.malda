// Basic Graph Operations Example
// Demonstrates creating graphs and basic operations

io.print("=== Basic Graph Operations ===\n");

// Create a directed graph with initial nodes and edges
var g = graph directed {
    nodes: ["A", "B", "C", "D"],
    edges: [
        { from: "A", to: "B", weight: 4 },
        { from: "A", to: "C", weight: 2 },
        { from: "B", to: "D", weight: 5 },
        { from: "C", to: "D", weight: 1 }
    ]
};

io.print("Graph created with " + g.nodeCount() + " nodes and " + g.edgeCount() + " edges");
io.print("Is directed: " + g.isDirected());
io.print("");

// Query graph
io.print("Has node 'A': " + g.hasNode("A"));
io.print("Has edge from 'A' to 'B': " + g.hasEdge("A", "B"));
io.print("Weight of edge A->B: " + g.getWeight("A", "B"));
io.print("");

// Get neighbors
var neighbors = g.getNeighbors("A");
io.print("Neighbors of 'A': " + neighbors);
io.print("");

// Get all nodes and edges
var nodes = g.nodes();
var edges = g.edges();
io.print("All nodes: " + nodes);
io.print("All edges: " + edges);
io.print("");

// Add a new node and edge
g.addNode("E");
g.addEdge("D", "E", 3);
io.print("After adding node E and edge D->E:");
io.print("Node count: " + g.nodeCount());
io.print("Edge count: " + g.edgeCount());
io.print("");

// Add edge with properties
g.addEdge("E", "A", 7, dict { "label": "return", "type": "cycle" });
io.print("Added edge E->A with properties");
io.print("");

// Remove an edge
g.removeEdge("A", "B");
io.print("After removing edge A->B:");
io.print("Has edge A->B: " + g.hasEdge("A", "B"));
io.print("Edge count: " + g.edgeCount());
io.print("");

// Create an undirected graph
var g2 = graph undirected {
    nodes: ["X", "Y", "Z"],
    edges: [
        { from: "X", to: "Y", weight: 10 },
        { from: "Y", to: "Z", weight: 5 }
    ]
};

io.print("Undirected graph created:");
io.print("Is directed: " + g2.isDirected());
io.print("Nodes: " + g2.nodes());
io.print("Edges: " + g2.edges());
