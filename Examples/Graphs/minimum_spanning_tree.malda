// Minimum Spanning Tree Example
// Demonstrates MST algorithm for undirected graphs

io.print("=== Minimum Spanning Tree ===\n");

// Create an undirected graph representing a network
// Example: Cities connected by roads with distances
var cityGraph = graph undirected {
    nodes: ["A", "B", "C", "D", "E"],
    edges: [
        { from: "A", to: "B", weight: 4 },
        { from: "A", to: "C", weight: 2 },
        { from: "B", to: "C", weight: 1 },
        { from: "B", to: "D", weight: 5 },
        { from: "C", to: "D", weight: 8 },
        { from: "C", to: "E", weight: 10 },
        { from: "D", to: "E", weight: 2 }
    ]
};

io.print("City network graph:");
io.print("Nodes: " + cityGraph.nodes());
io.print("Edges: " + cityGraph.edges());
io.print("Is directed: " + cityGraph.isDirected());
io.print("");

// Calculate minimum spanning tree
var mst = cityGraph.minimumSpanningTree();
io.print("Minimum Spanning Tree:");
io.print("  Edges: " + mst.edges);
io.print("  Total weight: " + mst.totalWeight);
io.print("");

// Display MST edges in a readable format
io.print("MST edges (connecting all cities with minimum cost):");
for (var edge in mst.edges) {
    var from = edge[0];
    var to = edge[1];
    var weight = edge[2];
    io.print("  " + from + " <-> " + to + " (weight: " + weight + ")");
}
io.print("");

// Compare original graph vs MST
io.print("Original graph:");
io.print("  Total edges: " + cityGraph.edgeCount());
io.print("MST:");
io.print("  Total edges: " + mst.edges.length);
io.print("  Total weight: " + mst.totalWeight);
io.print("");

// Example: Network infrastructure planning
io.print("Application: Network infrastructure planning");
io.print("The MST shows the minimum cost network to connect all cities.");
