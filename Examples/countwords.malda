function countWords(text) {
    io.print("Debug: Input text: '" + text + "'");
    if (text == null || text == "") {
        io.print("Debug: Empty or null text, returning 0");
        return 0;
    }
    var words = 0;
    var inWord = false;
    var i = 0;
    while (i < str.length(text)) {
        var char = str.substring(text, i, 1);
        io.print("Debug: Processing character '" + char + "' at position " + i);
        io.print("Non é spazio:" + (char != " "));
        if (char != " " && char != "\t" && char != "\n") {
            if (!inWord) {
                words = words + 1;
                io.print("Debug: Found new word, total words now: " + words);
                inWord = true;
            }
        } else {
            inWord = false;
            io.print("Debug: Found whitespace, inWord set to false");
        }
        i = i + 1;
    }
    io.print("Debug: Final word count: " + words);
    return words;
}

io.print(countWords("Quante sono queste parole"));
