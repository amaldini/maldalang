// Basic Arduino Example
// Demonstrates connecting to Arduino and controlling basic I/O

io.print("=== Basic Arduino Control ===\n");

// Connect to Arduino via serial (USB)
// Change "COM3" to your Arduino's port (e.g., "COM3" on Windows, "/dev/ttyUSB0" on Linux)
var arduino = new ArduinoConnection("COM3", 9600);

io.print("Connecting to Arduino...\n");
var connected = arduino.connect();
if (connected) {
    io.print("Connected successfully!\n\n");

    // Configure pin 13 as OUTPUT (built-in LED on most Arduino boards)
    io.print("Configuring pin 13 as OUTPUT...\n");
    arduino.pinMode(13, "OUTPUT");

    // Blink LED 5 times
    io.print("Blinking LED 5 times...\n");
    for (var i = 0; i < 5; i = i + 1) {
        arduino.digitalWrite(13, true);
        io.print("LED ON\n");
        sleep(500);

        arduino.digitalWrite(13, false);
        io.print("LED OFF\n");
        sleep(500);
    }

    // Read analog pin 0 (if sensor connected)
    io.print("\nReading analog pin 0...\n");
    var analogValue = arduino.analogRead(0);
    io.print("Analog value: " + analogValue + "\n");

    // Read digital pin 2 (if button/sensor connected)
    io.print("Reading digital pin 2...\n");
    arduino.pinMode(2, "INPUT");
    var digitalValue = arduino.digitalRead(2);
    io.print("Digital value: " + digitalValue + "\n");

    // Disconnect
    io.print("\nDisconnecting...\n");
    arduino.disconnect();
    io.print("Disconnected.\n");
} else {
    io.print("Failed to connect to Arduino.\n");
    io.print("Make sure:\n");
    io.print("  1. Arduino is connected via USB\n");
    io.print("  2. Correct port name is used (COM3, /dev/ttyUSB0, etc.)\n");
    io.print("  3. Arduino bridge sketch is uploaded\n");
}

io.print("\nExample complete!\n");
