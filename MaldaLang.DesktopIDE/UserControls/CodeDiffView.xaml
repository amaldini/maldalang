<UserControl x:Class="MaldaLang.DesktopIDE.UserControls.CodeDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8">
            <TextBlock Text="Code Changes" 
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextForegroundBrush}"/>
        </Border>
        
        <!-- Diff Display -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DiffItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Line Numbers -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding LineNumberText}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Background="{Binding LineBackground}"
                                       Padding="8,2"
                                       MinWidth="60"
                                       TextAlignment="Right"/>
                            
                            <!-- Original Content -->
                            <TextBox Grid.Column="1"
                                     Text="{Binding OriginalContent, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     Background="{Binding OriginalBackground, Mode=OneWay}"
                                     Foreground="{Binding OriginalForeground, Mode=OneWay}"
                                     BorderThickness="0,0,1,0"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollBarVisibility="Disabled"/>
                            
                            <!-- New Content -->
                            <TextBox Grid.Column="2"
                                     Text="{Binding NewContent, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     Background="{Binding NewBackground, Mode=OneWay}"
                                     Foreground="{Binding NewForeground, Mode=OneWay}"
                                     BorderThickness="0"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollBarVisibility="Disabled"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- Action Buttons -->
        <Border Grid.Row="2" 
                Background="{DynamicResource InputBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="8">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Apply Changes" 
                        Margin="0,0,8,0"
                        Click="ApplyButton_Click"
                        Style="{StaticResource PrimaryButton}"/>
                <Button Content="Discard" 
                        Margin="0,0,8,0"
                        Click="DiscardButton_Click"/>
                <Button Content="Copy Code" 
                        Margin="0,0,8,0"
                        Click="CopyButton_Click"/>
                <Button Content="Expand Diff"
                        Click="ExpandButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
