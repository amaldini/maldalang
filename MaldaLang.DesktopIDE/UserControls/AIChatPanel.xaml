<UserControl x:Class="MaldaLang.DesktopIDE.UserControls.AIChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MaldaLang.DesktopIDE.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Chat Messages Area -->
        <ScrollViewer x:Name="MessagesScrollViewer" 
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="MessagesStackPanel" Orientation="Vertical"/>
        </ScrollViewer>
        
        <!-- Welcome Message (when no messages) -->
        <TextBlock x:Name="WelcomeTextBlock"
                   Grid.Row="0"
                   Text="AI Assistant&#x0a;Ask me questions about your MALDA code, get explanations, or request code modifications.&#x0a;I have context about your current code, cursor position, and any errors."
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="20"
                   FontSize="12"/>
        
        <!-- Input Area -->
        <Border Grid.Row="1" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,1,0,0"
                Background="{DynamicResource InputBackgroundBrush}"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="ChatInputTextBox" 
                         Grid.Row="0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         MinHeight="60"
                         MaxHeight="120"
                         FontFamily="Consolas"
                         FontSize="12"
                         KeyDown="ChatInputTextBox_KeyDown"
                         TextChanged="ChatInputTextBox_TextChanged"/>
                <!-- Mode selection and Model selection -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Mode:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <RadioButton x:Name="AskModeRadioButton"
                                 Content="Ask"
                                 IsChecked="True"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextForegroundBrush}"
                                 Checked="AskModeRadioButton_Checked"/>
                    <RadioButton x:Name="AskMaldaModeRadioButton"
                                 Content="Edit"
                                 Margin="0,0,16,0"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextForegroundBrush}"
                                 Checked="AskMaldaModeRadioButton_Checked"/>
                    <TextBlock Text="Model:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button x:Name="ModelSelectionButton"
                            Content="Select Model"
                            Padding="8,4"
                            Click="ModelSelectionButton_Click"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource ButtonForegroundBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"/>
                    <TextBlock x:Name="CurrentModelTextBlock"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="ClearButton"
                            Content="Clear"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            Click="ClearButton_Click"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource ButtonForegroundBrush}"
                            BorderBrush="{DynamicResource ButtonBorderBrush}"/>
                    <Button x:Name="SendButton"
                            Content="Send"
                            Padding="16,6"
                            Click="SendButton_Click"
                            IsEnabled="False"
                            Background="{DynamicResource PrimaryButtonBackgroundBrush}"
                            Foreground="{DynamicResource PrimaryButtonForegroundBrush}"
                            BorderBrush="{DynamicResource PrimaryButtonBorderBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Loading Indicator -->
        <Border x:Name="LoadingIndicator"
                Grid.Row="0"
                Background="#80000000"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="AI is thinking..." 
                           Foreground="{DynamicResource TextForegroundBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- Model Loading Progress Overlay -->
        <Border x:Name="ModelLoadingOverlay"
                Grid.Row="0"
                Background="#E0000000"
                Visibility="Collapsed"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Padding="20">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="ModelLoadingText"
                           Text="Loading model..."
                           Foreground="{DynamicResource TextForegroundBrush}"
                           FontSize="14"
                           TextAlignment="Center"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"/>
                <ProgressBar x:Name="ModelLoadingProgressBar"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Height="8"
                             Width="300"
                             HorizontalAlignment="Center"
                             IsIndeterminate="False"/>
                <TextBlock Text="Please wait while the model loads into memory..."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11"
                           TextAlignment="Center"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
