<Window x:Class="MaldaLang.DesktopIDE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:MaldaLang.DesktopIDE.UserControls"
        xmlns:converters="clr-namespace:MaldaLang.DesktopIDE.Converters"
        xmlns:svc="clr-namespace:MaldaLang.DesktopIDE.Services"
        xmlns:ide="clr-namespace:MaldaLang.IDE.Models;assembly=malda"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="MALDA" Height="800" Width="1200"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <converters:AddOneConverter x:Key="AddOneConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <Style x:Key="AutofixButton" TargetType="Button">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryButtonHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="TabButtonStyle">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="{DynamicResource TabBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TabForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{DynamicResource ListBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ListForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ListBorderBrush}"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource ListForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ListBackgroundBrush}"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TabForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local"
                              SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      IsItemsHost="True"
                                      Background="Transparent"
                                      Margin="0,0,0,-1"
                                      Panel.ZIndex="1"/>
                            <Border x:Name="ContentPanel"
                                    Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="0,4,4,4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TabForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource TabBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4,4,0,0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Menu Bar -->
        <Menu x:Name="MainMenu" Grid.Row="0" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="FileNew_Click" InputGestureText="Ctrl+N">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconNew}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Open..." Click="FileOpen_Click" InputGestureText="Ctrl+O">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconOpen}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open Folde_r..." Click="FileOpenFolder_Click">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconFolder}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Save" Click="FileSave_Click" InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconSave}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save _As..." Click="FileSaveAs_Click" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="Close _Others" Click="FileCloseOthers_Click"/>
                <MenuItem Header="Close _All" Click="FileCloseAll_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="FileExit_Click" InputGestureText="Alt+F4">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconExit}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Click="EditUndo_Click" InputGestureText="Ctrl+Z">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconUndo}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Redo" Click="EditRedo_Click" InputGestureText="Ctrl+Y">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconRedo}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Cu_t" Click="EditCut_Click" InputGestureText="Ctrl+X">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconCut}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Copy" Click="EditCopy_Click" InputGestureText="Ctrl+C">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconCopy}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Paste" Click="EditPaste_Click" InputGestureText="Ctrl+V">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconPaste}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Select _All" Click="EditSelectAll_Click" InputGestureText="Ctrl+A">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconSelectAll}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Find..." Click="EditFind_Click" InputGestureText="Ctrl+F">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconFind}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="R_eplace..." Click="EditReplace_Click" InputGestureText="Ctrl+H"/>
                <MenuItem Header="Format _Document" Click="EditFormatDocument_Click" InputGestureText="Ctrl+Alt+F">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconFormat}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Quick Fix..." Click="EditQuickFix_Click" InputGestureText="Ctrl+.">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconLightbulb}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Apply _Autofixes" Click="AutofixErrorsButton_Click">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconWrench}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Rename Symbol..." Click="NavigateRenameSymbol_Click" InputGestureText="Ctrl+Alt+R">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconRename}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Navigate">
                <MenuItem Header="Go to _Definition" Click="NavigateGoToDefinition_Click" InputGestureText="F12">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconGoTo}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Find _References" Click="NavigateFindReferences_Click" InputGestureText="Shift+F12">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconReferences}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Go to _Symbol..." Click="NavigateGoToSymbol_Click" InputGestureText="Ctrl+T">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconSymbol}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Command _Palette..." Click="ViewCommandPalette_Click" InputGestureText="Ctrl+Shift+P">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconFind}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="ThemeMenu" Header="_Theme">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconTheme}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Show S_yntax Panel" IsCheckable="True" IsChecked="True" Click="ViewToggleSyntaxPanel_Click"/>
                <MenuItem Header="Show _Output Panel" IsCheckable="True" IsChecked="True" Click="ViewToggleOutputPanel_Click"/>
                <MenuItem Header="Output on the _Right" IsCheckable="True" IsChecked="True" Click="ViewToggleOutputOnRight_Click"
                          ToolTip="Show program output in the tall pane on the right. Uncheck to dock it under the editor."/>
                <MenuItem Header="Show _Debug Panel" IsCheckable="True" Click="ViewToggleDebugPanel_Click"/>
                <MenuItem Header="Show _Tool Calls Panel" IsCheckable="True" Click="ViewToggleToolCallsPanel_Click"/>
                <MenuItem Header="Show _Problems Panel" IsCheckable="True" Click="ViewToggleErrorsPanel_Click"/>
                <MenuItem Header="Show _Search Panel" IsCheckable="True" Click="ViewToggleSearchPanel_Click"/>
                <MenuItem Header="Show _AI Panel" IsCheckable="True" Click="ViewToggleAIPanel_Click"/>
                <MenuItem Header="Show _Web UI Panel" IsCheckable="True" Click="ViewToggleWebUIPanel_Click"/>
                <MenuItem Header="_Maximize AI Panel" IsCheckable="True" Click="ViewToggleMaximizeAiPanel_Click" InputGestureText="Shift+F7"/>
                <MenuItem Header="_Maximize Web Preview" IsCheckable="True" Click="ViewToggleMaximizeWebPreview_Click" InputGestureText="Shift+F6"/>
                <MenuItem Header="_Reset Web Preview" Click="ViewResetWebPreview_Click"/>
                <Separator/>
                <MenuItem Header="_Type Errors as Errors" IsCheckable="True" IsChecked="True" Click="ViewToggleTypeErrors_Click"
                          ToolTip="When checked, type-hint mismatches are Errors. Uncheck for Warning/Info (lenient)."/>
                <Separator/>
                <MenuItem Header="Open _Trace..." Click="ViewOpenTrace_Click">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconTrace}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Run">
                <MenuItem Header="_Run" Click="RunButton_Click" InputGestureText="Ctrl+F5">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconPlay}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Debug" Click="DebugButton_Click" InputGestureText="F5">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconDebug}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Stop" Click="StopButton_Click" InputGestureText="Shift+F5">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconStop}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Reload Open Files" Click="ReloadOpenFilesButton_Click" InputGestureText="Ctrl+Shift+R">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconReload}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Compile" Click="CompileButton_Click" InputGestureText="Ctrl+Shift+B">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconCompile}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Preview _Web" Click="PreviewWebButton_Click" InputGestureText="F6">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconWeb}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Debug">
                <MenuItem Header="_Continue" Click="ContinueButton_Click" InputGestureText="F5">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconPlay}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Step _Over" Click="StepOverButton_Click" InputGestureText="F10">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconStepOver}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Step _Into" Click="StepIntoButton_Click" InputGestureText="F11">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconStepInto}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Step O_ut" Click="StepOutButton_Click" InputGestureText="Shift+F11">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconStepOut}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Pause" Click="PauseButton_Click">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconPause}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Toggle _Breakpoint" Click="DebugToggleBreakpoint_Click" InputGestureText="F9">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconBreakpoint}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Clear All _Breakpoints" Click="DebugClearBreakpoints_Click">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconClearBreakpoints}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="_Browse Models..." Click="ToolsBrowseModels_Click">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconPackage}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Package _Manager..." Click="ToolsPackageManager_Click">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconBook}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Configure _MCP Servers..." Click="ToolsConfigureMCPServers_Click">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconPlug}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Start With _MALDA..." Click="StartWithMalda_Click">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconLearn}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Load Example..." Click="ToolsLoadExample_Click">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconOpen}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Clear Output" Click="ClearOutputButton_Click">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconTrash}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Show _Tool Calls" Click="ToolCallsTabButton_Click"/>
                <MenuItem Header="Show _AI Chat" Click="AITabButton_Click"/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="Start With _MALDA..." Click="StartWithMalda_Click">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconLearn}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_About..." Click="HelpAbout_Click">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconAbout}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Reference Manual" Click="HelpReferenceManual_Click">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconManual}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Documentation" Click="HelpDocumentation_Click">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconHelp}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Keyboard Shortcuts" Click="HelpShortcuts_Click">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconKeyboard}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Update Installation..." Click="HelpUpdateInstallation_Click">
                    <MenuItem.Icon>
                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconDownload}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <Border x:Name="MainToolbar" Grid.Row="1" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RunButton" Style="{StaticResource ToolbarPrimaryButton}" Click="RunButton_Click" ToolTip="Run without debugging (Ctrl+F5)">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IdeAccentIcon}" Data="{StaticResource IconPlay}" Fill="{DynamicResource PrimaryButtonForegroundBrush}" StrokeThickness="0"/>
                        <TextBlock Text="Run" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryButtonForegroundBrush}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DebugButton" Style="{StaticResource ToolbarIconButton}" Click="DebugButton_Click" ToolTip="Start debugging (F5)">
                    <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconDebug}"/>
                </Button>
                <Button x:Name="StopButton" Style="{StaticResource ToolbarIconButton}" Click="StopButton_Click" ToolTip="Stop (Shift+F5)">
                    <Path Style="{StaticResource IdeDangerIcon}" Data="{StaticResource IconStop}"/>
                </Button>
                <Button x:Name="ClearOutputButton" Style="{StaticResource ToolbarIconButton}" Click="ClearOutputButton_Click" ToolTip="Clear output">
                    <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconTrash}"/>
                </Button>
                <Button x:Name="ReloadOpenFilesButton" Style="{StaticResource ToolbarIconButton}" Click="ReloadOpenFilesButton_Click" ToolTip="Reload open files from disk (Ctrl+Shift+R)">
                    <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconReload}"/>
                </Button>
                <Button Style="{StaticResource ToolbarIconButton}" Click="CompileButton_Click" ToolTip="Compile (Ctrl+Shift+B)">
                    <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconCompile}"/>
                </Button>
                <Button x:Name="PreviewWebButton" Style="{StaticResource ToolbarIconButton}" Click="PreviewWebButton_Click" ToolTip="Preview Web (F6)">
                    <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconWeb}"/>
                </Button>
                <Button Style="{StaticResource ToolbarIconButton}" Click="StartWithMalda_Click" ToolTip="Start With MALDA">
                    <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconLearn}"/>
                </Button>

                <StackPanel x:Name="DebugTransportBar" Orientation="Horizontal" Visibility="Collapsed">
                    <Border Style="{StaticResource ToolbarDivider}"/>
                    <Button x:Name="ContinueButton" Style="{StaticResource ToolbarIconButton}" Click="ContinueButton_Click" ToolTip="Continue (F5)">
                        <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconPlay}"/>
                    </Button>
                    <Button x:Name="StepOverButton" Style="{StaticResource ToolbarIconButton}" Click="StepOverButton_Click" ToolTip="Step Over (F10)">
                        <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconStepOver}"/>
                    </Button>
                    <Button x:Name="StepIntoButton" Style="{StaticResource ToolbarIconButton}" Click="StepIntoButton_Click" ToolTip="Step Into (F11)">
                        <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconStepInto}"/>
                    </Button>
                    <Button x:Name="StepOutButton" Style="{StaticResource ToolbarIconButton}" Click="StepOutButton_Click" ToolTip="Step Out (Shift+F11)">
                        <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconStepOut}"/>
                    </Button>
                    <Button x:Name="PauseButton" Style="{StaticResource ToolbarIconButton}" Click="PauseButton_Click" ToolTip="Pause">
                        <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconPause}"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid x:Name="MainWorkspaceGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SyntaxPanelColumn" Width="280" MinWidth="220"/>
                <ColumnDefinition x:Name="LeftSplitterColumn" Width="5"/>
                <ColumnDefinition x:Name="EditorColumn" Width="*"/>
                <ColumnDefinition x:Name="RightSplitterColumn" Width="5"/>
                <ColumnDefinition x:Name="SidebarColumn" Width="420" MinWidth="280"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Syntax Panel -->
            <Border x:Name="SyntaxPanel"
                    Grid.Column="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Background="{DynamicResource SidebarBackgroundBrush}">
                <TabControl Margin="8"
                            Background="{DynamicResource SidebarBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}">
                    <TabItem Header="Files">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="WorkspaceEmptyState" Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="No folder open" FontWeight="SemiBold"/>
                                <TextBlock Text="Open a folder to browse .malda files in this workspace."
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,8"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Button Content="Open Folder"
                                        Click="FileOpenFolder_Click"
                                        HorizontalAlignment="Left"
                                        Padding="10,4"/>
                            </StackPanel>
                            <TextBlock x:Name="WorkspaceFolderLabel"
                                       Grid.Row="0"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6"
                                       Visibility="Collapsed"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TreeView x:Name="WorkspaceFilesTreeView"
                                      Grid.Row="1"
                                      MouseDoubleClick="WorkspaceFilesTreeView_MouseDoubleClick"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Syntax">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Syntax Helper" FontWeight="Bold" Margin="0,0,0,6"/>

                            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                <TextBox x:Name="SyntaxSearchTextBox"
                                         Margin="0,0,0,6"
                                         ToolTip="Search syntax snippets"
                                         TextChanged="SyntaxSearchTextBox_TextChanged"/>
                                <ComboBox x:Name="SyntaxCategoryComboBox"
                                          SelectionChanged="SyntaxCategoryComboBox_SelectionChanged"/>
                            </StackPanel>

                            <ListBox x:Name="SyntaxSnippetsListBox"
                                     Grid.Row="2"
                                     Background="{DynamicResource ListBackgroundBrush}"
                                     Foreground="{DynamicResource ListForegroundBrush}"
                                     BorderBrush="{DynamicResource ListBorderBrush}"
                                     FontSize="12"
                                     MouseDoubleClick="SyntaxSnippetsListBox_MouseDoubleClick"
                                     SelectionChanged="SyntaxSnippetsListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                                                <TextBlock Text="{Binding Preview}" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button x:Name="InsertSyntaxButton"
                                    Grid.Row="3"
                                    Content="Insert Snippet"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,8,0,0"
                                    Click="InsertSyntaxButton_Click"
                                    IsEnabled="False"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Outline">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Document Outline" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox x:Name="OutlineSearchTextBox"
                                     Grid.Row="1"
                                     Margin="0,0,0,8"
                                     ToolTip="Filter symbols in current document"
                                     TextChanged="OutlineSearchTextBox_TextChanged"/>
                            <TreeView x:Name="OutlineTreeView"
                                      Grid.Row="2"
                                      Background="{DynamicResource ListBackgroundBrush}"
                                      Foreground="{DynamicResource ListForegroundBrush}"
                                      BorderBrush="{DynamicResource ListBorderBrush}"
                                      FontSize="12"
                                      SelectedItemChanged="OutlineTreeView_SelectedItemChanged"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- GridSplitter for resizing left panel -->
            <GridSplitter x:Name="SyntaxPanelSplitter"
                         Grid.Column="1"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         Background="{DynamicResource GridSplitterBackgroundBrush}"
                         Width="5"
                         ResizeBehavior="PreviousAndNext"
                         ShowsPreview="True"/>

            <!-- Editor Panel -->
            <Border x:Name="EditorPane" Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition x:Name="BottomPanelRow" Height="220" MinHeight="96"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource TabBackgroundBrush}"
                                  Padding="4,2,4,0">
                        <WrapPanel x:Name="DocumentTabsPanel" Orientation="Horizontal"/>
                    </ScrollViewer>

                    <Border x:Name="LearningBranchBanner"
                            Grid.Row="1"
                            Background="{DynamicResource TabBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,10"
                            Visibility="Collapsed">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Width="28"
                                    Height="28"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Padding="0"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Content="×"
                                    ToolTip="Hide starter header"
                                    Click="CloseLearningBranchBanner_Click"/>
                            <StackPanel DockPanel.Dock="Left" Margin="0,0,16,0">
                                <TextBlock x:Name="LearningBranchTitleTextBlock"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextForegroundBrush}" />
                                <TextBlock x:Name="LearningBranchDescriptionTextBlock"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <WrapPanel x:Name="LearningBranchButtonsPanel"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <avalon:TextEditor Grid.Row="2"
                                       x:Name="CodeEditor"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       ShowLineNumbers="True"
                                       SyntaxHighlighting="CSharp"
                                       Background="{DynamicResource EditorBackgroundBrush}"
                                       Foreground="{DynamicResource EditorForegroundBrush}"
                                       LineNumbersForeground="{DynamicResource EditorLineNumbersBrush}"
                                       MouseDoubleClick="CodeEditor_MouseDoubleClick">
                        <avalon:TextEditor.ContextMenu>
                            <ContextMenu x:Name="EditorContextMenu" Opened="EditorContextMenu_Opened">
                                <MenuItem Header="Go to _Definition"
                                          Click="NavigateGoToDefinition_Click"
                                          InputGestureText="F12"
                                          Tag="{x:Static svc:EditorContextMenuCommand.GoToDefinition}">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconGoTo}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Find _References"
                                          Click="NavigateFindReferences_Click"
                                          InputGestureText="Shift+F12"
                                          Tag="{x:Static svc:EditorContextMenuCommand.FindReferences}">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconReferences}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Rename Symbol..."
                                          Click="NavigateRenameSymbol_Click"
                                          InputGestureText="Ctrl+Alt+R"
                                          Tag="{x:Static svc:EditorContextMenuCommand.RenameSymbol}">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconRename}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="_Quick Fix..."
                                          Click="EditQuickFix_Click"
                                          InputGestureText="Ctrl+."
                                          Tag="{x:Static svc:EditorContextMenuCommand.QuickFix}">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconLightbulb}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Format _Document" Click="EditFormatDocument_Click" InputGestureText="Ctrl+Alt+F">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconFormat}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Cu_t"
                                          Click="EditCut_Click"
                                          InputGestureText="Ctrl+X"
                                          Tag="{x:Static svc:EditorContextMenuCommand.Cut}">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconCut}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Copy"
                                          Click="EditCopy_Click"
                                          InputGestureText="Ctrl+C"
                                          Tag="{x:Static svc:EditorContextMenuCommand.Copy}">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconCopy}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="_Paste"
                                          Click="EditPaste_Click"
                                          InputGestureText="Ctrl+V"
                                          Tag="{x:Static svc:EditorContextMenuCommand.Paste}">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconPaste}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Select _All" Click="EditSelectAll_Click" InputGestureText="Ctrl+A">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconSelectAll}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Toggle _Breakpoint" Click="DebugToggleBreakpoint_Click" InputGestureText="F9">
                                    <MenuItem.Icon>
                                        <Path Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconBreakpoint}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </avalon:TextEditor.ContextMenu>
                    </avalon:TextEditor>
                    </Grid>
                    <GridSplitter x:Name="BottomPanelSplitter"
                                  Grid.Row="1"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext"
                                  Background="{DynamicResource GridSplitterBackgroundBrush}"/>
                    <Border x:Name="BottomPanel"
                            Grid.Row="2"
                            Background="{DynamicResource SidebarBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="BottomTabBar" Grid.Row="0" Orientation="Horizontal" Background="{DynamicResource TabBackgroundBrush}">
                                <Button x:Name="ErrorsTabButton" Click="ErrorsTabButton_Click" Style="{StaticResource TabButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Problems" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ProblemsBadgeText"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="OutputTabButton" Content="Output" Click="OutputTabButton_Click" Style="{StaticResource TabButtonStyle}"/>
                                <Button x:Name="DebugTabButton" Content="Debug" Click="DebugTabButton_Click" Style="{StaticResource TabButtonStyle}"/>
                                <Button x:Name="SearchTabButton" Content="Search" Click="SearchTabButton_Click" Style="{StaticResource TabButtonStyle}"/>
                                <Button x:Name="ToolCallsTabButton" Content="Tool Calls" Click="ToolCallsTabButton_Click" Style="{StaticResource TabButtonStyle}"/>
                            </StackPanel>
                            <Grid x:Name="BottomPanelContent" Grid.Row="1"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            
            <!-- GridSplitter for resizing right sidebar -->
            <GridSplitter x:Name="SidebarSplitter"
                         Grid.Column="3" 
                         HorizontalAlignment="Stretch" 
                         VerticalAlignment="Stretch"
                         Background="{DynamicResource GridSplitterBackgroundBrush}"
                         Width="5"
                         ResizeBehavior="PreviousAndNext"
                         ShowsPreview="True"/>
            
            <!-- Sidebar -->
            <Grid x:Name="SidebarGrid" Grid.Column="4" Background="{DynamicResource SidebarBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Tabs -->
                <StackPanel x:Name="SidebarTabBar" Grid.Row="0" Orientation="Horizontal" Background="{DynamicResource TabBackgroundBrush}">
                    <Button x:Name="AITabButton" Content="AI" Click="AITabButton_Click"
                            Style="{StaticResource TabButtonStyle}"/>
                    <Button x:Name="WebUITabButton" Content="Web UI" Click="WebUITabButton_Click"
                            Style="{StaticResource TabButtonStyle}"/>
                </StackPanel>
                
                <!-- Tab Content -->
                <Grid x:Name="SidebarPanelContent" Grid.Row="1">
                    <!-- Output Panel -->
                    <Grid x:Name="OutputPanel" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="RegressionActionBar"
                                Grid.Row="0"
                                Visibility="Collapsed"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="8,6">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CreateRegressionButton"
                                        Content="Create Regression"
                                        Click="CreateRegressionButton_Click"
                                        Padding="8,4"/>
                                <TextBlock x:Name="RegressionHintTextBlock"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        
                        <WebBrowser x:Name="OutputWebBrowser" 
                                    Grid.Row="1"/>
                        
                        <Border Grid.Row="2" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Program Input (one value per line):" Margin="0,0,0,4" FontSize="12"/>
                                <TextBox x:Name="ProgramInputTextBox" 
                                         Grid.Row="1"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="60"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Background="{DynamicResource InputBackgroundBrush}"
                                         Foreground="{DynamicResource InputForegroundBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}"/>
                            </Grid>
                        </Border>
                    </Grid>
                    
                    <!-- Debug Panel -->
                    <Grid x:Name="DebugPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Call Stack" FontWeight="Bold" Margin="8,8,8,4" Foreground="{DynamicResource DebugAccentBrush}" FontSize="12"/>
                        <ListBox x:Name="CallStackListBox" Grid.Row="1" Background="{DynamicResource ListBackgroundBrush}" BorderBrush="{DynamicResource ListBorderBrush}" Margin="8,0,8,8"
                                 Foreground="{DynamicResource ListForegroundBrush}" FontFamily="Consolas" FontSize="12"
                                 SelectionChanged="CallStackListBox_SelectionChanged"/>

                        <TextBlock Grid.Row="2" Text="Variables" FontWeight="Bold" Margin="8,8,8,4" Foreground="{DynamicResource DebugAccentBrush}" FontSize="12"/>
                        <TreeView x:Name="VariablesTreeView" Grid.Row="3" Background="{DynamicResource ListBackgroundBrush}" BorderBrush="{DynamicResource ListBorderBrush}" Margin="8,0,8,8"
                                  Foreground="{DynamicResource ListForegroundBrush}" FontFamily="Consolas" FontSize="12"
                                  TreeViewItem.Expanded="DebugInspectTree_Expanded"
                                  TreeViewItem.Collapsed="DebugInspectTree_Collapsed"/>

                        <TextBlock Grid.Row="4" Text="Watches" FontWeight="Bold" Margin="8,8,8,4" Foreground="{DynamicResource DebugAccentBrush}" FontSize="12"/>
                        <Grid Grid.Row="5" Margin="8,0,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WatchExpressionTextBox" Grid.Column="0" KeyDown="WatchExpressionTextBox_KeyDown"/>
                            <Button Grid.Column="1" Content="Add" Margin="6,0,0,0" Padding="8,4" Click="AddWatchButton_Click"/>
                        </Grid>
                        <TreeView x:Name="WatchesTreeView" Grid.Row="6" Background="{DynamicResource ListBackgroundBrush}" BorderBrush="{DynamicResource ListBorderBrush}" Margin="8,0,8,8"
                                  Foreground="{DynamicResource ListForegroundBrush}" FontFamily="Consolas" FontSize="12"
                                  TreeViewItem.Expanded="DebugInspectTree_Expanded"
                                  TreeViewItem.Collapsed="DebugInspectTree_Collapsed"
                                  MouseDoubleClick="WatchesTreeView_MouseDoubleClick"/>

                        <TextBlock Grid.Row="7" Text="Breakpoints" FontWeight="Bold" Margin="8,8,8,4" Foreground="{DynamicResource DebugAccentBrush}" FontSize="12"/>
                        <ListBox x:Name="BreakpointsListBox" Grid.Row="8" Background="{DynamicResource ListBackgroundBrush}" BorderBrush="{DynamicResource ListBorderBrush}" Margin="8,0,8,8"
                                 Foreground="{DynamicResource ListForegroundBrush}" FontFamily="Consolas" FontSize="12"
                                 MouseDoubleClick="BreakpointsListBox_MouseDoubleClick"/>
                    </Grid>
                    
                    <!-- Tool Calls Panel -->
                    <Grid x:Name="ToolCallsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8">
                            <Button Content="Clear Log" Click="ClearToolCallsButton_Click" HorizontalAlignment="Right" Padding="8,4"/>
                        </Border>
                        <WebBrowser x:Name="ToolCallsWebBrowser" Grid.Row="1"/>
                    </Grid>
                    
                    <!-- Errors Panel -->
                    <Grid x:Name="ErrorsPanel" Visibility="Collapsed">
                        <ListBox x:Name="ErrorsListBox" 
                                 Background="{DynamicResource ListBackgroundBrush}"
                                 Foreground="{DynamicResource ListForegroundBrush}"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 SelectionChanged="ErrorsListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Error icon and message -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock x:Name="IconTextBlock" Margin="0,0,4,0"/>
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="Line "/>
                                                <Run Text="{Binding Line, Converter={StaticResource AddOneConverter}}"/>
                                                <Run Text=", Col "/>
                                                <Run Text="{Binding Column, Converter={StaticResource AddOneConverter}}"/>
                                                <Run Text=": "/>
                                                <Run Text="{Binding Message}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        
                                        <!-- Fix button (if available) -->
                                        <Button Grid.Column="1"
                                                Padding="6,2"
                                                Margin="8,0,0,0"
                                                ToolTip="Apply quick fix"
                                                Click="ErrorFixButton_Click"
                                                Tag="{Binding}">
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource IdeIcon}"
                                                          Data="{StaticResource IconWrench}"
                                                          Width="12"
                                                          Height="12"
                                                          Stroke="{DynamicResource PrimaryButtonForegroundBrush}"/>
                                                    <TextBlock Text="Fix"
                                                               Margin="4,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource PrimaryButtonForegroundBrush}"/>
                                                </StackPanel>
                                            </Button.Content>
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Visibility" Value="{Binding AutoFix, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="4"
                                                                        Padding="6,2">
                                                                    <ContentPresenter HorizontalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static ide:DiagnosticSeverity.Error}">
                                            <Setter TargetName="IconTextBlock" Property="Text" Value="✕"/>
                                            <Setter TargetName="IconTextBlock" Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static ide:DiagnosticSeverity.Warning}">
                                            <Setter TargetName="IconTextBlock" Property="Text" Value="⚠"/>
                                            <Setter TargetName="IconTextBlock" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static ide:DiagnosticSeverity.Info}">
                                            <Setter TargetName="IconTextBlock" Property="Text" Value="ℹ"/>
                                            <Setter TargetName="IconTextBlock" Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    
                    <!-- AI Chat Panel -->
                    <Grid x:Name="AIChatPanel" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="AI Assistant" VerticalAlignment="Center" Foreground="{DynamicResource TextForegroundBrush}"/>
                                <Button x:Name="AiPanelMaximizeButton" Grid.Column="1" Content="Maximize" Click="AiPanelMaximizeButton_Click" Padding="10,4"
                                        ToolTip="Show AI panel across the entire IDE client area (Shift+F7)"/>
                            </Grid>
                        </Border>

                        <local:AIChatPanel x:Name="AIChatPanelControl" Grid.Row="1"/>
                    </Grid>

                    <!-- Search Panel -->
                    <Grid x:Name="SearchPanel" Visibility="Collapsed" Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="SearchTextBox"
                                 Grid.Row="0"
                                 Margin="0,0,0,6"
                                 ToolTip="Enter text or regex pattern"
                                 KeyDown="SearchTextBox_KeyDown"/>

                        <TextBox x:Name="ReplaceTextBox"
                                 Grid.Row="1"
                                 Margin="0,0,0,6"
                                 ToolTip="Replacement text"
                                 KeyDown="ReplaceTextBox_KeyDown"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox x:Name="SearchRegexCheckBox" Content="Regex" VerticalAlignment="Center" Foreground="{DynamicResource TextForegroundBrush}"/>
                            <CheckBox x:Name="SearchMatchCaseCheckBox" Content="Match case" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextForegroundBrush}"/>
                            <CheckBox x:Name="SearchCurrentDocumentOnlyCheckBox" Content="Current doc only" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextForegroundBrush}"/>
                            <Button x:Name="SearchFindAllButton" Content="Find All" Click="SearchFindAllButton_Click" Margin="8,0,0,0" Padding="10,4"/>
                            <Button x:Name="SearchPrevButton" Content="Previous" Click="SearchPrevButton_Click" Margin="8,0,0,0" Padding="10,4"/>
                            <Button x:Name="SearchNextButton" Content="Next" Click="SearchNextButton_Click" Margin="4,0,0,0" Padding="10,4"/>
                            <Button x:Name="SearchReplaceButton" Content="Replace" Click="SearchReplaceButton_Click" Margin="8,0,0,0" Padding="10,4"/>
                            <Button x:Name="SearchReplaceAllButton" Content="Replace All" Click="SearchReplaceAllButton_Click" Margin="4,0,0,0" Padding="10,4"/>
                        </StackPanel>

                        <TextBlock x:Name="SearchSummaryTextBlock" Grid.Row="3" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <TreeView x:Name="SearchResultsTreeView"
                                  Grid.Row="4"
                                  Background="{DynamicResource ListBackgroundBrush}"
                                  Foreground="{DynamicResource ListForegroundBrush}"
                                  BorderBrush="{DynamicResource ListBorderBrush}"
                                  FontFamily="Consolas"
                                  FontSize="12"
                                  SelectedItemChanged="SearchResultsTreeView_SelectedItemChanged">
                            <TreeView.Resources>
                                <Style TargetType="{x:Type TreeViewItem}">
                                    <Setter Property="Foreground" Value="{DynamicResource ListForegroundBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource ListBackgroundBrush}"/>
                                </Style>
                            </TreeView.Resources>
                        </TreeView>
                    </Grid>

                    <!-- Web UI Panel -->
                    <Grid x:Name="WebUIPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WebUiUrlTextBox" Grid.Column="0" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Go" Click="WebUiGoButton_Click" Padding="10,4"/>
                                <Button Grid.Column="2" Content="Open External" Click="WebUiOpenExternalButton_Click" Padding="10,4" Margin="8,0,0,0"/>
                                <Button x:Name="WebUiMaximizeButton" Grid.Column="3" Content="Maximize" Click="WebUiMaximizeButton_Click" Padding="10,4" Margin="8,0,0,0"
                                        ToolTip="Show web preview across the entire IDE client area (Shift+F6)"/>
                                <Button x:Name="WebUiResetButton" Grid.Column="4" Content="Reset" Click="WebUiResetButton_Click" Padding="10,4" Margin="8,0,0,0"
                                        ToolTip="Clear the web preview to an empty page"/>
                            </Grid>
                        </Border>

                        <wv2:WebView2 x:Name="WebUiWebView" Grid.Row="1"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border x:Name="StatusBar"
                Grid.Row="3"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,0"
                Height="28">
            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusDiagnosticsText"
                               Text="No problems"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="ThemeComboBox"
                              Style="{StaticResource ToolbarComboBox}"
                              Width="148"
                              VerticalAlignment="Center"
                              SelectionChanged="ThemeComboBox_SelectionChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusModeText"
                               Text="Interpreter"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusCaretText"
                               Text="Ln 1, Col 1"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="StatusPathText"
                               Text=""
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>
        
        <!-- Model Loading Progress Overlay -->
        <Border x:Name="ModelLoadingOverlay"
                Grid.Row="2"
                Background="#80000000"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Padding="12"
                Margin="0,0,0,0">
            <Border Background="{DynamicResource ListBackgroundBrush}"
                    CornerRadius="4"
                    Padding="12"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="ModelLoadingText"
                               Text="Loading model..."
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource TextForegroundBrush}"/>
                    <ProgressBar x:Name="ModelLoadingProgressBar"
                                 Height="20"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 IsIndeterminate="False"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
