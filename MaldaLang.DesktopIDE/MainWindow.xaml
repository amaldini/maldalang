<Window x:Class="MaldaLang.DesktopIDE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:MaldaLang.DesktopIDE.UserControls"
        xmlns:converters="clr-namespace:MaldaLang.DesktopIDE.Converters"
        xmlns:ide="clr-namespace:MaldaLang.IDE.Models;assembly=malda"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="MALDA: The AI-First Programming Language - IDE" Height="800" Width="1200"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <converters:AddOneConverter x:Key="AddOneConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        
        <!-- Theme Color Resources -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="MainBackgroundBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="EditorForegroundBrush" Color="#212121"/>
        <SolidColorBrush x:Key="EditorLineNumbersBrush" Color="#757575"/>
        <SolidColorBrush x:Key="TextForegroundBrush" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#757575"/>
        <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#212121"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#B0B0B0"/>
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#808080"/>
        <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#2196F3"/>
        <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="PrimaryButtonHoverBorderBrush" Color="#1565C0"/>
        <SolidColorBrush x:Key="TabBackgroundBrush" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TabForegroundBrush" Color="#212121"/>
        <SolidColorBrush x:Key="TabHoverBrush" Color="#D8D8D8"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputForegroundBrush" Color="#212121"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#B0B0B0"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="GridSplitterBackgroundBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="ListBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ListForegroundBrush" Color="#212121"/>
        <SolidColorBrush x:Key="ListBorderBrush" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="DebugAccentBrush" Color="#2196F3"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#d32f2f"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#ffc107"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#2196F3"/>
        <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#B0B0B0"/>
        <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#808080"/>
        <SolidColorBrush x:Key="ScrollBarButtonBrush" Color="#C0C0C0"/>
        
        <Style x:Key="AutofixButton" TargetType="Button">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource ScrollBarTrackBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="GridRoot" Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition MaxHeight="18"/>
                                <RowDefinition Height="0.00001*"/>
                                <RowDefinition MaxHeight="18"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="BackTrack" 
                                    Grid.Row="1" 
                                    Background="{DynamicResource ScrollBarTrackBrush}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"/>
                            <Track x:Name="PART_Track" 
                                   Grid.Row="1" 
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" 
                                                  Background="Transparent"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" 
                                                  Background="Transparent"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" 
                                           Background="{DynamicResource ScrollBarThumbBrush}"
                                           BorderBrush="Transparent"
                                           BorderThickness="1">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBorder"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="2"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBorder" 
                                                                            Property="Background" 
                                                                            Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBorder" 
                                                                            Property="Background" 
                                                                            Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                            <RepeatButton x:Name="PART_LineUpButton" 
                                         Command="ScrollBar.LineUpCommand" 
                                         Background="{DynamicResource ScrollBarButtonBrush}"
                                         BorderBrush="Transparent"
                                         Focusable="False"
                                         Grid.Row="0">
                                <RepeatButton.Style>
                                    <Style TargetType="RepeatButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="1">
                                                        <Path x:Name="Arrow" 
                                                              Data="M 0 4 L 8 4 L 4 0 Z" 
                                                              Fill="{DynamicResource TextForegroundBrush}" 
                                                              HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ButtonBorder" 
                                                                    Property="Background" 
                                                                    Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="ButtonBorder" 
                                                                    Property="Background" 
                                                                    Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RepeatButton.Style>
                            </RepeatButton>
                            <RepeatButton x:Name="PART_LineDownButton" 
                                         Command="ScrollBar.LineDownCommand" 
                                         Background="{DynamicResource ScrollBarButtonBrush}"
                                         BorderBrush="Transparent"
                                         Focusable="False"
                                         Grid.Row="2">
                                <RepeatButton.Style>
                                    <Style TargetType="RepeatButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="1">
                                                        <Path x:Name="Arrow" 
                                                              Data="M 0 0 L 4 4 L 8 0 Z" 
                                                              Fill="{DynamicResource TextForegroundBrush}" 
                                                              HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ButtonBorder" 
                                                                    Property="Background" 
                                                                    Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="ButtonBorder" 
                                                                    Property="Background" 
                                                                    Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RepeatButton.Style>
                            </RepeatButton>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="GridRoot" Property="LayoutTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryButtonHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="TabButtonStyle">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="{DynamicResource TabBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TabForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4,4,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{DynamicResource ListBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ListForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ListBorderBrush}"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource ListForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ListBackgroundBrush}"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TabForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local"
                              SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel"
                                      Grid.Row="0"
                                      IsItemsHost="True"
                                      Background="Transparent"
                                      Margin="0,0,0,-1"
                                      Panel.ZIndex="1"/>
                            <Border x:Name="ContentPanel"
                                    Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="0,4,4,4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TabForegroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource TabBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4,4,0,0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Menu Styles (moved to Window.Resources for better theme integration) -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource ToolbarBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
        </Style>
        <!-- MenuItem Style -->
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Height" Value="1"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Menu Bar -->
        <Menu x:Name="MainMenu" Grid.Row="0" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1">
            
            <!-- File Menu -->
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="FileNew_Click" InputGestureText="Ctrl+N">
                    <MenuItem.Icon>
                        <TextBlock Text="📄" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Open..." Click="FileOpen_Click" InputGestureText="Ctrl+O">
                    <MenuItem.Icon>
                        <TextBlock Text="📂" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Save" Click="FileSave_Click" InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <TextBlock Text="💾" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Close _Others" Click="FileCloseOthers_Click"/>
                <MenuItem Header="Close _All" Click="FileCloseAll_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="FileExit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            
            <!-- Edit Menu -->
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Click="EditUndo_Click" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo" Click="EditRedo_Click" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="Cu_t" Click="EditCut_Click" InputGestureText="Ctrl+X"/>
                <MenuItem Header="_Copy" Click="EditCopy_Click" InputGestureText="Ctrl+C"/>
                <MenuItem Header="_Paste" Click="EditPaste_Click" InputGestureText="Ctrl+V"/>
                <Separator/>
                <MenuItem Header="Select _All" Click="EditSelectAll_Click" InputGestureText="Ctrl+A"/>
                <MenuItem Header="_Find..." Click="EditFind_Click" InputGestureText="Ctrl+F"/>
                <MenuItem Header="Format _Document" Click="EditFormatDocument_Click" InputGestureText="Ctrl+Alt+F"/>
                <MenuItem Header="_Rename Symbol..." Click="NavigateRenameSymbol_Click" InputGestureText="Ctrl+Alt+R"/>
            </MenuItem>

            <MenuItem Header="_Navigate">
                <MenuItem Header="Go to _Definition" Click="NavigateGoToDefinition_Click" InputGestureText="F12"/>
                <MenuItem Header="Find _References" Click="NavigateFindReferences_Click" InputGestureText="Shift+F12"/>
                <MenuItem Header="Go to _Symbol..." Click="NavigateGoToSymbol_Click" InputGestureText="Ctrl+T"/>
                <MenuItem Header="_Rename Symbol..." Click="NavigateRenameSymbol_Click" InputGestureText="Ctrl+Alt+R"/>
            </MenuItem>
            
            <!-- View Menu -->
            <MenuItem Header="_View">
                <MenuItem Header="_Theme">
                    <MenuItem Header="Light" Click="ViewThemeLight_Click"/>
                    <MenuItem Header="Dark" Click="ViewThemeDark_Click"/>
                    <MenuItem Header="High Contrast" Click="ViewThemeHighContrast_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Show S_yntax Panel" IsCheckable="True" IsChecked="True" Click="ViewToggleSyntaxPanel_Click"/>
                <MenuItem Header="Show _Output Panel" IsCheckable="True" IsChecked="True" Click="ViewToggleOutputPanel_Click"/>
                <MenuItem Header="Show _Debug Panel" IsCheckable="True" Click="ViewToggleDebugPanel_Click"/>
                <MenuItem Header="Show _Tool Calls Panel" IsCheckable="True" Click="ViewToggleToolCallsPanel_Click"/>
                <MenuItem Header="Show _Errors Panel" IsCheckable="True" Click="ViewToggleErrorsPanel_Click"/>
                <MenuItem Header="Show _Search Panel" IsCheckable="True" Click="ViewToggleSearchPanel_Click"/>
                <MenuItem Header="Show _AI Panel" IsCheckable="True" Click="ViewToggleAIPanel_Click"/>
                <MenuItem Header="Show _Web UI Panel" IsCheckable="True" Click="ViewToggleWebUIPanel_Click"/>
                <Separator/>
                <MenuItem Header="_Type Errors as Errors" IsCheckable="True" IsChecked="True" Click="ViewToggleTypeErrors_Click"
                          ToolTip="When checked, type-hint mismatches are Errors. Uncheck for Warning/Info (lenient)."/>
                <Separator/>
                <MenuItem Header="Open _Trace..." Click="ViewOpenTrace_Click"/>
            </MenuItem>
            
            <!-- Run Menu -->
            <MenuItem Header="_Run">
                <MenuItem Header="_Run" Click="RunButton_Click" InputGestureText="F5">
                    <MenuItem.Icon>
                        <TextBlock Text="▶" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Debug" Click="DebugButton_Click" InputGestureText="F9">
                    <MenuItem.Icon>
                        <TextBlock Text="🐛" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Stop" Click="StopButton_Click" InputGestureText="Shift+F5">
                    <MenuItem.Icon>
                        <TextBlock Text="⏹" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Reload Open Files" Click="ReloadOpenFilesButton_Click" InputGestureText="Ctrl+Shift+R">
                    <MenuItem.Icon>
                        <TextBlock Text="↻" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Compile" Click="CompileButton_Click" InputGestureText="Ctrl+Shift+B">
                    <MenuItem.Icon>
                        <TextBlock Text="⚙" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Preview _Web" Click="PreviewWebButton_Click" InputGestureText="F6">
                    <MenuItem.Icon>
                        <TextBlock Text="🌐" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            
            <!-- Debug Menu -->
            <MenuItem Header="_Debug">
                <MenuItem Header="_Continue" Click="ContinueButton_Click" InputGestureText="F5">
                    <MenuItem.Icon>
                        <TextBlock Text="▶" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Step _Over" Click="StepOverButton_Click" InputGestureText="F10">
                    <MenuItem.Icon>
                        <TextBlock Text="⏭" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Step _Into" Click="StepIntoButton_Click" InputGestureText="F11">
                    <MenuItem.Icon>
                        <TextBlock Text="⬇" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Step O_ut" Click="StepOutButton_Click" InputGestureText="Shift+F11">
                    <MenuItem.Icon>
                        <TextBlock Text="⬆" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Pause" Click="PauseButton_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="⏸" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Toggle _Breakpoint" Click="DebugToggleBreakpoint_Click" InputGestureText="F9"/>
                <MenuItem Header="Clear All _Breakpoints" Click="DebugClearBreakpoints_Click"/>
            </MenuItem>
            
            <!-- Tools Menu -->
            <MenuItem Header="_Tools">
                <MenuItem Header="_Browse Models..." Click="ToolsBrowseModels_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📦" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Package _Manager..." Click="ToolsPackageManager_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📚" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Configure _MCP Servers..." Click="ToolsConfigureMCPServers_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🔌" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Load Example..." Click="ToolsLoadExample_Click"/>
                <MenuItem Header="_Clear Output" Click="ClearOutputButton_Click"/>
                <Separator/>
                <MenuItem Header="Show _Tool Calls" Click="ToolCallsTabButton_Click"/>
                <MenuItem Header="Show _AI Chat" Click="AITabButton_Click"/>
            </MenuItem>
            
            <!-- Help Menu -->
            <MenuItem Header="_Help">
                <MenuItem Header="_About..." Click="HelpAbout_Click"/>
                <MenuItem Header="_Reference Manual" Click="HelpReferenceManual_Click"/>
                <MenuItem Header="_Documentation" Click="HelpDocumentation_Click"/>
                <MenuItem Header="_Keyboard Shortcuts" Click="HelpShortcuts_Click"/>
            </MenuItem>
        </Menu>
        
        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RunButton" Content="Run" Style="{StaticResource PrimaryButton}" Click="RunButton_Click"/>
                <Button x:Name="DebugButton" Content="Debug" Click="DebugButton_Click"/>
                <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click"/>
                <Button x:Name="ReloadOpenFilesButton" Content="Reload Files" Click="ReloadOpenFilesButton_Click" ToolTip="Stop execution and reload all opened files from disk (Ctrl+Shift+R)"/>
                <Button Content="Compile" Click="CompileButton_Click"/>
                <Button x:Name="PreviewWebButton" Content="Preview Web" Click="PreviewWebButton_Click" ToolTip="Transpile the current MALDA web file and open it in the built-in browser (F6)"/>
                
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0"/>
                
                <Button x:Name="ContinueButton" Content="▶ Continue" Click="ContinueButton_Click" ToolTip="Continue (F5)"/>
                <Button x:Name="StepOverButton" Content="⏭ Step Over" Click="StepOverButton_Click" ToolTip="Step Over (F10)"/>
                <Button x:Name="StepIntoButton" Content="⬇ Step Into" Click="StepIntoButton_Click" ToolTip="Step Into (F11)"/>
                <Button x:Name="StepOutButton" Content="⬆ Step Out" Click="StepOutButton_Click" ToolTip="Step Out (Shift+F11)"/>
                <Button x:Name="PauseButton" Content="⏸ Pause" Click="PauseButton_Click"/>
                
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0"/>
                
                <Button Content="Browse Examples..." Click="BrowseExamplesButton_Click" Margin="4,0"/>
                
                <Button Content="Clear Output" Click="ClearOutputButton_Click"/>
                <Button Content="Save" Click="SaveButton_Click"/>
                <Button Content="Load" Click="LoadButton_Click"/>
                
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0"/>
                
                <Button x:Name="AutofixErrorsButton" Content="🔧 Autofix Errors" Click="AutofixErrorsButton_Click" 
                        ToolTip="Auto-fix parser errors (missing characters)"/>
                
                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,0"/>
                
                <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="4,0,4,0" Foreground="{DynamicResource TextForegroundBrush}"/>
                <ComboBox x:Name="ThemeComboBox" Width="150" Margin="4,0" SelectionChanged="ThemeComboBox_SelectionChanged"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SyntaxPanelColumn" Width="280" MinWidth="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300" MinWidth="250"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Syntax Panel -->
            <Border x:Name="SyntaxPanel"
                    Grid.Column="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Background="{DynamicResource SidebarBackgroundBrush}">
                <TabControl Margin="8"
                            Background="{DynamicResource SidebarBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}">
                    <TabItem Header="Syntax">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Syntax Helper" FontWeight="Bold" Margin="0,0,0,6"/>

                            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                <TextBox x:Name="SyntaxSearchTextBox"
                                         Margin="0,0,0,6"
                                         ToolTip="Search syntax snippets"
                                         TextChanged="SyntaxSearchTextBox_TextChanged"/>
                                <ComboBox x:Name="SyntaxCategoryComboBox"
                                          SelectionChanged="SyntaxCategoryComboBox_SelectionChanged"/>
                            </StackPanel>

                            <ListBox x:Name="SyntaxSnippetsListBox"
                                     Grid.Row="2"
                                     Background="{DynamicResource ListBackgroundBrush}"
                                     Foreground="{DynamicResource ListForegroundBrush}"
                                     BorderBrush="{DynamicResource ListBorderBrush}"
                                     FontSize="11"
                                     MouseDoubleClick="SyntaxSnippetsListBox_MouseDoubleClick"
                                     SelectionChanged="SyntaxSnippetsListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                                                <TextBlock Text="{Binding Preview}" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button x:Name="InsertSyntaxButton"
                                    Grid.Row="3"
                                    Content="Insert Snippet"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,8,0,0"
                                    Click="InsertSyntaxButton_Click"
                                    IsEnabled="False"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Outline">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Document Outline" FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBox x:Name="OutlineSearchTextBox"
                                     Grid.Row="1"
                                     Margin="0,0,0,8"
                                     ToolTip="Filter symbols in current document"
                                     TextChanged="OutlineSearchTextBox_TextChanged"/>
                            <TreeView x:Name="OutlineTreeView"
                                      Grid.Row="2"
                                      Background="{DynamicResource ListBackgroundBrush}"
                                      Foreground="{DynamicResource ListForegroundBrush}"
                                      BorderBrush="{DynamicResource ListBorderBrush}"
                                      FontSize="11"
                                      SelectedItemChanged="OutlineTreeView_SelectedItemChanged"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- GridSplitter for resizing left panel -->
            <GridSplitter x:Name="SyntaxPanelSplitter"
                         Grid.Column="1"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         Background="{DynamicResource GridSplitterBackgroundBrush}"
                         Width="5"
                         ResizeBehavior="PreviousAndNext"
                         ShowsPreview="True"/>

            <!-- Editor Panel -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource TabBackgroundBrush}">
                        <WrapPanel x:Name="DocumentTabsPanel" Orientation="Horizontal"/>
                    </ScrollViewer>

                    <Border x:Name="LearningBranchBanner"
                            Grid.Row="1"
                            Background="{DynamicResource TabBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,10"
                            Visibility="Collapsed">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Width="28"
                                    Height="28"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Padding="0"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Content="×"
                                    ToolTip="Hide starter header"
                                    Click="CloseLearningBranchBanner_Click"/>
                            <StackPanel DockPanel.Dock="Left" Margin="0,0,16,0">
                                <TextBlock x:Name="LearningBranchTitleTextBlock"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextForegroundBrush}" />
                                <TextBlock x:Name="LearningBranchDescriptionTextBlock"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <WrapPanel x:Name="LearningBranchButtonsPanel"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <avalon:TextEditor Grid.Row="2"
                                       x:Name="CodeEditor"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       ShowLineNumbers="True"
                                       SyntaxHighlighting="CSharp"
                                       Background="{DynamicResource EditorBackgroundBrush}"
                                       Foreground="{DynamicResource EditorForegroundBrush}"
                                       LineNumbersForeground="{DynamicResource EditorLineNumbersBrush}"
                                       MouseDoubleClick="CodeEditor_MouseDoubleClick"/>
                </Grid>
            </Border>
            
            <!-- GridSplitter for resizing right sidebar -->
            <GridSplitter Grid.Column="3" 
                         HorizontalAlignment="Stretch" 
                         VerticalAlignment="Stretch"
                         Background="{DynamicResource GridSplitterBackgroundBrush}"
                         Width="5"
                         ResizeBehavior="PreviousAndNext"
                         ShowsPreview="True"/>
            
            <!-- Sidebar -->
            <Grid Grid.Column="4" Background="{DynamicResource SidebarBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Tabs -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Background="{DynamicResource TabBackgroundBrush}">
                    <Button x:Name="OutputTabButton" Content="Output" Click="OutputTabButton_Click" 
                            Style="{StaticResource TabButtonStyle}"/>
                    <Button x:Name="DebugTabButton" Content="Debug" Click="DebugTabButton_Click"
                            Style="{StaticResource TabButtonStyle}"/>
                    <Button x:Name="ToolCallsTabButton" Content="Tool Calls" Click="ToolCallsTabButton_Click"
                            Style="{StaticResource TabButtonStyle}"/>
                    <Button x:Name="ErrorsTabButton" Content="Errors" Click="ErrorsTabButton_Click"
                            Style="{StaticResource TabButtonStyle}"/>
                    <Button x:Name="SearchTabButton" Content="Search" Click="SearchTabButton_Click"
                            Style="{StaticResource TabButtonStyle}"/>
                    <Button x:Name="AITabButton" Content="AI" Click="AITabButton_Click"
                            Style="{StaticResource TabButtonStyle}"/>
                    <Button x:Name="WebUITabButton" Content="Web UI" Click="WebUITabButton_Click"
                            Style="{StaticResource TabButtonStyle}"/>
                </StackPanel>
                
                <!-- Tab Content -->
                <Grid Grid.Row="1">
                    <!-- Output Panel -->
                    <Grid x:Name="OutputPanel" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="RegressionActionBar"
                                Grid.Row="0"
                                Visibility="Collapsed"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="8,6">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CreateRegressionButton"
                                        Content="Create Regression"
                                        Click="CreateRegressionButton_Click"
                                        Padding="8,4"/>
                                <TextBlock x:Name="RegressionHintTextBlock"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        
                        <WebBrowser x:Name="OutputWebBrowser" 
                                    Grid.Row="1"/>
                        
                        <Border Grid.Row="2" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Program Input (one value per line):" Margin="0,0,0,4" FontSize="11"/>
                                <TextBox x:Name="ProgramInputTextBox" 
                                         Grid.Row="1"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="60"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Background="{DynamicResource InputBackgroundBrush}"
                                         Foreground="{DynamicResource InputForegroundBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}"/>
                            </Grid>
                        </Border>
                    </Grid>
                    
                    <!-- Debug Panel -->
                    <Grid x:Name="DebugPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="Call Stack" FontWeight="Bold" Margin="8,8,8,4" Foreground="{DynamicResource DebugAccentBrush}" FontSize="11"/>
                        <ListBox x:Name="CallStackListBox" Grid.Row="1" Background="{DynamicResource ListBackgroundBrush}" BorderBrush="{DynamicResource ListBorderBrush}" Margin="8,0,8,8"
                                 Foreground="{DynamicResource ListForegroundBrush}" FontFamily="Consolas" FontSize="11"/>
                        
                        <TextBlock Grid.Row="2" Text="Variables" FontWeight="Bold" Margin="8,8,8,4" Foreground="{DynamicResource DebugAccentBrush}" FontSize="11"/>
                        <ListBox x:Name="VariablesListBox" Grid.Row="3" Background="{DynamicResource ListBackgroundBrush}" BorderBrush="{DynamicResource ListBorderBrush}" Margin="8,0,8,8"
                                 Foreground="{DynamicResource ListForegroundBrush}" FontFamily="Consolas" FontSize="11"/>
                        
                        <TextBlock Grid.Row="4" Text="Breakpoints" FontWeight="Bold" Margin="8,8,8,4" Foreground="{DynamicResource DebugAccentBrush}" FontSize="11"/>
                        <ListBox x:Name="BreakpointsListBox" Grid.Row="5" Background="{DynamicResource ListBackgroundBrush}" BorderBrush="{DynamicResource ListBorderBrush}" Margin="8,0,8,8"
                                 Foreground="{DynamicResource ListForegroundBrush}" FontFamily="Consolas" FontSize="11"/>
                    </Grid>
                    
                    <!-- Tool Calls Panel -->
                    <Grid x:Name="ToolCallsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8">
                            <Button Content="Clear Log" Click="ClearToolCallsButton_Click" HorizontalAlignment="Right" Padding="8,4"/>
                        </Border>
                        <WebBrowser x:Name="ToolCallsWebBrowser" Grid.Row="1"/>
                    </Grid>
                    
                    <!-- Errors Panel -->
                    <Grid x:Name="ErrorsPanel" Visibility="Collapsed">
                        <ListBox x:Name="ErrorsListBox" 
                                 Background="{DynamicResource ListBackgroundBrush}"
                                 Foreground="{DynamicResource ListForegroundBrush}"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 SelectionChanged="ErrorsListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Error icon and message -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock x:Name="IconTextBlock" Margin="0,0,4,0"/>
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="Line "/>
                                                <Run Text="{Binding Line, Converter={StaticResource AddOneConverter}}"/>
                                                <Run Text=", Col "/>
                                                <Run Text="{Binding Column, Converter={StaticResource AddOneConverter}}"/>
                                                <Run Text=": "/>
                                                <Run Text="{Binding Message}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        
                                        <!-- Fix button (if available) -->
                                        <Button Grid.Column="1" 
                                                Content="🔧 Fix" 
                                                Padding="4,2"
                                                Margin="8,0,0,0"
                                                FontSize="11"
                                                ToolTip="Click to apply autofix for this error"
                                                Click="ErrorFixButton_Click"
                                                Tag="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#2196F3"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Visibility" Value="{Binding AutoFix, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                        CornerRadius="3" 
                                                                        Padding="4,2">
                                                                    <ContentPresenter HorizontalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1976D2"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static ide:DiagnosticSeverity.Error}">
                                            <Setter TargetName="IconTextBlock" Property="Text" Value="✕"/>
                                            <Setter TargetName="IconTextBlock" Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static ide:DiagnosticSeverity.Warning}">
                                            <Setter TargetName="IconTextBlock" Property="Text" Value="⚠"/>
                                            <Setter TargetName="IconTextBlock" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="{x:Static ide:DiagnosticSeverity.Info}">
                                            <Setter TargetName="IconTextBlock" Property="Text" Value="ℹ"/>
                                            <Setter TargetName="IconTextBlock" Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    
                    <!-- AI Chat Panel -->
                    <Grid x:Name="AIChatPanel" Visibility="Collapsed">
                        <local:AIChatPanel x:Name="AIChatPanelControl"/>
                    </Grid>

                    <!-- Search Panel -->
                    <Grid x:Name="SearchPanel" Visibility="Collapsed" Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="SearchTextBox"
                                 Grid.Row="0"
                                 Margin="0,0,0,6"
                                 ToolTip="Enter text or regex pattern"
                                 KeyDown="SearchTextBox_KeyDown"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox x:Name="SearchRegexCheckBox" Content="Regex" VerticalAlignment="Center" Foreground="{DynamicResource TextForegroundBrush}"/>
                            <CheckBox x:Name="SearchMatchCaseCheckBox" Content="Match case" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextForegroundBrush}"/>
                            <CheckBox x:Name="SearchCurrentDocumentOnlyCheckBox" Content="Current doc only" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextForegroundBrush}"/>
                            <Button x:Name="SearchFindAllButton" Content="Find All" Click="SearchFindAllButton_Click" Margin="8,0,0,0" Padding="10,4"/>
                            <Button x:Name="SearchPrevButton" Content="Previous" Click="SearchPrevButton_Click" Margin="8,0,0,0" Padding="10,4"/>
                            <Button x:Name="SearchNextButton" Content="Next" Click="SearchNextButton_Click" Margin="4,0,0,0" Padding="10,4"/>
                        </StackPanel>

                        <TextBlock x:Name="SearchSummaryTextBlock" Grid.Row="2" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <TreeView x:Name="SearchResultsTreeView"
                                  Grid.Row="3"
                                  Background="{DynamicResource ListBackgroundBrush}"
                                  Foreground="{DynamicResource ListForegroundBrush}"
                                  BorderBrush="{DynamicResource ListBorderBrush}"
                                  FontFamily="Consolas"
                                  FontSize="11"
                                  SelectedItemChanged="SearchResultsTreeView_SelectedItemChanged">
                            <TreeView.Resources>
                                <Style TargetType="{x:Type TreeViewItem}">
                                    <Setter Property="Foreground" Value="{DynamicResource ListForegroundBrush}"/>
                                    <Setter Property="Background" Value="{DynamicResource ListBackgroundBrush}"/>
                                </Style>
                            </TreeView.Resources>
                        </TreeView>
                    </Grid>

                    <!-- Web UI Panel -->
                    <Grid x:Name="WebUIPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WebUiUrlTextBox" Grid.Column="0" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Content="Go" Click="WebUiGoButton_Click" Padding="10,4"/>
                                <Button Grid.Column="2" Content="Open External" Click="WebUiOpenExternalButton_Click" Padding="10,4"/>
                            </Grid>
                        </Border>

                        <wv2:WebView2 x:Name="WebUiWebView" Grid.Row="1"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        
        <!-- Model Loading Progress Overlay -->
        <Border x:Name="ModelLoadingOverlay"
                Grid.Row="2"
                Background="#80000000"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Padding="12"
                Margin="0,0,0,0">
            <Border Background="{DynamicResource ListBackgroundBrush}"
                    CornerRadius="4"
                    Padding="12"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="ModelLoadingText"
                               Text="Loading model..."
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource TextForegroundBrush}"/>
                    <ProgressBar x:Name="ModelLoadingProgressBar"
                                 Height="20"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 IsIndeterminate="False"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
