<Window x:Class="MaldaLang.DesktopIDE.Windows.ModelSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Select Model" Height="500" Width="600"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconPackage}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Select a Local Model" Style="{StaticResource DialogHeader}" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource DialogPanel}">
            <Grid>
                <ListBox x:Name="ModelsListBox"
                         Background="Transparent"
                         Foreground="{DynamicResource ListForegroundBrush}"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding FileName}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextForegroundBrush}"/>
                                    <TextBlock Text="{Binding Path}"
                                               FontSize="10"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="10"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{Binding Size, StringFormat='{}{0:N0} bytes'}"/>
                                        <Run Text=" • Downloaded: "/>
                                        <Run Text="{Binding DownloadedAt, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="NoModelsTextBlock"
                           Text="No local models installed.&#x0a;Use Tools → Browse Models to download models."
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,14,0,0">
            <RadioButton x:Name="UseLocalModelRadioButton"
                         Content="Use Local Model"
                         Margin="0,0,16,0"
                         Checked="UseLocalModelRadioButton_Checked"/>
            <RadioButton x:Name="UseOpenRouterRadioButton"
                         Content="Use OpenRouter (Online)"
                         Checked="UseOpenRouterRadioButton_Checked"/>
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancel"
                    Click="CancelButton_Click"
                    Margin="0,0,8,0"
                    MinWidth="88"/>
            <Button x:Name="SelectButton"
                    Content="Select"
                    Click="SelectButton_Click"
                    MinWidth="88"
                    IsEnabled="False"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
