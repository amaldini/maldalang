<Window x:Class="MaldaLang.DesktopIDE.Windows.ModelBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Model Browser" Height="700" Width="1000"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <!-- Button Styles matching MainWindow -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ButtonHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryButtonHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="ErrorButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <!-- TextBlock Style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Browse and Download LLM Models"
                   FontSize="18" 
                   FontWeight="Bold"
                   Margin="0,0,0,12"
                   Foreground="{DynamicResource TextForegroundBrush}"/>

        <!-- Search and Filter -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     TextChanged="SearchTextBox_TextChanged"
                     Padding="8,4"
                     FontSize="12"
                     Background="{DynamicResource InputBackgroundBrush}"
                     Foreground="{DynamicResource InputForegroundBrush}"
                     BorderBrush="{DynamicResource InputBorderBrush}"
                     BorderThickness="1"/>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Content="Refresh"
                    Click="RefreshButton_Click"
                    Margin="8,0,0,0"
                    Padding="12,4"
                    MinWidth="80"/>
            <Button x:Name="OpenFolderButton"
                    Grid.Column="2"
                    Content="Open Models Folder"
                    Click="OpenFolderButton_Click"
                    Margin="8,0,0,0"
                    Padding="12,4"
                    MinWidth="120"/>
        </Grid>

        <!-- Main Content: Models List and Details -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Models List -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource ListBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Available Models"
                               FontWeight="Bold"
                               Padding="8,4"
                               Background="{DynamicResource TabBackgroundBrush}"
                               Foreground="{DynamicResource TextForegroundBrush}"/>
                    <ListBox x:Name="ModelsListBox"
                             Grid.Row="1"
                             SelectionChanged="ModelsListBox_SelectionChanged"
                             Background="{DynamicResource ListBackgroundBrush}"
                             Foreground="{DynamicResource ListForegroundBrush}"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6"
                                        Margin="0,2"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding Id}"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextForegroundBrush}"/>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Author}"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    Margin="0,4,0,0">
                                            <TextBlock Text="{Binding GetFormattedSize, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text=" • "
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Downloads, StringFormat='{}{0:N0} downloads'}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="LoadingPanel"
                                 Grid.Row="1"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed">
                        <ProgressBar x:Name="LoadingProgressBar"
                                     IsIndeterminate="True"
                                     Width="300"
                                     Height="20"
                                     Margin="0,0,0,12"
                                     Foreground="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                        <TextBlock x:Name="LoadingTextBlock"
                                   Text="Loading models..."
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextForegroundBrush}"
                                   FontSize="12"/>
                        <TextBlock x:Name="LoadingStatusTextBlock"
                                   Text=""
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   MaxWidth="400"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource GridSplitterBackgroundBrush}"/>

            <!-- Model Details -->
            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource ListBackgroundBrush}"
                    Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Model Details"
                               FontWeight="Bold"
                               Padding="8,4"
                               Background="{DynamicResource TabBackgroundBrush}"
                               Foreground="{DynamicResource TextForegroundBrush}"/>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="12">
                        <StackPanel x:Name="DetailsPanel">
                            <TextBlock x:Name="DetailsTextBlock"
                                       Text="Select a model to view details"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2"
                            Padding="12"
                            Background="{DynamicResource InputBackgroundBrush}">
                        <StackPanel Orientation="Vertical">
                            <Button x:Name="DownloadButton"
                                    Content="Download Selected File"
                                    Click="DownloadButton_Click"
                                    IsEnabled="False"
                                    Padding="12,6"
                                    Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Active Downloads -->
        <Border Grid.Row="4"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource ListBackgroundBrush}"
                Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Active Downloads"
                           FontWeight="Bold"
                           Padding="8,4"
                           Background="{DynamicResource TabBackgroundBrush}"
                           Foreground="{DynamicResource TextForegroundBrush}"/>
                <ListBox x:Name="ActiveDownloadsListBox"
                         Grid.Row="1"
                         Background="{DynamicResource ListBackgroundBrush}"
                         Foreground="{DynamicResource ListForegroundBrush}"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding FileName}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextForegroundBrush}"/>
                                    <TextBlock Text="{Binding ModelId}"
                                               FontSize="10"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ProgressBar Value="{Binding Percentage}"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Height="16"
                                                 Margin="0,4,0,2"
                                                 Foreground="{DynamicResource PrimaryButtonBackgroundBrush}"/>
                                    <TextBlock Text="{Binding ProgressText}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Cancel"
                                        Click="CancelDownload_Click"
                                        Tag="{Binding ModelId}"
                                        Margin="8,0,0,0"
                                        Padding="8,4"
                                        MinWidth="60"
                                        Style="{StaticResource ErrorButton}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Installed Models -->
        <Border Grid.Row="5"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource ListBackgroundBrush}"
                Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Installed Models"
                           FontWeight="Bold"
                           Padding="8,4"
                           Background="{DynamicResource TabBackgroundBrush}"
                           Foreground="{DynamicResource TextForegroundBrush}"/>
                <ListBox x:Name="InstalledModelsListBox"
                         Grid.Row="1"
                         Background="{DynamicResource ListBackgroundBrush}"
                         Foreground="{DynamicResource ListForegroundBrush}"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding FileName}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextForegroundBrush}"/>
                                    <TextBlock Text="{Binding Path}"
                                               FontSize="10"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="10"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{Binding Size, StringFormat='{}{0:N0} bytes'}"/>
                                        <Run Text=" • Downloaded: "/>
                                        <Run Text="{Binding DownloadedAt, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Open"
                                        Click="OpenInstalledModel_Click"
                                        Tag="{Binding}"
                                        Margin="8,0,4,0"
                                        Padding="8,4"
                                        MinWidth="60"/>
                                <Button Grid.Column="2"
                                        Content="Delete"
                                        Click="DeleteInstalledModel_Click"
                                        Tag="{Binding}"
                                        Margin="4,0,0,0"
                                        Padding="8,4"
                                        MinWidth="60"
                                        Style="{StaticResource ErrorButton}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
