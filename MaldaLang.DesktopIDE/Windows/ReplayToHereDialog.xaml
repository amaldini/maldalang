<Window x:Class="MaldaLang.DesktopIDE.Windows.ReplayToHereDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Replay to Here" Height="400" Width="500"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconReload}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextForegroundBrush}">
                Restore file system state up to the selected step. Choose where to write files.
            </TextBlock>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Working directory" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="WorkingDirTextBox" Grid.Column="0" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Click="BrowseButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconFolder}"/>
                    <TextBlock Text="Browse" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
        <TextBlock Grid.Row="3" Text="Files to restore" Margin="0,14,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <Border Grid.Row="4" Style="{StaticResource DialogPanel}">
            <ListBox x:Name="FilesListBox" BorderThickness="0" Background="Transparent"
                     Foreground="{DynamicResource InputForegroundBrush}"/>
        </Border>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Click="CancelButton_Click" Margin="0,0,8,0" MinWidth="88"/>
            <Button x:Name="RestoreButton" Content="Restore" IsDefault="True" Click="RestoreButton_Click" Style="{StaticResource PrimaryButton}" MinWidth="88"/>
        </StackPanel>
    </Grid>
</Window>
