<Window x:Class="MaldaLang.DesktopIDE.Windows.ApplyingUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Updating MALDA"
        Width="420"
        Height="160"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="StatusText"
                       Text="Installing the downloaded release…"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Margin="0,0,0,12"/>
            <ProgressBar Height="16" IsIndeterminate="True"/>
        </StackPanel>
    </Grid>
</Window>
