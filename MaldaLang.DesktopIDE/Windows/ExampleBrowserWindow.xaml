<Window x:Class="MaldaLang.DesktopIDE.Windows.ExampleBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="Browse Examples" Height="700" Width="1000"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <!-- ScrollBar brushes will be set dynamically in code-behind -->
        <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#B0B0B0"/>
        <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#808080"/>
        <SolidColorBrush x:Key="ScrollBarButtonBrush" Color="#C0C0C0"/>

        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="rectangle"
                                Background="{DynamicResource ScrollBarThumbBrush}"
                                CornerRadius="3"
                                Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="rectangle" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true">
                                <Setter TargetName="rectangle" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource ScrollBarTrackBrush}"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Grid.RowDefinitions>
                                <RowDefinition MaxHeight="14"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition MaxHeight="14"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MaxWidth="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition MaxWidth="14"/>
                            </Grid.ColumnDefinitions>

                            <Track x:Name="PART_Track" Grid.Row="1" Grid.Column="1" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderBrush="Transparent"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderBrush="Transparent"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                            </Track>

                            <RepeatButton x:Name="LineUpButton" Command="ScrollBar.LineUpCommand" Grid.Row="0" Grid.Column="1">
                                <Path x:Name="LineUpPath" Data="M 0 4 L 4 0 L 8 4 Z" Fill="{DynamicResource TextForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                            </RepeatButton>
                            <RepeatButton x:Name="LineDownButton" Command="ScrollBar.LineDownCommand" Grid.Row="2" Grid.Column="1">
                                <Path x:Name="LineDownPath" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                            </RepeatButton>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="14"/>
                                <Setter TargetName="PART_Track" Property="Grid.Row" Value="1"/>
                                <Setter TargetName="PART_Track" Property="Grid.Column" Value="1"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="false"/>
                                <Setter TargetName="LineUpButton" Property="Grid.Row" Value="1"/>
                                <Setter TargetName="LineUpButton" Property="Grid.Column" Value="0"/>
                                <Setter TargetName="LineDownButton" Property="Grid.Row" Value="1"/>
                                <Setter TargetName="LineDownButton" Property="Grid.Column" Value="2"/>
                                <Setter TargetName="LineUpPath" Property="Data" Value="M 4 0 L 0 4 L 4 8 Z"/>
                                <Setter TargetName="LineDownPath" Property="Data" Value="M 0 0 L 4 4 L 0 8 Z"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconBook}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Browse Examples" Style="{StaticResource DialogHeader}" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource DialogSearchHost}">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconFind}" Margin="8,0,6,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <Button x:Name="RefreshButton" Grid.Column="1" Click="RefreshButton_Click" Margin="8,0,0,0" ToolTip="Refresh examples">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconReload}"/>
                    <TextBlock Text="Refresh" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DialogPanel}">
                <ListBox x:Name="CategoriesListBox" SelectionChanged="CategoriesListBox_SelectionChanged" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource ListForegroundBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Padding="8,6" Foreground="{DynamicResource ListForegroundBrush}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource GridSplitterBackgroundBrush}"/>

            <Border Grid.Column="2" Style="{StaticResource DialogPanel}" Margin="5,0,0,0">
                <ListBox x:Name="ExamplesListBox" SelectionChanged="ExamplesListBox_SelectionChanged" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource ListForegroundBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource ListForegroundBrush}"/>
                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="{DynamicResource GridSplitterBackgroundBrush}"/>

            <Border Grid.Column="4" Style="{StaticResource DialogPanel}" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <avalon:TextEditor x:Name="PreviewEditor" 
                                       IsReadOnly="True" 
                                       FontFamily="Consolas" 
                                       FontSize="12" 
                                       ShowLineNumbers="True" 
                                       SyntaxHighlighting="CSharp"
                                       Background="{DynamicResource EditorBackgroundBrush}"
                                       Foreground="{DynamicResource EditorForegroundBrush}"
                                       LineNumbersForeground="{DynamicResource EditorLineNumbersBrush}"/>
                    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="0,0,8,8">
                        <TextBlock x:Name="DescriptionTextBlock" Padding="12,8" TextWrapping="Wrap" Foreground="{DynamicResource TextForegroundBrush}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="LoadButton" Click="LoadButton_Click" IsEnabled="False" MinWidth="132" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IdeAccentIcon}" Data="{StaticResource IconOpen}" Stroke="{DynamicResource PrimaryButtonForegroundBrush}"/>
                    <TextBlock Text="Load Example" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click" MinWidth="88"/>
        </StackPanel>
    </Grid>
</Window>