<Window x:Class="MaldaLang.DesktopIDE.Windows.FullScreenMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Full Screen Message"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        WindowState="Maximized"
        MinWidth="600"
        MinHeight="400">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="CloseButton_Click"
                        Content="Close"
                        MinWidth="88"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconSpark}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock x:Name="TitleTextBlock"
                                   Text="AI Message"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextForegroundBrush}"/>
                        <TextBlock x:Name="SubtitleTextBlock"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Padding="16">
            <StackPanel x:Name="ContentStackPanel"
                        Orientation="Vertical"
                        Margin="0,0,0,16"
                        VerticalAlignment="Top"/>
        </ScrollViewer>
    </Grid>
</Window>

