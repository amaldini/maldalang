<UserControl x:Class="MaldaLang.DesktopIDE.Windows.IdeSplashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B181E"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             FontFamily="Segoe UI, Segoe UI Variable, sans-serif">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="1,0" EndPoint="0.15,1">
                <GradientStop Color="#164248" Offset="0"/>
                <GradientStop Color="#0B181E" Offset="0.38"/>
                <GradientStop Color="#101A22" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Rectangle Width="12" HorizontalAlignment="Left" Fill="#0E7C86"/>

        <Canvas Width="320"
                Height="250"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,48,48,0"
                IsHitTestVisible="False"
                Opacity="0.9">
            <!-- Prompt feeds three agents; the agents meet at a result. Same drawing as the manual cover. -->
            <Ellipse Canvas.Left="163" Canvas.Top="85.7" Width="81.1" Height="81.1" Stroke="#0E7C86" StrokeThickness="1" Opacity="0.22"/>
            <Ellipse Canvas.Left="181.8" Canvas.Top="104.4" Width="43.7" Height="43.7" Stroke="#2AA0AA" StrokeThickness="1.2" Opacity="0.45"/>
            <Line X1="117.8" Y1="116.1" X2="187.6" Y2="51.4" Stroke="#0E7C86" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.6"/>
            <Line X1="117.8" Y1="126.3" X2="179.4" Y2="126.3" Stroke="#0E7C86" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.6"/>
            <Line X1="117.8" Y1="136.4" X2="187.6" Y2="201.1" Stroke="#0E7C86" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.6"/>
            <Line X1="211.5" Y1="46.3" X2="263.2" Y2="109.7" Stroke="#0E7C86" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.6"/>
            <Line X1="218.4" Y1="126.3" X2="259.8" Y2="126.3" Stroke="#0E7C86" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.6"/>
            <Line X1="211.5" Y1="206.3" X2="263.2" Y2="142.9" Stroke="#0E7C86" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.6"/>
            <Polygon Points="190.3,54.3 194.4,45.1 184.9,48.5" Fill="#0E7C86" Opacity="0.9"/>
            <Polygon Points="179.4,130.2 188.8,126.3 179.4,122.3" Fill="#0E7C86" Opacity="0.9"/>
            <Polygon Points="184.9,204 194.4,207.5 190.3,198.2" Fill="#0E7C86" Opacity="0.9"/>
            <Polygon Points="260.2,112.2 269.1,116.9 266.3,107.2" Fill="#0E7C86" Opacity="0.9"/>
            <Polygon Points="259.8,130.2 269.1,126.3 259.8,122.3" Fill="#0E7C86" Opacity="0.9"/>
            <Polygon Points="266.3,145.4 269.1,135.6 260.2,140.4" Fill="#0E7C86" Opacity="0.9"/>
            <Rectangle Canvas.Left="32" Canvas.Top="103.7" Width="81.1" Height="45.2" RadiusX="10.9" RadiusY="10.9" Stroke="#2AA0AA" StrokeThickness="1.4">
                <Rectangle.Fill><SolidColorBrush Color="#0E7C86" Opacity="0.12"/></Rectangle.Fill>
            </Rectangle>
            <Ellipse Canvas.Left="194.2" Canvas.Top="27.2" Width="18.7" Height="18.7" Fill="#0E7C86" Opacity="0.85"/>
            <Ellipse Canvas.Left="191.9" Canvas.Top="114.6" Width="23.4" Height="23.4" Fill="#0E7C86"/>
            <Ellipse Canvas.Left="194.2" Canvas.Top="206.6" Width="18.7" Height="18.7" Fill="#0E7C86" Opacity="0.85"/>
            <Rectangle Canvas.Left="273.8" Canvas.Top="110.7" Width="31.2" Height="31.2" Stroke="#0E7C86" StrokeThickness="1.4">
                <Rectangle.Fill><SolidColorBrush Color="#0E7C86" Opacity="0.16"/></Rectangle.Fill>
            </Rectangle>
        </Canvas>

        <StackPanel VerticalAlignment="Center" Margin="84,0,340,0">
            <TextBlock FontSize="72" FontWeight="Bold" Foreground="#F4FBFC">
                <Run Text="MALDA"/><Run Text="™" FontSize="22" BaselineAlignment="Top"/>
            </TextBlock>
            <TextBlock Text="Desktop IDE"
                       FontSize="28"
                       FontWeight="Medium"
                       Foreground="#C5D4D8"
                       Margin="0,4,0,0"/>
            <Rectangle Width="72" Height="4" Fill="#0E7C86" HorizontalAlignment="Left" Margin="0,18,0,18"/>
            <TextBlock Text="The AI-First Programming Language"
                       FontSize="16"
                       Foreground="#8AA3A8"/>
            <TextBlock Text="Multi Agent Language with Development Automation"
                       FontSize="16"
                       Foreground="#8AA3A8"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock x:Name="VersionText"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   Margin="84,0,0,32"
                   FontSize="14"
                   Foreground="#6E868C"/>
        <TextBlock x:Name="StatusText"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Right"
                   Margin="0,0,40,32"
                   FontSize="14"
                   Foreground="#8AA3A8"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
