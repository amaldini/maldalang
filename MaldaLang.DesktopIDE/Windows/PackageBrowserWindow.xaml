<Window x:Class="MaldaLang.DesktopIDE.Windows.PackageBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Package Manager" Height="600" Width="800"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource ListBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ListForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{DynamicResource ListBackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource EditorBackgroundBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource TabBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource ListBackgroundBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource EditorSelection}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource EditorSelection}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource ListForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconPackage}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Package Manager" Style="{StaticResource DialogHeader}" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource DialogSearchHost}" Margin="0,0,8,0">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Style="{StaticResource IdeMenuIcon}" Data="{StaticResource IconFind}" Margin="8,0,6,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <Button Grid.Column="1" Click="SearchButton_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconFind}"/>
                    <TextBlock Text="Search" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconReload}"/>
                    <TextBlock Text="Refresh" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource DialogPanel}">
            <DataGrid x:Name="PackagesDataGrid" 
                      AutoGenerateColumns="False" 
                      SelectionMode="Single"
                      SelectionChanged="PackagesDataGrid_SelectionChanged"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource ListForegroundBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Package Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Click="InstallButton_Click" Margin="0,0,8,0" MinWidth="100" Style="{StaticResource PrimaryButton}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IdeAccentIcon}" Data="{StaticResource IconDownload}" Stroke="{DynamicResource PrimaryButtonForegroundBrush}"/>
                    <TextBlock Text="Install" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Click="UninstallButton_Click" Margin="0,0,8,0" MinWidth="100" Style="{StaticResource ErrorButton}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IdeIcon}" Data="{StaticResource IconTrash}" Stroke="{DynamicResource PrimaryButtonForegroundBrush}"/>
                    <TextBlock Text="Uninstall" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Content="Close" Click="CloseButton_Click" MinWidth="88"/>
        </StackPanel>
    </Grid>
</Window>
