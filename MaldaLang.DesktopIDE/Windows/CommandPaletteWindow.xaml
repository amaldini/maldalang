<Window x:Class="MaldaLang.DesktopIDE.Windows.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Palette"
        Width="560"
        Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextForegroundBrush}"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="FilterTextBox"
                 FontSize="14"
                 Padding="8,6"
                 Background="{DynamicResource InputBackgroundBrush}"
                 Foreground="{DynamicResource InputForegroundBrush}"
                 BorderBrush="{DynamicResource InputBorderBrush}"
                 TextChanged="FilterTextBox_TextChanged"
                 PreviewKeyDown="FilterTextBox_PreviewKeyDown"/>
        <ListBox x:Name="CommandList"
                 Grid.Row="1"
                 Margin="0,10,0,0"
                 FontSize="13"
                 BorderThickness="0"
                 Background="{DynamicResource ListBackgroundBrush}"
                 Foreground="{DynamicResource ListForegroundBrush}"
                 MouseDoubleClick="CommandList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2,4">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding Shortcut}"
                                   Margin="16,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Title}"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
