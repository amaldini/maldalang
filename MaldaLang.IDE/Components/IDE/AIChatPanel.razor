@using MaldaLang.IDE.Models
@using MaldaLang.IDE.Services
@using Markdig
@inject AIChatService AIChatService
@inject CodeDiffService CodeDiffService

<div class="ai-chat-panel">
    <div class="chat-messages" @ref="messagesContainer">
        @if (messages.Count == 0)
        {
            <div class="chat-welcome">
                <h3>AI Assistant</h3>
                <p>Ask me questions about your MALDA code, get explanations, or request code modifications.</p>
                <p>I have context about your current code, cursor position, and any errors.</p>
            </div>
        }
        else
        {
            @foreach (var message in messages)
            {
                <div class="chat-message @(message.IsUser ? "user-message" : "ai-message")">
                    <div class="message-header">
                        <span class="message-role">@(message.IsUser ? "You" : "AI")</span>
                        <span class="message-time">@message.Timestamp.ToString("HH:mm")</span>
                    </div>
                    <div class="message-content">
                        @if (message.IsError)
                        {
                            <div class="error-message">@message.Content</div>
                        }
                        else if (IsMarkdown(message.Content))
                        {
                            <div class="markdown-content">@((MarkupString)RenderMarkdown(message.Content))</div>
                        }
                        else
                        {
                            <div class="text-content">@message.Content</div>
                        }
                    </div>
                    @if (message.HasCodeBlock && !message.IsUser)
                    {
                        <div class="code-suggestion">
                            <CodeDiffView DiffResult="@message.DiffResult" 
                                         SuggestedCode="@message.CodeBlock"
                                         OnApply="HandleApplyChanges"
                                         OnDiscard="HandleDiscardChanges"
                                         OnCopy="HandleCopyCode" />
                        </div>
                    }
                </div>
            }
        }
        @if (isLoading)
        {
            <div class="chat-message ai-message">
                <div class="message-header">
                    <span class="message-role">AI</span>
                </div>
                <div class="message-content">
                    <div class="loading-indicator">
                        <span></span><span></span><span></span>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="chat-input-container">
        <div class="chat-input-inner">
            <div class="chat-mode-toggle">
                <span class="chat-mode-label">Mode:</span>
                <button type="button"
                        class="chat-mode-button @(currentMode == ChatMode.Ask ? "active" : "")"
                        @onclick="() => SetMode(ChatMode.Ask)">
                    Ask
                </button>
                <button type="button"
                        class="chat-mode-button @(currentMode == ChatMode.AskMalda ? "active" : "")"
                        @onclick="() => SetMode(ChatMode.AskMalda)">
                    Edit
                </button>
            </div>
            <div class="chat-input-row">
                <textarea @ref="inputRef" 
                          @bind="inputMessage" 
                          @onkeydown="HandleKeyPress"
                          @onkeydown:preventDefault="@ShouldPreventDefault"
                          placeholder="@GetPlaceholder()"
                          class="chat-input"
                          disabled="@isLoading"></textarea>
                <div class="chat-input-buttons">
                    <button type="button" class="btn-clear" @onclick="ClearChat" disabled="@isLoading">
                        Clear
                    </button>
                    <button class="btn-send" @onclick="SendMessage" disabled="@(isLoading || string.IsNullOrWhiteSpace(inputMessage))">
                        Send
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string CurrentCode { get; set; } = "";
    [Parameter] public (int Line, int Column) CursorPosition { get; set; }
    [Parameter] public List<Diagnostic> Errors { get; set; } = new();
    [Parameter] public string? SelectedCode { get; set; }
    [Parameter] public EventCallback<string> OnCodeChange { get; set; }
    
    private List<ChatMessageModel> messages = new();
    private string inputMessage = "";
    private bool isLoading = false;
    private ElementReference messagesContainer;
    private ElementReference inputRef;
    private ChatMessageModel? currentSuggestion = null;
    private ChatMode currentMode = ChatMode.Ask;
    
    private void ClearChat()
    {
        AIChatService.ClearHistory();
        messages.Clear();
        currentSuggestion = null;
        StateHasChanged();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(inputMessage) || isLoading)
            return;
        
        var userMessage = inputMessage.Trim();
        inputMessage = "";
        
        // Add user message to UI
        messages.Add(new ChatMessageModel
        {
            IsUser = true,
            Content = userMessage,
            Timestamp = DateTime.Now
        });
        
        isLoading = true;
        StateHasChanged();
        
        // Scroll to bottom
        await ScrollToBottom();
        
        try
        {
            // Send to AI service
            var response = await AIChatService.SendMessageAsync(
                userMessage,
                CurrentCode,
                CursorPosition.Line,
                CursorPosition.Column,
                Errors,
                SelectedCode,
                currentMode
            );
            
            if (response.IsError)
            {
                messages.Add(new ChatMessageModel
                {
                    IsUser = false,
                    Content = response.ErrorMessage ?? "An error occurred",
                    IsError = true,
                    Timestamp = DateTime.Now
                });
            }
            else
            {
                var aiMessage = new ChatMessageModel
                {
                    IsUser = false,
                    Content = response.Content,
                    CodeBlock = response.CodeBlock,
                    HasCodeBlock = response.HasCodeBlock,
                    Timestamp = DateTime.Now
                };
                
                // Generate diff in Edit mode when code block exists
                if (currentMode == ChatMode.AskMalda && response.HasCodeBlock && !string.IsNullOrEmpty(response.CodeBlock))
                {
                    aiMessage.DiffResult = CodeDiffService.GenerateDiff(CurrentCode, response.CodeBlock);
                    currentSuggestion = aiMessage;
                }
                
                messages.Add(aiMessage);
            }
        }
        catch (Exception ex)
        {
            messages.Add(new ChatMessageModel
            {
                IsUser = false,
                Content = $"Error: {ex.Message}",
                IsError = true,
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }
    
    private async Task HandleApplyChanges()
    {
        if (currentSuggestion?.CodeBlock != null)
        {
            await OnCodeChange.InvokeAsync(currentSuggestion.CodeBlock);
            currentSuggestion = null;
        }
    }
    
    private async Task HandleDiscardChanges()
    {
        currentSuggestion = null;
        StateHasChanged();
    }
    
    private async Task HandleCopyCode()
    {
        if (currentSuggestion?.CodeBlock != null)
        {
            // Copy to clipboard would require JS interop
            // For now, just show a message
            await Task.CompletedTask;
        }
    }

    private void SetMode(ChatMode mode)
    {
        currentMode = mode;
    }

    private string GetPlaceholder() =>
        currentMode == ChatMode.AskMalda
            ? "Ask the MALDA agent (with tools) about your code..."
            : "Ask a question about your MALDA code...";
    
    private bool ShouldPreventDefault => !isLoading && !string.IsNullOrWhiteSpace(inputMessage);
    
    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !isLoading && !string.IsNullOrWhiteSpace(inputMessage))
        {
            await SendMessage();
        }
    }
    
    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(50); // Small delay to ensure DOM is updated
            // Scroll would be handled via JS interop if needed
        }
        catch { }
    }
    
    private bool IsMarkdown(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return false;
        
        var trimmed = text.TrimStart();
        if (System.Text.RegularExpressions.Regex.IsMatch(trimmed, @"^#{1,6}\s+\w", System.Text.RegularExpressions.RegexOptions.Multiline))
            return true;
        if (trimmed.Contains("```"))
            return true;
        if (System.Text.RegularExpressions.Regex.IsMatch(trimmed, @"^---+$", System.Text.RegularExpressions.RegexOptions.Multiline))
            return true;
        if (System.Text.RegularExpressions.Regex.IsMatch(trimmed, @"^[\s]*[-*+]\s+\w", System.Text.RegularExpressions.RegexOptions.Multiline))
            return true;
        if (trimmed.Contains("|") && trimmed.Contains("---"))
            return true;
        return false;
    }
    
    private string RenderMarkdown(string markdown)
    {
        var normalized = markdown.Replace("\r\n", "\n").Replace("\r", "\n");
        var processedMarkdown = System.Text.RegularExpressions.Regex.Replace(
            normalized,
            @"(?<!\n)\n(?!\n)",
            "  \n"
        );
        
        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();
        
        var html = Markdown.ToHtml(processedMarkdown, pipeline);
        
        var parts = System.Text.RegularExpressions.Regex.Split(html, @"(<pre[^>]*>.*?</pre>|<code[^>]*>.*?</code>)", System.Text.RegularExpressions.RegexOptions.Singleline | System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var result = new System.Text.StringBuilder();
        foreach (var part in parts)
        {
            if (System.Text.RegularExpressions.Regex.IsMatch(part, @"^<(pre|code)", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
            {
                result.Append(part);
            }
            else
            {
                result.Append(part.Replace("\n", "<br>"));
            }
        }
        
        return result.ToString();
    }
    
    public class ChatMessageModel
    {
        public bool IsUser { get; set; }
        public string Content { get; set; } = "";
        public string? CodeBlock { get; set; }
        public bool HasCodeBlock { get; set; }
        public DiffResult? DiffResult { get; set; }
        public bool IsError { get; set; }
        public DateTime Timestamp { get; set; }
    }
}

<style>
    .ai-chat-panel {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: #1e1e1e;
    }
    
    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    
    .chat-welcome {
        text-align: center;
        padding: 40px 20px;
        color: #999;
    }
    
    .chat-welcome h3 {
        color: #ccc;
        margin-bottom: 12px;
    }
    
    .chat-welcome p {
        margin: 8px 0;
        line-height: 1.6;
    }
    
    .chat-message {
        display: flex;
        flex-direction: column;
        max-width: 85%;
        animation: fadeIn 0.3s;
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    .user-message {
        align-self: flex-end;
    }
    
    .ai-message {
        align-self: flex-start;
    }
    
    .message-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 4px;
        font-size: 11px;
        color: #999;
    }
    
    .message-role {
        font-weight: bold;
    }
    
    .message-content {
        padding: 10px 14px;
        border-radius: 8px;
        word-wrap: break-word;
        white-space: pre-wrap;
    }
    
    .user-message .message-content {
        background: #007acc;
        color: white;
    }
    
    .ai-message .message-content {
        background: #2d2d2d;
        color: #ccc;
        border: 1px solid #444;
    }
    
    .error-message {
        color: #f44336;
    }
    
    .text-content {
        line-height: 1.5;
    }
    
    .markdown-content {
        color: #ccc;
        line-height: 1.6;
    }
    
    .markdown-content p {
        margin: 0.5em 0;
    }
    
    .markdown-content code {
        background: #1e1e1e;
        padding: 2px 6px;
        border-radius: 3px;
        font-family: 'Consolas', 'Monaco', monospace;
    }
    
    .markdown-content pre {
        background: #1e1e1e;
        padding: 12px;
        border-radius: 4px;
        overflow-x: auto;
        margin: 1em 0;
    }
    
    .markdown-content pre code {
        background: transparent;
        padding: 0;
    }
    
    .code-suggestion {
        margin-top: 8px;
        border-top: 1px solid #444;
        padding-top: 8px;
    }
    
    .loading-indicator {
        display: flex;
        gap: 4px;
        padding: 8px;
    }
    
    .loading-indicator span {
        width: 8px;
        height: 8px;
        background: #666;
        border-radius: 50%;
        animation: bounce 1.4s infinite ease-in-out both;
    }
    
    .loading-indicator span:nth-child(1) { animation-delay: -0.32s; }
    .loading-indicator span:nth-child(2) { animation-delay: -0.16s; }
    
    @@keyframes bounce {
        0%, 80%, 100% { transform: scale(0); }
        40% { transform: scale(1); }
    }
    
    .chat-input-container {
        padding: 12px;
        border-top: 1px solid #444;
        background: #2d2d2d;
    }

    .chat-input-inner {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .chat-mode-toggle {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        color: #d4d4d4;
    }

    .chat-mode-label {
        margin-right: 2px;
    }

    .chat-mode-button {
        padding: 3px 10px;
        background: #3a3a3a;
        border: 1px solid #555;
        border-radius: 10px;
        color: #e0e0e0;
        font-size: 11px;
        cursor: pointer;
    }

    .chat-mode-button.active {
        background: #007acc;
        border-color: #007acc;
        color: #fff;
    }

    .chat-mode-button:hover:not(.active) {
        background: #444;
        color: #f0f0f0;
    }

    .chat-input-row {
        display: flex;
        gap: 8px;
    }

    .chat-input {
        flex: 1;
        min-height: 60px;
        max-height: 120px;
        padding: 8px;
        background: #1e1e1e;
        color: #ccc;
        border: 1px solid #555;
        border-radius: 4px;
        font-family: inherit;
        font-size: 13px;
        resize: vertical;
    }
    
    .chat-input:focus {
        outline: none;
        border-color: #007acc;
    }
    
    .chat-input:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .chat-input-buttons {
        display: flex;
        gap: 8px;
        align-self: flex-end;
    }

    .btn-clear {
        padding: 8px 12px;
        background: #444;
        color: #ccc;
        border: 1px solid #555;
        border-radius: 4px;
        cursor: pointer;
        font-size: 13px;
    }

    .btn-clear:hover:not(:disabled) {
        background: #555;
        color: #f0f0f0;
    }

    .btn-clear:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    
    .btn-send {
        padding: 8px 16px;
        background: #007acc;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 13px;
        font-weight: bold;
        align-self: flex-end;
    }
    
    .btn-send:hover:not(:disabled) {
        background: #0066aa;
    }
    
    .btn-send:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>
