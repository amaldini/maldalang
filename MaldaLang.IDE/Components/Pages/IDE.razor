    private async Task OnStepOut()
    {
        if (debuggerHook == null || !DebuggerService.State.IsPaused || !DebuggerService.State.IsRunning)
            return;
            
        await InvokeAsync(async () =>
        {
            var interpreter = ExecutionService.GetCurrentInterpreter();
            if (interpreter != null)
            {
                var callStack = interpreter.GetCallStack();
                if (callStack.Count > 0)
                {
                    var currentFrame = callStack[callStack.Count - 1];
                    debuggerHook.SetStepOutFunction(currentFrame.FunctionName);
                }
            }
            
            // Update output before stepping
            executionOutput = ExecutionService.GetCurrentOutput();
            UpdateDebugInfo();
            
            debuggerHook.SetDebugMode(DebugMode.StepOut);
            DebuggerService.Resume();
            
            // Highlight current line after step (convert 1-based -> 0-based for Monaco)
            if (DebuggerService.State.CurrentLine.HasValue && codeEditor != null)
            {
                var line = DebuggerService.State.CurrentLine.Value;
                if (line > 0)
                {
                    await codeEditor.HighlightLine(line - 1);
                }
            }
            StateHasChanged();
        });
