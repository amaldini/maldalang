    private async Task ApplySingleAutofix(Diagnostic diagnostic)
    {
        if (codeEditor == null)
        {
            ShowToast("Editor not available", "error");
            return;
        }
        
        var autofix = diagnostic.AutoFix;
        if (autofix == null)
        {
            ShowToast("No autofix available for this error", "info");
            return;
        }
        
        try
        {
            // Validate autofix before applying
            var source = await codeEditor.GetValue();
            if (!ValidateAutofix(source, autofix))
            {
                ShowToast("Invalid autofix position - code may have changed", "error");
                return;
            }
            
            await codeEditor.ReplaceRange(
                autofix.Line,
                autofix.Column,
                autofix.Line,
                autofix.Column + autofix.LengthToReplace,
                autofix.TextToInsert
            );
            
            // Re-validate after autofix
            var newSource = await codeEditor.GetValue();
            var fileName = FileService.CurrentFilePath ?? "main.malda";
            diagnostics = LanguageService.GetDiagnostics(newSource, fileName);
            if (codeEditor != null)
            {
                await codeEditor.SetDiagnostics(diagnostics);
            }
            
            ShowToast("Error fixed successfully", "success");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowToast($"Error applying autofix: {ex.Message}", "error");
        }
    }
    
    private bool ValidateAutofix(string source, AutoFixInfo autofix)
    {
        if (string.IsNullOrEmpty(source)) return false;
        
        var lines = source.Split('\n');
        
        // Validate line number
        if (autofix.Line < 0 || autofix.Line >= lines.Length)
        {
            return false;
        }
        
        var line = lines[autofix.Line];
        
        // Validate column number
        if (autofix.Column < 0 || autofix.Column > line.Length)
        {
            return false;
        }
        
        // Validate length to replace
        if (autofix.LengthToReplace < 0 || autofix.Column + autofix.LengthToReplace > line.Length)
        {
            return false;
        }
        
        return true;
    }
    
    private async Task<bool> ApplyAutofixInternal(AutoFixInfo autofix)
    {
        if (codeEditor == null) return false;
        
        try
        {
            var source = await codeEditor.GetValue();
            
            // Validate before applying
            if (!ValidateAutofix(source, autofix))
            {
                return false;
            }
            
            await codeEditor.ReplaceRange(
                autofix.Line,
                autofix.Column,
                autofix.Line,
                autofix.Column + autofix.LengthToReplace,
                autofix.TextToInsert
            );
            
            return true;
        }
        catch
        {
            return false;
        }
    }
    
