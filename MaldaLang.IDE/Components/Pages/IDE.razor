    private async Task CreateRegressionFromPayloadAsync(PropertyRegressionArtifactRequest request)
    {
        try
        {
            var content = PropertyRegressionArtifactSupport.BuildArtifactContent(request);
            var suggestedName = request.RecommendedRegressionFileName;
            if (string.IsNullOrWhiteSpace(suggestedName))
            {
                suggestedName = PropertyRegressionArtifactSupport.BuildRecommendedFileName(request);
            }

            var downloadName = System.IO.Path.GetFileName(PropertyRegressionArtifactSupport.EnsureSpecExtension(suggestedName));
            await JSRuntime.InvokeVoidAsync("downloadFile", downloadName, content);
            ShowToast($"Regression generated: {downloadName}", "success");
        }
        catch (Exception ex)
        {
            ShowToast($"Failed to generate regression: {ex.Message}", "error");
        }
    }
    
    private async Task AutofixErrors()
    {
        if (codeEditor == null)
        {
            ShowToast("Editor not available", "error");
            return;
        }
        
        try
        {
            var source = await codeEditor.GetValue();
            var autofixableDiagnostics = diagnostics
                .Where(d => d.AutoFix != null && d.AutoFix.IsSimpleCharacterFix)
                .ToList();
            
            if (autofixableDiagnostics.Count == 0)
            {
                ShowToast("No autofixable errors found", "info");
                return;
            }
            
            // Sort by position (reverse order to avoid offset issues when inserting)
            autofixableDiagnostics.Sort((a, b) =>
            {
                var lineCompare = b.Line.CompareTo(a.Line);
                if (lineCompare != 0) return lineCompare;
                return b.Column.CompareTo(a.Column);
            });
            
            // Apply all autofixes
            var fixedCount = 0;
            foreach (var diagnostic in autofixableDiagnostics)
            {
                var autofix = diagnostic.AutoFix;
                if (autofix == null) continue;
                
                if (await ApplyAutofixInternal(autofix))
                {
                    fixedCount++;
                }
            }
            
            // Re-validate after autofix
            var newSource = await codeEditor.GetValue();
            var fileName = FileService.CurrentFilePath ?? "main.malda";
            diagnostics = LanguageService.GetDiagnostics(newSource, fileName);
            if (codeEditor != null)
            {
                await codeEditor.SetDiagnostics(diagnostics);
            }
            
            // Switch to errors tab to show results
            activeTab = "errors";
            
            // Show results
            if (fixedCount > 0)
            {
                ShowToast($"Successfully fixed {fixedCount} error{(fixedCount > 1 ? "s" : string.Empty)}", "success");
            }
            else
            {
                ShowToast("No errors could be fixed", "info");
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowToast($"Error applying autofixes: {ex.Message}", "error");
        }
    }
