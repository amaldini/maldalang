@page "/ide"
@using MaldaLang.IDE
@using MaldaLang.IDE.Components
@using MaldaLang.IDE.Components.IDE
@using MaldaLang.IDE.Services
@using MaldaLang.IDE.Models
@using MaldaLang.Interpreter
@using MaldaLang.BuiltIns
@using MaldaLang.Testing
@using CompilerNamespace = MaldaLang.Compiler
@implements IDisposable
@inject ILanguageService LanguageService
@inject ExecutionService ExecutionService
@inject DebuggerService DebuggerService
@inject FileService FileService
@inject CompilerService CompilerService
@inject AIChatService AIChatService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>MALDA IDE</PageTitle>

<div class="ide-container">
    <div class="ide-toolbar">
        <button class="btn btn-primary" @onclick="RunProgram">Run</button>
        <button class="btn btn-secondary" @onclick="DebugProgram" disabled="@(DebuggerService.State.IsRunning)">Debug</button>
        <button class="btn btn-secondary" @onclick="StopProgram" disabled="@(!DebuggerService.State.IsRunning)">Stop</button>
        <button class="btn btn-secondary" @onclick="CompileProgramAsync" disabled="@isCompiling">Compile</button>
        <select @bind="compilationMode" style="margin-left: 10px; padding: 4px 8px; border: 1px solid #ccc; border-radius: 4px; font-size: 12px;" disabled="@isCompiling">
            <option value="@CompilerNamespace.CompilationMode.Interpreter">Interpreter (Current)</option>
            <option value="@CompilerNamespace.CompilationMode.TranspileToCSharp">Transpile to C#</option>
            <option value="@CompilerNamespace.CompilationMode.TranspileToDll">Transpile to DLL</option>
        </select>
        @if (!string.IsNullOrEmpty(compilationStatus))
        {
            <span style="margin-left: 10px; color: @(isCompiling ? "#007acc" : compilationStatus.Contains("Error") ? "#f44336" : "#4caf50"); font-size: 12px;">
                @compilationStatus
            </span>
        }
        
        <!-- Debug Controls -->
        <div class="debug-toolbar-separator"></div>
        <button class="btn btn-sm btn-success" @onclick="OnContinue" disabled="@(!DebuggerService.State.IsPaused || !DebuggerService.State.IsRunning)" title="Continue (F5)">
            ▶ Continue
        </button>
        <button class="btn btn-sm btn-info" @onclick="OnStepOver" disabled="@(!DebuggerService.State.IsPaused || !DebuggerService.State.IsRunning)" title="Step Over (F10)">
            ⏭ Step Over
        </button>
        <button class="btn btn-sm btn-info" @onclick="OnStepInto" disabled="@(!DebuggerService.State.IsPaused || !DebuggerService.State.IsRunning)" title="Step Into (F11)">
            ⬇ Step Into
        </button>
        <button class="btn btn-sm btn-info" @onclick="OnStepOut" disabled="@(!DebuggerService.State.IsPaused || !DebuggerService.State.IsRunning)" title="Step Out (Shift+F11)">
            ⬆ Step Out
        </button>
        <button class="btn btn-sm btn-warning" @onclick="OnPause" disabled="@(!DebuggerService.State.IsRunning || DebuggerService.State.IsPaused)" title="Pause">
            ⏸ Pause
        </button>
        
        <div class="debug-toolbar-separator"></div>
        <button class="btn btn-sm btn-primary" @onclick="AutofixErrors" disabled="@(!HasAutofixableErrors)" title="Auto-fix parser errors">
            🔧 Autofix Errors
        </button>
        
        <div class="spacer"></div>
        <button class="btn btn-sm btn-outline-secondary" @onclick="OpenStarterLauncher" title="Open guided starter path">Guided Start</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ShowExampleBrowser" title="Browse Examples">Browse Examples...</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearOutput" title="Clear Output">Clear Output</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="SaveFile">Save</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadFile">Load</button>
    </div>

    @if (ShowStarterContext)
    {
        <div class="starter-context-banner">
            <button class="starter-context-dismiss" @onclick="CloseStarterContext" title="Hide starter header" aria-label="Hide starter header">×</button>
            <div class="starter-context-copy">
                <div class="starter-context-title">@currentExample.Name</div>
                <div class="starter-context-meta">
                    @if (!string.IsNullOrWhiteSpace(currentExample.Track))
                    {
                        <span>@GetTrackLabel(currentExample.Track)</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(currentExample.Difficulty))
                    {
                        <span>@currentExample.Difficulty</span>
                    }
                    @if (currentExample.Minutes.HasValue)
                    {
                        <span>@currentExample.Minutes.Value min</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(currentExample.LearningGoal))
                {
                    <div class="starter-context-goal">@currentExample.LearningGoal</div>
                }
            </div>
            <div class="starter-context-actions">
                @if (GetNextExample() is ExampleProgram nextExample)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => LoadExampleIntoEditorAsync(nextExample, true)">Load Next: @nextExample.Name</button>
                }
                <button class="btn btn-sm btn-outline-secondary" @onclick="OpenStarterLauncher">Switch Path</button>
            </div>
        </div>
        @if (SuggestedBranches.Count != 0)
        {
            <div class="starter-branch-banner">
                <div class="starter-branch-label">Next branches after fundamentals</div>
                <div class="starter-branch-actions">
                    @foreach (var branch in SuggestedBranches)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenExamplePathAsync(branch.RelativeExamplePath, true)">
                            @branch.Title
                        </button>
                    }
                </div>
            </div>
        }
    }
    
    <div class="ide-content">
        <div class="ide-editor-panel" style="width: calc(100% - @(sidebarWidth + 5)px);">
            <CodeEditor @ref="codeEditor" 
                       OnContentChanged="OnEditorContentChanged"
                       OnCursorPositionChanged="HandleCursorPositionChanged"
                       OnBreakpointToggle="OnBreakpointToggle"
                       OnModelContentChanged="OnModelContentChanged" />
        </div>
        
        <div class="ide-splitter" 
             @onmousedown="StartResizeWithJS"
             style="cursor: col-resize; width: 5px; background: #444; flex-shrink: 0;"></div>
        
        <div class="ide-sidebar" style="width: @(sidebarWidth)px;">
            <div class="ide-tabs">
                <button class="tab-button @(activeTab == "output" ? "active" : "")" @onclick='() => activeTab = "output"'>Output</button>
                <button class="tab-button @(activeTab == "debug" ? "active" : "")" @onclick='() => activeTab = "debug"'>Debug</button>
                <button class="tab-button @(activeTab == "errors" ? "active" : "")" @onclick='() => activeTab = "errors"'>Errors</button>
                <button class="tab-button @(activeTab == "ai" ? "active" : "")" @onclick='() => activeTab = "ai"'>AI</button>
            </div>
            
            <div class="ide-panel-content">
                @if (activeTab == "output")
                {
                    <div style="display: flex; flex-direction: column; height: 100%;">
                        <div style="flex: 1; overflow: auto;">
                            <OutputPanel Output="@executionOutput" Error="@executionError" OnCreateRegression="CreateRegressionFromPayloadAsync" />
                        </div>
                        <div style="border-top: 1px solid #444; padding: 8px; background: #2d2d2d;">
                            <label style="color: #ccc; font-size: 12px; margin-bottom: 4px; display: block;">Program Input (one value per line):</label>
                            <textarea @bind="programInput" 
                                    style="width: 100%; min-height: 60px; background: #1e1e1e; color: #ccc; border: 1px solid #555; padding: 4px; font-family: monospace; font-size: 12px; resize: vertical;"
                                    placeholder="Enter input values here, one per line..."></textarea>
                        </div>
                    </div>
                }
                else if (activeTab == "debug")
                {
                    <DebugPanel DebugState="@DebuggerService.State" 
                               Breakpoints="@DebuggerService.Breakpoints" />
                }
                else if (activeTab == "errors")
                {
                    <ErrorList Diagnostics="@diagnostics"
                               OnNavigate="NavigateToError"
                               OnApplyAutofix="ApplySingleAutofix"
                               OnOpenExample="OpenDiagnosticExample"
                               OnReadLesson="OpenDiagnosticLesson" />
                }
                else if (activeTab == "ai")
                {
                    <AIChatPanel CurrentCode="@currentCode" 
                                CursorPosition="@cursorPosition"
                                Errors="@diagnostics"
                                SelectedCode="@selectedCode"
                                OnCodeChange="HandleAICodeChange" />
                }
            </div>
        </div>
    </div>
    
    <!-- Model Loading Progress Overlay -->
    @if (showModelLoading)
    {
        <div class="model-loading-overlay">
            <div class="model-loading-card">
                <div class="model-loading-text">@modelLoadingMessage</div>
                @if (showProgressBar)
                {
                    <div class="model-loading-progress-container">
                        <div class="model-loading-progress-bar" style="width: @(modelLoadingProgress)%"></div>
                    </div>
                }
            </div>
        </div>
    }
    
    <!-- Toast Notification -->
    @if (showToast)
    {
        <div class="toast-overlay">
            <div class="toast-card @toastType">
                <div class="toast-icon">
                    @if (toastType == "success")
                    {
                        <span>✓</span>
                    }
                    else if (toastType == "error")
                    {
                        <span>✕</span>
                    }
                    else
                    {
                        <span>ℹ</span>
                    }
                </div>
                <div class="toast-message">@toastMessage</div>
            </div>
        </div>
    }

    @if (showStarterLauncher)
    {
        <div class="starter-overlay">
            <div class="starter-panel">
                <div class="starter-panel-header">
                    <div>
                        <div class="starter-panel-eyebrow">Guided onboarding</div>
                        <h2>Choose how you want to start with MALDA</h2>
                        <p>Begin with programming fundamentals, jump into AI-native features, or open a commercial showcase.</p>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CloseStarterLauncher">Start Blank</button>
                </div>

                <div class="starter-track-picker">
                    @foreach (var track in starterTracks)
                    {
                        <button class="starter-track-button @(selectedStarterTrack == track.Id ? "active" : "")"
                                @onclick="() => SelectStarterTrack(track.Id)">
                            @track.Label
                        </button>
                    }
                </div>

                <div class="starter-card-grid">
                    @foreach (var starter in VisibleStarterOptions)
                    {
                        <button class="starter-choice-card" @onclick="() => OpenStarterAsync(starter.Id)">
                            <div class="starter-choice-topline">
                                <span class="starter-choice-track">@GetTrackLabel(starter.Track)</span>
                                <span class="starter-choice-time">@starter.EstimatedTime</span>
                            </div>
                            <div class="starter-choice-title">@starter.Title</div>
                            <div class="starter-choice-description">@starter.Description</div>
                            <div class="starter-choice-goal">@starter.LearningGoal</div>
                            <div class="starter-choice-highlights">
                                @foreach (var highlight in starter.Highlights)
                                {
                                    <span>@highlight</span>
                                }
                            </div>
                        </button>
                    }
                </div>

                <div class="specialization-section">
                    <div class="specialization-header">
                        <h3>Specialization tracks</h3>
                        <p>After the core path, branch into @StarterCatalog.GetBranchTitleSummary().</p>
                    </div>
                    <div class="specialization-grid">
                        @foreach (var branch in VisibleLearningBranches)
                        {
                            <button class="specialization-card" @onclick="() => OpenExamplePathAsync(branch.RelativeExamplePath, true)">
                                <div class="starter-choice-topline">
                                    <span class="starter-choice-track">@GetTrackLabel(branch.AudienceTrack)</span>
                                    <span class="starter-choice-time">@branch.EstimatedTime</span>
                                </div>
                                <div class="starter-choice-title">@branch.Title</div>
                                <div class="starter-choice-description">@branch.Description</div>
                                <div class="starter-choice-goal">@branch.LearningGoal</div>
                                <div class="starter-choice-highlights">
                                    @foreach (var highlight in branch.Highlights)
                                    {
                                        <span>@highlight</span>
                                    }
                                </div>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "starter")]
    public string? StarterId { get; set; }

    [SupplyParameterFromQuery(Name = "track")]
    public string? TrackId { get; set; }

    [SupplyParameterFromQuery(Name = "example")]
    public string? ExamplePath { get; set; }

    private CodeEditor? codeEditor;
    private string activeTab = "output";
    private string executionOutput = "";
    private string? executionError;
    private bool showExampleBrowser = false;
    private string programInput = "";
    private List<Diagnostic> diagnostics = new();
    private DebuggerHook? debuggerHook;
    private Task? debugTask;
    private CancellationTokenSource? debugCancellation;
    private int sidebarWidth = 300;
    private Microsoft.JSInterop.DotNetObjectReference<IDE>? dotNetRef;
    private string currentCode = "";
    private (int Line, int Column) cursorPosition = (0, 0);
    private string? selectedCode = null;
    private bool showModelLoading = false;
    private string modelLoadingMessage = "Loading model...";
    private int modelLoadingProgress = 0;
    private bool showProgressBar = true;
    private bool showToast = false;
    private string toastMessage = "";
    private string toastType = "info"; // "success", "error", "info"
    private bool showStarterLauncher;
    private bool initialStarterResolved;
    private string selectedStarterTrack = "student";
    private ExampleProgram? currentExample;
    private bool starterContextDismissed;
    private readonly (string Id, string Label)[] starterTracks =
    [
        ("student", "Learn programming"),
        ("ai-builder", "Build with AI"),
        ("showcase", "Commercial showcases")
    ];

    private IEnumerable<StarterOption> VisibleStarterOptions =>
        StarterCatalog.GetByTrack(selectedStarterTrack);

    private IEnumerable<LearningBranch> VisibleLearningBranches =>
        StarterCatalog.GetBranchesForTrack(selectedStarterTrack);

    private List<LearningBranch> SuggestedBranches =>
        currentExample != null && IsCoreLearningExample(currentExample)
            ? StarterCatalog.GetBranches()
            : [];

    private bool ShowStarterContext =>
        currentExample != null && !starterContextDismissed;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Subscribe to breakpoint changes
            DebuggerService.BreakpointsChanged += OnBreakpointsChanged;
            
            // Subscribe to input needed event to update output in real-time
            ExecutionService.InputNeeded += OnInputNeeded;
            
            // Subscribe to output needs update event (e.g., during sleep)
            ExecutionService.OutputNeedsUpdate += OnOutputNeedsUpdate;
            
            // Subscribe to model loading progress
            ModelLoadingService.OnProgressChanged += OnModelLoadingProgress;
            ModelLoadingService.OnLoadingStarted += OnModelLoadingStarted;
            ModelLoadingService.OnLoadingCompleted += OnModelLoadingCompleted;
            
            // Update breakpoints when editor is first rendered
            if (codeEditor != null)
            {
                await codeEditor.SetBreakpoints(DebuggerService.Breakpoints);
                // Initialize current code
                currentCode = await codeEditor.GetValue();
            }
            
            // Setup splitter resizing
            dotNetRef = Microsoft.JSInterop.DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("eval", @"
                (function() {
                    var component = null;
                    var isResizing = false;
                    var startX = 0;
                    var startWidth = 300;
                    
                    window.addEventListener('mousemove', function(e) {
                        if (isResizing && component) {
                            var deltaX = startX - e.clientX;
                            var newWidth = startWidth + deltaX;
                            if (newWidth < 250) newWidth = 250;
                            if (newWidth > 400) newWidth = 400;
                            component.invokeMethodAsync('UpdateSidebarWidth', Math.round(newWidth));
                        }
                    });
                    
                    window.addEventListener('mouseup', function(e) {
                        isResizing = false;
                    });
                    
                    window.setupSplitter = function(comp) {
                        component = comp;
                    };
                    
                    window.startResize = function(clientX, currentWidth) {
                        isResizing = true;
                        startX = clientX;
                        startWidth = currentWidth;
                    };
                })();
            ");
            await JSRuntime.InvokeVoidAsync("setupSplitter", dotNetRef);
            await InitializeStarterStateAsync();
        }
    }
    
    public void Dispose()
    {
        // Unsubscribe from events
        ExecutionService.InputNeeded -= OnInputNeeded;
        ExecutionService.OutputNeedsUpdate -= OnOutputNeedsUpdate;
        DebuggerService.BreakpointsChanged -= OnBreakpointsChanged;
        ModelLoadingService.OnProgressChanged -= OnModelLoadingProgress;
        ModelLoadingService.OnLoadingStarted -= OnModelLoadingStarted;
        ModelLoadingService.OnLoadingCompleted -= OnModelLoadingCompleted;
        dotNetRef?.Dispose();
    }
    
    private async void OnModelLoadingProgress(ModelLoadingService.ModelLoadingProgress progress)
    {
        await InvokeAsync(() =>
        {
            if (progress.IsError)
            {
                // Show error message and hide progress bar
                showModelLoading = true;
                showProgressBar = false;
                modelLoadingMessage = progress.Message;
                StateHasChanged();
                
                // Hide after 3 seconds
                _ = Task.Run(async () =>
                {
                    await Task.Delay(3000);
                    await InvokeAsync(() =>
                    {
                        if (!ModelLoadingService.IsAnyModelLoading())
                        {
                            showModelLoading = false;
                            showProgressBar = true;
                            StateHasChanged();
                        }
                    });
                });
            }
            else if (progress.IsLoading && progress.Percentage < 100)
            {
                showModelLoading = true;
                showProgressBar = true;
                modelLoadingMessage = progress.Message;
                modelLoadingProgress = progress.Percentage;
                StateHasChanged();
            }
        });
    }
    
    private void OnModelLoadingStarted(ModelLoadingService.ModelLoadingProgress progress)
    {
        InvokeAsync(() =>
        {
            showModelLoading = true;
            showProgressBar = true;
            modelLoadingMessage = progress.Message;
            modelLoadingProgress = progress.Percentage;
            StateHasChanged();
        });
    }
    
    private void OnModelLoadingCompleted(string modelPath)
    {
        InvokeAsync(() =>
        {
            // Check if there are any other models still loading
            if (!ModelLoadingService.IsAnyModelLoading())
            {
                showModelLoading = false;
                showProgressBar = true;
                modelLoadingProgress = 100;
                StateHasChanged();
            }
        });
    }
    
    private void OnInputNeeded()
    {
        // Update output before input is requested
        InvokeAsync(() =>
        {
            executionOutput = ExecutionService.GetCurrentOutput();
            activeTab = "output"; // Ensure output tab is visible
            StateHasChanged();
        });
    }
    
    private void OnOutputNeedsUpdate()
    {
        // Update output panel (e.g., during sleep)
        InvokeAsync(() =>
        {
            executionOutput = ExecutionService.GetCurrentOutput();
            activeTab = "output"; // Ensure output tab is visible
            StateHasChanged();
        });
    }
    
    private async void OnBreakpointsChanged()
    {
        await InvokeAsync(async () =>
        {
            if (codeEditor != null)
            {
                await codeEditor.SetBreakpoints(DebuggerService.Breakpoints);
                StateHasChanged();
            }
        });
    }
    
    private async Task OnEditorContentChanged(string content)
    {
        currentCode = content;
        
        // Update diagnostics on content change (debounced)
        await Task.Delay(500); // Simple debounce
        var fileName = FileService.CurrentFilePath ?? "main.malda";
        diagnostics = LanguageService.GetDiagnostics(content, fileName);
        if (codeEditor != null)
        {
            await codeEditor.SetDiagnostics(diagnostics);
        }
    }
    
    private async Task HandleAICodeChange(string newCode)
    {
        if (codeEditor != null)
        {
            await codeEditor.SetValue(newCode);
            currentCode = newCode;
            // Update diagnostics after code change
            var fileName = FileService.CurrentFilePath ?? "main.malda";
            diagnostics = LanguageService.GetDiagnostics(newCode, fileName);
            await codeEditor.SetDiagnostics(diagnostics);
        }
    }
    
    private async void HandleCursorPositionChanged((int Line, int Column) position)
    {
        cursorPosition = position;
        OnCursorPositionChanged(position.Line, position.Column);
        
        // Update selected code if there's a selection
        if (codeEditor != null)
        {
            var selection = await codeEditor.GetSelection();
            if (selection != null && (selection.StartLine != selection.EndLine || selection.StartColumn != selection.EndColumn))
            {
                selectedCode = await codeEditor.GetSelectedText();
            }
            else
            {
                selectedCode = null;
            }
        }
    }
    
    private void OnCursorPositionChanged(int line, int column)
    {
        // Could show hover information here
    }
    
    private async Task OnBreakpointToggle(int line)
    {
        DebuggerService.ToggleBreakpoint(line, FileService.CurrentFilePath ?? "main.malda");
        
        // Update breakpoints in editor
        if (codeEditor != null)
        {
            await codeEditor.SetBreakpoints(DebuggerService.Breakpoints);
        }
    }
    
    private async Task OnModelContentChanged((int LineNumber, int Delta) change)
    {
        var fileName = FileService.CurrentFilePath ?? "main.malda";
        DebuggerService.AdjustBreakpointsForLineChange(fileName, change.LineNumber, change.Delta);
        
        // Update breakpoints in editor after adjustment
        if (codeEditor != null)
        {
            await codeEditor.SetBreakpoints(DebuggerService.Breakpoints);
        }
    }
    
    private async Task RunProgram()
    {
        if (codeEditor == null) return;
        
        var source = await codeEditor.GetValue();
        currentCode = source; // Update current code
        var input = string.IsNullOrWhiteSpace(programInput) ? null : programInput;
        var fileName = FileService.CurrentFilePath ?? "main.malda";
        var result = await ExecutionService.ExecuteAsync(source, input, fileName);
        
        executionOutput = result.Output;
        executionError = result.Error;
        activeTab = "output";
        
        if (!result.Success)
        {
            activeTab = "errors";
            diagnostics.Add(new Diagnostic
            {
                Severity = DiagnosticSeverity.Error,
                Message = result.Error ?? "Execution failed",
                Line = 0,
                Column = 0,
                Length = 1
            });
        }
    }
    
    private async Task DebugProgram()
    {
        if (codeEditor == null) return;
        
        var source = await codeEditor.GetValue();
        var fileName = FileService.CurrentFilePath ?? "main.malda";
        
        // Update breakpoints in editor before starting
        await codeEditor.SetBreakpoints(DebuggerService.Breakpoints);
        
        // Clear output at start of debugging
        executionOutput = "";
        executionError = null;
        
        DebuggerService.Start();
        activeTab = "output"; // Show output tab to see debug output
        
        // Create debugger hook
        debuggerHook = new DebuggerHook(DebuggerService);
        debuggerHook.SetDebugMode(DebugMode.Continue);
        debuggerHook.OnPaused += async (line, file) =>
        {
            await InvokeAsync(async () =>
            {
                // Update output during debugging
                executionOutput = ExecutionService.GetCurrentOutput();
                
                UpdateDebugInfo();
                if (codeEditor != null && line > 0)
                {
                    await codeEditor.HighlightLine(line);
                }
                StateHasChanged();
            });
        };
        
        // Start debugging in background task
        debugCancellation = new CancellationTokenSource();
        var input = string.IsNullOrWhiteSpace(programInput) ? null : programInput;
        debugTask = Task.Run(async () =>
        {
            try
            {
                var result = await ExecutionService.ExecuteWithDebuggerAsync(source, debuggerHook, input, fileName);
                
                // Update UI with final results
                await InvokeAsync(async () =>
                {
                    // Get final output (should already be updated during pauses, but ensure it's complete)
                    executionOutput = ExecutionService.GetCurrentOutput();
                    executionError = result.Error;
                    if (!result.Success && !string.IsNullOrEmpty(result.Error))
                    {
                        activeTab = "errors";
                    }
                    else
                    {
                        activeTab = "output"; // Show output tab
                    }
                    UpdateDebugInfo();
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    executionError = ex.Message;
                    activeTab = "errors";
                    StateHasChanged();
                });
            }
            finally
            {
                await InvokeAsync(async () =>
                {
                    DebuggerService.Stop();
                    // Update debug info one last time
                    UpdateDebugInfo();
                    StateHasChanged();
                });
            }
        }, debugCancellation.Token);
    }
    
    private void StopProgram()
    {
        debugCancellation?.Cancel();
        DebuggerService.Stop();
        debuggerHook = null;
        debugTask = null;
        debugCancellation?.Dispose();
        debugCancellation = null;
    }
    
    private string compilationStatus = "";
    private bool isCompiling = false;
    private CompilerNamespace.CompilationMode compilationMode = CompilerNamespace.CompilationMode.Interpreter;
    private bool HasAutofixableErrors => diagnostics.Any(d => d.AutoFix != null && d.AutoFix.IsSimpleCharacterFix);

    private async Task CompileProgramAsync()
    {
        if (codeEditor == null) return;
        
        var source = await codeEditor.GetValue();
        if (string.IsNullOrWhiteSpace(source))
        {
            compilationStatus = "Error: Please enter some code to compile.";
            StateHasChanged();
            return;
        }

        isCompiling = true;
        compilationStatus = "Compiling...";
        StateHasChanged();

        try
        {
            var outputFileName = compilationMode == CompilerNamespace.CompilationMode.TranspileToDll ? "program.dll" : "program.exe";
            if (!string.IsNullOrEmpty(FileService.CurrentFilePath))
            {
                var fileName = Path.GetFileNameWithoutExtension(FileService.CurrentFilePath);
                var extension = compilationMode == CompilerNamespace.CompilationMode.TranspileToDll ? ".dll" : ".exe";
                outputFileName = $"{fileName}{extension}";
            }

            CompilerService.OnProgress += (progress) =>
            {
                compilationStatus = progress.Message;
                InvokeAsync(StateHasChanged);
            };

            var result = await CompilerService.CompileAsync(source, outputFileName, compilationMode);

            if (result.Success && !string.IsNullOrEmpty(result.OutputPath))
            {
                // Try to create zip with dependencies first
                var zipBytes = CompilerService.CreateZipWithDependencies(result.OutputPath);
                byte[] fileBytes;
                string downloadFileName;
                string contentType;

                // For DLL mode, always download the DLL directly
                if (compilationMode == CompilerNamespace.CompilationMode.TranspileToDll)
                {
                    var dllBytes = CompilerService.ReadCompiledExecutable(result.OutputPath);
                    if (dllBytes != null)
                    {
                        fileBytes = dllBytes;
                        downloadFileName = outputFileName;
                        contentType = "application/x-msdownload";
                        compilationStatus = $"Compilation successful! Downloading {downloadFileName} (DLL library)...";
                    }
                    else
                    {
                        compilationStatus = "Error: Could not read compiled DLL.";
                        return;
                    }
                }
                else if (zipBytes != null)
                {
                    // DLL exists separately (single-file publish didn't fully embed it), create zip
                    fileBytes = zipBytes;
                    downloadFileName = Path.ChangeExtension(outputFileName, ".zip");
                    contentType = "application/zip";
                    compilationStatus = $"Compilation successful! Downloading {downloadFileName} (includes executable and DLL)...";
                }
                else
                {
                    // DLL is embedded in exe (single-file publish worked), download single exe
                    var exeBytes = CompilerService.ReadCompiledExecutable(result.OutputPath);
                    if (exeBytes != null)
                    {
                        fileBytes = exeBytes;
                        downloadFileName = outputFileName;
                        contentType = "application/x-msdownload";
                        compilationStatus = $"Compilation successful! Downloading {downloadFileName} (single-file executable)...";
                    }
                    else
                    {
                        compilationStatus = "Error: Could not read compiled executable.";
                        return;
                    }
                }

                // Download the file using JavaScript
                var base64 = Convert.ToBase64String(fileBytes);
                await JSRuntime.InvokeVoidAsync("downloadFile", downloadFileName, base64, contentType);
                
                // Clean up the temp file after a delay
                _ = Task.Run(async () =>
                {
                    await Task.Delay(5000);
                    try
                    {
                        if (File.Exists(result.OutputPath))
                            File.Delete(result.OutputPath);
                        var dllPath = Path.Combine(Path.GetDirectoryName(result.OutputPath) ?? "", "MaldaLang.dll");
                        if (File.Exists(dllPath))
                            File.Delete(dllPath);
                    }
                    catch { }
                });
            }
            else
            {
                compilationStatus = $"Compilation failed: {result.ErrorMessage}";
            }
        }
        catch (Exception ex)
        {
            compilationStatus = $"Error during compilation: {ex.Message}";
        }
        finally
        {
            isCompiling = false;
            StateHasChanged();
        }
    }
    
    private async Task SaveFile()
    {
        if (codeEditor == null) return;
        
        var content = await codeEditor.GetValue();
        FileService.SetContent(content);
        
        string fileName;
        
        if (string.IsNullOrEmpty(FileService.CurrentFilePath))
        {
            // Prompt for file name using JavaScript
            var promptResult = await JSRuntime.InvokeAsync<string>("eval", 
                "window.prompt ? window.prompt('Enter file name:', 'program.malda') : null");
            
            if (string.IsNullOrEmpty(promptResult))
            {
                // User cancelled or prompt not available
                return;
            }
            
            // Ensure .malda extension
            fileName = promptResult.EndsWith(".malda", StringComparison.OrdinalIgnoreCase) 
                ? promptResult 
                : promptResult + ".malda";
            
            // Update file service with new path
            FileService.SetFilePath(fileName);
        }
        else
        {
            fileName = FileService.GetFileName();
        }
        
        // Save using browser download
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, content);
    }
    
