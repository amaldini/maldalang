    private async Task OnPause()
    {
        if (debuggerHook == null || !DebuggerService.State.IsRunning || DebuggerService.State.IsPaused)
            return;
            
        await InvokeAsync(async () =>
        {
            debuggerHook.SetDebugMode(DebugMode.Paused);
            DebuggerService.Pause();
            
            // Update output when pausing
            executionOutput = ExecutionService.GetCurrentOutput();
            UpdateDebugInfo();
            
            // Highlight current line when pausing (convert 1-based -> 0-based for Monaco)
            if (DebuggerService.State.CurrentLine.HasValue && codeEditor != null)
            {
                var line = DebuggerService.State.CurrentLine.Value;
