@page "/"
@using MaldaLang.IDE

<PageTitle>MALDA Start Here</PageTitle>

<div class="home-shell">
    <section class="hero-section">
        <div class="hero-copy">
            <p class="eyebrow">AI-first full-stack platform</p>
            <h1>The fastest path from first program to production-grade AI apps.</h1>
            <p class="hero-subtitle">
                MALDA keeps its commercial AI-first identity while giving first-time programmers a guided, low-friction way to learn variables, functions, prompts, agents, and full-stack applications in one environment.
            </p>
            <div class="hero-actions">
                <a class="hero-button primary" href="/ide?starter=hello-world">Start learning programming</a>
                <a class="hero-button secondary" href="/ide?starter=prompt">Build with AI</a>
                <a class="hero-button secondary" href="/ide?starter=fullstack">See full-stack demo</a>
            </div>
        </div>
        <div class="hero-proof">
            <div class="proof-card">
                <h2>Why teams care</h2>
                <ul>
                    <li>One stack for language, agents, APIs, UI, and deployment</li>
                    <li>Local AI path lowers cost and setup friction</li>
                    <li>Beginner-friendly entry without capping advanced work</li>
                </ul>
            </div>
        </div>
    </section>

    <section class="path-section">
        <div class="path-card">
            <p class="path-label">Learn Programming</p>
            <h2>Start with small wins.</h2>
            <p>Use curated lessons that focus on output, variables, conditionals, loops, functions, then a small complete program and input before you touch advanced AI or full-stack patterns.</p>
            <a class="inline-link" href="/ide?track=student">Open the student path</a>
        </div>
        <div class="path-card">
            <p class="path-label">Build AI Apps</p>
            <h2>Keep the premium MALDA story visible.</h2>
            <p>Move from prompts to agents, REST APIs, UI controls, and commercial showcase apps without switching languages or runtime models.</p>
            <a class="inline-link" href="/ide?track=ai-builder">Open the AI builder path</a>
        </div>
    </section>

    <section class="starter-grid-section">
        <div class="section-header">
            <h2>Guided starters</h2>
            <p>Choose the path that matches where you are today.</p>
        </div>
        <div class="starter-grid">
            @foreach (var starter in StarterCatalog.GetAll())
            {
                <article class="starter-card">
                    <div class="starter-meta">
                        <span class="starter-track">@GetTrackLabel(starter.Track)</span>
                        <span class="starter-time">@starter.EstimatedTime</span>
                    </div>
                    <h3>@starter.Title</h3>
                    <p>@starter.Description</p>
                    <p class="starter-goal"><strong>Goal:</strong> @starter.LearningGoal</p>
                    <div class="starter-highlights">
                        @foreach (var highlight in starter.Highlights)
                        {
                            <span>@highlight</span>
                        }
                    </div>
                    <a class="inline-link" href="/ide?starter=@starter.Id">Open starter</a>
                </article>
            }
        </div>
    </section>

    <section class="starter-grid-section">
        <div class="section-header">
            <h2>Specialization tracks</h2>
            <p>After the core path, branch into @StarterCatalog.GetBranchTitleSummary().</p>
        </div>
        <div class="branch-grid">
            @foreach (var branch in StarterCatalog.GetBranches())
            {
                <article class="starter-card branch-card">
                    <div class="starter-meta">
                        <span class="starter-track">@GetTrackLabel(branch.AudienceTrack)</span>
                        <span class="starter-time">@branch.EstimatedTime</span>
                    </div>
                    <h3>@branch.Title</h3>
                    <p>@branch.Description</p>
                    <p class="starter-goal"><strong>Goal:</strong> @branch.LearningGoal</p>
                    <div class="starter-highlights">
                        @foreach (var highlight in branch.Highlights)
                        {
                            <span>@highlight</span>
                        }
                    </div>
                    <a class="inline-link" href="/ide?example=@ToQueryValue(branch.RelativeExamplePath)">Open track</a>
                </article>
            }
        </div>
    </section>

    <section class="lesson-section" id="lesson-hello-world">
        <h2>Hello World</h2>
        <p>Your first MALDA program can be one line: <code>io.print("Hello, World!");</code>. Change the text, run again, and notice how direct feedback makes the language feel approachable.</p>
        <a class="inline-link" href="/ide?starter=hello-world">Try Hello World</a>
    </section>

    <section class="lesson-section" id="lesson-variables">
        <h2>Variables and Arithmetic</h2>
        <p>Variables let you store values and reuse them. MALDA keeps the syntax minimal with <code>var total = 2 + 3;</code>, so the student can focus on the concept rather than ceremony.</p>
        <a class="inline-link" href="/ide?starter=variables">Open the variables lesson</a>
    </section>

    <section class="lesson-section" id="lesson-conditionals">
        <h2>Conditionals</h2>
        <p>Conditionals teach decision making. MALDA's <code>if</code>/<code>else</code> syntax stays close to mainstream languages, which helps beginners build transferable intuition.</p>
        <a class="inline-link" href="/ide?starter=conditionals">Open conditionals</a>
    </section>

    <section class="lesson-section" id="lesson-loops">
        <h2>Loops</h2>
        <p>Learn <code>while</code> first, then a counted <code>for</code>, so repetition is one idea at a time before the complete starter uses <code>for-in</code> over an array.</p>
        <a class="inline-link" href="/ide?starter=loops">Open the while loop</a>
        <span> · </span>
        <a class="inline-link" href="/ide?starter=for-loop">Open the for loop</a>
    </section>

    <section class="lesson-section" id="lesson-functions">
        <h2>Functions</h2>
        <p>Functions are where MALDA begins to feel powerful: the student learns naming, reuse, parameters, and return values in a way that also prepares them for prompts and agents later.</p>
        <a class="inline-link" href="/ide?starter=functions">Open first function</a>
    </section>

    <section class="lesson-section" id="lesson-complete-starter">
        <h2>Complete Starter Program</h2>
        <p>After the single-idea lessons, one short program puts variables, a <code>for-in</code> loop, a function, and an <code>if</code> together.</p>
        <a class="inline-link" href="/ide?starter=complete-starter">Open the complete starter</a>
    </section>

    <section class="lesson-section" id="lesson-input-output">
        <h2>Input and Output</h2>
        <p>Once the earlier syntax feels familiar, connect <code>io.input</code>, type conversion, and output in one small interactive example.</p>
        <a class="inline-link" href="/ide?starter=input-output">Open input and output</a>
    </section>

    <section class="lesson-section" id="lesson-first-prompt">
        <h2>First Prompt</h2>
        <p>Prompts are MALDA's bridge between plain programming and AI workflows. Students can see a prompt block as just another reusable building block, not a mysterious separate system.</p>
        <a class="inline-link" href="/ide?starter=prompt">Open first prompt</a>
    </section>

    <section class="lesson-section" id="lesson-first-agent">
        <h2>First Agent</h2>
        <p>After functions and prompts, agents feel like a natural next step. MALDA's commercial value stays intact because the onboarding path now climbs toward the same premium destination instead of bypassing it.</p>
        <a class="inline-link" href="/ide?starter=agent">Open first agent</a>
    </section>

    <section class="lesson-section" id="lesson-build-ai-apps">
        <h2>Build AI Apps</h2>
        <p>MALDA's differentiator is not just learning syntax. It is the unified runtime for prompts, agents, APIs, web UI, and deployment. The student path should feed directly into this builder path.</p>
        <a class="inline-link" href="/ide?track=ai-builder">Explore the AI builder path</a>
    </section>

    <section class="lesson-section" id="lesson-fullstack-demo">
        <h2>Full-Stack Demo</h2>
        <p>The full-stack showcase proves the commercial ceiling: MALDA can power interactive UI, route handling, local AI, and larger business workflows in one stack.</p>
        <a class="inline-link" href="/ide?starter=fullstack">Open the full-stack showcase</a>
    </section>
</div>

@code {
    private static string GetTrackLabel(string track)
    {
        return track switch
        {
            "student" => "Learn programming",
            "ai-builder" => "Build with AI",
            "showcase" => "Showcase",
            _ => "Path"
        };
    }

    private static string ToQueryValue(string value)
    {
        return Uri.EscapeDataString(value.Replace('\\', '/'));
    }
}

<style>
    .home-shell {
        display: flex;
        flex-direction: column;
        gap: 28px;
        padding: 24px 0 40px;
        color: #d9e2ec;
    }

    .hero-section {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
        gap: 24px;
        align-items: stretch;
    }

    .hero-copy,
    .proof-card,
    .path-card,
    .starter-card,
    .lesson-section {
        background: linear-gradient(180deg, rgba(23, 32, 46, 0.96), rgba(15, 23, 34, 0.96));
        border: 1px solid rgba(132, 145, 166, 0.18);
        border-radius: 18px;
        padding: 24px;
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.18);
    }

    .eyebrow,
    .path-label,
    .starter-track {
        color: #8cc8ff;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 12px;
    }

    .hero-copy h1 {
        font-size: clamp(2rem, 4vw, 3.2rem);
        line-height: 1.05;
        margin-bottom: 16px;
        color: #f8fbff;
    }

    .hero-subtitle,
    .path-card p,
    .starter-card p,
    .lesson-section p,
    .proof-card li,
    .section-header p {
        color: #b8c7d9;
        line-height: 1.6;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 20px;
    }

    .hero-button,
    .inline-link {
        text-decoration: none;
    }

    .hero-button {
        border-radius: 999px;
        padding: 12px 18px;
        font-weight: 600;
    }

    .hero-button.primary {
        background: #53b3ff;
        color: #04111f;
    }

    .hero-button.secondary,
    .inline-link {
        color: #8cc8ff;
    }

    .proof-card h2,
    .path-card h2,
    .section-header h2,
    .lesson-section h2 {
        color: #f8fbff;
        margin-bottom: 12px;
    }

    .proof-card ul {
        margin: 0;
        padding-left: 20px;
        display: grid;
        gap: 10px;
    }

    .path-section {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .starter-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 16px;
    }

    .branch-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 16px;
    }

    .branch-card {
        border-color: rgba(83, 179, 255, 0.2);
    }

    .starter-meta {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
        color: #8cc8ff;
    }

    .starter-time {
        color: #9fb3c8;
        font-size: 0.9rem;
    }

    .starter-card h3 {
        color: #f8fbff;
        margin-bottom: 10px;
    }

    .starter-goal {
        margin: 12px 0;
    }

    .starter-highlights {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 12px;
    }

    .starter-highlights span {
        background: rgba(140, 200, 255, 0.12);
        color: #cfe8ff;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 0.8rem;
    }

    .lesson-section code {
        color: #9bd0ff;
    }

    @@media (max-width: 900px) {
        .hero-section,
        .path-section {
            grid-template-columns: 1fr;
        }
    }
</style>
